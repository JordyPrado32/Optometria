@inject AuthenticationStateProvider AuthenticationStateProvider
@inject MenuAccessService MenuAccessService

<div class="app-nav-shell">
    <button type="button" class="app-nav-toggle" @onclick="ToggleMenu" aria-label="Abrir menu">
        <span></span>
        <span></span>
        <span></span>
    </button>

    <nav class="app-nav @(menuOpen ? "is-open" : string.Empty)">
        <div class="app-nav-scroll">
            <div class="app-nav-links">
                @foreach (var menu in sortedMenus)
                {
                    <NavLink class="app-nav-link" href="@menu.Ruta" Match="@(menu.Ruta == "/dashboard" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                        <span class="app-nav-link-mark">
                            <i class="@GetMenuIconClass(menu.Ruta)"></i>
                        </span>
                        <span class="app-nav-link-copy">
                            <strong>@menu.Nombre</strong>
                        </span>
                    </NavLink>
                }
            </div>
        </div>

        <aside class="app-account-panel">
            <div class="app-account-panel-copy">
                <span>@RoleName</span>
                <strong>@UserName</strong>
            </div>

            <div class="app-account-panel-grid">
                <a class="app-account-utility" href="/profile">Perfil</a>
                <a class="app-account-utility" href="/setup-2fa">Seguridad</a>
            </div>

            <a class="app-account-link" href="/auth/logout">Cerrar sesion</a>
        </aside>
    </nav>
</div>

@code {
    private readonly List<AppMenuItem> sortedMenus = [];
    private bool menuOpen;
    private string UserName { get; set; } = "Cuenta";
    private string RoleName { get; set; } = "Sesion";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        UserName = user.Identity?.Name ?? "Cuenta";
        RoleName = user.FindFirst(ClaimTypes.Role)?.Value ?? "Sesion";

        var roleIdValue = user.FindFirst("RoleId")?.Value;
        int? roleId = int.TryParse(roleIdValue, out var parsedRoleId) ? parsedRoleId : null;

        var rawMenus = await MenuAccessService.GetMenusForRoleAsync(roleId);
        sortedMenus.AddRange(rawMenus.OrderBy(m => GetRouteOrder(m.Ruta)));
    }

    private void ToggleMenu()
    {
        menuOpen = !menuOpen;
    }

    private static int GetRouteOrder(string route) => route switch
    {
        "/dashboard" => 1,
        "/patients" => 2,
        "/doctor/patient-entry" => 3,
        "/doctor/my-patients" => 4,
        "/laboratories" => 5,
        "/suppliers" => 6,
        "/clients" => 7,
        "/emisor" => 8,
        "/users" => 9,
        "/roles" => 10,
        "/menus" => 11,
        "/register" => 12,
        "/setup-2fa" => 13,
        "/profile" => 14,
        _ => 100
    };

    private static string GetMenuIconClass(string route) => route switch
    {
        "/dashboard" => "bi bi-grid-1x2-fill",
        "/patients" => "bi bi-people-fill",
        "/doctor/patient-entry" => "bi bi-person-plus-fill",
        "/doctor/my-patients" => "bi bi-journal-medical",
        "/laboratories" => "bi bi-clipboard2-pulse-fill",
        "/suppliers" => "bi bi-truck",
        "/clients" => "bi bi-person-vcard-fill",
        "/emisor" => "bi bi-building-fill-gear",
        "/users" => "bi bi-people",
        "/roles" => "bi bi-shield-lock-fill",
        "/menus" => "bi bi-menu-button-wide-fill",
        "/profile" => "bi bi-person-circle",
        "/register" => "bi bi-person-add",
        "/setup-2fa" => "bi bi-shield-fill-check",
        _ => "bi bi-link-45deg"
    };
}
