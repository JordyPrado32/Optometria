@inject AuthenticationStateProvider AuthenticationStateProvider
@inject MenuAccessService MenuAccessService

<div class="app-nav-shell">
    <button type="button" class="app-nav-toggle" @onclick="ToggleMenu" aria-label="Abrir menu">
        <span></span>
        <span></span>
        <span></span>
    </button>

    <nav class="app-nav @(menuOpen ? "is-open" : string.Empty)">
        <div class="app-nav-scroll">
            @foreach (var group in menuGroups.Where(group => group.Items.Count > 0))
            {
                <section class="app-nav-group">
                    <header class="app-nav-group-header">
                        <span>@group.Title</span>
                        <small>@group.Description</small>
                    </header>

                    <div class="app-nav-links">
                        @foreach (var menu in group.Items)
                        {
                            <NavLink class="app-nav-link" href="@menu.Ruta" Match="@(menu.Ruta == "/dashboard" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                                <span class="app-nav-link-mark @GetMenuIconClass(menu.Ruta)">@GetMenuIconLabel(menu.Ruta)</span>
                                <span class="app-nav-link-copy">
                                    <strong>@menu.Nombre</strong>
                                    <small>@GetMenuDescription(menu.Ruta)</small>
                                </span>
                            </NavLink>
                        }
                    </div>
                </section>
            }
        </div>

        <aside class="app-account-panel">
            <div class="app-account-panel-copy">
                <span>@RoleName</span>
                <strong>@UserName</strong>
                <small>Sesion con permisos filtrados</small>
            </div>

            <div class="app-account-panel-grid">
                <a class="app-account-utility" href="/profile">Perfil</a>
                <a class="app-account-utility" href="/setup-2fa">Seguridad</a>
            </div>

            <a class="app-account-link" href="/auth/logout">Cerrar sesion</a>
        </aside>
    </nav>
</div>

@code {
    private readonly List<AppMenuItem> menus = [];
    private readonly List<MenuGroup> menuGroups = [];
    private bool menuOpen;
    private string UserName { get; set; } = "Cuenta";
    private string RoleName { get; set; } = "Sesion";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        UserName = user.Identity?.Name ?? "Cuenta";
        RoleName = user.FindFirst(ClaimTypes.Role)?.Value ?? "Sesion";

        var roleIdValue = user.FindFirst("RoleId")?.Value;
        int? roleId = int.TryParse(roleIdValue, out var parsedRoleId) ? parsedRoleId : null;

        menus.AddRange(await MenuAccessService.GetMenusForRoleAsync(roleId));
        BuildMenuGroups();
    }

    private void BuildMenuGroups()
    {
        menuGroups.Clear();
        menuGroups.Add(CreateGroup("Principal", "Vista general", "/dashboard"));
        menuGroups.Add(CreateGroup("Operacion", "Trabajo diario", "/patients", "/doctor/patient-entry", "/doctor/my-patients", "/laboratories", "/suppliers", "/users"));
        menuGroups.Add(CreateGroup("Control", "Reglas del sistema", "/roles", "/menus", "/register", "/setup-2fa"));
        menuGroups.Add(CreateGroup("Cuenta", "Espacio personal", "/profile"));
    }

    private MenuGroup CreateGroup(string title, string description, params string[] routes)
    {
        var items = menus
            .Where(menu => routes.Contains(menu.Ruta, StringComparer.OrdinalIgnoreCase))
            .OrderBy(menu => menu.Orden)
            .ToList();

        return new MenuGroup(title, description, items);
    }

    private void ToggleMenu()
    {
        menuOpen = !menuOpen;
    }

    private static string GetMenuDescription(string route) => route switch
    {
        "/dashboard" => "Resumen del panel",
        "/patients" => "Gestion de pacientes",
        "/doctor/patient-entry" => "Alta clinica propia",
        "/doctor/my-patients" => "Cartera asignada",
        "/laboratories" => "Gestion de laboratorios",
        "/suppliers" => "Gestion de proveedores",
        "/users" => "Gestion de usuarios",
        "/roles" => "Roles y permisos",
        "/menus" => "Navegacion del sistema",
        "/profile" => "Datos de la cuenta",
        "/register" => "Alta de cuentas",
        "/setup-2fa" => "Segundo factor",
        _ => "Modulo disponible"
    };

    private static string GetMenuIconLabel(string route) => route switch
    {
        "/dashboard" => "DB",
        "/patients" => "PC",
        "/doctor/patient-entry" => "IP",
        "/doctor/my-patients" => "MP",
        "/laboratories" => "LB",
        "/suppliers" => "PR",
        "/users" => "US",
        "/roles" => "RL",
        "/menus" => "MN",
        "/profile" => "PF",
        "/register" => "RG",
        "/setup-2fa" => "2F",
        _ => "MD"
    };

    private static string GetMenuIconClass(string route) => route switch
    {
        "/dashboard" => "is-dashboard",
        "/patients" => "is-patients",
        "/doctor/patient-entry" => "is-patients",
        "/doctor/my-patients" => "is-patients",
        "/laboratories" => "is-laboratories",
        "/suppliers" => "is-suppliers",
        "/users" => "is-users",
        "/roles" => "is-roles",
        "/menus" => "is-menus",
        "/profile" => "is-profile",
        "/register" => "is-register",
        "/setup-2fa" => "is-security",
        _ => string.Empty
    };

    private sealed record MenuGroup(string Title, string Description, List<AppMenuItem> Items);
}
