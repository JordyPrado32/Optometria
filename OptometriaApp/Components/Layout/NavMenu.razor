@inject AuthenticationStateProvider AuthenticationStateProvider
@inject MenuAccessService MenuAccessService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<div class="app-nav-shell">
    <button type="button" class="app-nav-toggle" @onclick="ToggleMenu" aria-label="Abrir menu">
        <span></span>
        <span></span>
        <span></span>
    </button>

    <nav class="app-nav @(menuOpen ? "is-open" : string.Empty)">
        <div class="app-nav-scroll">
            <div class="app-nav-links">
                @foreach (var item in RenderItems)
                {
                    @if (item.IsPurchasesGroup)
                    {
                        <div class="app-nav-group @(purchasesExpanded ? "is-expanded" : "")">
                            <button type="button" class="app-nav-link app-nav-group-trigger" @onclick="TogglePurchases">
                                <span class="app-nav-link-mark">
                                    <i class="bi bi-bag-check-fill"></i>
                                </span>
                                <span class="app-nav-link-copy">
                                    <strong>Compras</strong>
                                </span>
                                <span class="app-nav-group-chevron">
                                    <i class="bi @(purchasesExpanded ? "bi-dash-lg" : "bi-plus-lg")"></i>
                                </span>
                            </button>

                            <div class="app-nav-group-children">
                                @foreach (var child in childMenus)
                                {
                                    <NavLink class="app-nav-link app-nav-child-link" href="@child.Ruta" Match="NavLinkMatch.Prefix">
                                        <span class="app-nav-link-copy">
                                            <span>@child.Nombre</span>
                                        </span>
                                    </NavLink>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <NavLink class="app-nav-link" href="@item.MenuItem!.Ruta" Match="@(item.MenuItem.Ruta == "/dashboard" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                            <span class="app-nav-link-mark">
                                <i class="@GetMenuIconClass(item.MenuItem.Ruta)"></i>
                            </span>
                            <span class="app-nav-link-copy">
                                <strong>@item.MenuItem.Nombre</strong>
                            </span>
                        </NavLink>
                    }
                }
            </div>
        </div>
    </nav>
</div>

@code {
    public class NavigationItemWrapper
    {
        public AppMenuItem? MenuItem { get; set; }
        public bool IsPurchasesGroup { get; set; }
        public int Order { get; set; }
    }

    private readonly List<NavigationItemWrapper> RenderItems = [];
    private readonly List<AppMenuItem> childMenus = [];
    private AppMenuItem? purchasesParentMenu;
    private bool purchasesExpanded;
    private bool menuOpen;
    private string UserName { get; set; } = "Cuenta";
    private string RoleName { get; set; } = "Sesion";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        UserName = user.Identity?.Name ?? "Cuenta";
        RoleName = user.FindFirst(ClaimTypes.Role)?.Value ?? "Sesion";

        var roleIdValue = user.FindFirst("RoleId")?.Value;
        int? roleId = int.TryParse(roleIdValue, out var parsedRoleId) ? parsedRoleId : null;

        var rawMenus = await MenuAccessService.GetMenusForRoleAsync(roleId);

        // Find purchases parent
        purchasesParentMenu = rawMenus.FirstOrDefault(m => m.Ruta.Equals("/purchases", StringComparison.OrdinalIgnoreCase));

        // Find child menus
        var childPaths = new[] { "/purchase-orders", "/purchase-receptions", "/purchase-liquidations", "/inventories", "/kardex" };
        var rawChildren = rawMenus.Where(m => childPaths.Contains(m.Ruta.ToLowerInvariant())).ToList();

        // Main list (filter out children and parent)
        var mainList = rawMenus.Where(m => 
            !childPaths.Contains(m.Ruta.ToLowerInvariant()) && 
            !m.Ruta.Equals("/purchases", StringComparison.OrdinalIgnoreCase)
        ).ToList();

        childMenus.AddRange(rawChildren.OrderBy(m => GetRouteOrder(m.Ruta)));

        // Populate wrapper items
        foreach (var menu in mainList)
        {
            RenderItems.Add(new NavigationItemWrapper 
            { 
                MenuItem = menu, 
                IsPurchasesGroup = false, 
                Order = GetRouteOrder(menu.Ruta) 
            });
        }

        if (purchasesParentMenu is not null || childMenus.Any())
        {
            RenderItems.Add(new NavigationItemWrapper 
            { 
                MenuItem = purchasesParentMenu ?? new AppMenuItem { Nombre = "Compras", Ruta = "/purchases" }, 
                IsPurchasesGroup = true, 
                Order = GetRouteOrder("/purchases") 
            });
        }

        // Sort items by route order
        var sorted = RenderItems.OrderBy(item => item.Order).ToList();
        RenderItems.Clear();
        RenderItems.AddRange(sorted);

        // Auto-expand purchases group if we are currently on one of the child pages
        var currentUri = NavigationManager.Uri;
        var relativePath = "/" + NavigationManager.ToBaseRelativePath(currentUri).ToLowerInvariant();
        if (childPaths.Any(p => relativePath.Contains(p)))
        {
            purchasesExpanded = true;
        }
    }

    private void ToggleMenu()
    {
        menuOpen = !menuOpen;
    }

    private void TogglePurchases()
    {
        purchasesExpanded = !purchasesExpanded;
    }

    private static int GetRouteOrder(string route) => route switch
    {
        "/dashboard" => 1,
        "/patients" => 2,
        "/doctor/patient-entry" => 3,
        "/doctor/my-patients" => 4,
        "/appointments" => 5,
        "/appointment-availability" => 6,
        "/doctors" => 7,
        "/laboratories" => 8,
        "/suppliers" => 9,
        "/products" => 10,
        "/product-categories" => 11,
        "/purchases" => 12,
        "/purchase-orders" => 13,
        "/purchase-receptions" => 14,
        "/purchase-liquidations" => 15,
        "/inventories" => 16,
        "/kardex" => 17,
        "/clients" => 18,
        "/emisor" => 19,
        "/my-invoices" => 20,
        "/my-credit-notes" => 21,
        "/accounts-receivable" => 22,
        "/users" => 23,
        "/roles" => 24,
        "/menus" => 25,
        "/register" => 26,
        "/setup-2fa" => 27,
        "/profile" => 28,
        _ => 100
    };

    private static string GetMenuCategory(string route) => route switch
    {
        "/dashboard" or "/patients" or "/doctor/patient-entry" or "/doctor/my-patients" or "/appointments" or "/appointment-availability" or "/doctors" or "/laboratories" => "Clinica",
        "/clients" or "/emisor" or "/invoices" or "/my-invoices" or "/my-credit-notes" or "/accounts-receivable" => "Comercial",
        "/products" or "/product-categories" or "/suppliers" or "/purchases" or "/purchase-orders" or "/purchase-receptions" or "/purchase-liquidations" or "/inventories" or "/kardex" => "Inventario",
        _ => "Configuracion"
    };

    private static string GetMenuIconClass(string route) => route switch
    {
        "/dashboard" => "bi bi-grid-1x2-fill",
        "/patients" => "bi bi-people-fill",
        "/doctor/patient-entry" => "bi bi-person-plus-fill",
        "/doctor/my-patients" => "bi bi-journal-medical",
        "/appointments" => "bi bi-calendar2-check-fill",
        "/appointment-availability" => "bi bi-calendar-week-fill",
        "/doctors" => "bi bi-person-badge-fill",
        "/laboratories" => "bi bi-clipboard2-pulse-fill",
        "/suppliers" => "bi bi-truck",
        "/products" => "bi bi-box-seam-fill",
        "/product-categories" => "bi bi-tags-fill",
        "/purchases" => "bi bi-bag-check-fill",
        "/purchase-orders" => "bi bi-file-earmark-text-fill",
        "/purchase-receptions" => "bi bi-box-arrow-in-down",
        "/purchase-liquidations" => "bi bi-receipt-cutoff",
        "/inventories" => "bi bi-boxes",
        "/kardex" => "bi bi-journal-text",
        "/clients" => "bi bi-person-vcard-fill",
        "/emisor" => "bi bi-building-fill-gear",
        "/my-invoices" => "bi bi-receipt",
        "/my-credit-notes" => "bi bi-arrow-counterclockwise",
        "/accounts-receivable" => "bi bi-cash-coin",
        "/users" => "bi bi-people",
        "/roles" => "bi bi-shield-lock-fill",
        "/menus" => "bi bi-menu-button-wide-fill",
        "/profile" => "bi bi-person-circle",
        "/register" => "bi bi-person-add",
        "/setup-2fa" => "bi bi-shield-fill-check",
        _ => "bi bi-link-45deg"
    };
}
