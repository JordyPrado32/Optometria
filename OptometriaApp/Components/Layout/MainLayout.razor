    private string FormatPageTitle(string path)
    {
        if (string.IsNullOrWhiteSpace(path)) return "Dashboard";
        var parts = path.Split('/');
        var lastPart = parts[^1];
        if (string.IsNullOrWhiteSpace(lastPart)) return "Dashboard";
        
        return char.ToUpper(lastPart[0]) + lastPart.Substring(1);
    }

    private async Task LoadUserProfileAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                var userIdValue = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                if (int.TryParse(userIdValue, out var userId))
                {
                    CurrentUserId = userId;
                    await using var dbContext = await DbContextFactory.CreateDbContextAsync();
                    var profile = await dbContext.tbl_usuarios
                        .AsNoTracking()
                        .Include(u => u.id_rolNavigation)
                        .FirstOrDefaultAsync(u => u.id_usuario == userId);
                    if (profile is not null)
                    {
                        UserFullName = $"{profile.nombres} {profile.apellidos}".Trim();
                        if (string.IsNullOrWhiteSpace(UserFullName))
                        {
                            UserFullName = profile.usuario;
                        }
                        UserRoleName = profile.id_rolNavigation?.nombre ?? "Usuario";
                        
                        var avatarFile = string.IsNullOrWhiteSpace(profile.avatar_url) ? "l_sin_lentes.png" : System.IO.Path.GetFileName(profile.avatar_url);
                        UserAvatarUrl = $"/images/avatars/{avatarFile}";
                    }
                    else
                    {
                        UserFullName = user.Identity.Name ?? "Usuario";
                        UserRoleName = user.FindFirst(ClaimTypes.Role)?.Value ?? "Usuario";
                    }
                }
                else
                {
                    UserFullName = user.Identity.Name ?? "Usuario";
                    UserRoleName = user.FindFirst(ClaimTypes.Role)?.Value ?? "Usuario";
                }
            }
            else
            {
                UserFullName = "Invitado";
                UserRoleName = "Sesión";
            }
        }
        catch (Exception)
        {
            UserFullName = "Usuario";
            UserRoleName = "Usuario";
        }
    }

    private async Task LoadBrandingAsync()
    {
        try
        {
            var settings = await CustomizationService.GetSettingsAsync();
            BrandName = string.IsNullOrWhiteSpace(settings.nombre_comercial) ? "Optica Lux" : settings.nombre_comercial!;
            BrandLogoUrl = NormalizeAssetPath(settings.ruta_logo);

            var backgroundUrl = NormalizeAssetPath(settings.ruta_fondo);
            AppShellStyle = string.IsNullOrWhiteSpace(backgroundUrl)
                ? string.Empty
                : $"background-image: linear-gradient(rgba(255,250,244,0.93), rgba(255,250,244,0.93)), url('{backgroundUrl}'); background-size: cover; background-position: center;";
        }
        catch
        {
            BrandName = "Optica Lux";
            BrandLogoUrl = string.Empty;
            AppShellStyle = string.Empty;
        }
    }

    private static string NormalizeAssetPath(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var trimmed = value.Trim();
        if (trimmed.StartsWith("http", StringComparison.OrdinalIgnoreCase) || trimmed.StartsWith("/", StringComparison.Ordinal))
        {
            return trimmed;
        }

        return $"/{trimmed.TrimStart('~', '/', '\\').Replace("\\", "/", StringComparison.Ordinal)}";
    }

    private async Task LoadNotificationsAsync()
    {
        if (CurrentUserId <= 0)
        {
            UnreadNotificationsCount = 0;
            HeaderNotifications = [];
            return;
        }

        UnreadNotificationsCount = await NotificationService.GetUnreadCountAsync(CurrentUserId);
        HeaderNotifications = await NotificationService.GetRecentForUserAsync(CurrentUserId, 8);
    }

    private void ToggleNotificationsPanel()
    {
        ShowNotificationsPanel = !ShowNotificationsPanel;

        if (ShowNotificationsPanel)
        {
            _ = RefreshNotificationsPanelAsync();
        }
    }

    private void CloseNotificationsPanel()
    {
        ShowNotificationsPanel = false;
    }

    private async Task RefreshNotificationsPanelAsync()
    {
        try
        {
            await LoadNotificationsAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            ShowNotificationsPanel = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenHeaderNotificationAsync(tbl_notificacion notification)
    {
        await NotificationService.MarkAsReadAsync(CurrentUserId, notification.id_notificacion);
        await LoadNotificationsAsync();
        ShowNotificationsPanel = false;
        if (!string.IsNullOrWhiteSpace(notification.ruta_destino))
        {
            NavigationManager.NavigateTo(notification.ruta_destino);
        }
    }

    private async Task DeleteHeaderNotificationAsync(int notificationId)
    {
        await NotificationService.DeleteAsync(CurrentUserId, notificationId);
        await LoadNotificationsAsync();
    }

    private async Task MarkAllHeaderNotificationsAsReadAsync()
    {
        await NotificationService.MarkAllAsReadAsync(CurrentUserId);
        await LoadNotificationsAsync();
    }

    private static string GetNotificationIcon(string? type) => type?.ToLowerInvariant() switch
    {
        "transferencia" or "gestion tienda online" => "bi-shop-window",
        "pago" => "bi-cash-stack",
        "cita" => "bi-calendar-check",
        "exito" => "bi-check2-circle",
        "error" => "bi-x-circle",
        _ => "bi-bell"
    };

    private static string FormatNotificationDate(DateTime createdAt)
    {
        var elapsed = DateTime.Now - createdAt;
        if (elapsed.TotalMinutes < 1)
        {
            return "Hace un momento";
        }

        if (elapsed.TotalHours < 1)
        {
            return $"Hace {Math.Max(1, (int)elapsed.TotalMinutes)} min";
        }

        if (elapsed.TotalDays < 1)
        {
            return $"Hace {Math.Max(1, (int)elapsed.TotalHours)} h";
        }

        if (elapsed.TotalDays < 7)
        {
            return $"Hace {Math.Max(1, (int)elapsed.TotalDays)} dias";
        }

        return createdAt.ToString("yyyy-MM-dd HH:mm");
    }

