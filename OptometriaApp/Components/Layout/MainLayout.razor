@inherits LayoutComponentBase
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject NavigationManager NavigationManager
@inject OpticaCustomizationService CustomizationService
@inject NotificationService NotificationService
@using OptometriaApp.Models
@implements IDisposable

<div class="app-shell" style="@AppShellStyle">
    <div class="app-frame app-dashboard-frame">
        <aside class="app-sidebar">
            <a class="app-brand" href="/dashboard">
                <svg class="optica-logo-svg" viewBox="0 0 100 60" width="42" height="26" xmlns="http://www.w3.org/2000/svg">
                    <path d="M 5,30 C 25,10 75,10 95,30 C 75,50 25,50 5,30 Z" stroke="#5DA181" stroke-width="6" fill="none" stroke-linejoin="round"/>
                    <circle cx="50" cy="30" r="16" stroke="#7F6951" stroke-width="6" fill="#F4F0E4" />
                    <line x1="61" y1="41" x2="72" y2="52" stroke="#7F6951" stroke-width="6" stroke-linecap="round" />
                    <circle cx="50" cy="30" r="9" fill="#5DA181" />
                    <circle cx="50" cy="30" r="4.5" fill="#3c4e43" />
                    <circle cx="47" cy="27" r="2.2" fill="#fff" />
                </svg>
                <span class="app-brand-copy">
                    <span class="logo-text-optica">Óptica</span><span class="logo-text-lux">Lux</span>
                </span>
            </a>

            <NavMenu />
        </aside>

        <div class="app-content">
            <header class="app-header">
                <div class="app-header-frame">
                    <div class="app-header-left">
                        <span class="header-page-title">@CurrentPageTitle</span>
                    </div>
                    <div class="app-header-right">
                        <div class="header-notification-wrap">
                            <button type="button" class="header-notification-btn" aria-label="Notificaciones" @onclick="ToggleNotificationsPanel">
                                <i class="bi bi-bell-fill"></i>
                                @if (UnreadNotificationsCount > 0)
                                {
                                    <span class="notification-badge">@UnreadNotificationsCount</span>
                                }
                            </button>

                            @if (ShowNotificationsPanel)
                            {
                                <div class="header-notification-backdrop" @onclick="CloseNotificationsPanel"></div>
                                <div class="header-notification-popover" @onclick:stopPropagation="true">
                                    <div class="header-notification-popover-header">
                                        <div>
                                            <strong>Notificaciones</strong>
                                            <span>@UnreadNotificationsCount sin leer</span>
                                        </div>
                                        <div class="header-notification-popover-actions">
                                            <button type="button" class="header-notification-link" @onclick="MarkAllHeaderNotificationsAsReadAsync">Marcar leidas</button>
                                            <button type="button" class="header-notification-close" aria-label="Cerrar notificaciones" title="Cerrar" @onclick="CloseNotificationsPanel">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="header-notification-popover-body">
                                        @if (HeaderNotifications.Count == 0)
                                        {
                                            <div class="header-notification-empty">No tienes notificaciones por ahora.</div>
                                        }
                                        else
                                        {
                                            @foreach (var item in HeaderNotifications)
                                            {
                                                <article class="header-notification-item @(item.leida ? string.Empty : "is-unread")">
                                                    <button type="button" class="header-notification-open" @onclick="() => OpenHeaderNotificationAsync(item)">
                                                        <span class="header-notification-item-icon">
                                                            <i class="bi @(GetNotificationIcon(item.tipo))"></i>
                                                        </span>
                                                        <span class="header-notification-item-copy">
                                                            <small>@(string.IsNullOrWhiteSpace(item.modulo_origen) ? "Sistema" : item.modulo_origen)</small>
                                                            <strong>@item.titulo</strong>
                                                            <span>@item.mensaje</span>
                                                            <time>@FormatNotificationDate(item.fecha_creacion)</time>
                                                        </span>
                                                    </button>
                                                    <button type="button" class="header-notification-delete" title="Eliminar" @onclick="() => DeleteHeaderNotificationAsync(item.id_notificacion)">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </article>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        
                        <div class="header-profile-divider"></div>
                        
                        <a class="header-user-profile" href="/perfil">
                            <img src="@UserAvatarUrl" alt="Avatar del usuario" class="header-avatar" />
                            <div class="header-user-info">
                                <span class="header-username">@UserFullName</span>
                                <span class="header-userrole">@UserRoleName</span>
                            </div>
                        </a>
                        
                        <div class="header-profile-divider"></div>
                        
                        <a class="header-logout-btn" href="/auth/logout" aria-label="Cerrar sesión">
                            <i class="bi bi-box-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </header>

            <main class="app-main">
                <article class="app-stage">
                    @Body
                </article>
            </main>

            <footer class="app-footer">
                <div class="footer-content">
                    <svg class="optica-logo-svg" viewBox="0 0 100 60" width="30" height="18" xmlns="http://www.w3.org/2000/svg">
                        <path d="M 5,30 C 25,10 75,10 95,30 C 75,50 25,50 5,30 Z" stroke="#5DA181" stroke-width="6" fill="none" stroke-linejoin="round"/>
                        <circle cx="50" cy="30" r="16" stroke="#7F6951" stroke-width="6" fill="#F4F0E4" />
                        <line x1="61" y1="41" x2="72" y2="52" stroke="#7F6951" stroke-width="6" stroke-linecap="round" />
                        <circle cx="50" cy="30" r="9" fill="#5DA181" />
                        <circle cx="50" cy="30" r="4.5" fill="#3c4e43" />
                        <circle cx="47" cy="27" r="2.2" fill="#fff" />
                    </svg>
                    <span class="footer-brand">Óptica Lux</span>
                    <span class="footer-divider">|</span>
                    <span class="footer-copy">&copy; Derechos Reservados 2026</span>
                </div>
            </footer>
        </div>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">X</span>
</div>

