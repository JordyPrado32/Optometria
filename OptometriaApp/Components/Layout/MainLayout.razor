</style>

@code {
    private string CurrentPageTitle { get; set; } = "Dashboard";
    private string UserFullName { get; set; } = string.Empty;
    private string UserRoleName { get; set; } = string.Empty;
    private string UserAvatarUrl { get; set; } = "/images/avatars/l_sin_lentes.png";
    private string BrandName { get; set; } = "Optica Lux";
    private string AppShellStyle { get; set; } = string.Empty;
    private string BrandLogoUrl { get; set; } = string.Empty;
    private int CurrentUserId { get; set; }
    private int UnreadNotificationsCount { get; set; }
    private bool ShowNotificationsPanel { get; set; }
    private List<tbl_notificacion> HeaderNotifications { get; set; } = [];
    private string BrandNamePrimary => BrandName.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Optica";
    private string BrandNameSecondary => BrandName.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries).Skip(1).FirstOrDefault() ?? string.Empty;

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        UpdatePageTitle();
        await LoadUserProfileAsync();
        await LoadNotificationsAsync();
        await LoadBrandingAsync();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdatePageTitle();
        await LoadNotificationsAsync();
        ShowNotificationsPanel = false;
        StateHasChanged();
    }

    private void UpdatePageTitle()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        
        // Normalize path
        if (relativePath.Contains('?'))
        {
            relativePath = relativePath.Substring(0, relativePath.IndexOf('?'));
        }
        if (relativePath.Contains('#'))
        {
            relativePath = relativePath.Substring(0, relativePath.IndexOf('#'));
        }

        // Map path to friendly names
        CurrentPageTitle = relativePath.ToLowerInvariant() switch
        {
            "" or "dashboard" => "Dashboard",
            "profile" or "perfil" => "Mi Perfil",
            "patients" or "pacientes" => "Pacientes",
            "doctor/patient-entry" or "doctor/ingresar-pacientes" => "Ingresar Pacientes",
            "doctor/my-patients" or "doctor/mis-pacientes" => "Ver Mis Pacientes",
            "appointments" or "citas" => "Citas",
            "appointment-availability" or "disponibilidad-medica" => "Disponibilidad Médica",
            "doctors" or "doctores" => "Doctores",
            "laboratories" or "laboratorios" => "Laboratorios",
            "lab-orders" or "pedidos-laboratorio" => "Pedidos a Laboratorio",
            "suppliers" or "proveedores" => "Proveedores",
            "clients" or "clientes" => "Clientes",
            "products" or "productos" => "Productos",
            "product-categories" or "categorias-de-productos" => "Categorías de Productos",
            "purchase-orders" or "ordenes-de-compra" => "Órdenes de Compra",
            "purchase-receptions" or "recepciones-de-compra" => "Recepciones de Compra",
            "purchase-liquidations" or "liquidaciones-de-compra" => "Liquidaciones de Compra",
            "inventories" or "inventarios" => "Inventarios",
            "kardex" => "Kardex",
            "invoices" or "facturas" => "Facturas",
            "my-invoices" or "mis-facturas" => "Mis Facturas",
