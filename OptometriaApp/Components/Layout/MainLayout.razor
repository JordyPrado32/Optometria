@code {
    private string CurrentPageTitle { get; set; } = "Dashboard";
    private string UserFullName { get; set; } = "Cargando...";
    private string UserRoleName { get; set; } = "Cargando...";
    private string UserAvatarUrl { get; set; } = "/images/avatars/l_sin_lentes.png";

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        UpdatePageTitle();
        await LoadUserProfileAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdatePageTitle();
        StateHasChanged();
    }

    private void UpdatePageTitle()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        
        // Normalize path
        if (relativePath.Contains('?'))
        {
            relativePath = relativePath.Substring(0, relativePath.IndexOf('?'));
        }
        if (relativePath.Contains('#'))
        {
            relativePath = relativePath.Substring(0, relativePath.IndexOf('#'));
        }

        // Map path to friendly names
        CurrentPageTitle = relativePath.ToLowerInvariant() switch
        {
            "" or "dashboard" => "Dashboard",
            "profile" => "Mi Perfil",
            "patients" => "Pacientes",
            "doctor/patient-entry" => "Ingresar Pacientes",
            "doctor/my-patients" => "Ver Mis Pacientes",
            "laboratories" => "Laboratorios",
            "suppliers" => "Proveedores",
            "users" => "Usuarios",
            "roles" => "Roles",
            "menus" => "Menús",
            "register" => "Registrar Usuario",
            "setup-2fa" => "Seguridad (2FA)",
            _ => FormatPageTitle(relativePath)
        };
    }

    private string FormatPageTitle(string path)
    {
        if (string.IsNullOrWhiteSpace(path)) return "Dashboard";
        var parts = path.Split('/');
        var lastPart = parts[^1];
        if (string.IsNullOrWhiteSpace(lastPart)) return "Dashboard";
        
        return char.ToUpper(lastPart[0]) + lastPart.Substring(1);
    }

    private async Task LoadUserProfileAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                var userIdValue = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                if (int.TryParse(userIdValue, out var userId))
                {
                    await using var dbContext = await DbContextFactory.CreateDbContextAsync();
                    var profile = await dbContext.tbl_usuarios
                        .AsNoTracking()
                        .Include(u => u.id_rolNavigation)
                        .FirstOrDefaultAsync(u => u.id_usuario == userId);
                    if (profile is not null)
                    {
                        UserFullName = $"{profile.nombres} {profile.apellidos}".Trim();
                        if (string.IsNullOrWhiteSpace(UserFullName))
                        {
                            UserFullName = profile.usuario;
                        }
                        UserRoleName = profile.id_rolNavigation?.nombre ?? "Usuario";
                        
                        var avatarFile = string.IsNullOrWhiteSpace(profile.avatar_url) ? "l_sin_lentes.png" : System.IO.Path.GetFileName(profile.avatar_url);
                        UserAvatarUrl = $"/images/avatars/{avatarFile}";
                    }
                    else
                    {
                        UserFullName = user.Identity.Name ?? "Usuario";
                        UserRoleName = user.FindFirst(ClaimTypes.Role)?.Value ?? "Usuario";
                    }
                }
                else
                {
                    UserFullName = user.Identity.Name ?? "Usuario";
                    UserRoleName = user.FindFirst(ClaimTypes.Role)?.Value ?? "Usuario";
                }
            }
            else
            {
                UserFullName = "Invitado";
                UserRoleName = "Sesión";
            }
        }
        catch (Exception)
        {
            UserFullName = "Usuario";
            UserRoleName = "Usuario";
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

