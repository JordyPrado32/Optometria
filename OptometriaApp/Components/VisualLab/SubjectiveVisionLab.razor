@using System.Globalization
<div class="vl-workspace vl-perception">
    <aside class="vl-panel"><section><h2>Condición visual</h2><div class="vl-condition-list">@foreach(var c in conditions) { <button class="@(condition == c ? "selected" : "")" @onclick="() => condition = c"><i class="bi bi-eye"></i>@c</button> }</div></section><section><label for="vision-intensity">Intensidad <output>@intensity.ToString("0") / 6</output></label><input id="vision-intensity" type="range" min="0" max="6" step=".25" @bind="intensity" @bind:event="oninput" /><div class="vl-range-ends"><span>Leve</span><span>Alta</span></div></section><section><h2>Escenario</h2><div class="vl-scenario-grid">@foreach(var s in scenarios) { <button class="@(scenario == s ? "selected" : "")" @onclick="() => scenario = s"><span class="vl-scenario-thumb" style="@($"background-image:url('{ImageFor(s)}');filter:{(s == "Noche" ? "brightness(.5)" : "none")}")"></span>@s</button> }</div></section></aside>
    <main class="vl-main"><BeforeAfterComparator Source="@Image" BeforeStyle="@Effect" AfterStyle="@BaseEffect" /><div class="vl-guidance"><span><i class="bi bi-info-circle"></i></span><p>@(Guided ? "Mueve el divisor y cambia de condición para explorar los detalles que dejan de distinguirse." : "Compara el mismo encuadre. El efecto es ilustrativo y no reproduce exactamente la visión de una persona.")</p></div><div class="vl-example-strip"><strong>Observa los pequeños detalles</strong><span>Contornos</span><span>Luces</span><span>Texturas</span><span>Distancias</span></div></main>
    <aside class="vl-insights-panel"><div class="vl-panel"><h2>@condition</h2><p>@Description</p><div class="vl-insight"><i class="bi bi-bullseye"></i><small>@Hint</small></div></div><div class="vl-panel vl-test-cta"><i class="bi bi-eye"></i><h2>Conoce tu agudeza visual</h2><p>Una experiencia orientativa, paso a paso y por ojo.</p><a class="vl-primary" href="/visual-acuity-test">Realizar test <i class="bi bi-arrow-right"></i></a></div></aside>
</div>
@code {
    [Parameter] public bool Guided { get; set; }
    private string condition = "Miopía", scenario = "Calle";
    private double intensity = 2.5;
    private readonly string[] conditions = ["Visión normal","Miopía","Hipermetropía","Astigmatismo","Presbicia","Fatiga digital"];
    private readonly string[] scenarios = ["Calle","Noche","Lectura","Pantalla","Paisaje"];
    private string Image => ImageFor(scenario);
    private static string ImageFor(string scenario) => scenario switch { "Lectura" => "/images/visual-lab/reading.svg", "Pantalla" => "/images/visual-lab/screen.svg", "Paisaje" => "/images/visual-lab/landscape.png", _ => "/images/visual-lab/street.png" };
    private string BaseEffect => scenario == "Noche" ? "filter:brightness(.55) saturate(.75);" : "";
    private string Effect {
        get {
            var near = scenario is "Lectura" or "Pantalla";
            var blur = condition switch { "Visión normal" => 0, "Miopía" => intensity * (near ? .3 : 1.4), "Hipermetropía" => intensity * (near ? 1.3 : .6), "Presbicia" => near ? intensity * 1.4 : 0, "Fatiga digital" => intensity * .35, _ => intensity * .55 };
            return FormattableString.Invariant($"filter:blur({blur:0.00}px) brightness({(scenario == "Noche" ? .55 : 1)}) contrast({(condition == "Fatiga digital" ? .85 : 1)});") + (condition == "Astigmatismo" ? "transform:scale(1.03) skewX(.6deg);" : "");
        }
    }
    private string Description => condition switch { "Miopía" => "Los detalles lejanos pierden definición: fachadas, señales y rostros.", "Hipermetropía" => "El esfuerzo de enfoque puede ser más evidente al mirar de cerca.", "Astigmatismo" => "Los contornos pueden percibirse borrosos o distorsionados en distintas direcciones.", "Presbicia" => "Los detalles de cerca se vuelven más difíciles de enfocar.", "Fatiga digital" => "La comodidad y la nitidez pueden fluctuar al utilizar pantallas.", _ => "Imagen de referencia sin efectos añadidos." };
    private string Hint => scenario == "Noche" ? "Observa el contorno de las luces y los detalles en sombra." : "Observa qué detalles distingues a ambos lados del divisor.";
}
