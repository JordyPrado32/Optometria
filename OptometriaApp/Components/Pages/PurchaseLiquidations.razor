@page "/liquidaciones-de-compra"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject NavigationManager NavigationManager

<PageTitle>Liquidaciones de compra</PageTitle>

@if (isLoading)
{
    <section class="management-shell"><div class="management-card"><h1>Cargando liquidaciones...</h1></div></section>
}
else if (!canView)
{
    <section class="management-shell"><div class="management-card"><h1>Sin acceso</h1></div></section>
}
else
{
    <section class="management-shell">
        <div class="management-hero">
            <div><span class="eyebrow">Compras</span><h1>Liquidaciones de compra</h1><p>Cada usuario gestiona sus liquidaciones asociadas a sus propias ordenes de compra.</p></div>
            <div class="workspace-actions" style="align-items: center;">
                @if (permissions.CanCreate)
                {
                    <button class="btn btn-coffee" @onclick="PrepareNew">
                        <i class="bi bi-plus-lg" style="margin-right: 6px;"></i> Nueva liquidacion
                    </button>
                }
                <button class="btn btn-excel" @onclick="ExportLiquidations">
                    <i class="bi bi-file-earmark-excel-fill" style="margin-right: 6px;"></i> Exportar Excel
                </button>
            </div>
        </div>

        <section class="management-card compact-filter-card">
            <div class="management-card-header"><h2>Filtros</h2><span>@FilteredItems.Count resultados</span></div>
            <div class="filters-row-2">
                <div>
                    <label class="form-label">Buscar</label>
                    <input class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Numero, orden, factura o autorizacion" />
                </div>
                <div class="filter-selects-col-2">
                    <div>
                        <label class="form-label">Estado</label>
                        <select class="form-select" @bind="stateFilter">
                            <option value="">Todos</option>
                            @foreach (var option in stateOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Orden</label>
                        <select class="form-select" @bind="orderFilter">
                            <option value="">Todas</option>
                            @foreach (var order in availableOrders.OrderByDescending(o => o.fecha_orden))
                            {
                                <option value="@order.id_orden_compra.ToString()">@order.numero_orden</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="management-actions" style="margin-top: 0.3rem;">
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ClearFilters" style="padding: 0.3rem 0.7rem !important; font-size: 0.78rem !important; border-color: rgba(127,105,81,0.25) !important;">
                    <i class="bi bi-trash" style="margin-right: 4px;"></i> Limpiar filtros
                </button>
            </div>
        </section>

        <section class="management-card" style="margin-top:1.5rem;">
            <div class="management-card-header"><h2>Liquidaciones</h2><span>@FilteredItems.Count</span></div>
            <div class="table-responsive" style="margin-top:1rem;">
                <table class="table table-hover">
                    <thead><tr><th>Numero</th><th>Orden</th><th>Factura</th><th>Estado</th><th>Total</th><th style="text-align:right;">Acciones</th></tr></thead>
                    <tbody>
                        @if (FilteredItems.Count == 0)
                        {
                            <tr><td colspan="6" style="text-align:center; padding:2rem;">No hay liquidaciones.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in PagedItems)
                            {
                                <tr>
                                    <td>@item.numero_liquidacion</td>
                                    <td>@item.id_orden_compraNavigation?.numero_orden</td>
                                    <td>@(item.numero_factura ?? "-")</td>
                                    <td>@item.estado_liquidacion</td>
                                    <td>@(item.total?.ToString("0.00") ?? "0.00")</td>
                                    <td style="text-align:right;">
                                        <div style="display:inline-flex; gap:0.4rem;">
                                            <button class="btn btn-outline-primary" @onclick="() => GenerateDocumentAsync(item)">
                                                <i class="bi bi-file-earmark-check" style="margin-right:4px;"></i> Documento
                                            </button>
                                            <button class="btn btn-outline-primary" @onclick="() => GoToRetention(item.id_liquidacion_compra)">
                                                <i class="bi bi-receipt" style="margin-right:4px;"></i> Retencion
                                            </button>
                                            <a class="btn btn-outline-primary" href="@($"/liquidaciones-de-compra/{item.id_liquidacion_compra}/abonos")">Abonos</a>
                                            <button disabled="@(!permissions.CanEdit)" class="btn btn-outline-primary" @onclick="() => PrepareEdit(item)">
                                                <i class="bi bi-pencil-fill"></i> Editar
                                            </button>
                                            @if (permissions.CanDelete)
                                            {
                                                <button class="btn btn-outline-primary" @onclick="() => pendingDelete = item">
                                                    <i class="bi bi-archive"></i> Archivar
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <TablePager TotalItems="@FilteredItems.Count" CurrentPage="@liquidationPage" CurrentPageChanged="SetLiquidationPage" />
        </section>
    </section>
}

@if (showForm && editor is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card form-modal-card">
            <header class="custom-modal-header rose-header"><h2>@(isCreating ? "Nueva liquidacion" : "Editar liquidacion")</h2><button class="btn-close-modal" @onclick="CloseForm">×</button></header>
            <div class="custom-modal-body">
                <p class="required-fields-note">Los campos marcados con * son obligatorios.</p>
                <div class="management-form-grid">
                    <div><label class="form-label">Numero liquidacion *</label><input class="form-control" @bind="editor.NumeroLiquidacion" /></div>
                    <div>
                        <label class="form-label">Buscar orden</label>
                        <input class="form-control" @bind="orderSearchTerm" @bind:event="oninput" placeholder="Escribe el numero de orden" />
                    </div>
                    <div>
                        <label class="form-label">Orden *</label>
                        <select class="form-select" @bind="editor.IdOrdenCompra">
                            <option value="0">Selecciona</option>
                            @foreach (var order in FilteredAvailableOrders)
                            {
                                <option value="@order.id_orden_compra">@order.numero_orden</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Estado</label>
                        <select class="form-select" @bind="editor.EstadoLiquidacion" disabled>
                            @foreach (var option in stateOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>

                    <details class="additional-details">
                        <summary><span><i class="bi bi-receipt-cutoff"></i> Comprobante</span></summary>
                        <div class="additional-details-body">
                            <div><label class="form-label">Factura</label><input class="form-control" @bind="editor.NumeroFactura" /></div>
                            <div><label class="form-label">Autorizacion</label><input class="form-control" @bind="editor.NumeroAutorizacion" /></div>
                        </div>
                    </details>

                    <details class="additional-details">
                        <summary><span><i class="bi bi-calculator"></i> Valores financieros</span></summary>
                        <div class="additional-details-body">
                            <div><label class="form-label">Subtotal</label><input type="number" step="0.01" class="form-control" @bind="editor.Subtotal" /></div>
                            <div><label class="form-label">Descuento</label><input type="number" step="0.01" class="form-control" @bind="editor.DescuentoTotal" /></div>
                            <div><label class="form-label">Impuesto</label><input type="number" step="0.01" class="form-control" @bind="editor.ImpuestoTotal" /></div>
                            <div><label class="form-label">Pagado</label><input type="number" step="0.01" class="form-control" @bind="editor.SaldoPagado" readonly /></div>
                        </div>
                    </details>

                    <details class="additional-details">
                        <summary><span><i class="bi bi-info-circle"></i> Detalles adicionales</span></summary>
                        <div class="additional-details-body is-single">
                            <div><label class="form-label">Observaciones</label><textarea class="form-control" rows="3" @bind="editor.Observaciones"></textarea></div>
                        </div>
                    </details>
                </div>
            </div>
            <footer class="custom-modal-footer"><button class="btn btn-primary" disabled="@saving" @onclick="SaveAsync">Guardar</button><button class="btn btn-outline-primary" @onclick="CloseForm">Cerrar</button></footer>
        </div>
    </div>
}

@if (pendingDelete is not null)
{
    <section class="management-card" role="alert">
        <h2>Archivar liquidacion @pendingDelete.numero_liquidacion</h2>
        <p>Se conservara su registro. No se puede archivar si tiene movimientos de pago.</p>
        <button class="btn btn-danger" @onclick="() => DeleteAsync(pendingDelete)">Confirmar archivo</button>
        <button class="btn btn-outline-primary" @onclick="() => pendingDelete = null">Cancelar</button>
    </section>
}
<StatusModal Visible="@showAlert"
             IsError="@alertIsError"
             Title="@alertTitle"
             Message="@alertMessage"
             ActionText="@(showRetentionAction && generatedDocumentLiquidationId > 0 ? "Ir a retencion" : null)"
             ActionIconClass="bi bi-receipt"
             OnAction="OpenRetentionFromAlert"
             OnClose="CloseAlert" />

@code {
    private readonly List<tbl_liquidacion_compra> items = [];
    private readonly List<tbl_orden_compra> availableOrders = [];
    private readonly string[] stateOptions = ["Pendiente", "Parcial", "Pagada"];
    private Permissions permissions = new();
    private LiquidationEditor? editor;
    private tbl_liquidacion_compra? pendingDelete;
    private bool saving;
    private bool isLoading = true, canView, isCreating, showForm, showAlert, alertIsError, showRetentionAction;
    private int currentUserId, currentRoleId, generatedDocumentLiquidationId;
    private string alertMessage = string.Empty, alertTitle = string.Empty, searchTerm = string.Empty, stateFilter = string.Empty, orderFilter = string.Empty, orderSearchTerm = string.Empty;

    private List<tbl_liquidacion_compra> FilteredItems => items.Where(MatchesFilters).ToList();
    private const int TablePageSize = 5;
    private int liquidationPage = 1;
    private int EffectiveLiquidationPage => Math.Min(liquidationPage, Math.Max(1, (int)Math.Ceiling(FilteredItems.Count / (double)TablePageSize)));
    private IEnumerable<tbl_liquidacion_compra> PagedItems => FilteredItems.Skip((EffectiveLiquidationPage - 1) * TablePageSize).Take(TablePageSize);
    private void SetLiquidationPage(int page) => liquidationPage = page;
    private IEnumerable<tbl_orden_compra> FilteredAvailableOrders => availableOrders.Where(MatchesOrderSearch).OrderByDescending(x => x.fecha_orden);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var uid) ? uid : 0;
        currentRoleId = int.TryParse(auth.User.FindFirst("RoleId")?.Value, out var rid) ? rid : 0;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        permissions = await GetPermissionsAsync(db);
        canView = permissions.CanView;
        if (!canView) { isLoading = false; return; }
        availableOrders.Clear();
        availableOrders.AddRange(await db.tbl_orden_compra.AsNoTracking().Where(x => x.id_usuario_solicita == currentUserId).OrderByDescending(x => x.fecha_orden).ToListAsync());
        items.Clear();
        items.AddRange(await db.tbl_liquidacion_compra.AsNoTracking().Include(x => x.id_orden_compraNavigation).Where(x => x.id_usuario_registro == currentUserId && x.activo == true).OrderByDescending(x => x.fecha_liquidacion).ToListAsync());
        isLoading = false;
    }

    private void PrepareNew()
    {
        isCreating = true;
        orderSearchTerm = string.Empty;
        editor = new LiquidationEditor { EstadoLiquidacion = "Pendiente" };
        showForm = true;
    }

    private void PrepareEdit(tbl_liquidacion_compra item)
    {
        isCreating = false;
        orderSearchTerm = item.id_orden_compraNavigation?.numero_orden ?? string.Empty;
        editor = new LiquidationEditor { Id = item.id_liquidacion_compra, IdOrdenCompra = item.id_orden_compra, NumeroLiquidacion = item.numero_liquidacion, NumeroFactura = item.numero_factura ?? string.Empty, NumeroAutorizacion = item.numero_autorizacion ?? string.Empty, Subtotal = item.subtotal ?? 0, DescuentoTotal = item.descuento_total ?? 0, ImpuestoTotal = item.impuesto_total ?? 0, SaldoPagado = item.saldo_pagado ?? 0, EstadoLiquidacion = item.estado_liquidacion ?? "Pendiente", Observaciones = item.observaciones ?? string.Empty };
        showForm = true;
    }

    private async Task SaveAsync()
    {
        if (saving) return;
        saving = true;
        try { await SaveCoreAsync(); }
        catch (InvalidOperationException ex) { ShowAlert("No se pudo guardar", ex.Message, true); }
        catch (Exception ex) when (ex is DbUpdateException or Microsoft.Data.SqlClient.SqlException) { ShowAlert("No se pudo guardar", "Recarga las liquidaciones y comprueba los datos antes de reintentar.", true); }
        finally { saving = false; }
    }

    private async Task SaveCoreAsync()
    {
        if (editor is null || string.IsNullOrWhiteSpace(editor.NumeroLiquidacion) || editor.IdOrdenCompra <= 0) { ShowAlert("No se pudo guardar la liquidacion.", "Completa numero de liquidacion y orden de compra.", true); return; }
        await using var db = await DbContextFactory.CreateDbContextAsync();
        permissions = await GetPermissionsAsync(db);
        if (!permissions.CanView || (isCreating ? !permissions.CanCreate : !permissions.CanEdit)) throw new InvalidOperationException("No tienes permiso para guardar esta liquidacion.");
        if (!await db.tbl_orden_compra.AnyAsync(x => x.id_orden_compra == editor.IdOrdenCompra && x.id_usuario_solicita == currentUserId)) throw new InvalidOperationException("Selecciona una orden propia.");
        editor.NumeroLiquidacion = editor.NumeroLiquidacion.Trim();
        if (editor.NumeroLiquidacion.Length > 20 || editor.NumeroFactura.Trim().Length > 50 || editor.NumeroAutorizacion.Trim().Length > 100)
            throw new InvalidOperationException("Limites: numero de liquidacion 20, factura 50 y autorizacion 100 caracteres.");
        await using var transaction = await db.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable);
        var duplicate = await db.tbl_liquidacion_compra.AnyAsync(x => x.id_liquidacion_compra != editor.Id && x.numero_liquidacion == editor.NumeroLiquidacion);
        if (duplicate) { ShowAlert("No se pudo guardar la liquidacion.", "Ya existe una liquidacion con ese numero.", true); return; }

        tbl_liquidacion_compra entity;
        if (isCreating)
        {
            entity = new tbl_liquidacion_compra { id_usuario_registro = currentUserId, fecha_liquidacion = DateTime.Now, activo = true, fecha_creacion = DateTime.Now };
            db.tbl_liquidacion_compra.Add(entity);
        }
        else
        {
            entity = await db.tbl_liquidacion_compra.FromSqlInterpolated($"SELECT * FROM dbo.tbl_liquidacion_compra WITH (UPDLOCK, HOLDLOCK) WHERE id_liquidacion_compra = {editor.Id}").FirstAsync(x => x.id_usuario_registro == currentUserId && x.activo == true);
        }

        PurchasePaymentRules.ValidateTotals(editor.Subtotal, editor.DescuentoTotal, editor.ImpuestoTotal, entity.saldo_pagado ?? 0);
        if ((entity.saldo_pagado ?? 0) > 0 && entity.id_orden_compra != editor.IdOrdenCompra) throw new InvalidOperationException("No puedes cambiar la orden de una liquidacion con pagos.");
        entity.id_orden_compra = editor.IdOrdenCompra;
        entity.numero_liquidacion = editor.NumeroLiquidacion.Trim();
        entity.numero_factura = NullIfBlank(editor.NumeroFactura);
        entity.numero_autorizacion = NullIfBlank(editor.NumeroAutorizacion);
        entity.subtotal = editor.Subtotal;
        entity.descuento_total = editor.DescuentoTotal;
        entity.impuesto_total = editor.ImpuestoTotal;
        entity.total = editor.Subtotal - editor.DescuentoTotal + editor.ImpuestoTotal;
        entity.saldo_pagado ??= 0;
        entity.saldo_pendiente = entity.total - entity.saldo_pagado;
        entity.estado_liquidacion = PurchasePaymentRules.State(entity.total ?? 0, entity.saldo_pagado ?? 0);
        entity.observaciones = NullIfBlank(editor.Observaciones);
        entity.fecha_actualizacion = DateTime.Now;

        WriteAudit(db, isCreating ? "Crear liquidacion compra" : "Editar liquidacion compra", $"LiquidacionCompraId={entity.id_liquidacion_compra}; Numero={entity.numero_liquidacion}; OrdenCompraId={entity.id_orden_compra}");
        await db.SaveChangesAsync();
        await transaction.CommitAsync();
        CloseForm();
        ShowAlert(
            isCreating ? "Liquidacion creada" : "Liquidacion actualizada",
            isCreating
                ? $"La liquidacion {entity.numero_liquidacion} se registro correctamente."
                : $"La liquidacion {entity.numero_liquidacion} se actualizo correctamente.",
            false);
        await LoadAsync();
    }

    private async Task DeleteAsync(tbl_liquidacion_compra item)
    {
        try
        {
            await using var db = await DbContextFactory.CreateDbContextAsync();
            permissions = await GetPermissionsAsync(db);
            if (!permissions.CanView || !permissions.CanDelete) throw new InvalidOperationException("No tienes permiso para archivar.");
            await using var transaction = await db.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable);
            var entity = await db.tbl_liquidacion_compra.FromSqlInterpolated($"SELECT * FROM dbo.tbl_liquidacion_compra WITH (UPDLOCK, HOLDLOCK) WHERE id_liquidacion_compra = {item.id_liquidacion_compra}")
                .FirstAsync(x => x.id_usuario_registro == currentUserId);
            if ((entity.saldo_pagado ?? 0) != 0 || await db.PurchasePayments.AnyAsync(x => x.LiquidationId == entity.id_liquidacion_compra))
                throw new InvalidOperationException("Conserva la liquidacion: tiene movimientos de pago.");
            entity.activo = false;
            WriteAudit(db, "Archivar liquidacion", $"Liquidacion={entity.id_liquidacion_compra}");
            await db.SaveChangesAsync();
            await transaction.CommitAsync();
            pendingDelete = null;
            await LoadAsync();
        }
        catch (InvalidOperationException ex) { ShowAlert("No se pudo archivar", ex.Message, true); }
        catch (Exception ex) when (ex is DbUpdateException or Microsoft.Data.SqlClient.SqlException) { ShowAlert("No se pudo archivar", "Recarga y comprueba el estado de la liquidacion.", true); }
    }

    private Task GenerateDocumentAsync(tbl_liquidacion_compra item)
    {
        NavigationManager.NavigateTo($"/purchase-liquidations/{item.id_liquidacion_compra}/print", forceLoad: true);
        return Task.CompletedTask;
    }
    private void GoToRetention(int liquidationId)
    {
        showAlert = false;
        NavigationManager.NavigateTo($"/retenciones?liquidacionId={liquidationId}", forceLoad: false);
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        stateFilter = string.Empty;
        orderFilter = string.Empty;
    }

    private void ExportLiquidations()
    {
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query.Add($"search={Uri.EscapeDataString(searchTerm)}");
        }
        if (!string.IsNullOrWhiteSpace(stateFilter))
        {
            query.Add($"state={Uri.EscapeDataString(stateFilter)}");
        }
        if (!string.IsNullOrWhiteSpace(orderFilter))
        {
            query.Add($"orderId={Uri.EscapeDataString(orderFilter)}");
        }

        var exportUrl = query.Count == 0
            ? "/exports/purchase-liquidations.csv"
            : $"/exports/purchase-liquidations.csv?{string.Join("&", query)}";

        NavigationManager.NavigateTo(exportUrl, forceLoad: true);
    }

    private bool MatchesFilters(tbl_liquidacion_compra item)
    {
        if (!string.IsNullOrWhiteSpace(stateFilter) && !string.Equals(item.estado_liquidacion, stateFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (int.TryParse(orderFilter, out var orderId) && orderId > 0 && item.id_orden_compra != orderId)
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return true;
        }

        var search = searchTerm.Trim().ToLowerInvariant();
        return item.numero_liquidacion.ToLowerInvariant().Contains(search) ||
               (item.numero_factura?.ToLowerInvariant().Contains(search) ?? false) ||
               (item.numero_autorizacion?.ToLowerInvariant().Contains(search) ?? false) ||
               (item.id_orden_compraNavigation?.numero_orden.ToLowerInvariant().Contains(search) ?? false);
    }

    private bool MatchesOrderSearch(tbl_orden_compra order)
    {
        if (string.IsNullOrWhiteSpace(orderSearchTerm))
        {
            return true;
        }

        var search = orderSearchTerm.Trim().ToLowerInvariant();
        return order.numero_orden.ToLowerInvariant().Contains(search) ||
               (order.referencia_externa?.ToLowerInvariant().Contains(search) ?? false);
    }

    private async Task<Permissions> GetPermissionsAsync(OpticaDbContext db)
    {
        var user = await db.tbl_usuarios.AsNoTracking().FirstOrDefaultAsync(x => x.id_usuario == currentUserId && x.activo == true && x.bloqueado != true);
        if (user == null) return new Permissions();
        currentRoleId = user.id_rol;
        var permission = await db.tbl_rol_menu_permisos.AsNoTracking().Where(p => p.id_rol == currentRoleId)
            .Join(db.tbl_menu_apps.AsNoTracking().Where(m => m.activo && m.ruta == "/liquidaciones-de-compra"), p => p.id_menu, m => m.id_menu, (p, _) => p)
            .FirstOrDefaultAsync();
        return permission is null ? new Permissions() : new Permissions { CanView = permission.puede_ver, CanCreate = permission.puede_crear, CanEdit = permission.puede_editar, CanDelete = permission.puede_eliminar };
    }
    private void WriteAudit(OpticaDbContext db, string action, string detail) => db.tbl_log_auditoria.Add(new tbl_log_auditoria { id_usuario = currentUserId > 0 ? currentUserId : null, accion = action, modulo = "LiquidacionesCompra", fecha = DateTime.Now, detalle = detail });
    private void ShowAlert(string title, string message, bool isError, bool canGoToRetention = false, int liquidationId = 0)
    {
        alertTitle = title;
        alertMessage = message;
        alertIsError = isError;
        showRetentionAction = canGoToRetention && !isError;
        generatedDocumentLiquidationId = showRetentionAction ? liquidationId : 0;
        showAlert = true;
    }

    private void CloseAlert()
    {
        showAlert = false;
        alertTitle = string.Empty;
        alertMessage = string.Empty;
        showRetentionAction = false;
        generatedDocumentLiquidationId = 0;
    }

    private void OpenRetentionFromAlert()
    {
        if (generatedDocumentLiquidationId > 0)
        {
            GoToRetention(generatedDocumentLiquidationId);
        }
    }
    private void CloseForm() { showForm = false; editor = null; orderSearchTerm = string.Empty; }
    private static string? NullIfBlank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private sealed class Permissions { public bool CanView { get; set; } public bool CanCreate { get; set; } public bool CanEdit { get; set; } public bool CanDelete { get; set; } }
    private sealed class LiquidationEditor { public int Id { get; set; } public int IdOrdenCompra { get; set; } public string NumeroLiquidacion { get; set; } = string.Empty; public string NumeroFactura { get; set; } = string.Empty; public string NumeroAutorizacion { get; set; } = string.Empty; public decimal Subtotal { get; set; } public decimal DescuentoTotal { get; set; } public decimal ImpuestoTotal { get; set; } public decimal SaldoPagado { get; set; } public string EstadoLiquidacion { get; set; } = "Pendiente"; public string Observaciones { get; set; } = string.Empty; }
}
