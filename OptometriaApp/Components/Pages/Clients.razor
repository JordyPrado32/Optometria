@page "/clientes"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@using System.Net.Mail
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject NavigationManager NavigationManager

<PageTitle>Clientes</PageTitle>

@if (isLoading)
{
    <section class="management-shell">
        <div class="management-card">
            <h1>Cargando clientes...</h1>
        </div>
    </section>
}
else if (!canViewClients)
{
    <section class="management-shell">
        <div class="management-card">
            <span class="eyebrow">Restringido</span>
            <h1>Gestion de clientes</h1>
            <p>Tu rol no tiene permiso para ver este modulo.</p>
        </div>
    </section>
}
else
{
    <section class="management-shell">
        <div class="management-hero">
            <div>
                <span class="eyebrow">Facturacion electronica</span>
                <h1>Clientes</h1>
                <p>Administra tu propia cartera de clientes para SRI con auditoria por usuario y control completo de cambios.</p>
            </div>

            <div class="workspace-actions" style="align-items: center;">
                @if (permissions.CanCreate)
                {
                    <button type="button" class="btn btn-coffee" @onclick="PrepareNewClient">
                        <i class="bi bi-plus-lg" style="margin-right: 6px;"></i> Nuevo cliente
                    </button>
                }

                <button type="button" class="btn btn-excel" @onclick="ExportClients">
                    <i class="bi bi-file-earmark-excel-fill" style="margin-right: 6px;"></i> Exportar CSV
                </button>
            </div>
        </div>

        <section class="management-card compact-filter-card">
            <div class="management-card-header">
                <h2>Filtros y busqueda</h2>
                <span>@FilteredClients.Count resultados</span>
            </div>

            <div class="filters-row-2">
                <div>
                    <label class="form-label" for="clientSearch">Buscador</label>
                    <input id="clientSearch" class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Identificacion, razon social, nombres, ciudad o correo" />
                </div>

                <div class="filter-selects-col-2">
                    <div>
                        <label class="form-label" for="clientType">Tipo de cliente</label>
                        <select id="clientType" class="form-select" @bind="selectedTypeFilter">
                            <option value="">Todos</option>
                            @foreach (var option in clientTypeOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label" for="clientStatus">Estado</label>
                        <select id="clientStatus" class="form-select" @bind="selectedStatusFilter">
                            <option value="all">Todos</option>
                            <option value="active">Activos</option>
                            <option value="inactive">Inactivos</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="management-actions" style="margin-top: 0.3rem;">
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ClearFilters" style="padding: 0.3rem 0.7rem !important; font-size: 0.78rem !important; border-color: rgba(127,105,81,0.25) !important;">
                    <i class="bi bi-trash" style="margin-right: 4px;"></i> Limpiar filtros
                </button>
            </div>
        </section>

        <section class="management-card" style="margin-top: 1.5rem;">
            <div class="management-card-header">
                <h2>Listado de clientes</h2>
                <span>@FilteredClients.Count registrados</span>
            </div>

            <div class="table-responsive" style="margin-top: 1rem;">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Identificacion</th>
                            <th>Razon social</th>
                            <th>Tipo</th>
                            <th>Ciudad</th>
                            <th>Condicion de pago</th>
                            <th>Estado</th>
                            <th style="text-align: right; padding-right: 1.5rem;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredClients.Count == 0)
                        {
                            <tr>
                                <td colspan="7" style="text-align: center; padding: 2rem; color: var(--color-taupe);">
                                    No se encontraron clientes para tu usuario con los filtros actuales.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in PagedClients)
                            {
                                <tr>
                                    <td>
                                        <strong style="color: var(--color-sage);">@item.numero_identificacion</strong>
                                        <div style="font-size: 0.78rem; color: var(--color-taupe);">@item.tipo_identificacion</div>
                                    </td>
                                    <td>
                                        <strong style="color: var(--color-ink);">@item.razon_social</strong>
                                        <div style="font-size: 0.78rem; color: var(--color-taupe);">@(string.IsNullOrWhiteSpace(item.nombre_comercial) ? "Sin nombre comercial" : item.nombre_comercial)</div>
                                    </td>
                                    <td>@item.tipo_cliente</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.ciudad) ? "-" : item.ciudad)</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.condicion_pago) ? "-" : item.condicion_pago)</td>
                                    <td>
                                        @if (item.estado)
                                        {
                                            <span class="badge" style="background: rgba(93, 161, 129, 0.15) !important; color: #5DA181 !important; font-size: 0.78rem; padding: 0.35rem 0.65rem; border-radius: 2rem;">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background: rgba(127, 105, 81, 0.12) !important; color: #7F6951 !important; font-size: 0.78rem; padding: 0.35rem 0.65rem; border-radius: 2rem;">Inactivo</span>
                                        }
                                    </td>
                                    <td style="text-align: right; padding-right: 1.2rem;">
                                        <div style="display: inline-flex; gap: 0.4rem; justify-content: flex-end;">
                                            <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(93, 161, 129, 0.3) !important; color: var(--color-sage) !important;" @onclick="() => PrepareEditClient(item)">
                                                <i class="bi bi-pencil-fill" style="margin-right: 4px;"></i> Editar
                                            </button>
                                            <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(254, 188, 100, 0.4) !important; color: #e09b3c !important;" @onclick="() => PrepareAuditClient(item)">
                                                <i class="bi bi-clock-history" style="margin-right: 4px;"></i> Auditoria
                                            </button>
                                            @if (permissions.CanDelete)
                                            {
                                                <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(127, 105, 81, 0.2) !important; color: var(--color-taupe) !important;" @onclick="() => DeleteClientAsync(item)">
                                                    Eliminar
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <TablePager TotalItems="@FilteredClients.Count" CurrentPage="@clientPage" CurrentPageChanged="SetClientPage" />
        </section>
    </section>
}

@if (showFormModal && editor is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card form-modal-card">
            <header class="custom-modal-header rose-header">
                <h2>@EditorTitle</h2>
                <button type="button" class="btn-close-modal" @onclick="CloseFormModal">×</button>
            </header>
            <div class="custom-modal-body">
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger" role="alert">@errorMessage</div>
                }

                <p style="margin-bottom: 1rem; color: var(--color-taupe); font-size: 0.9rem;">Los campos marcados con * son obligatorios.</p>

                <div class="management-form-grid">
                    <div>
                        <label class="form-label" for="clientTipo">Tipo de cliente *</label>
                        <select id="clientTipo" class="form-select" @bind="editor.TipoCliente" disabled="@(!CanModifyEditor)">
                            @foreach (var option in clientTypeOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label" for="clientTipoId">Tipo de identificacion *</label>
                        <select id="clientTipoId" class="form-select" @bind="editor.TipoIdentificacion" disabled="@(!CanModifyEditor)">
                            @foreach (var option in identificationOptions)
                            {
                                <option value="@option.Code">@option.Label</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label" for="clientNumeroId">Numero de identificacion *</label>
                        <input id="clientNumeroId" class="form-control" @bind="editor.NumeroIdentificacion" readonly="@(!CanModifyEditor)" maxlength="20" />
                    </div>

                    <div>
                        <label class="form-label" for="clientRazonSocial">@BusinessNameLabel</label>
                        <input id="clientRazonSocial" class="form-control" @bind="editor.RazonSocial" readonly="@(!CanModifyEditor)" maxlength="300" />
                    </div>

                    <div>
                        <label class="form-label" for="clientNombres">@FirstNameLabel</label>
                        <input id="clientNombres" class="form-control" @bind="editor.Nombres" readonly="@(!CanModifyEditor)" maxlength="200" />
                    </div>

                    <div>
                        <label class="form-label" for="clientApellidos">@LastNameLabel</label>
                        <input id="clientApellidos" class="form-control" @bind="editor.Apellidos" readonly="@(!CanModifyEditor)" maxlength="200" />
                    </div>

                    <div class="patient-form-span">
                        <label class="form-label" for="clientNombreComercial">@CommercialNameLabel</label>
                        <input id="clientNombreComercial" class="form-control" @bind="editor.NombreComercial" readonly="@(!CanModifyEditor)" maxlength="300" />
                    </div>

                    <div class="patient-form-span">
                        <label class="form-label" for="clientDireccion">Direccion</label>
                        <input id="clientDireccion" class="form-control" @bind="editor.Direccion" readonly="@(!CanModifyEditor)" maxlength="500" />
                    </div>

                    <div>
                        <label class="form-label" for="clientCiudad">Ciudad</label>
                        <input id="clientCiudad" class="form-control" @bind="editor.Ciudad" readonly="@(!CanModifyEditor)" maxlength="100" />
                    </div>

                    <div>
                        <label class="form-label" for="clientProvincia">Provincia</label>
                        <input id="clientProvincia" class="form-control" @bind="editor.Provincia" readonly="@(!CanModifyEditor)" maxlength="100" />
                    </div>

                    <div>
                        <label class="form-label" for="clientPostal">Codigo postal</label>
                        <input id="clientPostal" class="form-control" @bind="editor.CodigoPostal" readonly="@(!CanModifyEditor)" maxlength="10" />
                    </div>

                    <div>
                        <label class="form-label" for="clientPhone">Telefono</label>
                        <input id="clientPhone" class="form-control" @bind="editor.Telefono" readonly="@(!CanModifyEditor)" maxlength="20" />
                    </div>

                    <div>
                        <label class="form-label" for="clientEmail">Correo electronico</label>
                        <input id="clientEmail" type="email" class="form-control" @bind="editor.CorreoElectronico" readonly="@(!CanModifyEditor)" maxlength="100" />
                    </div>

                    <div>
                        <label class="form-label" for="clientCountry">Pais codigo</label>
                        <input id="clientCountry" class="form-control" @bind="editor.PaisCodigo" readonly="@(!CanModifyEditor)" maxlength="2" />
                    </div>

                    <div>
                        <label class="form-label" for="clientPayment">Condicion de pago</label>
                        <select id="clientPayment" class="form-select" @bind="editor.CondicionPago" disabled="@(!CanModifyEditor)">
                            @foreach (var option in paymentConditionOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label" for="clientDays">Dias de plazo</label>
                        <input id="clientDays" type="number" class="form-control" @bind="editor.DiasPlazo" readonly="@(!CanModifyEditor)" min="0" />
                    </div>

                    <div>
                        <label class="form-label" for="clientLimit">Limite de credito</label>
                        <input id="clientLimit" type="number" step="0.01" class="form-control" @bind="editor.LimiteCredito" readonly="@(!CanModifyEditor)" min="0" />
                    </div>

                    <div>
                        <label class="form-label" for="clientBalance">Saldo deudor</label>
                        <input id="clientBalance" type="number" step="0.01" class="form-control" @bind="editor.SaldoDeudor" readonly="@(!CanModifyEditor)" min="0" />
                    </div>

                    <div>
                        <label class="form-label" for="clientContactoNombre">Contacto nombre</label>
                        <input id="clientContactoNombre" class="form-control" @bind="editor.ContactoNombre" readonly="@(!CanModifyEditor)" maxlength="200" />
                    </div>

                    <div>
                        <label class="form-label" for="clientContactoTelefono">Contacto telefono</label>
                        <input id="clientContactoTelefono" class="form-control" @bind="editor.ContactoTelefono" readonly="@(!CanModifyEditor)" maxlength="20" />
                    </div>

                    <div>
                        <label class="form-label" for="clientContactoCorreo">Contacto correo</label>
                        <input id="clientContactoCorreo" type="email" class="form-control" @bind="editor.ContactoCorreo" readonly="@(!CanModifyEditor)" maxlength="100" />
                    </div>

                    <div>
                        <label class="form-label" for="clientContribuyente">No. contribuyente especial</label>
                        <input id="clientContribuyente" class="form-control" @bind="editor.NumeroContribuyenteEspecial" readonly="@(!CanModifyEditor)" maxlength="10" />
                    </div>

                    <div>
                        <label class="form-label" for="clientEstado">Estado</label>
                        <select id="clientEstado" class="form-select" @bind="editor.Estado" disabled="@(!CanModifyEditor)">
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>

                    <div class="patient-form-span">
                        <label class="form-label" for="clientObservaciones">Observaciones</label>
                        <textarea id="clientObservaciones" class="form-control" rows="4" @bind="editor.Observaciones" readonly="@(!CanModifyEditor)" maxlength="500"></textarea>
                    </div>
                </div>

                <div class="management-form-grid" style="margin-top: 1rem;">
                    <label class="form-check" style="display: flex; gap: 0.55rem; align-items: center;">
                        <input type="checkbox" class="form-check-input" @bind="editor.EsContribuyenteEspecial" disabled="@(!CanModifyEditor)" />
                        <span class="form-check-label">Contribuyente especial</span>
                    </label>

                    <label class="form-check" style="display: flex; gap: 0.55rem; align-items: center;">
                        <input type="checkbox" class="form-check-input" @bind="editor.EsResidenteExterior" disabled="@(!CanModifyEditor)" />
                        <span class="form-check-label">Residente en el exterior</span>
                    </label>

                    <label class="form-check" style="display: flex; gap: 0.55rem; align-items: center;">
                        <input type="checkbox" class="form-check-input" @bind="editor.EsConsumidorFinal" disabled="@(!CanModifyEditor)" />
                        <span class="form-check-label">Consumidor final</span>
                    </label>

                    <label class="form-check" style="display: flex; gap: 0.55rem; align-items: center;">
                        <input type="checkbox" class="form-check-input" @bind="editor.EsObligadoContabilidad" disabled="@(!CanModifyEditor)" />
                        <span class="form-check-label">Obligado a contabilidad</span>
                    </label>
                </div>
            </div>
            <footer class="custom-modal-footer">
                @if (CanModifyEditor)
                {
                    <button type="button" class="btn btn-primary" @onclick="SaveClientWithHandlingAsync">Guardar cambios</button>
                }
                <button type="button" class="btn btn-outline-primary" @onclick="CloseFormModal">Cerrar</button>
            </footer>
        </div>
    </div>
}

@if (showAuditModal && selectedClient is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card audit-modal-card">
            <header class="custom-modal-header apricot-header">
                <h2>Historial de auditoria - @selectedClient.razon_social</h2>
                <button type="button" class="btn-close-modal" @onclick="() => showAuditModal = false">×</button>
            </header>
            <div class="custom-modal-body">
                @if (auditEntries.Count == 0)
                {
                    <p style="text-align: center; color: var(--color-taupe); margin: 2rem 0;">No hay eventos registrados para este cliente.</p>
                }
                else
                {
                    <div class="management-list">
                        @foreach (var auditEntry in auditEntries)
                        {
                            <article class="management-list-item" style="border: 1px solid rgba(127, 105, 81, 0.08); border-radius: 0.8rem; padding: 0.95rem; margin-bottom: 0.6rem; background: #faf8f4;">
                                <div style="display: flex; justify-content: space-between; margin-bottom: 0.35rem;">
                                    <strong style="color: var(--color-sage);">@auditEntry.accion</strong>
                                    <span style="font-size: 0.78rem; color: var(--color-taupe);">@(auditEntry.fecha?.ToString("yyyy-MM-dd HH:mm") ?? "Sin fecha")</span>
                                </div>
                                <div style="font-size: 0.82rem; color: var(--color-ink); margin-bottom: 0.35rem;">@auditEntry.detalle</div>
                                <span style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-taupe); opacity: 0.8;">@GetAuditActorLabel(auditEntry)</span>
                            </article>
                        }
                    </div>
                }
            </div>
            <footer class="custom-modal-footer">
                <button type="button" class="btn btn-outline-primary" @onclick="() => showAuditModal = false">Cerrar</button>
            </footer>
        </div>
    </div>
}

@if (showAlertModal)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card alert-modal-card">
            <header class="custom-modal-header @(alertIsError ? "error-header" : "success-header")">
                <h2>@(alertIsError ? "Error de validacion" : "Operacion exitosa")</h2>
            </header>
            <div class="custom-modal-body" style="padding: 2rem 1.5rem; text-align: center;">
                <div style="font-size: 3rem; margin-bottom: 1rem; color: @(alertIsError ? "#7F6951" : "#5DA181")">
                    <i class="bi @(alertIsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")"></i>
                </div>
                <p style="font-size: 1rem; color: var(--color-ink); line-height: 1.5; margin: 0;">@alertMessage</p>
            </div>
            <footer class="custom-modal-footer" style="justify-content: center;">
                <button type="button" class="btn btn-primary" style="min-width: 120px;" @onclick="CloseAlertModal">Aceptar</button>
            </footer>
        </div>
    </div>
}

@code {
    private readonly List<ClientEntity> clients = [];
    private readonly List<(string Code, string Label)> identificationOptions =
    [
        ("04", "04 - RUC"),
        ("05", "05 - Cedula"),
        ("06", "06 - Pasaporte"),
        ("08", "08 - Identificacion exterior")
    ];
    private readonly string[] clientTypeOptions = ["Personal", "Empresa", "Gobierno", "Exterior"];
    private readonly string[] paymentConditionOptions = ["Contado", "Credito", "Mixto"];
    private List<tbl_log_auditoria> auditEntries = [];
    private ClientEditorModel? editor;
    private ModulePermissions permissions = new();
    private bool isLoading = true;
    private bool canViewClients;
    private bool isCreatingNewClient;
    private int selectedClientId;
    private int currentUserId;
    private int currentRoleId;
    private string searchTerm = string.Empty;
    private string selectedTypeFilter = string.Empty;
    private string selectedStatusFilter = "all";
    private string? errorMessage;
    private bool showFormModal;
    private bool showAuditModal;
    private bool showAlertModal;
    private string alertMessage = string.Empty;
    private bool alertIsError;
    private ClientEntity? selectedClient;

    private List<ClientEntity> FilteredClients => clients
        .Where(MatchesFilters)
        .OrderBy(c => c.razon_social)
        .ThenBy(c => c.numero_identificacion)
        .ToList();
    private const int TablePageSize = 5;
    private int clientPage = 1;
    private int EffectiveClientPage => Math.Min(clientPage, Math.Max(1, (int)Math.Ceiling(FilteredClients.Count / (double)TablePageSize)));
    private IEnumerable<ClientEntity> PagedClients => FilteredClients.Skip((EffectiveClientPage - 1) * TablePageSize).Take(TablePageSize);
    private void SetClientPage(int page) => clientPage = page;

    private string EditorTitle => isCreatingNewClient ? "Nuevo cliente" : "Detalle del cliente";
    private bool CanModifyEditor => isCreatingNewClient ? permissions.CanCreate : permissions.CanEdit;
    private bool IsCompanyEditor => string.Equals(editor?.TipoCliente, "Empresa", StringComparison.OrdinalIgnoreCase);
    private string BusinessNameLabel => IsCompanyEditor ? "Razon social *" : "Razon social";
    private string FirstNameLabel => IsCompanyEditor ? "Nombres" : "Nombres *";
    private string LastNameLabel => IsCompanyEditor ? "Apellidos" : "Apellidos *";
    private string CommercialNameLabel => IsCompanyEditor ? "Nombre comercial *" : "Nombre comercial";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var parsedUserId) ? parsedUserId : 0;
        currentRoleId = int.TryParse(authState.User.FindFirst("RoleId")?.Value, out var parsedRoleId) ? parsedRoleId : 0;
        await LoadAsync();
    }

    private async Task LoadAsync(int? preserveSelectedClientId = null)
    {
        isLoading = true;
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        permissions = await GetModulePermissionsAsync(dbContext, currentRoleId);
        canViewClients = permissions.CanView;

        if (!canViewClients || currentUserId <= 0)
        {
            isLoading = false;
            return;
        }

        var loadedClients = await dbContext.clients
            .AsNoTracking()
            .Where(c => c.id_usuario_creacion == currentUserId)
            .ToListAsync();

        clients.Clear();
        clients.AddRange(loadedClients);

        if (preserveSelectedClientId.HasValue)
        {
            selectedClientId = preserveSelectedClientId.Value;
            selectedClient = clients.FirstOrDefault(c => c.cliente_id == selectedClientId);
            editor = BuildEditor(selectedClient);
        }

        isLoading = false;
    }

    private void PrepareNewClient()
    {
        isCreatingNewClient = true;
        selectedClientId = 0;
        selectedClient = null;
        editor = BuildNewEditor();
        auditEntries = [];
        errorMessage = null;
        showFormModal = true;
    }

    private void PrepareEditClient(ClientEntity item)
    {
        isCreatingNewClient = false;
        selectedClientId = item.cliente_id;
        selectedClient = item;
        editor = BuildEditor(item);
        errorMessage = null;
        showFormModal = true;
    }

    private async Task PrepareAuditClient(ClientEntity item)
    {
        selectedClient = item;
        selectedClientId = item.cliente_id;
        await LoadAuditEntriesAsync(item.cliente_id);
        showAuditModal = true;
    }

    private void ShowAlert(string message, bool isError)
    {
        alertMessage = message;
        alertIsError = isError;
        showAlertModal = true;
    }

    private void CloseAlertModal()
    {
        showAlertModal = false;
        alertMessage = string.Empty;
    }

    private void CloseFormModal()
    {
        errorMessage = null;
        showFormModal = false;
    }

    private async Task SaveClientAsync()
    {
        errorMessage = null;

        if (!ValidateEditor())
        {
            ShowAlert(errorMessage ?? "Corrige los datos del formulario.", true);
            return;
        }

        if (currentUserId <= 0)
        {
            ShowAlert("No se pudo identificar el usuario autenticado.", true);
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var identificationExists = await dbContext.clients.AnyAsync(c =>
            c.id_usuario_creacion == currentUserId &&
            c.cliente_id != editor!.ClienteId &&
            c.tipo_identificacion == editor.TipoIdentificacion &&
            c.numero_identificacion == editor.NumeroIdentificacion.Trim());

        if (identificationExists)
        {
            ShowAlert("Ya existe un cliente tuyo con la misma identificacion.", true);
            return;
        }

        ClientEntity clientEntity;
        if (isCreatingNewClient)
        {
            if (!permissions.CanCreate)
            {
                ShowAlert("Tu rol no tiene permiso para crear clientes.", true);
                return;
            }

            clientEntity = new ClientEntity
            {
                id_usuario_creacion = currentUserId,
                fecha_creacion = DateTime.Now
            };

            dbContext.clients.Add(clientEntity);
        }
        else
        {
            if (!permissions.CanEdit)
            {
                ShowAlert("Tu rol no tiene permiso para editar clientes.", true);
                return;
            }

            clientEntity = await dbContext.clients.FirstOrDefaultAsync(c =>
                    c.cliente_id == editor!.ClienteId &&
                    c.id_usuario_creacion == currentUserId)
                ?? throw new InvalidOperationException("No se encontro el cliente seleccionado.");
        }

        clientEntity.tipo_cliente = editor!.TipoCliente;
        clientEntity.tipo_identificacion = editor.TipoIdentificacion;
        clientEntity.numero_identificacion = editor.NumeroIdentificacion.Trim();
        clientEntity.razon_social = editor.RazonSocial.Trim();
        clientEntity.nombres = NormalizeOptional(editor.Nombres);
        clientEntity.apellidos = NormalizeOptional(editor.Apellidos);
        clientEntity.nombre_comercial = NormalizeOptional(editor.NombreComercial);
        clientEntity.direccion = NormalizeOptional(editor.Direccion);
        clientEntity.ciudad = NormalizeOptional(editor.Ciudad);
        clientEntity.provincia = NormalizeOptional(editor.Provincia);
        clientEntity.codigo_postal = NormalizeOptional(editor.CodigoPostal);
        clientEntity.telefono = NormalizeOptional(editor.Telefono);
        clientEntity.correo_electronico = NormalizeOptional(editor.CorreoElectronico);
        clientEntity.es_contribuyente_especial = editor.EsContribuyenteEspecial;
        clientEntity.numero_contribuyente_especial = NormalizeOptional(editor.NumeroContribuyenteEspecial);
        clientEntity.pais_codigo = NormalizeCountryCode(editor.PaisCodigo);
        clientEntity.es_residente_exterior = editor.EsResidenteExterior;
        clientEntity.es_consumidor_final = editor.EsConsumidorFinal;
        clientEntity.es_obligado_contabilidad = editor.EsObligadoContabilidad;
        clientEntity.contacto_nombre = NormalizeOptional(editor.ContactoNombre);
        clientEntity.contacto_telefono = NormalizeOptional(editor.ContactoTelefono);
        clientEntity.contacto_correo = NormalizeOptional(editor.ContactoCorreo);
        clientEntity.condicion_pago = NormalizeOptional(editor.CondicionPago);
        clientEntity.dias_plazo = editor.DiasPlazo;
        clientEntity.limite_credito = editor.LimiteCredito;
        clientEntity.saldo_deudor = editor.SaldoDeudor;
        clientEntity.estado = editor.Estado;
        clientEntity.observaciones = NormalizeOptional(editor.Observaciones);
        clientEntity.fecha_actualizacion = DateTime.Now;
        clientEntity.id_usuario_actualizacion = isCreatingNewClient ? null : currentUserId;

        await dbContext.SaveChangesAsync();

        WriteAudit(
            dbContext,
            isCreatingNewClient ? "Crear cliente" : "Editar cliente",
            $"ClienteId={clientEntity.cliente_id}; Identificacion={clientEntity.tipo_identificacion}-{clientEntity.numero_identificacion}; RazonSocial={clientEntity.razon_social}");

        await dbContext.SaveChangesAsync();

        ShowAlert(
            isCreatingNewClient
                ? "El cliente se creo correctamente."
                : "La informacion del cliente se guardo correctamente.",
            false);

        showFormModal = false;
        isCreatingNewClient = false;
        await LoadAsync(clientEntity.cliente_id);
    }

    private async Task SaveClientWithHandlingAsync()
    {
        try
        {
            await SaveClientAsync();
        }
        catch (Exception ex)
        {
            errorMessage = GetInnermostMessage(ex);
        }
    }

    private async Task DeleteClientAsync(ClientEntity item)
    {
        if (!permissions.CanDelete || currentUserId <= 0)
        {
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var clientEntity = await dbContext.clients.FirstOrDefaultAsync(c =>
            c.cliente_id == item.cliente_id &&
            c.id_usuario_creacion == currentUserId);

        if (clientEntity is null)
        {
            ShowAlert("No se encontro el cliente seleccionado.", true);
            return;
        }

        WriteAudit(
            dbContext,
            "Eliminar cliente",
            $"ClienteId={clientEntity.cliente_id}; Identificacion={clientEntity.tipo_identificacion}-{clientEntity.numero_identificacion}; RazonSocial={clientEntity.razon_social}");

        dbContext.clients.Remove(clientEntity);
        await dbContext.SaveChangesAsync();

        ShowAlert("El cliente fue eliminado correctamente.", false);
        selectedClientId = 0;
        selectedClient = null;
        await LoadAsync();
    }

    private async Task LoadAuditEntriesAsync(int clientId)
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var token = $"ClienteId={clientId};";

        auditEntries = await dbContext.tbl_log_auditoria
            .AsNoTracking()
            .Include(a => a.id_usuarioNavigation)
            .Where(a => a.modulo == "Clientes" && a.detalle != null && a.detalle.Contains(token))
            .OrderByDescending(a => a.fecha)
            .Take(20)
            .ToListAsync();
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        selectedTypeFilter = string.Empty;
        selectedStatusFilter = "all";
    }

    private void ExportClients()
    {
        var query = new List<string>();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query.Add($"search={Uri.EscapeDataString(searchTerm)}");
        }

        if (!string.IsNullOrWhiteSpace(selectedTypeFilter))
        {
            query.Add($"type={Uri.EscapeDataString(selectedTypeFilter)}");
        }

        if (selectedStatusFilter != "all")
        {
            query.Add($"status={Uri.EscapeDataString(selectedStatusFilter)}");
        }

        var exportUrl = query.Count == 0
            ? "/exports/clients.csv"
            : $"/exports/clients.csv?{string.Join("&", query)}";

        NavigationManager.NavigateTo(exportUrl, forceLoad: true);
    }

    private bool MatchesFilters(ClientEntity item)
    {
        if (selectedStatusFilter is "active" or "inactive")
        {
            var expectedStatus = selectedStatusFilter == "active";
            if (item.estado != expectedStatus)
            {
                return false;
            }
        }

        if (!string.IsNullOrWhiteSpace(selectedTypeFilter) && !string.Equals(item.tipo_cliente, selectedTypeFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return true;
        }

        var search = searchTerm.Trim().ToLowerInvariant();
        return item.razon_social.ToLowerInvariant().Contains(search) ||
               item.numero_identificacion.ToLowerInvariant().Contains(search) ||
               (item.nombres?.ToLowerInvariant().Contains(search) ?? false) ||
               (item.apellidos?.ToLowerInvariant().Contains(search) ?? false) ||
               (item.ciudad?.ToLowerInvariant().Contains(search) ?? false) ||
               (item.correo_electronico?.ToLowerInvariant().Contains(search) ?? false);
    }

    private bool ValidateEditor()
    {
        if (editor is null)
        {
            errorMessage = "No hay un cliente seleccionado.";
            return false;
        }

        editor.NumeroIdentificacion = editor.NumeroIdentificacion.Trim();
        editor.RazonSocial = editor.RazonSocial.Trim();
        editor.Nombres = editor.Nombres.Trim();
        editor.Apellidos = editor.Apellidos.Trim();
        editor.NombreComercial = editor.NombreComercial.Trim();
        editor.PaisCodigo = editor.PaisCodigo.Trim().ToUpperInvariant();

        if (string.IsNullOrWhiteSpace(editor.TipoCliente) ||
            string.IsNullOrWhiteSpace(editor.TipoIdentificacion) ||
            string.IsNullOrWhiteSpace(editor.NumeroIdentificacion))
        {
            errorMessage = "Completa los campos obligatorios del cliente.";
            return false;
        }

        if (IsCompanyEditor)
        {
            if (string.IsNullOrWhiteSpace(editor.RazonSocial) || string.IsNullOrWhiteSpace(editor.NombreComercial))
            {
                errorMessage = "Para empresas, razon social y nombre comercial son obligatorios.";
                return false;
            }
        }
        else
        {
            if (string.IsNullOrWhiteSpace(editor.Nombres) || string.IsNullOrWhiteSpace(editor.Apellidos))
            {
                errorMessage = "Para personas, nombres y apellidos son obligatorios.";
                return false;
            }
        }

        if (editor.NumeroIdentificacion.Length > 20 || editor.RazonSocial.Length > 300 || editor.PaisCodigo.Length != 2)
        {
            errorMessage = "Revisa la longitud de identificacion, razon social o codigo de pais.";
            return false;
        }

        if (!string.IsNullOrWhiteSpace(editor.CorreoElectronico) && !IsValidEmail(editor.CorreoElectronico))
        {
            errorMessage = "Ingresa un correo electronico valido para el cliente.";
            return false;
        }

        if (!string.IsNullOrWhiteSpace(editor.ContactoCorreo) && !IsValidEmail(editor.ContactoCorreo))
        {
            errorMessage = "Ingresa un correo electronico valido para el contacto.";
            return false;
        }

        if (editor.DiasPlazo < 0 || editor.LimiteCredito < 0 || editor.SaldoDeudor < 0)
        {
            errorMessage = "Los campos numericos no pueden ser negativos.";
            return false;
        }

        return true;
    }

    private async Task<ModulePermissions> GetModulePermissionsAsync(OpticaDbContext dbContext, int roleId)
    {
        if (roleId <= 0)
        {
            return new ModulePermissions();
        }

        var permission = await dbContext.tbl_rol_menu_permisos
            .AsNoTracking()
            .Where(p => p.id_rol == roleId)
            .Join(
                dbContext.tbl_menu_apps.AsNoTracking().Where(m => m.ruta == "/clientes"),
                rolePermission => rolePermission.id_menu,
                menu => menu.id_menu,
                (rolePermission, _) => rolePermission)
            .FirstOrDefaultAsync();

        return permission is null
            ? new ModulePermissions()
            : new ModulePermissions
            {
                CanView = permission.puede_ver,
                CanCreate = permission.puede_crear,
                CanEdit = permission.puede_editar,
                CanDelete = permission.puede_eliminar
            };
    }

