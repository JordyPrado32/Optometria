@page "/tienda-online"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using System.Text.Json
@using OptometriaApp.Data
@using OptometriaApp.Models
@using OptometriaApp.Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject IWebHostEnvironment WebHostEnvironment
@inject IJSRuntime JSRuntime

<PageTitle>Tienda online</PageTitle>

<style>
    .shop-shell { display:grid; gap:1rem; }
    .shop-top-note { min-height:2rem; border-radius:999px; display:flex; align-items:center; justify-content:center; padding:0.35rem 1rem; background:#2f2a25; color:#fffaf4; font-size:0.78rem; letter-spacing:0.02em; text-align:center; }
    .shop-nav { position:sticky; top:0.75rem; z-index:12; display:grid; grid-template-columns:minmax(0, 1fr) auto; gap:0.8rem; align-items:center; padding:0.7rem; border:1px solid rgba(127,105,81,0.12); border-radius:1.35rem; background:rgba(255,250,244,0.94); backdrop-filter:blur(8px); box-shadow:0 16px 36px rgba(127,105,81,0.1); }
    .shop-category-nav { display:flex; gap:0.45rem; overflow-x:auto; padding-bottom:0.1rem; }
    .shop-category-nav button { flex:0 0 auto; border:0; border-radius:999px; padding:0.48rem 0.85rem; background:transparent; color:var(--color-taupe); font-weight:800; }
    .shop-category-nav button.is-active, .shop-category-nav button:hover { background:rgba(93,161,129,0.16); color:var(--color-sage); }
    .shop-nav-actions { display:flex; align-items:center; gap:0.5rem; }
    .shop-search { min-width:14rem; display:flex; align-items:center; gap:0.45rem; border:1px solid rgba(93,161,129,0.24); border-radius:999px; padding:0.35rem 0.75rem; background:#fff; }
    .shop-search input { border:0; outline:0; width:100%; background:transparent; color:var(--color-ink); }
    .shop-cart-button { position:relative; width:2.65rem; height:2.65rem; border:1px solid rgba(127,105,81,0.16); border-radius:999px; display:grid; place-items:center; background:#fff; color:var(--color-ink); }
    .shop-cart-count { position:absolute; right:-0.25rem; top:-0.25rem; min-width:1.15rem; height:1.15rem; border-radius:999px; display:grid; place-items:center; background:var(--color-sage); color:#fff; font-size:0.68rem; font-weight:900; }
    .shop-hero { min-height:470px; border-radius:1.5rem; overflow:hidden; position:relative; display:grid; align-items:end; padding:2rem; background:linear-gradient(135deg, rgba(93,161,129,0.18), rgba(254,188,100,0.16)); border:1px solid rgba(127,105,81,0.12); }
    .shop-hero img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:0; }
    .shop-hero::after { content:""; position:absolute; inset:0; z-index:1; background:linear-gradient(180deg, rgba(40,34,29,0.08), rgba(40,34,29,0.62)); }
    .shop-hero-copy { position:relative; z-index:2; max-width:46rem; color:#fff; display:grid; gap:0.8rem; }
    .shop-hero-brand { color:#5DA181; font-size:clamp(1.25rem, 2.4vw, 2.35rem); line-height:1; font-weight:950; letter-spacing:0; text-transform:none; text-shadow:0 10px 24px rgba(0,0,0,0.28); }
    .shop-hero-copy h1 { margin:0; color:#fff; font-size:clamp(2rem, 4.8vw, 4.5rem); line-height:1; font-weight:950; }
    .shop-hero-copy p { margin:0; color:rgba(255,250,244,0.92); font-size:1.05rem; max-width:40rem; }
    .shop-hero-actions { display:flex; gap:0.6rem; flex-wrap:wrap; margin-top:0.35rem; }
    .shop-admin-edit { position:absolute; right:1rem; top:1rem; z-index:3; }
    .shop-section-title { display:flex; justify-content:space-between; align-items:end; gap:1rem; margin-top:0.5rem; }
    .shop-section-title h2 { margin:0; color:var(--color-ink); font-size:1.65rem; }
    .shop-section-title p { margin:0.25rem 0 0; color:var(--color-taupe); }
    .shop-feature-grid { display:grid; grid-template-columns:repeat(4, minmax(0, 1fr)); gap:0.8rem; }
    .shop-feature-card { min-height:170px; border:0; border-radius:1rem; overflow:hidden; position:relative; display:grid; align-items:end; padding:0.9rem; text-align:left; background:rgba(244,240,228,0.8); color:#fff; cursor:pointer; }
    .shop-feature-card img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
    .shop-feature-card::after { content:""; position:absolute; inset:0; background:linear-gradient(180deg, rgba(40,34,29,0.05), rgba(40,34,29,0.62)); }
    .shop-feature-card span { position:relative; z-index:1; font-weight:900; font-size:1rem; color:#fff; }
    .shop-feature-card small { position:relative; z-index:1; color:rgba(255,250,244,0.86); font-weight:700; }
    .shop-storefront { display:block; }
    .shop-product-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:1rem; }
    .shop-product-card { border:1px solid rgba(127,105,81,0.12); border-radius:1.25rem; overflow:hidden; background:#fffaf4; box-shadow:0 14px 30px rgba(127,105,81,0.08); display:grid; grid-template-rows:auto 1fr; min-width:0; transition:transform 0.18s ease, box-shadow 0.18s ease; }
    .shop-product-card:hover { transform:translateY(-2px); box-shadow:0 18px 34px rgba(127,105,81,0.12); }
    .shop-product-image { aspect-ratio:1 / 0.82; background:linear-gradient(135deg, rgba(93,161,129,0.15), rgba(236,204,197,0.36)); display:grid; place-items:center; overflow:hidden; color:var(--color-taupe); }
    .shop-product-image img { width:100%; height:100%; object-fit:cover; }
    .shop-product-image i { font-size:2.2rem; }
    .shop-product-body { padding:1rem; display:grid; gap:0.75rem; align-content:start; }
    .shop-product-body h3 { margin:0; color:var(--color-ink); font-size:1rem; overflow-wrap:anywhere; }
    .shop-product-body p { margin:0; color:var(--color-taupe); font-size:0.82rem; line-height:1.35; min-height:2.2rem; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    .shop-product-meta { display:flex; justify-content:space-between; align-items:center; gap:0.7rem; }
    .shop-product-title-row { display:flex; justify-content:space-between; gap:0.7rem; align-items:flex-start; }
    .shop-product-tag { border-radius:999px; padding:0.24rem 0.55rem; background:rgba(236,204,197,0.34); color:var(--color-taupe-deep); font-size:0.68rem; font-weight:900; white-space:nowrap; }
    .shop-product-footer { display:grid; grid-template-columns:1fr auto; gap:0.75rem; align-items:center; border-top:1px solid rgba(127,105,81,0.08); padding-top:0.75rem; }
    .shop-price { color:var(--color-ink); font-size:1.25rem; font-weight:950; }
    .shop-stock { border-radius:999px; padding:0.25rem 0.55rem; font-size:0.7rem; font-weight:900; white-space:nowrap; }
    .shop-stock.stock-ok { background:rgba(93,161,129,0.14); color:#2e7d32; }
    .shop-stock.stock-low { background:rgba(254,188,100,0.2); color:#b46e00; }
    .shop-stock.stock-out { background:rgba(198,40,40,0.12); color:#c62828; }
    .shop-side { position:sticky; top:5.4rem; display:grid; gap:1rem; }
    .shop-side-card, .shop-cart-panel { border:1px solid rgba(127,105,81,0.12); border-radius:1rem; background:#fffaf4; padding:1rem; box-shadow:0 12px 28px rgba(127,105,81,0.06); }
    .shop-side-card h3, .shop-cart-panel h3 { margin:0 0 0.75rem; color:var(--color-ink); font-size:1rem; }
    .shop-mini-list { display:grid; gap:0.5rem; }
    .shop-mini-row { display:flex; justify-content:space-between; gap:0.7rem; align-items:center; color:var(--color-taupe); font-weight:800; }
    .shop-cart-panel { display:none; }
    .shop-cart-panel.is-open { display:grid; gap:0.75rem; }
    .shop-cart-item { display:grid; grid-template-columns:1fr auto; gap:0.55rem; padding:0.65rem; border:1px solid rgba(93,161,129,0.14); border-radius:0.8rem; background:#fff; }
    .shop-cart-item strong { color:var(--color-ink); overflow-wrap:anywhere; }
    .shop-cart-item small { color:var(--color-taupe); }
    .shop-qty { display:flex; align-items:center; gap:0.35rem; }
    .shop-qty button { width:1.7rem; height:1.7rem; border-radius:999px; border:1px solid rgba(127,105,81,0.18); background:#fffaf4; color:var(--color-ink); font-weight:900; }
    .shop-cart-total { display:flex; justify-content:space-between; border-top:1px solid rgba(127,105,81,0.1); padding-top:0.75rem; color:var(--color-ink); font-weight:950; }
    .shop-cart-modal-card { width:min(100%, 560px) !important; }
    .shop-cart-modal-body { display:grid; gap:0.75rem; }
    .shop-cart-empty { min-height:8rem; display:grid; place-items:center; text-align:center; color:var(--color-taupe); border:1px dashed rgba(127,105,81,0.18); border-radius:1rem; background:rgba(244,240,228,0.42); }
    .shop-config-grid { display:grid; grid-template-columns:11rem minmax(0, 1fr); gap:1rem; align-items:start; }
    .shop-config-preview { min-height:9rem; border-radius:1rem; overflow:hidden; display:grid; place-items:center; background:rgba(244,240,228,0.65); color:var(--color-taupe); }
    .shop-config-preview img { width:100%; height:100%; object-fit:cover; }
    .shop-config-fields { display:grid; gap:0.65rem; min-width:0; }
    @@media (max-width: 1100px) { .shop-side { position:static; grid-template-columns:repeat(2, minmax(0, 1fr)); } .shop-feature-grid { grid-template-columns:repeat(2, minmax(0, 1fr)); } }
    @@media (max-width: 820px) { .shop-nav { grid-template-columns:1fr; } .shop-nav-actions { justify-content:space-between; } .shop-search { min-width:0; flex:1; } .shop-hero { min-height:360px; padding:1.1rem; } .shop-side { grid-template-columns:1fr; } .shop-config-grid { grid-template-columns:1fr; } }
    @@media (max-width: 640px) { .shop-feature-grid, .shop-product-grid { grid-template-columns:1fr; } }
</style>

@if (isLoading)
{
    <section class="management-shell">
        <div class="management-card">
            <h1>Cargando tienda online...</h1>
        </div>
    </section>
}
else if (!canViewModule)
{
    <section class="management-shell">
        <div class="management-card">
            <span class="eyebrow">Restringido</span>
            <h1>Tienda online</h1>
            <p>Tu rol no tiene permiso para ver este modulo.</p>
        </div>
    </section>
}
else
{
    <section class="management-shell shop-shell">
        <div class="shop-top-note">@storeSettings.BannerText</div>

        <nav class="shop-nav" aria-label="Navegacion de tienda">
            <div class="shop-category-nav">
                @foreach (var category in categories)
                {
                    <button type="button" class="@(categoryFilter == category ? "is-active" : string.Empty)" @onclick="() => SelectCategory(category)">@category</button>
                }
            </div>

            <div class="shop-nav-actions">
                <label class="shop-search">
                    <i class="bi bi-search"></i>
                    <input @bind="searchTerm" @bind:event="oninput" placeholder="Buscar" />
                </label>
                <button type="button" class="shop-cart-button" @onclick="ToggleCart">
                    <i class="bi bi-bag"></i>
                    @if (CartCount > 0)
                    {
                        <span class="shop-cart-count">@CartCount</span>
                    }
                </button>
            </div>
        </nav>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        <section class="shop-hero">
            @if (!string.IsNullOrWhiteSpace(storeSettings.HeroImage))
            {
                <img src="@storeSettings.HeroImage" alt="Imagen principal de tienda" />
            }
            @if (CanEditStorefront)
            {
                <button type="button" class="btn btn-primary shop-admin-edit" @onclick="OpenStoreEditor">
                    <i class="bi bi-pencil-square"></i> Editar portada
                </button>
            }
            <div class="shop-hero-copy">
                <span class="shop-hero-brand">@storeSettings.BrandName</span>
                <h1>@storeSettings.HeroTitle</h1>
                <p>@storeSettings.HeroSubtitle</p>
                <div class="shop-hero-actions">
                    <button type="button" class="btn btn-primary" @onclick="OpenCart">@storeSettings.HeroButton</button>
                    <button type="button" class="btn btn-outline-primary" style="background:rgba(255,250,244,0.88) !important;" @onclick="ToggleCart">
                        <i class="bi bi-bag-check"></i> Ver carrito
                    </button>
                </div>
            </div>
        </section>

        <section>
            <div class="shop-section-title">
                <div>
                    <h2>@storeSettings.FeatureTitle</h2>
                    <p>@storeSettings.FeatureSubtitle</p>
                </div>
                <span class="eyebrow">@FeaturedCategories.Count opciones</span>
            </div>
            <div class="shop-feature-grid" style="margin-top:0.85rem;">
                @foreach (var item in FeaturedCategories)
                {
                    <button type="button" class="shop-feature-card" @onclick="() => SelectCategory(item.Name)">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Name" />
                        }
                        <span>@item.Name</span>
                        <small>@item.Count productos</small>
                    </button>
                }
            </div>
        </section>

        <section id="storeCatalog" class="shop-storefront">
            <div>
                <div class="shop-section-title">
                    <div>
                        <h2>Catalogo</h2>
                        <p>@FilteredProducts.Count productos listos para comprar</p>
                    </div>
                </div>

                <div class="shop-product-grid" style="margin-top:0.85rem;">
                    @if (FilteredProducts.Count == 0)
                    {
                        <div class="management-card store-empty">
                            <div>
                                <i class="bi bi-search" style="font-size:2rem; color:var(--color-sage);"></i>
                                <p style="margin:0.6rem 0 0;">No hay productos que coincidan con la busqueda.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in FilteredProducts)
                        {
                            <article class="shop-product-card">
                                <div class="shop-product-image">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-eyeglasses"></i>
                                    }
                                </div>
                                <div class="shop-product-body">
                                    <div class="shop-product-title-row">
                                        <div>
                                            <h3>@item.Name</h3>
                                            <small style="color:var(--color-taupe); font-weight:800;">@item.Code</small>
                                        </div>
                                        <span class="shop-product-tag">@item.Category</span>
                                    </div>
                                    <p>@item.Description</p>
                                    <div class="shop-product-meta">
                                        <span class="shop-stock @item.StockClass">@item.StockLabel</span>
                                    </div>
                                    <div class="shop-product-footer">
                                        <span class="shop-price">$@item.Price.ToString("0.00")</span>
                                        <button type="button" class="btn btn-primary" disabled="@(item.Stock <= 0)" @onclick="() => AddToCart(item)">
                                            <i class="bi bi-bag-plus-fill"></i> Agregar al carrito
                                        </button>
                                    </div>
                                </div>
                            </article>
                        }
                    }
                </div>
            </div>
        </section>
    </section>
}

@if (showCart)
{
    <div class="custom-modal-overlay" @onclick="CloseCart">
        <div class="custom-modal-card shop-cart-modal-card" @onclick:stopPropagation="true">
            <header class="custom-modal-header apricot-header">
                <h2><i class="bi bi-bag-check" style="color:var(--color-sage); margin-right:0.35rem;"></i>Carrito</h2>
                <button type="button" class="btn-close-modal" @onclick="CloseCart">x</button>
            </header>
            <div class="custom-modal-body shop-cart-modal-body">
                @if (cart.Count == 0)
                {
                    <div class="shop-cart-empty">
                        <div>
                            <i class="bi bi-bag" style="font-size:2rem; color:var(--color-sage);"></i>
                            <p style="margin:0.55rem 0 0;">Aun no agregas productos.</p>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var item in cart)
                    {
                        <div class="shop-cart-item">
                            <div>
                                <strong>@item.Name</strong>
                                <small>@item.Quantity x $@item.Price.ToString("0.00")</small>
                            </div>
                            <div class="shop-qty">
                                <button type="button" @onclick="() => DecreaseCartItem(item.ProductId)">-</button>
                                <b>@item.Quantity</b>
                                <button type="button" @onclick="() => IncreaseCartItem(item.ProductId)">+</button>
                            </div>
                        </div>
                    }
                    <div class="shop-cart-total">
                        <span>Total</span>
                        <span>$@CartTotal.ToString("0.00")</span>
                    </div>
                    <button type="button" class="btn btn-primary" @onclick="CheckoutCart">
                        <i class="bi bi-credit-card-2-front-fill"></i> Pagar
                    </button>
                    <button type="button" class="btn btn-outline-primary" @onclick="ClearCart">Vaciar carrito</button>
                }
                @if (!string.IsNullOrWhiteSpace(cartMessage))
                {
                    <small style="color:var(--color-sage); font-weight:800;">@cartMessage</small>
                }
            </div>
        </div>
    </div>
}

@if (showStoreEditor && storeEditor is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card form-modal-card">
            <header class="custom-modal-header rose-header">
                <h2>Editar tienda online</h2>
                <button type="button" class="btn-close-modal" @onclick="CloseStoreEditor">x</button>
            </header>
            <div class="custom-modal-body">
                <p style="margin-bottom:1rem; color:var(--color-taupe);">Estos cambios se muestran a los usuarios de la tienda. Solo el administrador ve esta edicion.</p>
                <div class="shop-config-grid">
                    <div class="shop-config-preview">
                        @if (!string.IsNullOrWhiteSpace(StoreHeroPreviewUrl))
                        {
                            <img src="@StoreHeroPreviewUrl" alt="Portada de tienda" />
                        }
                        else
                        {
                            <i class="bi bi-image" style="font-size:2rem;"></i>
                        }
                    </div>
                    <div class="shop-config-fields">
                        <div>
                            <label class="form-label">Texto superior</label>
                            <input class="form-control" @bind="storeEditor.BannerText" maxlength="180" />
                        </div>
                        <div>
                            <label class="form-label">Titulo principal</label>
                            <input class="form-control" @bind="storeEditor.HeroTitle" maxlength="180" />
                        </div>
                        <div>
                            <label class="form-label">Texto principal</label>
                            <textarea class="form-control" rows="3" @bind="storeEditor.HeroSubtitle" maxlength="300"></textarea>
                        </div>
                        <div>
                            <label class="form-label">Texto del boton</label>
                            <input class="form-control" @bind="storeEditor.HeroButton" maxlength="80" />
                        </div>
                        <div>
                            <label class="form-label">Imagen principal</label>
                            <input class="form-control" @bind="storeEditor.HeroImage" maxlength="500" placeholder="/images/store/portada.jpg o https://..." />
                            <InputFile OnChange="OnStoreHeroImageSelected" class="form-control" accept="image/png,image/jpeg,image/webp" />
                        </div>
                        <div>
                            <label class="form-label">Titulo productos basicos</label>
                            <input class="form-control" @bind="storeEditor.FeatureTitle" maxlength="120" />
                        </div>
                        <div>
                            <label class="form-label">Subtitulo productos basicos</label>
                            <input class="form-control" @bind="storeEditor.FeatureSubtitle" maxlength="240" />
                        </div>
                    </div>
                </div>
            </div>
            <footer class="custom-modal-footer">
                <button type="button" class="btn btn-primary" @onclick="SaveStoreSettingsAsync">Guardar portada</button>
                <button type="button" class="btn btn-outline-primary" @onclick="CloseStoreEditor">Cerrar</button>
            </footer>
        </div>
    </div>
}

@code {
    private readonly List<StoreProductRow> products = [];
    private readonly List<string> categories = [];
    private readonly List<CartItem> cart = [];
    private bool isLoading = true;
    private bool canViewModule;
    private string? errorMessage;
    private int currentRoleId;
    private int currentUserId;
    private string searchTerm = string.Empty;
    private string categoryFilter = string.Empty;
    private bool showCart;
    private bool cartRestored;
    private string? cartMessage;
    private bool showStoreEditor;
    private StorefrontSettings storeSettings = StorefrontSettings.Default();
    private StorefrontSettings? storeEditor;
    private byte[]? pendingHeroImageBytes;
    private string? pendingHeroImageExtension;
    private string? pendingHeroImagePreview;
    private const long MaxStoreImageSize = 4 * 1024 * 1024;

    private bool CanEditStorefront => currentRoleId == 1;
    private string? StoreHeroPreviewUrl => pendingHeroImagePreview ?? storeEditor?.HeroImage;
    private int CartCount => cart.Sum(x => x.Quantity);
    private decimal CartTotal => cart.Sum(x => x.Price * x.Quantity);
    private string CartStorageKey => currentUserId > 0
        ? $"optometria-online-store-cart-user-{currentUserId}"
        : "optometria-online-store-cart-anonymous";

    private List<StoreProductRow> FilteredProducts => products
        .Where(x => string.IsNullOrWhiteSpace(searchTerm)
            || x.SearchBlob.Contains(searchTerm.Trim(), StringComparison.OrdinalIgnoreCase))
        .Where(x => string.IsNullOrWhiteSpace(categoryFilter)
            || string.Equals(x.Category, categoryFilter, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(x => x.Stock > 0)
        .ThenBy(x => x.Name)
        .ToList();

    private List<CategorySummary> CategorySummaries => products
        .GroupBy(x => x.Category)
        .Select(group => new CategorySummary(group.Key, group.Count(), group.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.ImageUrl))?.ImageUrl ?? string.Empty))
        .OrderByDescending(x => x.Count)
        .ThenBy(x => x.Name)
        .ToList();

    private List<CategorySummary> FeaturedCategories => CategorySummaries.Take(4).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && canViewModule && !cartRestored)
        {
            cartRestored = true;
            await RestoreCartAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            currentUserId = int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var parsedUserId) ? parsedUserId : 0;
            currentRoleId = int.TryParse(user.FindFirstValue("RoleId"), out var parsedRoleId) ? parsedRoleId : 0;

            canViewModule = currentRoleId == 1 || await dbContext.tbl_rol_menu_permisos
                .AsNoTracking()
                .Where(x => x.id_rol == currentRoleId && x.puede_ver)
                .Join(
                    dbContext.tbl_menu_apps.AsNoTracking().Where(x => x.ruta == "/tienda-online"),
                    permission => permission.id_menu,
                    menu => menu.id_menu,
                    (_, _) => true)
                .AnyAsync();

            if (!canViewModule)
            {
                return;
            }

            var settingsEntity = await dbContext.tbl_configuracion_opticas.AsNoTracking().OrderBy(x => x.id_configuracion).FirstOrDefaultAsync();
            storeSettings = StorefrontSettings.FromEntity(settingsEntity);

            var rows = await (
                from product in ProductInventoryRules.FilterStoreVisible(dbContext.tbl_productos.AsNoTracking())
                join category in dbContext.tbl_categoria_productos.AsNoTracking() on product.id_categoria equals category.id_categoria into categoryJoin
                from category in categoryJoin.DefaultIfEmpty()
                select new
                {
                    product.id_producto,
                    product.codigo_producto,
                    product.nombre_producto,
                    product.descripcion,
                    product.imagen_url,
                    product.precio_venta,
                    product.stock_actual,
                    product.tiene_iva,
                    product.porcentaje_iva,
                    CategoryName = category != null ? category.nombre : null
                })
                .ToListAsync();

            products.Clear();
            products.AddRange(rows.Select(x => new StoreProductRow
            {
                ProductId = x.id_producto,
                Code = x.codigo_producto ?? "SIN-CODIGO",
                Name = x.nombre_producto ?? "Producto",
                Description = string.IsNullOrWhiteSpace(x.descripcion) ? "Sin descripcion comercial cargada." : x.descripcion!,
                ImageUrl = x.imagen_url ?? string.Empty,
                Category = string.IsNullOrWhiteSpace(x.CategoryName) ? "Sin categoria" : x.CategoryName!,
                Price = x.precio_venta,
                Stock = x.stock_actual ?? 0,
                TaxLabel = (x.tiene_iva ?? false) ? $"Si, {(x.porcentaje_iva ?? 0m):0.##}%" : "No",
                SearchBlob = $"{x.codigo_producto} {x.nombre_producto} {x.descripcion} {x.imagen_url} {x.CategoryName}"
            }));

            categories.Clear();
            categories.AddRange(products.Select(x => x.Category).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x));
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo cargar la tienda online: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

