    private async Task AddToCart(StoreProductRow product)
    {
        if (product.Stock <= 0)
        {
            cartMessage = "Este producto esta agotado.";
            showCart = true;
            return;
        }

        var item = cart.FirstOrDefault(x => x.ProductId == product.ProductId);
        if (item is null)
        {
            cart.Add(new CartItem
            {
                ProductId = product.ProductId,
                Name = product.Name,
                Price = product.Price,
                Stock = product.Stock,
                Quantity = 1
            });
        }
        else if (item.Quantity < item.Stock)
        {
            item.Quantity++;
        }
        else
        {
            cartMessage = "No puedes agregar mas unidades de este producto disponible.";
        }

        showCart = true;
        await SaveCartAsync();
    }

    private async Task IncreaseCartItem(int productId)
    {
        var item = cart.FirstOrDefault(x => x.ProductId == productId);
        if (item is not null && item.Quantity < item.Stock)
        {
            item.Quantity++;
            await SaveCartAsync();
        }
    }

    private async Task DecreaseCartItem(int productId)
    {
        var item = cart.FirstOrDefault(x => x.ProductId == productId);
        if (item is null)
        {
            return;
        }

        item.Quantity--;
        if (item.Quantity <= 0)
        {
            cart.Remove(item);
        }

        await SaveCartAsync();
    }

    private async Task ClearCart()
    {
        cart.Clear();
        cartMessage = null;
        await SaveCartAsync();
    }

    private void CheckoutCart()
    {
        cartMessage = cart.Count == 0
            ? "Agrega productos antes de finalizar."
            : "Pedido preparado. Confirma los datos del cliente para completar la compra.";
    }

    private async Task SaveCartAsync()
    {
        try
        {
            if (cart.Count == 0)
            {
                await JSRuntime.InvokeVoidAsync("localStorage.removeItem", CartStorageKey);
                return;
            }

            var payload = JsonSerializer.Serialize(cart.Select(x => new StoredCartItem
            {
                ProductId = x.ProductId,
                Quantity = x.Quantity
            }));

            await JSRuntime.InvokeVoidAsync("localStorage.setItem", CartStorageKey, payload);
        }
        catch
        {
            cartMessage = "No se pudo guardar el carrito en este navegador.";
        }
    }

    private async Task RestoreCartAsync()
    {
        try
        {
            var payload = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", CartStorageKey);
            if (string.IsNullOrWhiteSpace(payload))
            {
                return;
            }

            var storedItems = JsonSerializer.Deserialize<List<StoredCartItem>>(payload) ?? [];
            cart.Clear();

            foreach (var storedItem in storedItems)
            {
                var product = products.FirstOrDefault(x => x.ProductId == storedItem.ProductId && x.Stock > 0);
                if (product is null)
                {
                    continue;
                }

                cart.Add(new CartItem
                {
                    ProductId = product.ProductId,
                    Name = product.Name,
                    Price = product.Price,
                    Stock = product.Stock,
                    Quantity = Math.Clamp(storedItem.Quantity, 1, product.Stock)
                });
            }

            await SaveCartAsync();
        }
        catch
        {
            cartMessage = "No se pudo recuperar el carrito guardado.";
        }
    }

    private void OpenStoreEditor()
    {
        if (!CanEditStorefront)
        {
            return;
        }

        storeEditor = storeSettings.Clone();
        pendingHeroImageBytes = null;
        pendingHeroImageExtension = null;
        pendingHeroImagePreview = null;
        showStoreEditor = true;
    }

    private void CloseStoreEditor()
    {
        showStoreEditor = false;
        storeEditor = null;
        pendingHeroImageBytes = null;
        pendingHeroImageExtension = null;
        pendingHeroImagePreview = null;
    }

    private async Task OnStoreHeroImageSelected(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "Selecciona una imagen valida.";
            return;
        }

        if (file.Size > MaxStoreImageSize)
        {
            errorMessage = "La imagen principal no debe superar 4 MB.";
            return;
        }

        await using var stream = file.OpenReadStream(MaxStoreImageSize);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        pendingHeroImageBytes = memory.ToArray();
        pendingHeroImageExtension = GetSafeImageExtension(file.Name, file.ContentType);
        pendingHeroImagePreview = $"data:{file.ContentType};base64,{Convert.ToBase64String(pendingHeroImageBytes)}";
    }

    private async Task SaveStoreSettingsAsync()
    {
        if (!CanEditStorefront || storeEditor is null)
        {
            return;
        }

        if (pendingHeroImageBytes is not null)
        {
            storeEditor.HeroImage = await SaveStoreImageAsync();
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var settingsEntity = await dbContext.tbl_configuracion_opticas.OrderBy(x => x.id_configuracion).FirstOrDefaultAsync();
        if (settingsEntity is null)
        {
            settingsEntity = new tbl_configuracion_optica();
            dbContext.tbl_configuracion_opticas.Add(settingsEntity);
        }

        storeEditor.ApplyTo(settingsEntity);
        await dbContext.SaveChangesAsync();
        storeSettings = storeEditor.Clone();
        CloseStoreEditor();
    }

    private async Task<string> SaveStoreImageAsync()
    {
        var extension = pendingHeroImageExtension ?? ".jpg";
        var fileName = $"store-hero-{DateTime.Now:yyyyMMddHHmmss}{extension}";
        var folder = Path.Combine(WebHostEnvironment.WebRootPath, "images", "store");
        Directory.CreateDirectory(folder);
        await File.WriteAllBytesAsync(Path.Combine(folder, fileName), pendingHeroImageBytes!);
        return $"/images/store/{fileName}";
    }

    private static string GetSafeImageExtension(string fileName, string contentType)
    {
        var extension = Path.GetExtension(fileName).ToLowerInvariant();
        if (extension is ".jpg" or ".jpeg" or ".png" or ".webp")
        {
            return extension;
        }

        return contentType.ToLowerInvariant() switch
        {
            "image/png" => ".png",
            "image/webp" => ".webp",
            _ => ".jpg"
        };
    }

    private sealed class StoreProductRow
    {
        public int ProductId { get; set; }
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string ImageUrl { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public int Stock { get; set; }
        public string TaxLabel { get; set; } = "No";
        public string SearchBlob { get; set; } = string.Empty;
        public string StockLabel => Stock <= 0 ? "Producto agotado" : "Producto disponible";
        public string StockClass => Stock <= 0 ? "stock-out" : Stock <= 5 ? "stock-low" : "stock-ok";
    }

    private sealed class CartItem
    {
        public int ProductId { get; set; }
        public string Name { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public int Stock { get; set; }
        public int Quantity { get; set; }
    }

    private sealed class StoredCartItem
    {
        public int ProductId { get; set; }
        public int Quantity { get; set; }
    }

    private sealed record CategorySummary(string Name, int Count, string ImageUrl);

    private sealed class StorefrontSettings
    {
        public string BrandName { get; set; } = "Optica Lux";
        public string BannerText { get; set; } = "Compra tus lentes, monturas y accesorios con atencion personalizada.";
        public string HeroTitle { get; set; } = "Lentes que se ven bien y se sienten mejor";
        public string HeroSubtitle { get; set; } = "Explora productos seleccionados para cuidar tu vision con estilo, comodidad y disponibilidad real.";
        public string HeroButton { get; set; } = "Comprar ahora";
        public string HeroImage { get; set; } = string.Empty;
        public string FeatureTitle { get; set; } = "Productos basicos";
        public string FeatureSubtitle { get; set; } = "Entra rapido a las categorias principales del catalogo.";

        public static StorefrontSettings Default() => new();

        public static StorefrontSettings FromEntity(tbl_configuracion_optica? entity)
        {
            var settings = Default();
            if (entity is null)
            {
                return settings;
            }

            settings.BrandName = string.IsNullOrWhiteSpace(entity.nombre_comercial) ? settings.BrandName : entity.nombre_comercial!;
            settings.BannerText = string.IsNullOrWhiteSpace(entity.tienda_banner_texto) ? settings.BannerText : entity.tienda_banner_texto!;
            settings.HeroTitle = string.IsNullOrWhiteSpace(entity.tienda_hero_titulo) ? settings.HeroTitle : entity.tienda_hero_titulo!;
            settings.HeroSubtitle = string.IsNullOrWhiteSpace(entity.tienda_hero_subtitulo) ? settings.HeroSubtitle : entity.tienda_hero_subtitulo!;
            settings.HeroButton = string.IsNullOrWhiteSpace(entity.tienda_hero_boton) ? settings.HeroButton : entity.tienda_hero_boton!;
            settings.HeroImage = string.IsNullOrWhiteSpace(entity.tienda_hero_imagen) ? string.Empty : entity.tienda_hero_imagen!;
            settings.FeatureTitle = string.IsNullOrWhiteSpace(entity.tienda_basicos_titulo) ? settings.FeatureTitle : entity.tienda_basicos_titulo!;
            settings.FeatureSubtitle = string.IsNullOrWhiteSpace(entity.tienda_basicos_subtitulo) ? settings.FeatureSubtitle : entity.tienda_basicos_subtitulo!;
            return settings;
        }

        public StorefrontSettings Clone() => new()
        {
            BrandName = BrandName,
            BannerText = BannerText,
            HeroTitle = HeroTitle,
            HeroSubtitle = HeroSubtitle,
            HeroButton = HeroButton,
            HeroImage = HeroImage,
            FeatureTitle = FeatureTitle,
            FeatureSubtitle = FeatureSubtitle
        };

        public void ApplyTo(tbl_configuracion_optica entity)
        {
            entity.tienda_banner_texto = NormalizeOptional(BannerText);
            entity.tienda_hero_titulo = NormalizeOptional(HeroTitle);
            entity.tienda_hero_subtitulo = NormalizeOptional(HeroSubtitle);
            entity.tienda_hero_boton = NormalizeOptional(HeroButton);
            entity.tienda_hero_imagen = NormalizeOptional(HeroImage);
            entity.tienda_basicos_titulo = NormalizeOptional(FeatureTitle);
            entity.tienda_basicos_subtitulo = NormalizeOptional(FeatureSubtitle);
        }

        private static string? NormalizeOptional(string? value)
        {
            return string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        }
    }
