@page "/change-password"
@attribute [Authorize(Policy = "FullAccess")]
@layout AuthLayout
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Cambiar contrasena</PageTitle>

<div class="auth-shell auth-shell-change">
    <section class="auth-panel auth-panel-brand">
        <div class="wave-divider">
            <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                <path d="M 80,0 C 55,15 45,35 55,55 C 65,75 75,85 80,100 L 100,100 L 100,0 Z" fill="#F4F0E4" />
            </svg>
        </div>
    </section>

    <section class="auth-panel auth-panel-form">
        <div class="auth-card auth-card-change">
            <div class="auth-heading">
                <span class="eyebrow">Nueva contrasena</span>
                <h2>Cambiar contrasena</h2>
                <p>Despues del cambio volveras al panel principal.</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="alert alert-danger" role="alert">@Error</div>
            }

            <div class="password-policy">
                <strong>Politica de contrasena</strong>
                <p>Minimo 12 caracteres, mayuscula, minuscula, numero, simbolo, sin espacios y sin usar partes del usuario, nombre o correo.</p>
            </div>

            <form method="post" action="/auth/change-password" class="auth-form">
                <div class="auth-grid">
                    <div>
                        <label class="form-label" for="password">Nueva contrasena</label>
                        <div class="input-with-icon">
                            <i class="bi bi-lock"></i>
                            <div class="password-field">
                                <input id="password" name="password" type="@(showPassword ? "text" : "password")" class="form-control" required />
                                <button type="button" class="password-toggle" @onclick="TogglePasswordVisibility">
                                    <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="form-label" for="confirmPassword">Confirmar contrasena</label>
                        <div class="input-with-icon">
                            <i class="bi bi-shield-check"></i>
                            <div class="password-field">
                                <input id="confirmPassword" name="confirmPassword" type="@(showConfirmPassword ? "text" : "password")" class="form-control" required />
                                <button type="button" class="password-toggle" @onclick="ToggleConfirmPasswordVisibility">
                                    <i class="bi @(showConfirmPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary auth-submit">Guardar nueva contrasena</button>
            </form>
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    private bool showPassword;
    private bool showConfirmPassword;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        var forcePasswordChange = string.Equals(authState.User.FindFirst("ForcePasswordChange")?.Value, bool.TrueString, StringComparison.OrdinalIgnoreCase);
        if (!forcePasswordChange)
        {
            NavigationManager.NavigateTo("/dashboard");
        }
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private void ToggleConfirmPasswordVisibility()
    {
        showConfirmPassword = !showConfirmPassword;
    }
}
