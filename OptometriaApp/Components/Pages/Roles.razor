@page "/roles"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject MenuAccessService MenuAccessService

<PageTitle>Roles</PageTitle>

@if (!isAdmin)
{
    <section class="management-shell">
        <div class="management-card">
            <span class="eyebrow">Restringido</span>
            <h1>Gestion de roles</h1>
            <p>Solo el rol administrador puede editar roles, menus y permisos.</p>
        </div>
    </section>
}
else if (isLoading)
{
    <section class="management-shell">
        <div class="management-card">
            <h1>Cargando roles...</h1>
        </div>
    </section>
}
else
{
    <section class="management-shell">
        <div class="management-hero">
            <div>
                <span class="eyebrow">Administracion</span>
                <h1>Roles y permisos</h1>
                <p>Selecciona un rol, edita su descripcion y define exactamente que menus puede ver o administrar.</p>
            </div>

            <button type="button" class="btn btn-outline-primary" @onclick="PrepareNewRole">Nuevo rol</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-success" role="alert">@statusMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        <section class="management-card">
            <div class="management-card-header">
                <h2>Listado de roles</h2>
                <span>@roles.Count roles</span>
            </div>

            <div class="management-table-wrap">
                <table class="management-table soft-management-table">
                    <thead>
                        <tr>
                            <th>Rol</th>
                            <th>Descripcion</th>
                            <th>Menus asignados</th>
                            <th class="table-actions-cell">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in PagedRoles)
                        {
                            <tr>
                                <td><strong>@role.nombre</strong></td>
                                <td>@(string.IsNullOrWhiteSpace(role.descripcion) ? "Sin descripcion" : role.descripcion)</td>
                                <td>@GetVisibleMenuCount(role.id_rol)</td>
                                <td class="table-actions-cell">
                                    <button type="button" class="btn btn-outline-primary compact-action" @onclick="() => OpenEditRole(role.id_rol)">
                                        <i class="bi bi-pencil-fill"></i> Editar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="table-pager">
                <button type="button" class="btn btn-outline-primary compact-action" @onclick="PreviousRolePage" disabled="@(rolePage <= 1)">Anterior</button>
                <span>Pagina @rolePage de @TotalRolePages</span>
                <button type="button" class="btn btn-outline-primary compact-action" @onclick="NextRolePage" disabled="@(rolePage >= TotalRolePages)">Siguiente</button>
            </div>
        </section>
    </section>
}

@if (showFormModal)
{
    <div class="custom-modal-overlay" @onclick="CloseFormModal">
        <div class="custom-modal-card form-modal-card" @onclick:stopPropagation="true">
            <header class="custom-modal-header rose-header">
                <h2>@(selectedRoleId > 0 ? "Editar rol" : "Nuevo rol")</h2>
                <button type="button" class="btn-close-modal" @onclick="CloseFormModal">×</button>
            </header>

            <div class="custom-modal-body">
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger" role="alert">@errorMessage</div>
                }

                <section class="management-stack">
                    <div class="management-form-grid">
                        <div>
                            <label class="form-label" for="roleName">Nombre</label>
                            <input id="roleName" class="form-control" @bind="roleName" />
                        </div>

                        <div>
                            <label class="form-label" for="roleDescription">Descripcion</label>
                            <input id="roleDescription" class="form-control" @bind="roleDescription" />
                        </div>
                    </div>

                    <div>
                        <div class="management-card-header">
                            <h2>Permisos por menu</h2>
                            <span>@permissionRows.Count menus</span>
                        </div>

                        <div class="management-table-wrap">
                            <table class="management-table soft-management-table">
                                <thead>
                                    <tr>
                                        <th>Menu</th>
                                        <th>Ruta</th>
                                        <th>Ver</th>
                                        <th>Crear</th>
                                        <th>Editar</th>
                                        <th>Eliminar</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in permissionRows)
                                    {
                                        <tr>
                                            <td>@row.Nombre</td>
                                            <td>
                                                @if (string.IsNullOrWhiteSpace(row.Ruta))
                                                {
                                                    <span class="soft-status is-muted">Agrupador</span>
                                                }
                                                else
                                                {
                                                    <code>@row.Ruta</code>
                                                }
                                            </td>
                                            <td><input type="checkbox" @bind="row.PuedeVer" /></td>
                                            <td><input type="checkbox" @bind="row.PuedeCrear" /></td>
                                            <td><input type="checkbox" @bind="row.PuedeEditar" /></td>
                                            <td><input type="checkbox" @bind="row.PuedeEliminar" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>
            </div>

            <footer class="custom-modal-footer">
                <button type="button" class="btn btn-primary" @onclick="SaveRoleAsync">Guardar rol y permisos</button>
                <button type="button" class="btn btn-outline-primary" @onclick="CloseFormModal">Cerrar</button>
            </footer>
        </div>
    </div>
}

@code {
    private List<tbl_rol> roles = [];
    private List<tbl_menu_app> menus = [];
    private List<tbl_rol_menu_permiso> permissions = [];
    private List<PermissionEditorRow> permissionRows = [];
    private bool isAdmin;
    private bool isLoading = true;
    private int selectedRoleId;
    private string roleName = string.Empty;
    private string roleDescription = string.Empty;
    private bool showFormModal;
    private int rolePage = 1;
    private string? statusMessage;
    private string? errorMessage;
    private const int PageSize = 5;
    private IEnumerable<tbl_rol> PagedRoles => roles
        .OrderBy(r => r.id_rol)
        .Skip((rolePage - 1) * PageSize)
        .Take(PageSize);
    private int TotalRolePages => Math.Max(1, (int)Math.Ceiling(roles.Count / (double)PageSize));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAdmin = authState.User.FindFirst("RoleId")?.Value == "1";

        if (!isAdmin)
        {
            isLoading = false;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync(int? preserveRoleId = null)
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();

        roles = await dbContext.tbl_rols
            .AsNoTracking()
            .OrderBy(r => r.id_rol)
            .ToListAsync();

        menus = await dbContext.tbl_menu_apps
            .AsNoTracking()
            .OrderBy(m => m.orden)
            .ThenBy(m => m.nombre)
            .ToListAsync();

        permissions = await dbContext.tbl_rol_menu_permisos
            .AsNoTracking()
            .ToListAsync();

        selectedRoleId = preserveRoleId ?? roles.FirstOrDefault()?.id_rol ?? 0;
        BuildEditor();
        ClampRolePage();
        isLoading = false;
    }

    private void PrepareNewRole()
    {
        selectedRoleId = 0;
        roleName = string.Empty;
        roleDescription = string.Empty;
        permissionRows = menus
            .Select(menu => new PermissionEditorRow
            {
                IdMenu = menu.id_menu,
                Nombre = menu.nombre,
                Ruta = menu.ruta ?? string.Empty
            })
            .ToList();
        statusMessage = null;
        errorMessage = null;
        showFormModal = true;
    }

    private void OpenEditRole(int roleId)
    {
        selectedRoleId = roleId;
        BuildEditor();
        statusMessage = null;
        errorMessage = null;
        showFormModal = true;
    }

    private void CloseFormModal()
    {
        showFormModal = false;
        errorMessage = null;
    }

    private void BuildEditor()
    {
        var selectedRole = roles.FirstOrDefault(r => r.id_rol == selectedRoleId);
        roleName = selectedRole?.nombre ?? string.Empty;
        roleDescription = selectedRole?.descripcion ?? string.Empty;

        permissionRows = menus
            .Select(menu =>
            {
                var existingPermission = permissions.FirstOrDefault(p => p.id_rol == selectedRoleId && p.id_menu == menu.id_menu);
                return new PermissionEditorRow
                {
                    IdMenu = menu.id_menu,
                    Nombre = menu.nombre,
                    Ruta = menu.ruta ?? string.Empty,
                    PuedeVer = existingPermission?.puede_ver ?? false,
                    PuedeCrear = existingPermission?.puede_crear ?? false,
                    PuedeEditar = existingPermission?.puede_editar ?? false,
                    PuedeEliminar = existingPermission?.puede_eliminar ?? false
                };
            })
            .ToList();
    }

    private async Task SaveRoleAsync()
    {
        statusMessage = null;
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(roleName))
        {
            errorMessage = "Ingresa un nombre para el rol.";
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        tbl_rol roleEntity;

        if (selectedRoleId > 0)
        {
            roleEntity = await dbContext.tbl_rols.FirstAsync(r => r.id_rol == selectedRoleId);
            roleEntity.nombre = roleName.Trim();
            roleEntity.descripcion = string.IsNullOrWhiteSpace(roleDescription) ? null : roleDescription.Trim();
        }
        else
        {
            roleEntity = new tbl_rol
            {
                nombre = roleName.Trim(),
                descripcion = string.IsNullOrWhiteSpace(roleDescription) ? null : roleDescription.Trim()
            };

            dbContext.tbl_rols.Add(roleEntity);
            await dbContext.SaveChangesAsync();
            selectedRoleId = roleEntity.id_rol;
        }

        var existingPermissions = await dbContext.tbl_rol_menu_permisos
            .Where(p => p.id_rol == roleEntity.id_rol)
            .ToListAsync();

        foreach (var row in permissionRows)
        {
            var permission = existingPermissions.FirstOrDefault(p => p.id_menu == row.IdMenu);
            if (permission is null)
            {
                permission = new tbl_rol_menu_permiso
                {
                    id_rol = roleEntity.id_rol,
                    id_menu = row.IdMenu
                };

                dbContext.tbl_rol_menu_permisos.Add(permission);
            }

            permission.puede_ver = row.PuedeVer;
            permission.puede_crear = row.PuedeCrear;
            permission.puede_editar = row.PuedeEditar;
            permission.puede_eliminar = row.PuedeEliminar;
        }

        await dbContext.SaveChangesAsync();

        statusMessage = "El rol y sus permisos se guardaron correctamente.";
        await LoadAsync(roleEntity.id_rol);
        await MenuAccessService.NotifyMenusChangedAsync();
        showFormModal = false;
    }

    private int GetVisibleMenuCount(int roleId) =>
        permissions.Count(p => p.id_rol == roleId && p.puede_ver);

    private void PreviousRolePage()
    {
        if (rolePage > 1)
        {
            rolePage--;
        }
    }

    private void NextRolePage()
    {
        if (rolePage < TotalRolePages)
        {
            rolePage++;
        }
    }

    private void ClampRolePage()
    {
        if (rolePage > TotalRolePages)
        {
            rolePage = TotalRolePages;
        }
        else if (rolePage < 1)
        {
            rolePage = 1;
        }
    }

    private sealed class PermissionEditorRow
    {
        public int IdMenu { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string Ruta { get; set; } = string.Empty;
        public bool PuedeVer { get; set; }
        public bool PuedeCrear { get; set; }
        public bool PuedeEditar { get; set; }
        public bool PuedeEliminar { get; set; }
    }
}
