@page "/roles"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject MenuAccessService MenuAccessService

<PageTitle>Roles</PageTitle>

@if (!isAdmin)
{
    <section class="management-shell">
        <div class="management-card">
            <span class="eyebrow">Restringido</span>
            <h1>Gestión de roles</h1>
            <p>Solo el rol administrador puede editar roles, menús y permisos.</p>
        </div>
    </section>
}
else if (isLoading)
{
    <section class="management-shell">
        <div class="management-card">
            <h1>Cargando roles...</h1>
        </div>
    </section>
}
else
{
    <style>
        .roles-dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1.2rem;
            margin-bottom: 1.5rem;
        }

        .role-kpi-card {
            background: rgba(255, 250, 244, 0.95);
            border: 1px solid rgba(127, 105, 81, 0.12);
            border-radius: 1.3rem;
            padding: 1.25rem 1.4rem;
            display: flex;
            align-items: center;
            gap: 1.1rem;
            box-shadow: 0 10px 30px rgba(127, 105, 81, 0.06);
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

        .role-kpi-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 16px 36px rgba(127, 105, 81, 0.12);
        }

        .role-kpi-icon {
            width: 3.2rem;
            height: 3.2rem;
            border-radius: 1rem;
            display: grid;
            place-items: center;
            font-size: 1.4rem;
            flex-shrink: 0;
        }

        .kpi-icon-sage { background: rgba(93, 161, 129, 0.15); color: var(--color-sage); }
        .kpi-icon-apricot { background: rgba(254, 188, 100, 0.2); color: #c97e18; }
        .kpi-icon-rose { background: rgba(236, 204, 197, 0.4); color: #b05d53; }

        .role-kpi-info h3 {
            margin: 0;
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--color-ink);
            line-height: 1.1;
        }

        .role-kpi-info span {
            font-size: 0.82rem;
            color: var(--color-taupe);
            font-weight: 600;
        }

        .btn-new-role-glow {
            background: linear-gradient(135deg, var(--color-sage) 0%, #468668 100%) !important;
            color: #fff !important;
            border: none !important;
            border-radius: 999px !important;
            padding: 0.65rem 1.4rem !important;
            font-weight: 700 !important;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: 0 8px 20px rgba(93, 161, 129, 0.35);
            transition: all 0.25s ease;
        }

        .btn-new-role-glow:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 26px rgba(93, 161, 129, 0.45);
            filter: brightness(1.05);
        }

        .roles-card-container {
            background: rgba(255, 250, 244, 0.98);
            border: 1px solid rgba(127, 105, 81, 0.12);
            border-radius: 1.6rem;
            padding: 1.75rem;
            box-shadow: 0 16px 40px rgba(127, 105, 81, 0.07);
        }

        .roles-floating-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 0.65rem;
        }

        .roles-floating-table thead th {
            border: none;
            color: var(--color-taupe);
            font-size: 0.78rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            padding: 0 1.25rem 0.5rem;
        }

        .roles-floating-table tbody tr {
            background: #ffffff;
            border-radius: 1rem;
            box-shadow: 0 4px 16px rgba(127, 105, 81, 0.05);
            transition: all 0.2s ease;
        }

        .roles-floating-table tbody tr:hover {
            transform: scale(1.008) translateY(-2px);
            box-shadow: 0 10px 24px rgba(127, 105, 81, 0.12);
            background: #fffdfa;
        }

        .roles-floating-table tbody td {
            padding: 1rem 1.25rem;
            vertical-align: middle;
            border-top: 1px solid rgba(127, 105, 81, 0.06);
            border-bottom: 1px solid rgba(127, 105, 81, 0.06);
        }

        .roles-floating-table tbody td:first-child {
            border-left: 1px solid rgba(127, 105, 81, 0.06);
            border-top-left-radius: 1rem;
            border-bottom-left-radius: 1rem;
        }

        .roles-floating-table tbody td:last-child {
            border-right: 1px solid rgba(127, 105, 81, 0.06);
            border-top-right-radius: 1rem;
            border-bottom-right-radius: 1rem;
            text-align: right;
        }

        .role-identity {
            display: flex;
            align-items: center;
            gap: 0.9rem;
        }

        .role-badge-avatar {
            width: 2.6rem;
            height: 2.6rem;
            border-radius: 0.85rem;
            display: grid;
            place-items: center;
            font-size: 1.15rem;
            flex-shrink: 0;
        }

        .role-avatar-admin { background: linear-gradient(135deg, rgba(142, 68, 173, 0.18), rgba(254, 188, 100, 0.3)); color: #7d3c98; }
        .role-avatar-recep { background: rgba(93, 161, 129, 0.2); color: var(--color-sage); }
        .role-avatar-medico { background: rgba(52, 152, 219, 0.2); color: #2980b9; }
        .role-avatar-bodega { background: rgba(230, 126, 34, 0.2); color: #d35400; }
        .role-avatar-paciente { background: rgba(236, 204, 197, 0.5); color: #b05d53; }
        .role-avatar-default { background: rgba(127, 105, 81, 0.15); color: var(--color-taupe); }

        .role-title-text {
            font-size: 0.98rem;
            font-weight: 800;
            color: var(--color-ink);
        }

        .role-desc-text {
            font-size: 0.85rem;
            color: var(--color-taupe);
            max-width: 28rem;
            line-height: 1.35;
        }

        .role-coverage-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.35rem 0.85rem;
            border-radius: 999px;
            font-size: 0.82rem;
            font-weight: 700;
            background: rgba(93, 161, 129, 0.12);
            color: var(--color-sage);
            border: 1px solid rgba(93, 161, 129, 0.25);
        }

        .role-coverage-badge.badge-total {
            background: linear-gradient(135deg, rgba(254, 188, 100, 0.25), rgba(93, 161, 129, 0.2));
            color: #b36e10;
            border-color: rgba(254, 188, 100, 0.4);
        }

        .btn-edit-role-pill {
            background: rgba(244, 240, 228, 0.85);
            border: 1px solid rgba(127, 105, 81, 0.2);
            color: var(--color-taupe-deep);
            border-radius: 999px;
            padding: 0.42rem 1.05rem;
            font-size: 0.82rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            transition: all 0.2s ease;
        }

        .btn-edit-role-pill:hover {
            background: var(--color-sage);
            color: #ffffff;
            border-color: var(--color-sage);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(93, 161, 129, 0.3);
        }
    </style>

    <section class="management-shell">
        <div class="management-hero" style="align-items: center;">
            <div>
                <span class="eyebrow" style="letter-spacing: 0.12em;"><i class="bi bi-shield-lock-fill"></i> Seguridad y Acceso</span>
                <h1 style="margin-top: 0.2rem;">Roles y permisos</h1>
                <p>Configura las atribuciones operativas de cada perfil en la clínica.</p>
            </div>

            <button type="button" class="btn-new-role-glow" @onclick="PrepareNewRole">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Nuevo rol</span>
            </button>
        </div>

        <!-- KPI Widgets -->
        <div class="roles-dashboard-grid">
            <article class="role-kpi-card">
                <div class="role-kpi-icon kpi-icon-sage">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="role-kpi-info">
                    <h3>@roles.Count</h3>
                    <span>Roles registrados</span>
                </div>
            </article>

            <article class="role-kpi-card">
                <div class="role-kpi-icon kpi-icon-apricot">
                    <i class="bi bi-grid-3x3-gap-fill"></i>
                </div>
                <div class="role-kpi-info">
                    <h3>@menus.Count</h3>
                    <span>Módulos de sistema</span>
                </div>
            </article>

            <article class="role-kpi-card">
                <div class="role-kpi-icon kpi-icon-rose">
                    <i class="bi bi-key-fill"></i>
                </div>
                <div class="role-kpi-info">
                    <h3>RBAC</h3>
                    <span>Matriz dinámica</span>
                </div>
            </article>
        </div>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-success" role="alert" style="border-radius: 1rem;">@statusMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger" role="alert" style="border-radius: 1rem;">@errorMessage</div>
        }

        <section class="roles-card-container">
            <div class="management-card-header" style="border-bottom: 1px solid rgba(127, 105, 81, 0.08); padding-bottom: 1rem; margin-bottom: 0.5rem;">
                <div>
                    <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--color-ink); margin: 0;">Matriz de Perfiles</h2>
                    <small style="color: var(--color-taupe);">Haz clic en editar para gestionar privilegios por módulo</small>
                </div>
                <span style="font-weight: 700; color: var(--color-taupe); background: rgba(127, 105, 81, 0.08); padding: 0.3rem 0.8rem; border-radius: 999px; font-size: 0.8rem;">
                    @roles.Count perfiles activos
                </span>
            </div>

            <div class="table-responsive">
                <table class="roles-floating-table">
                    <thead>
                        <tr>
                            <th>Perfil / Rol</th>
                            <th>Descripción operativa</th>
                            <th>Módulos con acceso</th>
                            <th style="text-align: right; padding-right: 1.5rem;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in PagedRoles)
                        {
                            var visibleCount = GetVisibleMenuCount(role.id_rol);
                            var isFullAccess = visibleCount >= menus.Count && menus.Count > 0;
                            var avatarClass = role.nombre.ToLower() switch
                            {
                                var n when n.Contains("admin") => "role-avatar-admin",
                                var n when n.Contains("recep") => "role-avatar-recep",
                                var n when n.Contains("optomet") || n.Contains("medic") => "role-avatar-medico",
                                var n when n.Contains("bodeg") => "role-avatar-bodega",
                                var n when n.Contains("paciente") => "role-avatar-paciente",
                                _ => "role-avatar-default"
                            };
                            var iconClass = role.nombre.ToLower() switch
                            {
                                var n when n.Contains("admin") => "bi-shield-check",
                                var n when n.Contains("recep") => "bi-headset",
                                var n when n.Contains("optomet") || n.Contains("medic") => "bi-eyeglasses",
                                var n when n.Contains("bodeg") => "bi-box-seam",
                                var n when n.Contains("paciente") => "bi-person-heart",
                                _ => "bi-person-badge"
                            };

                            <tr>
                                <td>
                                    <div class="role-identity">
                                        <div class="role-badge-avatar @avatarClass">
                                            <i class="bi @iconClass"></i>
                                        </div>
                                        <div>
                                            <div class="role-title-text">@role.nombre</div>
                                            <small style="color: var(--color-taupe); font-size: 0.75rem;">ID: #@role.id_rol</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="role-desc-text">
                                        @(string.IsNullOrWhiteSpace(role.descripcion) ? "Sin descripción asignada" : role.descripcion)
                                    </div>
                                </td>
                                <td>
                                    <div class="role-coverage-badge @(isFullAccess ? "badge-total" : string.Empty)">
                                        <i class="bi @(isFullAccess ? "bi-stars" : "bi-check2-circle")"></i>
                                        <span>@visibleCount de @menus.Count módulos</span>
                                    </div>
                                </td>
                                <td>
                                    <button type="button" class="btn-edit-role-pill" @onclick="() => OpenEditRole(role.id_rol)">
                                        <i class="bi bi-sliders"></i>
                                        <span>Editar permisos</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="table-pager" style="margin-top: 1.2rem; display: flex; justify-content: space-between; align-items: center;">
                <button type="button" class="btn btn-outline-primary compact-action" @onclick="PreviousRolePage" disabled="@(rolePage <= 1)">
                    <i class="bi bi-chevron-left"></i> Anterior
                </button>
                <span style="font-weight: 700; font-size: 0.85rem; color: var(--color-taupe);">Página @rolePage de @TotalRolePages</span>
                <button type="button" class="btn btn-outline-primary compact-action" @onclick="NextRolePage" disabled="@(rolePage >= TotalRolePages)">
                    Siguiente <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </section>
    </section>
}

@if (showFormModal)
{
    <div class="custom-modal-overlay" @onclick="CloseFormModal">
        <div class="custom-modal-card form-modal-card" @onclick:stopPropagation="true">
            <header class="custom-modal-header rose-header">
                <h2>@(selectedRoleId > 0 ? "Editar rol" : "Nuevo rol")</h2>
                <button type="button" class="btn-close-modal" @onclick="CloseFormModal">×</button>
            </header>

            <div class="custom-modal-body">
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger" role="alert">@errorMessage</div>
                }

                <section class="management-stack">
                    <div class="management-form-grid">
                        <div>
                            <label class="form-label" for="roleName">Nombre</label>
                            <input id="roleName" class="form-control" @bind="roleName" />
                        </div>

                        <div>
                            <label class="form-label" for="roleDescription">Descripcion</label>
                            <input id="roleDescription" class="form-control" @bind="roleDescription" />
                        </div>
                    </div>

                    <div>
                        <div class="management-card-header">
                            <h2>Permisos por menu</h2>
                            <span>@permissionRows.Count menus</span>
                        </div>

                        <div class="management-table-wrap">
                            <table class="management-table soft-management-table">
                                <thead>
                                    <tr>
                                        <th>Menu</th>
                                        <th>Ruta</th>
                                        <th>Ver</th>
                                        <th>Crear</th>
                                        <th>Editar</th>
                                        <th>Eliminar</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in permissionRows)
                                    {
                                        <tr>
                                            <td>@row.Nombre</td>
                                            <td>
                                                @if (string.IsNullOrWhiteSpace(row.Ruta))
                                                {
                                                    <span class="soft-status is-muted">Agrupador</span>
                                                }
                                                else
                                                {
                                                    <code>@row.Ruta</code>
                                                }
                                            </td>
                                            <td><input type="checkbox" @bind="row.PuedeVer" /></td>
                                            <td><input type="checkbox" @bind="row.PuedeCrear" /></td>
                                            <td><input type="checkbox" @bind="row.PuedeEditar" /></td>
                                            <td><input type="checkbox" @bind="row.PuedeEliminar" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>
            </div>

            <footer class="custom-modal-footer">
                <button type="button" class="btn btn-primary" @onclick="SaveRoleAsync">Guardar rol y permisos</button>
                <button type="button" class="btn btn-outline-primary" @onclick="CloseFormModal">Cerrar</button>
            </footer>
        </div>
    </div>
}

@code {
    private List<tbl_rol> roles = [];
    private List<tbl_menu_app> menus = [];
    private List<tbl_rol_menu_permiso> permissions = [];
    private List<PermissionEditorRow> permissionRows = [];
    private bool isAdmin;
    private bool isLoading = true;
    private int selectedRoleId;
    private string roleName = string.Empty;
    private string roleDescription = string.Empty;
    private bool showFormModal;
    private int rolePage = 1;
    private string? statusMessage;
    private string? errorMessage;
    private const int PageSize = 5;
    private IEnumerable<tbl_rol> PagedRoles => roles
        .OrderBy(r => r.id_rol)
        .Skip((rolePage - 1) * PageSize)
        .Take(PageSize);
    private int TotalRolePages => Math.Max(1, (int)Math.Ceiling(roles.Count / (double)PageSize));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAdmin = authState.User.FindFirst("RoleId")?.Value == "1";

        if (!isAdmin)
        {
            isLoading = false;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync(int? preserveRoleId = null)
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();

        roles = await dbContext.tbl_rols
            .AsNoTracking()
            .OrderBy(r => r.id_rol)
            .ToListAsync();

        menus = await dbContext.tbl_menu_apps
            .AsNoTracking()
            .OrderBy(m => m.orden)
            .ThenBy(m => m.nombre)
            .ToListAsync();

        permissions = await dbContext.tbl_rol_menu_permisos
            .AsNoTracking()
            .ToListAsync();

        selectedRoleId = preserveRoleId ?? roles.FirstOrDefault()?.id_rol ?? 0;
        BuildEditor();
        ClampRolePage();
        isLoading = false;
    }

    private void PrepareNewRole()
    {
        selectedRoleId = 0;
        roleName = string.Empty;
        roleDescription = string.Empty;
        permissionRows = menus
            .Select(menu => new PermissionEditorRow
            {
                IdMenu = menu.id_menu,
                Nombre = menu.nombre,
                Ruta = menu.ruta ?? string.Empty
            })
            .ToList();
        statusMessage = null;
        errorMessage = null;
        showFormModal = true;
    }

    private void OpenEditRole(int roleId)
    {
        selectedRoleId = roleId;
        BuildEditor();
        statusMessage = null;
        errorMessage = null;
        showFormModal = true;
    }

    private void CloseFormModal()
    {
        showFormModal = false;
        errorMessage = null;
    }

    private void BuildEditor()
    {
        var selectedRole = roles.FirstOrDefault(r => r.id_rol == selectedRoleId);
        roleName = selectedRole?.nombre ?? string.Empty;
        roleDescription = selectedRole?.descripcion ?? string.Empty;

        permissionRows = menus
            .Select(menu =>
            {
                var existingPermission = permissions.FirstOrDefault(p => p.id_rol == selectedRoleId && p.id_menu == menu.id_menu);
                return new PermissionEditorRow
                {
                    IdMenu = menu.id_menu,
                    Nombre = menu.nombre,
                    Ruta = menu.ruta ?? string.Empty,
                    PuedeVer = existingPermission?.puede_ver ?? false,
                    PuedeCrear = existingPermission?.puede_crear ?? false,
                    PuedeEditar = existingPermission?.puede_editar ?? false,
                    PuedeEliminar = existingPermission?.puede_eliminar ?? false
                };
            })
            .ToList();
    }

    private async Task SaveRoleAsync()
    {
        statusMessage = null;
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(roleName))
        {
            errorMessage = "Ingresa un nombre para el rol.";
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        tbl_rol roleEntity;

        if (selectedRoleId > 0)
        {
            roleEntity = await dbContext.tbl_rols.FirstAsync(r => r.id_rol == selectedRoleId);
            roleEntity.nombre = roleName.Trim();
            roleEntity.descripcion = string.IsNullOrWhiteSpace(roleDescription) ? null : roleDescription.Trim();
        }
        else
        {
            roleEntity = new tbl_rol
            {
                nombre = roleName.Trim(),
                descripcion = string.IsNullOrWhiteSpace(roleDescription) ? null : roleDescription.Trim()
            };

            dbContext.tbl_rols.Add(roleEntity);
            await dbContext.SaveChangesAsync();
            selectedRoleId = roleEntity.id_rol;
        }

        var existingPermissions = await dbContext.tbl_rol_menu_permisos
            .Where(p => p.id_rol == roleEntity.id_rol)
            .ToListAsync();

        foreach (var row in permissionRows)
        {
            var permission = existingPermissions.FirstOrDefault(p => p.id_menu == row.IdMenu);
            if (permission is null)
            {
                permission = new tbl_rol_menu_permiso
                {
                    id_rol = roleEntity.id_rol,
                    id_menu = row.IdMenu
                };

                dbContext.tbl_rol_menu_permisos.Add(permission);
            }

            permission.puede_ver = row.PuedeVer;
            permission.puede_crear = row.PuedeCrear;
            permission.puede_editar = row.PuedeEditar;
            permission.puede_eliminar = row.PuedeEliminar;
        }

        await dbContext.SaveChangesAsync();

        statusMessage = "El rol y sus permisos se guardaron correctamente.";
        await LoadAsync(roleEntity.id_rol);
        await MenuAccessService.NotifyMenusChangedAsync();
        showFormModal = false;
    }

    private int GetVisibleMenuCount(int roleId) =>
        permissions.Count(p => p.id_rol == roleId && p.puede_ver);

    private void PreviousRolePage()
    {
        if (rolePage > 1)
        {
            rolePage--;
        }
    }

    private void NextRolePage()
    {
        if (rolePage < TotalRolePages)
        {
            rolePage++;
        }
    }

    private void ClampRolePage()
    {
        if (rolePage > TotalRolePages)
        {
            rolePage = TotalRolePages;
        }
        else if (rolePage < 1)
        {
            rolePage = 1;
        }
    }

    private sealed class PermissionEditorRow
    {
        public int IdMenu { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string Ruta { get; set; } = string.Empty;
        public bool PuedeVer { get; set; }
        public bool PuedeCrear { get; set; }
        public bool PuedeEditar { get; set; }
        public bool PuedeEliminar { get; set; }
    }
}
