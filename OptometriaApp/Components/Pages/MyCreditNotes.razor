        public string InvoiceState { get; set; } = "Vigente";
        public List<CreditNoteDetailLineView> Details { get; set; } = [];
        public string IssueDateLabel => IssueDate.ToString("yyyy-MM-dd HH:mm");
        public string ExpirationDateLabel => ExpirationDate?.ToString("yyyy-MM-dd") ?? "Sin vencimiento";
    }

    private sealed class CreditNoteDetailLineView
    {
        public string ProductCode { get; set; } = string.Empty;
        public string Concept { get; set; } = string.Empty;
        public decimal TaxRate { get; set; }
        public int? Quantity { get; set; }
        public decimal Subtotal { get; set; }
        public decimal Tax { get; set; }
        public decimal Total { get; set; }
        public string TaxLabel => TaxRate > 0m ? $"{TaxRate:0.##}%" : "No";
        public string QuantityLabel => Quantity.HasValue && Quantity.Value > 0 ? Quantity.Value.ToString() : "-";
    }
}
