    private static string ResolveInvoiceCreditState(decimal currentTotal, decimal totalCredited)
    {
        if (currentTotal <= 0.009m)
        {
            return "Totalmente acreditada";
        }

        return totalCredited > 0m ? "Parcialmente acreditada" : "Vigente";
    }

    private static string ResolveCreditNoteStatus(string? state, decimal? availableBalance, DateTime? expirationDate)
    {
        if (expirationDate.HasValue && expirationDate.Value.Date < DateTime.Today && (availableBalance ?? 0m) > 0m)
        {
            return "Vencida";
        }

        if ((availableBalance ?? 0m) <= 0.009m)
        {
            return "Aplicada";
        }

        return string.IsNullOrWhiteSpace(state) || string.Equals(state, "Emitida", StringComparison.OrdinalIgnoreCase)
            ? "Disponible"
            : state!;
    }

    private async Task ReintegrateInventoryForCreditNoteAsync(OpticaDbContext dbContext, tbl_nota_credito note, string? invoiceNumber, List<CreditAllocation> allocations)
    {
        var detailIds = allocations.Select(x => x.DetailSaleId).Distinct().ToList();
        if (detailIds.Count == 0)
        {
            return;
        }

        var saleDetails = await dbContext.tbl_detalle_venta
            .Where(x => detailIds.Contains(x.id_detalle_venta))
            .ToDictionaryAsync(x => x.id_detalle_venta);

        foreach (var allocation in allocations)
        {
            if (!saleDetails.TryGetValue(allocation.DetailSaleId, out var saleDetail))
            {
                continue;
            }

            var quantityToRestore = allocation.QuantityToCredit ?? 0;
            if (quantityToRestore <= 0)
            {
                continue;
            }

            var product = await dbContext.tbl_productos.FirstOrDefaultAsync(x => x.id_producto == saleDetail.id_producto);
            if (product is null)
            {
                continue;
            }

            var previousStock = product.stock_actual ?? 0;
            var newStock = previousStock + quantityToRestore;
            product.stock_actual = newStock;
            product.fecha_ultima_venta = DateTime.Now;

            dbContext.tbl_movimiento_inventarios.Add(new tbl_movimiento_inventario
            {
                id_producto = product.id_producto,
                id_usuario = currentUserId > 0 ? currentUserId : 1,
                tipo_movimiento = "Devolucion venta",
                cantidad = quantityToRestore,
                stock_anterior = previousStock,
                stock_resultante = newStock,
                fecha_movimiento = DateTime.Now,
                observaciones = $"Nota de credito {note.numero_nota} por devolucion sobre factura {invoiceNumber ?? note.id_comprobante_relacionado?.ToString() ?? "N/D"}",
                id_referencia_documento = note.id_nota_credito,
                tipo_documento_referencia = "NotaCredito",
                costo_unitario = saleDetail.cantidad > 0 ? Math.Round(allocation.Subtotal / saleDetail.cantidad, 2, MidpointRounding.AwayFromZero) : 0m,
                costo_total_movimiento = allocation.Subtotal,
                metodo_valuacion = "Promedio",
                id_usuario_autoriza = currentUserId > 0 ? currentUserId : null,
                comprobante_numero = note.numero_nota
            });

            dbContext.tbl_kardex.Add(new tbl_kardex
            {
                id_producto = product.id_producto,
                fecha_movimiento = DateTime.Now,
                tipo_movimiento = "Entrada por devolucion",
                id_referencia = note.id_nota_credito,
                tipo_referencia = "NotaCredito",
                comprobante_numero = note.numero_nota,
                cantidad_movimiento = quantityToRestore,
                costo_unitario = saleDetail.cantidad > 0 ? Math.Round(allocation.Subtotal / saleDetail.cantidad, 2, MidpointRounding.AwayFromZero) : 0m,
                costo_total = allocation.Subtotal,
                stock_anterior = previousStock,
                stock_nuevo = newStock,
                metodo_valuacion = "Promedio",
                id_usuario_movimiento = currentUserId > 0 ? currentUserId : null,
                descripcion_movimiento = $"Reintegro por nota de credito {note.numero_nota}",
                estado_kardex = "Registrado",
                observaciones = NormalizeOptional(note.motivo),
                fecha_creacion = DateTime.Now
            });
        }
    }

