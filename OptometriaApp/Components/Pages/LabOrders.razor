    private async Task SaveAsync()
    {
        if (editor is null)
        {
            return;
        }

        modalErrorMessage = ValidateEditor(editor);
        if (!string.IsNullOrWhiteSpace(modalErrorMessage))
        {
            return;
        }

        try
        {
            await using var db = await DbContextFactory.CreateDbContextAsync();
            var entity = editor.Id == 0
                ? new tbl_orden_rx { fecha_creacion = DateTime.Now }
                : await db.tbl_orden_rxes.FirstOrDefaultAsync(x => x.id_orden_rx == editor.Id);

            if (entity is null)
            {
                modalErrorMessage = "No se pudo cargar el pedido para actualizarlo.";
                return;
            }

            var isContact = string.Equals(editor.TipoRx, "Contactologia", StringComparison.OrdinalIgnoreCase);
            var normalizedState = NormalizeDbOrderState(editor.Estado);

            entity.id_consulta = editor.IdConsulta;
            entity.id_laboratorio = editor.IdLaboratorio;
            entity.tipo_rx = isContact ? "Contactologia" : "Lente Convencional";
            entity.estado = normalizedState;
            entity.observaciones = BuildObservations(editor);

            if (editor.SelectedRxId > 0)
            {
                entity.id_rx_lente = !isContact ? editor.SelectedRxId : null;
                entity.id_rx_contactologia = isContact ? editor.SelectedRxId : null;
            }
            else
            {
                if (!isContact)
                {
                    var newRx = new tbl_rx_lente
                    {
                        id_consulta = editor.IdConsulta,
                        od_esfera = ClinicalHistoryService.ParseOptDecimal(editor.OdEsfera),
                        od_cilindro = ClinicalHistoryService.ParseOptDecimal(editor.OdCilindro),
                        od_eje = ClinicalHistoryService.ParseOptDecimal(editor.OdEje),
                        od_addicion = ClinicalHistoryService.ParseOptDecimal(editor.OdAddicion),
                        od_dp = ClinicalHistoryService.ParseOptDecimal(editor.OdDp),
                        od_dnp = ClinicalHistoryService.ParseOptDecimal(editor.OdDnp),
                        od_altura = ClinicalHistoryService.ParseOptDecimal(editor.OdAltura),
                        oi_esfera = ClinicalHistoryService.ParseOptDecimal(editor.OiEsfera),
                        oi_cilindro = ClinicalHistoryService.ParseOptDecimal(editor.OiCilindro),
                        oi_eje = ClinicalHistoryService.ParseOptDecimal(editor.OiEje),
                        oi_addicion = ClinicalHistoryService.ParseOptDecimal(editor.OiAddicion),
                        oi_dp = ClinicalHistoryService.ParseOptDecimal(editor.OiDp),
                        oi_dnp = ClinicalHistoryService.ParseOptDecimal(editor.OiDnp),
                        oi_altura = ClinicalHistoryService.ParseOptDecimal(editor.OiAltura),
                        diseno_lente = NormalizeOpt(editor.DisenoLente),
                        material = NormalizeOpt(editor.Material),
                        tratamiento = NormalizeOpt(editor.Tratamiento),
                        observaciones = NormalizeOpt(editor.Observaciones)
                    };
                    db.tbl_rx_lentes.Add(newRx);
                    await db.SaveChangesAsync();
                    entity.id_rx_lente = newRx.id_rx_lente;
                    entity.id_rx_contactologia = null;
                }
                else
                {
                    var newRx = new tbl_rx_contactologia
                    {
                        id_consulta = editor.IdConsulta,
                        od_esfera = ClinicalHistoryService.ParseOptDecimal(editor.OdEsfera),
                        od_cilindro = ClinicalHistoryService.ParseOptDecimal(editor.OdCilindro),
                        od_eje = ClinicalHistoryService.ParseOptDecimal(editor.OdEje),
                        od_diametro = ClinicalHistoryService.ParseOptDecimal(editor.OdDiametro),
                        od_curva_base = ClinicalHistoryService.ParseOptDecimal(editor.OdCurvaBase),
                        oi_esfera = ClinicalHistoryService.ParseOptDecimal(editor.OiEsfera),
                        oi_cilindro = ClinicalHistoryService.ParseOptDecimal(editor.OiCilindro),
                        oi_eje = ClinicalHistoryService.ParseOptDecimal(editor.OiEje),
                        oi_diametro = ClinicalHistoryService.ParseOptDecimal(editor.OiDiametro),
                        oi_curva_base = ClinicalHistoryService.ParseOptDecimal(editor.OiCurvaBase),
                        tipo_lente = NormalizeOpt(editor.TipoLenteContacto),
                        observaciones = NormalizeOpt(editor.Observaciones)
                    };
                    db.tbl_rx_contactologia.Add(newRx);
                    await db.SaveChangesAsync();
                    entity.id_rx_contactologia = newRx.id_rx_contactologia;
                    entity.id_rx_lente = null;
                }
            }

            if (editor.Id == 0)
            {
                db.tbl_orden_rxes.Add(entity);
            }

            await db.SaveChangesAsync();

            if (editor.Id == 0)
            {
                entity.numero_orden = BuildOrderNumber(entity.id_orden_rx);
                editor.NumeroOrden = entity.numero_orden;
                await db.SaveChangesAsync();
            }

            await EnsureShipmentAsync(db, entity);
            await db.SaveChangesAsync();

            showForm = false;
            editor = null;
            modalErrorMessage = null;
            statusMessage = "Pedido a laboratorio guardado correctamente.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            modalErrorMessage = $"No se pudo guardar la orden: {ex.Message}";
        }
    }

    private async Task EnsureShipmentAsync(OpticaDbContext db, tbl_orden_rx order)
    {
        var effectiveUserId = currentUserId;
        if (effectiveUserId <= 0)
        {
            effectiveUserId = await db.tbl_usuarios.Where(u => u.activo == true).Select(u => u.id_usuario).FirstOrDefaultAsync();
            if (effectiveUserId <= 0) effectiveUserId = 1;
        }

        var shipment = await db.tbl_envio_laboratorios.FirstOrDefaultAsync(x => x.id_orden_rx == order.id_orden_rx);
        if (shipment is null)
        {
            shipment = new tbl_envio_laboratorio
            {
                id_orden_rx = order.id_orden_rx,
                id_usuario = effectiveUserId,
                canal = "WhatsApp",
                fecha_envio = order.fecha_creacion ?? DateTime.Now
            };
            db.tbl_envio_laboratorios.Add(shipment);
        }

        var normalizedState = NormalizeDbOrderState(order.estado);
        shipment.estado = normalizedState;
        if (string.Equals(normalizedState, "Listo para entrega", StringComparison.OrdinalIgnoreCase))
        {
            shipment.fecha_listo_entrega ??= DateTime.Now;
            shipment.fecha_cambio_estado = DateTime.Now;
        }
        else if (string.Equals(normalizedState, "Entregado al paciente", StringComparison.OrdinalIgnoreCase))
        {
            shipment.fecha_entregado ??= DateTime.Now;
            shipment.fecha_cambio_estado = DateTime.Now;
            shipment.id_usuario_entrega ??= effectiveUserId;
        }
    }

    private static string NormalizeDbOrderState(string? state)
    {
        if (string.IsNullOrWhiteSpace(state)) return "Enviado a laboratorio";
        if (state.Contains("Listo", StringComparison.OrdinalIgnoreCase)) return "Listo para entrega";
        if (state.Contains("Entregado", StringComparison.OrdinalIgnoreCase)) return "Entregado al paciente";
        return "Enviado a laboratorio";
    }

