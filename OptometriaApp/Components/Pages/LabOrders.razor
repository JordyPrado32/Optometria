@page "/pedidos-laboratorio"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using OptometriaApp.Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject LabMessagingService LabMessagingService
@inject IJSRuntime JSRuntime

<PageTitle>Pedidos a laboratorio</PageTitle>

@if (isLoading)
{
    <section class="management-shell"><div class="management-card"><h1>Cargando pedidos...</h1></div></section>
}
else if (!canViewModule)
{
    <section class="management-shell"><div class="management-card"><h1>Sin acceso</h1><p>Tu rol no tiene permiso para este modulo.</p></div></section>
}
else
{
    <section class="management-shell">
        <div class="management-hero">
            <div>
                <span class="eyebrow">Clinica</span>
                <h1>Pedidos a laboratorio</h1>
                <p>Registra la orden RX, asigna laboratorio y deja lista la trazabilidad para el flujo de envio y entrega.</p>
            </div>
            <div class="workspace-actions" style="align-items: center;">
                @if (permissions.CanCreate)
                {
                    <button type="button" class="btn btn-coffee" @onclick="PrepareNew">
                        <i class="bi bi-plus-lg" style="margin-right: 6px;"></i> Nuevo pedido
                    </button>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-success" role="alert">@statusMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        <section class="management-card compact-filter-card">
            <div class="management-card-header">
                <h2>Filtros y busqueda</h2>
                <span>@FilteredOrders.Count resultados</span>
            </div>
            <div class="filters-row-2">
                <div>
                    <label class="form-label">Buscar</label>
                    <input class="form-control" @bind="searchTerm" @bind:event="oninput" @bind:after="PersistFiltersAsync" placeholder="Paciente, cedula, laboratorio u orden" />
                </div>
                <div class="filter-selects-col-2">
                    <div>
                        <label class="form-label">Estado</label>
                        <select class="form-select" @bind="stateFilter" @bind:after="PersistFiltersAsync">
                            <option value="">Todos</option>
                            @foreach (var option in stateOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Laboratorio</label>
                        <select class="form-select" @bind="laboratoryFilter" @bind:after="PersistFiltersAsync">
                            <option value="">Todos</option>
                            @foreach (var laboratory in laboratories.OrderBy(x => x.nombre))
                            {
                                <option value="@laboratory.id_laboratorio.ToString()">@laboratory.nombre</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="management-actions" style="margin-top: 0.3rem;">
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ClearFilters">Limpiar filtros</button>
                @if (!string.IsNullOrWhiteSpace(rxFolderPath))
                {
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="OpenRxFolderAsync">Abrir carpeta RX</button>
                }
            </div>
        </section>

        <section class="management-card" style="margin-top: 1.5rem;">
            <div class="management-card-header">
                <h2>Pedidos registrados</h2>
                <span>@FilteredOrders.Count registrados</span>
            </div>
            <div class="table-responsive" style="margin-top: 1rem;">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Orden</th>
                            <th>Paciente</th>
                            <th>Laboratorio</th>
                            <th>Tipo RX</th>
                            <th>Estado</th>
                            <th>Fecha</th>
                            <th>Logistica</th>
                            <th style="text-align:right;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (PagedOrders.Count == 0)
                        {
                            <tr><td colspan="8" style="text-align:center; padding:2rem;">No hay pedidos con los filtros aplicados.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in PagedOrders)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.OrderNumber</strong>
                                        <div style="font-size:0.78rem; color:var(--color-taupe);">Consulta #@item.ConsultationId</div>
                                    </td>
                                    <td>
                                        @item.PatientName
                                        <div style="font-size:0.78rem; color:var(--color-taupe);">@item.PatientIdentifier</div>
                                    </td>
                                    <td>@item.LaboratoryName</td>
                                    <td>@item.RxTypeLabel</td>
                                    <td>@item.State</td>
                                    <td>@item.CreatedAtLabel</td>
                                    <td>@item.LogisticsLabel</td>
                                    <td style="text-align:right;">
                                        <div style="display:inline-flex; gap:0.4rem;">
                                            @if (permissions.CanEdit)
                                            {
                                                <button type="button" class="btn btn-outline-primary" @onclick="() => PrepareEdit(item.Id)">
                                                    <i class="bi bi-pencil-fill"></i> Editar
                                                </button>
                                                <button type="button" class="btn btn-outline-primary" @onclick="() => PrepareResend(item)">
                                                    <i class="bi bi-arrow-repeat"></i> Reenviar
                                                </button>
                                            }
                                            <a class="btn btn-outline-primary" href="/envios-laboratorio">
                                                <i class="bi bi-truck"></i> Envios
                                            </a>
                                            <a class="btn btn-outline-primary" href="@item.PatientTrackingUrl" target="_blank" rel="noopener noreferrer">
                                                <i class="bi bi-box-arrow-up-right"></i> Portal paciente
                                            </a>
                                            @if (!string.IsNullOrWhiteSpace(item.WhatsappUrl))
                                            {
                                                <a class="btn btn-outline-primary" href="@item.WhatsappUrl" target="_blank" rel="noopener noreferrer">
                                                    <i class="bi bi-whatsapp"></i> WhatsApp
                                                </a>
                                            }
                                            <a class="btn btn-outline-primary" href="@item.RxDownloadUrl" target="_blank" rel="noopener noreferrer">
                                                <i class="bi bi-file-earmark-text"></i> RX
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <TablePager TotalItems="@FilteredOrders.Count" CurrentPage="@currentPage" CurrentPageChanged="SetPage" />
        </section>
    </section>
}

@if (showForm && editor is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card form-modal-card" style="max-width: 920px;">
            <header class="custom-modal-header rose-header">
                <h2>@(editor.Id == 0 ? "Nuevo pedido a laboratorio" : $"Editar pedido {editor.NumeroOrden}")</h2>
                <button type="button" class="btn-close-modal" @onclick="CloseForm">×</button>
            </header>
            <div class="custom-modal-body">
                @if (!string.IsNullOrWhiteSpace(modalErrorMessage))
                {
                    <div class="alert alert-danger" role="alert" style="margin-bottom: 1.2rem; font-size: 0.9rem;">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @modalErrorMessage
                    </div>
                }

                <div class="management-form-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.9rem;">
                    <div>
                        <label class="form-label">Número de orden</label>
                        <input class="form-control" @bind="editor.NumeroOrden" maxlength="50" readonly style="background: rgba(0,0,0,0.02); font-weight: 600;" />
                    </div>

                    <div>
                        <label class="form-label">Laboratorio óptico *</label>
                        <select class="form-select @(editor.IdLaboratorio == 0 ? "border-warning" : "")" @bind="editor.IdLaboratorio">
                            <option value="0">-- Selecciona un laboratorio --</option>
                            @foreach (var laboratory in laboratories.OrderBy(x => x.nombre))
                            {
                                <option value="@laboratory.id_laboratorio">@laboratory.nombre</option>
                            }
                        </select>
                        @if (laboratories.Count == 0)
                        {
                            <span class="text-danger" style="font-size: 0.76rem; display: block; margin-top: 0.2rem;">
                                <i class="bi bi-info-circle"></i> No hay laboratorios registrados en el sistema.
                            </span>
                        }
                    </div>

                    <div>
                        <label class="form-label">Consulta del paciente *</label>
                        <select class="form-select @(editor.IdConsulta == 0 ? "border-warning" : "")" value="@editor.IdConsulta" @onchange="OnConsultationChanged">
                            <option value="0">-- Selecciona la consulta del paciente --</option>
                            @foreach (var consultation in availableConsultations)
                            {
                                <option value="@consultation.Id">@consultation.DisplayName</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label">Tipo de trabajo RX *</label>
                        <select class="form-select" value="@editor.TipoRx" @onchange="OnRxTypeChanged">
                            <option value="Lente Convencional">Lente (Lunas oftálmicas)</option>
                            <option value="Contactologia">Contactología (Lentes de contacto)</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label">Estado del pedido *</label>
                        <select class="form-select" @bind="editor.Estado">
                            @foreach (var option in stateOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label">Receta RX asociada</label>
                        <select class="form-select" value="@editor.SelectedRxId" @onchange="OnRxOptionChanged">
                            @if (CurrentRxOptions.Count > 0)
                            {
                                @foreach (var option in CurrentRxOptions)
                                {
                                    <option value="@option.Id">@option.Label</option>
                                }
                            }
                            <option value="0">-- Ingresar / Ajustar graduación manualmente --</option>
                        </select>
                    </div>
                </div>

                <div style="margin-top: 1.2rem; padding: 1rem; border-radius: 0.85rem; background: rgba(93, 161, 129, 0.05); border: 1px solid rgba(93, 161, 129, 0.2);">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.8rem; flex-wrap: wrap; gap: 0.5rem;">
                        <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--color-ink); margin: 0;">
                            <i class="bi bi-eye-fill text-success me-1"></i> Parámetros de Graduación RX (@editor.TipoRx)
                        </h4>
                        @if (editor.SelectedRxId > 0)
                        {
                            <span class="badge bg-light text-dark border">RX Vinculada #@editor.SelectedRxId</span>
                        }
                        else if (editor.SelectedRxId == -100)
                        {
                            <span class="badge" style="background: rgba(93, 161, 129, 0.2); color: #166534; border: 1px solid rgba(93, 161, 129, 0.4); font-weight: 600;">
                                <i class="bi bi-check2-circle me-1"></i> Precargado de Historia Clínica
                            </span>
                        }
                        else
                        {
                            <span class="badge" style="background: rgba(254, 188, 100, 0.2); color: #b45309; border: 1px solid rgba(254, 188, 100, 0.4);">
                                Ingreso manual / personalizado
                            </span>
                        }
                    </div>

                    @if (editor.TipoRx != "Contactologia")
                    {
                        <div style="display: grid; grid-template-columns: auto repeat(5, 1fr); gap: 0.5rem; align-items: center; margin-bottom: 0.8rem; font-size: 0.82rem;">
                            <div style="font-weight: 700; color: var(--color-taupe);">Ojo</div>
                            <div style="font-weight: 700; text-align: center;">Esfera (ESF)</div>
                            <div style="font-weight: 700; text-align: center;">Cilindro (CIL)</div>
                            <div style="font-weight: 700; text-align: center;">Eje (EJE °)</div>
                            <div style="font-weight: 700; text-align: center;">Adición (ADD)</div>
                            <div style="font-weight: 700; text-align: center;">DP / DNP</div>

                            <div style="font-weight: 700; color: var(--color-sage);">OD</div>
                            <div><input class="form-control form-control-sm text-center" @bind="editor.OdEsfera" placeholder="0.00" /></div>
                            <div><input class="form-control form-control-sm text-center" @bind="editor.OdCilindro" placeholder="0.00" /></div>
                            <div><input class="form-control form-control-sm text-center" @bind="editor.OdEje" placeholder="0°" /></div>
                            <div><input class="form-control form-control-sm text-center" @bind="editor.OdAddicion" placeholder="+0.00" /></div>
                            <div><input class="form-control form-control-sm text-center" @bind="editor.OdDp" placeholder="mm" /></div>

                            <div style="font-weight: 700; color: var(--color-sage);">OI</div>
                            <div><input class="form-control form-control-sm text-center" @bind="editor.OiEsfera" placeholder="0.00" /></div>
                            <div><input class="form-control form-control-sm text-center" @bind="editor.OiCilindro" placeholder="0.00" /></div>
                            <div><input class="form-control form-control-sm text-center" @bind="editor.OiEje" placeholder="0°" /></div>
                            <div><input class="form-control form-control-sm text-center" @bind="editor.OiAddicion" placeholder="+0.00" /></div>
                            <div><input class="form-control form-control-sm text-center" @bind="editor.OiDp" placeholder="mm" /></div>
                        </div>

                        <div class="management-form-grid" style="grid-template-columns: 1fr 1fr 1fr; gap: 0.75rem; margin-top: 0.6rem;">
                            <div>
                                <label class="form-label" style="font-size: 0.8rem;">Diseño de lente</label>
                                <input class="form-control form-control-sm" @bind="editor.DisenoLente" placeholder="ej. Monofocal, Progresivo, Bifocal" />
                            </div>
                            <div>
                                <label class="form-label" style="font-size: 0.8rem;">Material</label>
                                <input class="form-control form-control-sm" @bind="editor.Material" placeholder="ej. Policarbonato, CR-39, Alto índice" />
                            </div>
                            <div>
                                <label class="form-label" style="font-size: 0.8rem;">Tratamiento</label>
                                <input class="form-control form-control-sm" @bind="editor.Tratamiento" placeholder="ej. Antirreflejo, Blue Block, Fotocromático" />
                            </div>
                        </div>
                    }
                    else
                    {
                        <div style="display: grid; grid-template-columns: auto repeat(5, 1fr); gap: 0.5rem; align-items: center; margin-bottom: 0.8rem; font-size: 0.82rem;">
                            <div style="font-weight: 700; color: var(--color-taupe);">Ojo</div>
                            <div style="font-weight: 700; text-align: center;">Esfera (ESF)</div>
                            <div style="font-weight: 700; text-align: center;">Cilindro (CIL)</div>
                            <div style="font-weight: 700; text-align: center;">Eje (EJE °)</div>
                            <div style="font-weight: 700; text-align: center;">Curva Base (CB)</div>
                            <div style="font-weight: 700; text-align: center;">Diámetro (DIA)</div>

                            <div style="font-weight: 700; color: var(--color-sage);">OD</div>
                            <div><input class="form-control form-control-sm text-center" @bind="editor.OdEsfera" placeholder="0.00" /></div>
                            <div><input class="form-control form-control-sm text-center" @bind="editor.OdCilindro" placeholder="0.00" /></div>
                            <div><input class="form-control form-control-sm text-center" @bind="editor.OdEje" placeholder="0°" /></div>
                            <div><input class="form-control form-control-sm text-center" @bind="editor.OdCurvaBase" placeholder="8.6" /></div>
                            <div><input class="form-control form-control-sm text-center" @bind="editor.OdDiametro" placeholder="14.2" /></div>

                            <div style="font-weight: 700; color: var(--color-sage);">OI</div>
                            <div><input class="form-control form-control-sm text-center" @bind="editor.OiEsfera" placeholder="0.00" /></div>
                            <div><input class="form-control form-control-sm text-center" @bind="editor.OiCilindro" placeholder="0.00" /></div>
                            <div><input class="form-control form-control-sm text-center" @bind="editor.OiEje" placeholder="0°" /></div>
                            <div><input class="form-control form-control-sm text-center" @bind="editor.OiCurvaBase" placeholder="8.6" /></div>
                            <div><input class="form-control form-control-sm text-center" @bind="editor.OiDiametro" placeholder="14.2" /></div>
                        </div>

                        <div class="management-form-grid" style="grid-template-columns: 1fr; gap: 0.75rem; margin-top: 0.6rem;">
                            <div>
                                <label class="form-label" style="font-size: 0.8rem;">Tipo de lente de contacto</label>
                                <input class="form-control form-control-sm" @bind="editor.TipoLenteContacto" placeholder="ej. Blando esférico, Tórico mensual, Gas Permeable" />
                            </div>
                        </div>
                    }
                </div>

                <div style="margin-top: 1rem;">
                    <label class="form-label">Observaciones e indicaciones técnicas para el laboratorio</label>
                    <textarea class="form-control" rows="3" @bind="editor.Observaciones" placeholder="Indicaciones de biselado, ranurado, tinte, armazón o detalles especiales..."></textarea>
                </div>

                @if (editor.IsResend)
                {
                    <div style="margin-top: 0.8rem;">
                        <label class="form-label text-danger">Motivo de reenvío *</label>
                        <textarea class="form-control" rows="2" @bind="editor.MotivoReenvio" placeholder="Indica por qué se vuelve a enviar el trabajo al laboratorio..."></textarea>
                    </div>
                }
            </div>
            <footer class="custom-modal-footer">
                <button type="button" class="btn btn-outline-primary" @onclick="CloseForm">Cerrar</button>
                <button type="button" class="btn btn-primary" @onclick="SaveAsync">
                    <i class="bi bi-check-lg me-1"></i> Guardar pedido
                </button>
            </footer>
        </div>
    </div>
}

@code {
    private readonly List<OrderRow> orders = [];
    private readonly List<ConsultationOption> availableConsultations = [];
    private readonly string[] stateOptions = ["Enviado a laboratorio", "Listo para entrega", "Entregado al paciente"];
    private readonly string[] rxTypeOptions = ["Lente Convencional", "Contactologia"];
    private List<tbl_laboratorio> laboratories = [];
    private bool isLoading = true;
    private bool canViewModule;
    private bool showForm;
    private int currentPage = 1;
    private int currentRoleId;
    private int currentUserId;
    private string searchTerm = string.Empty;
    private string stateFilter = string.Empty;
    private string laboratoryFilter = string.Empty;
    private string? statusMessage;
    private string? errorMessage;
    private string? modalErrorMessage;
    private Permissions permissions = new();
    private LabOrderEditor? editor;
    private string whatsappPrefix = "593";
    private string whatsappTemplate = OpticaCustomizationService.DefaultLabWhatsappTemplate;
    private string rxFolderPath = string.Empty;
    private bool filtersRestored;
    private const string FilterStorageKey = "lab-orders.filters";

    private const int PageSize = 10;

    private List<OrderRow> FilteredOrders => orders
        .Where(MatchesFilters)
        .OrderByDescending(x => x.CreatedAt)
        .ToList();

    private IReadOnlyList<OrderRow> PagedOrders => FilteredOrders
        .Skip((EffectivePage - 1) * PageSize)
        .Take(PageSize)
        .ToList();

    private IReadOnlyList<RxOption> CurrentRxOptions =>
        editor is null
            ? []
            : availableConsultations.FirstOrDefault(x => x.Id == editor.IdConsulta)?.GetOptions(editor.TipoRx) ?? [];

    private int EffectivePage => Math.Min(currentPage, Math.Max(1, (int)Math.Ceiling(FilteredOrders.Count / (double)PageSize)));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentRoleId = int.TryParse(authState.User.FindFirst("RoleId")?.Value, out var parsedRoleId) ? parsedRoleId : 0;
        currentUserId = int.TryParse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var parsedUserId) ? parsedUserId : 0;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || filtersRestored)
        {
            return;
        }

        var rawFilters = await JSRuntime.InvokeAsync<string?>("optometriaSession.get", FilterStorageKey);
        if (!string.IsNullOrWhiteSpace(rawFilters))
        {
            var restored = System.Text.Json.JsonSerializer.Deserialize<LabOrderFilters>(rawFilters);
            if (restored is not null)
            {
                searchTerm = restored.SearchTerm ?? string.Empty;
                stateFilter = restored.StateFilter ?? string.Empty;
                laboratoryFilter = restored.LaboratoryFilter ?? string.Empty;
                currentPage = restored.Page <= 0 ? 1 : restored.Page;
                StateHasChanged();
            }
        }

        filtersRestored = true;
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        statusMessage = null;
        errorMessage = null;

        await using var db = await DbContextFactory.CreateDbContextAsync();
        permissions = await GetPermissionsAsync(db);
        canViewModule = permissions.CanView;

        laboratories = await db.tbl_laboratorios
            .AsNoTracking()
            .Where(x => x.activo == true)
            .OrderBy(x => x.nombre)
            .ToListAsync();

        var settings = await OpticaCustomizationService.GetOrCreateSettingsAsync(db);
        whatsappPrefix = settings.prefijo_pais ?? "593";
        rxFolderPath = settings.carpeta_rx ?? string.Empty;

        var template = await OpticaCustomizationService.GetOrCreateTemplateAsync(
            db,
            "WhatsApp",
            OpticaCustomizationService.LabWhatsappTemplateType,
            OpticaCustomizationService.DefaultLabWhatsappTemplate);
        whatsappTemplate = template.contenido ?? OpticaCustomizationService.DefaultLabWhatsappTemplate;

        var consultationData = await db.tbl_consulta
            .AsNoTracking()
            .Include(x => x.id_pacienteNavigation)
            .Include(x => x.tbl_rx_lentes)
            .Include(x => x.tbl_rx_contactologia)
            .OrderByDescending(x => x.fecha_consulta)
            .Take(200)
            .ToListAsync();

        var consultationIds = consultationData.Select(c => c.id_consulta).ToList();
        var clinicalEvents = await db.tbl_historia_clinica_optometria_eventos
            .AsNoTracking()
            .Where(e => consultationIds.Contains(e.id_consulta) && e.activo)
            .OrderByDescending(e => e.fecha_evento)
            .ToListAsync();

        var patientIds = consultationData.Select(c => c.id_paciente).Distinct().ToList();
        var histories = await db.tbl_historia_clinica_optometrias
            .AsNoTracking()
            .Where(h => patientIds.Contains(h.id_paciente) && h.activo == true)
            .ToListAsync();

        var jsonOpts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };

        availableConsultations.Clear();
        foreach (var c in consultationData)
        {
            var opt = new ConsultationOption
            {
                Id = c.id_consulta,
                PatientId = c.id_paciente,
                PatientName = $"{c.id_pacienteNavigation.nombres} {c.id_pacienteNavigation.apellidos}",
                PatientIdentifier = c.id_pacienteNavigation.cedula,
                Date = c.fecha_consulta,
                LensOptions = c.tbl_rx_lentes.Select(rx => new RxOption
                {
                    Id = rx.id_rx_lente,
                    PatientId = c.id_paciente,
                    Label = $"RX lente #{rx.id_rx_lente} - {rx.diseno_lente ?? "Estándar"} (OD: {rx.od_esfera:0.##}/{rx.od_cilindro:0.##}, OI: {rx.oi_esfera:0.##}/{rx.oi_cilindro:0.##})",
                    OdEsfera = rx.od_esfera,
                    OdCilindro = rx.od_cilindro,
                    OdEje = rx.od_eje,
                    OdAddicion = rx.od_addicion,
                    OdDp = rx.od_dp,
                    OdDnp = rx.od_dnp,
                    OdAltura = rx.od_altura,
                    OiEsfera = rx.oi_esfera,
                    OiCilindro = rx.oi_cilindro,
                    OiEje = rx.oi_eje,
                    OiAddicion = rx.oi_addicion,
                    OiDp = rx.oi_dp,
                    OiDnp = rx.oi_dnp,
                    OiAltura = rx.oi_altura,
                    DisenoLente = rx.diseno_lente,
                    Material = rx.material,
                    Tratamiento = rx.tratamiento
                }).ToList(),
                ContactOptions = c.tbl_rx_contactologia.Select(rx => new RxOption
                {
                    Id = rx.id_rx_contactologia,
                    PatientId = c.id_paciente,
                    Label = $"RX contacto #{rx.id_rx_contactologia} - {rx.tipo_lente ?? "Estándar"} (OD: {rx.od_esfera:0.##}, OI: {rx.oi_esfera:0.##})",
                    OdEsfera = rx.od_esfera,
                    OdCilindro = rx.od_cilindro,
                    OdEje = rx.od_eje,
                    OdDiametro = rx.od_diametro,
                    OdCurvaBase = rx.od_curva_base,
                    OiEsfera = rx.oi_esfera,
                    OiCilindro = rx.oi_cilindro,
                    OiEje = rx.oi_eje,
                    OiDiametro = rx.oi_diametro,
                    OiCurvaBase = rx.oi_curva_base,
                    TipoLenteContacto = rx.tipo_lente
                }).ToList()
            };

            if (opt.LensOptions.Count == 0)
            {
                var ev = clinicalEvents.FirstOrDefault(e => e.id_consulta == c.id_consulta)
                         ?? clinicalEvents.FirstOrDefault(e => e.id_paciente == c.id_paciente);
                ClinicalHistoryEditorModel? parsedEditor = null;
                if (ev is not null && !string.IsNullOrWhiteSpace(ev.payload_json))
                {
                    try { parsedEditor = System.Text.Json.JsonSerializer.Deserialize<ClinicalHistoryEditorModel>(ev.payload_json, jsonOpts); } catch { }
                }

                if (parsedEditor is null)
                {
                    var hist = histories.FirstOrDefault(h => h.id_paciente == c.id_paciente);
                    if (hist is not null)
                    {
                        parsedEditor = new ClinicalHistoryEditorModel();
                        if (!string.IsNullOrWhiteSpace(hist.lentes_json))
                        {
                            try { parsedEditor.Lentes = System.Text.Json.JsonSerializer.Deserialize<LensSection>(hist.lentes_json, jsonOpts) ?? new(); } catch { }
                        }
                        if (!string.IsNullOrWhiteSpace(hist.refraccion_json))
                        {
                            try { parsedEditor.Refraction = System.Text.Json.JsonSerializer.Deserialize<RefractionSection>(hist.refraccion_json, jsonOpts) ?? new(); } catch { }
                        }
                    }
                }

                if (parsedEditor is not null)
                {
                    var refText = !string.IsNullOrWhiteSpace(parsedEditor.Refraction.PruebaAmbulatoriaRxFinal)
                        ? parsedEditor.Refraction.PruebaAmbulatoriaRxFinal
                        : (!string.IsNullOrWhiteSpace(parsedEditor.Refraction.SubjetivoAfinacionBalance)
                            ? parsedEditor.Refraction.SubjetivoAfinacionBalance
                            : parsedEditor.Refraction.RxEstaticaDinamica);

                    var (odEsf, odCil, odEje, odAdd, odDp) = ClinicalHistoryService.ParseEyeMeasurements(parsedEditor.Lentes.Od, refText, "OD");
                    var (oiEsf, oiCil, oiEje, oiAdd, oiDp) = ClinicalHistoryService.ParseEyeMeasurements(parsedEditor.Lentes.Oi, refText, "OI");

                    if (odEsf.HasValue || odCil.HasValue || oiEsf.HasValue || oiCil.HasValue ||
                        !string.IsNullOrWhiteSpace(parsedEditor.Lentes.Od) || !string.IsNullOrWhiteSpace(parsedEditor.Lentes.Oi) ||
                        !string.IsNullOrWhiteSpace(parsedEditor.Lentes.Material) || !string.IsNullOrWhiteSpace(parsedEditor.Lentes.TipoLente))
                    {
                        opt.LensOptions.Add(new RxOption
                        {
                            Id = -100,
                            PatientId = c.id_paciente,
                            Label = $"Graduación de Historia Clínica (OD: {odEsf?.ToString("0.##") ?? "-"}/{odCil?.ToString("0.##") ?? "-"}, OI: {oiEsf?.ToString("0.##") ?? "-"}/{oiCil?.ToString("0.##") ?? "-"})",
                            OdEsfera = odEsf,
                            OdCilindro = odCil,
                            OdEje = odEje,
                            OdAddicion = odAdd ?? ClinicalHistoryService.ParseOptDecimal(parsedEditor.Lentes.Addicion),
                            OdDp = odDp ?? ClinicalHistoryService.ParseOptDecimal(parsedEditor.Lentes.DistPupilar),
                            OiEsfera = oiEsf,
                            OiCilindro = oiCil,
                            OiEje = oiEje,
                            OiAddicion = oiAdd ?? ClinicalHistoryService.ParseOptDecimal(parsedEditor.Lentes.Addicion),
                            OiDp = oiDp ?? ClinicalHistoryService.ParseOptDecimal(parsedEditor.Lentes.DistPupilar),
                            DisenoLente = parsedEditor.Lentes.TipoLente,
                            Material = parsedEditor.Lentes.Material,
                            Tratamiento = parsedEditor.Lentes.Filtro
                        });
                    }
                }
            }

            availableConsultations.Add(opt);
        }

        orders.Clear();
        if (canViewModule)
        {
            var data = await db.tbl_orden_rxes
                .AsNoTracking()
                .Include(x => x.id_laboratorioNavigation)
                .Include(x => x.id_consultaNavigation)
                .ThenInclude(x => x.id_pacienteNavigation)
                .Include(x => x.tbl_envio_laboratorios)
                .ToListAsync();

            orders.AddRange(data.Select(x =>
            {
                var shipment = x.tbl_envio_laboratorios.OrderByDescending(y => y.fecha_envio).FirstOrDefault();
                var patient = x.id_consultaNavigation.id_pacienteNavigation;
                return new OrderRow
                {
                    Id = x.id_orden_rx,
                    ConsultationId = x.id_consulta,
                    OrderNumber = string.IsNullOrWhiteSpace(x.numero_orden) ? $"RX-{x.id_orden_rx}" : x.numero_orden!,
                    PatientName = $"{patient.nombres} {patient.apellidos}",
                    PatientIdentifier = patient.cedula,
                    LaboratoryName = x.id_laboratorioNavigation.nombre,
                    LaboratoryId = x.id_laboratorio,
                    RxTypeLabel = string.IsNullOrWhiteSpace(x.tipo_rx) ? "Lente" : x.tipo_rx!,
                    State = string.IsNullOrWhiteSpace(x.estado) ? "Enviado a laboratorio" : x.estado!,
                    CreatedAt = x.fecha_creacion,
                    CreatedAtLabel = x.fecha_creacion?.ToString("yyyy-MM-dd HH:mm") ?? "-",
                    RxDownloadUrl = $"/exports/lab-orders/{x.id_orden_rx}.html",
                    WhatsappUrl = BuildWhatsappUrl(
                        x.id_laboratorioNavigation.whatsapp,
                        x.numero_orden ?? $"RX-{x.id_orden_rx:000000}",
                        $"{patient.nombres} {patient.apellidos}",
                        string.IsNullOrWhiteSpace(x.tipo_rx) ? "Lente" : x.tipo_rx!,
                        x.id_laboratorioNavigation.nombre,
                        x.observaciones),
                    LogisticsLabel = shipment is null ? "Pendiente de gestion" : $"{shipment.estado ?? "Enviado a laboratorio"} · {shipment.canal ?? "Manual"}",
                    PatientTrackingUrl = BuildPatientTrackingUrl(x.numero_orden ?? $"RX-{x.id_orden_rx:000000}")
                };
            }));
        }

        isLoading = false;
    }

