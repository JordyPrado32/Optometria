            CanCreate = true,
            CanEdit = true,
            CanDelete = true
        };
    }

    private async Task OpenRxFolderAsync()
    {
        if (string.IsNullOrWhiteSpace(rxFolderPath))
        {
            errorMessage = "No hay carpeta RX configurada.";
            return;
        }

        await JSRuntime.InvokeVoidAsync("optometriaSession.openRxFolder", rxFolderPath);
    }

