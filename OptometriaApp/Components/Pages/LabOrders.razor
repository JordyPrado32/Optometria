    private async Task EnsureSelectedRxAsync()
    {
        if (editor is null)
        {
            return;
        }

        var options = CurrentRxOptions;
        if (options.Count > 0)
        {
            var opt = options.FirstOrDefault(x => x.Id == editor.SelectedRxId) ?? options[0];
            editor.SelectedRxId = opt.Id;
            PopulateEditorFromRxOption(opt);
            return;
        }

        if (editor.IdConsulta > 0)
        {
            try
            {
                await using var db = await DbContextFactory.CreateDbContextAsync();
                var consultation = await db.tbl_consulta
                    .AsNoTracking()
                    .Include(c => c.tbl_rx_lentes)
                    .FirstOrDefaultAsync(c => c.id_consulta == editor.IdConsulta);

                if (consultation is not null)
                {
                    var rx = consultation.tbl_rx_lentes.FirstOrDefault();
                    if (rx is not null)
                    {
                        editor.OdEsfera = rx.od_esfera?.ToString("0.##") ?? string.Empty;
                        editor.OdCilindro = rx.od_cilindro?.ToString("0.##") ?? string.Empty;
                        editor.OdEje = rx.od_eje?.ToString("0.##") ?? string.Empty;
                        editor.OdAddicion = rx.od_addicion?.ToString("0.##") ?? string.Empty;
                        editor.OdDp = rx.od_dp?.ToString("0.##") ?? string.Empty;
                        editor.OiEsfera = rx.oi_esfera?.ToString("0.##") ?? string.Empty;
                        editor.OiCilindro = rx.oi_cilindro?.ToString("0.##") ?? string.Empty;
                        editor.OiEje = rx.oi_eje?.ToString("0.##") ?? string.Empty;
                        editor.OiAddicion = rx.oi_addicion?.ToString("0.##") ?? string.Empty;
                        editor.OiDp = rx.oi_dp?.ToString("0.##") ?? string.Empty;
                        editor.DisenoLente = rx.diseno_lente ?? string.Empty;
                        editor.Material = rx.material ?? string.Empty;
                        editor.Tratamiento = rx.tratamiento ?? string.Empty;
                        editor.SelectedRxId = rx.id_rx_lente;
                        return;
                    }

                    var ev = await db.tbl_historia_clinica_optometria_eventos
                        .AsNoTracking()
                        .Where(e => (e.id_consulta == consultation.id_consulta || e.id_paciente == consultation.id_paciente) && e.activo)
                        .OrderByDescending(e => e.fecha_evento)
                        .FirstOrDefaultAsync();

                    var jsonOpts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                    ClinicalHistoryEditorModel? parsedEditor = null;
                    if (ev is not null && !string.IsNullOrWhiteSpace(ev.payload_json))
                    {
                        try { parsedEditor = System.Text.Json.JsonSerializer.Deserialize<ClinicalHistoryEditorModel>(ev.payload_json, jsonOpts); } catch { }
                    }

                    if (parsedEditor is null)
                    {
                        var hist = await db.tbl_historia_clinica_optometrias
                            .AsNoTracking()
                            .FirstOrDefaultAsync(h => h.id_paciente == consultation.id_paciente && h.activo == true);
                        if (hist is not null)
                        {
                            parsedEditor = new ClinicalHistoryEditorModel();
                            if (!string.IsNullOrWhiteSpace(hist.lentes_json))
                            {
                                try { parsedEditor.Lentes = System.Text.Json.JsonSerializer.Deserialize<LensSection>(hist.lentes_json, jsonOpts) ?? new(); } catch { }
                            }
                            if (!string.IsNullOrWhiteSpace(hist.refraccion_json))
                            {
                                try { parsedEditor.Refraction = System.Text.Json.JsonSerializer.Deserialize<RefractionSection>(hist.refraccion_json, jsonOpts) ?? new(); } catch { }
                            }
                        }
                    }

                    if (parsedEditor is not null)
                    {
                        var refText = !string.IsNullOrWhiteSpace(parsedEditor.Refraction.PruebaAmbulatoriaRxFinal)
                            ? parsedEditor.Refraction.PruebaAmbulatoriaRxFinal
                            : (!string.IsNullOrWhiteSpace(parsedEditor.Refraction.SubjetivoAfinacionBalance)
                                ? parsedEditor.Refraction.SubjetivoAfinacionBalance
                                : parsedEditor.Refraction.RxEstaticaDinamica);

                        var (odEsf, odCil, odEje, odAdd, odDp) = ClinicalHistoryService.ParseEyeMeasurements(parsedEditor.Lentes.Od, refText, "OD");
                        var (oiEsf, oiCil, oiEje, oiAdd, oiDp) = ClinicalHistoryService.ParseEyeMeasurements(parsedEditor.Lentes.Oi, refText, "OI");

                        editor.OdEsfera = odEsf?.ToString("0.##") ?? string.Empty;
                        editor.OdCilindro = odCil?.ToString("0.##") ?? string.Empty;
                        editor.OdEje = odEje?.ToString("0.##") ?? string.Empty;
                        editor.OdAddicion = (odAdd ?? ClinicalHistoryService.ParseOptDecimal(parsedEditor.Lentes.Addicion))?.ToString("0.##") ?? string.Empty;
                        editor.OdDp = (odDp ?? ClinicalHistoryService.ParseOptDecimal(parsedEditor.Lentes.DistPupilar))?.ToString("0.##") ?? string.Empty;
                        editor.OiEsfera = oiEsf?.ToString("0.##") ?? string.Empty;
                        editor.OiCilindro = oiCil?.ToString("0.##") ?? string.Empty;
                        editor.OiEje = oiEje?.ToString("0.##") ?? string.Empty;
                        editor.OiAddicion = (oiAdd ?? ClinicalHistoryService.ParseOptDecimal(parsedEditor.Lentes.Addicion))?.ToString("0.##") ?? string.Empty;
                        editor.OiDp = (oiDp ?? ClinicalHistoryService.ParseOptDecimal(parsedEditor.Lentes.DistPupilar))?.ToString("0.##") ?? string.Empty;
                        editor.DisenoLente = parsedEditor.Lentes.TipoLente ?? string.Empty;
                        editor.Material = parsedEditor.Lentes.Material ?? string.Empty;
                        editor.Tratamiento = parsedEditor.Lentes.Filtro ?? string.Empty;
                        editor.SelectedRxId = -100;
                        return;
                    }
                }
            }
            catch
            {
            }
        }

        editor.SelectedRxId = 0;
    }

    private string? ValidateEditor(LabOrderEditor currentEditor)
    {
        if (currentEditor.IdLaboratorio <= 0)
        {
            return "Por favor selecciona un laboratorio óptico.";
        }

        if (currentEditor.IdConsulta <= 0)
        {
            return "Por favor selecciona la consulta médica del paciente.";
        }

        if (currentEditor.IsResend && string.IsNullOrWhiteSpace(currentEditor.MotivoReenvio))
        {
            return "Ingresa el motivo del reenvío.";
        }

        return null;
    }

    private static decimal? ParseOptDecimal(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        return decimal.TryParse(value.Trim().Replace(',', '.'), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var result) ? result : null;
    }

    private static string? NormalizeOpt(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }

    private static string BuildOrderNumber(int orderId) => $"RX-{orderId:000000}";

    private static string BuildPatientTrackingUrl(string orderNumber)
        => $"/seguimiento-pedido?orden={Uri.EscapeDataString(orderNumber)}";

    private string BuildWhatsappUrl(
        string? laboratoryWhatsapp,
        string orderNumber,
        string patientName,
        string rxType,
        string laboratoryName,
        string? observations)
    {
        var phone = OpticaCustomizationService.NormalizePhone(laboratoryWhatsapp, whatsappPrefix);
        if (string.IsNullOrWhiteSpace(phone))
        {
            return string.Empty;
        }

        var message = OpticaCustomizationService.RenderTemplate(
            whatsappTemplate,
            new Dictionary<string, string>
            {
                ["order_number"] = orderNumber,
                ["patient_name"] = patientName.Trim(),
                ["rx_type"] = rxType,
                ["laboratory_name"] = laboratoryName,
                ["observations"] = string.IsNullOrWhiteSpace(observations) ? string.Empty : $"Observaciones: {observations.Trim()}."
            });
        return LabMessagingService.BuildWhatsAppLink(phone, message);
    }

    private static string? BuildObservations(LabOrderEditor currentEditor)
    {
        var observations = string.IsNullOrWhiteSpace(currentEditor.Observaciones)
            ? string.Empty
            : currentEditor.Observaciones.Trim();

        if (!currentEditor.IsResend)
        {
            return string.IsNullOrWhiteSpace(observations) ? null : observations;
        }

        var prefix = $"Reenvio de orden {currentEditor.OriginalOrderNumber}. Motivo: {currentEditor.MotivoReenvio.Trim()}.";
        var combined = string.IsNullOrWhiteSpace(observations)
            ? prefix
            : $"{prefix} {observations}";

        return combined;
    }

    private bool MatchesFilters(OrderRow row)
    {
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var lowered = searchTerm.ToLowerInvariant();
            if (!row.OrderNumber.ToLowerInvariant().Contains(lowered) &&
                !row.PatientName.ToLowerInvariant().Contains(lowered) &&
                !row.PatientIdentifier.ToLowerInvariant().Contains(lowered) &&
                !row.LaboratoryName.ToLowerInvariant().Contains(lowered))
            {
                return false;
            }
        }

        if (!string.IsNullOrWhiteSpace(stateFilter) && !string.Equals(row.State, stateFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (!string.IsNullOrWhiteSpace(laboratoryFilter) && !string.Equals(row.LaboratoryId.ToString(), laboratoryFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return true;
    }

    private async Task ClearFilters()
    {
        searchTerm = string.Empty;
        stateFilter = string.Empty;
        laboratoryFilter = string.Empty;
        currentPage = 1;
        await PersistFiltersAsync();
    }

    private Task SetPage(int page)
    {
        currentPage = page;
        return PersistFiltersAsync();
    }

    private Task PersistFiltersAsync()
    {
        var payload = System.Text.Json.JsonSerializer.Serialize(new LabOrderFilters
        {
            SearchTerm = searchTerm,
            StateFilter = stateFilter,
            LaboratoryFilter = laboratoryFilter,
            Page = currentPage
        });
        return JSRuntime.InvokeVoidAsync("optometriaSession.set", FilterStorageKey, payload).AsTask();
    }

    private void CloseForm()
    {
        showForm = false;
        editor = null;
        modalErrorMessage = null;
    }

    private static async Task<Permissions> GetPermissionsAsync(OpticaDbContext db)
    {
        return new Permissions
        {
