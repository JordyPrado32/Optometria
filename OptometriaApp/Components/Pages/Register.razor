@page "/registro"
@layout AuthLayout
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Registro</PageTitle>

<div class="auth-shell auth-shell-register">
    <section class="auth-panel auth-panel-brand">
        <div class="wave-divider">
            <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                <path d="M 80,0 C 55,15 45,35 55,55 C 65,75 75,85 80,100 L 100,100 L 100,0 Z" fill="#F4F0E4" />
            </svg>
        </div>
    </section>

    <section class="auth-panel auth-panel-form">
        <div class="auth-card auth-card-register">
            <div class="auth-heading">
                <span class="eyebrow">Registro</span>
                <h2>Crear cuenta</h2>
                <p>Completa tus datos y una contraseña segura.</p>
            </div>

            <div class="auth-avatar-card">
                <div class="auth-avatar-preview">
                    <img src="/images/avatars/@ObtenerNombreImagen()" alt="Avatar de perfil" />
                </div>

                <button type="button" class="btn btn-outline-primary auth-avatar-trigger" @onclick="AbrirSeleccionador">
                    Personalizar avatar
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="alert alert-danger" role="alert">@Error</div>
            }
            <form method="post" action="/auth/register" class="auth-form auth-register-form">
                <AntiforgeryToken />
                <input type="hidden" name="avatar_url" value="@ObtenerNombreImagen()" />

                <div class="auth-grid">
                    <div class="form-group">
                        <label class="form-label" for="nombres">Nombres</label>
                        <div class="input-with-icon">
                            <i class="bi bi-person-vcard"></i>
                            <input id="nombres" name="nombres" class="form-control" placeholder="Tus nombres" autocomplete="given-name" required />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="apellidos">Apellidos</label>
                        <div class="input-with-icon">
                            <i class="bi bi-person-vcard-fill"></i>
                            <input id="apellidos" name="apellidos" class="form-control" placeholder="Tus apellidos" autocomplete="family-name" required />
                        </div>
                    </div>
                </div>

                <div class="auth-grid">
                    <div class="form-group">
                        <label class="form-label" for="email">Correo</label>
                        <div class="input-with-icon">
                            <i class="bi bi-envelope-at"></i>
                            <input id="email" name="email" type="email" class="form-control" placeholder="correo@dominio.com" autocomplete="email" required />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="telefono">Telefono</label>
                        <div class="input-with-icon">
                            <i class="bi bi-telephone"></i>
                            <input id="telefono" name="telefono" class="form-control" placeholder="Telefono opcional" autocomplete="tel" />
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="usuario">Usuario</label>
                    <div class="input-with-icon">
                        <i class="bi bi-person"></i>
                        <input id="usuario" name="usuario" class="form-control" placeholder="Crea tu usuario" autocomplete="username" required />
                    </div>
                </div>

                <div class="auth-grid">
                    <div class="form-group">
                        <label class="form-label" for="password">Contraseña</label>
                        <div class="input-with-icon">
                            <i class="bi bi-lock"></i>
                            <div class="password-field">
                                <input id="password" name="password" type="@(showPassword ? "text" : "password")" class="form-control" placeholder="Minimo 12 caracteres" autocomplete="new-password" required />
                                <button type="button" class="password-toggle" @onclick="TogglePasswordVisibility">
                                    <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="confirmPassword">Confirmar contraseña</label>
                        <div class="input-with-icon">
                            <i class="bi bi-shield-check"></i>
                            <div class="password-field">
                                <input id="confirmPassword" name="confirmPassword" type="@(showConfirmPassword ? "text" : "password")" class="form-control" placeholder="Repite la contrasena" autocomplete="new-password" required />
                                <button type="button" class="password-toggle" @onclick="ToggleConfirmPasswordVisibility">
                                    <i class="bi @(showConfirmPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <label class="auth-check">
                    <input id="acceptedTerms" name="acceptedTerms" type="checkbox" value="true" required />
                    <span>Acepto los terminos y condiciones de uso del sistema</span>
                </label>

                <button type="submit" class="btn btn-primary auth-submit">Registrar usuario</button>
            </form>

            <div class="auth-footer auth-footer-stack">
                <span>Ya tienes cuenta?</span>
                <a href="/">Volver al login</a>
            </div>
        </div>
    </section>
</div>

@if (mostrarModal)
{
    <div class="profile-avatar-modal-backdrop">
        <div class="profile-avatar-modal">
            <div class="profile-avatar-modal-header">
                <span>Personalizar apariencia</span>
                <button type="button" class="profile-avatar-close" @onclick="CerrarSeleccionador">&times;</button>
            </div>

            <div class="profile-avatar-modal-body">
                <div class="profile-avatar-preview-card">
                    <img src="/images/avatars/@ObtenerNombreImagen()" alt="Vista previa del avatar" />
                    <strong>Vista previa actual</strong>
                    <span>Elige personaje y estilo antes de continuar.</span>
                </div>

                <div class="profile-avatar-controls">
                    <div class="profile-avatar-tabs">
                        <button type="button" class="@(categoriaActiva == "mujeres" ? "is-active" : null)" @onclick='() => SeleccionarAtributo("categoria", "mujeres")'>
                            Mujeres
                        </button>
                        <button type="button" class="@(categoriaActiva == "hombres" ? "is-active" : null)" @onclick='() => SeleccionarAtributo("categoria", "hombres")'>
                            Hombres
                        </button>
                    </div>

                    <div class="profile-avatar-grid">
                        @foreach (var personaje in (categoriaActiva == "mujeres" ? avataresMujeres : avataresHombres))
                        {
                            <button type="button" class="profile-avatar-option @(personajeSeleccionado == personaje ? "is-selected" : null)" @onclick='() => SeleccionarAtributo("personaje", personaje)'>
                                <img src="/images/avatars/@($"{personaje}_sin_lentes.png")" alt="Avatar @personaje" />
                            </button>
                        }
                    </div>

                    <div class="profile-avatar-controls">
                        <strong class="manual-key-label">Configurar lentes</strong>
                        <div class="profile-avatar-lens-toggle">
                            <button type="button" class="@(avatarLentes == "redondos" ? "is-active" : null)" @onclick='() => SeleccionarAtributo("lentes", "redondos")'>
                                Redondos
                            </button>
                            <button type="button" class="@(avatarLentes == "none" ? "is-active" : null)" @onclick='() => SeleccionarAtributo("lentes", "none")'>
                                Sin lentes
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="profile-avatar-modal-actions">
                <button type="button" class="btn btn-primary" @onclick="CerrarSeleccionador">Aceptar</button>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    private bool showPassword;
    private bool showConfirmPassword;
    private bool shouldRedirectAuthenticatedUser;
    private ClaimsPrincipal? authenticatedUser;
    private bool mostrarModal;
    private string personajeSeleccionado = "l";
    private string avatarLentes = "none";
    private string categoriaActiva = "mujeres";
    private readonly string[] avataresMujeres = ["l", "m", "n", "p", "r"];
    private readonly string[] avataresHombres = ["s", "t", "u", "v", "w"];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            authenticatedUser = authState.User;
            shouldRedirectAuthenticatedUser = true;
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && shouldRedirectAuthenticatedUser && authenticatedUser is not null)
        {
            shouldRedirectAuthenticatedUser = false;
            NavigateByStage(authenticatedUser);
        }

        return Task.CompletedTask;
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private void ToggleConfirmPasswordVisibility()
    {
        showConfirmPassword = !showConfirmPassword;
    }

    private string ObtenerNombreImagen()
    {
        var sufijoLentes = avatarLentes == "redondos" ? "con_lentes" : "sin_lentes";
        return $"{personajeSeleccionado}_{sufijoLentes}.png";
    }

    private void SeleccionarAtributo(string tipo, string valor)
    {
        if (tipo == "personaje")
        {
            personajeSeleccionado = valor;
        }
        else if (tipo == "lentes")
        {
            avatarLentes = valor;
        }
        else if (tipo == "categoria")
        {
            categoriaActiva = valor;
        }
    }

    private void AbrirSeleccionador() => mostrarModal = true;
    private void CerrarSeleccionador() => mostrarModal = false;

    private void NavigateByStage(ClaimsPrincipal user)
    {
        var authStage = user.FindFirst("AuthStage")?.Value;
        var forcePasswordChange = string.Equals(user.FindFirst("ForcePasswordChange")?.Value, bool.TrueString, StringComparison.OrdinalIgnoreCase);

        var target = authStage switch
        {
            "TwoFactorSetupRequired" => "/configurar-2fa",
            "TwoFactorPending" => "/verificar-2fa",
            _ => forcePasswordChange ? "/cambiar-contrasena" : "/dashboard"
        };

        NavigationManager.NavigateTo(target);
    }
}
