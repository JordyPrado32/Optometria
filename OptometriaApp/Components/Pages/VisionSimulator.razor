@page "/vision-simulator"
@using OptometriaApp.Components.VisualLab
@rendermode InteractiveServer
<PageTitle>Laboratorio Visual | Óptica Lux</PageTitle>
<link rel="stylesheet" href="visual-lab.css" />
<div class="vl-shell">
    <header class="vl-header">
        <div><span class="vl-eyebrow">ÓPTICA LUX / EXPERIENCIAS</span><h1>Laboratorio Visual</h1><p>Explora cómo funciona, se corrige y se percibe la visión.</p></div>
        <div class="vl-header-actions"><div class="vl-segments"><button class="@(!guided ? "active" : "")" @onclick="() => guided = false">Explorar</button><button class="@(guided ? "active" : "")" @onclick="() => guided = true">Guiado</button></div><label class="vl-motion"><input type="checkbox" @bind="reduced" /> Reducir movimiento</label></div>
    </header>
    <nav class="vl-modes" aria-label="Modos del laboratorio">
        @foreach (var m in modes)
        {
            <button class="@(mode == m.Id ? "active" : "")" aria-pressed="@(mode == m.Id)" @onclick="() => mode = m.Id"><i class="bi @m.Icon"></i><span><strong>@m.Name</strong><small>@m.Description</small></span><span class="vl-mode-number">0@(m.Id + 1)</span></button>
        }
    </nav>
    @if (mode == 0) { <EyeRefractionLab Guided="guided" ReducedMotion="reduced" /> }
    else if (mode == 1) { <FrameStudio Guided="guided" ReducedMotion="reduced" /> }
    else { <SubjectiveVisionLab Guided="guided" /> }
    <footer class="vl-footnote"><span><i class="bi bi-info-circle"></i> Representación educativa. La percepción y los resultados reales varían entre personas.</span><a href="/visual-acuity-test">Test de Agudeza Visual <i class="bi bi-arrow-up-right"></i></a></footer>
</div>
@code {
    private int mode;
    private bool guided, reduced;
    private readonly (int Id, string Name, string Description, string Icon)[] modes = [
        (0, "Ojo & Refracción", "Anatomía, rayos y corrección", "bi-eye"),
        (1, "Monturas & Lunas", "Estudio 3D y tratamientos", "bi-eyeglasses"),
        (2, "Tu Visión", "Simulación de la percepción", "bi-binoculars")];
}

