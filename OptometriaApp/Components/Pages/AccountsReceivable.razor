    private async Task PersistFiltersAsync()
    {
        var payload = System.Text.Json.JsonSerializer.Serialize(new ReceivableFilters
        {
            SearchTerm = searchTerm,
            ClientId = selectedClientFilter,
            StateFilter = selectedStateFilter,
            DueFilter = selectedDueFilter
        });

        await JSRuntime.InvokeVoidAsync("optometriaSession.set", FilterStorageKey, payload);
    }

    private async Task<ModulePermissions> GetModulePermissionsAsync(OpticaDbContext dbContext, int roleId)
    {
        if (roleId <= 0)
        {
            return new ModulePermissions();
        }

        var permission = await dbContext.tbl_rol_menu_permisos
            .AsNoTracking()
            .Where(x => x.id_rol == roleId)
            .Join(
                dbContext.tbl_menu_apps.AsNoTracking().Where(x => x.ruta == "/cuentas-por-cobrar"),
                rolePermission => rolePermission.id_menu,
                menu => menu.id_menu,
                (rolePermission, _) => rolePermission)
            .FirstOrDefaultAsync();

        if (permission is null)
        {
            return new ModulePermissions();
        }

        return new ModulePermissions
        {
            CanView = permission.puede_ver,
            CanCreate = permission.puede_crear,
            CanEdit = permission.puede_editar,
            CanDelete = permission.puede_eliminar
        };
    }

    private bool MatchesSearch(AccountReceivableRow item)
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return true;
        }

        var term = searchTerm.Trim().ToLowerInvariant();
        return item.ClientName.ToLowerInvariant().Contains(term)
            || item.ClientDocument.ToLowerInvariant().Contains(term)
            || item.PatientName.ToLowerInvariant().Contains(term)
            || (item.InvoiceNumber?.ToLowerInvariant().Contains(term) ?? false);
    }

    private bool MatchesClient(AccountReceivableRow item) => selectedClientFilter <= 0 || item.ClientId == selectedClientFilter;

    private bool MatchesState(AccountReceivableRow item) => selectedStateFilter == "Todos" || item.DisplayStatus == selectedStateFilter;

    private bool MatchesDueFilter(AccountReceivableRow item)
    {
        if (selectedDueFilter == "Todos")
        {
            return true;
        }

        if (selectedDueFilter == "SinFecha")
        {
            return item.DueDate is null;
        }

        if (item.DueDate is null)
        {
            return false;
        }

        var today = DateOnly.FromDateTime(DateTime.Today);
        return selectedDueFilter switch
        {
            "Vencidas" => item.DisplayStatus == "Vencida",
            "Hoy" => item.DueDate.Value == today,
            "Proximos7" => item.DueDate.Value >= today && item.DueDate.Value <= today.AddDays(7),
            _ => true
        };
    }

