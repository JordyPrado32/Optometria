    private static string ResolveDisplayStatus(string state, decimal balance, DateOnly? dueDate)
    {
        if (balance <= 0 || string.Equals(state, "Pagada", StringComparison.OrdinalIgnoreCase))
        {
            return "Pagada";
        }

        if (dueDate is not null && dueDate.Value < DateOnly.FromDateTime(DateTime.Today))
        {
            return "Vencida";
        }

        return "Pendiente";
    }

    private static string GetClientLabel(string? businessName, string? firstName, string? lastName)
    {
        if (!string.IsNullOrWhiteSpace(businessName))
        {
            return businessName;
        }

        var fullName = $"{firstName} {lastName}".Trim();
        return string.IsNullOrWhiteSpace(fullName) ? "Cliente sin nombre" : fullName;
    }

    private static string GetPatientLabel(string? firstName, string? lastName)
    {
        var fullName = $"{firstName} {lastName}".Trim();
        return string.IsNullOrWhiteSpace(fullName) ? "Paciente no asociado" : fullName;
    }

    private static string GetDueCaption(AccountReceivableRow item)
    {
        if (item.DueDate is null)
        {
            return "Sin fecha";
        }

        var today = DateOnly.FromDateTime(DateTime.Today);
        var days = item.DueDate.Value.DayNumber - today.DayNumber;

        if (days == 0)
        {
            return "Vence hoy";
        }

        if (days < 0)
        {
            return $"{Math.Abs(days)} dias de atraso";
        }

        return $"Faltan {days} dias";
    }

    private static int GetDaysPastDue(AccountReceivableRow item)
    {
        if (item.DueDate is null || item.Balance <= 0)
        {
            return -1;
        }

        return DateOnly.FromDateTime(DateTime.Today).DayNumber - item.DueDate.Value.DayNumber;
    }

    private static string GetAgingBucket(AccountReceivableRow item)
    {
        var daysPastDue = GetDaysPastDue(item);
        if (item.Balance <= 0)
        {
            return "Sin saldo";
        }

        if (daysPastDue < 0)
        {
            return "Por vencer";
        }

        if (daysPastDue <= 30)
        {
            return "0-30 dias";
        }

        if (daysPastDue <= 60)
        {
            return "31-60 dias";
        }

        if (daysPastDue <= 90)
        {
            return "61-90 dias";
        }

        return "90+ dias";
    }

    private static string GetCollectionPriority(AccountReceivableRow item)
    {
        var daysPastDue = GetDaysPastDue(item);
        return daysPastDue switch
        {
            > 90 => "Critica",
            > 30 => "Alta",
            >= 0 => "Media",
            _ when item.Balance > 0 => "Preventiva",
            _ => "Cerrada"
        };
    }

    private bool IsReferenceRequired(int paymentMethodId)
    {
        if (paymentMethodId == -1)
        {
            return false;
        }

        var methodName = paymentMethods.FirstOrDefault(x => x.Id == paymentMethodId)?.Name ?? string.Empty;
        return methodName.Contains("transfer", StringComparison.OrdinalIgnoreCase)
            || methodName.Contains("tarjeta", StringComparison.OrdinalIgnoreCase)
            || methodName.Contains("deposit", StringComparison.OrdinalIgnoreCase);
    }

    private static string ResolveCreditNoteStatus(string? state, decimal? availableBalance, DateTime? expirationDate)
    {
        if (expirationDate.HasValue && expirationDate.Value.Date < DateTime.Today && (availableBalance ?? 0m) > 0m)
        {
            return "Vencida";
        }

        if ((availableBalance ?? 0m) <= 0.009m)
        {
            return "Aplicada";
        }

        return string.IsNullOrWhiteSpace(state) || string.Equals(state, "Emitida", StringComparison.OrdinalIgnoreCase)
            ? "Disponible"
            : state!;
    }

    private async Task<tbl_nota_credito?> ResolveApplicableCreditNoteAsync(OpticaDbContext dbContext, int clientId, int creditNoteId)
    {
        return await (
            from note in dbContext.tbl_nota_credito
            join comprobante in dbContext.tbl_comprobantes on note.id_comprobante_relacionado equals comprobante.id_comprobante
            join sale in dbContext.tbl_venta on comprobante.id_venta equals sale.id_venta
            where note.id_nota_credito == creditNoteId
               && sale.id_cliente_facturacion == clientId
               && (note.saldo_disponible ?? note.monto_total) > 0m
               && (note.fecha_vencimiento == null || note.fecha_vencimiento >= DateTime.Today)
               && note.estado != "Anulada"
            select note)
            .FirstOrDefaultAsync();
    }

    private async Task<tbl_nota_credito?> ResolveCreditNoteFromReferenceAsync(OpticaDbContext dbContext, int clientId, string? reference)
    {
        var noteNumber = ParseCreditNoteNumber(reference);
        if (string.IsNullOrWhiteSpace(noteNumber))
        {
            return null;
        }

        return await (
            from note in dbContext.tbl_nota_credito
            join comprobante in dbContext.tbl_comprobantes on note.id_comprobante_relacionado equals comprobante.id_comprobante
            join sale in dbContext.tbl_venta on comprobante.id_venta equals sale.id_venta
            where note.numero_nota == noteNumber
               && sale.id_cliente_facturacion == clientId
               && note.estado != "Anulada"
            select note)
            .FirstOrDefaultAsync();
    }

    private static string? ParseCreditNoteNumber(string? reference)
    {
        if (string.IsNullOrWhiteSpace(reference))
        {
            return null;
        }

        var normalized = reference.Trim();
        if (!normalized.StartsWith("NC:", StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        var value = normalized[3..].Trim();
        var separator = value.IndexOf(' ');
        return separator > 0 ? value[..separator].Trim() : value;
    }

    private static void UpdateCreditNoteBalance(tbl_nota_credito note, decimal delta)
    {
        var newBalance = Math.Max(0m, (note.saldo_disponible ?? note.monto_total) + delta);
        note.saldo_disponible = newBalance;
        note.estado = ResolveCreditNoteStatus(note.estado, newBalance, note.fecha_vencimiento);
    }

