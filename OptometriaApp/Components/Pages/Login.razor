@page "/"
@layout AuthLayout
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Login</PageTitle>

<div class="auth-shell">
    <section class="auth-panel auth-panel-brand">
        <div class="brand-badge">Optometria</div>
        <h1>Gestion segura de pacientes, consultas y ventas</h1>
        <p>
            El ingreso principal ahora trabaja con autenticacion en dos pasos,
            bloqueo por intentos fallidos y recuperacion con clave temporal enviada al correo.
        </p>

        <div class="brand-points">
            <div class="brand-point">Ruta principal <code>/</code> dedicada al login</div>
            <div class="brand-point">Primer ingreso con configuracion de Google Authenticator</div>
            <div class="brand-point">Bloqueo automatico al tercer intento fallido</div>
        </div>
    </section>

    <section class="auth-panel auth-panel-form">
        <div class="auth-card">
            <div class="auth-heading">
                <span class="eyebrow">Ingreso principal</span>
                <h2>Iniciar sesion</h2>
                <p>Escribe tu usuario y contrasena para continuar.</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="alert alert-danger" role="alert">@Error</div>
            }

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="alert alert-success" role="alert">@Message</div>
            }

            <form method="post" action="/auth/login" class="auth-form">
                <div>
                    <label class="form-label" for="usuario">Usuario</label>
                    <input id="usuario" name="usuario" class="form-control" placeholder="Ingresa tu usuario" />
                </div>

                <div>
                    <label class="form-label" for="password">Contrasena</label>
                    <div class="password-field">
                        <input id="password" name="password" type="@(showPassword ? "text" : "password")" class="form-control" placeholder="Ingresa tu contrasena" />
                        <button type="button" class="password-toggle" @onclick="TogglePasswordVisibility">
                            @(showPassword ? "Ocultar" : "Mostrar")
                        </button>
                    </div>
                </div>

                <label class="auth-check">
                    <input id="rememberMe" name="rememberMe" type="checkbox" value="true" />
                    <span>Recordarme en este equipo</span>
                </label>

                <button type="submit" class="btn btn-primary auth-submit">Entrar al sistema</button>
            </form>

            <div class="auth-footer auth-footer-stack">
                <a href="/forgot-password">Olvide mi contrasena</a>
                <a href="/register">Crear usuario</a>
            </div>
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? Message { get; set; }

    private bool showPassword;
    private bool shouldRedirectAuthenticatedUser;
    private ClaimsPrincipal? authenticatedUser;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            authenticatedUser = authState.User;
            shouldRedirectAuthenticatedUser = true;
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && shouldRedirectAuthenticatedUser && authenticatedUser is not null)
        {
            shouldRedirectAuthenticatedUser = false;
            NavigateByStage(authenticatedUser);
        }

        return Task.CompletedTask;
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private void NavigateByStage(ClaimsPrincipal user)
    {
        var forcePasswordChange = string.Equals(user.FindFirst("ForcePasswordChange")?.Value, bool.TrueString, StringComparison.OrdinalIgnoreCase);

        NavigationManager.NavigateTo(forcePasswordChange ? "/change-password" : "/dashboard");
    }
}
