    private static string? NormalizeOptional(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private async Task<bool> CanViewHistoryModuleAsync(OpticaDbContext dbContext)
    {
        if (currentRoleId == 1)
        {
            return true;
        }

        var permission = await dbContext.tbl_rol_menu_permisos
            .AsNoTracking()
            .Where(p => p.id_rol == currentRoleId)
            .Join(
                dbContext.tbl_menu_apps.AsNoTracking().Where(m => m.ruta == "/doctor/historia-clinica"),
                rolePermission => rolePermission.id_menu,
                menu => menu.id_menu,
                (rolePermission, _) => rolePermission)
            .FirstOrDefaultAsync();

        return permission?.puede_ver == true;
    }

    private async Task<int> EnsureConsultationSnapshotAsync(OpticaDbContext dbContext)
    {
        var existingConsultation = await dbContext.tbl_consulta
            .Where(x => x.id_paciente == patient!.id_paciente && x.id_optometra == currentUserId)
            .OrderByDescending(x => x.fecha_consulta)
            .FirstOrDefaultAsync();

        if (existingConsultation is null)
        {
            existingConsultation = new tbl_consulta
            {
                id_paciente = patient!.id_paciente,
                id_optometra = currentUserId
            };

            dbContext.tbl_consulta.Add(existingConsultation);
        }

        existingConsultation.fecha_consulta = DateTime.Now;
        existingConsultation.motivo_consulta = NormalizeOptional(editor!.MotivoConsulta);
        existingConsultation.historia_clinica = NormalizeOptional(editor.NumeroHistoria);
        existingConsultation.antecedentes_personales = NormalizeOptional(editor.Antecedentes.PersonalesGenerales);
        existingConsultation.antecedentes_familiares = NormalizeOptional(editor.Antecedentes.FamiliaresGenerales);
        existingConsultation.antecedentes_oculares = NormalizeOptional(string.Join(" | ", new[]
        {
            editor.Antecedentes.PersonalesOculares,
            editor.Antecedentes.FamiliaresOculares
        }.Where(value => !string.IsNullOrWhiteSpace(value))));
        existingConsultation.usa_lentes = editor.UsaLentes;
        existingConsultation.detalle_usa_lentes = NormalizeOptional(editor.Lentes.Observaciones);
        existingConsultation.evaluaciones = NormalizeOptional(editor.Diagnostico.TratamientoConducta);
        existingConsultation.examenes_varios = NormalizeOptional(editor.Diagnostico.ExamenesIndicados);
        existingConsultation.medicamentos = NormalizeOptional(editor.Diagnostico.MedicamentosRecetados);
        existingConsultation.notas = NormalizeOptional(editor.ObservacionesGenerales);

        await dbContext.SaveChangesAsync();
        return existingConsultation.id_consulta;
    }

    private void ResetPatientContext()
    {
        patient = null;
        history = null;
        openingSnapshot = null;
        editor = null;
        historyExists = false;
        historyOpenedLabel = "Sin apertura";
    }

