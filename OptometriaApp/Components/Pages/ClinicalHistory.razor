@page "/doctor/historia-clinica"
@page "/doctor/clinical-history"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BillingDraftService BillingDraftService
@inject ClinicalHistoryService ClinicalHistoryService
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@using OptometriaApp.Services

<PageTitle>Historia clinica</PageTitle>

@if (canViewModule && selectedEncounterSummary is not null)
{
    <ClinicalEditControl EncounterId="@selectedEncounterSummary.EncounterId" />
    <label for="clinical-edit-reason">Motivo obligatorio de la edición</label>
    <textarea id="clinical-edit-reason" class="form-control" maxlength="1000" @bind="editReason"></textarea>
}

@if (isLoading)
{
    <section class="management-shell">
        <div class="management-card">
            <h1>Cargando historia clinica...</h1>
        </div>
    </section>
}
else if (!canViewModule)
{
    <section class="management-shell">
        <div class="management-card">
            <span class="eyebrow">Restringido</span>
            <h1>Historia clinica</h1>
            <p>Tu rol no tiene permiso para usar este módulo.</p>
        </div>
    </section>
}
else
{
    <section class="management-shell clinical-history-shell">
        <div class="management-hero">
            <div>
                <span class="eyebrow">Historia optometrica</span>
                <h1>Historia clinica</h1>
                <p>Trabaja la historia maestra del paciente y registra cada evolucion como un encuentro clinico independiente, con trazabilidad, borrador y cierre seguro.</p>
            </div>

            <div class="workspace-actions">
                @if (selectedEncounterSummary is not null)
                {
                    <a class="btn btn-outline-primary" href="@($"/certificados-medicos/{selectedEncounterSummary.ConsultationId}")">Certificados médicos</a>
                    <a class="btn btn-outline-primary" href="@($"/prescriptions/{selectedEncounterSummary.ConsultationId}/print")" target="_blank" rel="noopener">Imprimir receta</a>
                }
                <a class="btn btn-outline-primary" href="/doctor/historia-clinica">Cambiar paciente</a>
                @if (patient is not null && editor is not null)
                {
                    <a class="btn btn-outline-primary" href="@GetExamModuleUrl()">Modulo de examenes</a>
                    <a class="btn btn-outline-primary" href="@GetAppointmentPrefillUrl()">Agendar cita</a>
                    <button type="button" class="btn btn-outline-primary" @onclick="StartNewEncounterAsync">Nueva evolucion</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveDraftAsync">Guardar borrador</button>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-success d-flex align-items-center justify-content-between py-2 px-3 mb-3 shadow-sm border-0 rounded-3" role="alert">
                <div><i class="bi bi-check-circle-fill me-2"></i>@statusMessage</div>
                <button type="button" class="btn-close" aria-label="Close" @onclick="() => statusMessage = null"></button>
            </div>
        }

        @if (showClosedSuccessModal)
        {
            <div class="custom-modal-overlay" style="z-index: 10000;" @onclick="CloseClosedSuccessModal">
                <div class="custom-modal-card status-modal-card" style="max-width: 520px; border-radius: 1.25rem; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,0.35);" @onclick:stopPropagation="true">
                    <header class="custom-modal-header success-header" style="padding: 1.2rem 1.6rem; border-bottom: 1px solid rgba(78, 147, 122, 0.2);">
                        <div class="status-modal-header-copy">
                            <span class="status-modal-badge" style="color: #276749;"><i class="bi bi-shield-check me-1"></i> Proceso completado</span>
                            <h2 style="font-size: 1.25rem; font-weight: 800; color: #1e4620;">Historial Clínico Cerrado</h2>
                        </div>
                        <button type="button" class="btn-close-modal" @onclick="CloseClosedSuccessModal">×</button>
                    </header>
                    <div class="custom-modal-body status-modal-body" style="padding: 2rem 1.8rem; text-align: center;">
                        <div style="width: 72px; height: 72px; border-radius: 50%; background: #ebfbee; color: #2b8a3e; display: flex; align-items: center; justify-content: center; font-size: 2.2rem; margin: 0 auto 1rem; border: 2px solid #b2f2bb;">
                            <i class="bi bi-check2-circle"></i>
                        </div>
                        <h3 style="font-size: 1.15rem; font-weight: 700; color: #212529; margin-bottom: 0.5rem;">¡Historial cerrado exitosamente!</h3>
                        <p class="text-muted small mb-0" style="font-size: 0.92rem; line-height: 1.5;">
                            La evolución clínica del paciente <strong>@GetPatientFullName()</strong> ha sido finalizada y guardada de forma segura con su firma digital y sincronización de servicios.
                        </p>
                    </div>
                    <footer class="custom-modal-footer" style="padding: 1rem 1.6rem; background: #f8faf9; border-top: 1px solid rgba(0,0,0,0.06); display: flex; justify-content: space-between; gap: 0.75rem;">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseClosedSuccessModal">
                            Permanecer aquí
                        </button>
                        <button type="button" class="btn btn-success px-4 fw-bold" @onclick="NavigateToAppointments">
                            <i class="bi bi-calendar-check me-1"></i> Ir a Citas
                        </button>
                    </footer>
                </div>
            </div>
        }

        @if (showValidationModal && (validationMessages.Count > 0 || !string.IsNullOrWhiteSpace(errorMessage)))
        {
            <div class="modal fade show d-block" tabindex="-1" style="background: rgba(26, 21, 18, 0.62); z-index: 10000;" role="dialog" @onclick="CloseValidationModal">
                <div class="modal-dialog modal-dialog-centered" role="document" @onclick:stopPropagation="true">
                    <div class="modal-content border-0 shadow-lg" style="border-radius: 1.25rem; overflow: hidden;">
                        <div class="modal-header @(validationMessages.Count > 0 ? "bg-warning-subtle text-dark" : "bg-danger-subtle text-danger") border-0 py-3 px-4">
                            <h5 class="modal-title fw-bold d-flex align-items-center gap-2 mb-0">
                                @if (validationMessages.Count > 0)
                                {
                                    <i class="bi bi-exclamation-triangle-fill text-warning fs-4"></i>
                                    <span>Requisitos pendientes</span>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle-fill text-danger fs-4"></i>
                                    <span>Atención</span>
                                }
                            </h5>
                            <button type="button" class="btn-close" aria-label="Close" @onclick="CloseValidationModal"></button>
                        </div>
                        <div class="modal-body p-4">
                            @if (!string.IsNullOrWhiteSpace(errorMessage))
                            {
                                <div class="alert alert-danger py-2 px-3 mb-3 small border-0 shadow-sm">
                                    <strong><i class="bi bi-shield-exclamation me-1"></i> @errorMessage</strong>
                                </div>
                            }
                            @if (validationMessages.Count > 0)
                            {
                                <p class="text-muted small mb-2">Para poder cerrar y guardar la historia clínica de forma segura, completa los siguientes puntos:</p>
                                <ul class="list-group list-group-flush border rounded mb-0">
                                    @foreach (var msg in validationMessages)
                                    {
                                        <li class="list-group-item d-flex align-items-center gap-2 py-2 px-3 small">
                                            <i class="bi bi-arrow-right-circle-fill text-warning flex-shrink-0"></i>
                                            <span>@msg</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                        <div class="modal-footer border-0 bg-light px-4 py-3 d-flex justify-content-between">
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloseValidationModal">
                                Entendido / Cerrar
                            </button>
                            @if (validationMessages.Count > 0)
                            {
                                <button type="button" class="btn btn-primary btn-sm" @onclick="GoToValidationStep">
                                    <i class="bi bi-pencil-square me-1"></i> Ir al paso pendiente
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <section class="management-card clinical-card">
            <div class="management-card-header">
                <h2>Paciente</h2>
                <span>@availablePatients.Count registrados</span>
            </div>
            <div class="clinical-grid-2" style="margin-top: 1rem;">
                <div>
                    <label class="form-label" for="clinicalPatientSearch">Buscar paciente</label>
                    <input id="clinicalPatientSearch" class="form-control" @bind="patientSearchTerm" @bind:event="oninput" placeholder="Nombre, cedula o codigo" />
                </div>
                <div>
                    <label class="form-label" for="clinicalPatientPicker">Selecciona el paciente</label>
                    <select id="clinicalPatientPicker" class="form-select" value="@GetSelectedPatientValue()" @onchange="OnPatientChangedAsync">
                        <option value="">Selecciona un paciente</option>
                        @foreach (var availablePatient in FilteredPatients)
                        {
                            <option value="@availablePatient.id_paciente">@GetPatientOptionLabel(availablePatient)</option>
                        }
                    </select>
                </div>
            </div>

            @if (patient is null)
            {
                <p style="margin: 1rem 0 0;">Selecciona un paciente para abrir su historia maestra y revisar o crear nuevas evoluciones clinicas.</p>
            }
        </section>

        @if (patient is not null && editor is not null && openingSnapshot is not null)
        {
            <div class="clinical-kpi-row">
                <div class="clinical-kpi-card">
                    <div class="kpi-card-header">
                        <span class="kpi-icon-badge"><i class="bi bi-person-fill"></i></span>
                        <span class="kpi-label">Paciente</span>
                    </div>
                    <div class="kpi-card-body">
                        <h3 class="kpi-title text-truncate">@GetPatientFullName()</h3>
                        <div class="kpi-meta">
                            <span><i class="bi bi-card-text"></i> @GetPatientCedula()</span>
                            @if (!string.IsNullOrWhiteSpace(GetPatientAgeDisplay()))
                            {
                                <span><i class="bi bi-calendar3"></i> @GetPatientAgeDisplay()</span>
                            }
                        </div>
                        <div class="kpi-subtext text-truncate mt-1">
                            <span class="badge bg-light text-dark border">HC: @(string.IsNullOrWhiteSpace(editor.NumeroHistoria) ? "Por asignar" : editor.NumeroHistoria)</span>
                            <span class="text-muted small ms-1">@(history?.fecha_apertura?.ToString("yyyy-MM-dd") ?? "Apertura hoy")</span>
                        </div>
                    </div>
                </div>

                <div class="clinical-kpi-card">
                    <div class="kpi-card-header">
                        <span class="kpi-icon-badge"><i class="bi bi-journal-medical"></i></span>
                        <span class="kpi-label">Evolución Activa</span>
                    </div>
                    <div class="kpi-card-body">
                        <div class="d-flex align-items-center gap-1 mb-1">
                            <select class="form-select form-select-sm" value="@(EncounterId?.ToString() ?? "new")" @onchange="OnEncounterSelectChanged">
                                <option value="new">+ Nueva Evolución (Borrador)</option>
                                @foreach (var enc in encounterSummaries)
                                {
                                    <option value="@enc.EncounterId">#@enc.EncounterId - @enc.EventDate.ToString("yyyy-MM-dd HH:mm") (@enc.Status)</option>
                                }
                            </select>
                        </div>
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="clinical-badge @(selectedEncounterSummary?.Status == "Cerrada" ? "clinical-badge--success" : "clinical-badge--warning")">
                                @(selectedEncounterSummary?.Status ?? "Nuevo borrador")
                            </span>
                            <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none" style="font-size:0.8rem;" @onclick="StartNewEncounterAsync">
                                <i class="bi bi-plus-circle"></i> Nueva
                            </button>
                        </div>
                    </div>
                </div>

                <div class="clinical-kpi-card">
                    <div class="kpi-card-header">
                        <span class="kpi-icon-badge"><i class="bi bi-speedometer2"></i></span>
                        <span class="kpi-label">Progreso</span>
                    </div>
                    <div class="kpi-card-body">
                        <div class="d-flex align-items-baseline justify-content-between mb-1">
                            <h3 class="kpi-title mb-0">@ClinicalHistoryService.GetCompletionPercent(editor)%</h3>
                            <span class="small text-muted">Completado</span>
                        </div>
                        <div class="progress" style="height: 6px; border-radius: 4px; background: rgba(127,105,81,0.12);">
                            <div class="progress-bar" role="progressbar" style="width: @(ClinicalHistoryService.GetCompletionPercent(editor))%; background: #5da181;" aria-valuenow="@ClinicalHistoryService.GetCompletionPercent(editor)" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <p class="kpi-hint text-truncate mb-0 mt-1" title="@GetCompletionHint()">@GetCompletionHint()</p>
                    </div>
                </div>

                <div class="clinical-kpi-card">
                    <div class="kpi-card-header">
                        <span class="kpi-icon-badge"><i class="bi bi-shield-exclamation"></i></span>
                        <span class="kpi-label">Alertas & Exámenes</span>
                    </div>
                    <div class="kpi-card-body">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="clinical-badge @(alertSummaries.Count > 0 ? "clinical-badge--danger" : "clinical-badge--neutral")">
                                @alertSummaries.Count Alertas
                            </span>
                            <span class="clinical-badge clinical-badge--neutral">
                                @examTimeline.Count Exámenes
                            </span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between mt-1">
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size:0.75rem;" @onclick="ToggleHistoryDetails">
                                <i class="bi bi-clock-history me-1"></i>@(showHistoryDetails ? "Ocultar panel" : "Ver historial")
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            @if (showHistoryDetails)
            {
                <div class="clinical-drawer-panel">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="card h-100 p-3 shadow-sm border-0" style="background:#fff;">
                                <h6 class="fw-bold"><i class="bi bi-journal-text me-1"></i> Evoluciones (@encounterSummaries.Count)</h6>
                                <ClinicalHistoryEncounterList Encounters="encounterSummaries" SelectedEncounterId="EncounterId" LegacyLabel="legacyEncounterLabel" OnSelect="SelectEncounterAsync" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card h-100 p-3 shadow-sm border-0" style="background:#fff;">
                                <h6 class="fw-bold"><i class="bi bi-clipboard2-pulse me-1"></i> Exámenes (@examTimeline.Count)</h6>
                                @if (examTimeline.Count == 0)
                                {
                                    <p class="text-muted small">Sin exámenes previos registrados.</p>
                                }
                                else
                                {
                                    <div class="overflow-auto" style="max-height: 220px;">
                                        @foreach (var exam in examTimeline)
                                        {
                                            <div class="border-bottom py-1 small">
                                                <strong>@exam.ExamType</strong> (@exam.EventDate.ToString("yyyy-MM-dd"))
                                                <div class="text-muted">@exam.ResultSummary</div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card h-100 p-3 shadow-sm border-0" style="background:#fff;">
                                <h6 class="fw-bold"><i class="bi bi-exclamation-octagon me-1"></i> Alertas (@alertSummaries.Count)</h6>
                                @if (alertSummaries.Count == 0)
                                {
                                    <p class="text-muted small">Sin alertas clínicas activas.</p>
                                }
                                else
                                {
                                    <div class="overflow-auto" style="max-height: 220px;">
                                        @foreach (var alert in alertSummaries)
                                        {
                                            <div class="border-bottom py-1 small text-danger">
                                                <strong>@alert.Title</strong> - @alert.Category
                                                <div class="text-muted small">@alert.Notes</div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            <section class="management-card clinical-card clinical-wizard-shell">
                <div class="management-card-header">
                    <h2>Diligenciamiento guiado</h2>
                    <span>Paso @activeWizardStep de @WizardSteps.Count</span>
                </div>
                <ClinicalHistoryStepNavigation ActiveStep="activeWizardStep" Steps="WizardSteps" OnSelect="GoToWizardStepAsync" />
                <p class="clinical-helper-text">@GetWizardCurrentHint()</p>
            </section>

            @if (activeWizardStep == 1)
            {
                <section class="management-card clinical-card">
                    <div class="management-card-header">
                        <h2>Apertura y control</h2>
                        <span>Datos base protegidos</span>
                    </div>
                    <div class="clinical-grid-4" style="margin-top: 1rem;">
                        <div>
                            <label class="form-label">Fecha de apertura</label>
                            <input class="form-control" value="@(history?.fecha_apertura?.ToString("yyyy-MM-dd HH:mm") ?? DateTime.Now.ToString("yyyy-MM-dd HH:mm"))" readonly />
                        </div>
                        <div>
                            <label class="form-label">Ultima actualizacion</label>
                            <input class="form-control" value="@(selectedEncounterSummary?.UpdatedAt.ToString("yyyy-MM-dd HH:mm") ?? history?.fecha_ultima_actualizacion?.ToString("yyyy-MM-dd HH:mm") ?? "Sin actualizacion")" readonly />
                        </div>
                        <div>
                            <label class="form-label">Historia clinica N.</label>
                            <input class="form-control" @bind="editor.NumeroHistoria" />
                        </div>
                        <div>
                            <label class="form-label">Consultorio</label>
                            <input class="form-control" @bind="editor.Consultorio" />
                        </div>
                        <div>
                            <label class="form-label">Llave</label>
                            <input class="form-control" @bind="editor.LlaveClinica" />
                        </div>
                        <div>
                            <label class="form-label">Lugar de nacimiento</label>
                            <input class="form-control" @bind="editor.LugarNacimiento" />
                        </div>
                        <div>
                            <label class="form-label">Procedencia</label>
                            <input class="form-control" @bind="editor.Procedencia" />
                        </div>
                        <div>
                            <label class="form-label">Ultimo control</label>
                            <input class="form-control" @bind="editor.UltimoControl" />
                        </div>
                    </div>

                    <div class="management-card-header" style="margin-top: 1.5rem;">
                        <h2>Snapshot de apertura</h2>
                        <span>Se conserva para trazabilidad</span>
                    </div>
                    <div class="clinical-grid-4" style="margin-top: 1rem;">
                        <div><label class="form-label">Apellidos</label><input class="form-control" value="@(GetSnapshotValue(openingSnapshot?.Apellidos, patient?.apellidos))" readonly /></div>
                        <div><label class="form-label">Nombres</label><input class="form-control" value="@(GetSnapshotValue(openingSnapshot?.Nombres, patient?.nombres))" readonly /></div>
                        <div><label class="form-label">CI</label><input class="form-control" value="@(GetSnapshotValue(openingSnapshot?.Cedula, patient?.cedula))" readonly /></div>
                        <div><label class="form-label">Genero</label><input class="form-control" value="@(GetSnapshotValue(openingSnapshot?.Genero, patient?.genero))" readonly /></div>
                        <div><label class="form-label">Fecha nacimiento</label><input class="form-control" value="@(GetSnapshotValue(openingSnapshot?.FechaNacimiento, patient?.fecha_nacimiento?.ToString("yyyy-MM-dd")))" readonly /></div>
                        <div><label class="form-label">Edad</label><input class="form-control" value="@(GetSnapshotValue(openingSnapshot?.Edad, patient?.edad?.ToString()))" readonly /></div>
                        <div><label class="form-label">Ocupacion</label><input class="form-control" value="@(GetSnapshotValue(openingSnapshot?.Ocupacion, patient?.ocupacion))" readonly /></div>
                        <div><label class="form-label">Email</label><input class="form-control" value="@(GetSnapshotValue(openingSnapshot?.Email, patient?.email))" readonly /></div>
                        <div class="clinical-span-2"><label class="form-label">Direccion</label><input class="form-control" value="@(GetSnapshotValue(openingSnapshot?.Direccion, patient?.direccion))" readonly /></div>
                        <div><label class="form-label">Telefono</label><input class="form-control" value="@(GetSnapshotValue(openingSnapshot?.Telefono, patient?.telefono))" readonly /></div>
                    </div>
                </section>
            }

            @if (activeWizardStep == 2)
            {
                <section class="management-card clinical-card">
                    <div class="management-card-header">
                        <h2>Motivo, anamnesis y antecedentes</h2>
                        <span>Contexto clinico inicial</span>
                    </div>
                    <p class="clinical-helper-text">Este paso ya no solo orienta: tambien valida el flujo clinico minimo para que la evolucion quede clara y reutilizable.</p>
                    <div class="clinical-tutorial-grid" style="margin-top: 1rem;">
                        <div class="clinical-tutorial-card">
                            <span class="eyebrow">Tutorial 1</span>
                            <strong>Define el problema real</strong>
                            <p>Selecciona motivo principal, inicio y lateralidad. Evita frases vagas o administrativas.</p>
                        </div>
                        <div class="clinical-tutorial-card">
                            <span class="eyebrow">Tutorial 2</span>
                            <strong>Mide el cuadro</strong>
                            <p>Usa duracion numerica real, intensidad y por lo menos un sintoma. Si hay riesgo, marca una alerta.</p>
                        </div>
                        <div class="clinical-tutorial-card">
                            <span class="eyebrow">Tutorial 3</span>
                            <strong>Agrega solo contexto util</strong>
                            <p>Completa desencadenantes, aliviantes y notas solo cuando aporten informacion clinica verificable.</p>
                        </div>
                    </div>
                    <div class="clinical-tutorial-warning">
                        <strong>No escribir:</strong> “revision”, “molestia”, “me duele un poco”.
                        <br />
                        <strong>Mejor:</strong> “Vision borrosa AO de inicio gradual desde hace 3 semanas, peor en pantalla, mejora con reposo”.
                    </div>
                    <div class="clinical-grid-4" style="margin-top: 1rem;">
                        <div>
                            <label class="form-label">Motivo principal</label>
                            <select class="form-select" @bind="editor.AnamnesisGuiada.MotivoPrincipal">
                                <option value="">Selecciona</option>
                                @foreach (var option in MainComplaintOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="form-label">Inicio</label>
                            <select class="form-select" @bind="editor.AnamnesisGuiada.Inicio">
                                <option value="">Selecciona</option>
                                @foreach (var option in OnsetOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="form-label">Duracion</label>
                            <input class="form-control" @bind="editor.AnamnesisGuiada.DuracionValor" inputmode="numeric" pattern="[0-9]*" maxlength="4" placeholder="Ej. 3" />
                        </div>
                        <div>
                            <label class="form-label">Unidad</label>
                            <select class="form-select" @bind="editor.AnamnesisGuiada.DuracionUnidad">
                                @foreach (var option in DurationUnitOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="form-label">Lateralidad</label>
                            <select class="form-select" @bind="editor.AnamnesisGuiada.Lateralidad">
                                <option value="">Selecciona</option>
                                @foreach (var option in LateralityOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="form-label">Intensidad</label>
                            <select class="form-select" @bind="editor.AnamnesisGuiada.Intensidad">
                                <option value="">Selecciona</option>
                                @foreach (var option in IntensityOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </div>
                        <div class="clinical-span-2">
                            <label class="form-label">Desencadenantes</label>
                            <input class="form-control" @bind="editor.AnamnesisGuiada.Desencadenantes" maxlength="120" placeholder="Pantallas, lectura, polvo, sol..." />
                        </div>
