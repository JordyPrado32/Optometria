@page "/doctor/historia-clinica"
@page "/doctor/clinical-history"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.EntityFrameworkCore
@using OptometriaApp.Data
@using OptometriaApp.Models
@using OptometriaApp.Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BillingDraftService BillingDraftService
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject NavigationManager NavigationManager

<PageTitle>Historia clinica</PageTitle>

@if (isLoading)
{
    <section class="management-shell">
        <div class="management-card">
            <h1>Cargando historia clinica...</h1>
        </div>
    </section>
}
else if (!canViewModule)
{
    <section class="management-shell">
        <div class="management-card">
            <span class="eyebrow">Restringido</span>
            <h1>Historia clinica</h1>
            <p>Tu rol no tiene permiso para usar este modulo.</p>
        </div>
    </section>
}
else
{
    <section class="management-shell clinical-history-shell">
        <div class="management-hero">
            <div>
                <span class="eyebrow">Historia optometrica</span>
                <h1>Historia clinica</h1>
                <p>Selecciona un paciente desde este modulo y registra aqui mismo la apertura, evolucion clinica y servicios pendientes de facturacion.</p>
            </div>

            <div class="workspace-actions">
                <a class="btn btn-outline-primary" href="/doctor/historia-clinica">Cambiar paciente</a>
                @if (patient is not null && editor is not null && openingSnapshot is not null)
                {
                    <button type="button" class="btn btn-primary" @onclick="SaveAsync">@(historyExists ? "Guardar actualizacion" : "Crear historia clinica")</button>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-success" role="alert">@statusMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        <section class="management-card clinical-card">
            <div class="management-card-header">
                <h2>Paciente</h2>
                <span>@availablePatients.Count registrados</span>
            </div>
            <div class="clinical-grid-4" style="margin-top: 1rem;">
                <div class="clinical-span-3">
                    <label class="form-label">Selecciona el paciente</label>
                    <select class="form-select" value="@GetSelectedPatientValue()" @onchange="OnPatientChangedAsync">
                        <option value="">Selecciona un paciente</option>
                        @foreach (var availablePatient in availablePatients)
                        {
                            <option value="@availablePatient.id_paciente">@GetPatientOptionLabel(availablePatient)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label">Estado actual</label>
                    <input class="form-control" value="@(patient is null ? "Sin seleccion" : (historyExists ? "Historia existente" : "Nueva historia"))" readonly />
                </div>
            </div>
            @if (patient is null || editor is null || openingSnapshot is null)
            {
                <p style="margin: 1rem 0 0;">Selecciona un paciente para abrir o actualizar su historia clinica sin salir de este modulo.</p>
            }
        </section>

        @if (patient is not null && editor is not null && openingSnapshot is not null)
        {
        <section class="management-card clinical-card">
            <div class="clinical-header-grid">
                <div class="clinical-highlight">
                    <span class="eyebrow">Paciente</span>
                    <strong>@($"{openingSnapshot.Nombres} {openingSnapshot.Apellidos}")</strong>
                    <p>@openingSnapshot.Cedula</p>
                </div>
                <div class="clinical-highlight">
                    <span class="eyebrow">Historia</span>
                    <strong>@(string.IsNullOrWhiteSpace(editor.NumeroHistoria) ? "Pendiente" : editor.NumeroHistoria)</strong>
                    <p>@(historyExists ? $"Apertura: {historyOpenedLabel}" : "Aun no creada")</p>
                </div>
                <div class="clinical-highlight">
                    <span class="eyebrow">Proteccion</span>
                    <strong>@(historyExists ? "Datos base bloqueados" : "Se congelaran al crear")</strong>
                    <p>Los datos de apertura no se sobrescriben despues de la primera creacion.</p>
                </div>
            </div>

            <div class="clinical-grid-4" style="margin-top: 1rem;">
                <div>
                    <label class="form-label">Fecha</label>
                    <input class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" readonly />
                </div>
                <div>
                    <label class="form-label">Hora</label>
                    <input class="form-control" value="@DateTime.Now.ToString("HH:mm")" readonly />
                </div>
                <div>
                    <label class="form-label">Historia clinica N.</label>
                    <input class="form-control" @bind="editor.NumeroHistoria" readonly="@historyExists" />
                </div>
                <div>
                    <label class="form-label">Consultorio</label>
                    <input class="form-control" @bind="editor.Consultorio" readonly="@historyExists" />
                </div>
                <div>
                    <label class="form-label">Llave</label>
                    <input class="form-control" @bind="editor.LlaveClinica" readonly="@historyExists" />
                </div>
                <div>
                    <label class="form-label">Lugar de nacimiento</label>
                    <input class="form-control" @bind="editor.LugarNacimiento" readonly="@historyExists" />
                </div>
                <div>
                    <label class="form-label">Procedencia</label>
                    <input class="form-control" @bind="editor.Procedencia" readonly="@historyExists" />
                </div>
                <div>
                    <label class="form-label">Ultimo control</label>
                    <input class="form-control" @bind="editor.UltimoControl" readonly="@historyExists" />
                </div>
            </div>
        </section>

        <section class="management-card clinical-card">
            <div class="management-card-header">
                <h2>Datos de apertura protegidos</h2>
                <span>Snapshot inicial del paciente</span>
            </div>
            <div class="clinical-grid-4" style="margin-top: 1rem;">
                <div><label class="form-label">Apellidos</label><input class="form-control" value="@openingSnapshot.Apellidos" readonly /></div>
                <div><label class="form-label">Nombres</label><input class="form-control" value="@openingSnapshot.Nombres" readonly /></div>
                <div><label class="form-label">CI</label><input class="form-control" value="@openingSnapshot.Cedula" readonly /></div>
                <div><label class="form-label">Genero</label><input class="form-control" value="@openingSnapshot.Genero" readonly /></div>
                <div><label class="form-label">Fecha nacimiento</label><input class="form-control" value="@openingSnapshot.FechaNacimiento" readonly /></div>
                <div><label class="form-label">Edad</label><input class="form-control" value="@openingSnapshot.Edad" readonly /></div>
                <div><label class="form-label">Ocupacion</label><input class="form-control" value="@openingSnapshot.Ocupacion" readonly /></div>
                <div><label class="form-label">Email</label><input class="form-control" value="@openingSnapshot.Email" readonly /></div>
                <div class="clinical-span-2"><label class="form-label">Direccion</label><input class="form-control" value="@openingSnapshot.Direccion" readonly /></div>
                <div><label class="form-label">Telefono</label><input class="form-control" value="@openingSnapshot.Telefono" readonly /></div>
            </div>
        </section>

        <section class="management-card clinical-card">
            <div class="management-card-header">
                <h2>Motivo y anamnesis</h2>
                <span>Bloque principal de consulta</span>
            </div>
            <div class="clinical-stack">
                <div>
                    <label class="form-label">Motivo de consulta</label>
                    <textarea class="form-control" rows="3" @bind="editor.MotivoConsulta"></textarea>
                </div>
                <div>
                    <label class="form-label">Anamnesis</label>
                    <textarea class="form-control" rows="5" @bind="editor.Anamnesis"></textarea>
                </div>
            </div>
        </section>

        <section class="management-card clinical-card">
            <div class="management-card-header">
                <h2>Antecedentes</h2>
                <span>Personales y familiares</span>
            </div>
            <div class="clinical-grid-2" style="margin-top: 1rem;">
                <div>
                    <label class="form-label">Personales oculares</label>
                    <textarea class="form-control" rows="4" @bind="editor.Antecedentes.PersonalesOculares"></textarea>
                </div>
                <div>
                    <label class="form-label">Personales generales</label>
                    <textarea class="form-control" rows="4" @bind="editor.Antecedentes.PersonalesGenerales"></textarea>
                </div>
                <div>
                    <label class="form-label">Familiares oculares</label>
                    <textarea class="form-control" rows="4" @bind="editor.Antecedentes.FamiliaresOculares"></textarea>
                </div>
                <div>
                    <label class="form-label">Familiares generales</label>
                    <textarea class="form-control" rows="4" @bind="editor.Antecedentes.FamiliaresGenerales"></textarea>
                </div>
            </div>
        </section>

        <section class="management-card clinical-card">
            <div class="management-card-header">
                <h2>Lensometria y agudeza visual</h2>
                <span>Lectura base y vision</span>
            </div>
            <div class="clinical-grid-4" style="margin-top: 1rem;">
                <div><label class="form-label">Usa lentes</label><input type="checkbox" class="form-check-input" style="margin-left:0.2rem;" @bind="editor.UsaLentes" /></div>
                <div><label class="form-label">ADD</label><input class="form-control" @bind="editor.Lentes.Addicion" /></div>
                <div><label class="form-label">Prismas</label><input class="form-control" @bind="editor.Lentes.Prismas" /></div>
                <div><label class="form-label">Dist. pupilar</label><input class="form-control" @bind="editor.Lentes.DistPupilar" /></div>
                <div><label class="form-label">OD</label><input class="form-control" @bind="editor.Lentes.Od" /></div>
                <div><label class="form-label">OI</label><input class="form-control" @bind="editor.Lentes.Oi" /></div>
                <div><label class="form-label">AO</label><input class="form-control" @bind="editor.Lentes.Ao" /></div>
                <div><label class="form-label">Tipo de lente</label><input class="form-control" @bind="editor.Lentes.TipoLente" /></div>
                <div><label class="form-label">Material</label><input class="form-control" @bind="editor.Lentes.Material" /></div>
                <div><label class="form-label">Filtro</label><input class="form-control" @bind="editor.Lentes.Filtro" /></div>
                <div><label class="form-label">Tiempo de uso RX</label><input class="form-control" @bind="editor.Lentes.TiempoUsoRx" /></div>
                <div class="clinical-span-4"><label class="form-label">Observaciones del lente</label><textarea class="form-control" rows="3" @bind="editor.Lentes.Observaciones"></textarea></div>
            </div>

            <div class="clinical-grid-4" style="margin-top: 1rem;">
                <div><label class="form-label">AV VL SC OD</label><input class="form-control" @bind="editor.Visual.OdVlSc" /></div>
                <div><label class="form-label">AV VL SC OI</label><input class="form-control" @bind="editor.Visual.OiVlSc" /></div>
                <div><label class="form-label">AV VL SC AO</label><input class="form-control" @bind="editor.Visual.AoVlSc" /></div>
                <div><label class="form-label">PH</label><input class="form-control" @bind="editor.Visual.Ph" /></div>
                <div><label class="form-label">AV VP SC OD</label><input class="form-control" @bind="editor.Visual.OdVpSc" /></div>
                <div><label class="form-label">AV VP SC OI</label><input class="form-control" @bind="editor.Visual.OiVpSc" /></div>
                <div><label class="form-label">AV VP SC AO</label><input class="form-control" @bind="editor.Visual.AoVpSc" /></div>
                <div><label class="form-label">Dominancia</label><input class="form-control" @bind="editor.Visual.Dominancia" /></div>
                <div><label class="form-label">Optotipo</label><input class="form-control" @bind="editor.Visual.Optotipo" /></div>
                <div><label class="form-label">Distancia VL</label><input class="form-control" @bind="editor.Visual.DistanciaVl" /></div>
                <div><label class="form-label">Distancia VP</label><input class="form-control" @bind="editor.Visual.DistanciaVp" /></div>
            </div>
        </section>

        <section class="management-card clinical-card">
            <div class="management-card-header">
                <h2>Examen externo / biomicroscopia</h2>
                <span>Grafico ocular y hallazgos</span>
            </div>
            <div class="clinical-grid-2" style="margin-top: 1rem;">
                <EyeDiagramEditor Label="OD" @bind-Value="editor.Biomicroscopia.GraphicOd" />
                <EyeDiagramEditor Label="OI" @bind-Value="editor.Biomicroscopia.GraphicOi" />
            </div>
            <div class="clinical-odoi-grid">
                <div class="clinical-odoi-head">Hallazgo</div>
                <div class="clinical-odoi-head">OD</div>
                <div class="clinical-odoi-head">OI</div>
                <div class="clinical-odoi-label">Orbita / cejas</div>
                <input class="form-control" @bind="editor.Biomicroscopia.OrbitaOd" />
                <input class="form-control" @bind="editor.Biomicroscopia.OrbitaOi" />
                <div class="clinical-odoi-label">Parpados / pestanas</div>
                <input class="form-control" @bind="editor.Biomicroscopia.ParpadosOd" />
                <input class="form-control" @bind="editor.Biomicroscopia.ParpadosOi" />
                <div class="clinical-odoi-label">Sistema lagrimal</div>
                <input class="form-control" @bind="editor.Biomicroscopia.SistemaLagrimalOd" />
                <input class="form-control" @bind="editor.Biomicroscopia.SistemaLagrimalOi" />
                <div class="clinical-odoi-label">Conjuntiva / esclera</div>
                <input class="form-control" @bind="editor.Biomicroscopia.ConjuntivaOd" />
                <input class="form-control" @bind="editor.Biomicroscopia.ConjuntivaOi" />
                <div class="clinical-odoi-label">Cornea / camara anterior</div>
                <input class="form-control" @bind="editor.Biomicroscopia.CorneaOd" />
                <input class="form-control" @bind="editor.Biomicroscopia.CorneaOi" />
                <div class="clinical-odoi-label">Iris / pupila</div>
                <input class="form-control" @bind="editor.Biomicroscopia.IrisOd" />
                <input class="form-control" @bind="editor.Biomicroscopia.IrisOi" />
                <div class="clinical-odoi-label">Cristalino</div>
                <input class="form-control" @bind="editor.Biomicroscopia.CristalinoOd" />
                <input class="form-control" @bind="editor.Biomicroscopia.CristalinoOi" />
                <div class="clinical-odoi-label">Test adicionales</div>
                <input class="form-control" @bind="editor.Biomicroscopia.TestAdicionalesOd" />
                <input class="form-control" @bind="editor.Biomicroscopia.TestAdicionalesOi" />
            </div>
        </section>

        <section class="management-card clinical-card">
            <div class="management-card-header">
                <h2>Oftalmoscopia</h2>
                <span>Fondo de ojo y hallazgos</span>
            </div>
            <div class="clinical-grid-2" style="margin-top: 1rem;">
                <EyeDiagramEditor Label="OD" @bind-Value="editor.Oftalmoscopia.GraphicOd" />
                <EyeDiagramEditor Label="OI" @bind-Value="editor.Oftalmoscopia.GraphicOi" />
            </div>
            <div class="clinical-odoi-grid">
                <div class="clinical-odoi-head">Hallazgo</div>
                <div class="clinical-odoi-head">OD</div>
                <div class="clinical-odoi-head">OI</div>
                <div class="clinical-odoi-label">Papila / excavacion</div>
                <input class="form-control" @bind="editor.Oftalmoscopia.PapilaOd" />
                <input class="form-control" @bind="editor.Oftalmoscopia.PapilaOi" />
                <div class="clinical-odoi-label">Vasos / arteria / vena</div>
                <input class="form-control" @bind="editor.Oftalmoscopia.VasosOd" />
                <input class="form-control" @bind="editor.Oftalmoscopia.VasosOi" />
                <div class="clinical-odoi-label">Macula / fijacion</div>
                <input class="form-control" @bind="editor.Oftalmoscopia.MaculaOd" />
                <input class="form-control" @bind="editor.Oftalmoscopia.MaculaOi" />
                <div class="clinical-odoi-label">Tapete / regularidad y color</div>
                <input class="form-control" @bind="editor.Oftalmoscopia.TapeteOd" />
                <input class="form-control" @bind="editor.Oftalmoscopia.TapeteOi" />
            </div>
        </section>

        <section class="management-card clinical-card">
            <div class="management-card-header">
                <h2>Examen motor y refraccion</h2>
                <span>Bloques tecnicos de consulta</span>
            </div>
            <div class="clinical-grid-2" style="margin-top: 1rem;">
                <div>
                    <label class="form-label">Examen motor</label>
                    <textarea class="form-control" rows="8" @bind="editor.Motor.Resumen"></textarea>
                </div>
                <div>
                    <label class="form-label">Ducciones / versiones / Maddox / Worth</label>
                    <textarea class="form-control" rows="8" @bind="editor.Motor.HallazgosComplementarios"></textarea>
                </div>
                <div>
                    <label class="form-label">Queratometria y miras</label>
                    <textarea class="form-control" rows="6" @bind="editor.Keratometria.Resumen"></textarea>
                </div>
                <div>
                    <label class="form-label">Astigmatismo corneal</label>
                    <textarea class="form-control" rows="6" @bind="editor.Keratometria.AstigmatismoCorneal"></textarea>
                </div>
            </div>

            <div class="clinical-grid-2" style="margin-top: 1rem;">
                <div>
                    <label class="form-label">RX estatica y dinamica</label>
                    <textarea class="form-control" rows="8" @bind="editor.Refraction.RxEstaticaDinamica"></textarea>
                </div>
                <div>
                    <label class="form-label">Subjetivo, afinacion y balance binocular</label>
                    <textarea class="form-control" rows="8" @bind="editor.Refraction.SubjetivoAfinacionBalance"></textarea>
                </div>
                <div>
                    <label class="form-label">Prueba ambulatoria y RX final</label>
                    <textarea class="form-control" rows="8" @bind="editor.Refraction.PruebaAmbulatoriaRxFinal"></textarea>
                </div>
                <div>
                    <label class="form-label">Observaciones tecnicas</label>
                    <textarea class="form-control" rows="8" @bind="editor.Refraction.Observaciones"></textarea>
                </div>
            </div>
        </section>

        <section class="management-card clinical-card">
            <div class="management-card-header">
                <h2>Diagnostico y conducta</h2>
                <span>Cierre clinico</span>
            </div>
            <div class="clinical-grid-4" style="margin-top: 1rem;">
                <div class="clinical-span-3"><label class="form-label">Diagnostico OD</label><input class="form-control" @bind="editor.Diagnostico.DiagnosticoOd" /></div>
                <div><label class="form-label">CIE10</label><input class="form-control" @bind="editor.Diagnostico.Cie10" /></div>
                <div class="clinical-span-2"><label class="form-label">Diagnostico OI</label><input class="form-control" @bind="editor.Diagnostico.DiagnosticoOi" /></div>
                <div class="clinical-span-2"><label class="form-label">Motor</label><input class="form-control" @bind="editor.Diagnostico.DiagnosticoMotor" /></div>
                <div class="clinical-span-4"><label class="form-label">Patologico presuntivo</label><textarea class="form-control" rows="3" @bind="editor.Diagnostico.PatologicoPresuntivo"></textarea></div>
                <div class="clinical-span-4"><label class="form-label">Tratamiento / disposicion / conducta</label><textarea class="form-control" rows="4" @bind="editor.Diagnostico.TratamientoConducta"></textarea></div>
                <div class="clinical-span-4"><label class="form-label">Examenes indicados para facturacion</label><textarea class="form-control" rows="3" @bind="editor.Diagnostico.ExamenesIndicados"></textarea></div>
                <div class="clinical-span-4"><label class="form-label">Medicamentos recetados para facturacion</label><textarea class="form-control" rows="3" @bind="editor.Diagnostico.MedicamentosRecetados"></textarea></div>
                <div class="clinical-span-4"><label class="form-label">Observaciones generales</label><textarea class="form-control" rows="4" @bind="editor.ObservacionesGenerales"></textarea></div>
                <div class="clinical-span-2"><label class="form-label">Nombre del examinador</label><input class="form-control" @bind="editor.NombreExaminador" /></div>
                <div class="clinical-span-2"><label class="form-label">Nivel paralelo y jornada</label><input class="form-control" @bind="editor.NivelParaleloJornada" /></div>
            </div>
        </section>

        <section class="management-card clinical-card">
            <div class="management-card-header">
                <h2>Consentimiento informado</h2>
                <span>Registro final</span>
            </div>
            <div class="clinical-grid-4" style="margin-top: 1rem;">
                <div class="clinical-span-2"><label class="form-label">Yo,</label><input class="form-control" @bind="editor.Consentimiento.Nombre" /></div>
                <div><label class="form-label">CC</label><input class="form-control" @bind="editor.Consentimiento.Cedula" /></div>
                <div><label class="form-label">Firma / referencia</label><input class="form-control" @bind="editor.Consentimiento.FirmaReferencia" /></div>
                <div class="clinical-span-4">
                    <label class="form-label">Texto de consentimiento</label>
                    <textarea class="form-control" rows="4" @bind="editor.Consentimiento.Texto"></textarea>
                </div>
                <div>
                    <label class="form-label">Autoriza</label>
                    <input type="checkbox" class="form-check-input" style="margin-left:0.2rem;" @bind="editor.Consentimiento.Autorizado" />
                </div>
            </div>
        </section>
        }
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "patientId")]
    public int? PatientId { get; set; }

    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private readonly List<tbl_paciente> availablePatients = [];
    private tbl_paciente? patient;
    private tbl_historia_clinica_optometria? history;
    private OpeningSnapshot? openingSnapshot;
    private HistoryEditorModel? editor;
    private bool isLoading = true;
    private bool canViewModule;
    private bool historyExists;
    private int currentUserId;
    private int currentRoleId;
    private string? statusMessage;
    private string? errorMessage;
    private string historyOpenedLabel = "Sin apertura";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        statusMessage = null;
        errorMessage = null;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier), out var userId) ? userId : 0;
        currentRoleId = int.TryParse(authState.User.FindFirstValue("RoleId"), out var roleId) ? roleId : 0;

        if (currentUserId <= 0)
        {
            canViewModule = false;
            isLoading = false;
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        canViewModule = await CanViewHistoryModuleAsync(dbContext);

        if (!canViewModule)
        {
            isLoading = false;
            return;
        }

        var loadedPatients = await dbContext.tbl_pacientes
            .AsNoTracking()
            .OrderBy(x => x.apellidos)
            .ThenBy(x => x.nombres)
            .ToListAsync();

        availablePatients.Clear();
        availablePatients.AddRange(loadedPatients);

        if (!PatientId.HasValue || PatientId.Value <= 0)
        {
            ResetPatientContext();
            isLoading = false;
            return;
        }

        patient = await dbContext.tbl_pacientes
            .AsNoTracking()
            .FirstOrDefaultAsync(x => x.id_paciente == PatientId.Value);

        if (patient is null)
        {
            ResetPatientContext();
            errorMessage = "No se encontro el paciente seleccionado.";
            isLoading = false;
            return;
        }

        history = await dbContext.tbl_historia_clinica_optometrias
            .AsNoTracking()
            .FirstOrDefaultAsync(x => x.id_paciente == patient.id_paciente && x.activo == true);

        historyExists = history is not null;
        openingSnapshot = history is null
            ? BuildOpeningSnapshot(patient)
            : Deserialize<OpeningSnapshot>(history.datos_apertura_json) ?? BuildOpeningSnapshot(patient);

        editor = history is null ? BuildNewEditor(patient) : BuildEditor(history);
        historyOpenedLabel = history?.fecha_apertura?.ToString("yyyy-MM-dd HH:mm") ?? "Sin apertura";
        isLoading = false;
    }

    private async Task SaveAsync()
    {
        statusMessage = null;
        errorMessage = null;

        if (patient is null || editor is null || openingSnapshot is null)
        {
            errorMessage = "No existe un paciente valido para guardar la historia clinica.";
            return;
        }

        if (string.IsNullOrWhiteSpace(editor.MotivoConsulta))
        {
            errorMessage = "Ingresa el motivo de consulta.";
            return;
        }

        if (string.IsNullOrWhiteSpace(editor.NumeroHistoria))
        {
            errorMessage = "Define el numero de historia clinica.";
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var entity = await dbContext.tbl_historia_clinica_optometrias
            .FirstOrDefaultAsync(x => x.id_paciente == patient.id_paciente);

        if (entity is null)
        {
            entity = new tbl_historia_clinica_optometria
            {
                id_paciente = patient.id_paciente,
                id_optometra_apertura = currentUserId,
                fecha_apertura = DateTime.Now,
                numero_historia = NormalizeOptional(editor.NumeroHistoria),
                consultorio = NormalizeOptional(editor.Consultorio),
                llave_clinica = NormalizeOptional(editor.LlaveClinica),
                lugar_nacimiento = NormalizeOptional(editor.LugarNacimiento),
                procedencia = NormalizeOptional(editor.Procedencia),
                ultimo_control = NormalizeOptional(editor.UltimoControl),
                datos_apertura_json = JsonSerializer.Serialize(openingSnapshot, JsonOptions),
                activo = true
            };

            dbContext.tbl_historia_clinica_optometrias.Add(entity);
        }

        entity.id_optometra_ultima_actualizacion = currentUserId;
        entity.fecha_ultima_actualizacion = DateTime.Now;
        entity.motivo_consulta = NormalizeOptional(editor.MotivoConsulta);
        entity.anamnesis = NormalizeOptional(editor.Anamnesis);
        entity.antecedentes_json = Serialize(editor.Antecedentes);
        entity.usa_lentes = editor.UsaLentes;
        entity.lentes_json = Serialize(editor.Lentes);
        entity.agudeza_visual_json = Serialize(editor.Visual);
        entity.biomicroscopia_json = Serialize(editor.Biomicroscopia);
        entity.oftalmoscopia_json = Serialize(editor.Oftalmoscopia);
        entity.examen_motor_json = Serialize(editor.Motor);
        entity.queratometria_json = Serialize(editor.Keratometria);
        entity.refraccion_json = Serialize(editor.Refraction);
        entity.diagnostico_json = Serialize(editor.Diagnostico);
        entity.observaciones_generales = NormalizeOptional(editor.ObservacionesGenerales);
        entity.nombre_examinador = NormalizeOptional(editor.NombreExaminador);
        entity.nivel_paralelo_jornada = NormalizeOptional(editor.NivelParaleloJornada);
        entity.consentimiento_json = Serialize(editor.Consentimiento);

        var consultationId = await EnsureConsultationSnapshotAsync(dbContext);
        await BillingDraftService.EnsureConsultationBillingEntriesAsync(dbContext, consultationId, currentUserId);
        await dbContext.SaveChangesAsync();

        historyExists = true;
        statusMessage = HasBillingTriggers(editor)
            ? "La historia clinica se guardo correctamente y se actualizaron los servicios pendientes de facturacion."
            : "La historia clinica se guardo correctamente.";
        await LoadAsync();
    }

    private async Task OnPatientChangedAsync(ChangeEventArgs args)
    {
        var rawValue = args.Value?.ToString();
        PatientId = int.TryParse(rawValue, out var parsedPatientId) && parsedPatientId > 0
            ? parsedPatientId
            : null;

        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameter("patientId", PatientId), forceLoad: false);
        await LoadAsync();
    }

