@page "/doctor/historia-clinica"
@page "/doctor/clinical-history"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BillingDraftService BillingDraftService
@inject ClinicalHistoryService ClinicalHistoryService
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@using OptometriaApp.Services

<PageTitle>Historia clinica</PageTitle>

@if (isLoading)
{
    <section class="management-shell">
        <div class="management-card">
            <h1>Cargando historia clinica...</h1>
        </div>
    </section>
}
else if (!canViewModule)
{
    <section class="management-shell">
        <div class="management-card">
            <span class="eyebrow">Restringido</span>
            <h1>Historia clinica</h1>
            <p>Tu rol no tiene permiso para usar este modulo.</p>
        </div>
    </section>
}
else
{
    <section class="management-shell clinical-history-shell">
        <div class="management-hero">
            <div>
                <span class="eyebrow">Historia optometrica</span>
                <h1>Historia clinica</h1>
                <p>Trabaja la historia maestra del paciente y registra cada evolucion como un encuentro clinico independiente, con trazabilidad, borrador y cierre seguro.</p>
            </div>

            <div class="workspace-actions">
                <a class="btn btn-outline-primary" href="/doctor/historia-clinica">Cambiar paciente</a>
                @if (patient is not null && editor is not null)
                {
                    <a class="btn btn-outline-primary" href="@GetExamModuleUrl()">Modulo de examenes</a>
                    <a class="btn btn-outline-primary" href="@GetAppointmentPrefillUrl()">Agendar cita</a>
                    <button type="button" class="btn btn-outline-primary" @onclick="StartNewEncounterAsync">Nueva evolucion</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveDraftAsync">Guardar borrador</button>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-success" role="alert">@statusMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        @if (validationMessages.Count > 0)
        {
            <div class="alert alert-warning" role="alert">
                <strong>Antes de continuar revisa lo siguiente:</strong>
                <ul style="margin: 0.6rem 0 0; padding-left: 1.2rem;">
                    @foreach (var validationMessage in validationMessages)
                    {
                        <li>@validationMessage</li>
                    }
                </ul>
            </div>
            <div class="clinical-guide-grid" style="margin-top: 1rem;">
                <div class="clinical-guide-card">
                    <span class="eyebrow">1. Inicio</span>
                    <strong>Selecciona paciente</strong>
                    <p>Empieza arriba. Al elegir el paciente, el sistema completa los datos base protegidos.</p>
                </div>
                <div class="clinical-guide-card">
                    <span class="eyebrow">2. Consulta</span>
                    <strong>Llena anamnesis y examen</strong>
                    <p>Resume lo que cuenta el paciente y completa los hallazgos tecnicos.</p>
                </div>
                <div class="clinical-guide-card">
                    <span class="eyebrow">3. Cierre</span>
                    <strong>Firma y guarda</strong>
                    <p>Al final registra consentimiento, dibuja la firma si aplica y guarda la historia.</p>
                </div>
                <div class="clinical-guide-card clinical-guide-card--accent">
                    <span class="eyebrow">Progreso</span>
                    <strong>@(editor is null ? 0 : ClinicalHistoryService.GetCompletionPercent(editor))% completado</strong>
                    <p>@GetCompletionHint()</p>
                </div>
            </div>
        }

        <section class="management-card clinical-card">
            <div class="management-card-header">
                <h2>Paciente</h2>
                <span>@availablePatients.Count registrados</span>
            </div>
            <div class="clinical-grid-2" style="margin-top: 1rem;">
                <div>
                    <label class="form-label" for="clinicalPatientSearch">Buscar paciente</label>
                    <input id="clinicalPatientSearch" class="form-control" @bind="patientSearchTerm" @bind:event="oninput" placeholder="Nombre, cedula o codigo" />
                </div>
                <div>
                    <label class="form-label" for="clinicalPatientPicker">Selecciona el paciente</label>
                    <select id="clinicalPatientPicker" class="form-select" value="@GetSelectedPatientValue()" @onchange="OnPatientChangedAsync">
                        <option value="">Selecciona un paciente</option>
                        @foreach (var availablePatient in FilteredPatients)
                        {
                            <option value="@availablePatient.id_paciente">@GetPatientOptionLabel(availablePatient)</option>
                        }
                    </select>
                </div>
            </div>

            @if (patient is null)
            {
                <p style="margin: 1rem 0 0;">Selecciona un paciente para abrir su historia maestra y revisar o crear nuevas evoluciones clinicas.</p>
            }
        </section>

        @if (patient is not null && editor is not null && openingSnapshot is not null)
        {
            <section class="management-card clinical-card">
                <div class="management-card-header">
                    <h2>Resumen del paciente</h2>
                    <span>@GetProgressLabel()</span>
                </div>
                <div class="clinical-header-grid" style="margin-top: 1rem;">
                    <div class="clinical-highlight">
                        <span class="eyebrow">Paciente</span>
                        <strong>@($"{openingSnapshot.Nombres} {openingSnapshot.Apellidos}")</strong>
                        <p>@openingSnapshot.Cedula</p>
                    </div>
                    <div class="clinical-highlight">
                        <span class="eyebrow">Historia</span>
                        <strong>@(string.IsNullOrWhiteSpace(editor.NumeroHistoria) ? "Pendiente" : editor.NumeroHistoria)</strong>
                        <p>@(history?.fecha_apertura?.ToString("yyyy-MM-dd HH:mm") ?? "Sin apertura previa")</p>
                    </div>
                    <div class="clinical-highlight">
                        <span class="eyebrow">Encuentro activo</span>
                        <strong>@(selectedEncounterSummary?.Status ?? (hasLegacyDataPendingMigration ? "Migracion pendiente" : "Nuevo borrador"))</strong>
                        <p>@GetEncounterDateLabel()</p>
                    </div>
                    <div class="clinical-highlight">
                        <span class="eyebrow">Progreso</span>
                        <strong>@ClinicalHistoryService.GetCompletionPercent(editor)% completado</strong>
                        <p>@GetCompletionHint()</p>
                    </div>
                </div>
            </section>

            <section class="management-card clinical-card">
                <div class="management-card-header">
                    <h2>Evoluciones del paciente</h2>
                    <span>@encounterSummaries.Count registradas</span>
                </div>
                <p class="clinical-helper-text">Cada atencion se guarda como una evolucion independiente. Puedes reabrir un borrador, revisar encuentros cerrados o iniciar una nueva evolucion sin perder la trazabilidad anterior.</p>
                <ClinicalHistoryEncounterList Encounters="encounterSummaries" SelectedEncounterId="EncounterId" LegacyLabel="legacyEncounterLabel" OnSelect="SelectEncounterAsync" />
            </section>

            <section class="management-card clinical-card">
                <div class="management-card-header">
                    <h2>Examenes y estudios</h2>
                    <span>@examTimeline.Count registrados</span>
                </div>
                <p class="clinical-helper-text">Aqui se consolidan los examenes hechos dentro de la consulta y tambien los registrados desde el modulo separado, incluso si fueron en fechas distintas.</p>
                @if (examTimeline.Count == 0)
                {
                    <p style="margin-top: 1rem;">Aun no hay examenes longitudinales registrados para este paciente.</p>
                }
                else
                {
                    <div class="management-list clinical-list-spaced">
                        @foreach (var exam in examTimeline)
                        {
                            <article class="management-list-item">
                                <strong>@exam.ExamType</strong>
                                <span>@exam.EventDate.ToString("yyyy-MM-dd")</span>
                                <span>@exam.SourceModule</span>
                                <span>@exam.ResultSummary</span>
                                @if (exam.IsAlarm)
                                {
                                    <span class="clinical-badge clinical-badge--danger">Alarma</span>
                                }
                                @if (exam.RequestedFollowUp)
                                {
                                    <span class="clinical-badge clinical-badge--warning">Requiere control</span>
                                }
                            </article>
                        }
                    </div>
                }
            </section>

            @if (alertSummaries.Count > 0)
            {
                <section class="management-card clinical-card">
                    <div class="management-card-header">
                        <h2>Alertas clinicas activas</h2>
                        <span>@alertSummaries.Count detectadas</span>
                    </div>
                    <div class="management-list clinical-list-spaced" style="margin-top: 1rem;">
                        @foreach (var alert in alertSummaries.Take(8))
                        {
                            <article class="management-list-item">
                                <strong>@alert.Title</strong>
                                <span>@alert.Category</span>
                                <span>@alert.EventDate.ToString("yyyy-MM-dd")</span>
                                <span>@(string.IsNullOrWhiteSpace(alert.Notes) ? "Sin nota adicional" : alert.Notes)</span>
                            </article>
                        }
                    </div>
                </section>
            }

            <section class="management-card clinical-card clinical-wizard-shell">
                <div class="management-card-header">
                    <h2>Diligenciamiento guiado</h2>
                    <span>Paso @activeWizardStep de @WizardSteps.Count</span>
                </div>
                <ClinicalHistoryStepNavigation ActiveStep="activeWizardStep" Steps="WizardSteps" OnSelect="GoToWizardStepAsync" />
                <p class="clinical-helper-text">@GetWizardCurrentHint()</p>
            </section>

            @if (activeWizardStep == 1)
            {
                <section class="management-card clinical-card">
                    <div class="management-card-header">
                        <h2>Apertura y control</h2>
                        <span>Datos base protegidos</span>
                    </div>
                    <div class="clinical-grid-4" style="margin-top: 1rem;">
                        <div>
                            <label class="form-label">Fecha de apertura</label>
                            <input class="form-control" value="@(history?.fecha_apertura?.ToString("yyyy-MM-dd HH:mm") ?? DateTime.Now.ToString("yyyy-MM-dd HH:mm"))" readonly />
                        </div>
                        <div>
                            <label class="form-label">Ultima actualizacion</label>
                            <input class="form-control" value="@(selectedEncounterSummary?.UpdatedAt.ToString("yyyy-MM-dd HH:mm") ?? history?.fecha_ultima_actualizacion?.ToString("yyyy-MM-dd HH:mm") ?? "Sin actualizacion")" readonly />
                        </div>
                        <div>
                            <label class="form-label">Historia clinica N.</label>
                            <input class="form-control" @bind="editor.NumeroHistoria" />
                        </div>
                        <div>
                            <label class="form-label">Consultorio</label>
                            <input class="form-control" @bind="editor.Consultorio" />
                        </div>
                        <div>
                            <label class="form-label">Llave</label>
                            <input class="form-control" @bind="editor.LlaveClinica" />
                        </div>
                        <div>
                            <label class="form-label">Lugar de nacimiento</label>
                            <input class="form-control" @bind="editor.LugarNacimiento" />
                        </div>
                        <div>
                            <label class="form-label">Procedencia</label>
                            <input class="form-control" @bind="editor.Procedencia" />
                        </div>
                        <div>
                            <label class="form-label">Ultimo control</label>
                            <input class="form-control" @bind="editor.UltimoControl" />
                        </div>
                    </div>

                    <div class="management-card-header" style="margin-top: 1.5rem;">
                        <h2>Snapshot de apertura</h2>
                        <span>Se conserva para trazabilidad</span>
                    </div>
                    <div class="clinical-grid-4" style="margin-top: 1rem;">
                        <div><label class="form-label">Apellidos</label><input class="form-control" value="@openingSnapshot.Apellidos" readonly /></div>
                        <div><label class="form-label">Nombres</label><input class="form-control" value="@openingSnapshot.Nombres" readonly /></div>
                        <div><label class="form-label">CI</label><input class="form-control" value="@openingSnapshot.Cedula" readonly /></div>
                        <div><label class="form-label">Genero</label><input class="form-control" value="@openingSnapshot.Genero" readonly /></div>
                        <div><label class="form-label">Fecha nacimiento</label><input class="form-control" value="@openingSnapshot.FechaNacimiento" readonly /></div>
                        <div><label class="form-label">Edad</label><input class="form-control" value="@openingSnapshot.Edad" readonly /></div>
                        <div><label class="form-label">Ocupacion</label><input class="form-control" value="@openingSnapshot.Ocupacion" readonly /></div>
                        <div><label class="form-label">Email</label><input class="form-control" value="@openingSnapshot.Email" readonly /></div>
                        <div class="clinical-span-2"><label class="form-label">Direccion</label><input class="form-control" value="@openingSnapshot.Direccion" readonly /></div>
                        <div><label class="form-label">Telefono</label><input class="form-control" value="@openingSnapshot.Telefono" readonly /></div>
                    </div>
                </section>
            }

            @if (activeWizardStep == 2)
            {
                <section class="management-card clinical-card">
                    <div class="management-card-header">
                        <h2>Motivo, anamnesis y antecedentes</h2>
                        <span>Contexto clinico inicial</span>
                    </div>
                    <p class="clinical-helper-text">Este paso ya no solo orienta: tambien valida el flujo clinico minimo para que la evolucion quede clara y reutilizable.</p>
                    <div class="clinical-tutorial-grid" style="margin-top: 1rem;">
                        <div class="clinical-tutorial-card">
                            <span class="eyebrow">Tutorial 1</span>
                            <strong>Define el problema real</strong>
                            <p>Selecciona motivo principal, inicio y lateralidad. Evita frases vagas o administrativas.</p>
                        </div>
                        <div class="clinical-tutorial-card">
                            <span class="eyebrow">Tutorial 2</span>
                            <strong>Mide el cuadro</strong>
                            <p>Usa duracion numerica real, intensidad y por lo menos un sintoma. Si hay riesgo, marca una alerta.</p>
                        </div>
                        <div class="clinical-tutorial-card">
                            <span class="eyebrow">Tutorial 3</span>
                            <strong>Agrega solo contexto util</strong>
                            <p>Completa desencadenantes, aliviantes y notas solo cuando aporten informacion clinica verificable.</p>
                        </div>
                    </div>
                    <div class="clinical-tutorial-warning">
                        <strong>No escribir:</strong> “revision”, “molestia”, “me duele un poco”.
                        <br />
                        <strong>Mejor:</strong> “Vision borrosa AO de inicio gradual desde hace 3 semanas, peor en pantalla, mejora con reposo”.
                    </div>
                    <div class="clinical-grid-4" style="margin-top: 1rem;">
                        <div>
                            <label class="form-label">Motivo principal</label>
                            <select class="form-select" @bind="editor.AnamnesisGuiada.MotivoPrincipal">
                                <option value="">Selecciona</option>
                                @foreach (var option in MainComplaintOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="form-label">Inicio</label>
                            <select class="form-select" @bind="editor.AnamnesisGuiada.Inicio">
                                <option value="">Selecciona</option>
                                @foreach (var option in OnsetOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="form-label">Duracion</label>
                            <input class="form-control" @bind="editor.AnamnesisGuiada.DuracionValor" inputmode="numeric" pattern="[0-9]*" maxlength="4" placeholder="Ej. 3" />
                        </div>
                        <div>
                            <label class="form-label">Unidad</label>
                            <select class="form-select" @bind="editor.AnamnesisGuiada.DuracionUnidad">
                                @foreach (var option in DurationUnitOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="form-label">Lateralidad</label>
                            <select class="form-select" @bind="editor.AnamnesisGuiada.Lateralidad">
                                <option value="">Selecciona</option>
                                @foreach (var option in LateralityOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="form-label">Intensidad</label>
                            <select class="form-select" @bind="editor.AnamnesisGuiada.Intensidad">
                                <option value="">Selecciona</option>
                                @foreach (var option in IntensityOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </div>
                        <div class="clinical-span-2">
                            <label class="form-label">Desencadenantes</label>
                            <input class="form-control" @bind="editor.AnamnesisGuiada.Desencadenantes" maxlength="120" placeholder="Pantallas, lectura, polvo, sol..." />
                        </div>
                        <div class="clinical-span-2">
                            <label class="form-label">Aliviantes</label>
                            <input class="form-control" @bind="editor.AnamnesisGuiada.Aliviantes" maxlength="120" placeholder="Reposo, lubricantes, lentes..." />
                        </div>
                    </div>

                    <div class="clinical-grid-2" style="margin-top: 1rem;">
                        <div>
                            <label class="form-label">Sintomas frecuentes</label>
                            <div class="clinical-chip-wrap">
                                @foreach (var option in SymptomOptions)
                                {
                                    <button type="button" class="@GetChipClass(editor.AnamnesisGuiada.Sintomas.Contains(option))" @onclick="() => ToggleAnamnesisItem(editor.AnamnesisGuiada.Sintomas, option)">
                                        @option
                                    </button>
                                }
                            </div>
                        </div>
                        <div>
                            <label class="form-label">Banderas de alerta</label>
                            <div class="clinical-chip-wrap">
                                @foreach (var option in RedFlagOptions)
                                {
                                    <button type="button" class="@GetChipClass(editor.AnamnesisGuiada.BanderasAlerta.Contains(option), true)" @onclick="() => ToggleAnamnesisItem(editor.AnamnesisGuiada.BanderasAlerta, option)">
                                        @option
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="clinical-stack">
                        <div>
                            <label class="form-label">Motivo de consulta</label>
                            <textarea class="form-control" rows="3" maxlength="220" @bind="editor.MotivoConsulta" placeholder="Describe el motivo de consulta de forma precisa"></textarea>
                        </div>
                        <div>
                            <label class="form-label">Anamnesis</label>
                            <textarea class="form-control" rows="5" maxlength="1200" @bind="editor.Anamnesis" placeholder="Agrega solo datos clinicos verificables si necesitas ampliar"></textarea>
                        </div>
                        <div>
                            <label class="form-label">Notas adicionales de anamnesis guiada</label>
                            <textarea class="form-control" rows="3" maxlength="400" @bind="editor.AnamnesisGuiada.NotasAdicionales" placeholder="Usa este espacio solo para precisar lo que no cubren los selectores"></textarea>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(GetStructuredAnamnesisPreview()))
                    {
                        <div class="clinical-preview-card">
                            <span class="eyebrow">Resumen guiado</span>
                            <p>@GetStructuredAnamnesisPreview()</p>
                        </div>
                    }

                    <div class="clinical-grid-2" style="margin-top: 1rem;">
                        <div>
                            <label class="form-label">Personales oculares</label>
                            <textarea class="form-control" rows="4" @bind="editor.Antecedentes.PersonalesOculares"></textarea>
                        </div>
                        <div>
                            <label class="form-label">Personales generales</label>
                            <textarea class="form-control" rows="4" @bind="editor.Antecedentes.PersonalesGenerales"></textarea>
                        </div>
                        <div>
                            <label class="form-label">Familiares oculares</label>
                            <textarea class="form-control" rows="4" @bind="editor.Antecedentes.FamiliaresOculares"></textarea>
                        </div>
                        <div>
                            <label class="form-label">Familiares generales</label>
                            <textarea class="form-control" rows="4" @bind="editor.Antecedentes.FamiliaresGenerales"></textarea>
                        </div>
                    </div>
                </section>

        <section class="management-card clinical-card">
            <div class="management-card-header">
                <h2>Lensometria y agudeza visual</h2>
                <span>Lectura base y vision</span>
            </div>
            <p class="clinical-helper-text">Este bloque sirve para registrar con que llega el paciente y como esta viendo antes de la refraccion final.</p>
            <div class="clinical-grid-4" style="margin-top: 1rem;">
                <div><label class="form-label">Usa lentes</label><input type="checkbox" class="form-check-input" style="margin-left:0.2rem;" @bind="editor.UsaLentes" /></div>
                <div><label class="form-label">ADD</label><input class="form-control" @bind="editor.Lentes.Addicion" /></div>
                <div><label class="form-label">Prismas</label><input class="form-control" @bind="editor.Lentes.Prismas" /></div>
                <div><label class="form-label">Dist. pupilar</label><input class="form-control" @bind="editor.Lentes.DistPupilar" /></div>
                <div><label class="form-label">Ojo derecho</label><input class="form-control" @bind="editor.Lentes.Od" /></div>
                <div><label class="form-label">Ojo izquierdo</label><input class="form-control" @bind="editor.Lentes.Oi" /></div>
                <div><label class="form-label">Ambos ojos</label><input class="form-control" @bind="editor.Lentes.Ao" /></div>
                <div><label class="form-label">Tipo de lente</label><input class="form-control" @bind="editor.Lentes.TipoLente" /></div>
                <div><label class="form-label">Material</label><input class="form-control" @bind="editor.Lentes.Material" /></div>
                <div><label class="form-label">Filtro</label><input class="form-control" @bind="editor.Lentes.Filtro" /></div>
                <div><label class="form-label">Tiempo de uso RX</label><input class="form-control" @bind="editor.Lentes.TiempoUsoRx" /></div>
                <div class="clinical-span-4"><label class="form-label">Observaciones del lente</label><textarea class="form-control" rows="3" @bind="editor.Lentes.Observaciones"></textarea></div>
            </div>
            <div class="clinical-grid-4" style="margin-top: 1rem;">
                <div><label class="form-label">Agudeza visual lejos sin correccion - ojo derecho</label><input class="form-control" @bind="editor.Visual.OdVlSc" /></div>
                <div><label class="form-label">Agudeza visual lejos sin correccion - ojo izquierdo</label><input class="form-control" @bind="editor.Visual.OiVlSc" /></div>
                <div><label class="form-label">Agudeza visual lejos sin correccion - ambos ojos</label><input class="form-control" @bind="editor.Visual.AoVlSc" /></div>
                <div><label class="form-label">PH</label><input class="form-control" @bind="editor.Visual.Ph" /></div>
                <div><label class="form-label">Agudeza visual cerca sin correccion - ojo derecho</label><input class="form-control" @bind="editor.Visual.OdVpSc" /></div>
                <div><label class="form-label">Agudeza visual cerca sin correccion - ojo izquierdo</label><input class="form-control" @bind="editor.Visual.OiVpSc" /></div>
                <div><label class="form-label">Agudeza visual cerca sin correccion - ambos ojos</label><input class="form-control" @bind="editor.Visual.AoVpSc" /></div>
                <div><label class="form-label">Dominancia</label><input class="form-control" @bind="editor.Visual.Dominancia" /></div>
                <div><label class="form-label">Optotipo</label><input class="form-control" @bind="editor.Visual.Optotipo" /></div>
                <div><label class="form-label">Distancia VL</label><input class="form-control" @bind="editor.Visual.DistanciaVl" /></div>
                <div><label class="form-label">Distancia VP</label><input class="form-control" @bind="editor.Visual.DistanciaVp" /></div>
            </div>
        </section>
            }

            @if (activeWizardStep == 3)
            {
                <section class="management-card clinical-card">
                    <div class="management-card-header">
                        <h2>Examen externo / biomicroscopia</h2>
                        <span>Grafico ocular y hallazgos</span>
                    </div>
                    <div class="clinical-grid-2" style="margin-top: 1rem;">
                        <EyeDiagramEditor Label="OD" @bind-Value="editor.Biomicroscopia.GraphicOd" />
                        <EyeDiagramEditor Label="OI" @bind-Value="editor.Biomicroscopia.GraphicOi" />
                    </div>
                    <div class="clinical-odoi-grid">
                        <div class="clinical-odoi-head">Hallazgo</div>
                        <div class="clinical-odoi-head">OD</div>
                        <div class="clinical-odoi-head">OI</div>
                        <div class="clinical-odoi-label">Orbita / cejas</div>
                        <input class="form-control" @bind="editor.Biomicroscopia.OrbitaOd" />
                        <input class="form-control" @bind="editor.Biomicroscopia.OrbitaOi" />
                        <div class="clinical-odoi-label">Parpados / pestanas</div>
                        <input class="form-control" @bind="editor.Biomicroscopia.ParpadosOd" />
                        <input class="form-control" @bind="editor.Biomicroscopia.ParpadosOi" />
                        <div class="clinical-odoi-label">Sistema lagrimal</div>
                        <input class="form-control" @bind="editor.Biomicroscopia.SistemaLagrimalOd" />
                        <input class="form-control" @bind="editor.Biomicroscopia.SistemaLagrimalOi" />
                        <div class="clinical-odoi-label">Conjuntiva / esclera</div>
                        <input class="form-control" @bind="editor.Biomicroscopia.ConjuntivaOd" />
                        <input class="form-control" @bind="editor.Biomicroscopia.ConjuntivaOi" />
                        <div class="clinical-odoi-label">Cornea / camara anterior</div>
                        <input class="form-control" @bind="editor.Biomicroscopia.CorneaOd" />
                        <input class="form-control" @bind="editor.Biomicroscopia.CorneaOi" />
                        <div class="clinical-odoi-label">Iris / pupila</div>
                        <input class="form-control" @bind="editor.Biomicroscopia.IrisOd" />
                        <input class="form-control" @bind="editor.Biomicroscopia.IrisOi" />
                        <div class="clinical-odoi-label">Cristalino</div>
                        <input class="form-control" @bind="editor.Biomicroscopia.CristalinoOd" />
                        <input class="form-control" @bind="editor.Biomicroscopia.CristalinoOi" />
                        <div class="clinical-odoi-label">Test adicionales</div>
                        <input class="form-control" @bind="editor.Biomicroscopia.TestAdicionalesOd" />
                        <input class="form-control" @bind="editor.Biomicroscopia.TestAdicionalesOi" />
                    </div>
                </section>

                <section class="management-card clinical-card">
                    <div class="management-card-header">
                        <h2>Oftalmoscopia</h2>
                        <span>Fondo de ojo y hallazgos</span>
                    </div>
                    <div class="clinical-grid-2" style="margin-top: 1rem;">
                        <EyeDiagramEditor Label="OD" @bind-Value="editor.Oftalmoscopia.GraphicOd" />
                        <EyeDiagramEditor Label="OI" @bind-Value="editor.Oftalmoscopia.GraphicOi" />
                    </div>
                    <div class="clinical-odoi-grid">
                        <div class="clinical-odoi-head">Hallazgo</div>
                        <div class="clinical-odoi-head">OD</div>
                        <div class="clinical-odoi-head">OI</div>
                        <div class="clinical-odoi-label">Papila / excavacion</div>
                        <input class="form-control" @bind="editor.Oftalmoscopia.PapilaOd" />
                        <input class="form-control" @bind="editor.Oftalmoscopia.PapilaOi" />
                        <div class="clinical-odoi-label">Vasos / arteria / vena</div>
                        <input class="form-control" @bind="editor.Oftalmoscopia.VasosOd" />
                        <input class="form-control" @bind="editor.Oftalmoscopia.VasosOi" />
                        <div class="clinical-odoi-label">Macula / fijacion</div>
                        <input class="form-control" @bind="editor.Oftalmoscopia.MaculaOd" />
                        <input class="form-control" @bind="editor.Oftalmoscopia.MaculaOi" />
                        <div class="clinical-odoi-label">Tapete / regularidad y color</div>
                        <input class="form-control" @bind="editor.Oftalmoscopia.TapeteOd" />
                        <input class="form-control" @bind="editor.Oftalmoscopia.TapeteOi" />
                    </div>
                </section>

                <section class="management-card clinical-card">
                    <div class="management-card-header">
                        <h2>Examen motor y refraccion</h2>
                        <span>Bloques tecnicos</span>
                    </div>
                    <div class="clinical-grid-2" style="margin-top: 1rem;">
                        <div>
                            <label class="form-label">Examen motor</label>
                            <textarea class="form-control" rows="8" @bind="editor.Motor.Resumen"></textarea>
                        </div>
                        <div>
                            <label class="form-label">Ducciones / versiones / Maddox / Worth</label>
                            <textarea class="form-control" rows="8" @bind="editor.Motor.HallazgosComplementarios"></textarea>
                        </div>
                        <div>
                            <label class="form-label">Queratometria y miras</label>
                            <textarea class="form-control" rows="6" @bind="editor.Keratometria.Resumen"></textarea>
                        </div>
                        <div>
                            <label class="form-label">Astigmatismo corneal</label>
                            <textarea class="form-control" rows="6" @bind="editor.Keratometria.AstigmatismoCorneal"></textarea>
                        </div>
                    </div>

                    <div class="clinical-grid-2" style="margin-top: 1rem;">
                        <div>
                            <label class="form-label">RX estatica y dinamica</label>
                            <textarea class="form-control" rows="8" @bind="editor.Refraction.RxEstaticaDinamica"></textarea>
                        </div>
                        <div>
                            <label class="form-label">Subjetivo, afinacion y balance binocular</label>
                            <textarea class="form-control" rows="8" @bind="editor.Refraction.SubjetivoAfinacionBalance"></textarea>
                        </div>
                        <div>
                            <label class="form-label">Prueba ambulatoria y RX final</label>
                            <textarea class="form-control" rows="8" @bind="editor.Refraction.PruebaAmbulatoriaRxFinal"></textarea>
                        </div>
                        <div>
                            <label class="form-label">Observaciones tecnicas</label>
                            <textarea class="form-control" rows="8" @bind="editor.Refraction.Observaciones"></textarea>
                        </div>
                    </div>
                </section>

                <section class="management-card clinical-card">
                    <div class="management-card-header">
                        <h2>Registro longitudinal de examenes</h2>
                        <span>@editor.ExamenesClinicos.Count en este encuentro</span>
                    </div>
                    <p class="clinical-helper-text">Usa esta seccion cuando en una misma historia se agregan varios examenes en consultas o fechas distintas. Tambien puedes completarlos luego desde el modulo de examenes.</p>
                    <div class="clinical-stack" style="margin-top: 1rem;">
                        @foreach (var exam in editor.ExamenesClinicos.Select((value, index) => new { value, index }))
                        {
                            <div class="clinical-grid-4 clinical-inline-card">
                                <div>
                                    <label class="form-label">Tipo</label>
                                    <select class="form-select" @bind="exam.value.TipoExamen">
                                        <option value="">Selecciona</option>
                                        @foreach (var option in ClinicalExamTypeOptions)
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label">Fecha</label>
                                    <input type="date" class="form-control" value="@FormatDateInput(exam.value.FechaExamen)" @onchange="args => OnExamDateChanged(exam.index, args)" />
                                </div>
                                <div>
                                    <label class="form-label">Origen</label>
                                    <select class="form-select" @bind="exam.value.ModuloOrigen">
                                        <option value="Historia clinica">Historia clinica</option>
                                        <option value="Modulo de examenes">Modulo de examenes</option>
                                        <option value="Externo">Externo</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label">Profesional</label>
                                    <input class="form-control" @bind="exam.value.ProfesionalResponsable" maxlength="120" />
                                </div>
                                <div class="clinical-span-2">
                                    <label class="form-label">Motivo / solicitud</label>
                                    <input class="form-control" @bind="exam.value.MotivoRegistro" maxlength="180" />
                                </div>
                                <div class="clinical-span-2">
                                    <label class="form-label">Resultado resumido</label>
                                    <input class="form-control" @bind="exam.value.ResultadoResumen" maxlength="220" />
                                </div>
                                <div class="clinical-span-3">
                                    <label class="form-label">Detalle / interpretacion</label>
                                    <textarea class="form-control" rows="3" @bind="exam.value.DetalleResultados"></textarea>
                                </div>
                                <div>
                                    <label class="form-label">Resultado alarmante</label>
                                    <div class="form-check form-switch" style="margin-top: 0.45rem;">
                                        <input class="form-check-input" type="checkbox" @bind="exam.value.EsResultadoAlarmante" />
                                    </div>
                                </div>
                                <div class="clinical-span-3">
                                    <label class="form-label">Notas de alarma / accion</label>
                                    <input class="form-control" @bind="exam.value.NotasAlarma" maxlength="220" />
                                </div>
                                <div>
                                    <label class="form-label">Seguimiento</label>
                                    <div class="form-check form-switch" style="margin-top: 0.45rem;">
                                        <input class="form-check-input" type="checkbox" @bind="exam.value.RequiereSeguimiento" />
                                    </div>
                                </div>
                                <div class="clinical-span-4">
                                    <button type="button" class="btn btn-outline-primary" @onclick="() => RemoveClinicalExamRecord(exam.index)">Quitar examen</button>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="workspace-actions" style="margin-top: 0.85rem;">
                        <button type="button" class="btn btn-outline-primary" @onclick="AddClinicalExamRecord">Agregar examen al encuentro</button>
                        <a class="btn btn-outline-primary" href="@GetExamModuleUrl()">Abrir modulo separado</a>
                    </div>
                </section>
            }

            @if (activeWizardStep == 4)
            {
                <section class="management-card clinical-card">
                    <div class="management-card-header">
                        <h2>Diagnostico y conducta</h2>
                        <span>Cierre clinico del encuentro</span>
                    </div>
                    <div class="clinical-grid-4" style="margin-top: 1rem;">
                        <div class="clinical-span-3"><label class="form-label">Diagnostico OD</label><input class="form-control" @bind="editor.Diagnostico.DiagnosticoOd" /></div>
                        <div><label class="form-label">CIE10</label><input class="form-control" @bind="editor.Diagnostico.Cie10" /></div>
                        <div class="clinical-span-2"><label class="form-label">Diagnostico OI</label><input class="form-control" @bind="editor.Diagnostico.DiagnosticoOi" /></div>
                        <div class="clinical-span-2"><label class="form-label">Motor</label><input class="form-control" @bind="editor.Diagnostico.DiagnosticoMotor" /></div>
                        <div class="clinical-span-4"><label class="form-label">Patologico presuntivo</label><textarea class="form-control" rows="3" @bind="editor.Diagnostico.PatologicoPresuntivo"></textarea></div>
                        <div class="clinical-span-4"><label class="form-label">Tratamiento / disposicion / conducta</label><textarea class="form-control" rows="4" @bind="editor.Diagnostico.TratamientoConducta"></textarea></div>
                        <div class="clinical-span-4"><label class="form-label">Examenes indicados para facturacion</label><textarea class="form-control" rows="3" @bind="editor.Diagnostico.ExamenesIndicados"></textarea></div>
                        <div class="clinical-span-4"><label class="form-label">Medicamentos recetados para facturacion</label><textarea class="form-control" rows="3" @bind="editor.Diagnostico.MedicamentosRecetados"></textarea></div>
                        <div class="clinical-span-4" style="padding: 1rem; border: 1px solid rgba(127,105,81,0.12); border-radius: 1rem; background: rgba(255,255,255,0.68);">
                            <div class="management-card-header" style="margin-bottom: 0.75rem;">
                                <h2>Receta medica estructurada</h2>
                                <span>Se guarda como receta y cruza stock para facturacion</span>
                            </div>
                            <p class="clinical-helper-text">Agrega aqui lo realmente prescrito. Si eliges un producto existente y activas facturacion, el sistema solo lo llevara a factura cuando sea facturable y, si es un bien, tenga stock suficiente.</p>
                            <div class="clinical-stack">
                                @foreach (var item in editor.Diagnostico.PrescripcionItems.Select((value, index) => new { value, index }))
                                {
                                    <div class="clinical-grid-4" style="padding: 0.85rem; border: 1px dashed rgba(127,105,81,0.18); border-radius: 0.9rem;">
                                        <div>
                                            <label class="form-label">Tipo</label>
                                            <select class="form-select" @bind="item.value.TipoItem">
                                                @foreach (var option in PrescriptionTypeOptions)
                                                {
                                                    <option value="@option">@option</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="clinical-span-2">
                                            <label class="form-label">Producto relacionado</label>
                                            <select class="form-select" value="@item.value.ProductoId" @onchange="args => OnPrescriptionProductChanged(item.index, args)">
                                                <option value="0">Escribir manualmente</option>
                                                @foreach (var product in AvailablePrescriptionProducts)
                                                {
                                                    <option value="@product.id_producto">@GetPrescriptionProductLabel(product)</option>
                                                }
                                            </select>
                                        </div>
                                        <div>
                                            <label class="form-label">Facturar</label>
                                            <div class="form-check form-switch" style="margin-top: 0.45rem;">
                                                <input class="form-check-input" type="checkbox" @bind="item.value.EnviarAFacturacion" />
                                            </div>
                                        </div>
                                        <div class="clinical-span-2">
                                            <label class="form-label">Nombre prescrito</label>
                                            <input class="form-control" @bind="item.value.NombreItem" maxlength="200" />
                                        </div>
                                        <div>
                                            <label class="form-label">Cantidad</label>
                                            <input type="number" min="1" class="form-control" @bind="item.value.Cantidad" />
                                        </div>
                                        <div>
                                            <label class="form-label">Unidad</label>
                                            <input class="form-control" @bind="item.value.Unidad" maxlength="40" />
                                        </div>
                                        <div class="clinical-span-3">
                                            <label class="form-label">Indicaciones</label>
                                            <input class="form-control" @bind="item.value.Indicaciones" maxlength="500" placeholder="Dosis, frecuencia, observaciones de uso o preparacion" />
                                        </div>
                                        <div>
                                            <label class="form-label">Quitar</label>
                                            <button type="button" class="btn btn-outline-primary" style="width:100%;" @onclick="() => RemovePrescriptionItem(item.index)">Eliminar</button>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="workspace-actions" style="margin-top: 0.85rem;">
                                <button type="button" class="btn btn-outline-primary" @onclick="AddPrescriptionItem">Agregar item a receta</button>
                            </div>
                        </div>
                        <div class="clinical-span-4"><label class="form-label">Observaciones generales</label><textarea class="form-control" rows="4" @bind="editor.ObservacionesGenerales"></textarea></div>
                        <div class="clinical-span-2"><label class="form-label">Nombre del examinador</label><input class="form-control" @bind="editor.NombreExaminador" /></div>
                        <div class="clinical-span-2"><label class="form-label">Nivel paralelo y jornada</label><input class="form-control" @bind="editor.NivelParaleloJornada" /></div>
                    </div>
                </section>

                <section class="management-card clinical-card">
                    <div class="management-card-header">
                        <h2>Seguimiento y nueva cita</h2>
                        <span>@(editor.Seguimiento.RequiereNuevaCita ? "Pendiente de agendar" : "Sin control pendiente")</span>
                    </div>
                    <div class="clinical-grid-4" style="margin-top: 1rem;">
                        <div>
                            <label class="form-label">Requiere nueva cita</label>
                            <div class="form-check form-switch" style="margin-top: 0.45rem;">
                                <input class="form-check-input" type="checkbox" @bind="editor.Seguimiento.RequiereNuevaCita" />
                            </div>
                        </div>
                        <div>
                            <label class="form-label">Prioridad</label>
                            <select class="form-select" @bind="editor.Seguimiento.Prioridad">
                                @foreach (var option in FollowUpPriorityOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="form-label">Dias sugeridos</label>
                            <input type="number" min="1" max="365" class="form-control" @bind="editor.Seguimiento.DiasSugeridos" />
                        </div>
                        <div>
                            <label class="form-label">Accion</label>
                            <a class="btn btn-outline-primary" style="width:100%;" href="@GetAppointmentPrefillUrl()">Agendar control</a>
                        </div>
                        <div class="clinical-span-2">
                            <label class="form-label">Motivo de seguimiento</label>
                            <input class="form-control" @bind="editor.Seguimiento.Motivo" maxlength="220" />
                        </div>
                        <div class="clinical-span-2">
                            <label class="form-label">Observaciones</label>
                            <textarea class="form-control" rows="3" @bind="editor.Seguimiento.Observaciones"></textarea>
                        </div>
                    </div>
                    @if (followUpSummaries.Count > 0)
                    {
                        <div class="clinical-preview-card" style="margin-top: 1rem;">
                            <span class="eyebrow">Controles previos</span>
                            <p>@string.Join(" | ", followUpSummaries.Take(3).Select(x => $"{x.EventDate:yyyy-MM-dd}: {x.Priority} - {x.Reason}"))</p>
                        </div>
                    }
                </section>
            }

            @if (activeWizardStep == 5)
            {
                <section class="management-card clinical-card">
                    <div class="management-card-header">
                        <h2>Consentimiento informado</h2>
                        <span>Cierre seguro</span>
                    </div>
                    <p class="clinical-helper-text">El cierre ya no invalida la firma por salir de este paso. La captura solo se actualiza cuando realmente la editas o limpias.</p>
                    <div class="clinical-grid-4" style="margin-top: 1rem;">
                        <div class="clinical-span-2"><label class="form-label">Yo,</label><input class="form-control" @bind="editor.Consentimiento.Nombre" /></div>
                        <div><label class="form-label">CC</label><input class="form-control" @bind="editor.Consentimiento.Cedula" /></div>
                        <div><label class="form-label">Firma / referencia</label><input class="form-control" @bind="editor.Consentimiento.FirmaReferencia" /></div>
                        <div class="clinical-span-4">
                            <label class="form-label">Texto de consentimiento</label>
                            <textarea class="form-control" rows="4" @bind="editor.Consentimiento.Texto"></textarea>
                        </div>
                        <div>
                            <label class="form-label">Autoriza</label>
                            <input type="checkbox" class="form-check-input" style="margin-left:0.2rem;" @bind="editor.Consentimiento.Autorizado" />
                        </div>
                        <div class="clinical-span-4">
                            <label class="form-label">Firma dibujada</label>
                            <div class="clinical-signature-shell">
                                <canvas id="@SignatureCanvasId" class="clinical-signature-pad"></canvas>
                                <div class="workspace-actions clinical-signature-actions">
                                    <button type="button" class="btn btn-outline-primary" @onclick="ClearSignatureAsync">Limpiar firma</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            }

            <section class="management-card clinical-card clinical-wizard-footer">
                <div class="clinical-wizard-footer-copy">
                    <strong>@WizardSteps[activeWizardStep - 1].Title</strong>
                    <p>@GetWizardCurrentHint()</p>
                </div>
                <div class="workspace-actions">
                    @if (activeWizardStep > 1)
                    {
                        <button type="button" class="btn btn-outline-primary" @onclick="GoToPreviousWizardStep">Paso anterior</button>
                    }
                    @if (activeWizardStep < WizardSteps.Count)
                    {
                        <button type="button" class="btn btn-primary" @onclick="GoToNextWizardStepAsync">Siguiente paso</button>
                    }
                    <button type="button" class="btn btn-outline-primary" @onclick="SaveDraftAsync">Guardar borrador</button>
                    @if (activeWizardStep == WizardSteps.Count)
                    {
                        <button type="button" class="btn btn-primary" @onclick="FinalizeAsync">Cerrar y guardar historia</button>
                    }
                </div>
            </section>
        }
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "patientId")]
    public int? PatientId { get; set; }

    [SupplyParameterFromQuery(Name = "encounterId")]
    public int? EncounterId { get; set; }

    private readonly List<tbl_paciente> availablePatients = [];
    private readonly List<tbl_producto> prescriptionProducts = [];
    private readonly List<string> validationMessages = [];
    private static readonly string[] MainComplaintOptions = ["Vision borrosa", "Ardor ocular", "Ojo rojo", "Dolor ocular", "Cefalea", "Diplopia", "Fotofobia", "Control visual", "Adaptacion de lentes", "Otro (especificar)"];
    private static readonly string[] OnsetOptions = ["Sudito", "Gradual", "Intermitente", "Recurrente", "Post-trauma"];
    private static readonly string[] DurationUnitOptions = ["horas", "dias", "semanas", "meses", "anios"];
    private static readonly string[] LateralityOptions = ["OD", "OI", "AO", "Alternante"];
    private static readonly string[] IntensityOptions = ["Leve", "Moderada", "Severa", "10/10"];
    private static readonly string[] SymptomOptions = ["Vision borrosa", "Prurito", "Lagrimeo", "Cefalea", "Fotofobia", "Diplopia", "Cuerpo extrano", "Secrecion", "Moscas volantes", "Destellos"];
    private static readonly string[] RedFlagOptions = ["Dolor intenso", "Perdida subita de vision", "Trauma", "Destellos nuevos", "Moscas volantes nuevas", "Diplopia aguda", "Ojo rojo severo", "Cefalea intensa"];
    private static readonly string[] PrescriptionTypeOptions = ["Medicamento", "Examen", "Insumo"];
    private static readonly string[] ClinicalExamTypeOptions = ["Tonometria", "Campimetria", "Topografia corneal", "Retinografia", "OCT", "Paquimetria", "Biometria", "Prueba de color", "Test lagrimal", "Otro"];
    private static readonly string[] FollowUpPriorityOptions = ["Control", "Preferente", "Urgente"];
    private static readonly IReadOnlyList<ClinicalHistoryStepNavigation.ClinicalStepDefinition> WizardSteps = new[]
    {
        new ClinicalHistoryStepNavigation.ClinicalStepDefinition(1, "Apertura", "Historia maestra y control del paciente."),
        new ClinicalHistoryStepNavigation.ClinicalStepDefinition(2, "Consulta inicial", "Motivo, anamnesis, antecedentes y vision."),
        new ClinicalHistoryStepNavigation.ClinicalStepDefinition(3, "Hallazgos", "Biomicroscopia, oftalmoscopia y refraccion."),
        new ClinicalHistoryStepNavigation.ClinicalStepDefinition(4, "Diagnostico", "Conclusion clinica y conducta."),
        new ClinicalHistoryStepNavigation.ClinicalStepDefinition(5, "Consentimiento", "Autorizacion, firma y cierre.")
    };

    private tbl_paciente? patient;
    private tbl_historia_clinica_optometria? history;
    private OpeningSnapshot? openingSnapshot;
    private ClinicalHistoryEditorModel? editor;
    private List<ClinicalEncounterSummary> encounterSummaries = [];
    private List<ClinicalExamTimelineItem> examTimeline = [];
    private List<ClinicalAlertSummary> alertSummaries = [];
    private List<ClinicalFollowUpSummary> followUpSummaries = [];
    private ClinicalEncounterSummary? selectedEncounterSummary;
    private bool hasLegacyDataPendingMigration;
    private string? legacyEncounterLabel;
    private bool isLoading = true;
    private bool canViewModule;
    private int currentUserId;
    private int currentRoleId;
    private int activeWizardStep = 1;
    private bool shouldInitializeSignaturePad;
    private string? statusMessage;
    private string? errorMessage;
    private string patientSearchTerm = string.Empty;
    private string SignatureCanvasId => "clinical-signature-pad";
    private IEnumerable<tbl_producto> AvailablePrescriptionProducts => prescriptionProducts.OrderBy(x => x.nombre_producto).ThenBy(x => x.codigo_producto);
    private IEnumerable<tbl_paciente> FilteredPatients => string.IsNullOrWhiteSpace(patientSearchTerm)
        ? availablePatients.Take(200)
        : availablePatients.Where(x =>
                GetPatientOptionLabel(x).Contains(patientSearchTerm, StringComparison.OrdinalIgnoreCase))
            .Take(200);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!shouldInitializeSignaturePad || editor is null)
        {
            return;
        }

        shouldInitializeSignaturePad = false;
        await JSRuntime.InvokeVoidAsync("optometriaClinicalSignature.init", SignatureCanvasId, editor.Consentimiento.FirmaDibujada);
    }

    private async Task LoadAsync(bool preserveStatus = false)
    {
        isLoading = true;
        errorMessage = null;
        validationMessages.Clear();

        if (!preserveStatus)
        {
            statusMessage = null;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier), out var userId) ? userId : 0;
        currentRoleId = int.TryParse(authState.User.FindFirstValue("RoleId"), out var roleId) ? roleId : 0;

        if (currentUserId <= 0)
        {
            canViewModule = false;
            isLoading = false;
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        canViewModule = await CanViewHistoryModuleAsync(dbContext);

        if (!canViewModule)
        {
            isLoading = false;
            return;
        }

        availablePatients.Clear();
        availablePatients.AddRange(await dbContext.tbl_pacientes
            .AsNoTracking()
            .OrderBy(x => x.apellidos)
            .ThenBy(x => x.nombres)
            .ToListAsync());

        prescriptionProducts.Clear();
        prescriptionProducts.AddRange(await dbContext.tbl_productos
            .AsNoTracking()
            .Where(x => x.activo == true)
            .OrderBy(x => x.nombre_producto)
            .ToListAsync());

        if (!PatientId.HasValue || PatientId.Value <= 0)
        {
            ResetPatientContext();
            isLoading = false;
            return;
        }

        patient = await dbContext.tbl_pacientes
            .AsNoTracking()
            .FirstOrDefaultAsync(x => x.id_paciente == PatientId.Value);

        if (patient is null)
        {
            ResetPatientContext();
            errorMessage = "No se encontro el paciente seleccionado.";
            isLoading = false;
            return;
        }

        patientSearchTerm = GetPatientOptionLabel(patient);

        var loadResult = await ClinicalHistoryService.LoadPatientHistoryAsync(dbContext, patient, EncounterId);
        history = loadResult.History;
        openingSnapshot = loadResult.OpeningSnapshot;
        editor = loadResult.Editor;
        encounterSummaries = loadResult.Encounters;
        examTimeline = loadResult.ExamTimeline;
        alertSummaries = loadResult.AlertSummaries;
        followUpSummaries = loadResult.FollowUpSummaries;
        selectedEncounterSummary = loadResult.SelectedEncounter;
        hasLegacyDataPendingMigration = loadResult.HasLegacyDataPendingMigration;
        legacyEncounterLabel = loadResult.LegacyEncounterLabel;
        activeWizardStep = 1;
        shouldInitializeSignaturePad = false;
        isLoading = false;
    }

    private async Task OnPatientChangedAsync(ChangeEventArgs args)
    {
        var rawValue = args.Value?.ToString();
        PatientId = int.TryParse(rawValue, out var parsedPatientId) && parsedPatientId > 0
            ? parsedPatientId
            : null;
        EncounterId = null;

        NavigationManager.NavigateTo(
            NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                ["patientId"] = PatientId,
                ["encounterId"] = null
            }),
            forceLoad: false);

        await LoadAsync();
    }

    private async Task SelectEncounterAsync(int encounterId)
    {
        EncounterId = encounterId;
        NavigationManager.NavigateTo(
            NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                ["patientId"] = PatientId,
                ["encounterId"] = EncounterId
            }),
            forceLoad: false);

        await LoadAsync();
    }

    private async Task StartNewEncounterAsync()
    {
        if (patient is null)
        {
            return;
        }

        var seededEditor = ClinicalHistoryService.BuildNewEditor(patient);
        if (editor is not null)
        {
            seededEditor.NumeroHistoria = string.IsNullOrWhiteSpace(editor.NumeroHistoria) ? seededEditor.NumeroHistoria : editor.NumeroHistoria;
            seededEditor.Consultorio = editor.Consultorio;
            seededEditor.LlaveClinica = editor.LlaveClinica;
            seededEditor.LugarNacimiento = editor.LugarNacimiento;
            seededEditor.Procedencia = editor.Procedencia;
            seededEditor.UltimoControl = editor.UltimoControl;
        }

        editor = seededEditor;
        EncounterId = null;
        selectedEncounterSummary = null;
        hasLegacyDataPendingMigration = false;
        legacyEncounterLabel = null;
        validationMessages.Clear();
        errorMessage = null;
        statusMessage = "Se abrio una nueva evolucion en borrador.";
        activeWizardStep = 1;
        shouldInitializeSignaturePad = false;

        NavigationManager.NavigateTo(
            NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                ["patientId"] = PatientId,
                ["encounterId"] = null
            }),
            forceLoad: false);

        await InvokeAsync(StateHasChanged);
    }

    private async Task GoToWizardStepAsync(int step)
    {
        if (editor is null)
        {
            return;
        }

        if (step > activeWizardStep)
        {
            var errors = ClinicalHistoryService.ValidateStep(editor, activeWizardStep);
            if (errors.Count > 0)
            {
                validationMessages.Clear();
                validationMessages.AddRange(errors);
                return;
            }
        }

        validationMessages.Clear();
        activeWizardStep = Math.Min(Math.Max(step, 1), WizardSteps.Count);

        if (activeWizardStep == WizardSteps.Count)
        {
            shouldInitializeSignaturePad = true;
        }

        await InvokeAsync(StateHasChanged);
    }

    private Task GoToPreviousWizardStep()
        => GoToWizardStepAsync(activeWizardStep - 1);

    private Task GoToNextWizardStepAsync()
        => GoToWizardStepAsync(activeWizardStep + 1);

    private async Task SaveDraftAsync()
        => await SaveAsync(ClinicalHistorySaveMode.Draft);

    private async Task FinalizeAsync()
        => await SaveAsync(ClinicalHistorySaveMode.Finalize);

    private async Task SaveAsync(ClinicalHistorySaveMode mode)
    {
        errorMessage = null;
        validationMessages.Clear();

        if (patient is null || editor is null || openingSnapshot is null)
        {
            errorMessage = "No existe un paciente valido para guardar la historia clinica.";
            return;
        }

        editor.Consentimiento.FirmaDibujada = await CaptureSignatureAsync();

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var result = await ClinicalHistoryService.SaveAsync(
            dbContext,
            new ClinicalHistorySaveRequest
            {
                Patient = patient,
                OpeningSnapshot = openingSnapshot,
                Editor = editor,
                ActorUserId = currentUserId,
                BillingDraftService = BillingDraftService,
                SelectedEncounterId = EncounterId,
                HasLegacyDataPendingMigration = hasLegacyDataPendingMigration,
                Mode = mode
            });

        if (result.ValidationErrors.Count > 0)
        {
            validationMessages.AddRange(result.ValidationErrors);
            activeWizardStep = InferStepFromValidation(result.ValidationErrors);
            if (activeWizardStep == WizardSteps.Count)
            {
                shouldInitializeSignaturePad = true;
            }
            return;
        }

        statusMessage = result.StatusMessage;
        EncounterId = result.EncounterId;
        var currentStep = mode == ClinicalHistorySaveMode.Finalize ? WizardSteps.Count : activeWizardStep;

        NavigationManager.NavigateTo(
            NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                ["patientId"] = PatientId,
                ["encounterId"] = EncounterId
            }),
            forceLoad: false);

        await LoadAsync(preserveStatus: true);
        activeWizardStep = currentStep;
        shouldInitializeSignaturePad = activeWizardStep == WizardSteps.Count;

        if (mode == ClinicalHistorySaveMode.Finalize && editor is not null && ClinicalHistoryService.HasBillingTriggers(editor))
        {
            statusMessage += " Se actualizaron los servicios pendientes de facturacion.";
        }
    }

    private async Task<string> CaptureSignatureAsync()
    {
        if (editor is null)
        {
            return string.Empty;
        }

        if (activeWizardStep != WizardSteps.Count)
        {
            return editor.Consentimiento.FirmaDibujada;
        }

        try
        {
            return await JSRuntime.InvokeAsync<string>("optometriaClinicalSignature.getDataUrl", SignatureCanvasId);
        }
        catch
        {
            return editor.Consentimiento.FirmaDibujada;
        }
    }

    private async Task ClearSignatureAsync()
    {
        if (editor is null)
        {
            return;
        }

        editor.Consentimiento.FirmaDibujada = string.Empty;
        await JSRuntime.InvokeVoidAsync("optometriaClinicalSignature.clear", SignatureCanvasId);
    }

    private async Task<bool> CanViewHistoryModuleAsync(OpticaDbContext dbContext)
    {
        if (currentRoleId == 1)
        {
            return true;
        }

        var doctorProfile = await dbContext.tbl_medico
            .AsNoTracking()
            .FirstOrDefaultAsync(x => x.id_usuario == currentUserId);

        if (doctorProfile is not null && doctorProfile.puede_gestionar_historia_clinica == false)
        {
            return false;
        }

        var permission = await dbContext.tbl_rol_menu_permisos
            .AsNoTracking()
            .Where(p => p.id_rol == currentRoleId)
            .Join(
                dbContext.tbl_menu_apps.AsNoTracking().Where(m => m.ruta == "/doctor/historia-clinica"),
                rolePermission => rolePermission.id_menu,
                menu => menu.id_menu,
                (rolePermission, _) => rolePermission)
            .FirstOrDefaultAsync();

        return permission?.puede_ver == true;
    }

    private void ResetPatientContext()
    {
        patient = null;
        history = null;
        openingSnapshot = null;
        editor = null;
        encounterSummaries = [];
        examTimeline = [];
        alertSummaries = [];
        followUpSummaries = [];
        selectedEncounterSummary = null;
        hasLegacyDataPendingMigration = false;
        legacyEncounterLabel = null;
        activeWizardStep = 1;
        shouldInitializeSignaturePad = false;
        patientSearchTerm = string.Empty;
    }

    private string GetSelectedPatientValue()
        => PatientId?.ToString() ?? string.Empty;

    private static string GetPatientOptionLabel(tbl_paciente patient)
        => $"{patient.apellidos} {patient.nombres} - {patient.cedula}";

    private string GetProgressLabel()
        => selectedEncounterSummary is null
            ? "Nuevo encuentro en borrador"
            : $"Encuentro #{selectedEncounterSummary.EncounterId} - {selectedEncounterSummary.Status}";

    private string GetEncounterDateLabel()
        => selectedEncounterSummary is null
            ? "Todavia no se ha guardado este encuentro."
            : $"Abierto el {selectedEncounterSummary.EventDate:yyyy-MM-dd HH:mm}";

    private string GetWizardCurrentHint()
        => activeWizardStep switch
        {
            1 => "Revisa la historia maestra y prepara el contexto del nuevo encuentro.",
            2 => "Documenta lo que el paciente refiere y deja antecedentes utilizables para futuras consultas.",
            3 => "Registra los hallazgos tecnicos del encuentro actual.",
            4 => "Define diagnostico, conducta y lo que debe pasar a facturacion.",
            5 => "Confirma consentimiento y cierra la evolucion de forma segura.",
            _ => "Completa la historia clinica paso a paso."
        };

    private string GetCompletionHint()
    {
        if (editor is null)
        {
            return "Selecciona un paciente para empezar.";
        }

        var progress = ClinicalHistoryService.GetCompletionPercent(editor);
        if (progress >= 85)
        {
            return "Solo falta revisar consentimiento y cierre.";
        }

        if (string.IsNullOrWhiteSpace(editor.MotivoConsulta))
        {
            return "Empieza por motivo de consulta.";
        }

        if (!ClinicalHistoryService.HasAnyAnamnesis(editor))
        {
            return "Continua con anamnesis para dejar clara la historia del paciente.";
        }

        return "Sigue el flujo guiado hasta completar hallazgos, diagnostico y consentimiento.";
    }

    private void AddPrescriptionItem()
    {
        editor?.Diagnostico.PrescripcionItems.Add(new PrescriptionLineItem
        {
            TipoItem = "Medicamento",
            Cantidad = 1,
            Unidad = "unidad"
        });
    }

    private void RemovePrescriptionItem(int index)
    {
        if (editor is null || index < 0 || index >= editor.Diagnostico.PrescripcionItems.Count)
        {
            return;
        }

        editor.Diagnostico.PrescripcionItems.RemoveAt(index);
    }

    private void AddClinicalExamRecord()
    {
        editor?.ExamenesClinicos.Add(new ClinicalExamRecord
        {
            FechaExamen = DateTime.Today,
            ModuloOrigen = "Historia clinica"
        });
    }

    private void RemoveClinicalExamRecord(int index)
    {
        if (editor is null || index < 0 || index >= editor.ExamenesClinicos.Count)
        {
            return;
        }

        editor.ExamenesClinicos.RemoveAt(index);
    }

    private void OnExamDateChanged(int index, ChangeEventArgs args)
    {
        if (editor is null || index < 0 || index >= editor.ExamenesClinicos.Count)
        {
            return;
        }

        editor.ExamenesClinicos[index].FechaExamen = DateTime.TryParse(args.Value?.ToString(), out var parsedDate)
            ? parsedDate
            : null;
    }

    private void OnPrescriptionProductChanged(int index, ChangeEventArgs args)
    {
        if (editor is null || index < 0 || index >= editor.Diagnostico.PrescripcionItems.Count)
        {
            return;
        }

        var item = editor.Diagnostico.PrescripcionItems[index];
        item.ProductoId = int.TryParse(args.Value?.ToString(), out var productId) ? productId : 0;

        if (item.ProductoId <= 0)
        {
            return;
        }

        var product = prescriptionProducts.FirstOrDefault(x => x.id_producto == item.ProductoId);
        if (product is null)
        {
            return;
        }

        item.NombreItem = product.nombre_producto;
        if (ProductInventoryRules.IsStockManaged(product))
        {
            item.TipoItem = "Medicamento";
        }
        else if (string.IsNullOrWhiteSpace(item.TipoItem) || string.Equals(item.TipoItem, "Medicamento", StringComparison.OrdinalIgnoreCase))
        {
            item.TipoItem = "Examen";
        }
    }

    private static string GetPrescriptionProductLabel(tbl_producto product)
    {
        var stockLabel = ProductInventoryRules.IsStockManaged(product)
            ? $" | stock {(product.stock_actual ?? 0)}"
            : " | servicio";
        return $"{product.codigo_producto} - {product.nombre_producto}{stockLabel}";
    }

    private static int InferStepFromValidation(IEnumerable<string> errors)
    {
        var joined = string.Join(" ", errors).ToLowerInvariant();

        if (joined.Contains("firma") || joined.Contains("consent"))
        {
            return 5;
        }

        if (joined.Contains("diagnost"))
        {
            return 4;
        }

        if (joined.Contains("tecnico") || joined.Contains("visual") || joined.Contains("hallazgo"))
        {
            return 3;
        }

        if (joined.Contains("anamnesis") || joined.Contains("antecedente") || joined.Contains("motivo"))
        {
            return 2;
        }

        return 1;
    }

    private static string GetChipClass(bool isSelected, bool isAlert = false)
    {
        if (isSelected && isAlert)
        {
            return "clinical-chip clinical-chip--selected clinical-chip--alert";
        }

        if (isSelected)
        {
            return "clinical-chip clinical-chip--selected";
        }

        return isAlert ? "clinical-chip clinical-chip--alert-soft" : "clinical-chip";
    }

    private void ToggleAnamnesisItem(List<string> items, string option)
    {
        if (items.Contains(option))
        {
            items.Remove(option);
            return;
        }

        items.Add(option);
    }

    private string GetStructuredAnamnesisPreview()
        => editor is null ? string.Empty : ClinicalHistoryService.BuildStructuredAnamnesisSummary(editor.AnamnesisGuiada);

    private string GetExamModuleUrl()
        => PatientId.HasValue
            ? NavigationManager.GetUriWithQueryParameters("/doctor/examenes", new Dictionary<string, object?> { ["patientId"] = PatientId })
            : "/doctor/examenes";

    private string GetAppointmentPrefillUrl()
    {
        var reason = editor?.Seguimiento.Motivo;
        if (string.IsNullOrWhiteSpace(reason))
        {
            reason = editor?.MotivoConsulta;
        }

        var suggestedDate = editor?.Seguimiento.RequiereNuevaCita == true
            ? DateOnly.FromDateTime(DateTime.Today.AddDays(Math.Max(editor.Seguimiento.DiasSugeridos, 1))).ToString("yyyy-MM-dd")
            : null;

        return NavigationManager.GetUriWithQueryParameters("/citas", new Dictionary<string, object?>
        {
            ["patientId"] = PatientId,
            ["reason"] = reason,
            ["date"] = suggestedDate
        });
    }

    private static string FormatDateInput(DateTime? value)
        => value?.ToString("yyyy-MM-dd") ?? string.Empty;
}

