                        <div class="clinical-span-2">
                            <label class="form-label">Motivo de seguimiento</label>
                            <input class="form-control" @bind="editor.Seguimiento.Motivo" maxlength="220" />
                        </div>
                        <div class="clinical-span-2">
                            <label class="form-label">Observaciones</label>
                            <textarea class="form-control" rows="3" @bind="editor.Seguimiento.Observaciones"></textarea>
                        </div>
                    </div>
                    @if (followUpSummaries.Count > 0)
                    {
                        <div class="clinical-preview-card" style="margin-top: 1rem;">
                            <span class="eyebrow">Controles previos</span>
                            <p>@string.Join(" | ", followUpSummaries.Take(3).Select(x => $"{x.EventDate:yyyy-MM-dd}: {x.Priority} - {x.Reason}"))</p>
                        </div>
                    }
                </section>
            }

            @if (activeWizardStep == 5)
            {
                <section class="management-card clinical-card">
                    <div class="management-card-header">
                        <h2>Consentimiento informado</h2>
                        <span>Cierre seguro</span>
                    </div>
                    <p class="clinical-helper-text">El cierre ya no invalida la firma por salir de este paso. La captura solo se actualiza cuando realmente la editas o limpias.</p>
                    <div class="clinical-grid-4" style="margin-top: 1rem;">
                        <div class="clinical-span-2"><label class="form-label">Yo,</label><input class="form-control" @bind="editor.Consentimiento.Nombre" /></div>
                        <div><label class="form-label">CC</label><input class="form-control" @bind="editor.Consentimiento.Cedula" /></div>
                        <div><label class="form-label">Firma / referencia</label><input class="form-control" @bind="editor.Consentimiento.FirmaReferencia" /></div>
                        <div class="clinical-span-4">
                            <label class="form-label">Texto de consentimiento</label>
                            <textarea class="form-control" rows="4" @bind="editor.Consentimiento.Texto"></textarea>
                        </div>
                        <div>
                            <label class="form-label">Autoriza</label>
                            <input type="checkbox" class="form-check-input" style="margin-left:0.2rem;" @bind="editor.Consentimiento.Autorizado" />
                        </div>
                        <div class="clinical-span-4">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label class="form-label mb-0">Firma digital del paciente</label>
                                @if (!string.IsNullOrWhiteSpace(editor.Consentimiento.FirmaDibujada) && editor.Consentimiento.FirmaDibujada.Length > 50)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check-circle-fill me-1"></i> Firma digital registrada
                                    </span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(editor.Consentimiento.FirmaDibujada) && editor.Consentimiento.FirmaDibujada.Length > 50)
                            {
                                <div class="mb-2 p-2 bg-white rounded border d-flex align-items-center gap-3">
                                    <img src="@(editor.Consentimiento.FirmaDibujada.StartsWith("data:image") ? editor.Consentimiento.FirmaDibujada : $"data:image/png;base64,{editor.Consentimiento.FirmaDibujada}")" style="max-height: 44px; border: 1px solid #ddd; border-radius: 4px; background: #fff; padding: 2px;" alt="Firma registrada" />
                                    <small class="text-muted">Firma guardada en el encuentro. Puedes volver a dibujar abajo si deseas actualizarla.</small>
                                </div>
                            }
                            <div class="clinical-signature-shell">
                                <canvas id="@SignatureCanvasId" class="clinical-signature-pad"></canvas>
                                <div class="workspace-actions clinical-signature-actions">
                                    <button type="button" class="btn btn-outline-primary" @onclick="ClearSignatureAsync">Limpiar firma</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            }



            <section class="management-card clinical-card clinical-wizard-footer">
                <div class="clinical-wizard-footer-copy">
                    <strong>@WizardSteps[activeWizardStep - 1].Title</strong>
                    <p>@GetWizardCurrentHint()</p>
                </div>
                <div class="workspace-actions">
                    @if (activeWizardStep > 1)
                    {
                        <button type="button" class="btn btn-outline-primary" @onclick="GoToPreviousWizardStep">Paso anterior</button>
                    }
                    @if (activeWizardStep < WizardSteps.Count)
                    {
                        <button type="button" class="btn btn-primary" @onclick="GoToNextWizardStepAsync">Siguiente paso</button>
                    }
                    <button type="button" class="btn btn-outline-primary" @onclick="SaveDraftAsync">Guardar borrador</button>
                    @if (activeWizardStep == WizardSteps.Count)
                    {
                        <button type="button" class="btn btn-primary" @onclick="FinalizeAsync">
                            <i class="bi bi-check-circle-fill me-1"></i> Cerrar y guardar historia
                        </button>
                    }
                </div>
            </section>
        }
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "patientId")]
    public int? PatientId { get; set; }

    [SupplyParameterFromQuery(Name = "encounterId")]
    public int? EncounterId { get; set; }

    private readonly List<tbl_paciente> availablePatients = [];
    private readonly List<tbl_producto> prescriptionProducts = [];
    private readonly List<string> validationMessages = [];
    private static readonly string[] MainComplaintOptions = ["Visión borrosa", "Ardor ocular", "Ojo rojo", "Dolor ocular", "Cefalea", "Diplopía", "Fotofobia", "Control visual", "Adaptación de lentes", "Otro (especificar)"];
    private static readonly string[] OnsetOptions = ["Súbito", "Gradual", "Intermitente", "Recurrente", "Post-trauma"];
    private static readonly string[] DurationUnitOptions = ["horas", "días", "semanas", "meses", "años"];
    private static readonly string[] LateralityOptions = ["OD", "OI", "AO", "Alternante"];
    private static readonly string[] IntensityOptions = ["Leve", "Moderada", "Severa", "10/10"];
    private static readonly string[] SymptomOptions = ["Visión borrosa", "Prurito", "Lagrimeo", "Cefalea", "Fotofobia", "Diplopía", "Cuerpo extraño", "Secreción", "Moscas volantes", "Destellos"];
    private static readonly string[] RedFlagOptions = ["Dolor intenso", "Pérdida súbita de visión", "Trauma", "Destellos nuevos", "Moscas volantes nuevas", "Diplopía aguda", "Ojo rojo severo", "Cefalea intensa"];
    private static readonly string[] PrescriptionTypeOptions = ["Medicamento", "Examen", "Insumo"];
    private static readonly string[] ClinicalExamTypeOptions = ["Tonometría", "Campimetría", "Topografía corneal", "Retinografía", "OCT", "Paquimetría", "Biometría", "Prueba de color", "Test lagrimal", "Otro"];
    private static readonly string[] FollowUpPriorityOptions = ["Control", "Preferente", "Urgente"];
    private static readonly IReadOnlyList<ClinicalHistoryStepNavigation.ClinicalStepDefinition> WizardSteps = new[]
    {
        new ClinicalHistoryStepNavigation.ClinicalStepDefinition(1, "Apertura", "Historia maestra y control del paciente."),
        new ClinicalHistoryStepNavigation.ClinicalStepDefinition(2, "Consulta inicial", "Motivo, anamnesis, antecedentes y visión."),
        new ClinicalHistoryStepNavigation.ClinicalStepDefinition(3, "Hallazgos", "Biomicroscopía, oftalmoscopía y refracción."),
        new ClinicalHistoryStepNavigation.ClinicalStepDefinition(4, "Diagnóstico", "Conclusión clínica y conducta."),
        new ClinicalHistoryStepNavigation.ClinicalStepDefinition(5, "Consentimiento", "Autorización, firma y cierre.")
    };

    private tbl_paciente? patient;
    private tbl_historia_clinica_optometria? history;
    private OpeningSnapshot? openingSnapshot;
    private ClinicalHistoryEditorModel? editor;
    private List<ClinicalEncounterSummary> encounterSummaries = [];
    private List<ClinicalExamTimelineItem> examTimeline = [];
    private List<ClinicalAlertSummary> alertSummaries = [];
    private List<ClinicalFollowUpSummary> followUpSummaries = [];
    private ClinicalEncounterSummary? selectedEncounterSummary;
    private bool hasLegacyDataPendingMigration;
    private string? legacyEncounterLabel;
    private bool isLoading = true;
    private bool canViewModule;
    private int currentUserId;
    private string editReason = "";
    private bool showHistoryDetails;
    private void ToggleHistoryDetails() => showHistoryDetails = !showHistoryDetails;
    private bool savingHistory;
    private int currentRoleId;
    private int activeWizardStep = 1;
    private bool shouldInitializeSignaturePad;
    private string? statusMessage;
    private string? errorMessage;
    private bool showValidationModal;
    private void CloseValidationModal() => showValidationModal = false;
    private async Task GoToValidationStep()
    {
        showValidationModal = false;
        var step = InferStepFromValidation(validationMessages);
        await GoToWizardStepAsync(step);
    }
    private bool showClosedSuccessModal;
    private void CloseClosedSuccessModal() => showClosedSuccessModal = false;
    private void NavigateToAppointments()
    {
        showClosedSuccessModal = false;
        NavigationManager.NavigateTo(GetAppointmentPrefillUrl());
    }
    private string patientSearchTerm = string.Empty;
    private string SignatureCanvasId => "clinical-signature-pad";
    private IEnumerable<tbl_producto> AvailablePrescriptionProducts => prescriptionProducts.OrderBy(x => x.nombre_producto).ThenBy(x => x.codigo_producto);
    private IEnumerable<tbl_paciente> FilteredPatients => string.IsNullOrWhiteSpace(patientSearchTerm)
        ? availablePatients.Take(200)
        : availablePatients.Where(x =>
                GetPatientOptionLabel(x).Contains(patientSearchTerm, StringComparison.OrdinalIgnoreCase))
            .Take(200);

    private async Task OnEncounterSelectChanged(ChangeEventArgs args)
    {
        var raw = args.Value?.ToString();
        if (raw == "new")
        {
            await StartNewEncounterAsync();
        }
        else if (int.TryParse(raw, out var encId) && encId > 0)
        {
            await SelectEncounterAsync(encId);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (activeWizardStep == WizardSteps.Count && editor is not null && shouldInitializeSignaturePad)
        {
            shouldInitializeSignaturePad = false;
            await Task.Delay(50);
            await JSRuntime.InvokeVoidAsync("optometriaClinicalSignature.init", SignatureCanvasId, editor.Consentimiento.FirmaDibujada);
        }
    }

    private async Task LoadAsync(bool preserveStatus = false)
    {
        editReason = "";
        isLoading = true;
        errorMessage = null;
        validationMessages.Clear();

        if (!preserveStatus)
        {
            statusMessage = null;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier), out var userId) ? userId : 0;
        currentRoleId = int.TryParse(authState.User.FindFirstValue("RoleId"), out var roleId) ? roleId : 0;

        if (currentUserId <= 0)
        {
            canViewModule = false;
            isLoading = false;
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        canViewModule = await CanViewHistoryModuleAsync(dbContext);

        if (!canViewModule)
        {
            isLoading = false;
            return;
        }

        var isFullAdmin = authState.User.IsInRole("Administrador") || authState.User.IsInRole("Admin");
        var doctorProfile = await dbContext.tbl_medico.AsNoTracking().FirstOrDefaultAsync(m => m.id_usuario == currentUserId);
        var isDoctorOnly = (doctorProfile is not null || authState.User.IsInRole("Doctor") || authState.User.IsInRole("Médico") || authState.User.IsInRole("Medico")) && !isFullAdmin;

        List<int>? assignedPatientIds = null;
        if (isDoctorOnly)
        {
            var doctorId = doctorProfile?.id_medico ?? 0;
            var citaPatientIds = await dbContext.tbl_citas
                .AsNoTracking()
                .Where(c => (doctorId > 0 && c.id_medico == doctorId) || c.id_medicoNavigation.id_usuario == currentUserId)
                .Select(c => c.id_paciente)
                .Distinct()
                .ToListAsync();

            var historyPatientIds = await dbContext.tbl_historia_clinica_optometrias
                .AsNoTracking()
                .Where(h => h.id_optometra_apertura == currentUserId || h.id_optometra_ultima_actualizacion == currentUserId)
                .Select(h => h.id_paciente)
                .Distinct()
                .ToListAsync();

            var eventoPatientIds = await dbContext.tbl_historia_clinica_optometria_eventos
                .AsNoTracking()
                .Where(h => h.id_optometra == currentUserId)
                .Select(h => h.id_paciente)
                .Distinct()
                .ToListAsync();

            var consultaPatientIds = await dbContext.tbl_consulta
                .AsNoTracking()
                .Where(c => c.id_optometra == currentUserId)
                .Select(c => c.id_paciente)
                .Distinct()
                .ToListAsync();

            assignedPatientIds = citaPatientIds.Union(historyPatientIds).Union(eventoPatientIds).Union(consultaPatientIds).Distinct().ToList();
        }

        availablePatients.Clear();
        if (assignedPatientIds is not null)
        {
            availablePatients.AddRange(await dbContext.tbl_pacientes
                .AsNoTracking()
                .Where(x => assignedPatientIds.Contains(x.id_paciente))
                .OrderBy(x => x.apellidos)
                .ThenBy(x => x.nombres)
                .ToListAsync());
        }
        else
        {
            availablePatients.AddRange(await dbContext.tbl_pacientes
                .AsNoTracking()
                .OrderBy(x => x.apellidos)
                .ThenBy(x => x.nombres)
                .ToListAsync());
        }

        prescriptionProducts.Clear();
        prescriptionProducts.AddRange(await dbContext.tbl_productos
            .AsNoTracking()
            .Where(x => x.activo == true)
            .OrderBy(x => x.nombre_producto)
            .ToListAsync());

        if (!PatientId.HasValue || PatientId.Value <= 0)
        {
            ResetPatientContext();
            isLoading = false;
            return;
        }

        if (assignedPatientIds is not null && !assignedPatientIds.Contains(PatientId.Value))
        {
            ResetPatientContext();
            errorMessage = "No tienes acceso a la historia clínica de este paciente porque no tiene citas ni consultas asignadas a tu nombre.";
            isLoading = false;
            return;
        }

        patient = await dbContext.tbl_pacientes
            .AsNoTracking()
            .FirstOrDefaultAsync(x => x.id_paciente == PatientId.Value);

        if (patient is null)
        {
            ResetPatientContext();
            errorMessage = "No se encontro el paciente seleccionado.";
            isLoading = false;
            return;
        }

        patientSearchTerm = GetPatientOptionLabel(patient);

        var loadResult = await ClinicalHistoryService.LoadPatientHistoryAsync(dbContext, patient, EncounterId);
        history = loadResult.History;
        openingSnapshot = loadResult.OpeningSnapshot;
        editor = loadResult.Editor;
        encounterSummaries = loadResult.Encounters;
        examTimeline = loadResult.ExamTimeline;
        alertSummaries = loadResult.AlertSummaries;
        followUpSummaries = loadResult.FollowUpSummaries;
        selectedEncounterSummary = loadResult.SelectedEncounter;
        hasLegacyDataPendingMigration = loadResult.HasLegacyDataPendingMigration;
        legacyEncounterLabel = loadResult.LegacyEncounterLabel;

        if (editor is not null && patient is not null)
        {
            if (string.IsNullOrWhiteSpace(editor.NombreExaminador))
            {
                var currentUser = await dbContext.tbl_usuarios.AsNoTracking().FirstOrDefaultAsync(x => x.id_usuario == currentUserId);
                if (currentUser is not null)
                {
                    var fullName = $"{currentUser.nombres} {currentUser.apellidos}".Trim();
                    editor.NombreExaminador = !string.IsNullOrWhiteSpace(fullName) ? fullName : currentUser.usuario;
                }
            }
            if (string.IsNullOrWhiteSpace(editor.Consentimiento.Nombre))
            {
                editor.Consentimiento.Nombre = $"{patient.nombres} {patient.apellidos}".Trim();
            }
            if (string.IsNullOrWhiteSpace(editor.Consentimiento.Cedula))
            {
                editor.Consentimiento.Cedula = patient.cedula;
            }
            if (string.IsNullOrWhiteSpace(editor.Consentimiento.FirmaReferencia))
            {
                editor.Consentimiento.FirmaReferencia = $"{patient.nombres} {patient.apellidos}".Trim();
            }
            editor.Consentimiento.Autorizado = true;
        }

        activeWizardStep = 1;
        shouldInitializeSignaturePad = false;
        isLoading = false;
    }

    private async Task OnPatientChangedAsync(ChangeEventArgs args)
    {
        var rawValue = args.Value?.ToString();
        PatientId = int.TryParse(rawValue, out var parsedPatientId) && parsedPatientId > 0
            ? parsedPatientId
            : null;
        EncounterId = null;

        NavigationManager.NavigateTo(
            NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                ["patientId"] = PatientId,
                ["encounterId"] = null
            }),
            forceLoad: false);

        await LoadAsync();
    }

    private async Task SelectEncounterAsync(int encounterId)
    {
        EncounterId = encounterId;
        NavigationManager.NavigateTo(
            NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                ["patientId"] = PatientId,
                ["encounterId"] = EncounterId
            }),
            forceLoad: false);

        await LoadAsync();
    }

    private async Task StartNewEncounterAsync()
    {
        if (patient is null)
        {
            return;
        }

        var seededEditor = ClinicalHistoryService.BuildNewEditor(patient);
        if (editor is not null)
        {
            seededEditor.NumeroHistoria = string.IsNullOrWhiteSpace(editor.NumeroHistoria) ? seededEditor.NumeroHistoria : editor.NumeroHistoria;
            seededEditor.Consultorio = editor.Consultorio;
            seededEditor.LlaveClinica = editor.LlaveClinica;
            seededEditor.LugarNacimiento = editor.LugarNacimiento;
            seededEditor.Procedencia = editor.Procedencia;
            seededEditor.UltimoControl = editor.UltimoControl;
        }

        editor = seededEditor;
        EncounterId = null;
        selectedEncounterSummary = null;
        hasLegacyDataPendingMigration = false;
        legacyEncounterLabel = null;
        validationMessages.Clear();
        errorMessage = null;
        statusMessage = "Se abrio una nueva evolucion en borrador.";
        activeWizardStep = 1;
        shouldInitializeSignaturePad = false;

        NavigationManager.NavigateTo(
            NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                ["patientId"] = PatientId,
                ["encounterId"] = null
            }),
            forceLoad: false);

        await InvokeAsync(StateHasChanged);
    }

    private async Task GoToWizardStepAsync(int step)
    {
        if (editor is null)
        {
            return;
        }

        if (step > activeWizardStep)
        {
            var errors = ClinicalHistoryService.ValidateStep(editor, activeWizardStep);
            if (errors.Count > 0)
            {
                validationMessages.Clear();
                validationMessages.AddRange(errors);
                showValidationModal = true;
                return;
            }
        }

        validationMessages.Clear();
        showValidationModal = false;
        activeWizardStep = Math.Min(Math.Max(step, 1), WizardSteps.Count);

        if (activeWizardStep == WizardSteps.Count)
        {
            shouldInitializeSignaturePad = true;
        }

        await InvokeAsync(StateHasChanged);
    }

    private Task GoToPreviousWizardStep()
        => GoToWizardStepAsync(activeWizardStep - 1);

    private Task GoToNextWizardStepAsync()
        => GoToWizardStepAsync(activeWizardStep + 1);

    private async Task SaveDraftAsync()
        => await SaveAsync(ClinicalHistorySaveMode.Draft);

    private async Task FinalizeAsync()
        => await SaveAsync(ClinicalHistorySaveMode.Finalize);

    private async Task SaveAsync(ClinicalHistorySaveMode mode)
    {
        if (savingHistory) return;
        savingHistory = true;
        try 
        { 
            await SaveCoreAsync(mode); 
        }
        catch (DbUpdateException ex) 
        { 
            errorMessage = $"No se pudo guardar la edición: {ex.InnerException?.Message ?? ex.Message}"; 
            showValidationModal = true;
        }
        catch (Exception ex) 
        { 
            errorMessage = $"Error al guardar la historia clínica: {ex.Message}"; 
            showValidationModal = true;
        }
        finally 
        { 
            savingHistory = false; 
        }
    }

    private async Task SaveCoreAsync(ClinicalHistorySaveMode mode)
    {
        errorMessage = null;
        validationMessages.Clear();
        showValidationModal = false;

        if (patient is null || editor is null || openingSnapshot is null)
        {
            errorMessage = "No existe un paciente valido para guardar la historia clinica.";
            showValidationModal = true;
            return;
        }

        var signatureData = await CaptureSignatureAsync();
        if (!string.IsNullOrWhiteSpace(signatureData))
        {
            editor.Consentimiento.FirmaDibujada = signatureData;
        }

        if (string.IsNullOrWhiteSpace(editReason))
        {
            editReason = "Actualización de historia clínica";
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var result = await ClinicalHistoryService.SaveAsync(
            dbContext,
            new ClinicalHistorySaveRequest
            {
                Patient = patient,
                OpeningSnapshot = openingSnapshot,
                Editor = editor,
                ActorUserId = currentUserId,
                EditReason = editReason,
                ExpectedUpdatedAt = selectedEncounterSummary?.UpdatedAt,
                BillingDraftService = BillingDraftService,
                SelectedEncounterId = EncounterId,
                HasLegacyDataPendingMigration = hasLegacyDataPendingMigration,
                Mode = mode
            });

        if (result.ValidationErrors.Count > 0)
        {
            validationMessages.AddRange(result.ValidationErrors);
            activeWizardStep = InferStepFromValidation(result.ValidationErrors);
            if (activeWizardStep == WizardSteps.Count)
            {
                shouldInitializeSignaturePad = true;
            }
            showValidationModal = true;
            return;
        }

        statusMessage = result.StatusMessage;
        editReason = "";
        EncounterId = result.EncounterId;
        var currentStep = mode == ClinicalHistorySaveMode.Finalize ? WizardSteps.Count : activeWizardStep;

        NavigationManager.NavigateTo(
            NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                ["patientId"] = PatientId,
                ["encounterId"] = EncounterId
            }),
            forceLoad: false);

        await LoadAsync(preserveStatus: true);
        activeWizardStep = currentStep;
        shouldInitializeSignaturePad = activeWizardStep == WizardSteps.Count;

        if (mode == ClinicalHistorySaveMode.Finalize && editor is not null && ClinicalHistoryService.HasBillingTriggers(editor))
        {
            statusMessage += " Se actualizaron los servicios pendientes de facturacion.";
        }

        if (mode == ClinicalHistorySaveMode.Finalize)
        {
            showClosedSuccessModal = true;
        }
    }

    private async Task<string> CaptureSignatureAsync()
    {
        if (editor is null)
        {
            return string.Empty;
        }

        if (activeWizardStep != WizardSteps.Count)
        {
            return editor.Consentimiento.FirmaDibujada;
        }

        try
        {
            var captured = await JSRuntime.InvokeAsync<string>("optometriaClinicalSignature.getDataUrl", SignatureCanvasId);
            if (!string.IsNullOrWhiteSpace(captured) && captured.Length > 50)
            {
                return captured;
            }
            return editor.Consentimiento.FirmaDibujada;
        }
        catch
        {
            return editor.Consentimiento.FirmaDibujada;
        }
    }

    private async Task ClearSignatureAsync()
    {
        if (editor is null)
        {
            return;
        }

        editor.Consentimiento.FirmaDibujada = string.Empty;
        await JSRuntime.InvokeVoidAsync("optometriaClinicalSignature.clear", SignatureCanvasId);
    }

    private async Task<bool> CanViewHistoryModuleAsync(OpticaDbContext dbContext)
    {
        if (currentRoleId == 1)
        {
            return true;
        }

        var doctorProfile = await dbContext.tbl_medico
            .AsNoTracking()
            .FirstOrDefaultAsync(x => x.id_usuario == currentUserId);

        if (doctorProfile is not null && doctorProfile.puede_gestionar_historia_clinica == false)
        {
            return false;
        }

        var permission = await dbContext.tbl_rol_menu_permisos
            .AsNoTracking()
            .Where(p => p.id_rol == currentRoleId)
            .Join(
                dbContext.tbl_menu_apps.AsNoTracking().Where(m => m.ruta == "/doctor/historia-clinica"),
                rolePermission => rolePermission.id_menu,
                menu => menu.id_menu,
                (rolePermission, _) => rolePermission)
            .FirstOrDefaultAsync();

        return permission?.puede_ver == true;
    }

    private void ResetPatientContext()
    {
        patient = null;
        history = null;
        openingSnapshot = null;
        editor = null;
        encounterSummaries = [];
        examTimeline = [];
        alertSummaries = [];
        followUpSummaries = [];
        selectedEncounterSummary = null;
        hasLegacyDataPendingMigration = false;
        legacyEncounterLabel = null;
        activeWizardStep = 1;
        shouldInitializeSignaturePad = false;
        patientSearchTerm = string.Empty;
    }

    private string GetSelectedPatientValue()
        => PatientId?.ToString() ?? string.Empty;

    private static string GetPatientOptionLabel(tbl_paciente patient)
        => $"{patient.apellidos} {patient.nombres} - {patient.cedula}";

    private string GetProgressLabel()
        => selectedEncounterSummary is null
            ? "Nuevo encuentro en borrador"
            : $"Encuentro #{selectedEncounterSummary.EncounterId} - {selectedEncounterSummary.Status}";

    private string GetEncounterDateLabel()
        => selectedEncounterSummary is null
            ? "Todavia no se ha guardado este encuentro."
            : $"Abierto el {selectedEncounterSummary.EventDate:yyyy-MM-dd HH:mm}";

    private string GetWizardCurrentHint()
        => activeWizardStep switch
        {
            1 => "Revisa la historia maestra y prepara el contexto del nuevo encuentro.",
            2 => "Documenta lo que el paciente refiere y deja antecedentes utilizables para futuras consultas.",
            3 => "Registra los hallazgos tecnicos del encuentro actual.",
            4 => "Define diagnostico, conducta y lo que debe pasar a facturacion.",
            5 => "Confirma consentimiento y cierra la evolucion de forma segura.",
            _ => "Completa la historia clinica paso a paso."
        };

    private string GetCompletionHint()
    {
        if (editor is null)
        {
            return "Selecciona un paciente para empezar.";
        }

        var progress = ClinicalHistoryService.GetCompletionPercent(editor);
        if (progress >= 85)
        {
            return "Solo falta revisar consentimiento y cierre.";
        }

        if (string.IsNullOrWhiteSpace(editor.MotivoConsulta))
        {
            return "Empieza por motivo de consulta.";
        }

        if (!ClinicalHistoryService.HasAnyAnamnesis(editor))
        {
            return "Continua con anamnesis para dejar clara la historia del paciente.";
        }

        return "Sigue el flujo guiado hasta completar hallazgos, diagnostico y consentimiento.";
    }

    private void AddPrescriptionItem()
    {
        editor?.Diagnostico.PrescripcionItems.Add(new PrescriptionLineItem
        {
            TipoItem = "Medicamento",
            Cantidad = 1,
            Unidad = "unidad"
        });
    }

    private void RemovePrescriptionItem(int index)
    {
        if (editor is null || index < 0 || index >= editor.Diagnostico.PrescripcionItems.Count)
        {
            return;
        }

        editor.Diagnostico.PrescripcionItems.RemoveAt(index);
    }

    private void AddClinicalExamRecord()
    {
        editor?.ExamenesClinicos.Add(new ClinicalExamRecord
        {
            FechaExamen = DateTime.Today,
            ModuloOrigen = "Historia clinica"
        });
    }

    private void RemoveClinicalExamRecord(int index)
    {
        if (editor is null || index < 0 || index >= editor.ExamenesClinicos.Count)
        {
            return;
        }

        editor.ExamenesClinicos.RemoveAt(index);
    }

    private void OnExamDateChanged(int index, ChangeEventArgs args)
    {
        if (editor is null || index < 0 || index >= editor.ExamenesClinicos.Count)
        {
            return;
        }

        editor.ExamenesClinicos[index].FechaExamen = DateTime.TryParse(args.Value?.ToString(), out var parsedDate)
            ? parsedDate
            : null;
    }

    private void OnPrescriptionProductChanged(int index, ChangeEventArgs args)
    {
        if (editor is null || index < 0 || index >= editor.Diagnostico.PrescripcionItems.Count)
        {
            return;
        }

        var item = editor.Diagnostico.PrescripcionItems[index];
        item.ProductoId = int.TryParse(args.Value?.ToString(), out var productId) ? productId : 0;

        if (item.ProductoId <= 0)
        {
            return;
        }

        var product = prescriptionProducts.FirstOrDefault(x => x.id_producto == item.ProductoId);
        if (product is null)
        {
            return;
        }

        item.NombreItem = product.nombre_producto;
        if (ProductInventoryRules.IsStockManaged(product))
        {
            item.TipoItem = "Medicamento";
        }
        else if (string.IsNullOrWhiteSpace(item.TipoItem) || string.Equals(item.TipoItem, "Medicamento", StringComparison.OrdinalIgnoreCase))
        {
            item.TipoItem = "Examen";
        }
    }

    private static string GetPrescriptionProductLabel(tbl_producto product)
    {
        var stockLabel = ProductInventoryRules.IsStockManaged(product)
            ? $" | stock {(product.stock_actual ?? 0)}"
            : " | servicio";
        return $"{product.codigo_producto} - {product.nombre_producto}{stockLabel}";
    }

    private static int InferStepFromValidation(IEnumerable<string> errors)
    {
        var joined = string.Join(" ", errors).ToLowerInvariant();

        if (joined.Contains("firma") || joined.Contains("consent"))
        {
            return 5;
        }

        if (joined.Contains("diagnost"))
        {
            return 4;
        }

        if (joined.Contains("tecnico") || joined.Contains("visual") || joined.Contains("hallazgo"))
        {
            return 3;
        }

        if (joined.Contains("anamnesis") || joined.Contains("antecedente") || joined.Contains("motivo"))
        {
            return 2;
        }

        return 1;
    }

    private static string GetChipClass(bool isSelected, bool isAlert = false)
    {
        if (isSelected && isAlert)
        {
            return "clinical-chip clinical-chip--selected clinical-chip--alert";
        }

        if (isSelected)
        {
            return "clinical-chip clinical-chip--selected";
        }

        return isAlert ? "clinical-chip clinical-chip--alert-soft" : "clinical-chip";
    }

    private void ToggleAnamnesisItem(List<string> items, string option)
    {
        if (items.Contains(option))
        {
            items.Remove(option);
            return;
        }

        items.Add(option);
    }

    private string GetStructuredAnamnesisPreview()
        => editor is null ? string.Empty : ClinicalHistoryService.BuildStructuredAnamnesisSummary(editor.AnamnesisGuiada);

    private string GetExamModuleUrl()
        => PatientId.HasValue
            ? NavigationManager.GetUriWithQueryParameters("/doctor/examenes", new Dictionary<string, object?> { ["patientId"] = PatientId })
            : "/doctor/examenes";

    private string GetAppointmentPrefillUrl()
    {
        var reason = editor?.Seguimiento.Motivo;
        if (string.IsNullOrWhiteSpace(reason))
        {
            reason = editor?.MotivoConsulta;
        }

        var suggestedDate = editor?.Seguimiento.RequiereNuevaCita == true
            ? DateOnly.FromDateTime(DateTime.Today.AddDays(Math.Max(editor.Seguimiento.DiasSugeridos, 1))).ToString("yyyy-MM-dd")
            : null;

        return NavigationManager.GetUriWithQueryParameters("/citas", new Dictionary<string, object?>
        {
            ["patientId"] = PatientId,
            ["reason"] = reason,
            ["date"] = suggestedDate
        });
    }

    private static string FormatDateInput(DateTime? value)
        => value?.ToString("yyyy-MM-dd") ?? string.Empty;

    private static string GetSnapshotValue(string? snapshotVal, string? fallbackVal)
        => !string.IsNullOrWhiteSpace(snapshotVal) ? snapshotVal : (fallbackVal ?? string.Empty);

    private string GetPatientFullName()
    {
        var snapName = $"{openingSnapshot?.Nombres} {openingSnapshot?.Apellidos}".Trim();
        if (!string.IsNullOrWhiteSpace(snapName)) return snapName;
        return patient is null ? "Paciente" : $"{patient.nombres} {patient.apellidos}".Trim();
    }

    private string GetPatientCedula()
        => !string.IsNullOrWhiteSpace(openingSnapshot?.Cedula) ? openingSnapshot.Cedula : (patient?.cedula ?? string.Empty);

    private string GetPatientAgeDisplay()
    {
        var age = openingSnapshot?.Edad;
        if (string.IsNullOrWhiteSpace(age) && patient?.edad.HasValue == true)
        {
            age = patient.edad.Value.ToString();
        }
        return string.IsNullOrWhiteSpace(age) ? string.Empty : $"{age} años";
    }
}

