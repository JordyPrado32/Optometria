@page "/profile"
@attribute [Authorize(Policy = "OperationalAccess")]
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<OpticaDbContext> DbContextFactory

<PageTitle>Mi perfil</PageTitle>

@if (isLoading)
{
    <section class="management-shell">
        <div class="management-card">
            <h1>Cargando perfil...</h1>
        </div>
    </section>
}
else if (profile is null)
{
    <section class="management-shell">
        <div class="management-card">
            <h1>No se encontro el perfil.</h1>
        </div>
    </section>
}
else
{
    <section class="management-shell">
        <div class="management-card profile-hero-card">
            <div class="profile-hero-copy">
                <span class="eyebrow">Mi perfil</span>
                <h1>@FullName</h1>
                <p>
                    Actualiza tus datos personales, conserva tu correo como identificador del sistema
                    y cambia tu contrasena con validacion reforzada.
                </p>
            </div>

            <div class="profile-hero-avatar">
                <img src="@AvatarPreviewPath" alt="Avatar del usuario" />
                <div>
                    <strong>@profile.usuario</strong>
                    <span>@RoleName</span>
                </div>
            </div>
        </div>

        <div class="profile-layout">
            <div class="management-card profile-side-card">
                <div class="management-card-header">
                    <h2>Acceso rapido</h2>
                    <span>Cuenta</span>
                </div>

                <div class="profile-avatar-preview-card">
                    <img src="@AvatarPreviewPath" alt="Vista previa del avatar" />
                    <strong>@FullName</strong>
                    <span>@(profile.email ?? "Sin correo")</span>
                </div>

                <button type="button" class="btn btn-outline-primary" @onclick="OpenAvatarPicker">
                    Cambiar avatar
                </button>

                <div class="password-policy profile-password-policy">
                    <strong>Politica ISO 27001</strong>
                    <p>Minimo 12 caracteres, mayuscula, minuscula, numero, simbolo, sin espacios y sin datos personales.</p>
                </div>
            </div>

            <div class="management-card">
                <div class="management-card-header">
                    <h2>Datos personales</h2>
                    <span>Edicion segura</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(Error))
                {
                    <div class="alert alert-danger" role="alert">@Error</div>
                }

                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <div class="alert alert-success" role="alert">@Message</div>
                }

                <form method="post" action="/auth/profile" class="auth-form" autocomplete="off">
                    <input type="hidden" name="avatar_url" value="@AvatarFormValue" />

                    <div class="auth-grid">
                        <div>
                            <label class="form-label" for="nombres">Nombres</label>
                            <input id="nombres" name="nombres" class="form-control" value="@profile.nombres" required />
                        </div>

                        <div>
                            <label class="form-label" for="apellidos">Apellidos</label>
                            <input id="apellidos" name="apellidos" class="form-control" value="@profile.apellidos" required />
                        </div>
                    </div>

                    <div class="auth-grid">
                        <div>
                            <label class="form-label" for="usuario">Usuario</label>
                            <input id="usuario" name="usuario" class="form-control profile-readonly-input" value="@profile.usuario" readonly />
                            <small class="profile-readonly-hint">El nombre de usuario no se puede modificar.</small>
                        </div>

                        <div>
                            <label class="form-label" for="telefono">Telefono</label>
                            <input id="telefono" name="telefono" class="form-control" value="@profile.telefono" />
                        </div>
                    </div>

                    <div class="auth-grid">
                        <div>
                            <label class="form-label" for="email">Correo</label>
                            <input id="email" name="email" type="email" class="form-control" value="@profile.email" readonly />
                        </div>

                        <div>
                            <label class="form-label" for="fechaNacimiento">Fecha de nacimiento</label>
                            <input id="fechaNacimiento" name="fechaNacimiento" type="date" class="form-control" value="@BirthDateValue" />
                        </div>
                    </div>

                    <div class="profile-password-section">
                        <div class="management-card-header">
                            <h2>Actualizar contrasena</h2>
                            <span>Opcional</span>
                        </div>

                        <div class="auth-grid">
                            <div>
                                <label class="form-label" for="currentPassword">Contrasena actual</label>
                                <div class="password-field">
                                    <input id="currentPassword" name="currentPassword" type="@(showCurrentPassword ? "text" : "password")" class="form-control" autocomplete="new-password" />
                                    <button type="button" class="password-toggle" @onclick="ToggleCurrentPasswordVisibility">
                                        @(showCurrentPassword ? "Ocultar" : "Mostrar")
                                    </button>
                                </div>
                            </div>

                            <div>
                                <label class="form-label" for="newPassword">Nueva contrasena</label>
                                <div class="password-field">
                                    <input id="newPassword" name="newPassword" type="@(showNewPassword ? "text" : "password")" class="form-control" autocomplete="new-password" />
                                    <button type="button" class="password-toggle" @onclick="ToggleNewPasswordVisibility">
                                        @(showNewPassword ? "Ocultar" : "Mostrar")
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div>
                            <label class="form-label" for="confirmNewPassword">Confirmar nueva contrasena</label>
                            <div class="password-field">
                                <input id="confirmNewPassword" name="confirmNewPassword" type="@(showConfirmPassword ? "text" : "password")" class="form-control" autocomplete="new-password" />
                                <button type="button" class="password-toggle" @onclick="ToggleConfirmPasswordVisibility">
                                    @(showConfirmPassword ? "Ocultar" : "Mostrar")
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="workspace-actions">
                        <button type="submit" class="btn btn-primary">Guardar cambios</button>
                        <a class="btn btn-outline-primary" href="/dashboard">Volver al dashboard</a>
                    </div>
                </form>
            </div>
        </div>
    </section>
}

@if (showAvatarPicker)
{
    <div class="profile-avatar-modal-backdrop">
        <div class="profile-avatar-modal">
            <div class="profile-avatar-modal-header">
                <span>Selecciona tu avatar</span>
                <button type="button" class="profile-avatar-close" @onclick="CloseAvatarPicker">&times;</button>
            </div>

            <div class="profile-avatar-modal-body">
                <div class="profile-avatar-preview-card">
                    <img src="@AvatarSelectionPreviewPath" alt="Avatar seleccionado" />
                    <strong>Vista previa</strong>
                    <span>@AvatarSelectionPreviewFile</span>
                </div>

                <div class="profile-avatar-controls">
                    <div class="profile-avatar-tabs">
                        <button type="button" class="@(activeCategory == "mujeres" ? "is-active" : string.Empty)" @onclick='() => SelectCategory("mujeres")'>
                            Mujeres
                        </button>
                        <button type="button" class="@(activeCategory == "hombres" ? "is-active" : string.Empty)" @onclick='() => SelectCategory("hombres")'>
                            Hombres
                        </button>
                    </div>

                    <div class="profile-avatar-grid">
                        @foreach (var avatar in CurrentAvatars)
                        {
                            <button type="button" class="profile-avatar-option @(selectedCharacter == avatar ? "is-selected" : string.Empty)" @onclick="() => SelectCharacter(avatar)">
                                <img src="@($"/images/avatars/{avatar}_sin_lentes.png")" alt="Avatar @avatar" />
                            </button>
                        }
                    </div>

                    <div class="profile-avatar-lens-toggle">
                        <button type="button" class="@(avatarLenses == "con_lentes" ? "is-active" : string.Empty)" @onclick='() => SelectLenses("con_lentes")'>
                            Con lentes
                        </button>
                        <button type="button" class="@(avatarLenses == "sin_lentes" ? "is-active" : string.Empty)" @onclick='() => SelectLenses("sin_lentes")'>
                            Sin lentes
                        </button>
                    </div>
                </div>
            </div>

            <div class="profile-avatar-modal-actions">
                <button type="button" class="btn btn-outline-primary" @onclick="CloseAvatarPicker">Cancelar</button>
                <button type="button" class="btn btn-primary" @onclick="ConfirmAvatarSelection">Confirmar avatar</button>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? Message { get; set; }

    private readonly string[] womenAvatars = ["l", "m", "n", "p", "r"];
    private readonly string[] menAvatars = ["s", "t", "u", "v", "w"];

    private tbl_usuario? profile;
    private bool isLoading = true;
    private bool showAvatarPicker;
    private bool showCurrentPassword;
    private bool showNewPassword;
    private bool showConfirmPassword;
    private bool avatarTouched;
    private string activeCategory = "mujeres";
    private string selectedCharacter = "l";
    private string avatarLenses = "sin_lentes";

    private string FullName => $"{profile?.nombres} {profile?.apellidos}".Trim();
    private string RoleName => profile?.id_rolNavigation?.nombre ?? "Sin rol";
    private string SelectedAvatarFile => $"{selectedCharacter}_{avatarLenses}.png";
    private string CurrentAvatarFile => string.IsNullOrWhiteSpace(profile?.avatar_url) ? "l_sin_lentes.png" : System.IO.Path.GetFileName(profile.avatar_url);
    private string AvatarPreviewFile => avatarTouched ? SelectedAvatarFile : CurrentAvatarFile;
    private string AvatarPreviewPath => $"/images/avatars/{AvatarPreviewFile}";
    private string AvatarSelectionPreviewFile => SelectedAvatarFile;
    private string AvatarSelectionPreviewPath => $"/images/avatars/{AvatarSelectionPreviewFile}";
    private string AvatarFormValue => avatarTouched ? SelectedAvatarFile : (string.IsNullOrWhiteSpace(profile?.avatar_url) ? string.Empty : CurrentAvatarFile);
    private string BirthDateValue => profile?.fecha_nacimiento?.ToString("yyyy-MM-dd") ?? string.Empty;
    private IReadOnlyList<string> CurrentAvatars => activeCategory == "mujeres" ? womenAvatars : menAvatars;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userIdValue = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (authState.User.Identity?.IsAuthenticated != true || !int.TryParse(userIdValue, out var userId))
        {
            isLoading = false;
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        profile = await dbContext.tbl_usuarios
            .AsNoTracking()
            .Include(u => u.id_rolNavigation)
            .FirstOrDefaultAsync(u => u.id_usuario == userId);

        if (profile is not null)
        {
            ApplyAvatarSelection(profile.avatar_url);
        }

        isLoading = false;
    }

    private void OpenAvatarPicker()
    {
        showAvatarPicker = true;
    }

    private void CloseAvatarPicker()
    {
        showAvatarPicker = false;
    }

    private void ConfirmAvatarSelection()
    {
        avatarTouched = true;
        showAvatarPicker = false;
    }

    private void SelectCategory(string category)
    {
        activeCategory = category;
        if (!CurrentAvatars.Contains(selectedCharacter))
        {
            selectedCharacter = CurrentAvatars.First();
        }
    }

    private void SelectCharacter(string avatar)
    {
        selectedCharacter = avatar;
    }

    private void SelectLenses(string value)
    {
        avatarLenses = value;
    }

    private void ToggleCurrentPasswordVisibility()
    {
        showCurrentPassword = !showCurrentPassword;
    }

    private void ToggleNewPasswordVisibility()
    {
        showNewPassword = !showNewPassword;
    }

    private void ToggleConfirmPasswordVisibility()
    {
        showConfirmPassword = !showConfirmPassword;
    }

    private void ApplyAvatarSelection(string? avatarFileName)
    {
        if (string.IsNullOrWhiteSpace(avatarFileName))
        {
            return;
        }

        var fileName = System.IO.Path.GetFileNameWithoutExtension(avatarFileName);
        var parts = fileName.Split('_', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length < 2)
        {
            return;
        }

        selectedCharacter = parts[0];
        avatarLenses = string.Join('_', parts.Skip(1));
        activeCategory = womenAvatars.Contains(selectedCharacter) ? "mujeres" : "hombres";
    }
}
