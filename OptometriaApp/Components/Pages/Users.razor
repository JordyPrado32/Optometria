    private async Task<ModulePermissions> GetModulePermissionsAsync(OpticaDbContext dbContext, int roleId)
    {
        if (roleId <= 0)
        {
            return new ModulePermissions();
        }

        var permission = await dbContext.tbl_rol_menu_permisos
            .AsNoTracking()
            .Where(p => p.id_rol == roleId)
            .Join(
                dbContext.tbl_menu_apps.AsNoTracking().Where(m => m.ruta == "/users"),
                rolePermission => rolePermission.id_menu,
                menu => menu.id_menu,
                (rolePermission, _) => rolePermission)
            .FirstOrDefaultAsync();

        if (permission is null)
        {
            return new ModulePermissions();
        }

        return new ModulePermissions
        {
            CanView = permission.puede_ver,
            CanCreate = permission.puede_crear,
            CanEdit = permission.puede_editar,
            CanDelete = permission.puede_eliminar
        };
    }

    private static bool IsPasswordExpired(tbl_usuario user)
    {
        if (!user.ultimo_cambio_password.HasValue)
        {
            return true;
        }

        return DateOnly.FromDateTime(DateTime.Now) >= user.ultimo_cambio_password.Value.AddDays(90);
    }

    private static string GetStatusLabel(tbl_usuario user)
    {
        if (user.bloqueado == true)
        {
            return "Bloqueado";
        }

        return user.activo == true ? "Activo" : "Inactivo";
    }

    private static string GetPasswordStatusLabel(tbl_usuario user)
    {
        if (user.tbl_usuario_seguridad?.must_change_password == true)
        {
            return "Cambio obligatorio";
        }

        return IsPasswordExpired(user) ? "Vencida" : "Vigente";
    }

