    {
        try
        {
            await SaveUserAsync();
        }
        catch (Exception ex)
        {
            errorMessage = GetInnermostMessage(ex);
        }
    }

    private async Task ResetPasswordAsync(tbl_usuario user)
    {
        errorMessage = null;

        if (!permissions.CanEdit || user is null || user.id_usuario <= 0)
        {
            return;
        }

        if (!EmailSender.IsConfigured())
        {
            ShowAlert("SMTP no configurado. Completa la sección Smtp en appsettings.json.", true);
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var userEntity = await dbContext.tbl_usuarios
            .Include(u => u.tbl_usuario_seguridad)
            .FirstOrDefaultAsync(u => u.id_usuario == user.id_usuario);

        if (userEntity is null)
        {
            ShowAlert("No se encontró el usuario seleccionado.", true);
            return;
        }

        if (string.IsNullOrWhiteSpace(userEntity.email))
        {
            ShowAlert("El usuario no tiene un correo registrado para enviar la clave temporal.", true);
            return;
        }

        var security = userEntity.tbl_usuario_seguridad ?? new tbl_usuario_seguridad
        {
            id_usuario = userEntity.id_usuario,
            created_at = DateTime.Now
        };

        if (userEntity.tbl_usuario_seguridad is null)
        {
            dbContext.tbl_usuario_seguridad.Add(security);
            userEntity.tbl_usuario_seguridad = security;
        }

        var temporaryPassword = AuthenticatorService.GenerateTemporaryPassword();
        var minutesValid = Math.Max(5, SecurityOptions.Value.TemporaryPasswordMinutesValid);

        security.recovery_password_hash = PasswordHasher.HashPassword(userEntity, temporaryPassword);
        security.recovery_password_expires_at = DateTime.Now.AddMinutes(minutesValid);
        security.must_change_password = true;
        security.updated_at = DateTime.Now;
        userEntity.bloqueado = false;
        userEntity.intentos_fallidos = 0;

        WriteAudit(
            dbContext,
            "Resetear clave",
            $"UsuarioId={userEntity.id_usuario}; Usuario={userEntity.usuario}; Método=Clave temporal por correo");

        await dbContext.SaveChangesAsync();

        await EmailQueue.QueueTemporaryPasswordEmailAsync(
            userEntity.email,
            $"{userEntity.nombres} {userEntity.apellidos}".Trim(),
            temporaryPassword,
            minutesValid);

        ShowAlert("Se envió una clave temporal al correo del usuario.", false);
        await LoadAsync(userEntity.id_usuario);
    }

    private async Task DisableMfaAsync(tbl_usuario? user)
    {
        errorMessage = null;

        if (!permissions.CanEdit || user is null || user.id_usuario <= 0)
        {
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var userEntity = await dbContext.tbl_usuarios
            .Include(u => u.tbl_usuario_seguridad)
            .FirstOrDefaultAsync(u => u.id_usuario == user.id_usuario);

        if (userEntity is null)
        {
            ShowAlert("No se encontró el usuario seleccionado.", true);
            return;
        }

        var security = userEntity.tbl_usuario_seguridad;
        if (security is null || (!security.two_factor_enabled && string.IsNullOrWhiteSpace(security.authenticator_secret)))
        {
            ShowAlert("El usuario no tiene MFA activo.", true);
            return;
        }

        security.two_factor_enabled = false;
        security.authenticator_secret = null;
        security.updated_at = DateTime.Now;

        WriteAudit(
            dbContext,
            "Desactivar MFA",
            $"UsuarioId={userEntity.id_usuario}; Usuario={userEntity.usuario}; Motivo=Recuperacion por perdida de acceso");

        await dbContext.SaveChangesAsync();

        ShowAlert("Se desactivó MFA para el usuario seleccionado.", false);
        showFormModal = false;
        await LoadAsync(userEntity.id_usuario);
    }

    private async Task ToggleActiveAsync(tbl_usuario user)
    {
        errorMessage = null;

        if (!permissions.CanDelete || user is null || user.id_usuario <= 0)
        {
            return;
        }

        if (user.id_usuario == currentUserId && (user.activo ?? false))
        {
            ShowAlert("No puedes desactivar tu propio usuario.", true);
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var userEntity = await dbContext.tbl_usuarios.FirstOrDefaultAsync(u => u.id_usuario == user.id_usuario);
        if (userEntity is null)
        {
            ShowAlert("No se encontró el usuario seleccionado.", true);
            return;
        }

        userEntity.activo = !(userEntity.activo ?? false);
        WriteAudit(
            dbContext,
            userEntity.activo == true ? "Reactivar usuario" : "Desactivar usuario",
            $"UsuarioId={userEntity.id_usuario}; Usuario={userEntity.usuario}; Activo={(userEntity.activo == true ? "Si" : "No")}");
        await dbContext.SaveChangesAsync();

        ShowAlert(userEntity.activo == true
            ? "El usuario fue reactivado correctamente."
            : "El usuario fue desactivado correctamente.", false);

        await LoadAsync(userEntity.id_usuario);
    }

    private void ExportUsers()
    {
        var query = new List<string>();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query.Add($"search={Uri.EscapeDataString(searchTerm)}");
        }

        if (!string.IsNullOrWhiteSpace(selectedRoleFilter))
        {
            query.Add($"roleId={Uri.EscapeDataString(selectedRoleFilter)}");
        }

        if (!string.Equals(selectedStatusFilter, "all", StringComparison.OrdinalIgnoreCase))
        {
            query.Add($"status={Uri.EscapeDataString(selectedStatusFilter)}");
        }

        if (!string.Equals(selectedPasswordFilter, "all", StringComparison.OrdinalIgnoreCase))
        {
            query.Add($"passwordState={Uri.EscapeDataString(selectedPasswordFilter)}");
        }

        var exportUrl = query.Count == 0
            ? "/exports/users.csv"
            : $"/exports/users.csv?{string.Join("&", query)}";

        NavigationManager.NavigateTo(exportUrl, forceLoad: true);
    }

    private async Task LoadAuditEntriesAsync(int userId)
