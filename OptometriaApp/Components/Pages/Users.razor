@code {
    private readonly List<tbl_usuario> users = [];
    private List<tbl_rol> roles = [];
    private List<tbl_log_auditoria> auditEntries = [];
    private UserEditorModel? editor;
    private ModulePermissions permissions = new();
    private bool isLoading = true;
    private bool canViewUsers;
    private bool isCreatingNewUser;
    private int userPage = 1;
    private int selectedUserId;
    private int currentUserId;
    private int currentRoleId;
    private string searchTerm = string.Empty;
    private string selectedRoleFilter = string.Empty;
    private string selectedStatusFilter = "all";
    private string selectedPasswordFilter = "all";
    private string? errorMessage;

    // Modals & custom alerts state:
    private bool showFormModal;
    private bool showAuditModal;
    private bool showAlertModal;
    private string alertMessage = string.Empty;
    private bool alertIsError;
    private string TodayDateIso => DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
    private tbl_usuario? selectedUser;

    private List<tbl_usuario> FilteredUsers => users
        .Where(MatchesFilters)
        .OrderBy(u => u.apellidos)
        .ThenBy(u => u.nombres)
        .ToList();
    private const int PageSize = 5;
    private int TotalUserPages => Math.Max(1, (int)Math.Ceiling(FilteredUsers.Count / (double)PageSize));
    private int CurrentUserPage => Math.Clamp(userPage, 1, TotalUserPages);
    private IEnumerable<tbl_usuario> PagedUsers => FilteredUsers
        .Skip((CurrentUserPage - 1) * PageSize)
        .Take(PageSize);

    private string EditorTitle => isCreatingNewUser ? "Nuevo usuario" : "Detalle del usuario";
    private string EditorSubtitle => isCreatingNewUser ? "Alta administrativa" : (selectedUserId > 0 ? $"Usuario #{selectedUserId}" : "Vista");
    private bool CanModifyEditor => isCreatingNewUser ? permissions.CanCreate : permissions.CanEdit;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var parsedUserId) ? parsedUserId : 0;
        currentRoleId = int.TryParse(authState.User.FindFirst("RoleId")?.Value, out var parsedRoleId) ? parsedRoleId : 0;

        await LoadAsync();
    }

    private async Task LoadAsync(int? preserveSelectedUserId = null)
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();

        permissions = await GetModulePermissionsAsync(dbContext, currentRoleId);
        canViewUsers = permissions.CanView;

        if (!canViewUsers)
        {
            isLoading = false;
            return;
        }

        roles = await dbContext.tbl_rols
            .AsNoTracking()
            .OrderBy(r => r.nombre)
            .ToListAsync();

        var loadedUsers = await dbContext.tbl_usuarios
            .AsNoTracking()
            .Include(u => u.id_rolNavigation)
            .Include(u => u.tbl_usuario_seguridad)
            .ToListAsync();

        users.Clear();
        users.AddRange(loadedUsers);

        if (preserveSelectedUserId.HasValue)
        {
            selectedUserId = preserveSelectedUserId.Value;
            var currentUser = users.FirstOrDefault(u => u.id_usuario == selectedUserId);
            if (currentUser is not null)
            {
                editor = BuildEditor(currentUser);
            }
        }

        isLoading = false;
    }

    private void PrepareNewUser()
    {
        if (!permissions.CanCreate)
        {
            ShowAlert("Tu rol no tiene permiso para crear usuarios.", true);
            return;
        }

        isCreatingNewUser = true;
        selectedUserId = 0;
        editor = BuildNewEditor();
        auditEntries = [];
        errorMessage = null;
        showFormModal = true;
    }

    private void PrepareEditUser(tbl_usuario user)
    {
        isCreatingNewUser = false;
        selectedUserId = user.id_usuario;
        selectedUser = user;
        editor = BuildEditor(user);
        errorMessage = null;
        showFormModal = true;
    }

    private async Task PrepareAuditUser(tbl_usuario user)
    {
        selectedUser = user;
        await LoadAuditEntriesAsync(user.id_usuario);
        showAuditModal = true;
    }

    private void ShowAlert(string message, bool isError)
    {
        alertMessage = message;
        alertIsError = isError;
        showAlertModal = true;
        StateHasChanged();
    }

    private void CloseAlertModal()
    {
        showAlertModal = false;
        alertMessage = string.Empty;
    }

    private void CloseFormModal()
    {
        errorMessage = null;
        showFormModal = false;
    }

    private void PreviousUserPage()
    {
        if (userPage > 1)
        {
            userPage--;
        }
    }

    private void NextUserPage()
    {
        if (userPage < TotalUserPages)
        {
            userPage++;
        }
    }

    private async Task SaveUserAsync()
    {
        errorMessage = null;

        if (editor is null)
        {
            ShowAlert("Selecciona o crea un usuario antes de guardar.", true);
            return;
        }

        if (!ValidateEditor())
        {
            ShowAlert(errorMessage ?? "Error de validación.", true);
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();

        var normalizedUserName = editor.Usuario.Trim().ToLowerInvariant();
        var normalizedEmail = editor.Email.Trim().ToLowerInvariant();

        var userNameInUse = await dbContext.tbl_usuarios
            .AnyAsync(u => u.id_usuario != editor.IdUsuario && u.usuario.ToLower() == normalizedUserName);

        if (userNameInUse)
        {
            ShowAlert("El nombre de usuario ya está registrado.", true);
            return;
        }

        var emailInUse = await dbContext.tbl_usuarios
            .AnyAsync(u => u.id_usuario != editor.IdUsuario && u.email != null && u.email.ToLower() == normalizedEmail);

        if (emailInUse)
        {
            ShowAlert("El correo electrónico ya está registrado.", true);
            return;
        }

        if (isCreatingNewUser)
        {
            if (!permissions.CanCreate)
            {
                ShowAlert("Tu rol no tiene permiso para crear usuarios.", true);
                return;
            }

            var passwordValidationError = ValidatePasswordForAdmin(editor.Password, editor.Usuario, editor.Nombres, editor.Apellidos, editor.Email);
            if (passwordValidationError is not null)
            {
                ShowAlert(passwordValidationError, true);
                return;
            }

            var newUser = new tbl_usuario
            {
                id_rol = editor.IdRol,
                nombres = editor.Nombres.Trim(),
                apellidos = editor.Apellidos.Trim(),
                email = editor.Email.Trim(),
                usuario = editor.Usuario.Trim(),
                telefono = string.IsNullOrWhiteSpace(editor.Telefono) ? null : editor.Telefono.Trim(),
                fecha_nacimiento = ParseBirthDate(editor.FechaNacimiento),
                activo = true,
                bloqueado = false,
                intentos_fallidos = 0,
                fecha_creacion = DateTime.Now,
                ultimo_cambio_password = DateOnly.FromDateTime(DateTime.Now)
            };

            newUser.password_hash = PasswordHasher.HashPassword(newUser, editor.Password);

            dbContext.tbl_usuarios.Add(newUser);
            await dbContext.SaveChangesAsync();

            dbContext.tbl_usuario_seguridad.Add(new tbl_usuario_seguridad
            {
                id_usuario = newUser.id_usuario,
                two_factor_enabled = false,
                must_change_password = false,
                created_at = DateTime.Now,
                updated_at = DateTime.Now
            });

            WriteAudit(
                dbContext,
                "Crear usuario",
                $"UsuarioId={newUser.id_usuario}; Usuario={newUser.usuario}; RolId={newUser.id_rol}; Correo={newUser.email}");

            await dbContext.SaveChangesAsync();

            ShowAlert("El usuario se creó correctamente.", false);
            showFormModal = false;
            isCreatingNewUser = false;
            await LoadAsync(newUser.id_usuario);
            return;
        }

        if (!permissions.CanEdit)
        {
            ShowAlert("Tu rol no tiene permiso para editar usuarios.", true);
            return;
        }

        var userEntity = await dbContext.tbl_usuarios.FirstOrDefaultAsync(u => u.id_usuario == editor.IdUsuario);
        if (userEntity is null)
        {
            ShowAlert("No se encontró el usuario seleccionado.", true);
            return;
        }

        userEntity.id_rol = editor.IdRol;
        userEntity.usuario = editor.Usuario.Trim();
        userEntity.email = editor.Email.Trim();
        userEntity.nombres = editor.Nombres.Trim();
        userEntity.apellidos = editor.Apellidos.Trim();
        userEntity.telefono = string.IsNullOrWhiteSpace(editor.Telefono) ? null : editor.Telefono.Trim();
        userEntity.fecha_nacimiento = ParseBirthDate(editor.FechaNacimiento);

        WriteAudit(
            dbContext,
            "Editar usuario",
            $"UsuarioId={userEntity.id_usuario}; Usuario={userEntity.usuario}; RolId={userEntity.id_rol}; Correo={userEntity.email}");

        await dbContext.SaveChangesAsync();

        ShowAlert("La información del usuario se guardó correctamente.", false);
        showFormModal = false;
        await LoadAsync(userEntity.id_usuario);
    }

