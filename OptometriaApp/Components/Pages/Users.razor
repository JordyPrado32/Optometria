@page "/users"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@using System.Net.Mail
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Identity
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject IPasswordHasher<tbl_usuario> PasswordHasher
@inject AuthenticatorService AuthenticatorService
@inject EmailSender EmailSender
@inject IEmailBackgroundQueue EmailQueue
@inject IOptions<SecuritySettings> SecurityOptions
@inject NavigationManager NavigationManager

<PageTitle>Usuarios</PageTitle>

@if (isLoading)
{
    <section class="management-shell">
        <div class="management-card">
            <h1>Cargando usuarios...</h1>
        </div>
    </section>
}
else if (!canViewUsers)
{
    <section class="management-shell">
        <div class="management-card">
            <span class="eyebrow">Restringido</span>
            <h1>Gestion de usuarios</h1>
            <p>Tu rol no tiene permiso para ver este modulo.</p>
        </div>
    </section>
}
else
{
    <section class="management-shell">
        <div class="management-hero">
            <div>
                <span class="eyebrow">Administración</span>
                <h1>Usuarios</h1>
                <p>Consulta, crea y administra cuentas con control por permisos, clave temporal por correo y exportación a CSV.</p>
            </div>

            <div class="workspace-actions">
                @if (permissions.CanCreate)
                {
                    <button type="button" class="btn btn-primary" @onclick="PrepareNewUser">
                        <i class="bi bi-person-plus-fill" style="margin-right: 6px;"></i> Nuevo usuario
                    </button>
                }

                <button type="button" class="btn btn-outline-primary" @onclick="ExportUsers">Exportar CSV</button>
            </div>
        </div>

        <section class="management-card">
            <div class="management-card-header">
                <h2>Filtros y búsqueda</h2>
                <span>@FilteredUsers.Count resultados</span>
            </div>

            <div class="filters-row">
                <div>
                    <label class="form-label" for="userSearch">Buscador</label>
                    <input id="userSearch" class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Usuario, nombre, correo o teléfono" />
                </div>

                <div class="filter-selects-col">
                    <div>
                        <label class="form-label" for="roleFilter">Rol</label>
                        <select id="roleFilter" class="form-select" @bind="selectedRoleFilter">
                            <option value="">Todos</option>
                            @foreach (var role in roles)
                            {
                                <option value="@role.id_rol.ToString()">@role.nombre</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label" for="statusFilter">Estado</label>
                        <select id="statusFilter" class="form-select" @bind="selectedStatusFilter">
                            <option value="all">Todos</option>
                            <option value="active">Activos</option>
                            <option value="inactive">Inactivos</option>
                            <option value="blocked">Bloqueados</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label" for="passwordFilter">Clave</label>
                        <select id="passwordFilter" class="form-select" @bind="selectedPasswordFilter">
                            <option value="all">Todas</option>
                            <option value="current">Vigente</option>
                            <option value="expired">Vencida</option>
                            <option value="mustchange">Cambio obligatorio</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="management-actions" style="margin-top: 1rem;">
                <button type="button" class="btn btn-outline-primary" @onclick="ClearFilters">Limpiar filtros</button>
            </div>
        </section>

        <!-- Users Table Card (Full Width) -->
        <section class="management-card" style="margin-top: 1.5rem;">
            <div class="management-card-header">
                <h2>Listado de Usuarios</h2>
                <span>@FilteredUsers.Count registrados</span>
            </div>

            <div class="table-responsive" style="margin-top: 1rem;">
                <table class="management-table soft-management-table">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Nombre Completo</th>
                            <th>Correo</th>
                            <th>Teléfono</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th>Seguridad Clave</th>
                            <th style="text-align: right; padding-right: 1.5rem;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredUsers.Count == 0)
                        {
                            <tr>
                                <td colspan="8" style="text-align: center; padding: 2rem; color: var(--color-taupe);">
                                    No se encontraron usuarios registrados con los filtros seleccionados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var u in PagedUsers)
                            {
                                <tr>
                                    <td>
                                        <strong style="color: var(--color-sage);">@u.usuario</strong>
                                    </td>
                                    <td>
                                        <strong style="color: var(--color-ink);">@($"{u.nombres} {u.apellidos}")</strong>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(u.email) ? "-" : u.email)</td>
                                    <td>@(string.IsNullOrWhiteSpace(u.telefono) ? "-" : u.telefono)</td>
                                    <td>
                                        <span class="badge" style="background: rgba(127, 105, 81, 0.08) !important; color: var(--color-taupe-deep) !important; padding: 0.3rem 0.6rem; border-radius: 2rem;">
                                            @u.id_rolNavigation?.nombre
                                        </span>
                                    </td>
                                    <td>
                                        @if (u.activo == true)
                                        {
                                            @if (u.bloqueado == true)
                                            {
                                                <span class="badge" style="background: rgba(254, 188, 100, 0.15) !important; color: #e09b3c !important; padding: 0.3rem 0.6rem; border-radius: 2rem;">Bloqueado</span>
                                            }
                                            else
                                            {
                                                <span class="badge" style="background: rgba(93, 161, 129, 0.15) !important; color: #5DA181 !important; padding: 0.3rem 0.6rem; border-radius: 2rem;">Activo</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge" style="background: rgba(127, 105, 81, 0.12) !important; color: #7F6951 !important; padding: 0.3rem 0.6rem; border-radius: 2rem;">Inactivo</span>
                                        }
                                    </td>
                                    <td>
                                        <span style="font-size: 0.8rem;">@GetPasswordStatusLabel(u)</span>
                                    </td>
                                    <td style="text-align: right; padding-right: 1.2rem;">
                                        <div style="display: inline-flex; gap: 0.4rem; justify-content: flex-end;">
                                            <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(93, 161, 129, 0.3) !important; color: var(--color-sage) !important;" @onclick="() => PrepareEditUser(u)">
                                                <i class="bi bi-pencil-fill" style="margin-right: 4px;"></i> Editar
                                            </button>
                                            @if (permissions.CanEdit)
                                            {
                                                <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(127, 105, 81, 0.25) !important; color: var(--color-taupe-deep) !important;" @onclick="() => ResetPasswordAsync(u)" title="Enviar clave temporal">
                                                    <i class="bi bi-key-fill"></i> Clave
                                                </button>
                                            }
                                            <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(254, 188, 100, 0.4) !important; color: #e09b3c !important;" @onclick="() => PrepareAuditUser(u)">
                                                <i class="bi bi-clock-history"></i> Auditoría
                                            </button>
                                            @if (permissions.CanDelete)
                                            {
                                                @if (u.activo == true)
                                                {
                                                    <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(127, 105, 81, 0.2) !important; color: var(--color-taupe) !important;" @onclick="() => ToggleActiveAsync(u)">
                                                        Desactivar
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; background-color: var(--color-sage) !important; border-color: var(--color-sage) !important;" @onclick="() => ToggleActiveAsync(u)">
                                                        Activar
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="table-pager">
                <button type="button" class="btn btn-outline-primary compact-action" @onclick="PreviousUserPage" disabled="@(CurrentUserPage <= 1)">Anterior</button>
                <span>Pagina @CurrentUserPage de @TotalUserPages</span>
                <button type="button" class="btn btn-outline-primary compact-action" @onclick="NextUserPage" disabled="@(CurrentUserPage >= TotalUserPages)">Siguiente</button>
            </div>
        </section>
    </section>
}

<!-- Custom Form Modal -->
@if (showFormModal && editor is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card form-modal-card">
            <header class="custom-modal-header rose-header">
                <h2>@EditorTitle</h2>
                <button type="button" class="btn-close-modal" @onclick="CloseFormModal">×</button>
            </header>
            <div class="custom-modal-body">
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger" role="alert">@errorMessage</div>
                }

                <div class="management-form-grid">
                    <div>
                        <label class="form-label" for="editNames">Nombres</label>
                        <input id="editNames" class="form-control" @bind="editor.Nombres" readonly="@(!CanModifyEditor)" />
                    </div>

                    <div>
                        <label class="form-label" for="editLastNames">Apellidos</label>
                        <input id="editLastNames" class="form-control" @bind="editor.Apellidos" readonly="@(!CanModifyEditor)" />
                    </div>

                    <div>
                        <label class="form-label" for="editUserName">Usuario</label>
                        <input id="editUserName" class="form-control" @bind="editor.Usuario" readonly="@(!CanModifyEditor)" />
                    </div>

                    <div>
                        <label class="form-label" for="editEmail">Correo</label>
                        <input id="editEmail" type="email" class="form-control" @bind="editor.Email" readonly="@(!CanModifyEditor)" />
                    </div>

                    <div>
                        <label class="form-label" for="editPhone">Teléfono</label>
                        <input id="editPhone" class="form-control" @bind="editor.Telefono" readonly="@(!CanModifyEditor)" />
                    </div>

                    <div>
                        <label class="form-label" for="editBirthDate">Fecha de nacimiento</label>
                        <input id="editBirthDate"
                               type="date"
                               class="form-control"
                               value="@editor.FechaNacimiento"
                               @onchange="OnBirthDateChanged"
                               max="@TodayDateIso"
                               readonly="@(!CanModifyEditor)" />
                    </div>

                    <div>
                        <label class="form-label" for="editRole">Rol</label>
                        <select id="editRole" class="form-select" @bind="editor.IdRol" disabled="@(!CanModifyEditor)">
                            @foreach (var role in roles)
                            {
                                <option value="@role.id_rol">@role.nombre</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label">Estado actual</label>
                        <input class="form-control" value="@GetEditorStatusText()" readonly />
                    </div>
                </div>

                @if (isCreatingNewUser)
                {
                    <div class="profile-password-section" style="margin-top: 1.5rem; border-top: 1px solid rgba(127, 105, 81, 0.08); padding-top: 1.2rem;">
                        <div class="management-card-header" style="margin-bottom: 1rem;">
                            <h3>Credenciales iniciales</h3>
                        </div>

                        <div class="auth-grid">
                            <div>
                                <label class="form-label" for="newPassword">Contraseña inicial</label>
                                <input id="newPassword" type="password" class="form-control" @bind="editor.Password" />
                            </div>

                            <div>
                                <label class="form-label" for="confirmNewPassword">Confirmar contraseña</label>
                                <input id="confirmNewPassword" type="password" class="form-control" @bind="editor.ConfirmPassword" />
                            </div>
                        </div>
                    </div>
                }
            </div>
            <footer class="custom-modal-footer">
                @if (CanModifyEditor)
                {
                    <button type="button" class="btn btn-primary" @onclick="SaveUserWithHandlingAsync">Guardar cambios</button>
                }
                @if (!isCreatingNewUser && permissions.CanEdit)
                {
                    <button type="button" class="btn btn-outline-primary" @onclick="() => DisableMfaAsync(selectedUser)" disabled="@(!editor.TwoFactorEnabled)">Desactivar MFA</button>
                }
                <button type="button" class="btn btn-outline-primary" @onclick="CloseFormModal">Cerrar</button>
            </footer>
        </div>
    </div>
}

<!-- Custom Audit Modal -->
@if (showAuditModal && selectedUser is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card audit-modal-card">
            <header class="custom-modal-header apricot-header">
                <h2>Historial de Auditoría - @($"{selectedUser.nombres} {selectedUser.apellidos}")</h2>
                <button type="button" class="btn-close-modal" @onclick="() => showAuditModal = false">×</button>
            </header>
            <div class="custom-modal-body">
                @if (auditEntries.Count == 0)
                {
                    <p style="text-align: center; color: var(--color-taupe); margin: 2rem 0;">No hay eventos registrados para este usuario en este módulo.</p>
                }
                else
                {
                    <div class="management-list">
                        @foreach (var auditEntry in auditEntries)
                        {
                            <article class="management-list-item" style="border: 1px solid rgba(127, 105, 81, 0.08); border-radius: 0.8rem; padding: 0.95rem; margin-bottom: 0.6rem; background: #faf8f4;">
                                <div style="display: flex; justify-content: space-between; margin-bottom: 0.35rem;">
                                    <strong style="color: var(--color-sage);">@auditEntry.accion</strong>
                                    <span style="font-size: 0.78rem; color: var(--color-taupe);">@(auditEntry.fecha?.ToString("yyyy-MM-dd HH:mm") ?? "Sin fecha")</span>
                                </div>
                                <div style="font-size: 0.82rem; color: var(--color-ink); margin-bottom: 0.35rem;">@auditEntry.detalle</div>
                                <span style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-taupe); opacity: 0.8;">@GetAuditActorLabel(auditEntry)</span>
                            </article>
                        }
                    </div>
                }
            </div>
            <footer class="custom-modal-footer">
                <button type="button" class="btn btn-outline-primary" @onclick="() => showAuditModal = false">Cerrar</button>
            </footer>
        </div>
    </div>
}

<!-- Custom Alert Modal -->
@if (showAlertModal)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card alert-modal-card">
            <header class="custom-modal-header @(alertIsError ? "error-header" : "success-header")">
                <h2>@(alertIsError ? "Error de Validación" : "Operación Exitosa")</h2>
            </header>
            <div class="custom-modal-body" style="padding: 2rem 1.5rem; text-align: center;">
                <div style="font-size: 3rem; margin-bottom: 1rem; color: @(alertIsError ? "#7F6951" : "#5DA181")">
                    <i class="bi @(alertIsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")"></i>
                </div>
                <p style="font-size: 1rem; color: var(--color-ink); line-height: 1.5; margin: 0;">@alertMessage</p>
            </div>
            <footer class="custom-modal-footer" style="justify-content: center; background: transparent; border-top: none; padding-top: 0;">
                <button type="button" class="btn btn-primary" style="min-width: 120px;" @onclick="CloseAlertModal">Aceptar</button>
            </footer>
        </div>
    </div>
}

