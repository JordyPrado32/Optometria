@page "/ordenes-de-compra"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@using OptometriaApp.Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject NavigationManager NavigationManager

<PageTitle>Ordenes de compra</PageTitle>

@if (isLoading)
{
    <section class="management-shell"><div class="management-card"><h1>Cargando ordenes...</h1></div></section>
}
else if (!canView)
{
    <section class="management-shell"><div class="management-card"><h1>Sin acceso</h1><p>Tu rol no tiene permiso para este modulo.</p></div></section>
}
else
{
    <section class="management-shell">
        <div class="management-hero">
            <div>
                <span class="eyebrow">Compras</span>
                <h1>Ordenes de compra</h1>
                <p>Cada usuario administra sus propias ordenes, lineas de producto y seguimiento de recepcion.</p>
            </div>
            <div class="workspace-actions" style="align-items: center;">
                @if (permissions.CanCreate)
                {
                    <button type="button" class="btn btn-coffee" @onclick="PrepareNew">
                        <i class="bi bi-plus-lg" style="margin-right: 6px;"></i> Nueva orden
                    </button>
                }
                <button type="button" class="btn btn-excel" @onclick="ExportOrders">
                    <i class="bi bi-file-earmark-excel-fill" style="margin-right: 6px;"></i> Exportar Excel
                </button>
                <button type="button" class="btn btn-outline-primary" @onclick="ExportOrdersPdf">
                    <i class="bi bi-file-earmark-pdf-fill" style="margin-right: 6px;"></i> Exportar PDF
                </button>
            </div>
        </div>

        <section class="management-card compact-filter-card">
            <div class="management-card-header">
                <h2>Filtros</h2>
                <span>@FilteredOrders.Count resultados</span>
            </div>
            <div class="filters-row-2">
                <div>
                    <label class="form-label">Buscar</label>
                    <input class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Numero, proveedor o referencia" />
                </div>
                <div class="filter-selects-col-2">
                    <div>
                        <label class="form-label">Estado</label>
                        <select class="form-select" @bind="stateFilter">
                            <option value="">Todos</option>
                            @foreach (var option in stateOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Proveedor</label>
                        <select class="form-select" @bind="supplierFilter">
                            <option value="">Todos</option>
                            @foreach (var supplier in suppliers.OrderBy(s => s.nombre))
                            {
                                <option value="@supplier.id_proveedor.ToString()">@supplier.nombre</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="filters-row-2" style="margin-top: 0.75rem;">
                <div>
                    <label class="form-label">Desde</label>
                    <input type="date" class="form-control" value="@dateFromFilter" @onchange="OnDateFromChanged" />
                </div>
                <div>
                    <label class="form-label">Hasta</label>
                    <input type="date" class="form-control" value="@dateToFilter" @onchange="OnDateToChanged" />
                </div>
            </div>
            <div class="management-actions" style="margin-top: 0.3rem;">
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ClearFilters" style="padding: 0.3rem 0.7rem !important; font-size: 0.78rem !important; border-color: rgba(127,105,81,0.25) !important;">
                    <i class="bi bi-trash" style="margin-right: 4px;"></i> Limpiar filtros
                </button>
            </div>
        </section>

        <section class="management-card" style="margin-top: 1.5rem;">
            <div class="management-card-header">
                <h2>Ordenes</h2>
                <span>@FilteredOrders.Count registradas</span>
            </div>
            <div class="table-responsive" style="margin-top: 1rem;">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Numero</th>
                            <th>Proveedor</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th>Total</th>
                            <th>Lineas</th>
                            <th style="text-align:right;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredOrders.Count == 0)
                        {
                            <tr><td colspan="7" style="text-align:center; padding:2rem;">No hay ordenes.</td></tr>
                        }
                        else
                        {
                            @foreach (var order in PagedOrders)
                            {
                                <tr>
                                    <td><strong>@order.numero_orden</strong></td>
                                    <td>@order.id_proveedorNavigation?.nombre</td>
                                    <td>@order.fecha_orden?.ToString("yyyy-MM-dd")</td>
                                    <td>@order.estado_orden</td>
                                    <td>@(order.total?.ToString("0.00") ?? "0.00")</td>
                                    <td>@order.tbl_detalle_orden_compra.Count</td>
                                    <td style="text-align:right;">
                                        <div style="display:inline-flex; gap:0.4rem;">
                                            <button class="btn btn-outline-primary" @onclick="() => PrepareEdit(order)">
                                                <i class="bi bi-pencil-fill"></i> Editar
                                            </button>
                                            <button class="btn btn-outline-primary" @onclick="() => ShowAudit(order)">
                                                <i class="bi bi-clock-history"></i> Auditoria
                                            </button>
                                            <a class="btn btn-outline-primary" href="@GetOrderXmlUrl(order.id_orden_compra)" target="_blank" rel="noopener noreferrer">
                                                <i class="bi bi-filetype-xml"></i> XML
                                            </a>
                                            @if (permissions.CanDelete)
                                            {
                                                <button class="btn btn-outline-primary" @onclick="() => DeleteAsync(order)">
                                                    <i class="bi bi-trash3-fill"></i> Eliminar
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <TablePager TotalItems="@FilteredOrders.Count" CurrentPage="@orderPage" CurrentPageChanged="SetOrderPage" />
        </section>
    </section>
}

@if (showForm && editor is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card form-modal-card">
            <header class="custom-modal-header rose-header">
                <h2>@(isCreating ? "Nueva orden de compra" : "Editar orden de compra")</h2>
                <button type="button" class="btn-close-modal" @onclick="CloseForm">×</button>
            </header>
            <div class="custom-modal-body">
                <p class="required-fields-note">Los campos marcados con * son obligatorios.</p>
                <div class="management-form-grid">
                    <div>
                        <label class="form-label">Numero <span class="field-required">*</span></label>
                        <input class="form-control" @bind="editor.NumeroOrden" maxlength="20" />
                    </div>
                    <div>
                        <label class="form-label">Proveedor <span class="field-required">*</span></label>
                        <select class="form-select" @bind="editor.IdProveedor">
                            <option value="0">Selecciona</option>
                            @foreach (var supplier in suppliers.OrderBy(s => s.nombre))
                            {
                                <option value="@supplier.id_proveedor">@supplier.nombre</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Fecha requerida <span class="field-required">*</span> <span style="font-size: 0.8rem; color: var(--color-taupe); font-weight: normal;">(dd/mm/aaaa)</span></label>
                        <input type="date" class="form-control" @bind="editor.FechaRequerida" min="@TodayDateIso" />
                    </div>
                    <div>
                        <label class="form-label">Recepcion esperada <span class="field-required">*</span> <span style="font-size: 0.8rem; color: var(--color-taupe); font-weight: normal;">(dd/mm/aaaa)</span></label>
                        <input type="date" class="form-control" @bind="editor.FechaRecepcionEsperada" min="@TodayDateIso" />
                    </div>
                    <div>
                        <label class="form-label">Estado <span class="field-required">*</span></label>
                        <select class="form-select" @bind="editor.EstadoOrden">
                            @foreach (var option in stateOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                    <details class="additional-details">
                        <summary><span><i class="bi bi-info-circle"></i> Detalles adicionales</span></summary>
                        <div class="additional-details-body">
                            <div>
                                <label class="form-label">Condicion pago</label>
                                <select class="form-select" @bind="editor.CondicionPago">
                                    @foreach (var option in paymentOptions)
                                    {
                                        <option value="@option">@option</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="form-label">Dias credito</label>
                                <input type="number" class="form-control" @bind="editor.DiasCredito" min="0" />
                            </div>
                            <div>
                                <label class="form-label">Moneda</label>
                                <input class="form-control" @bind="editor.Moneda" maxlength="3" />
                            </div>
                            <div>
                                <label class="form-label">Referencia externa</label>
                                <input class="form-control" @bind="editor.ReferenciaExterna" maxlength="100" />
                            </div>
                            <div class="patient-form-span">
                                <label class="form-label">Observaciones</label>
                                <textarea class="form-control" rows="3" @bind="editor.Observaciones"></textarea>
                            </div>
                        </div>
                    </details>
                </div>

                <div class="management-card" style="margin-top:1rem; padding:1rem;">
                    <div class="management-card-header">
                        <h2>Lineas</h2>
                        <button type="button" class="btn btn-outline-primary" @onclick="AddLine">Agregar linea</button>
                    </div>
                    <div style="display:grid; gap:0.8rem; margin-top:1rem;">
                        @for (var i = 0; i < editor.Lines.Count; i++)
                        {
                            var line = editor.Lines[i];
                            <div class="management-form-grid" style="padding:0.8rem; border:1px solid rgba(127,105,81,0.1); border-radius:12px;">
                                <div>
                                    <label class="form-label">Producto <span class="field-required">*</span></label>
                                    <select class="form-select" @bind="line.IdProducto">
                                        <option value="0">Selecciona</option>
                                        @foreach (var product in products.OrderBy(p => p.nombre_producto))
                                        {
                                            <option value="@product.id_producto">@product.nombre_producto</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label">Cantidad <span class="field-required">*</span></label>
                                    <input type="number" class="form-control" @bind="line.CantidadSolicitada" min="1" />
                                </div>
                                <div>
                                    <label class="form-label">Precio unitario <span class="field-required">*</span></label>
                                    <input type="number" step="0.01" class="form-control" @bind="line.PrecioUnitario" min="0" />
                                </div>
                                <details class="additional-details">
                                    <summary><span><i class="bi bi-info-circle"></i> Detalles adicionales</span></summary>
                                    <div class="additional-details-body">
                                        <div>
                                            <label class="form-label">Descuento %</label>
                                            <input type="number" step="0.01" class="form-control" @bind="line.DescuentoLinea" min="0" />
                                        </div>
                                        <div>
                                            <label class="form-label">Observaciones linea</label>
                                            <input class="form-control" @bind="line.Observaciones" maxlength="500" />
                                        </div>
                                    </div>
                                </details>
                                <div>
                                    <button type="button" class="btn btn-outline-primary" @onclick="() => RemoveLine(i)">Quitar</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <footer class="custom-modal-footer">
                <button type="button" class="btn btn-primary" @onclick="SaveAsync">Guardar</button>
                <button type="button" class="btn btn-outline-primary" @onclick="CloseForm">Cerrar</button>
            </footer>
        </div>
    </div>
}

@if (showAudit && selectedOrder is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card audit-modal-card">
            <header class="custom-modal-header apricot-header">
                <h2>Auditoria - @selectedOrder.numero_orden</h2>
                <button type="button" class="btn-close-modal" @onclick="() => showAudit = false">×</button>
            </header>
            <div class="custom-modal-body">
                @foreach (var item in auditEntries)
                {
                    <article class="management-list-item" style="border:1px solid rgba(127,105,81,0.08); border-radius:12px; padding:0.85rem; margin-bottom:0.6rem;">
                        <strong>@item.accion</strong>
                        <div>@item.detalle</div>
                        <small>@item.fecha?.ToString("yyyy-MM-dd HH:mm")</small>
                    </article>
                }
                @if (auditEntries.Count == 0)
                {
                    <p>No hay eventos registrados.</p>
                }
            </div>
        </div>
    </div>
}

<StatusModal Visible="@showAlert"
             IsError="@alertIsError"
             Title="@alertTitle"
             Message="@alertMessage"
             OnClose="CloseAlert" />

@code {
    private readonly List<tbl_orden_compra> orders = [];
    private readonly List<tbl_proveedor> suppliers = [];
    private readonly List<tbl_producto> products = [];
    private readonly string[] stateOptions = ["Pendiente", "Aprobada", "Recibida Parcial", "Recibida", "Cancelada"];
    private readonly string[] paymentOptions = ["Contado", "Credito", "Mixto"];
    private readonly List<tbl_log_auditoria> auditEntries = [];
    private Permissions permissions = new();
    private PurchaseOrderEditor? editor;
    private tbl_orden_compra? selectedOrder;
    private bool isLoading = true, canView, isCreating, showForm, showAudit, showAlert, alertIsError;
    private int currentUserId, currentRoleId;
    private string searchTerm = string.Empty, stateFilter = string.Empty, supplierFilter = string.Empty, alertMessage = string.Empty, alertTitle = string.Empty, dateFromFilter = string.Empty, dateToFilter = string.Empty;
    private string TodayDateIso => DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");

    private List<tbl_orden_compra> FilteredOrders => orders.Where(MatchesFilters).ToList();
    private const int TablePageSize = 5;
    private int orderPage = 1;
    private int EffectiveOrderPage => Math.Min(orderPage, Math.Max(1, (int)Math.Ceiling(FilteredOrders.Count / (double)TablePageSize)));
    private IEnumerable<tbl_orden_compra> PagedOrders => FilteredOrders.Skip((EffectiveOrderPage - 1) * TablePageSize).Take(TablePageSize);
    private void SetOrderPage(int page) => orderPage = page;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var uid) ? uid : 0;
        currentRoleId = int.TryParse(auth.User.FindFirst("RoleId")?.Value, out var rid) ? rid : 0;
        await LoadAsync();
    }

    private async Task LoadAsync(int? preserveId = null)
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        permissions = await GetPermissionsAsync(db);
        canView = permissions.CanView;
        if (!canView) { isLoading = false; return; }

        suppliers.Clear();
        suppliers.AddRange(await db.tbl_proveedors.AsNoTracking().OrderBy(x => x.nombre).ToListAsync());
        products.Clear();
        products.AddRange(await ProductInventoryRules.FilterGoods(db.tbl_productos.AsNoTracking())
            .Where(x => x.activo == true)
            .OrderBy(x => x.nombre_producto)
            .ToListAsync());
        orders.Clear();
        orders.AddRange(await db.tbl_orden_compra.AsNoTracking()
            .Include(x => x.id_proveedorNavigation)
            .Include(x => x.tbl_detalle_orden_compra)
            .Where(x => x.id_usuario_solicita == currentUserId)
            .OrderByDescending(x => x.fecha_orden)
            .ToListAsync());

        if (preserveId.HasValue)
        {
            selectedOrder = orders.FirstOrDefault(x => x.id_orden_compra == preserveId.Value);
        }

        isLoading = false;
    }

    private void PrepareNew()
    {
        isCreating = true;
        editor = new PurchaseOrderEditor
        {
            FechaRequerida = DateOnly.FromDateTime(DateTime.Today),
            FechaRecepcionEsperada = DateOnly.FromDateTime(DateTime.Today),
            CondicionPago = "Contado",
            Moneda = "USD",
            EstadoOrden = "Pendiente"
        };
        editor.Lines.Add(new PurchaseOrderLineEditor());
        showForm = true;
    }

    private async Task PrepareEdit(tbl_orden_compra order)
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var entity = await db.tbl_orden_compra.AsNoTracking()
            .Include(x => x.tbl_detalle_orden_compra)
            .FirstAsync(x => x.id_orden_compra == order.id_orden_compra && x.id_usuario_solicita == currentUserId);

        isCreating = false;
        editor = new PurchaseOrderEditor
        {
            Id = entity.id_orden_compra,
            NumeroOrden = entity.numero_orden,
            IdProveedor = entity.id_proveedor,
            FechaRequerida = entity.fecha_requerida,
            FechaRecepcionEsperada = entity.fecha_recepcion_esperada,
            CondicionPago = entity.condicion_pago ?? "Contado",
            DiasCredito = entity.dias_credito ?? 0,
            Moneda = entity.moneda ?? "USD",
            EstadoOrden = entity.estado_orden ?? "Pendiente",
            ReferenciaExterna = entity.referencia_externa ?? string.Empty,
            Observaciones = entity.observaciones ?? string.Empty,
            Lines = entity.tbl_detalle_orden_compra.Select(d => new PurchaseOrderLineEditor
            {
                Id = d.id_detalle_orden_compra,
                IdProducto = d.id_producto,
                CantidadSolicitada = d.cantidad_solicitada,
                PrecioUnitario = d.precio_unitario,
                DescuentoLinea = d.descuento_linea ?? 0,
                Observaciones = d.observaciones ?? string.Empty
            }).ToList()
        };
        showForm = true;
    }

    private void AddLine() => editor?.Lines.Add(new PurchaseOrderLineEditor());

    private void RemoveLine(int index)
    {
        if (editor is not null && index >= 0 && index < editor.Lines.Count)
        {
            editor.Lines.RemoveAt(index);
        }
    }

    private async Task SaveAsync()
    {
        if (editor is null ||
            string.IsNullOrWhiteSpace(editor.NumeroOrden) ||
            editor.IdProveedor <= 0 ||
            string.IsNullOrWhiteSpace(editor.EstadoOrden) ||
            !editor.FechaRequerida.HasValue ||
            !editor.FechaRecepcionEsperada.HasValue ||
            editor.Lines.Count == 0 ||
            editor.Lines.Any(x => x.IdProducto <= 0 || x.CantidadSolicitada <= 0 || x.PrecioUnitario < 0))
        {
            ShowAlert("No se pudo guardar la orden de compra.", "Completa proveedor, fechas, estado y al menos una linea valida con producto, cantidad y precio.", true);
            return;
        }

        if (!AppValidation.IsNotPast(editor.FechaRequerida) || !AppValidation.IsNotPast(editor.FechaRecepcionEsperada))
        {
            ShowAlert("No se pudo guardar la orden de compra.", "Las fechas requeridas no pueden ser anteriores a hoy.", true);
            return;
        }

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var selectedProductIds = editor.Lines.Select(x => x.IdProducto).Where(x => x > 0).Distinct().ToList();
        var allowedProducts = await ProductInventoryRules.FilterGoods(db.tbl_productos.AsNoTracking())
            .Where(x => selectedProductIds.Contains(x.id_producto))
            .Select(x => x.id_producto)
            .ToListAsync();

        var invalidProductIds = selectedProductIds.Except(allowedProducts).ToList();
        if (invalidProductIds.Count > 0)
        {
            ShowAlert("No se pudo guardar la orden de compra.", "La orden de compra solo admite bienes inventariables. Quita los servicios seleccionados.", true);
            return;
        }

        var duplicate = await db.tbl_orden_compra.AnyAsync(x => x.id_orden_compra != editor.Id && x.numero_orden == editor.NumeroOrden);
        if (duplicate)
        {
            ShowAlert("No se pudo guardar la orden de compra.", "Ya existe una orden de compra con ese numero.", true);
            return;
        }

        tbl_orden_compra entity;
        if (isCreating)
        {
            entity = new tbl_orden_compra
            {
                id_usuario_solicita = currentUserId,
                fecha_orden = DateTime.Now,
                fecha_creacion = DateTime.Now,
                activo = true
            };
            db.tbl_orden_compra.Add(entity);
        }
        else
        {
            entity = await db.tbl_orden_compra.Include(x => x.tbl_detalle_orden_compra)
                .FirstAsync(x => x.id_orden_compra == editor.Id && x.id_usuario_solicita == currentUserId);
            db.tbl_detalle_orden_compra.RemoveRange(entity.tbl_detalle_orden_compra);
        }

        entity.numero_orden = editor.NumeroOrden.Trim();
        entity.id_proveedor = editor.IdProveedor;
        entity.fecha_requerida = editor.FechaRequerida;
        entity.fecha_recepcion_esperada = editor.FechaRecepcionEsperada;
        entity.condicion_pago = editor.CondicionPago;
        entity.dias_credito = editor.DiasCredito;
        entity.moneda = string.IsNullOrWhiteSpace(editor.Moneda) ? "USD" : editor.Moneda.Trim().ToUpperInvariant();
        entity.estado_orden = editor.EstadoOrden;
        entity.referencia_externa = NullIfBlank(editor.ReferenciaExterna);
        entity.observaciones = NullIfBlank(editor.Observaciones);
        entity.fecha_actualizacion = DateTime.Now;

        var subtotal = 0m;
        foreach (var line in editor.Lines)
        {
            var total = line.CantidadSolicitada * line.PrecioUnitario;
            var discount = total * (line.DescuentoLinea / 100m);
            subtotal += total - discount;
            entity.tbl_detalle_orden_compra.Add(new tbl_detalle_orden_compra
            {
                id_producto = line.IdProducto,
                cantidad_solicitada = line.CantidadSolicitada,
                cantidad_recibida = 0,
                cantidad_rechazada = 0,
                cantidad_pendiente = line.CantidadSolicitada,
                precio_unitario = line.PrecioUnitario,
                precio_total_linea = total - discount,
                descuento_linea = line.DescuentoLinea,
                estado_linea = "Pendiente",
                observaciones = NullIfBlank(line.Observaciones)
            });
        }

        entity.subtotal = subtotal;
        entity.total = subtotal;
        await db.SaveChangesAsync();
        WriteAudit(db, isCreating ? "Crear orden compra" : "Editar orden compra", $"OrdenCompraId={entity.id_orden_compra}; Numero={entity.numero_orden}; Total={entity.total}");
        await db.SaveChangesAsync();
        CloseForm();
        ShowAlert(
            isCreating ? "Orden de compra creada" : "Orden de compra actualizada",
            isCreating
                ? $"La orden {entity.numero_orden} se creo correctamente."
                : $"La orden {entity.numero_orden} se actualizo correctamente.",
            false);
        await LoadAsync(entity.id_orden_compra);
    }

    private async Task DeleteAsync(tbl_orden_compra order)
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var entity = await db.tbl_orden_compra.Include(x => x.tbl_recepcion_compra).Include(x => x.tbl_liquidacion_compra)
            .FirstAsync(x => x.id_orden_compra == order.id_orden_compra && x.id_usuario_solicita == currentUserId);
        if (entity.tbl_recepcion_compra.Count > 0 || entity.tbl_liquidacion_compra.Count > 0)
        {
            ShowAlert("No se pudo eliminar la orden de compra.", "No puedes eliminar una orden que ya tiene recepciones o liquidaciones asociadas.", true);
            return;
        }
        WriteAudit(db, "Eliminar orden compra", $"OrdenCompraId={entity.id_orden_compra}; Numero={entity.numero_orden}");
        db.tbl_orden_compra.Remove(entity);
        await db.SaveChangesAsync();
        ShowAlert("Orden de compra eliminada", $"La orden {entity.numero_orden} se elimino correctamente.", false);
        await LoadAsync();
    }

    private async Task ShowAudit(tbl_orden_compra order)
    {
        selectedOrder = order;
        await using var db = await DbContextFactory.CreateDbContextAsync();
        auditEntries.Clear();
        auditEntries.AddRange(await db.tbl_log_auditoria.AsNoTracking()
            .Where(x => x.modulo == "OrdenesCompra" && x.detalle != null && x.detalle.Contains($"OrdenCompraId={order.id_orden_compra};"))
            .OrderByDescending(x => x.fecha).Take(20).ToListAsync());
        showAudit = true;
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        stateFilter = string.Empty;
        supplierFilter = string.Empty;
        dateFromFilter = string.Empty;
        dateToFilter = string.Empty;
    }

    private void ExportOrders()
    {
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query.Add($"search={Uri.EscapeDataString(searchTerm)}");
        }
        if (!string.IsNullOrWhiteSpace(stateFilter))
        {
            query.Add($"state={Uri.EscapeDataString(stateFilter)}");
        }
        if (!string.IsNullOrWhiteSpace(supplierFilter))
        {
            query.Add($"supplierId={Uri.EscapeDataString(supplierFilter)}");
        }
        if (!string.IsNullOrWhiteSpace(dateFromFilter))
        {
            query.Add($"dateFrom={Uri.EscapeDataString(dateFromFilter)}");
        }
        if (!string.IsNullOrWhiteSpace(dateToFilter))
        {
            query.Add($"dateTo={Uri.EscapeDataString(dateToFilter)}");
        }

        var exportUrl = query.Count == 0
            ? "/exports/purchase-orders.csv"
            : $"/exports/purchase-orders.csv?{string.Join("&", query)}";

        NavigationManager.NavigateTo(exportUrl, forceLoad: true);
    }

    private void ExportOrdersPdf()
    {
        NavigationManager.NavigateTo("/exports/purchase-orders.pdf", forceLoad: true);
    }

    private bool MatchesFilters(tbl_orden_compra order)
    {
        if (!string.IsNullOrWhiteSpace(stateFilter) && !string.Equals(order.estado_orden, stateFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (DateOnly.TryParse(dateFromFilter, out var fromDate) && (!order.fecha_orden.HasValue || order.fecha_orden.Value.Date < fromDate.ToDateTime(TimeOnly.MinValue)))
        {
            return false;
        }

        if (DateOnly.TryParse(dateToFilter, out var toDate) && (!order.fecha_orden.HasValue || order.fecha_orden.Value.Date > toDate.ToDateTime(TimeOnly.MaxValue)))
        {
            return false;
        }

        if (int.TryParse(supplierFilter, out var supplierId) && supplierId > 0 && order.id_proveedor != supplierId)
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return true;
        }

        var search = searchTerm.Trim().ToLowerInvariant();
        return order.numero_orden.ToLowerInvariant().Contains(search) ||
               (order.referencia_externa?.ToLowerInvariant().Contains(search) ?? false) ||
               (order.id_proveedorNavigation?.nombre.ToLowerInvariant().Contains(search) ?? false);
    }

    private async Task<Permissions> GetPermissionsAsync(OpticaDbContext db)
    {
        var permission = await db.tbl_rol_menu_permisos.AsNoTracking()
            .Where(p => p.id_rol == currentRoleId)
             .Join(db.tbl_menu_apps.AsNoTracking().Where(m => m.ruta == "/ordenes-de-compra"), p => p.id_menu, m => m.id_menu, (p, _) => p)
            .FirstOrDefaultAsync();
        return permission is null ? new Permissions() : new Permissions { CanView = permission.puede_ver, CanCreate = permission.puede_crear, CanEdit = permission.puede_editar, CanDelete = permission.puede_eliminar };
    }

    private void WriteAudit(OpticaDbContext db, string action, string detail) => db.tbl_log_auditoria.Add(new tbl_log_auditoria { id_usuario = currentUserId > 0 ? currentUserId : null, accion = action, modulo = "OrdenesCompra", fecha = DateTime.Now, detalle = detail });
