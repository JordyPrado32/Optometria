@page "/recepciones-de-compra"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@using OptometriaApp.Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject KardexService KardexService
@inject NavigationManager NavigationManager

<PageTitle>Recepciones de compra</PageTitle>

@if (isLoading)
{
    <section class="management-shell"><div class="management-card"><h1>Cargando recepciones...</h1></div></section>
}
else if (!canView)
{
    <section class="management-shell"><div class="management-card"><h1>Sin acceso</h1></div></section>
}
else
{
    <section class="management-shell">
        <div class="management-hero">
            <div><span class="eyebrow">Compras</span><h1>Recepciones de compra</h1><p>Las recepciones registradas por el usuario actual actualizan stock, movimientos y kardex.</p></div>
            <div class="workspace-actions" style="align-items: center;">
                @if (permissions.CanCreate)
                {
                    <button class="btn btn-coffee" @onclick="PrepareNew">
                        <i class="bi bi-plus-lg" style="margin-right: 6px;"></i> Nueva recepcion
                    </button>
                }
                <button class="btn btn-excel" @onclick="ExportReceptions">
                    <i class="bi bi-file-earmark-excel-fill" style="margin-right: 6px;"></i> Exportar Excel
                </button>
            </div>
        </div>

        <section class="management-card compact-filter-card">
            <div class="management-card-header"><h2>Filtros</h2><span>@FilteredReceptions.Count resultados</span></div>
            <div class="filters-row-2">
                <div>
                    <label class="form-label">Buscar</label>
                    <input class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Numero recepcion, orden o guia" />
                </div>
                <div class="filter-selects-col-2">
                    <div>
                        <label class="form-label">Estado</label>
                        <select class="form-select" @bind="stateFilter">
                            <option value="">Todos</option>
                            @foreach (var option in stateOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Orden</label>
                        <select class="form-select" @bind="orderFilter">
                            <option value="">Todas</option>
                            @foreach (var order in availableOrders.OrderByDescending(o => o.fecha_orden))
                            {
                                <option value="@order.id_orden_compra.ToString()">@order.numero_orden</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="management-actions" style="margin-top: 0.3rem;">
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ClearFilters" style="padding: 0.3rem 0.7rem !important; font-size: 0.78rem !important; border-color: rgba(127,105,81,0.25) !important;">
                    <i class="bi bi-trash" style="margin-right: 4px;"></i> Limpiar filtros
                </button>
            </div>
        </section>

        <section class="management-card" style="margin-top:1.5rem;">
            <div class="management-card-header"><h2>Recepciones</h2><span>@FilteredReceptions.Count</span></div>
            <div class="table-responsive" style="margin-top:1rem;">
                <table class="table table-hover">
                    <thead><tr><th>Numero</th><th>Orden</th><th>Fecha</th><th>Estado</th><th>Recibido</th><th style="text-align:right;">Acciones</th></tr></thead>
                    <tbody>
                        @if (FilteredReceptions.Count == 0)
                        {
                            <tr><td colspan="6" style="text-align:center; padding:2rem;">No hay recepciones.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in PagedReceptions)
                            {
                                <tr>
                                    <td>@item.numero_recepcion</td>
                                    <td>@item.id_orden_compraNavigation?.numero_orden</td>
                                    <td>@item.fecha_recepcion?.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@item.estado_recepcion</td>
                                    <td>@(item.cantidad_total_recibida ?? 0)</td>
                                    <td style="text-align:right;">
                                        <div style="display:inline-flex; gap:0.4rem;">
                                            <button class="btn btn-outline-primary" @onclick="() => PrepareEdit(item)">
                                                <i class="bi bi-pencil-fill"></i> Editar
                                            </button>
                                            @if (permissions.CanDelete)
                                            {
                                                <button class="btn btn-outline-primary" @onclick="() => DeleteAsync(item)">
                                                    <i class="bi bi-trash3-fill"></i> Eliminar
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <TablePager TotalItems="@FilteredReceptions.Count" CurrentPage="@receptionPage" CurrentPageChanged="SetReceptionPage" />
        </section>
    </section>
}

@if (showForm && editor is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card">
            <header class="custom-modal-header rose-header"><h2>@(isCreating ? "Nueva recepcion" : "Editar recepcion")</h2><button class="btn-close-modal" @onclick="CloseForm">×</button></header>
            <div class="custom-modal-body">
                <p class="required-fields-note">Los campos marcados con * son obligatorios.</p>
                <div class="management-form-grid">
                    <div><label class="form-label">Numero recepcion <span class="field-required">*</span></label><input class="form-control" @bind="editor.NumeroRecepcion" /></div>
                    <div>
                        <label class="form-label">Buscar orden</label>
                        <input class="form-control" @bind="orderSearchTerm" @bind:event="oninput" placeholder="Escribe el numero de orden" />
                    </div>
                    <div>
                        <label class="form-label">Orden compra <span class="field-required">*</span></label>
                        <select class="form-select" @bind="editor.IdOrdenCompra">
                            <option value="0">Selecciona</option>
                            @foreach (var order in FilteredAvailableOrders)
                            {
                                <option value="@order.id_orden_compra">@order.numero_orden</option>
                            }
                        </select>
                    </div>
                    <div><label class="form-label">Guia remision</label><input class="form-control" @bind="editor.NumeroGuiaRemision" /></div>
                    <div><label class="form-label">Estado <span class="field-required">*</span></label><select class="form-select" @bind="editor.EstadoRecepcion">@foreach (var option in stateOptions){<option value="@option">@option</option>}</select></div>
                    <div><label class="form-label">Clasificacion <span class="field-required">*</span></label><select class="form-select" @bind="editor.ClasificacionRecepcion">@foreach (var option in classificationOptions){<option value="@option">@option</option>}</select></div>
                    <div class="patient-form-span"><label class="form-label">Observaciones</label><textarea class="form-control" rows="3" @bind="editor.Observaciones"></textarea></div>
                </div>
                <div class="management-card" style="margin-top:1rem; padding:1rem;">
                    <div class="management-card-header"><h2>Tabla de verificacion</h2><span>Debe aprobarse antes de inventariar</span></div>
                    <div class="management-form-grid" style="margin-top:1rem;">
                        <div>
                            <label class="form-label">Checklist aprobado <span class="field-required">*</span></label>
                            <div class="form-check form-switch" style="margin-top:0.45rem;">
                                <input class="form-check-input" type="checkbox" @bind="editor.ChecklistAprobado" />
                            </div>
                        </div>
                        <div class="patient-form-span">
                            <label class="form-label">Notas de verificacion</label>
                            <textarea class="form-control" rows="3" @bind="editor.ObservacionesChecklist"></textarea>
                        </div>
                    </div>
                </div>
            </div>
            <footer class="custom-modal-footer"><button class="btn btn-primary" @onclick="SaveAsync">Guardar</button><button class="btn btn-outline-primary" @onclick="CloseForm">Cerrar</button></footer>
        </div>
    </div>
}

<StatusModal Visible="@showAlert"
             IsError="@alertIsError"
             Title="@alertTitle"
             Message="@alertMessage"
             OnClose="CloseAlert" />

@code {
    private readonly List<tbl_recepcion_compra> recepciones = [];
    private readonly List<tbl_orden_compra> availableOrders = [];
    private readonly string[] stateOptions = ["Completa", "Parcial", "Observada"];
    private readonly string[] classificationOptions = ["Perfecto estado", "Con fallas", "Obsoleto"];
    private Permissions permissions = new();
    private ReceptionEditor? editor;
    private bool isLoading = true, canView, isCreating, showForm, showAlert, alertIsError;
    private int currentUserId, currentRoleId;
    private string alertMessage = string.Empty, alertTitle = string.Empty, searchTerm = string.Empty, stateFilter = string.Empty, orderFilter = string.Empty, orderSearchTerm = string.Empty;

    private List<tbl_recepcion_compra> FilteredReceptions => recepciones.Where(MatchesFilters).ToList();
    private const int TablePageSize = 5;
    private int receptionPage = 1;
    private int EffectiveReceptionPage => Math.Min(receptionPage, Math.Max(1, (int)Math.Ceiling(FilteredReceptions.Count / (double)TablePageSize)));
    private IEnumerable<tbl_recepcion_compra> PagedReceptions => FilteredReceptions.Skip((EffectiveReceptionPage - 1) * TablePageSize).Take(TablePageSize);
    private void SetReceptionPage(int page) => receptionPage = page;
    private IEnumerable<tbl_orden_compra> FilteredAvailableOrders => availableOrders.Where(MatchesOrderSearch).OrderByDescending(x => x.fecha_orden);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var uid) ? uid : 0;
        currentRoleId = int.TryParse(auth.User.FindFirst("RoleId")?.Value, out var rid) ? rid : 0;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        permissions = await GetPermissionsAsync(db);
        canView = permissions.CanView;
        if (!canView) { isLoading = false; return; }
        availableOrders.Clear();
        availableOrders.AddRange(await db.tbl_orden_compra.AsNoTracking()
            .Include(x => x.tbl_detalle_orden_compra)
                .ThenInclude(x => x.id_productoNavigation)
            .Where(x => x.id_usuario_solicita == currentUserId)
            .Where(x => x.tbl_detalle_orden_compra.Any(line =>
                line.id_productoNavigation.naturaleza_item == null ||
                line.id_productoNavigation.naturaleza_item == "" ||
                line.id_productoNavigation.naturaleza_item == ProductInventoryRules.GoodNature))
            .OrderByDescending(x => x.fecha_orden)
            .ToListAsync());
        recepciones.Clear();
        recepciones.AddRange(await db.tbl_recepcion_compra.AsNoTracking().Include(x => x.id_orden_compraNavigation).Where(x => x.id_usuario_recibe == currentUserId).OrderByDescending(x => x.fecha_recepcion).ToListAsync());
        isLoading = false;
    }

    private void PrepareNew()
    {
        isCreating = true;
        orderSearchTerm = string.Empty;
        editor = new ReceptionEditor { EstadoRecepcion = "Completa", ClasificacionRecepcion = "Perfecto estado" };
        showForm = true;
    }

    private void PrepareEdit(tbl_recepcion_compra item)
    {
        isCreating = false;
        orderSearchTerm = item.id_orden_compraNavigation?.numero_orden ?? string.Empty;
        editor = new ReceptionEditor { Id = item.id_recepcion, IdOrdenCompra = item.id_orden_compra, NumeroRecepcion = item.numero_recepcion, NumeroGuiaRemision = item.numero_guia_remision ?? string.Empty, EstadoRecepcion = item.estado_recepcion ?? "Completa", ClasificacionRecepcion = "Perfecto estado", Observaciones = item.observaciones_recepcion ?? string.Empty };
        showForm = true;
    }

    private async Task SaveAsync()
    {
        if (editor is null || string.IsNullOrWhiteSpace(editor.NumeroRecepcion) || editor.IdOrdenCompra <= 0)
        {
            ShowAlert("No se pudo guardar la recepcion.", "Completa numero de recepcion, orden de compra, estado y clasificacion.", true);
            return;
        }

        if (isCreating && !editor.ChecklistAprobado)
        {
            ShowAlert("No se pudo guardar la recepcion.", "Debes aprobar la tabla de verificacion antes de actualizar inventario.", true);
            return;
        }

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var duplicate = await db.tbl_recepcion_compra.AnyAsync(x => x.id_recepcion != editor.Id && x.numero_recepcion == editor.NumeroRecepcion);
        if (duplicate) { ShowAlert("No se pudo guardar la recepcion.", "Ya existe una recepcion con ese numero.", true); return; }

        tbl_recepcion_compra entity;
        List<int>? affectedProductIds = null;
        if (isCreating)
        {
            entity = new tbl_recepcion_compra { id_usuario_recibe = currentUserId, fecha_recepcion = DateTime.Now, activo = true };
            db.tbl_recepcion_compra.Add(entity);
        }
        else
        {
            entity = await db.tbl_recepcion_compra.FirstAsync(x => x.id_recepcion == editor.Id && x.id_usuario_recibe == currentUserId);
        }

        entity.id_orden_compra = editor.IdOrdenCompra;
        entity.numero_recepcion = editor.NumeroRecepcion.Trim();
        entity.numero_guia_remision = NullIfBlank(editor.NumeroGuiaRemision);
        entity.estado_recepcion = editor.EstadoRecepcion;
        entity.observaciones_recepcion = NullIfBlank($"{editor.Observaciones}\nChecklist: {(editor.ChecklistAprobado ? "Aprobado" : "Pendiente")}. Clasificacion: {editor.ClasificacionRecepcion}. {editor.ObservacionesChecklist}".Trim());

        if (isCreating)
        {
            var order = await db.tbl_orden_compra
                .Include(x => x.tbl_detalle_orden_compra)
                    .ThenInclude(x => x.id_productoNavigation)
                .FirstAsync(x => x.id_orden_compra == editor.IdOrdenCompra && x.id_usuario_solicita == currentUserId);
            var invalidLines = order.tbl_detalle_orden_compra
                .Where(x => !ProductInventoryRules.IsGoodProduct(x.id_productoNavigation))
                .Select(x => x.id_producto)
                .Distinct()
                .ToList();
            if (invalidLines.Count > 0)
            {
                ShowAlert("No se pudo guardar la recepcion.", "La recepcion contiene servicios y no puede afectar inventario. Corrige la orden de compra primero.", true);
                return;
            }
            affectedProductIds = order.tbl_detalle_orden_compra.Select(x => x.id_producto).Distinct().ToList();
            var totalReceived = 0;
            foreach (var line in order.tbl_detalle_orden_compra.Where(x => (x.cantidad_pendiente ?? 0) > 0))
            {
                var received = line.cantidad_pendiente ?? 0;
                var approvedForInventory = string.Equals(editor.ClasificacionRecepcion, "Perfecto estado", StringComparison.OrdinalIgnoreCase);
                if (!approvedForInventory)
                {
                    line.cantidad_rechazada = (line.cantidad_rechazada ?? 0) + received;
                    line.estado_linea = editor.ClasificacionRecepcion;
                    order.estado_orden = "Recibida Parcial";
                    continue;
                }

                totalReceived += received;
                line.cantidad_recibida = (line.cantidad_recibida ?? 0) + received;
                line.cantidad_pendiente = 0;
                line.estado_linea = "Recibida";

                var product = await ProductInventoryRules.FilterGoods(db.tbl_productos)
                    .FirstOrDefaultAsync(x => x.id_producto == line.id_producto);
                if (product is null)
                {
                    ShowAlert("No se pudo guardar la recepcion.", "Se encontro un item no inventariable en la recepcion. El proceso fue cancelado para proteger el stock.", true);
                    return;
                }
                var previousStock = product.stock_actual ?? 0;
                product.stock_actual = previousStock + received;
                product.fecha_ultima_compra = DateTime.Now;

                tbl_lote_producto? lote = null;
                if (product.requiere_lote == true)
                {
                    lote = new tbl_lote_producto
                    {
                        id_producto = product.id_producto,
                        id_orden_compra = order.id_orden_compra,
                        numero_lote = $"{order.numero_orden}-{line.id_producto}-{DateTime.Now:yyyyMMddHHmmss}",
                        cantidad_inicial = received,
                        cantidad_disponible = received,
                        costo_unitario = line.precio_unitario,
                        precio_venta_unitario = product.precio_venta,
                        valor_total_costo = line.precio_unitario * received,
                        estado_lote = "Disponible",
                        fecha_ingreso = DateTime.Now,
                        id_usuario_ingreso = currentUserId
                    };
                    db.tbl_lote_producto.Add(lote);
                }

                db.tbl_movimiento_inventarios.Add(new tbl_movimiento_inventario
                {
                    id_producto = product.id_producto,
                    id_usuario = currentUserId,
                    tipo_movimiento = "Entrada",
                    cantidad = received,
                    stock_anterior = previousStock,
                    stock_resultante = product.stock_actual,
                    fecha_movimiento = DateTime.Now,
                    observaciones = $"Recepcion compra {editor.NumeroRecepcion}",
                    id_referencia_documento = order.id_orden_compra,
                    tipo_documento_referencia = "RecepcionCompra",
                    costo_unitario = line.precio_unitario,
                    costo_total_movimiento = line.precio_unitario * received,
                    saldo_en_dinero = (line.precio_unitario * received),
                    metodo_valuacion = "Promedio",
                    comprobante_numero = editor.NumeroRecepcion,
                    numero_lote = lote?.numero_lote
                });

                db.tbl_kardex.Add(new tbl_kardex
                {
                    id_producto = product.id_producto,
                    numero_lote = lote?.numero_lote,
                    fecha_movimiento = DateTime.Now,
                    tipo_movimiento = "Entrada",
                    id_referencia = order.id_orden_compra,
                    tipo_referencia = "RecepcionCompra",
                    comprobante_numero = editor.NumeroRecepcion,
                    cantidad_movimiento = received,
                    costo_unitario = line.precio_unitario,
                    costo_total = line.precio_unitario * received,
                    stock_anterior = previousStock,
                    stock_nuevo = product.stock_actual,
                    saldo_anterior_dinero = 0,
                    saldo_nuevo_dinero = line.precio_unitario * received,
                    precio_promedio_ponderado = line.precio_unitario,
                    metodo_valuacion = "Promedio",
                    id_usuario_movimiento = currentUserId,
                    descripcion_movimiento = $"Recepcion de orden {order.numero_orden}",
                    estado_kardex = "Registrado"
                });
            }

            entity.cantidad_total_recibida = totalReceived;
            order.fecha_recepcion_real = DateTime.Now;
            order.estado_orden = totalReceived > 0 ? "Recibida" : "Recibida Parcial";
            WriteAudit(db, "Crear recepcion compra", $"RecepcionCompraId={entity.id_recepcion}; Numero={entity.numero_recepcion}; OrdenCompraId={order.id_orden_compra}");
        }
        else
        {
            WriteAudit(db, "Editar recepcion compra", $"RecepcionCompraId={entity.id_recepcion}; Numero={entity.numero_recepcion}; OrdenCompraId={entity.id_orden_compra}");
        }

        await db.SaveChangesAsync();
        if (isCreating && affectedProductIds is not null && affectedProductIds.Count > 0)
        {
            await KardexService.RebuildForProductsAsync(affectedProductIds, currentUserId, "Recepcion de compra");
        }
        CloseForm();
        ShowAlert(
            isCreating ? "Recepcion creada" : "Recepcion actualizada",
            isCreating
                ? $"La recepcion {entity.numero_recepcion} se registro correctamente."
                : $"La recepcion {entity.numero_recepcion} se actualizo correctamente.",
            false);
        await LoadAsync();
    }

    private async Task DeleteAsync(tbl_recepcion_compra item)
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var entity = await db.tbl_recepcion_compra.FirstAsync(x => x.id_recepcion == item.id_recepcion && x.id_usuario_recibe == currentUserId);
        var hasInventoryImpact = await db.tbl_movimiento_inventarios.AsNoTracking().AnyAsync(x =>
            x.id_usuario == currentUserId &&
            x.tipo_documento_referencia == "RecepcionCompra" &&
            x.comprobante_numero == entity.numero_recepcion);

        if (hasInventoryImpact)
        {
            ShowAlert("No se pudo eliminar la recepcion.", "Esta recepcion ya afecto inventario. Para conservar la consistencia no se puede eliminar.", true);
            return;
        }

        WriteAudit(db, "Eliminar recepcion compra", $"RecepcionCompraId={entity.id_recepcion}; Numero={entity.numero_recepcion}; OrdenCompraId={entity.id_orden_compra}");
        db.tbl_recepcion_compra.Remove(entity);
        await db.SaveChangesAsync();
        ShowAlert("Recepcion eliminada", $"La recepcion {entity.numero_recepcion} se elimino correctamente.", false);
        await LoadAsync();
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        stateFilter = string.Empty;
        orderFilter = string.Empty;
    }

    private void ExportReceptions()
    {
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query.Add($"search={Uri.EscapeDataString(searchTerm)}");
        }
        if (!string.IsNullOrWhiteSpace(stateFilter))
        {
            query.Add($"state={Uri.EscapeDataString(stateFilter)}");
        }
        if (!string.IsNullOrWhiteSpace(orderFilter))
        {
            query.Add($"orderId={Uri.EscapeDataString(orderFilter)}");
        }

        var exportUrl = query.Count == 0
            ? "/exports/purchase-receptions.csv"
            : $"/exports/purchase-receptions.csv?{string.Join("&", query)}";

        NavigationManager.NavigateTo(exportUrl, forceLoad: true);
    }

    private bool MatchesFilters(tbl_recepcion_compra item)
    {
        if (!string.IsNullOrWhiteSpace(stateFilter) && !string.Equals(item.estado_recepcion, stateFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (int.TryParse(orderFilter, out var orderId) && orderId > 0 && item.id_orden_compra != orderId)
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return true;
        }

        var search = searchTerm.Trim().ToLowerInvariant();
        return item.numero_recepcion.ToLowerInvariant().Contains(search) ||
               (item.numero_guia_remision?.ToLowerInvariant().Contains(search) ?? false) ||
               (item.id_orden_compraNavigation?.numero_orden.ToLowerInvariant().Contains(search) ?? false);
    }

    private bool MatchesOrderSearch(tbl_orden_compra order)
    {
        if (string.IsNullOrWhiteSpace(orderSearchTerm))
        {
            return true;
        }

        var search = orderSearchTerm.Trim().ToLowerInvariant();
        return order.numero_orden.ToLowerInvariant().Contains(search) ||
               (order.referencia_externa?.ToLowerInvariant().Contains(search) ?? false);
    }

    private async Task<Permissions> GetPermissionsAsync(OpticaDbContext db)
    {
        var permission = await db.tbl_rol_menu_permisos.AsNoTracking().Where(p => p.id_rol == currentRoleId)
            .Join(db.tbl_menu_apps.AsNoTracking().Where(m => m.ruta == "/recepciones-de-compra"), p => p.id_menu, m => m.id_menu, (p, _) => p)
            .FirstOrDefaultAsync();
        return permission is null ? new Permissions() : new Permissions { CanView = permission.puede_ver, CanCreate = permission.puede_crear, CanEdit = permission.puede_editar, CanDelete = permission.puede_eliminar };
    }
    private void WriteAudit(OpticaDbContext db, string action, string detail) => db.tbl_log_auditoria.Add(new tbl_log_auditoria { id_usuario = currentUserId > 0 ? currentUserId : null, accion = action, modulo = "RecepcionesCompra", fecha = DateTime.Now, detalle = detail });
    private void ShowAlert(string title, string message, bool isError)
    {
        alertTitle = title;
        alertMessage = message;
        alertIsError = isError;
        showAlert = true;
    }

    private void CloseAlert()
    {
        showAlert = false;
        alertTitle = string.Empty;
        alertMessage = string.Empty;
    }
    private void CloseForm() { showForm = false; editor = null; orderSearchTerm = string.Empty; }
    private static string? NullIfBlank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
