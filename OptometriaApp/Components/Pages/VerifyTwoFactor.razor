@page "/verificar-2fa"
@page "/verify-2fa"
@attribute [Authorize(Policy = "TwoFactorVerification")]
@layout AuthLayout
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Verificar 2FA</PageTitle>

<div class="auth-shell">
    <section class="auth-panel auth-panel-brand">
        <div class="brand-badge">Segundo factor</div>
        <h1>Confirma tu código de Google Authenticator</h1>
        <p>
            Ya validamos tu usuario y contraseña. Falta el código de 6 dígitos
            para abrir el sistema.
        </p>
    </section>

    <section class="auth-panel auth-panel-form">
        <div class="auth-card">
            <div class="auth-heading">
                <span class="eyebrow">Verificación 2FA</span>
                <h2>Ingresa tu código</h2>
                <p>Este paso se pedirá siempre que ingreses al sistema.</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="alert alert-danger" role="alert">@Error</div>
            }

            <form method="post" action="/auth/verify-2fa" class="auth-form">
                <AntiforgeryToken />
                <div>
                    <label class="form-label" for="code">Código de 6 dígitos</label>
                    <input id="code" name="code" class="form-control auth-code-input" inputmode="numeric" maxlength="6" placeholder="123456" required />
                </div>

                <button type="submit" class="btn btn-primary auth-submit">Validar código</button>
            </form>

            <div class="auth-footer">
                <span>¿Te equivocaste de cuenta?</span>
                <a href="/auth/logout">Volver</a>
            </div>
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var stage = authState.User.FindFirst("AuthStage")?.Value;

        if (stage == "TwoFactorSetupRequired")
        {
            NavigationManager.NavigateTo("/configurar-2fa");
            return;
        }

        if (stage == "FullAccess")
        {
            var forcePasswordChange = string.Equals(authState.User.FindFirst("ForcePasswordChange")?.Value, bool.TrueString, StringComparison.OrdinalIgnoreCase);
            NavigationManager.NavigateTo(forcePasswordChange ? "/cambiar-contrasena" : "/dashboard");
        }
    }
}
