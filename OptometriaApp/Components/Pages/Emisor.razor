    private bool ValidateEditor()
    {
        if (editor is null)
        {
            errorMessage = "No hay un emisor seleccionado.";
            return false;
        }

        editor.Ruc = editor.Ruc.Trim();
        editor.RazonSocial = editor.RazonSocial.Trim();
        editor.Correo = editor.Correo.Trim();
        editor.Telefono = editor.Telefono.Trim();
        editor.Provincia = editor.Provincia.Trim();
        editor.Ciudad = editor.Ciudad.Trim();
        editor.Direccion = editor.Direccion.Trim();
        editor.DireccionEstablecimiento = editor.DireccionEstablecimiento.Trim();
        editor.CodigoPostal = editor.CodigoPostal.Trim();
        editor.CedulaRepresentante = editor.CedulaRepresentante.Trim();
        editor.NumeroContribuyenteEspecial = editor.NumeroContribuyenteEspecial.Trim();
        editor.NombreRepresentanteLegal = editor.NombreRepresentanteLegal.Trim();
        editor.EstablecimientoCodigo = NormalizeEmissionCode(editor.EstablecimientoCodigo);
        editor.PuntoEmisionCodigo = NormalizeEmissionCode(editor.PuntoEmisionCodigo);

        if (string.IsNullOrWhiteSpace(editor.Ruc) ||
            string.IsNullOrWhiteSpace(editor.RazonSocial) ||
            string.IsNullOrWhiteSpace(editor.TipoPersona) ||
            string.IsNullOrWhiteSpace(editor.TipoIdentificacion) ||
            string.IsNullOrWhiteSpace(editor.Direccion) ||
            string.IsNullOrWhiteSpace(editor.Provincia) ||
            string.IsNullOrWhiteSpace(editor.Ciudad) ||
            string.IsNullOrWhiteSpace(editor.Correo) ||
            string.IsNullOrWhiteSpace(editor.EstablecimientoCodigo) ||
            string.IsNullOrWhiteSpace(editor.PuntoEmisionCodigo))
        {
            errorMessage = "Completa los campos obligatorios del emisor.";
            return false;
        }

        if (editor.Ruc.Length != 13 || !editor.Ruc.All(char.IsDigit))
        {
            errorMessage = "El RUC debe tener exactamente 13 digitos.";
            return false;
        }

        if (editor.EstablecimientoCodigo.Length != 3 || !editor.EstablecimientoCodigo.All(char.IsDigit) ||
            editor.PuntoEmisionCodigo.Length != 3 || !editor.PuntoEmisionCodigo.All(char.IsDigit))
        {
            errorMessage = "Establecimiento y punto de emision deben tener exactamente 3 digitos.";
            return false;
        }

        if (!IsValidEmail(editor.Correo))
        {
            errorMessage = "Ingresa un correo electronico valido.";
            return false;
        }

        if (!string.IsNullOrWhiteSpace(editor.CedulaRepresentante) &&
            (editor.CedulaRepresentante.Length != 10 || !editor.CedulaRepresentante.All(char.IsDigit)))
        {
            errorMessage = "La cedula del representante debe tener 10 digitos.";
            return false;
        }

        if (editor.TipoPersona == "J" && string.IsNullOrWhiteSpace(editor.NombreRepresentanteLegal))
        {
            errorMessage = "Para una persona juridica debes registrar el representante legal.";
            return false;
        }

        if (editor.EsContribuyenteEspecial && string.IsNullOrWhiteSpace(editor.NumeroContribuyenteEspecial))
        {
            errorMessage = "Si marcas contribuyente especial debes indicar el numero correspondiente.";
            return false;
        }

        if (!string.IsNullOrWhiteSpace(editor.NumeroContribuyenteEspecial) && !editor.NumeroContribuyenteEspecial.All(char.IsDigit))
        {
            errorMessage = "El numero de contribuyente especial debe contener solo digitos.";
            return false;
        }

        return true;
    }

    private async Task HandleCertificateSelectedAsync(InputFileChangeEventArgs args)
    {
        if (editor is null || !CanModifyEditor)
        {
            return;
        }

        errorMessage = null;
        try
        {
            var file = args.File;
            const long maxCertificateSize = 1024 * 1024;
            if (!file.Name.EndsWith(".p12", StringComparison.OrdinalIgnoreCase) &&
                !file.Name.EndsWith(".pfx", StringComparison.OrdinalIgnoreCase))
            {
                throw new InvalidOperationException("El certificado debe tener extension .p12 o .pfx.");
            }

            await using var stream = file.OpenReadStream(maxCertificateSize);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            editor.CertificateBytes = memory.ToArray();
            editor.CertificateFileName = Path.GetFileName(file.Name);
        }
        catch (Exception ex)
        {
            editor.CertificateBytes = null;
            editor.CertificateFileName = string.Empty;
            errorMessage = GetInnermostMessage(ex);
        }
    }

    private async Task<string> ValidateAndSaveCertificateAsync(IssuerEditorModel model)
    {
        var certificateBytes = model.CertificateBytes
            ?? throw new InvalidOperationException("No se selecciono un certificado.");
        using var certificate = X509CertificateLoader.LoadPkcs12(
            certificateBytes,
            model.CertificatePassword,
            X509KeyStorageFlags.EphemeralKeySet);

        using var privateKey = certificate.GetRSAPrivateKey();
        if (!certificate.HasPrivateKey || privateKey is null)
        {
            throw new InvalidOperationException("El certificado no contiene una clave privada RSA utilizable.");
        }

        if (privateKey.KeySize < 2048)
        {
            throw new InvalidOperationException("La clave RSA del certificado debe tener al menos 2048 bits.");
        }

        if (DateTime.Now < certificate.NotBefore || DateTime.Now > certificate.NotAfter)
        {
            throw new InvalidOperationException($"El certificado no esta vigente. Validez: {certificate.NotBefore:yyyy-MM-dd} a {certificate.NotAfter:yyyy-MM-dd}.");
        }

        var certificateFolder = Path.GetFullPath(Path.Combine(
            WebHostEnvironment.ContentRootPath,
            "App_Data",
            "SriCertificates",
            currentUserId.ToString()));
        Directory.CreateDirectory(certificateFolder);
        var certificatePath = Path.Combine(
            certificateFolder,
            $"{model.Ruc}-{DateTime.UtcNow:yyyyMMddHHmmss}-{Guid.NewGuid():N}.p12");
        await File.WriteAllBytesAsync(certificatePath, certificateBytes);
        return certificatePath;
    }

    private async Task<ModulePermissions> GetModulePermissionsAsync(OpticaDbContext dbContext, int roleId)
    {
        if (roleId <= 0)
        {
            return new ModulePermissions();
        }

        var permission = await dbContext.tbl_rol_menu_permisos
            .AsNoTracking()
            .Where(p => p.id_rol == roleId)
            .Join(
                dbContext.tbl_menu_apps.AsNoTracking().Where(m => m.ruta == "/emisor"),
                rolePermission => rolePermission.id_menu,
                menu => menu.id_menu,
                (rolePermission, _) => rolePermission)
            .FirstOrDefaultAsync();

        return permission is null
            ? new ModulePermissions()
            : new ModulePermissions
            {
                CanView = permission.puede_ver,
                CanCreate = permission.puede_crear,
                CanEdit = permission.puede_editar,
                CanDelete = permission.puede_eliminar
            };
    }

