@page "/emisor"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@using System.Net.Mail
@using System.Security.Cryptography.X509Certificates
@using Microsoft.AspNetCore.Components.Forms
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment WebHostEnvironment
@inject IConfiguration Configuration
@inject CertificateSecretProtector CertificateSecretProtector

<PageTitle>Emisor</PageTitle>

@if (isLoading)
{
    <section class="management-shell">
        <div class="management-card">
            <h1>Cargando emisor...</h1>
        </div>
    </section>
}
else if (!canViewEmisor)
{
    <section class="management-shell">
        <div class="management-card">
            <span class="eyebrow">Restringido</span>
            <h1>Gestion de emisor</h1>
            <p>Tu rol no tiene permiso para ver este modulo.</p>
        </div>
    </section>
}
else
{
    <section class="management-shell">
        <div class="management-hero">
            <div>
                <span class="eyebrow">Facturacion electronica</span>
                <h1>Emisor</h1>
                <p>Cada usuario mantiene un unico emisor propio con control de auditoria, establecimiento y punto de emision.</p>
            </div>

            <div class="workspace-actions">
                @if (permissions.CanCreate && !emisores.Any())
                {
                    <button type="button" class="btn btn-primary" @onclick="PrepareNewIssuer">
                        <i class="bi bi-plus-lg" style="margin-right: 6px;"></i> Crear emisor
                    </button>
                }

                <button type="button" class="btn btn-outline-primary" @onclick="ExportIssuer">Exportar CSV</button>
            </div>
        </div>

        <section class="management-card" style="margin-top: 1.5rem;">
            <div class="management-card-header">
                <h2>Registro del emisor</h2>
                <span>@emisores.Count / 1</span>
            </div>

            <div class="table-responsive" style="margin-top: 1rem;">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>RUC</th>
                            <th>Razon social</th>
                            <th>Emision</th>
                            <th>Correo</th>
                            <th>Estado</th>
                            <th style="text-align: right; padding-right: 1.5rem;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (emisores.Count == 0)
                        {
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 2rem; color: var(--color-taupe);">
                                    No tienes un emisor registrado todavia.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in PagedIssuers)
                            {
                                <tr>
                                    <td><strong style="color: var(--color-sage);">@item.ruc</strong></td>
                                    <td>
                                        <strong style="color: var(--color-ink);">@item.razon_social</strong>
                                        <div style="font-size: 0.78rem; color: var(--color-taupe);">@(string.IsNullOrWhiteSpace(item.nombre_comercial) ? "Sin nombre comercial" : item.nombre_comercial)</div>
                                    </td>
                                    <td>@GetEmissionCode(item.establecimiento_codigo, item.punto_emision_codigo)</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.correo) ? "-" : item.correo)</td>
                                    <td>
                                        @if (item.estado)
                                        {
                                            <span class="badge" style="background: rgba(93, 161, 129, 0.15) !important; color: #5DA181 !important; font-size: 0.78rem; padding: 0.35rem 0.65rem; border-radius: 2rem;">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background: rgba(127, 105, 81, 0.12) !important; color: #7F6951 !important; font-size: 0.78rem; padding: 0.35rem 0.65rem; border-radius: 2rem;">Inactivo</span>
                                        }
                                    </td>
                                    <td style="text-align: right; padding-right: 1.2rem;">
                                        <div style="display: inline-flex; gap: 0.4rem; justify-content: flex-end;">
                                            <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(93, 161, 129, 0.3) !important; color: var(--color-sage) !important;" @onclick="() => PrepareEditIssuer(item)">
                                                <i class="bi bi-pencil-fill" style="margin-right: 4px;"></i> Editar
                                            </button>
                                            <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(254, 188, 100, 0.4) !important; color: #e09b3c !important;" @onclick="() => PrepareAuditIssuer(item)">
                                                <i class="bi bi-clock-history" style="margin-right: 4px;"></i> Auditoria
                                            </button>
                                            @if (permissions.CanDelete)
                                            {
                                                <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(127, 105, 81, 0.2) !important; color: var(--color-taupe) !important;" @onclick="() => DeleteIssuerAsync(item)">
                                                    <i class="bi bi-trash3-fill"></i> Eliminar
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <TablePager TotalItems="@emisores.Count" CurrentPage="@issuerPage" CurrentPageChanged="SetIssuerPage" />
        </section>
    </section>
}

@if (showFormModal && editor is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card form-modal-card">
            <header class="custom-modal-header rose-header">
                <h2>@EditorTitle</h2>
                <button type="button" class="btn-close-modal" @onclick="CloseFormModal">×</button>
            </header>
            <div class="custom-modal-body">
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger" role="alert">@errorMessage</div>
                }

                <div class="management-form-grid">
                    <div>
                        <label class="form-label" for="issuerRuc">RUC</label>
                        <input id="issuerRuc" class="form-control" @bind="editor.Ruc" readonly="@(!CanModifyEditor)" maxlength="13" />
                    </div>

                    <div>
                        <label class="form-label" for="issuerTipoPersona">Tipo de persona</label>
                        <select id="issuerTipoPersona" class="form-select" @bind="editor.TipoPersona" disabled="@(!CanModifyEditor)">
                            <option value="N">Natural</option>
                            <option value="J">Juridica</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label" for="issuerTipoId">Tipo de identificacion</label>
                        <select id="issuerTipoId" class="form-select" @bind="editor.TipoIdentificacion" disabled="@(!CanModifyEditor)">
                            @foreach (var option in identificationOptions)
                            {
                                <option value="@option.Code">@option.Label</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label" for="issuerRazon">Razon social</label>
                        <input id="issuerRazon" class="form-control" @bind="editor.RazonSocial" readonly="@(!CanModifyEditor)" maxlength="300" />
                    </div>

                    <div class="patient-form-span">
                        <label class="form-label" for="issuerNombreComercial">Nombre comercial</label>
                        <input id="issuerNombreComercial" class="form-control" @bind="editor.NombreComercial" readonly="@(!CanModifyEditor)" maxlength="300" />
                    </div>

                    <div class="patient-form-span">
                        <label class="form-label" for="issuerDireccion">Direccion</label>
                        <input id="issuerDireccion" class="form-control" @bind="editor.Direccion" readonly="@(!CanModifyEditor)" maxlength="500" />
                    </div>

                    <div class="patient-form-span">
                        <label class="form-label" for="issuerDireccionEstablecimiento">Direccion del establecimiento</label>
                        <input id="issuerDireccionEstablecimiento" class="form-control" @bind="editor.DireccionEstablecimiento" readonly="@(!CanModifyEditor)" maxlength="500" />
                    </div>

                    <div>
                        <label class="form-label" for="issuerPhone">Telefono</label>
                        <input id="issuerPhone" class="form-control" @bind="editor.Telefono" readonly="@(!CanModifyEditor)" maxlength="20" />
                    </div>

                    <div>
                        <label class="form-label" for="issuerMail">Correo</label>
                        <input id="issuerMail" type="email" class="form-control" @bind="editor.Correo" readonly="@(!CanModifyEditor)" maxlength="100" />
                    </div>

                    <div>
                        <label class="form-label" for="issuerProvince">Provincia</label>
                        <input id="issuerProvince" class="form-control" @bind="editor.Provincia" readonly="@(!CanModifyEditor)" maxlength="100" />
                    </div>

                    <div>
                        <label class="form-label" for="issuerCity">Ciudad</label>
                        <input id="issuerCity" class="form-control" @bind="editor.Ciudad" readonly="@(!CanModifyEditor)" maxlength="100" />
                    </div>

                    <div>
                        <label class="form-label" for="issuerPostal">Codigo postal</label>
                        <input id="issuerPostal" class="form-control" @bind="editor.CodigoPostal" readonly="@(!CanModifyEditor)" maxlength="10" />
                    </div>

                    <div>
                        <label class="form-label" for="issuerEstablecimiento">Establecimiento</label>
                        <input id="issuerEstablecimiento" class="form-control" @bind="editor.EstablecimientoCodigo" readonly="@(!CanModifyEditor)" maxlength="3" />
                    </div>

                    <div>
                        <label class="form-label" for="issuerPuntoEmision">Punto de emision</label>
                        <input id="issuerPuntoEmision" class="form-control" @bind="editor.PuntoEmisionCodigo" readonly="@(!CanModifyEditor)" maxlength="3" />
                    </div>

                    <div>
                        <label class="form-label" for="issuerSriEnvironment">Ambiente SRI</label>
                        <select id="issuerSriEnvironment" class="form-select" disabled>
                            <option value="2" selected>2 - Produccion</option>
                        </select>
                        <small class="form-text">Los comprobantes emitidos en este ambiente tienen validez tributaria.</small>
                    </div>

                    <div>
                        <label class="form-label" for="issuerEmissionType">Tipo de emision</label>
                        <select id="issuerEmissionType" class="form-select" disabled>
                            <option value="1" selected>1 - Emision normal</option>
                        </select>
                    </div>

                    <div class="patient-form-span">
                        <label class="form-label">Certificado de firma electronica</label>
                        <InputFile class="form-control" OnChange="HandleCertificateSelectedAsync" accept=".p12,.pfx,application/x-pkcs12" disabled="@(!CanModifyEditor)" />
                        <small class="form-text">
                            @(string.IsNullOrWhiteSpace(editor.CertificateFileName)
                                ? "Selecciona un archivo .p12 o .pfx (maximo 1 MB)."
                                : $"Certificado: {editor.CertificateFileName}")
                        </small>
                    </div>

                    <div class="patient-form-span">
                        <label class="form-label" for="issuerCertificatePassword">Clave del certificado</label>
                        <input id="issuerCertificatePassword" type="password" class="form-control" @bind="editor.CertificatePassword" readonly="@(!CanModifyEditor)" autocomplete="new-password" maxlength="128" />
                        <small class="form-text">Solo debes escribirla al cargar o reemplazar el certificado. Se almacena protegida.</small>
                    </div>

                    <div>
                        <label class="form-label" for="issuerRepresentante">Representante legal</label>
                        <input id="issuerRepresentante" class="form-control" @bind="editor.NombreRepresentanteLegal" readonly="@(!CanModifyEditor)" maxlength="300" />
                    </div>

                    <div>
                        <label class="form-label" for="issuerCedulaRep">Cedula representante</label>
                        <input id="issuerCedulaRep" class="form-control" @bind="editor.CedulaRepresentante" readonly="@(!CanModifyEditor)" maxlength="10" />
                    </div>

                    <div>
                        <label class="form-label" for="issuerContribuyente">No. contribuyente especial</label>
                        <input id="issuerContribuyente" class="form-control" @bind="editor.NumeroContribuyenteEspecial" readonly="@(!CanModifyEditor)" maxlength="10" />
                    </div>

                    <div>
                        <label class="form-label" for="issuerStatus">Estado</label>
                        <select id="issuerStatus" class="form-select" @bind="editor.Estado" disabled="@(!CanModifyEditor)">
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>
                </div>

                <div class="management-form-grid" style="margin-top: 1rem;">
                    <label class="form-check" style="display: flex; gap: 0.55rem; align-items: center;">
                        <input type="checkbox" class="form-check-input" @bind="editor.EsContribuyenteEspecial" disabled="@(!CanModifyEditor)" />
                        <span class="form-check-label">Contribuyente especial</span>
                    </label>
                    <label class="form-check" style="display: flex; gap: 0.55rem; align-items: center;">
                        <input type="checkbox" class="form-check-input" @bind="editor.ObligadoContabilidad" disabled="@(!CanModifyEditor)" />
                        <span class="form-check-label">Obligado a llevar contabilidad</span>
                    </label>
                    <div>
                        <label class="form-label" for="issuerRimpe">Regimen RIMPE</label>
                        <select id="issuerRimpe" class="form-select" @bind="editor.RegimenRimpe" disabled="@(!CanModifyEditor)">
                            <option value="">No aplica</option>
                            <option value="RIMPE">Contribuyente regimen RIMPE</option>
                            <option value="NEGOCIO_POPULAR">Negocio popular - regimen RIMPE</option>
                        </select>
                    </div>
                </div>
            </div>
            <footer class="custom-modal-footer">
                @if (CanModifyEditor)
                {
                    <button type="button" class="btn btn-primary" @onclick="SaveIssuerWithHandlingAsync">Guardar cambios</button>
                }
                <button type="button" class="btn btn-outline-primary" @onclick="CloseFormModal">Cerrar</button>
            </footer>
        </div>
    </div>
}

@if (showAuditModal && selectedIssuer is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card audit-modal-card">
            <header class="custom-modal-header apricot-header">
                <h2>Historial de auditoria - @selectedIssuer.razon_social</h2>
                <button type="button" class="btn-close-modal" @onclick="() => showAuditModal = false">×</button>
            </header>
            <div class="custom-modal-body">
                @if (auditEntries.Count == 0)
                {
                    <p style="text-align: center; color: var(--color-taupe); margin: 2rem 0;">No hay eventos registrados para este emisor.</p>
                }
                else
                {
                    <div class="management-list">
                        @foreach (var auditEntry in auditEntries)
                        {
                            <article class="management-list-item" style="border: 1px solid rgba(127, 105, 81, 0.08); border-radius: 0.8rem; padding: 0.95rem; margin-bottom: 0.6rem; background: #faf8f4;">
                                <div style="display: flex; justify-content: space-between; margin-bottom: 0.35rem;">
                                    <strong style="color: var(--color-sage);">@auditEntry.accion</strong>
                                    <span style="font-size: 0.78rem; color: var(--color-taupe);">@(auditEntry.fecha?.ToString("yyyy-MM-dd HH:mm") ?? "Sin fecha")</span>
                                </div>
                                <div style="font-size: 0.82rem; color: var(--color-ink); margin-bottom: 0.35rem;">@auditEntry.detalle</div>
                                <span style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-taupe); opacity: 0.8;">@GetAuditActorLabel(auditEntry)</span>
                            </article>
                        }
                    </div>
                }
            </div>
            <footer class="custom-modal-footer">
                <button type="button" class="btn btn-outline-primary" @onclick="() => showAuditModal = false">Cerrar</button>
            </footer>
        </div>
    </div>
}

@if (showAlertModal)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card alert-modal-card">
            <header class="custom-modal-header @(alertIsError ? "error-header" : "success-header")">
                <h2>@(alertIsError ? "Error de validacion" : "Operacion exitosa")</h2>
            </header>
            <div class="custom-modal-body" style="padding: 2rem 1.5rem; text-align: center;">
                <div style="font-size: 3rem; margin-bottom: 1rem; color: @(alertIsError ? "#7F6951" : "#5DA181")">
                    <i class="bi @(alertIsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")"></i>
                </div>
                <p style="font-size: 1rem; color: var(--color-ink); line-height: 1.5; margin: 0;">@alertMessage</p>
            </div>
            <footer class="custom-modal-footer" style="justify-content: center;">
                <button type="button" class="btn btn-primary" style="min-width: 120px;" @onclick="CloseAlertModal">Aceptar</button>
            </footer>
        </div>
    </div>
}

@code {
    private readonly List<EmisorEntity> emisores = [];
    private const int TablePageSize = 5;
    private int issuerPage = 1;
    private IEnumerable<EmisorEntity> PagedIssuers => emisores.Skip((issuerPage - 1) * TablePageSize).Take(TablePageSize);
    private void SetIssuerPage(int page) => issuerPage = page;
    private readonly List<(string Code, string Label)> identificationOptions =
    [
        ("04", "04 - RUC"),
        ("05", "05 - Cedula"),
        ("06", "06 - Pasaporte")
    ];
    private List<tbl_log_auditoria> auditEntries = [];
    private IssuerEditorModel? editor;
    private ModulePermissions permissions = new();
    private bool isLoading = true;
    private bool canViewEmisor;
    private bool isCreatingNewIssuer;
    private int currentUserId;
    private int currentRoleId;
    private bool showFormModal;
    private bool showAuditModal;
    private bool showAlertModal;
    private string alertMessage = string.Empty;
    private bool alertIsError;
    private string? errorMessage;
    private EmisorEntity? selectedIssuer;

    private string EditorTitle => isCreatingNewIssuer ? "Nuevo emisor" : "Detalle del emisor";
    private bool CanModifyEditor => isCreatingNewIssuer ? permissions.CanCreate : permissions.CanEdit;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var parsedUserId) ? parsedUserId : 0;
        currentRoleId = int.TryParse(authState.User.FindFirst("RoleId")?.Value, out var parsedRoleId) ? parsedRoleId : 0;
        await LoadAsync();
    }

    private async Task LoadAsync(int? preserveIssuerId = null)
    {
        isLoading = true;
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        permissions = await GetModulePermissionsAsync(dbContext, currentRoleId);
        canViewEmisor = permissions.CanView;

        if (!canViewEmisor || currentUserId <= 0)
        {
            isLoading = false;
            return;
        }

        var loadedIssuers = await dbContext.emisor
            .AsNoTracking()
            .Where(e => e.id_usuario_creacion == currentUserId)
            .ToListAsync();

        emisores.Clear();
        emisores.AddRange(loadedIssuers);

        if (preserveIssuerId.HasValue)
        {
            selectedIssuer = emisores.FirstOrDefault(e => e.emisor_id == preserveIssuerId.Value);
            editor = BuildEditor(selectedIssuer);
        }

        isLoading = false;
    }

    private void PrepareNewIssuer()
    {
        isCreatingNewIssuer = true;
        selectedIssuer = null;
        editor = BuildNewEditor();
        auditEntries = [];
        errorMessage = null;
        showFormModal = true;
    }

    private void PrepareEditIssuer(EmisorEntity item)
    {
        isCreatingNewIssuer = false;
        selectedIssuer = item;
        editor = BuildEditor(item);
        errorMessage = null;
        showFormModal = true;
    }

    private async Task PrepareAuditIssuer(EmisorEntity item)
    {
        selectedIssuer = item;
        await LoadAuditEntriesAsync(item.emisor_id);
        showAuditModal = true;
    }

    private void ShowAlert(string message, bool isError)
    {
        alertMessage = message;
        alertIsError = isError;
        showAlertModal = true;
    }

    private void CloseAlertModal()
    {
        showAlertModal = false;
        alertMessage = string.Empty;
    }

    private void CloseFormModal()
    {
        errorMessage = null;
        showFormModal = false;
    }

    private async Task SaveIssuerAsync()
    {
        errorMessage = null;

        if (!ValidateEditor())
        {
            ShowAlert(errorMessage ?? "Corrige los datos del formulario.", true);
            return;
        }

        if (currentUserId <= 0)
        {
            ShowAlert("No se pudo identificar el usuario autenticado.", true);
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();

        if (isCreatingNewIssuer)
        {
            var ownIssuerExists = await dbContext.emisor.AnyAsync(e => e.id_usuario_creacion == currentUserId);
            if (ownIssuerExists)
            {
                ShowAlert("Cada usuario solo puede tener un emisor.", true);
                return;
            }
        }

        var rucExists = await dbContext.emisor.AnyAsync(e =>
            e.emisor_id != editor!.EmisorId &&
            e.ruc == editor.Ruc.Trim());

        if (rucExists)
        {
            ShowAlert("Ya existe un emisor registrado con ese RUC.", true);
            return;
        }

        EmisorEntity issuerEntity;
        if (isCreatingNewIssuer)
        {
            if (!permissions.CanCreate)
            {
                ShowAlert("Tu rol no tiene permiso para crear emisores.", true);
                return;
            }

            issuerEntity = new EmisorEntity
            {
                id_usuario_creacion = currentUserId,
                fecha_creacion = DateTime.Now
            };

            dbContext.emisor.Add(issuerEntity);
        }
        else
        {
            if (!permissions.CanEdit)
            {
                ShowAlert("Tu rol no tiene permiso para editar emisores.", true);
                return;
            }

            issuerEntity = await dbContext.emisor.FirstOrDefaultAsync(e =>
                    e.emisor_id == editor!.EmisorId &&
                    e.id_usuario_creacion == currentUserId)
                ?? throw new InvalidOperationException("No se encontro el emisor seleccionado.");
        }

        issuerEntity.ruc = editor!.Ruc.Trim();
        issuerEntity.razon_social = editor.RazonSocial.Trim();
        issuerEntity.nombre_comercial = NormalizeOptional(editor.NombreComercial);
        issuerEntity.tipo_persona = editor.TipoPersona;
        issuerEntity.tipo_identificacion = editor.TipoIdentificacion;
        issuerEntity.direccion = NormalizeOptional(editor.Direccion);
        issuerEntity.direccion_establecimiento = NormalizeOptional(editor.DireccionEstablecimiento);
        issuerEntity.telefono = NormalizeOptional(editor.Telefono);
        issuerEntity.correo = NormalizeOptional(editor.Correo);
        issuerEntity.provincia = NormalizeOptional(editor.Provincia);
        issuerEntity.ciudad = NormalizeOptional(editor.Ciudad);
        issuerEntity.codigo_postal = NormalizeOptional(editor.CodigoPostal);
        issuerEntity.establecimiento_codigo = NormalizeEmissionCode(editor.EstablecimientoCodigo);
        issuerEntity.punto_emision_codigo = NormalizeEmissionCode(editor.PuntoEmisionCodigo);
        issuerEntity.ambiente_codigo = Configuration["Sri:Environment"] == "2" ? "2" : "1";
        issuerEntity.tipo_emision_codigo = "1";
        issuerEntity.nombre_representante_legal = NormalizeOptional(editor.NombreRepresentanteLegal);
        issuerEntity.cedula_representante = NormalizeOptional(editor.CedulaRepresentante);
        issuerEntity.es_contribuyente_especial = editor.EsContribuyenteEspecial;
        issuerEntity.numero_contribuyente_especial = NormalizeOptional(editor.NumeroContribuyenteEspecial);
        issuerEntity.obligado_contabilidad = editor.ObligadoContabilidad;
        issuerEntity.regimen_rimpe = NormalizeOptional(editor.RegimenRimpe);
        issuerEntity.estado = editor.Estado;
        issuerEntity.fecha_actualizacion = DateTime.Now;
        issuerEntity.id_usuario_actualizacion = isCreatingNewIssuer ? null : currentUserId;

        if (editor.CertificateBytes is not null)
        {
            var certificatePath = await ValidateAndSaveCertificateAsync(editor);
            issuerEntity.certificado_digital_ruta = certificatePath;
            issuerEntity.certificado_digital_clave = CertificateSecretProtector.Protect(editor.CertificatePassword);
        }

        await dbContext.SaveChangesAsync();

        WriteAudit(
            dbContext,
            isCreatingNewIssuer ? "Crear emisor" : "Editar emisor",
            $"EmisorId={issuerEntity.emisor_id}; Ruc={issuerEntity.ruc}; RazonSocial={issuerEntity.razon_social}");

        await dbContext.SaveChangesAsync();

        ShowAlert(
            isCreatingNewIssuer
                ? "El emisor se creo correctamente."
                : "La informacion del emisor se guardo correctamente.",
            false);

        showFormModal = false;
        isCreatingNewIssuer = false;
        await LoadAsync(issuerEntity.emisor_id);
    }

    private async Task SaveIssuerWithHandlingAsync()
    {
        try
        {
            await SaveIssuerAsync();
        }
        catch (Exception ex)
        {
            errorMessage = GetInnermostMessage(ex);
        }
    }

    private async Task DeleteIssuerAsync(EmisorEntity item)
    {
        if (!permissions.CanDelete || currentUserId <= 0)
        {
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var issuerEntity = await dbContext.emisor.FirstOrDefaultAsync(e =>
            e.emisor_id == item.emisor_id &&
            e.id_usuario_creacion == currentUserId);

        if (issuerEntity is null)
        {
            ShowAlert("No se encontro el emisor seleccionado.", true);
            return;
        }

        WriteAudit(
            dbContext,
            "Eliminar emisor",
            $"EmisorId={issuerEntity.emisor_id}; Ruc={issuerEntity.ruc}; RazonSocial={issuerEntity.razon_social}");

        dbContext.emisor.Remove(issuerEntity);
        await dbContext.SaveChangesAsync();

        ShowAlert("El emisor fue eliminado correctamente.", false);
        selectedIssuer = null;
        await LoadAsync();
    }

    private async Task LoadAuditEntriesAsync(int issuerId)
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var token = $"EmisorId={issuerId};";

        auditEntries = await dbContext.tbl_log_auditoria
            .AsNoTracking()
            .Include(a => a.id_usuarioNavigation)
            .Where(a => a.modulo == "Emisor" && a.detalle != null && a.detalle.Contains(token))
            .OrderByDescending(a => a.fecha)
            .Take(20)
            .ToListAsync();
    }

