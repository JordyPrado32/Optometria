@page "/categorias-de-productos"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<OpticaDbContext> DbContextFactory

<PageTitle>Categorias de productos</PageTitle>

@if (isLoading)
{
    <section class="management-shell">
        <div class="management-card">
            <h1>Cargando categorias...</h1>
        </div>
    </section>
}
else if (!canViewCategories)
{
    <section class="management-shell">
        <div class="management-card">
            <span class="eyebrow">Restringido</span>
            <h1>Categorias de productos</h1>
            <p>Tu rol no tiene permiso para ver este modulo.</p>
        </div>
    </section>
}
else
{
    <section class="management-shell">
        <div class="management-hero">
            <div>
                <span class="eyebrow">Catalogo</span>
                <h1>Categorias de productos</h1>
                <p>Administra las categorias del catalogo con busqueda, control de estado y auditoria sin salir del flujo operativo.</p>
            </div>

            <div class="workspace-actions">
                @if (permissions.CanCreate)
                {
                    <button type="button" class="btn btn-primary" @onclick="PrepareNewCategory">
                        <i class="bi bi-plus-lg" style="margin-right: 6px;"></i> Nueva categoria
                    </button>
                }
            </div>
        </div>

        <section class="management-card">
            <div class="management-card-header">
                <h2>Filtros y busqueda</h2>
                <span>@FilteredCategories.Count resultados</span>
            </div>

            <div class="management-form-grid">
                <div>
                    <label class="form-label" for="categorySearch">Buscador</label>
                    <input id="categorySearch" class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Nombre o descripcion" />
                </div>

                <div>
                    <label class="form-label" for="categoryStatus">Estado</label>
                    <select id="categoryStatus" class="form-select" @bind="selectedStatusFilter">
                        <option value="all">Todas</option>
                        <option value="active">Activas</option>
                        <option value="inactive">Inactivas</option>
                    </select>
                </div>
            </div>

            <div class="management-actions" style="margin-top: 1rem;">
                <button type="button" class="btn btn-outline-primary" @onclick="ClearFilters">Limpiar filtros</button>
            </div>
        </section>

        <section class="management-card" style="margin-top: 1.5rem;">
            <div class="management-card-header">
                <h2>Listado de categorias</h2>
                <span>@FilteredCategories.Count registradas</span>
            </div>

            <div class="table-responsive" style="margin-top: 1rem;">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Categoria</th>
                            <th>Descripcion</th>
                            <th>Productos asociados</th>
                            <th>Estado</th>
                            <th style="text-align: right; padding-right: 1.5rem;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredCategories.Count == 0)
                        {
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 2rem; color: var(--color-taupe);">
                                    No se encontraron categorias con los filtros seleccionados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var category in FilteredCategories)
                            {
                                <tr>
                                    <td>@category.id_categoria</td>
                                    <td><strong style="color: var(--color-ink);">@category.nombre</strong></td>
                                    <td>@(string.IsNullOrWhiteSpace(category.descripcion) ? "-" : category.descripcion)</td>
                                    <td>@category.tbl_productos.Count</td>
                                    <td>
                                        @if (category.activo != false)
                                        {
                                            <span class="badge" style="background: rgba(93, 161, 129, 0.15) !important; color: #5DA181 !important; font-size: 0.78rem; padding: 0.35rem 0.65rem; border-radius: 2rem;">Activa</span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background: rgba(127, 105, 81, 0.12) !important; color: #7F6951 !important; font-size: 0.78rem; padding: 0.35rem 0.65rem; border-radius: 2rem;">Inactiva</span>
                                        }
                                    </td>
                                    <td style="text-align: right; padding-right: 1.2rem;">
                                        <div style="display: inline-flex; gap: 0.4rem; justify-content: flex-end;">
                                            <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(93, 161, 129, 0.3) !important; color: var(--color-sage) !important;" @onclick="() => PrepareEditCategory(category)">
                                                <i class="bi bi-pencil-fill" style="margin-right: 4px;"></i> Editar
                                            </button>
                                            <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(254, 188, 100, 0.4) !important; color: #e09b3c !important;" @onclick="() => PrepareAuditCategory(category)">
                                                <i class="bi bi-clock-history" style="margin-right: 4px;"></i> Auditoria
                                            </button>
                                            @if (permissions.CanDelete)
                                            {
                                                <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(127, 105, 81, 0.2) !important; color: var(--color-taupe) !important;" @onclick="() => ToggleActiveAsync(category)">
                                                    @(category.activo != false ? "Inactivar" : "Activar")
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </section>
}

@if (showFormModal && editor is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card form-modal-card">
            <header class="custom-modal-header rose-header">
                <h2>@EditorTitle</h2>
                <button type="button" class="btn-close-modal" @onclick="CloseFormModal">x</button>
            </header>
            <div class="custom-modal-body">
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger" role="alert">@errorMessage</div>
                }

                <div class="management-form-grid">
                    <div>
                        <label class="form-label" for="categoryName">Nombre</label>
                        <input id="categoryName" class="form-control" @bind="editor.Nombre" readonly="@(!CanModifyEditor)" maxlength="100" />
                    </div>

                    <div>
                        <label class="form-label" for="categoryStatusField">Estado</label>
                        <select id="categoryStatusField" class="form-select" @bind="EditorActivoValue" disabled="@(!CanModifyEditor)">
                            <option value="true">Activa</option>
                            <option value="false">Inactiva</option>
                        </select>
                    </div>
                </div>

                <div style="margin-top: 1rem;">
                    <label class="form-label" for="categoryDescription">Descripcion</label>
                    <textarea id="categoryDescription" class="form-control" rows="4" @bind="editor.Descripcion" readonly="@(!CanModifyEditor)"></textarea>
                </div>
            </div>
            <footer class="custom-modal-footer">
                <button type="button" class="btn btn-outline-primary" @onclick="CloseFormModal">Cancelar</button>
                @if (CanModifyEditor)
                {
                    <button type="button" class="btn btn-primary" @onclick="SaveCategoryWithHandlingAsync">Guardar cambios</button>
                }
            </footer>
        </div>
    </div>
}

@if (showAuditModal && selectedCategory is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card audit-modal-card">
            <header class="custom-modal-header apricot-header">
                <h2>Historial de auditoria</h2>
                <button type="button" class="btn-close-modal" @onclick="() => showAuditModal = false">x</button>
            </header>
            <div class="custom-modal-body">
                <div style="margin-bottom: 1rem;">
                    <strong style="font-size: 1.1rem; color: var(--color-ink);">@selectedCategory.nombre</strong>
                    <span style="display: block; font-size: 0.85rem; color: var(--color-taupe);">Categoria #@selectedCategory.id_categoria</span>
                </div>

                @if (auditEntries.Count == 0)
                {
                    <p>No hay eventos registrados para esta categoria.</p>
                }
                else
                {
                    <div class="management-list">
                        @foreach (var auditEntry in auditEntries)
                        {
                            <article class="management-list-item" style="border: 1px solid rgba(127, 105, 81, 0.08); border-radius: 0.8rem; padding: 0.95rem; margin-bottom: 0.6rem; background: #faf8f4;">
                                <div style="display: flex; justify-content: space-between; margin-bottom: 0.35rem;">
                                    <strong style="color: var(--color-sage);">@auditEntry.accion</strong>
                                    <span style="font-size: 0.78rem; color: var(--color-taupe);">@(auditEntry.fecha?.ToString("yyyy-MM-dd HH:mm") ?? "Sin fecha")</span>
                                </div>
                                <div style="font-size: 0.82rem; color: var(--color-ink); margin-bottom: 0.35rem;">@auditEntry.detalle</div>
                                <span style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-taupe); opacity: 0.8;">@GetAuditActorLabel(auditEntry)</span>
                            </article>
                        }
                    </div>
                }
            </div>
            <footer class="custom-modal-footer">
                <button type="button" class="btn btn-primary" @onclick="() => showAuditModal = false">Cerrar</button>
            </footer>
        </div>
    </div>
}

@if (showAlertModal)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card alert-modal-card">
            <header class="custom-modal-header @(alertIsError ? "error-header" : "success-header")">
                <h2>@(alertIsError ? "Error de validacion" : "Operacion exitosa")</h2>
            </header>
            <div class="custom-modal-body" style="padding: 2rem 1.5rem; text-align: center;">
                <div style="font-size: 3rem; margin-bottom: 1rem; color: @(alertIsError ? "#7F6951" : "#5DA181")">
                    <i class="bi @(alertIsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")"></i>
                </div>
                <p style="font-size: 1rem; color: var(--color-ink); line-height: 1.5; margin: 0;">@alertMessage</p>
            </div>
            <footer class="custom-modal-footer" style="justify-content: center;">
                <button type="button" class="btn btn-primary" style="min-width: 120px;" @onclick="CloseAlertModal">Aceptar</button>
            </footer>
        </div>
    </div>
}

@code {
    private readonly List<tbl_categoria_producto> categories = [];
    private List<tbl_log_auditoria> auditEntries = [];
    private CategoryEditorModel? editor;
    private ModulePermissions permissions = new();
    private bool isLoading = true;
    private bool canViewCategories;
    private bool isCreatingNewCategory;
    private int currentUserId;
    private int currentRoleId;
    private string searchTerm = string.Empty;
    private string selectedStatusFilter = "all";
    private bool showFormModal;
    private bool showAuditModal;
    private bool showAlertModal;
    private string alertMessage = string.Empty;
    private bool alertIsError;
    private string? errorMessage;
    private tbl_categoria_producto? selectedCategory;

    private List<tbl_categoria_producto> FilteredCategories => categories
        .Where(MatchesFilters)
        .OrderBy(c => c.nombre)
        .ToList();

    private string EditorTitle => isCreatingNewCategory ? "Nueva categoria" : "Detalle de la categoria";
    private bool CanModifyEditor => isCreatingNewCategory ? permissions.CanCreate : permissions.CanEdit;
    private string EditorActivoValue
    {
        get => editor?.Activo == true ? "true" : "false";
        set
        {
            if (editor is not null)
            {
                editor.Activo = string.Equals(value, "true", StringComparison.OrdinalIgnoreCase);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var parsedUserId) ? parsedUserId : 0;
        currentRoleId = int.TryParse(authState.User.FindFirst("RoleId")?.Value, out var parsedRoleId) ? parsedRoleId : 0;
        await LoadAsync();
    }

    private async Task LoadAsync(int? preserveCategoryId = null)
    {
        isLoading = true;
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        permissions = await GetModulePermissionsAsync(dbContext, currentRoleId);
        canViewCategories = permissions.CanView;

        if (!canViewCategories)
        {
            isLoading = false;
            return;
        }

        var loadedCategories = await dbContext.tbl_categoria_productos
            .AsNoTracking()
            .Include(c => c.tbl_productos)
            .ToListAsync();

        categories.Clear();
        categories.AddRange(loadedCategories);

        if (preserveCategoryId.HasValue)
        {
            selectedCategory = categories.FirstOrDefault(c => c.id_categoria == preserveCategoryId.Value);
            editor = BuildEditor(selectedCategory);
        }

        isLoading = false;
    }

    private void PrepareNewCategory()
    {
        isCreatingNewCategory = true;
        selectedCategory = null;
        editor = BuildNewEditor();
        auditEntries = [];
        errorMessage = null;
        showFormModal = true;
    }

    private void PrepareEditCategory(tbl_categoria_producto category)
    {
        isCreatingNewCategory = false;
        selectedCategory = category;
        editor = BuildEditor(category);
        errorMessage = null;
        showFormModal = true;
    }

    private async Task PrepareAuditCategory(tbl_categoria_producto category)
    {
        selectedCategory = category;
        await LoadAuditEntriesAsync(category.id_categoria);
        showAuditModal = true;
    }

    private void ShowAlert(string message, bool isError)
    {
        alertMessage = message;
        alertIsError = isError;
        showAlertModal = true;
    }

    private void CloseAlertModal()
    {
        showAlertModal = false;
        alertMessage = string.Empty;
    }

    private void CloseFormModal()
    {
        errorMessage = null;
        showFormModal = false;
    }

    private async Task SaveCategoryAsync()
    {
        errorMessage = null;

        if (!ValidateEditor())
        {
            ShowAlert(errorMessage ?? "Corrige los datos del formulario.", true);
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var normalizedName = editor!.Nombre.Trim().ToLowerInvariant();

        var duplicateExists = await dbContext.tbl_categoria_productos
            .AnyAsync(c => c.id_categoria != editor.IdCategoria && c.nombre.ToLower() == normalizedName);

        if (duplicateExists)
        {
            ShowAlert("Ya existe una categoria con ese nombre.", true);
            return;
        }

        tbl_categoria_producto categoryEntity;
        if (isCreatingNewCategory)
        {
            if (!permissions.CanCreate)
            {
                ShowAlert("Tu rol no tiene permiso para crear categorias.", true);
                return;
            }

            categoryEntity = new tbl_categoria_producto();
            dbContext.tbl_categoria_productos.Add(categoryEntity);
        }
        else
        {
            if (!permissions.CanEdit)
            {
                ShowAlert("Tu rol no tiene permiso para editar categorias.", true);
                return;
            }

            categoryEntity = await dbContext.tbl_categoria_productos.FirstOrDefaultAsync(c => c.id_categoria == editor.IdCategoria)
                ?? throw new InvalidOperationException("No se encontro la categoria seleccionada.");
        }

        categoryEntity.nombre = editor.Nombre.Trim();
        categoryEntity.descripcion = NormalizeOptional(editor.Descripcion);
        categoryEntity.activo = editor.Activo;

        await dbContext.SaveChangesAsync();

        WriteAudit(
            dbContext,
            isCreatingNewCategory ? "Crear categoria producto" : "Editar categoria producto",
            $"CategoriaId={categoryEntity.id_categoria}; Nombre={categoryEntity.nombre}; Activo={(categoryEntity.activo != false ? "Si" : "No")}");

        await dbContext.SaveChangesAsync();

        ShowAlert(
            isCreatingNewCategory ? "La categoria se creo correctamente." : "La categoria se guardo correctamente.",
            false);

        showFormModal = false;
        isCreatingNewCategory = false;
        await LoadAsync(categoryEntity.id_categoria);
    }

    private async Task SaveCategoryWithHandlingAsync()
    {
        try
        {
            await SaveCategoryAsync();
        }
        catch (Exception ex)
        {
            errorMessage = GetInnermostMessage(ex);
        }
    }

    private async Task ToggleActiveAsync(tbl_categoria_producto category)
    {
        if (!permissions.CanDelete)
        {
            ShowAlert("Tu rol no tiene permiso para activar o inactivar categorias.", true);
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var categoryEntity = await dbContext.tbl_categoria_productos
            .Include(c => c.tbl_productos)
            .FirstOrDefaultAsync(c => c.id_categoria == category.id_categoria);

        if (categoryEntity is null)
        {
            ShowAlert("No se encontro la categoria seleccionada.", true);
            return;
        }

        if (categoryEntity.activo != false && categoryEntity.tbl_productos.Any(p => p.activo == true))
        {
            ShowAlert("No puedes inactivar una categoria con productos activos asociados.", true);
            return;
        }

        categoryEntity.activo = !(categoryEntity.activo != false);

        WriteAudit(
            dbContext,
            categoryEntity.activo != false ? "Reactivar categoria producto" : "Inactivar categoria producto",
            $"CategoriaId={categoryEntity.id_categoria}; Nombre={categoryEntity.nombre}; Activo={(categoryEntity.activo != false ? "Si" : "No")}");

        await dbContext.SaveChangesAsync();

        ShowAlert(
            categoryEntity.activo != false ? "La categoria fue activada correctamente." : "La categoria fue inactivada correctamente.",
            false);

        await LoadAsync(categoryEntity.id_categoria);
    }

    private async Task LoadAuditEntriesAsync(int categoryId)
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var token = $"CategoriaId={categoryId};";

        auditEntries = await dbContext.tbl_log_auditoria
            .AsNoTracking()
            .Include(a => a.id_usuarioNavigation)
            .Where(a => a.modulo == "Categorias de productos" && a.detalle != null && a.detalle.Contains(token))
            .OrderByDescending(a => a.fecha)
            .Take(20)
            .ToListAsync();
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        selectedStatusFilter = "all";
    }

    private bool MatchesFilters(tbl_categoria_producto category)
    {
        if (selectedStatusFilter is "active" or "inactive")
        {
            var expectedStatus = selectedStatusFilter == "active";
            if ((category.activo != false) != expectedStatus)
            {
                return false;
            }
        }

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return true;
        }

        var search = searchTerm.Trim().ToLowerInvariant();
        return category.nombre.ToLowerInvariant().Contains(search) ||
               (category.descripcion?.ToLowerInvariant().Contains(search) ?? false);
    }

    private bool ValidateEditor()
    {
        if (editor is null)
        {
            errorMessage = "No hay una categoria seleccionada.";
            return false;
        }

        editor.Nombre = editor.Nombre.Trim();
        editor.Descripcion = editor.Descripcion.Trim();

        if (string.IsNullOrWhiteSpace(editor.Nombre))
        {
            errorMessage = "El nombre de la categoria es obligatorio.";
            return false;
        }

        if (editor.Nombre.Length > 100)
        {
            errorMessage = "El nombre excede la longitud permitida.";
            return false;
        }

        return true;
    }

    private async Task<ModulePermissions> GetModulePermissionsAsync(OpticaDbContext dbContext, int roleId)
    {
        if (roleId <= 0)
        {
            return new ModulePermissions();
        }

        var permission = await dbContext.tbl_rol_menu_permisos
            .AsNoTracking()
            .Where(p => p.id_rol == roleId)
            .Join(
                dbContext.tbl_menu_apps.AsNoTracking().Where(m => m.ruta == "/categorias-de-productos"),
                rolePermission => rolePermission.id_menu,
                menu => menu.id_menu,
                (rolePermission, _) => rolePermission)
            .FirstOrDefaultAsync();

        return permission is null
            ? new ModulePermissions()
            : new ModulePermissions
            {
                CanView = permission.puede_ver,
                CanCreate = permission.puede_crear,
                CanEdit = permission.puede_editar,
                CanDelete = permission.puede_eliminar
            };
    }

    private static CategoryEditorModel BuildNewEditor()
    {
        return new CategoryEditorModel
        {
            Activo = true
        };
    }

    private static CategoryEditorModel? BuildEditor(tbl_categoria_producto? category)
    {
        if (category is null)
        {
            return null;
        }

        return new CategoryEditorModel
        {
            IdCategoria = category.id_categoria,
            Nombre = category.nombre,
            Descripcion = category.descripcion ?? string.Empty,
            Activo = category.activo != false
        };
    }

    private static string? NormalizeOptional(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }

    private static string GetAuditActorLabel(tbl_log_auditoria auditEntry)
    {
        return auditEntry.id_usuarioNavigation is null
            ? "Responsable: Sistema"
            : $"Responsable: {auditEntry.id_usuarioNavigation.usuario}";
    }

    private static string GetInnermostMessage(Exception ex)
    {
        while (ex.InnerException is not null)
        {
            ex = ex.InnerException;
        }

        return ex.Message;
    }

    private void WriteAudit(OpticaDbContext dbContext, string action, string detail)
    {
        dbContext.tbl_log_auditoria.Add(new tbl_log_auditoria
        {
            id_usuario = currentUserId > 0 ? currentUserId : null,
            accion = action,
            modulo = "Categorias de productos",
            fecha = DateTime.Now,
            detalle = detail
        });
    }

    private sealed class ModulePermissions
    {
        public bool CanView { get; set; }
        public bool CanCreate { get; set; }
        public bool CanEdit { get; set; }
        public bool CanDelete { get; set; }
    }

    private sealed class CategoryEditorModel
    {
        public int IdCategoria { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string Descripcion { get; set; } = string.Empty;
        public bool Activo { get; set; } = true;
    }
}
