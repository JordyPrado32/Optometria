@page "/inventarios"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject KardexService KardexService
@inject NavigationManager NavigationManager

<PageTitle>Inventarios</PageTitle>

@if (isLoading)
{
    <section class="management-shell"><div class="management-card"><h1>Cargando inventarios...</h1></div></section>
}
else if (!canView)
{
    <section class="management-shell"><div class="management-card"><h1>Sin acceso</h1></div></section>
}
else
{
    <section class="management-shell">
        <div class="management-hero">
            <div><span class="eyebrow">Inventario</span><h1>Inventarios</h1><p>Consulta tus movimientos, lotes y kardex. Tambien puedes registrar ajustes manuales propios.</p></div>
            <div class="workspace-actions" style="align-items: center;">
                @if (permissions.CanCreate)
                {
                    <button class="btn btn-coffee" @onclick="PrepareNew">
                        <i class="bi bi-plus-lg" style="margin-right: 6px;"></i> Nuevo movimiento
                    </button>
                }
                <button class="btn btn-excel" @onclick="ExportInventories">
                    <i class="bi bi-file-earmark-excel-fill" style="margin-right: 6px;"></i> Exportar Excel
                </button>
            </div>
        </div>

        <section class="management-card compact-filter-card">
            <div class="management-card-header"><h2>Filtros</h2><span>@FilteredMovements.Count movimientos</span></div>
            <div class="filters-row-2">
                <div>
                    <label class="form-label">Buscar</label>
                    <input class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Producto, comprobante o documento" />
                </div>
                <div class="filter-selects-col-2">
                    <div>
                        <label class="form-label">Tipo</label>
                        <select class="form-select" @bind="movementTypeFilter">
                            <option value="">Todos</option>
                            @foreach (var option in movementTypes)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Producto</label>
                        <select class="form-select" @bind="productFilter">
                            <option value="">Todos</option>
                            @foreach (var product in products.OrderBy(p => p.nombre_producto))
                            {
                                <option value="@product.id_producto.ToString()">@product.nombre_producto</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="management-actions" style="margin-top: 0.3rem;">
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ClearFilters" style="padding: 0.3rem 0.7rem !important; font-size: 0.78rem !important; border-color: rgba(127,105,81,0.25) !important;">
                    <i class="bi bi-trash" style="margin-right: 4px;"></i> Limpiar filtros
                </button>
            </div>
        </section>

        <section class="management-card" style="margin-top:1.5rem;">
            <div class="management-card-header"><h2>Movimientos</h2><span>@FilteredMovements.Count</span></div>
            <div class="table-responsive" style="margin-top:1rem;">
                <table class="table table-hover">
                    <thead><tr><th>Fecha</th><th>Producto</th><th>Tipo</th><th>Cantidad</th><th>Stock</th><th>Documento</th><th style="text-align:right;">Acciones</th></tr></thead>
                    <tbody>
                        @if (FilteredMovements.Count == 0)
                        {
                            <tr><td colspan="7" style="text-align:center; padding:2rem;">No hay movimientos.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in PagedMovements)
                            {
                                <tr>
                                    <td>@item.fecha_movimiento?.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@item.id_productoNavigation?.nombre_producto</td>
                                    <td>@item.tipo_movimiento</td>
                                    <td>@item.cantidad</td>
                                    <td>@($"{item.stock_anterior ?? 0} -> {item.stock_resultante ?? 0}")</td>
                                    <td>@(item.comprobante_numero ?? item.tipo_documento_referencia ?? "-")</td>
                                    <td style="text-align:right;">
                                        <span style="font-size:0.78rem; color:var(--color-taupe);">Solo lectura</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <TablePager TotalItems="@FilteredMovements.Count" CurrentPage="@movementPage" CurrentPageChanged="SetMovementPage" />
        </section>

        <section class="management-card" style="margin-top:1.5rem;">
            <div class="management-card-header"><h2>Lotes del usuario</h2><span>@FilteredLots.Count</span></div>
            <div class="table-responsive" style="margin-top:1rem;">
                <table class="table table-hover">
                    <thead><tr><th>Lote</th><th>Producto</th><th>Disponible</th><th>Vencimiento</th><th>Estado</th></tr></thead>
                    <tbody>
                        @if (FilteredLots.Count == 0)
                        {
                            <tr><td colspan="5" style="text-align:center; padding:2rem;">No hay lotes.</td></tr>
                        }
                        else
                        {
                            @foreach (var lot in PagedLots)
                            {
                                <tr><td>@lot.numero_lote</td><td>@lot.id_productoNavigation?.nombre_producto</td><td>@lot.cantidad_disponible</td><td>@lot.fecha_vencimiento?.ToString("yyyy-MM-dd")</td><td>@lot.estado_lote</td></tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <TablePager TotalItems="@FilteredLots.Count" CurrentPage="@lotPage" CurrentPageChanged="SetLotPage" />
        </section>
    </section>
}

@if (showForm && editor is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card">
            <header class="custom-modal-header rose-header"><h2>@(isCreating ? "Nuevo movimiento" : "Editar movimiento")</h2><button class="btn-close-modal" @onclick="CloseForm">×</button></header>
            <div class="custom-modal-body">
                <p class="required-fields-note">Los campos marcados con * son obligatorios.</p>
                <div class="management-form-grid">
                    <div>
                        <label class="form-label">Producto *</label>
                        <select class="form-select" @bind="editor.IdProducto">
                            <option value="0">Selecciona</option>
                            @foreach (var product in products)
                            {
                                <option value="@product.id_producto">@product.nombre_producto</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Tipo *</label>
                        <select class="form-select" @bind="editor.TipoMovimiento">
                            @foreach (var option in movementTypes)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                    <div><label class="form-label">Cantidad *</label><input type="number" class="form-control" @bind="editor.Cantidad" min="1" /></div>
                    <div>
                        <label class="form-label">Metodo valuacion *</label>
                        <select class="form-select" @bind="editor.MetodoValuacion">
                            <option value="">Selecciona</option>
                            @foreach (var method in valuationMethods)
                            {
                                <option value="@method">@method</option>
                            }
                        </select>
                    </div>
                    <details class="additional-details">
                        <summary><span><i class="bi bi-info-circle"></i> Detalles adicionales</span></summary>
                        <div class="additional-details-body">
                            <div><label class="form-label">Comprobante</label><input class="form-control" @bind="editor.ComprobanteNumero" /></div>
                            <div class="patient-form-span"><label class="form-label">Observaciones</label><textarea class="form-control" rows="3" @bind="editor.Observaciones"></textarea></div>
                        </div>
                    </details>
                </div>
            </div>
            <footer class="custom-modal-footer"><button class="btn btn-primary" @onclick="SaveAsync">Guardar</button><button class="btn btn-outline-primary" @onclick="CloseForm">Cerrar</button></footer>
        </div>
    </div>
}

<StatusModal Visible="@showAlert"
             IsError="@alertIsError"
             Title="@alertTitle"
             Message="@alertMessage"
             OnClose="CloseAlert" />

@code {
    private readonly List<tbl_movimiento_inventario> movements = [];
    private readonly List<tbl_lote_producto> lots = [];
    private readonly List<tbl_producto> products = [];
    private readonly string[] movementTypes = ["Entrada", "Salida", "Ajuste"];
    private readonly string[] valuationMethods = ["Promedio", "FIFO", "LIFO"];
    private Permissions permissions = new();
    private MovementEditor? editor;
    private bool isLoading = true, canView, isCreating, showForm, showAlert, alertIsError;
    private int currentUserId, currentRoleId;
    private string alertMessage = string.Empty, alertTitle = string.Empty, searchTerm = string.Empty, movementTypeFilter = string.Empty, productFilter = string.Empty;

    private List<tbl_movimiento_inventario> FilteredMovements => movements.Where(MatchesFilters).ToList();
    private List<tbl_lote_producto> FilteredLots => lots.Where(MatchesLotFilters).ToList();
    private const int TablePageSize = 5;
    private int movementPage = 1, lotPage = 1;
    private int EffectiveMovementPage => Math.Min(movementPage, Math.Max(1, (int)Math.Ceiling(FilteredMovements.Count / (double)TablePageSize)));
    private int EffectiveLotPage => Math.Min(lotPage, Math.Max(1, (int)Math.Ceiling(FilteredLots.Count / (double)TablePageSize)));
    private IEnumerable<tbl_movimiento_inventario> PagedMovements => FilteredMovements.Skip((EffectiveMovementPage - 1) * TablePageSize).Take(TablePageSize);
    private IEnumerable<tbl_lote_producto> PagedLots => FilteredLots.Skip((EffectiveLotPage - 1) * TablePageSize).Take(TablePageSize);
    private void SetMovementPage(int page) => movementPage = page;
    private void SetLotPage(int page) => lotPage = page;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var uid) ? uid : 0;
        currentRoleId = int.TryParse(auth.User.FindFirst("RoleId")?.Value, out var rid) ? rid : 0;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        permissions = await GetPermissionsAsync(db);
        canView = permissions.CanView;
        if (!canView) { isLoading = false; return; }
        products.Clear();
        products.AddRange(await db.tbl_productos
            .AsNoTracking()
            .Where(x =>
                x.activo == true &&
                (x.tipo_item ?? "Producto") == "Producto" &&
                (x.naturaleza_item == null || x.naturaleza_item == "" || x.naturaleza_item == "Bien"))
            .OrderBy(x => x.nombre_producto)
            .ToListAsync());

        var productIds = products.Select(x => x.id_producto).ToList();
        movements.Clear();
        movements.AddRange(await db.tbl_movimiento_inventarios
            .AsNoTracking()
            .Include(x => x.id_productoNavigation)
            .Where(x => x.id_usuario == currentUserId && productIds.Contains(x.id_producto))
            .OrderByDescending(x => x.fecha_movimiento)
            .ToListAsync());
        lots.Clear();
        lots.AddRange(await db.tbl_lote_producto
            .AsNoTracking()
            .Include(x => x.id_productoNavigation)
            .Where(x => x.id_usuario_ingreso == currentUserId && productIds.Contains(x.id_producto))
            .OrderByDescending(x => x.fecha_ingreso)
            .ToListAsync());
        isLoading = false;
    }

    private void PrepareNew() { isCreating = true; editor = new MovementEditor { TipoMovimiento = "Entrada", MetodoValuacion = "Promedio" }; showForm = true; }

    private async Task SaveAsync()
    {
        if (editor is null ||
            editor.IdProducto <= 0 ||
            string.IsNullOrWhiteSpace(editor.TipoMovimiento) ||
            editor.Cantidad <= 0 ||
            string.IsNullOrWhiteSpace(editor.MetodoValuacion) ||
            !valuationMethods.Contains(editor.MetodoValuacion))
        {
            ShowAlert("No se pudo guardar el movimiento.", "Completa producto, tipo, cantidad y metodo de valuacion.", true);
            return;
        }

        try
        {
            await using var db = await DbContextFactory.CreateDbContextAsync();
            var product = await db.tbl_productos.FirstOrDefaultAsync(x =>
                x.id_producto == editor.IdProducto &&
                x.activo == true &&
                (x.tipo_item ?? "Producto") == "Producto" &&
                (x.naturaleza_item == null || x.naturaleza_item == "" || x.naturaleza_item == "Bien"));

            if (product is null)
            {
                ShowAlert("No se pudo guardar el movimiento.", "Selecciona un producto inventariable valido.", true);
                return;
            }

            tbl_movimiento_inventario entity;
            var affectedProductIds = new HashSet<int> { product.id_producto };
            var previousStock = product.stock_actual ?? 0;
            var resultingStock = ResolveResultingStock(editor.TipoMovimiento, previousStock, editor.Cantidad);
            entity = new tbl_movimiento_inventario { id_usuario = currentUserId, fecha_movimiento = DateTime.Now };
            db.tbl_movimiento_inventarios.Add(entity);

            if (resultingStock < 0)
            {
                ShowAlert("No se pudo guardar el movimiento.", "El stock no puede quedar negativo.", true);
                return;
            }

            entity.id_producto = editor.IdProducto;
            entity.tipo_movimiento = editor.TipoMovimiento;
            entity.cantidad = editor.Cantidad;
            entity.stock_anterior = previousStock;
            entity.stock_resultante = resultingStock;
            entity.observaciones = NullIfBlank(editor.Observaciones);
            entity.comprobante_numero = NullIfBlank(editor.ComprobanteNumero);
            entity.metodo_valuacion = NullIfBlank(editor.MetodoValuacion);
            entity.tipo_documento_referencia = "InventarioManual";
            entity.saldo_en_dinero = 0;

            product.stock_actual = resultingStock;

            db.tbl_kardex.Add(new tbl_kardex
            {
                id_producto = product.id_producto,
                fecha_movimiento = DateTime.Now,
                tipo_movimiento = editor.TipoMovimiento,
                tipo_referencia = "InventarioManual",
                comprobante_numero = entity.comprobante_numero,
                cantidad_movimiento = editor.Cantidad,
                stock_anterior = previousStock,
                stock_nuevo = resultingStock,
                metodo_valuacion = entity.metodo_valuacion,
                id_usuario_movimiento = currentUserId,
                descripcion_movimiento = $"Movimiento manual {editor.TipoMovimiento}",
                estado_kardex = "Registrado"
            });

            WriteAudit(db, "Crear movimiento inventario", $"MovimientoInventarioId={entity.id_movimiento_inventario}; ProductoId={entity.id_producto}; Tipo={entity.tipo_movimiento}; Cantidad={entity.cantidad}");
            await db.SaveChangesAsync();
            await KardexService.RebuildForProductsAsync(affectedProductIds, currentUserId, "Movimiento manual");
            CloseForm();
            ShowAlert("Movimiento registrado", "El movimiento de inventario se guardo correctamente.", false);
            await LoadAsync();
        }
        catch (DbUpdateException)
        {
            ShowAlert("No se pudo guardar el movimiento.", "La base de datos rechazo el guardado del kardex. La configuracion ya fue ajustada; recarga la pagina e intenta de nuevo.", true);
        }
        catch (Exception ex)
        {
            ShowAlert("No se pudo guardar el movimiento.", $"Ocurrio un error inesperado al guardar el inventario: {ex.Message}", true);
        }
    }

    private async Task DeleteAsync(tbl_movimiento_inventario item)
    {
        ShowAlert("No se puede eliminar el movimiento.", "Los movimientos historicos no se eliminan. Registra un movimiento compensatorio para corregir el stock.", true);
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        movementTypeFilter = string.Empty;
        productFilter = string.Empty;
    }

    private void ExportInventories()
    {
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query.Add($"search={Uri.EscapeDataString(searchTerm)}");
        }
        if (!string.IsNullOrWhiteSpace(movementTypeFilter))
        {
            query.Add($"type={Uri.EscapeDataString(movementTypeFilter)}");
        }
        if (!string.IsNullOrWhiteSpace(productFilter))
        {
            query.Add($"productId={Uri.EscapeDataString(productFilter)}");
        }

        var exportUrl = query.Count == 0
            ? "/exports/inventories.csv"
            : $"/exports/inventories.csv?{string.Join("&", query)}";

        NavigationManager.NavigateTo(exportUrl, forceLoad: true);
    }

    private bool MatchesFilters(tbl_movimiento_inventario item)
    {
        if (!string.IsNullOrWhiteSpace(movementTypeFilter) && !string.Equals(item.tipo_movimiento, movementTypeFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (int.TryParse(productFilter, out var productId) && productId > 0 && item.id_producto != productId)
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return true;
        }

        var search = searchTerm.Trim().ToLowerInvariant();
        return (item.id_productoNavigation?.nombre_producto.ToLowerInvariant().Contains(search) ?? false) ||
               (item.comprobante_numero?.ToLowerInvariant().Contains(search) ?? false) ||
               (item.tipo_documento_referencia?.ToLowerInvariant().Contains(search) ?? false) ||
               (item.numero_lote?.ToLowerInvariant().Contains(search) ?? false);
    }

    private bool MatchesLotFilters(tbl_lote_producto lot)
    {
        if (int.TryParse(productFilter, out var productId) && productId > 0 && lot.id_producto != productId)
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return true;
        }

        var search = searchTerm.Trim().ToLowerInvariant();
        return lot.numero_lote.ToLowerInvariant().Contains(search) ||
               (lot.id_productoNavigation?.nombre_producto.ToLowerInvariant().Contains(search) ?? false) ||
               (lot.estado_lote?.ToLowerInvariant().Contains(search) ?? false);
    }

    private async Task<Permissions> GetPermissionsAsync(OpticaDbContext db)
    {
        var permission = await db.tbl_rol_menu_permisos.AsNoTracking().Where(p => p.id_rol == currentRoleId)
             .Join(db.tbl_menu_apps.AsNoTracking().Where(m => m.ruta == "/inventarios"), p => p.id_menu, m => m.id_menu, (p, _) => p)
            .FirstOrDefaultAsync();
        return permission is null ? new Permissions() : new Permissions { CanView = permission.puede_ver, CanCreate = permission.puede_crear, CanEdit = permission.puede_editar, CanDelete = permission.puede_eliminar };
    }
    private void WriteAudit(OpticaDbContext db, string action, string detail) => db.tbl_log_auditoria.Add(new tbl_log_auditoria { id_usuario = currentUserId > 0 ? currentUserId : null, accion = action, modulo = "Inventarios", fecha = DateTime.Now, detalle = detail });
    private void ShowAlert(string title, string message, bool isError)
    {
        alertTitle = title;
        alertMessage = message;
        alertIsError = isError;
        showAlert = true;
    }

    private void CloseAlert()
    {
        showAlert = false;
        alertTitle = string.Empty;
        alertMessage = string.Empty;
    }
    private void CloseForm() { showForm = false; editor = null; }
    private static string? NullIfBlank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static int ResolveResultingStock(string? movementType, int previousStock, int quantity)
    {
        if (string.Equals(movementType, "Entrada", StringComparison.OrdinalIgnoreCase))
        {
            return previousStock + quantity;
        }

        if (string.Equals(movementType, "Salida", StringComparison.OrdinalIgnoreCase))
        {
            return previousStock - quantity;
        }

        return quantity;
    }

    private static int ResolveMovementDelta(string? movementType, int quantity, int? stockBefore, int? stockAfter)
    {
        if (string.Equals(movementType, "Entrada", StringComparison.OrdinalIgnoreCase))
        {
            return quantity;
        }

        if (string.Equals(movementType, "Salida", StringComparison.OrdinalIgnoreCase))
        {
            return quantity * -1;
        }

        if (stockBefore.HasValue && stockAfter.HasValue)
        {
            return stockAfter.Value - stockBefore.Value;
        }

        return quantity;
    }
    private sealed class Permissions { public bool CanView { get; set; } public bool CanCreate { get; set; } public bool CanEdit { get; set; } public bool CanDelete { get; set; } }
    private sealed class MovementEditor { public int Id { get; set; } public int IdProducto { get; set; } public string TipoMovimiento { get; set; } = "Entrada"; public int Cantidad { get; set; } = 1; public string ComprobanteNumero { get; set; } = string.Empty; public string MetodoValuacion { get; set; } = "Promedio"; public string Observaciones { get; set; } = string.Empty; }
}
