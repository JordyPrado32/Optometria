@page "/configuracion-optica"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject IJSRuntime JSRuntime

<PageTitle>Configuración de la óptica</PageTitle>

@if (isLoading)
{
    <section class="management-shell"><div class="management-card"><h1>Cargando configuración...</h1></div></section>
}
else if (!isAdmin)
{
    <section class="management-shell"><div class="management-card"><h1>Sin acceso</h1><p>Solo el administrador puede personalizar esta configuración central.</p></div></section>
}
else
{
    <section class="management-shell">
        <header class="clinical-banner">
            <div>
                <span class="clinical-banner-tag">
                    <i class="bi bi-gear-fill"></i> Administración Central & Marca
                </span>
                <h1 class="clinical-banner-title">Configuración Central de la Óptica</h1>
                <p class="clinical-banner-desc">Administra imágenes, datos institucionales, logotipo, membrete, políticas y plantillas operativas del sistema.</p>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-success" role="alert">@statusMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        <section class="management-card">
            <div class="management-card-header">
                <h2>Identidad y operación</h2>
                <span>Datos globales</span>
            </div>

            <div class="management-form-grid" style="margin-top: 1rem;">
                <div><label class="form-label">Nombre comercial</label><input class="form-control" @bind="editor.NombreComercial" /></div>
                <div><label class="form-label">RUC</label><input class="form-control" @bind="editor.Ruc" /></div>
                <div><label class="form-label">Teléfono</label><input class="form-control" @bind="editor.Telefono" /></div>
                <div><label class="form-label">Prefijo WhatsApp</label><input class="form-control" @bind="editor.PrefijoPais" placeholder="593" /></div>
                <div class="clinical-span-2"><label class="form-label">Dirección</label><input class="form-control" @bind="editor.Direccion" /></div>
                <div><label class="form-label">Ruta logo</label><input class="form-control" @bind="editor.RutaLogo" placeholder="/images/logo.png" /></div>
                <div><label class="form-label">Ruta fondo</label><input class="form-control" @bind="editor.RutaFondo" placeholder="/images/fondo.jpg" /></div>
                <div class="clinical-span-2"><label class="form-label">Carpeta RX</label><input class="form-control" @bind="editor.CarpetaRx" placeholder="C:\\RX\\Pendientes" /></div>
            </div>

            <div class="workspace-actions" style="margin-top: 1rem;">
                <button type="button" class="btn btn-outline-primary" @onclick="OpenRxFolderAsync">Abrir carpeta RX</button>
            </div>
        </section>

        <section class="management-card" style="margin-top: 1.5rem;">
            <div class="management-card-header">
                <h2>Impuestos y Fiscalidad</h2>
                <span>Variables impositivas globales</span>
            </div>
            <p class="clinical-helper-text" style="font-size: 0.86rem; color: #6e5c4a; background: #faf8f4; border-left: 4px solid #5DA181; padding: 0.75rem 1rem; border-radius: 0 0.8rem 0.8rem 0; margin-top: 0.8rem;">
                Configura la tasa de IVA principal y las tasas activas aplicables a productos y servicios. Ningún módulo requerirá ingresar impuestos quemados o manuales.
            </p>

            <div class="management-form-grid" style="margin-top: 1rem;">
                <div>
                    <label class="form-label">IVA Principal Vigente (%)</label>
                    <input type="number" step="0.01" min="0" max="100" class="form-control" @bind="editor.PorcentajeImpuesto" />
                    <small class="text-muted">Porcentaje aplicado por defecto (ej. 15.00 ó 12.00).</small>
                </div>
                <div>
                    <label class="form-label">Tasas de IVA disponibles (separadas por coma)</label>
                    <input class="form-control" @bind="editor.OpcionesImpuestoCsv" placeholder="0, 5, 15" />
                    <small class="text-muted">Lista de tarifas activas para el catálogo (ej. "0, 5, 15").</small>
                </div>
            </div>
        </section>

        <section class="management-card" style="margin-top: 1.5rem;">
            <div class="management-card-header">
                <h2>Agendamiento y Operación</h2>
                <span>Liberación automática y cupos</span>
            </div>
            <div class="management-form-grid" style="margin-top: 1rem;">
                <div>
                    <label class="form-label">Horas de anticipación para liberación de citas no confirmadas</label>
                    <input type="number" min="1" max="72" class="form-control" @bind="editor.HorasLiberacionCitaNoConfirmada" />
                    <small class="text-muted">Si una cita sigue "Programada" a falta de estas horas, el sistema libera el cupo automáticamente.</small>
                </div>
            </div>
        </section>

        <section class="management-card" style="margin-top: 1.5rem;">
            <div class="management-card-header">
                <h2>Canales de Asistencia al Paciente (WhatsApp / Teléfono)</h2>
                <span>Atención guiada para adultos mayores</span>
            </div>
            <div class="management-form-grid" style="margin-top: 1rem;">
                <div>
                    <label class="form-label">Teléfono / WhatsApp Recepción Asistida</label>
                    <input class="form-control" @bind="editor.TelefonoRecepcionAsistida" placeholder="0991234567" />
                    <small class="text-muted">Número al que se comunican los pacientes con un solo clic.</small>
                </div>
                <div>
                    <label class="form-label">Teléfono / WhatsApp Laboratorista Técnico</label>
                    <input class="form-control" @bind="editor.TelefonoLaboratorioAsistido" placeholder="0997654321" />
                    <small class="text-muted">Contacto directo para consultas sobre lunas y recetas RX.</small>
                </div>
            </div>
        </section>

        <section class="management-card" style="margin-top: 1.5rem;">
            <div class="management-card-header">
                <h2>Plantillas de mensajes</h2>
                <span>WhatsApp y email</span>
            </div>

            <div class="management-form-grid" style="margin-top: 1rem;">
                <div class="clinical-span-2">
                    <label class="form-label">WhatsApp laboratorio</label>
                    <textarea class="form-control" rows="5" @bind="editor.WhatsappLaboratorioTemplate"></textarea>
                    <small class="text-muted">Variables: `{{order_number}}`, `{{patient_name}}`, `{{rx_type}}`, `{{laboratory_name}}`, `{{observations}}`.</small>
                </div>
                <div class="clinical-span-2">
                    <label class="form-label">Email recordatorio paciente</label>
                    <textarea class="form-control" rows="8" @bind="editor.EmailPacienteTemplate"></textarea>
                    <small class="text-muted">Variables: `{{patient_name}}`, `{{doctor_name}}`, `{{appointment_date}}`, `{{appointment_time}}`, `{{appointment_type}}`, `{{status_label}}`, `{{reminder_window}}`.</small>
                </div>
            </div>
        </section>

        <div class="workspace-actions" style="margin-top: 1.5rem;">
            <button type="button" class="btn btn-primary" @onclick="SaveAsync">Guardar configuración</button>
        </div>
    </section>
}

@code {
    private bool isLoading = true;
    private bool isAdmin;
    private string? statusMessage;
    private string? errorMessage;
    private SettingsEditor editor = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAdmin = int.TryParse(authState.User.FindFirst("RoleId")?.Value, out var roleId) && roleId == 1;
        if (!isAdmin)
        {
            isLoading = false;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var settings = await OpticaCustomizationService.GetOrCreateSettingsAsync(dbContext);
        var whatsappTemplate = await OpticaCustomizationService.GetOrCreateTemplateAsync(
            dbContext,
            "WhatsApp",
            OpticaCustomizationService.LabWhatsappTemplateType,
            OpticaCustomizationService.DefaultLabWhatsappTemplate);
        var emailTemplate = await OpticaCustomizationService.GetOrCreateTemplateAsync(
            dbContext,
            "Email",
            OpticaCustomizationService.PatientReminderEmailTemplateType,
            OpticaCustomizationService.DefaultPatientReminderEmailTemplate);

        editor = new SettingsEditor
        {
            Id = settings.id_configuracion,
            NombreComercial = settings.nombre_comercial ?? string.Empty,
            Ruc = settings.ruc ?? string.Empty,
            Direccion = settings.direccion ?? string.Empty,
            Telefono = settings.telefono ?? string.Empty,
            PrefijoPais = settings.prefijo_pais ?? "593",
            CarpetaRx = settings.carpeta_rx ?? string.Empty,
            RutaLogo = settings.ruta_logo ?? string.Empty,
            RutaFondo = settings.ruta_fondo ?? string.Empty,
            PorcentajeImpuesto = settings.porcentaje_impuesto ?? 15.00m,
            OpcionesImpuestoCsv = settings.opciones_impuesto_csv ?? "0, 5, 15",
            HorasLiberacionCitaNoConfirmada = settings.horas_liberacion_cita_no_confirmada ?? 2,
            TelefonoRecepcionAsistida = settings.telefono_recepcion_asistida ?? string.Empty,
            TelefonoLaboratorioAsistido = settings.telefono_laboratorio_asistido ?? string.Empty,
            WhatsappLaboratorioTemplate = whatsappTemplate.contenido ?? OpticaCustomizationService.DefaultLabWhatsappTemplate,
            EmailPacienteTemplate = emailTemplate.contenido ?? OpticaCustomizationService.DefaultPatientReminderEmailTemplate
        };

        isLoading = false;
    }

    private async Task SaveAsync()
    {
        statusMessage = null;
        errorMessage = null;

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var settings = await OpticaCustomizationService.GetOrCreateSettingsAsync(dbContext);
        settings.nombre_comercial = NormalizeOptional(editor.NombreComercial);
        settings.ruc = NormalizeOptional(editor.Ruc);
        settings.direccion = NormalizeOptional(editor.Direccion);
        settings.telefono = NormalizeOptional(editor.Telefono);
        settings.prefijo_pais = NormalizeOptional(editor.PrefijoPais);
        settings.carpeta_rx = NormalizeOptional(editor.CarpetaRx);
        settings.ruta_logo = NormalizeOptional(editor.RutaLogo);
        settings.ruta_fondo = NormalizeOptional(editor.RutaFondo);
        settings.porcentaje_impuesto = editor.PorcentajeImpuesto > 0 ? editor.PorcentajeImpuesto : 15.00m;
        settings.opciones_impuesto_csv = NormalizeOptional(editor.OpcionesImpuestoCsv) ?? "0, 5, 15";
        settings.horas_liberacion_cita_no_confirmada = editor.HorasLiberacionCitaNoConfirmada > 0 ? editor.HorasLiberacionCitaNoConfirmada : 2;
        settings.telefono_recepcion_asistida = NormalizeOptional(editor.TelefonoRecepcionAsistida);
        settings.telefono_laboratorio_asistido = NormalizeOptional(editor.TelefonoLaboratorioAsistido);

        var whatsappTemplate = await OpticaCustomizationService.GetOrCreateTemplateAsync(
            dbContext,
            "WhatsApp",
            OpticaCustomizationService.LabWhatsappTemplateType,
            OpticaCustomizationService.DefaultLabWhatsappTemplate);
        whatsappTemplate.contenido = string.IsNullOrWhiteSpace(editor.WhatsappLaboratorioTemplate)
            ? OpticaCustomizationService.DefaultLabWhatsappTemplate
            : editor.WhatsappLaboratorioTemplate.Trim();

        var emailTemplate = await OpticaCustomizationService.GetOrCreateTemplateAsync(
            dbContext,
            "Email",
            OpticaCustomizationService.PatientReminderEmailTemplateType,
            OpticaCustomizationService.DefaultPatientReminderEmailTemplate);
        emailTemplate.contenido = string.IsNullOrWhiteSpace(editor.EmailPacienteTemplate)
            ? OpticaCustomizationService.DefaultPatientReminderEmailTemplate
            : editor.EmailPacienteTemplate.Trim();

        await dbContext.SaveChangesAsync();
        statusMessage = "La configuración central y los parámetros del sistema se guardaron correctamente.";
    }

    private async Task OpenRxFolderAsync()
    {
        if (string.IsNullOrWhiteSpace(editor.CarpetaRx))
        {
            errorMessage = "Configura primero la carpeta RX.";
            return;
        }

        await JSRuntime.InvokeVoidAsync("optometriaSession.openRxFolder", editor.CarpetaRx);
    }

    private static string? NormalizeOptional(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private sealed class SettingsEditor
    {
        public int Id { get; set; }
        public string NombreComercial { get; set; } = string.Empty;
        public string Ruc { get; set; } = string.Empty;
        public string Direccion { get; set; } = string.Empty;
        public string Telefono { get; set; } = string.Empty;
        public string PrefijoPais { get; set; } = "593";
        public string CarpetaRx { get; set; } = string.Empty;
        public string RutaLogo { get; set; } = string.Empty;
        public string RutaFondo { get; set; } = string.Empty;
        public decimal PorcentajeImpuesto { get; set; } = 15.00m;
        public string OpcionesImpuestoCsv { get; set; } = "0, 5, 15";
        public int HorasLiberacionCitaNoConfirmada { get; set; } = 2;
        public string TelefonoRecepcionAsistida { get; set; } = string.Empty;
        public string TelefonoLaboratorioAsistido { get; set; } = string.Empty;
        public string WhatsappLaboratorioTemplate { get; set; } = string.Empty;
        public string EmailPacienteTemplate { get; set; } = string.Empty;
    }
}
