@page "/recuperar-contrasena"
@layout AuthLayout
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Recuperar acceso</PageTitle>

<div class="auth-shell">
    <section class="auth-panel auth-panel-brand">
        <div class="wave-divider">
            <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                <path d="M 80,0 C 55,15 45,35 55,55 C 65,75 75,85 80,100 L 100,100 L 100,0 Z" fill="#F4F0E4" />
            </svg>
        </div>
    </section>

    <section class="auth-panel auth-panel-form">
        <div class="auth-card">
            <div class="auth-heading">
                <span class="eyebrow">Recuperar acceso</span>
                <h2>Recuperar contrasena</h2>
                <p>Te enviaremos una clave temporal al correo, vuelve al login a úsala y cambia tu contrasena.</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="alert alert-danger" role="alert">@Error</div>
            }

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="alert alert-success" role="alert">@Message</div>
            }

            <form method="post" action="/auth/forgot-password" class="auth-form">
                <div class="form-group">
                    <label class="form-label" for="credential">Usuario o correo</label>
                    <div class="input-with-icon">
                        <i class="bi bi-envelope-at"></i>
                        <input id="credential" name="credential" class="form-control" placeholder="usuario o correo@dominio.com" autocomplete="username" required />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary auth-submit">Enviar clave temporal</button>
            </form>

            <div class="auth-footer auth-footer-stack">
                <span>Recordaste tu acceso?</span>
                <a href="/">Volver al login</a>
            </div>
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? Message { get; set; }

    private bool shouldRedirectAuthenticatedUser;
    private ClaimsPrincipal? authenticatedUser;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            authenticatedUser = authState.User;
            shouldRedirectAuthenticatedUser = true;
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && shouldRedirectAuthenticatedUser && authenticatedUser is not null)
        {
            shouldRedirectAuthenticatedUser = false;
            NavigateByStage(authenticatedUser);
        }

        return Task.CompletedTask;
    }

    private void NavigateByStage(ClaimsPrincipal user)
    {
        var authStage = user.FindFirst("AuthStage")?.Value;
        var forcePasswordChange = string.Equals(user.FindFirst("ForcePasswordChange")?.Value, bool.TrueString, StringComparison.OrdinalIgnoreCase);

        var target = authStage switch
        {
            "TwoFactorSetupRequired" => "/configurar-2fa",
            "TwoFactorPending" => "/verificar-2fa",
            _ => forcePasswordChange ? "/cambiar-contrasena" : "/dashboard"
        };

        NavigationManager.NavigateTo(target);
    }
}
