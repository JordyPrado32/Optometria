@page "/forgot-password"
@layout AuthLayout
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Recuperar acceso</PageTitle>

<div class="auth-shell">
    <section class="auth-panel auth-panel-brand">
    </section>

    <section class="auth-panel auth-panel-form">
        <div class="auth-card">
            <div class="auth-heading">
                <span class="eyebrow">Recuperar acceso</span>
                <h2>Clave temporal</h2>
                <p>La clave temporal vence y luego se te pedira cambiar la contrasena.</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="alert alert-danger" role="alert">@Error</div>
            }

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="alert alert-success" role="alert">@Message</div>
            }

            <form method="post" action="/auth/forgot-password" class="auth-form">
                <div>
                    <label class="form-label" for="credential">Usuario o correo</label>
                    <input id="credential" name="credential" class="form-control" placeholder="usuario o correo@dominio.com" required />
                </div>

                <button type="submit" class="btn btn-primary auth-submit">Enviar clave temporal</button>
            </form>

            <div class="auth-footer">
                <span>Recordaste tu acceso?</span>
                <a href="/">Volver al login</a>
            </div>
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? Message { get; set; }

    private bool shouldRedirectAuthenticatedUser;
    private ClaimsPrincipal? authenticatedUser;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            authenticatedUser = authState.User;
            shouldRedirectAuthenticatedUser = true;
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && shouldRedirectAuthenticatedUser && authenticatedUser is not null)
        {
            shouldRedirectAuthenticatedUser = false;

            var forcePasswordChange = string.Equals(authenticatedUser.FindFirst("ForcePasswordChange")?.Value, bool.TrueString, StringComparison.OrdinalIgnoreCase);
            NavigationManager.NavigateTo(forcePasswordChange ? "/change-password" : "/dashboard");
        }

        return Task.CompletedTask;
    }
}
