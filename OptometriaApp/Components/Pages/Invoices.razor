    private void BeginLineEdit(tbl_detalle_venta line)
    {
        lineEditor = new ManualLineEditor
        {
            LineId = line.id_detalle_venta,
            ProductId = line.id_producto,
            Quantity = line.cantidad,
            UnitPrice = line.precio_unitario ?? 0,
            Discount = line.descuento ?? 0,
            Concept = line.concepto_item ?? line.id_productoNavigation.nombre_producto
        };
    }

    private void ResetLineEditor()
    {
        lineEditor = new ManualLineEditor();
    }

    private void PrepareQuickProductUpsert()
    {
        var selectedProduct = SelectedManualProduct;
        if (selectedProduct is null)
        {
            productUpsertEditor = new ProductUpsertEditor
            {
                TipoItem = "Producto",
                PrecioVenta = lineEditor.UnitPrice,
                NombreProducto = lineEditor.Concept,
                PorcentajeIva = ivaPercentageOptions[0]
            };
            return;
        }

        productUpsertEditor = new ProductUpsertEditor
        {
            IdProducto = selectedProduct.id_producto,
            IdCategoria = selectedProduct.id_categoria ?? 0,
            CodigoProducto = selectedProduct.codigo_producto,
            NombreProducto = selectedProduct.nombre_producto,
            TipoItem = selectedProduct.tipo_item ?? "Producto",
            PrecioVenta = lineEditor.UnitPrice > 0 ? lineEditor.UnitPrice : selectedProduct.precio_venta,
            TieneIva = selectedProduct.tiene_iva ?? false,
            PorcentajeIva = selectedProduct.tiene_iva == true && ivaPercentageOptions.Contains(selectedProduct.porcentaje_iva ?? 0m)
                ? selectedProduct.porcentaje_iva ?? 0m
                : (selectedProduct.tiene_iva == true ? ivaPercentageOptions[0] : 0m)
        };
    }

    private string ProductUpsertTieneIvaValue
    {
        get => productUpsertEditor.TieneIva ? "true" : "false";
        set
        {
            productUpsertEditor.TieneIva = string.Equals(value, "true", StringComparison.OrdinalIgnoreCase);
            if (productUpsertEditor.TieneIva)
            {
                if (!ivaPercentageOptions.Contains(productUpsertEditor.PorcentajeIva))
                {
                    productUpsertEditor.PorcentajeIva = ivaPercentageOptions[0];
                }
            }
            else
            {
                productUpsertEditor.PorcentajeIva = 0;
            }
        }
    }

    private async Task SaveQuickProductAsync()
    {
        statusMessage = null;
        errorMessage = null;

        if (!canEditModule)
        {
            return;
        }

        productUpsertEditor.CodigoProducto = productUpsertEditor.CodigoProducto.Trim();
        productUpsertEditor.NombreProducto = productUpsertEditor.NombreProducto.Trim();

        if (string.IsNullOrWhiteSpace(productUpsertEditor.CodigoProducto) || string.IsNullOrWhiteSpace(productUpsertEditor.NombreProducto))
        {
            errorMessage = "Completa el codigo y el nombre del producto.";
            return;
        }

        if (productUpsertEditor.IdCategoria <= 0)
        {
            errorMessage = "Selecciona una categoria para el producto.";
            return;
        }

        if (productUpsertEditor.PrecioVenta < 0 || productUpsertEditor.PorcentajeIva < 0)
        {
            errorMessage = "Precio e IVA no pueden ser negativos.";
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        tbl_producto? product = null;

        if (productUpsertEditor.IdProducto > 0)
        {
            product = await dbContext.tbl_productos.FirstOrDefaultAsync(x => x.id_producto == productUpsertEditor.IdProducto);
        }

        product ??= await dbContext.tbl_productos.FirstOrDefaultAsync(x => x.codigo_producto == productUpsertEditor.CodigoProducto);

        if (product is null)
        {
            product = new tbl_producto
            {
                codigo_producto = productUpsertEditor.CodigoProducto,
                activo = true,
                fecha_creacion = DateTime.Now,
                usuario_creacion = GetCurrentActorLabel()
            };
            dbContext.tbl_productos.Add(product);
        }

        product.codigo_producto = productUpsertEditor.CodigoProducto;
        product.nombre_producto = productUpsertEditor.NombreProducto;
        product.tipo_item = string.IsNullOrWhiteSpace(productUpsertEditor.TipoItem) ? "Producto" : productUpsertEditor.TipoItem;
        product.id_categoria = productUpsertEditor.IdCategoria;
        product.precio_venta = productUpsertEditor.PrecioVenta;
        product.tiene_iva = productUpsertEditor.TieneIva;
        product.porcentaje_iva = productUpsertEditor.TieneIva ? productUpsertEditor.PorcentajeIva : 0;
        product.naturaleza_item ??= string.Equals(product.tipo_item, "Servicio", StringComparison.OrdinalIgnoreCase) ? "Servicio" : "Bien";
        product.stock_actual ??= 0;
        product.stock_minimo ??= 0;
        product.activo = true;
        product.id_usuario_actualizacion = currentUserId > 0 ? currentUserId : null;

        await dbContext.SaveChangesAsync();

        lineEditor.ProductId = product.id_producto;
        lineEditor.UnitPrice = product.precio_venta;
        lineEditor.Concept = product.nombre_producto;

        showProductUpsertForm = false;
        await LoadAsync(selectedPatientId > 0 ? selectedPatientId : null);
        lineEditor.ProductId = product.id_producto;
        ApplySelectedProductDefaults();
        statusMessage = $"Producto {product.codigo_producto} guardado correctamente.";
    }

    private void ApplySelectedProductDefaults()
    {
        var product = SelectedManualProduct;
        if (product is null)
        {
            return;
        }

        lineEditor.UnitPrice = product.precio_venta;
        lineEditor.Concept = product.nombre_producto;
    }

