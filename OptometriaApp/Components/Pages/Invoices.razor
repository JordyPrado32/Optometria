@page "/invoices"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using OptometriaApp.Data
@using OptometriaApp.Models
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BillingDraftService BillingDraftService
@inject IDbContextFactory<OpticaDbContext> DbContextFactory

<PageTitle>Facturas</PageTitle>

<style>
    .invoice-workspace {
        padding: 0;
        overflow: hidden;
    }

    .invoice-sheet-header {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.5rem;
        background: linear-gradient(135deg, rgba(93, 161, 129, 0.12), rgba(254, 188, 100, 0.08));
        border-bottom: 1px solid rgba(127, 105, 81, 0.12);
    }

    .invoice-sheet-body {
        padding: 1.5rem;
    }

    .invoice-toolbar-grid,
    .invoice-party-grid,
    .invoice-editor-grid,
    .invoice-upsert-grid,
    .invoice-bottom-grid {
        display: grid;
        gap: 1rem;
    }

    .invoice-toolbar-grid,
    .invoice-editor-grid,
    .invoice-upsert-grid {
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }

    .invoice-party-grid,
    .invoice-bottom-grid {
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }

    .invoice-section {
        border: 1px solid rgba(127, 105, 81, 0.12);
        border-radius: 1rem;
        padding: 1rem;
        background: rgba(255, 255, 255, 0.72);
    }

    .invoice-block-title {
        font-size: 0.85rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-taupe);
        margin-bottom: 0.85rem;
    }

    .invoice-summary-table td {
        padding: 0.45rem 0;
        border: none;
    }

    .invoice-summary-table td:last-child {
        text-align: right;
        font-weight: 700;
        color: var(--color-ink);
    }

    .invoice-lines-table th,
    .invoice-lines-table td {
        vertical-align: middle;
    }

    .invoice-line-editor,
    .invoice-product-upsert {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px dashed rgba(127, 105, 81, 0.18);
    }

    .invoice-kpi {
        text-align: right;
    }

    .invoice-kpi strong {
        display: block;
        font-size: 1.5rem;
        color: var(--color-ink);
    }

    @@media (max-width: 768px) {
        .invoice-sheet-header {
            flex-direction: column;
        }

        .invoice-kpi {
            text-align: left;
        }
    }
</style>

@if (isLoading)
{
    <section class="management-shell">
        <div class="management-card">
            <h1>Cargando facturas...</h1>
        </div>
    </section>
}
else if (!canViewModule)
{
    <section class="management-shell">
        <div class="management-card">
            <span class="eyebrow">Restringido</span>
            <h1>Facturas</h1>
            <p>Tu rol no tiene permiso para entrar a este modulo.</p>
        </div>
    </section>
}
else
{
    <section class="management-shell">
        <div class="management-hero">
            <div>
                <span class="eyebrow">Facturacion</span>
                <h1>Factura tradicional</h1>
                <p>Prepara una factura clasica con cabecera, cliente, tabla de items, totales y upserts inline sin salir del flujo.</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-success" role="alert">@statusMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        <section class="management-card invoice-workspace">
            <div class="invoice-sheet-header">
                <div>
                    <span class="eyebrow">Documento de venta</span>
                    <h2 style="margin: 0.35rem 0 0.45rem;">Factura #@invoiceNumberPreview</h2>
                    <p style="margin: 0; color: var(--color-taupe);">Fecha de trabajo: @InvoiceDateLabel</p>
                </div>

                <div class="invoice-kpi">
                    <span class="eyebrow">Total actual</span>
                    <strong>@totalPreview.ToString("0.00")</strong>
                    <span style="color: var(--color-taupe);">Saldo: @balancePreview.ToString("0.00")</span>
                </div>
            </div>

            <div class="invoice-sheet-body">
                <div class="invoice-toolbar-grid">
                    <div>
                        <label class="form-label" for="invoicePatient">Paciente</label>
                        <select id="invoicePatient" class="form-select" value="@selectedPatientId" @onchange="OnPatientChanged" disabled="@(!canEditModule)">
                            <option value="0">Selecciona</option>
                            @foreach (var patient in patients)
                            {
                                <option value="@patient.id_paciente">@GetPatientLabel(patient)</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label" for="invoiceClient">Cliente</label>
                        <select id="invoiceClient" class="form-select" value="@selectedClientId" @onchange="OnClientChanged" disabled="@(!canEditModule)">
                            <option value="0">Selecciona</option>
                            @foreach (var client in clients)
                            {
                                <option value="@client.cliente_id">@GetClientLabel(client)</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label">Forma de pago</label>
                        <select class="form-select" @bind="paymentForm" disabled="@(!canEditModule)">
                            @foreach (var method in paymentMethods)
                            {
                                <option value="@method">@method</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label">Dias de credito</label>
                        <input type="number" class="form-control" @bind="creditDays" min="0" readonly="@(!canEditModule)" />
                    </div>

                    <div>
                        <label class="form-label">Impuesto promedio %</label>
                        <input class="form-control" value="@taxRate.ToString("0.##")" readonly />
                    </div>

                    <div>
                        <label class="form-label">Valor cobrado</label>
                        <input type="number" step="0.01" class="form-control" @bind="paidAmount" min="0" readonly="@(!canEditModule)" />
                    </div>
                </div>

                <div class="invoice-party-grid" style="margin-top: 1.25rem;">
                    <section class="invoice-section">
                        <div class="invoice-block-title">Facturar a</div>
                        @if (billingClient is null && selectedPatient is null)
                        {
                            <p style="margin: 0;">Selecciona un cliente y, si quieres cargar pendientes, un paciente origen.</p>
                        }
                        else
                        {
                            <div class="invoice-toolbar-grid">
                                <div>
                                    <label class="form-label">Paciente origen</label>
                                    <input class="form-control" value="@(selectedPatient is null ? "Varios / no definido" : GetPatientLabel(selectedPatient))" readonly />
                                </div>
                                <div>
                                    <label class="form-label">Identificacion</label>
                                    <input class="form-control" value="@(billingClient?.numero_identificacion ?? selectedPatient?.cedula ?? string.Empty)" readonly />
                                </div>
                                <div>
                                    <label class="form-label">Razon social</label>
                                    <input class="form-control" value="@(billingClient?.razon_social ?? (selectedPatient is null ? string.Empty : GetPatientFullName(selectedPatient)))" readonly />
                                </div>
                                <div>
                                    <label class="form-label">Telefono</label>
                                    <input class="form-control" value="@(billingClient?.telefono ?? selectedPatient?.telefono ?? string.Empty)" readonly />
                                </div>
                                <div>
                                    <label class="form-label">Correo</label>
                                    <input class="form-control" value="@(billingClient?.correo_electronico ?? selectedPatient?.email ?? string.Empty)" readonly />
                                </div>
                                <div>
                                    <label class="form-label">Condicion</label>
                                    <input class="form-control" value="@(billingClient?.condicion_pago ?? "Contado")" readonly />
                                </div>
                            </div>
                        }
                    </section>

                    <section class="invoice-section">
                        <div class="invoice-block-title">Resumen del documento</div>
                        <table class="table invoice-summary-table" style="margin-bottom: 0;">
                            <tbody>
                                <tr><td>Numero factura</td><td>@invoiceNumberPreview</td></tr>
                                <tr><td>Lineas cargadas</td><td>@draftLines.Count</td></tr>
                                <tr><td>Subtotal</td><td>@subtotalPreview.ToString("0.00")</td></tr>
                                <tr><td>Impuestos</td><td>@taxPreview.ToString("0.00")</td></tr>
                                <tr><td>Total</td><td>@totalPreview.ToString("0.00")</td></tr>
                            </tbody>
                        </table>

                        <div class="workspace-actions" style="margin-top: 1rem;">
                            <a class="btn btn-outline-primary" href="/clients">Administrar clientes</a>
                        </div>
                    </section>
                </div>

                <section class="invoice-section" style="margin-top: 1.25rem;">
                    <div class="management-card-header">
                        <h2>Detalle de factura</h2>
                        <span>@draftLines.Count lineas</span>
                    </div>

                    <div class="table-responsive" style="margin-top: 1rem;">
                        <table class="table table-hover invoice-lines-table">
                            <thead>
                                <tr>
                                    <th>Codigo</th>
                                    <th>Concepto</th>
                                    <th>Origen</th>
                                    <th>IVA</th>
                                    <th>Cantidad</th>
                                    <th>Precio</th>
                                    <th>Descuento</th>
                                    <th>Total</th>
                                    <th style="text-align: right;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (draftLines.Count == 0)
                                {
                                    <tr>
                                        <td colspan="9" style="text-align: center; padding: 2rem; color: var(--color-taupe);">No hay lineas en la factura.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var line in draftLines)
                                    {
                                        <tr>
                                            <td>@line.id_productoNavigation.codigo_producto</td>
                                            <td>
                                                <strong>@(line.concepto_item ?? line.id_productoNavigation.nombre_producto)</strong>
                                                <div style="font-size: 0.78rem; color: var(--color-taupe);">@line.id_productoNavigation.nombre_producto</div>
                                            </td>
                                            <td>@GetOriginLabel(line)</td>
                                            <td>@GetLineTaxLabel(line)</td>
                                            <td>@line.cantidad</td>
                                            <td>@((line.precio_unitario ?? 0).ToString("0.00"))</td>
                                            <td>@((line.descuento ?? 0).ToString("0.00"))</td>
                                            <td>@((line.total_item ?? 0).ToString("0.00"))</td>
                                            <td style="text-align: right;">
                                                <div style="display: inline-flex; gap: 0.5rem;">
                                                    <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important;" @onclick="() => BeginLineEdit(line)" disabled="@(!canEditModule)">
                                                        Editar
                                                    </button>
                                                    <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important;" @onclick="() => RemoveLineAsync(line.id_detalle_venta)" disabled="@(!canEditModule)">
                                                        Quitar
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="invoice-line-editor">
                        <div class="invoice-block-title">@(lineEditor.LineId > 0 ? "Editar linea" : "Nueva linea")</div>

                        <div class="invoice-editor-grid">
                            <div>
                                <label class="form-label">Producto o servicio</label>
                                <select class="form-select" value="@lineEditor.ProductId" @onchange="OnManualProductChanged" disabled="@(!canEditModule)">
                                    <option value="0">Selecciona</option>
                                    @foreach (var product in products)
                                    {
                                        <option value="@product.id_producto">@($"{product.codigo_producto} - {product.nombre_producto}")</option>
                                    }
                                </select>
                            </div>

                            <div>
                                <label class="form-label">Cantidad</label>
                                <input type="number" class="form-control" @bind="lineEditor.Quantity" min="1" readonly="@(!canEditModule)" />
                            </div>

                            <div>
                                <label class="form-label">Precio unitario</label>
                                <input type="number" step="0.01" class="form-control" @bind="lineEditor.UnitPrice" min="0" readonly="@(!canEditModule)" />
                            </div>

                            <div>
                                <label class="form-label">Descuento</label>
                                <input type="number" step="0.01" class="form-control" @bind="lineEditor.Discount" min="0" readonly="@(!canEditModule)" />
                            </div>

                            <div>
                                <label class="form-label">IVA del producto</label>
                                <input class="form-control" value="@(SelectedManualProduct is null ? "Selecciona un producto" : GetProductTaxLabel(SelectedManualProduct))" readonly />
                            </div>

                            <div>
                                <label class="form-label">Total de linea</label>
                                <input class="form-control" value="@LineEditorTotal.ToString("0.00")" readonly />
                            </div>

                            <div style="grid-column: 1 / -1;">
                                <label class="form-label">Concepto</label>
                                <input class="form-control" @bind="lineEditor.Concept" readonly="@(!canEditModule)" />
                            </div>
                        </div>

                        <div class="workspace-actions" style="margin-top: 1rem;">
                            <button type="button" class="btn btn-primary" @onclick="SaveLineAsync" disabled="@(!canEditModule)">@LineActionLabel</button>
                            <button type="button" class="btn btn-outline-primary" @onclick="ResetLineEditor" disabled="@(!canEditModule)">Limpiar</button>
                            <button type="button" class="btn btn-outline-primary" @onclick="ToggleProductUpsertForm" disabled="@(!canEditModule)">Upsert producto</button>
                        </div>
                    </div>

                    @if (showProductUpsertForm)
                    {
                        <div class="invoice-product-upsert">
                            <div class="invoice-block-title">@(productUpsertEditor.IdProducto > 0 ? "Editar producto" : "Crear producto rapido")</div>

                            <div class="invoice-upsert-grid">
                                <div>
                                    <label class="form-label">Codigo *</label>
                                    <input class="form-control" @bind="productUpsertEditor.CodigoProducto" maxlength="50" />
                                </div>

                                <div>
                                    <label class="form-label">Nombre *</label>
                                    <input class="form-control" @bind="productUpsertEditor.NombreProducto" maxlength="150" />
                                </div>

                                <div>
                                    <label class="form-label">Tipo item</label>
                                    <select class="form-select" @bind="productUpsertEditor.TipoItem">
                                        <option value="Producto">Producto</option>
                                        <option value="Servicio">Servicio</option>
                                    </select>
                                </div>

                                <div>
                                    <label class="form-label">Categoria *</label>
                                    <select class="form-select" @bind="productUpsertEditor.IdCategoria">
                                        <option value="0">Selecciona</option>
                                        @foreach (var category in categories.OrderBy(x => x.nombre))
                                        {
                                            <option value="@category.id_categoria">@category.nombre</option>
                                        }
                                    </select>
                                </div>

                                <div>
                                    <label class="form-label">Precio venta</label>
                                    <input type="number" step="0.01" min="0" class="form-control" @bind="productUpsertEditor.PrecioVenta" />
                                </div>

                                <div>
                                    <label class="form-label">Tiene IVA</label>
                                    <select class="form-select" @bind="ProductUpsertTieneIvaValue">
                                        <option value="true">Si</option>
                                        <option value="false">No</option>
                                    </select>
                                </div>

                                <div>
                                    <label class="form-label">IVA %</label>
                                    <select class="form-select" @bind="productUpsertEditor.PorcentajeIva" disabled="@(!productUpsertEditor.TieneIva)">
                                        @foreach (var percentage in ivaPercentageOptions)
                                        {
                                            <option value="@percentage">@($"{percentage:0}%")</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="workspace-actions" style="margin-top: 1rem;">
                                <button type="button" class="btn btn-primary" @onclick="SaveQuickProductAsync">@ProductUpsertActionLabel</button>
                            </div>
                        </div>
                    }
                </section>

                <div class="invoice-bottom-grid" style="margin-top: 1.25rem;">
                    <section class="invoice-section">
                        <div class="invoice-block-title">Observaciones</div>
                        <textarea class="form-control" rows="7" @bind="invoiceNotes" readonly="@(!canEditModule)"></textarea>
                    </section>

                    <section class="invoice-section">
                        <div class="invoice-block-title">Totales</div>
                        <table class="table invoice-summary-table" style="margin-bottom: 1rem;">
                            <tbody>
                                <tr><td>Subtotal</td><td>@subtotalPreview.ToString("0.00")</td></tr>
                                <tr><td>Impuestos</td><td>@taxPreview.ToString("0.00")</td></tr>
                                <tr><td>Total</td><td>@totalPreview.ToString("0.00")</td></tr>
                                <tr><td>Valor cobrado</td><td>@paidAmount.ToString("0.00")</td></tr>
                                <tr><td>Saldo pendiente</td><td>@balancePreview.ToString("0.00")</td></tr>
                            </tbody>
                        </table>

                        <div class="workspace-actions">
                            <button type="button" class="btn btn-primary" @onclick="FinalizeInvoiceAsync" disabled="@(!canEditModule)">Emitir factura</button>
                        </div>
                    </section>
                </div>
            </div>
        </section>
    </section>
}

@code {
    private readonly List<tbl_paciente> patients = [];
    private readonly List<ClientEntity> clients = [];
    private readonly List<tbl_producto> products = [];
    private readonly List<tbl_categoria_producto> categories = [];
    private readonly List<string> paymentMethods = [];
    private readonly List<tbl_detalle_venta> draftLines = [];
    private ModulePermissions permissions = new();
    private tbl_paciente? selectedPatient;
    private ClientEntity? billingClient;
    private tbl_venta? draftSale;
    private bool isLoading = true;
    private bool canViewModule;
    private bool canEditModule;
    private int currentUserId;
    private int currentRoleId;
    private int selectedPatientId;
    private int selectedClientId;
    private string? statusMessage;
    private string? errorMessage;
    private string invoiceNumberPreview = "000000001";
    private string paymentForm = "Efectivo";
    private int creditDays;
    private decimal taxRate;
    private decimal paidAmount;
    private string invoiceNotes = string.Empty;
    private decimal subtotalPreview;
    private decimal taxPreview;
    private decimal totalPreview;
    private decimal balancePreview;
    private readonly decimal[] ivaPercentageOptions = [5m, 8m, 13m, 15m];
    private ManualLineEditor lineEditor = new();
    private ProductUpsertEditor productUpsertEditor = new();
    private bool showProductUpsertForm;

    private tbl_producto? SelectedManualProduct => products.FirstOrDefault(x => x.id_producto == lineEditor.ProductId);
    private string InvoiceDateLabel => (draftSale?.fecha_venta ?? DateTime.Now).ToString("yyyy-MM-dd HH:mm");
    private decimal LineEditorTotal => Math.Max(0m, (lineEditor.UnitPrice * lineEditor.Quantity) - lineEditor.Discount);
    private string LineActionLabel => lineEditor.LineId > 0 ? "Actualizar linea" : "Agregar linea";
    private string ProductUpsertActionLabel => productUpsertEditor.IdProducto > 0 ? "Actualizar producto" : "Guardar producto";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync(int? patientId = null)
    {
        isLoading = true;
        statusMessage = null;
        errorMessage = null;

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        currentUserId = int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var userId) ? userId : 0;
        currentRoleId = int.TryParse(user.FindFirstValue("RoleId"), out var roleId) ? roleId : 0;

        permissions = await GetModulePermissionsAsync(dbContext, currentRoleId);
        canViewModule = permissions.CanView;
        canEditModule = permissions.CanCreate || permissions.CanEdit;

        if (!canViewModule)
        {
            isLoading = false;
            return;
        }

        patients.Clear();
        patients.AddRange(await dbContext.tbl_pacientes
            .AsNoTracking()
            .Where(x => x.activo == true)
            .OrderBy(x => x.apellidos)
            .ThenBy(x => x.nombres)
            .ToListAsync());

        clients.Clear();
        clients.AddRange(await dbContext.clients
            .AsNoTracking()
            .Where(x => x.estado && x.id_usuario_creacion == currentUserId)
            .OrderBy(x => x.razon_social)
            .ThenBy(x => x.numero_identificacion)
            .ToListAsync());

        categories.Clear();
        categories.AddRange(await dbContext.tbl_categoria_productos
            .AsNoTracking()
            .Where(x => x.activo == true)
            .OrderBy(x => x.nombre)
            .ToListAsync());

        products.Clear();
        products.AddRange(await dbContext.tbl_productos
            .AsNoTracking()
            .Where(x => x.activo == true)
            .OrderBy(x => x.tipo_item)
            .ThenBy(x => x.nombre_producto)
            .ToListAsync());

        paymentMethods.Clear();
        paymentMethods.AddRange(await dbContext.tbl_metodo_pagos
            .AsNoTracking()
            .OrderBy(x => x.nombre)
            .Select(x => x.nombre)
            .ToListAsync());

        if (paymentMethods.Count == 0)
        {
            paymentMethods.AddRange(["Efectivo", "Tarjeta", "Transferencia", "Credito"]);
        }

        invoiceNumberPreview = await BillingDraftService.GenerateNextInvoiceNumberAsync(dbContext);

        selectedPatientId = patientId ?? selectedPatientId;
        await LoadCurrentDraftContextAsync(dbContext, selectedPatientId, selectedClientId);

        isLoading = false;
    }

    private async Task LoadCurrentDraftContextAsync(OpticaDbContext dbContext, int patientId, int clientId)
    {
        selectedPatient = patientId > 0
            ? await dbContext.tbl_pacientes.FirstOrDefaultAsync(x => x.id_paciente == patientId)
            : null;

        billingClient = clientId > 0
            ? clients.FirstOrDefault(x => x.cliente_id == clientId)
            : null;

        if (selectedPatient is null && billingClient is null)
        {
            draftSale = null;
            draftLines.Clear();
            showProductUpsertForm = false;
            ResetLineEditor();
            RecalculatePreview();
            return;
        }

        try
        {
            draftSale = await BillingDraftService.GetOrCreateDraftSaleAsync(
                dbContext,
                selectedPatient?.id_paciente,
                billingClient?.cliente_id,
                currentUserId);

            draftSale = await dbContext.tbl_venta
                .Include(x => x.tbl_detalle_venta)
                .ThenInclude(x => x.id_productoNavigation)
                .FirstAsync(x => x.id_venta == draftSale.id_venta);

            selectedClientId = draftSale.id_cliente_facturacion ?? selectedClientId;
            if (selectedClientId > 0)
            {
                billingClient = clients.FirstOrDefault(x => x.cliente_id == selectedClientId);
            }

            paymentForm = draftSale.forma_pago ?? paymentMethods.First();
            creditDays = draftSale.dias_credito ?? 0;
            taxRate = draftSale.porcentaje_impuesto ?? 0;
            paidAmount = draftSale.valor_cobrado ?? 0;
            invoiceNotes = draftSale.observaciones_factura ?? string.Empty;

            draftLines.Clear();
            draftLines.AddRange(draftSale.tbl_detalle_venta.OrderByDescending(x => x.origen_tipo).ThenBy(x => x.id_detalle_venta));
            await BillingDraftService.RecalculateSaleAsync(dbContext, draftSale);
            showProductUpsertForm = false;
            ResetLineEditor();
            RecalculatePreview();
        }
        catch (InvalidOperationException)
        {
            draftSale = null;
            draftLines.Clear();
            showProductUpsertForm = false;
            ResetLineEditor();
            RecalculatePreview();
        }
    }

    private Task OnManualProductChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var productId))
        {
            productId = 0;
        }

        lineEditor.ProductId = productId;
        ApplySelectedProductDefaults();
        return Task.CompletedTask;
    }

    private async Task OnPatientChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var patientId))
        {
            patientId = 0;
        }

        selectedPatientId = patientId;
        await LoadAsync(patientId);
    }

    private async Task OnClientChanged(ChangeEventArgs args)
    {
        statusMessage = null;
        errorMessage = null;

        if (!int.TryParse(args.Value?.ToString(), out var clientId))
        {
            clientId = 0;
        }

        selectedClientId = clientId;
        billingClient = clients.FirstOrDefault(x => x.cliente_id == clientId);
        if (billingClient is not null)
        {
            creditDays = Math.Max(0, billingClient.dias_plazo);
            paymentForm = string.IsNullOrWhiteSpace(billingClient.condicion_pago)
                ? paymentForm
                : billingClient.condicion_pago!;
        }

        if (draftSale is null)
        {
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var sale = await dbContext.tbl_venta.FirstOrDefaultAsync(x => x.id_venta == draftSale.id_venta);
        if (sale is null)
        {
            await LoadCurrentDraftContextAsync(dbContext, selectedPatientId, selectedClientId);
            return;
        }

        sale.id_cliente_facturacion = clientId > 0 ? clientId : null;
        sale.dias_credito = creditDays;
        sale.forma_pago = paymentForm;
        await dbContext.SaveChangesAsync();
        draftSale.id_cliente_facturacion = sale.id_cliente_facturacion;
        draftSale.dias_credito = sale.dias_credito;
        draftSale.forma_pago = sale.forma_pago;
        await LoadCurrentDraftContextAsync(dbContext, selectedPatientId, selectedClientId);
    }

    private async Task SaveLineAsync()
    {
        statusMessage = null;
        errorMessage = null;

        if (!canEditModule)
        {
            return;
        }

        var requestedProductId = lineEditor.ProductId;
        var requestedQuantity = lineEditor.Quantity;
        var requestedUnitPrice = lineEditor.UnitPrice;
        var requestedDiscount = lineEditor.Discount;
        var requestedConcept = lineEditor.Concept?.Trim() ?? string.Empty;
        var requestedLineId = lineEditor.LineId;

        if (billingClient is null && selectedClientId <= 0 && selectedPatientId <= 0)
        {
            errorMessage = "Selecciona un cliente o un paciente antes de agregar lineas a la factura.";
            return;
        }

        if (requestedProductId <= 0 || requestedQuantity <= 0)
        {
            errorMessage = "Selecciona un producto valido y una cantidad mayor a cero.";
            return;
        }

        if (requestedUnitPrice < 0 || requestedDiscount < 0)
        {
            errorMessage = "Precio y descuento no pueden ser negativos.";
            return;
        }

        if (string.IsNullOrWhiteSpace(requestedConcept))
        {
            errorMessage = "Ingresa un concepto para la linea.";
            return;
        }

        if (requestedDiscount > requestedUnitPrice * requestedQuantity && requestedUnitPrice > 0)
        {
            errorMessage = "El descuento no puede ser mayor al valor bruto de la linea.";
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();

        if (selectedPatient is null && selectedPatientId > 0)
        {
            selectedPatient = await dbContext.tbl_pacientes.FirstOrDefaultAsync(x => x.id_paciente == selectedPatientId);
        }

        if ((billingClient is null || selectedClientId <= 0) && selectedPatient is not null)
        {
            selectedClientId = await BillingDraftService.EnsureBillingClientAsync(dbContext, selectedPatient, currentUserId);
            billingClient = await dbContext.clients.AsNoTracking().FirstOrDefaultAsync(x => x.cliente_id == selectedClientId);
        }

        if (selectedClientId <= 0 && billingClient?.cliente_id > 0)
        {
            selectedClientId = billingClient.cliente_id;
        }

        if (draftSale is null && selectedPatientId <= 0)
        {
            errorMessage = "Selecciona un paciente antes de iniciar un nuevo borrador de factura.";
            return;
        }

        tbl_venta ensuredDraft;
        try
        {
            ensuredDraft = await BillingDraftService.GetOrCreateDraftSaleAsync(
                dbContext,
                selectedPatientId > 0 ? selectedPatientId : null,
                selectedClientId > 0 ? selectedClientId : null,
                currentUserId);
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
            return;
        }

        draftSale = ensuredDraft;

        var sale = await dbContext.tbl_venta
            .Include(x => x.tbl_detalle_venta)
            .FirstOrDefaultAsync(x => x.id_venta == ensuredDraft.id_venta);
        var product = await dbContext.tbl_productos.FirstOrDefaultAsync(x => x.id_producto == requestedProductId && x.activo == true);
        if (sale is null || product is null)
        {
            errorMessage = "No se encontro el borrador o el producto seleccionado.";
            return;
        }

        var unitPrice = requestedUnitPrice > 0 ? requestedUnitPrice : product.precio_venta;
        var concept = string.IsNullOrWhiteSpace(requestedConcept) ? product.nombre_producto : requestedConcept;
        var lineTotal = Math.Max(0m, (unitPrice * requestedQuantity) - requestedDiscount);
        var isEditing = requestedLineId > 0;

        if (isEditing)
        {
            var existingLine = sale.tbl_detalle_venta.FirstOrDefault(x => x.id_detalle_venta == requestedLineId);
            if (existingLine is null)
            {
                errorMessage = "No se encontro la linea seleccionada para editar.";
                return;
            }

            existingLine.id_producto = product.id_producto;
            existingLine.cantidad = requestedQuantity;
            existingLine.precio_unitario = unitPrice;
            existingLine.descuento = requestedDiscount;
            existingLine.concepto_item = concept;
            existingLine.total_item = lineTotal;
        }
        else
        {
            var newLine = new tbl_detalle_venta
            {
                id_venta = sale.id_venta,
                id_producto = product.id_producto,
                cantidad = requestedQuantity,
                precio_unitario = unitPrice,
                descuento = requestedDiscount,
                concepto_item = concept,
                total_item = lineTotal
            };

            sale.tbl_detalle_venta.Add(newLine);
            dbContext.tbl_detalle_venta.Add(newLine);
        }

        sale.forma_pago = paymentForm;
        sale.dias_credito = creditDays;
        sale.observaciones_factura = NormalizeOptional(invoiceNotes);
        sale.valor_cobrado = paidAmount;

        await BillingDraftService.RecalculateSaleAsync(dbContext, sale);
        await dbContext.SaveChangesAsync();

        ResetLineEditor();
        statusMessage = isEditing ? "La linea fue actualizada correctamente." : "La linea fue agregada al borrador de factura.";
        await LoadAsync(selectedPatientId > 0 ? selectedPatientId : null);
    }

    private async Task RemoveLineAsync(int lineId)
    {
        if (!canEditModule || draftSale is null || lineId <= 0)
        {
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var sale = await dbContext.tbl_venta.Include(x => x.tbl_detalle_venta).FirstOrDefaultAsync(x => x.id_venta == draftSale.id_venta);
        var line = await dbContext.tbl_detalle_venta.FirstOrDefaultAsync(x => x.id_detalle_venta == lineId && x.id_venta == draftSale.id_venta);
        if (sale is null || line is null)
        {
            return;
        }

        dbContext.tbl_detalle_venta.Remove(line);
        await BillingDraftService.RecalculateSaleAsync(dbContext, sale);
        await dbContext.SaveChangesAsync();

        if (lineEditor.LineId == lineId)
        {
            ResetLineEditor();
        }

        statusMessage = "La linea fue retirada del borrador.";
        await LoadAsync(selectedPatientId);
    }

    private async Task FinalizeInvoiceAsync()
    {
        statusMessage = null;
        errorMessage = null;

        if (!canEditModule)
        {
            return;
        }

        if (billingClient is null)
        {
            errorMessage = "Selecciona un cliente para poder emitir la factura.";
            return;
        }

        if (draftSale is null)
        {
            errorMessage = "No existe un borrador de factura para emitir.";
            return;
        }

        if (string.IsNullOrWhiteSpace(paymentForm))
        {
            errorMessage = "Selecciona una forma de pago.";
            return;
        }

        if (creditDays < 0)
        {
            errorMessage = "Los dias de credito no pueden ser negativos.";
            return;
        }

        if (paidAmount < 0)
        {
            errorMessage = "El valor cobrado no puede ser negativo.";
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var sale = await dbContext.tbl_venta
            .Include(x => x.tbl_detalle_venta)
            .FirstOrDefaultAsync(x => x.id_venta == draftSale.id_venta);

        if (sale is null)
        {
            errorMessage = "No se encontro el borrador de factura.";
            return;
        }

        if (!sale.tbl_detalle_venta.Any())
        {
            errorMessage = "Agrega al menos una linea antes de emitir la factura.";
            return;
        }

        var client = await dbContext.clients.FirstOrDefaultAsync(x => x.cliente_id == billingClient.cliente_id);
        if (client is null)
        {
            errorMessage = "No se encontro el cliente de facturacion.";
            return;
        }

        sale.id_cliente_facturacion = client.cliente_id;
        sale.id_usuario = currentUserId;
        sale.forma_pago = paymentForm;
        sale.dias_credito = creditDays;
        sale.observaciones_factura = NormalizeOptional(invoiceNotes);
        sale.valor_cobrado = paidAmount;
        sale.fecha_venta = DateTime.Now;

        await BillingDraftService.RecalculateSaleAsync(dbContext, sale);

        var invoiceNumber = await BillingDraftService.GenerateNextInvoiceNumberAsync(dbContext);
        sale.estado = (sale.saldo_pendiente ?? 0) > 0 ? "Credito" : "Facturada";

        var comprobante = new tbl_comprobante
        {
            id_venta = sale.id_venta,
            tipo_comprobante = "Factura",
            numero_comprobante = invoiceNumber,
            secuencial = long.Parse(invoiceNumber),
            estado_comprobante = "Emitido",
            fecha_emision = DateTime.Now
        };
        dbContext.tbl_comprobantes.Add(comprobante);
        await dbContext.SaveChangesAsync();

        var currentBalance = sale.saldo_pendiente ?? 0m;
        var accountReceivable = await dbContext.tbl_cta_cobrar.FirstOrDefaultAsync(x => x.id_venta == sale.id_venta);
        if (currentBalance > 0)
        {
            var dueDate = DateOnly.FromDateTime(DateTime.Today.AddDays(Math.Max(0, creditDays)));
            if (accountReceivable is null)
            {
                dbContext.tbl_cta_cobrar.Add(new tbl_cta_cobrar
                {
                    id_cliente = client.cliente_id,
                    id_venta = sale.id_venta,
                    id_comprobante = comprobante.id_comprobante,
                    monto_total = sale.total ?? 0,
                    saldo = currentBalance,
                    fecha_emision = DateTime.Now,
                    fecha_vencimiento = dueDate,
                    estado = "Pendiente",
                    fecha_creacion = DateTime.Now,
                    usuario_creacion = GetCurrentActorLabel()
                });
            }
            else
            {
                accountReceivable.id_cliente = client.cliente_id;
                accountReceivable.id_comprobante = comprobante.id_comprobante;
                accountReceivable.monto_total = sale.total ?? 0;
                accountReceivable.saldo = currentBalance;
                accountReceivable.fecha_vencimiento = dueDate;
                accountReceivable.estado = "Pendiente";
                accountReceivable.usuario_creacion ??= GetCurrentActorLabel();
            }
        }
        else if (accountReceivable is not null)
        {
            accountReceivable.id_comprobante = comprobante.id_comprobante;
            accountReceivable.monto_total = sale.total ?? 0;
            accountReceivable.saldo = 0;
            accountReceivable.estado = "Pagada";
        }

        client.condicion_pago = currentBalance > 0 ? "Credito" : paymentForm;
        client.dias_plazo = currentBalance > 0 ? creditDays : 0;
        var otherOutstandingBalance = await dbContext.tbl_cta_cobrar
            .Where(x => x.id_cliente == client.cliente_id && x.estado == "Pendiente" && x.id_venta != sale.id_venta)
            .Select(x => x.saldo)
            .DefaultIfEmpty(0m)
            .SumAsync();
        client.saldo_deudor = otherOutstandingBalance + currentBalance;
        client.fecha_actualizacion = DateTime.Now;
        client.id_usuario_actualizacion = currentUserId;

        await dbContext.SaveChangesAsync();

        statusMessage = $"Factura {invoiceNumber} emitida correctamente.";
        await LoadAsync(selectedPatientId > 0 ? selectedPatientId : null);
    }

    private async Task<ModulePermissions> GetModulePermissionsAsync(OpticaDbContext dbContext, int roleId)
    {
        if (roleId <= 0)
        {
            return new ModulePermissions();
        }

        var permission = await dbContext.tbl_rol_menu_permisos
            .AsNoTracking()
            .Where(x => x.id_rol == roleId)
            .Join(
                dbContext.tbl_menu_apps.AsNoTracking().Where(x => x.ruta == "/invoices"),
                rolePermission => rolePermission.id_menu,
                menu => menu.id_menu,
                (rolePermission, _) => rolePermission)
            .FirstOrDefaultAsync();

        if (permission is null)
        {
            return new ModulePermissions();
        }

        return new ModulePermissions
        {
            CanView = permission.puede_ver,
            CanCreate = permission.puede_crear,
            CanEdit = permission.puede_editar,
            CanDelete = permission.puede_eliminar
        };
    }

