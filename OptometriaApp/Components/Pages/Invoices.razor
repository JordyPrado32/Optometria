    private async Task SaveQuickProductAsync()
    {
        statusMessage = null;
        errorMessage = null;

        if (!ValidateQuickProductEditor())
        {
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var normalizedCode = productUpsertEditor.CodigoProducto.Trim().ToLowerInvariant();
        var codeExists = await dbContext.tbl_productos
            .AnyAsync(x => x.id_producto != productUpsertEditor.IdProducto && x.codigo_producto.ToLower() == normalizedCode);

        if (codeExists)
        {
            errorMessage = "Ya existe un producto con el mismo codigo.";
            return;
        }

        var isEditing = productUpsertEditor.IdProducto > 0;
        tbl_producto? product;

        if (isEditing)
        {
            if (!permissions.CanEdit)
            {
                errorMessage = "Tu rol no tiene permiso para editar productos.";
                return;
            }

            product = await dbContext.tbl_productos.FirstOrDefaultAsync(x => x.id_producto == productUpsertEditor.IdProducto);
            if (product is null)
            {
                errorMessage = "No se encontro el producto seleccionado.";
                return;
            }
        }
        else
        {
            if (!permissions.CanCreate)
            {
                errorMessage = "Tu rol no tiene permiso para crear productos.";
                return;
            }

            product = new tbl_producto
            {
                fecha_creacion = DateTime.Now,
                usuario_creacion = GetCurrentActorLabel()
            };
            dbContext.tbl_productos.Add(product);
        }

        ApplyQuickProductEditorToEntity(product);
        product.id_usuario_actualizacion = currentUserId > 0 ? currentUserId : null;

        await dbContext.SaveChangesAsync();

        WriteAudit(
            dbContext,
            "Productos",
            isEditing ? "Editar producto" : "Crear producto",
            $"ProductoId={product.id_producto}; Codigo={product.codigo_producto}; Nombre={product.nombre_producto}; EstadoProducto={product.estado_producto ?? "Disponible"}");

        await dbContext.SaveChangesAsync();

        lineEditor.ProductId = product.id_producto;
        lineEditor.UnitPrice = product.precio_venta;
        lineEditor.Concept = product.nombre_producto;

        showProductUpsertForm = false;
        await LoadAsync(selectedPatientId > 0 ? selectedPatientId : null);
        lineEditor.ProductId = product.id_producto;
        ApplySelectedProductDefaults();
        statusMessage = $"Producto {product.codigo_producto} guardado correctamente.";
    }

    private bool ValidateQuickProductEditor()
    {
        if (!canEditModule)
        {
            return false;
        }

        productUpsertEditor.CodigoProducto = productUpsertEditor.CodigoProducto.Trim();
        productUpsertEditor.NombreProducto = productUpsertEditor.NombreProducto.Trim();
        productUpsertEditor.TipoItem = "Producto";

        if (string.IsNullOrWhiteSpace(productUpsertEditor.CodigoProducto) || string.IsNullOrWhiteSpace(productUpsertEditor.NombreProducto))
        {
            errorMessage = "Completa el codigo y el nombre del producto.";
            return false;
        }

        if (!productTypeOptions.Contains(productUpsertEditor.TipoItem, StringComparer.OrdinalIgnoreCase))
        {
            errorMessage = "Selecciona un tipo de item valido.";
            return false;
        }

        if (productUpsertEditor.IdCategoria <= 0)
        {
            errorMessage = "Selecciona una categoria para el producto.";
            return false;
        }

        if (productUpsertEditor.PrecioVenta < 0)
        {
            errorMessage = "Los precios no pueden ser negativos.";
            return false;
        }

        if (productUpsertEditor.PorcentajeIva < 0)
        {
            errorMessage = "El porcentaje de IVA no puede ser negativo.";
            return false;
        }

        return true;
    }

    private void ApplyQuickProductEditorToEntity(tbl_producto entity)
    {
        entity.codigo_producto = productUpsertEditor.CodigoProducto.Trim();
        entity.nombre_producto = productUpsertEditor.NombreProducto.Trim();
        entity.tipo_item = "Producto";
        entity.id_categoria = productUpsertEditor.IdCategoria;
        entity.precio_venta = productUpsertEditor.PrecioVenta;
        entity.tiene_iva = productUpsertEditor.TieneIva;
        entity.porcentaje_iva = productUpsertEditor.TieneIva ? productUpsertEditor.PorcentajeIva : 0;
        entity.naturaleza_item = "Bien";
        entity.stock_actual ??= 0;
        entity.stock_minimo ??= 0;
        entity.activo = true;
        entity.estado_producto ??= "Disponible";
    }

    private void ApplySelectedProductDefaults()
    {
        var product = SelectedManualProduct;
        if (product is null)
        {
            return;
        }

        lineEditor.UnitPrice = product.precio_venta;
        lineEditor.Concept = product.nombre_producto;
        lineEditor.TieneIva = product.tiene_iva ?? false;
        lineEditor.PorcentajeIva = lineEditor.TieneIva
            ? (ivaPercentageOptions.Contains(product.porcentaje_iva ?? 0m) ? product.porcentaje_iva ?? 0m : ivaPercentageOptions[0])
            : 0m;
    }

    private bool CanInvoiceProduct(tbl_producto product)
    {
        if (product.activo != true)
        {
            return false;
        }

        if (!IsStockManagedProduct(product))
        {
            return true;
        }

        return !string.Equals(product.estado_producto, "Agotado", StringComparison.OrdinalIgnoreCase)
            && (product.stock_actual ?? 0) > 0;
    }

    private static bool IsStockManagedProduct(tbl_producto product)
    {
        return !string.Equals(product.naturaleza_item, "Servicio", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetInvoiceProductOptionLabel(tbl_producto product)
    {
        if (!IsStockManagedProduct(product))
        {
            return $"{product.codigo_producto} - {product.nombre_producto}";
        }

        return $"{product.codigo_producto} - {product.nombre_producto} (stock {(product.stock_actual ?? 0)})";
    }

    private string GetOriginLabel(tbl_detalle_venta line)
    {
        return string.IsNullOrWhiteSpace(line.origen_tipo)
            ? "Manual"
            : $"{line.origen_tipo} #{line.origen_id}";
    }

    private string GetLineTaxLabel(tbl_detalle_venta line)
    {
        return GetProductTaxLabel(line.id_productoNavigation);
    }

    private string GetPatientLabel(tbl_paciente patient)
    {
        return $"{patient.apellidos} {patient.nombres} - {patient.cedula}".Trim();
    }

    private string GetPatientFullName(tbl_paciente patient)
    {
        return $"{patient.nombres} {patient.apellidos}".Trim();
    }

    private string GetClientLabel(ClientEntity client)
    {
        return $"{GetClientDisplayName(client)} - {client.numero_identificacion}".Trim();
    }

    private string GetClientPersonName(ClientEntity client)
    {
        return $"{client.nombres} {client.apellidos}".Trim();
    }

    private string GetClientDisplayName(ClientEntity? client)
    {
        if (client is null)
        {
            return "Pendiente";
        }

        return string.IsNullOrWhiteSpace(client.razon_social)
            ? GetClientPersonName(client)
            : client.razon_social;
    }

    private string GetClientIdentification(ClientEntity? client)
    {
        return string.IsNullOrWhiteSpace(client?.numero_identificacion)
            ? "Sin identificacion"
            : client.numero_identificacion;
    }

    private void SyncSearchTerms()
    {
        patientSearchTerm = selectedPatient is null ? string.Empty : GetPatientLabel(selectedPatient);
        clientSearchTerm = billingClient is null ? string.Empty : GetClientLabel(billingClient);
    }

    private bool MatchesPatientSearch(tbl_paciente patient)
    {
        var search = NormalizeSearch(patientSearchTerm);
        if (string.IsNullOrEmpty(search))
        {
            return true;
        }

        return ContainsSearch(patient.cedula, search)
            || ContainsSearch(patient.nombres, search)
            || ContainsSearch(patient.apellidos, search)
            || ContainsSearch(GetPatientFullName(patient), search);
    }

    private bool MatchesClientSearch(ClientEntity client)
    {
        var search = NormalizeSearch(clientSearchTerm);
        if (string.IsNullOrEmpty(search))
        {
            return true;
        }

        return ContainsSearch(client.numero_identificacion, search)
            || ContainsSearch(client.razon_social, search)
            || ContainsSearch(client.nombres, search)
            || ContainsSearch(client.apellidos, search)
            || ContainsSearch(client.nombre_comercial, search)
            || ContainsSearch(GetClientPersonName(client), search)
            || ContainsSearch($"{client.apellidos} {client.nombres}".Trim(), search);
    }

    private static bool ContainsSearch(string? value, string search)
        => !string.IsNullOrWhiteSpace(value) && value.Contains(search, StringComparison.OrdinalIgnoreCase);

    private static string NormalizeSearch(string? value) => value?.Trim() ?? string.Empty;

    private async Task<int?> ResolveAnchorPatientIdAsync(OpticaDbContext dbContext)
    {
        if (selectedPatientId > 0)
        {
            return selectedPatientId;
        }

        if (draftSale?.id_paciente > 0)
        {
            return draftSale.id_paciente;
        }

        return null;
    }

    private static string GetProductTaxLabel(tbl_producto product)
    {
        return (product.tiene_iva ?? false)
            ? $"Si, {((product.porcentaje_iva ?? 0m).ToString("0.##"))}%"
            : "No";
    }

    private string GetCurrentActorLabel()
    {
        return $"USER_{currentUserId}";
    }

    private static string? NormalizeOptional(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }

    private void WriteAudit(OpticaDbContext dbContext, string module, string action, string detail)
    {
        dbContext.tbl_log_auditoria.Add(new tbl_log_auditoria
        {
            id_usuario = currentUserId > 0 ? currentUserId : null,
            accion = action,
            modulo = module,
            fecha = DateTime.Now,
            detalle = detail
        });
    }

