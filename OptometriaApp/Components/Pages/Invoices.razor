    private async Task SaveLineAsync()
    {
        statusMessage = null;
        errorMessage = null;

        if (!canEditModule)
        {
            return;
        }

        var requestedProductId = lineEditor.ProductId;
        var requestedQuantity = lineEditor.Quantity;
        var requestedUnitPrice = lineEditor.UnitPrice;
        var requestedDiscount = lineEditor.Discount;
        var requestedConcept = lineEditor.Concept?.Trim() ?? string.Empty;
        var requestedLineId = lineEditor.LineId;

        if (billingClient is null && selectedClientId <= 0)
        {
            errorMessage = "Selecciona un cliente antes de agregar lineas a la factura.";
            return;
        }

        if (requestedProductId <= 0 || requestedQuantity <= 0)
        {
            errorMessage = "Selecciona un producto valido y una cantidad mayor a cero.";
            return;
        }

        if (requestedUnitPrice < 0 || requestedDiscount < 0)
        {
            errorMessage = "Precio y descuento no pueden ser negativos.";
            return;
        }

        if (lineEditor.PorcentajeIva < 0)
        {
            errorMessage = "El porcentaje de IVA no puede ser negativo.";
            return;
        }

        if (string.IsNullOrWhiteSpace(requestedConcept))
        {
            errorMessage = "Ingresa un concepto para la linea.";
            return;
        }

        if (requestedDiscount > requestedUnitPrice * requestedQuantity && requestedUnitPrice > 0)
        {
            errorMessage = "El descuento no puede ser mayor al valor bruto de la linea.";
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();

        if (selectedPatient is null && selectedPatientId > 0)
        {
            selectedPatient = await dbContext.tbl_pacientes.FirstOrDefaultAsync(x => x.id_paciente == selectedPatientId);
        }

        if (selectedClientId <= 0 && billingClient?.cliente_id > 0)
        {
            selectedClientId = billingClient.cliente_id;
        }

        if (draftSale is null && selectedClientId <= 0)
        {
            errorMessage = "Selecciona un cliente antes de iniciar un nuevo borrador de factura.";
            return;
        }

        tbl_venta ensuredDraft;
        try
        {
            var effectivePatientId = await ResolveAnchorPatientIdAsync(dbContext);
            ensuredDraft = await BillingDraftService.GetOrCreateDraftSaleAsync(
                dbContext,
                effectivePatientId,
                selectedClientId > 0 ? selectedClientId : null,
                currentUserId);
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
            return;
        }

        draftSale = ensuredDraft;

        var sale = await dbContext.tbl_venta
            .Include(x => x.tbl_detalle_venta)
            .FirstOrDefaultAsync(x => x.id_venta == ensuredDraft.id_venta);
        var product = await dbContext.tbl_productos.FirstOrDefaultAsync(x => x.id_producto == requestedProductId && x.activo == true);
        if (sale is null || product is null)
        {
            errorMessage = "No se encontro el borrador o el producto seleccionado.";
            return;
        }

        if (!CanInvoiceProduct(product))
        {
            errorMessage = "Ese producto no esta disponible para facturacion.";
            return;
        }

        if (IsStockManagedProduct(product))
        {
            var reservedInDraft = sale.tbl_detalle_venta
                .Where(x => x.id_producto == product.id_producto && x.id_detalle_venta != requestedLineId)
                .Sum(x => x.cantidad);
            var availableStock = product.stock_actual ?? 0;
            if (availableStock <= 0 || requestedQuantity + reservedInDraft > availableStock)
            {
                errorMessage = $"No hay stock suficiente para '{product.nombre_producto}'. Disponible: {Math.Max(0, availableStock - reservedInDraft)}.";
                return;
            }
        }

        product.tiene_iva = lineEditor.TieneIva;
        product.porcentaje_iva = lineEditor.TieneIva ? lineEditor.PorcentajeIva : 0m;

        var unitPrice = requestedUnitPrice > 0 ? requestedUnitPrice : product.precio_venta;
        var concept = string.IsNullOrWhiteSpace(requestedConcept) ? product.nombre_producto : requestedConcept;
        var lineTotal = Math.Max(0m, (unitPrice * requestedQuantity) - requestedDiscount);
        var isEditing = requestedLineId > 0;

        if (isEditing)
        {
            var existingLine = sale.tbl_detalle_venta.FirstOrDefault(x => x.id_detalle_venta == requestedLineId);
            if (existingLine is null)
            {
                errorMessage = "No se encontro la linea seleccionada para editar.";
                return;
            }

            existingLine.id_producto = product.id_producto;
            existingLine.cantidad = requestedQuantity;
            existingLine.precio_unitario = unitPrice;
            existingLine.descuento = requestedDiscount;
            existingLine.concepto_item = concept;
            existingLine.total_item = lineTotal;
        }
        else
        {
            var newLine = new tbl_detalle_venta
            {
                id_venta = sale.id_venta,
                id_producto = product.id_producto,
                cantidad = requestedQuantity,
                precio_unitario = unitPrice,
                descuento = requestedDiscount,
                concepto_item = concept,
                total_item = lineTotal
            };

            sale.tbl_detalle_venta.Add(newLine);
            dbContext.tbl_detalle_venta.Add(newLine);
        }

        sale.forma_pago = paymentForm;
        sale.dias_credito = creditDays;
        sale.observaciones_factura = NormalizeOptional(invoiceNotes);
        sale.valor_cobrado = paidAmount;

        await BillingDraftService.RecalculateSaleAsync(dbContext, sale);
        await dbContext.SaveChangesAsync();

        ResetLineEditor();
        statusMessage = isEditing ? "La linea fue actualizada correctamente." : "La linea fue agregada al borrador de factura.";
        await LoadAsync(selectedPatientId > 0 ? selectedPatientId : null);
    }

    private async Task RemoveLineAsync(int lineId)
    {
        if (!canEditModule || draftSale is null || lineId <= 0)
        {
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var sale = await dbContext.tbl_venta.Include(x => x.tbl_detalle_venta).FirstOrDefaultAsync(x => x.id_venta == draftSale.id_venta);
        var line = await dbContext.tbl_detalle_venta.FirstOrDefaultAsync(x => x.id_detalle_venta == lineId && x.id_venta == draftSale.id_venta);
        if (sale is null || line is null)
        {
            return;
        }

        dbContext.tbl_detalle_venta.Remove(line);
        await BillingDraftService.RecalculateSaleAsync(dbContext, sale);
        await dbContext.SaveChangesAsync();

        if (lineEditor.LineId == lineId)
        {
            ResetLineEditor();
        }

        statusMessage = "La linea fue retirada del borrador.";
        await LoadAsync(selectedPatientId);
    }

    private async Task FinalizeInvoiceAsync()
    {
        statusMessage = null;
        errorMessage = null;

        if (!canEditModule)
        {
            return;
        }

        if (billingClient is null)
        {
            errorMessage = "Selecciona un cliente para poder emitir la factura.";
            return;
        }

        if (draftSale is null)
        {
            errorMessage = "No existe un borrador de factura para emitir.";
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var issuer = await dbContext.emisor.FirstOrDefaultAsync(x => x.id_usuario_creacion == currentUserId && x.estado);
        if (issuer is null)
        {
            errorMessage = "Configura un emisor activo antes de emitir la factura.";
            return;
        }

        var lastSequence = await BillingDraftService.GetLastInvoiceSequenceAsync(dbContext, issuer);
        var requiresInitialSequence = !lastSequence.HasValue;
        long resolvedInitialSequence = 0;
        if (requiresInitialSequence && !TryResolveInitialSequence(issuer, out resolvedInitialSequence, out var initialSequenceError))
        {
            errorMessage = initialSequenceError;
            return;
        }

        if (string.IsNullOrWhiteSpace(paymentForm))
        {
            errorMessage = "Selecciona una forma de pago.";
            return;
        }

        if (creditDays < 0)
        {
            errorMessage = "Los dias de credito no pueden ser negativos.";
            return;
        }

        if (paidAmount < 0)
        {
            errorMessage = "El valor cobrado no puede ser negativo.";
            return;
        }
        var sale = await dbContext.tbl_venta
            .Include(x => x.tbl_detalle_venta)
            .FirstOrDefaultAsync(x => x.id_venta == draftSale.id_venta);

        if (sale is null)
        {
            errorMessage = "No se encontro el borrador de factura.";
            return;
        }

        if (!sale.tbl_detalle_venta.Any())
        {
            errorMessage = "Agrega al menos una linea antes de emitir la factura.";
            return;
        }

        var linesByProduct = sale.tbl_detalle_venta
            .GroupBy(x => x.id_producto)
            .Select(x => new { ProductId = x.Key, Quantity = x.Sum(line => line.cantidad) })
            .ToList();
        var involvedProductIds = linesByProduct.Select(x => x.ProductId).Distinct().ToList();
        var invoiceProducts = await dbContext.tbl_productos
            .Where(x => involvedProductIds.Contains(x.id_producto))
            .ToDictionaryAsync(x => x.id_producto);

        foreach (var groupedLine in linesByProduct)
        {
            if (!invoiceProducts.TryGetValue(groupedLine.ProductId, out var invoiceProduct))
            {
                errorMessage = "Una de las lineas referencia un producto inexistente.";
                return;
            }

            if (!CanInvoiceProduct(invoiceProduct))
            {
                errorMessage = $"El producto '{invoiceProduct.nombre_producto}' ya no esta disponible para facturacion.";
                return;
            }

            if (IsStockManagedProduct(invoiceProduct) && groupedLine.Quantity > (invoiceProduct.stock_actual ?? 0))
            {
                errorMessage = $"No hay stock suficiente para '{invoiceProduct.nombre_producto}'. Disponible: {invoiceProduct.stock_actual ?? 0}.";
                return;
            }
        }

        var client = await dbContext.clients.FirstOrDefaultAsync(x => x.cliente_id == billingClient.cliente_id);
        if (client is null)
        {
            errorMessage = "No se encontro el cliente de facturacion.";
            return;
        }

        sale.id_cliente_facturacion = client.cliente_id;
        sale.id_usuario = currentUserId;
        sale.id_paciente = sale.id_paciente > 0
            ? sale.id_paciente
            : await ResolveAnchorPatientIdAsync(dbContext) ?? sale.id_paciente;
        sale.forma_pago = paymentForm;
        sale.dias_credito = creditDays;
        sale.observaciones_factura = NormalizeOptional(invoiceNotes);
        sale.valor_cobrado = paidAmount;
        sale.fecha_venta = DateTime.Now;

        await BillingDraftService.RecalculateSaleAsync(dbContext, sale);

        var invoiceSequence = requiresInitialSequence
            ? resolvedInitialSequence
            : await BillingDraftService.GenerateNextInvoiceSequenceAsync(dbContext, issuer);
        var invoiceNumber = BillingDraftService.BuildInvoiceNumber(issuer, invoiceSequence);
        sale.estado = "Pendiente";

        var comprobante = new tbl_comprobante
        {
            id_venta = sale.id_venta,
            tipo_comprobante = "Factura",
            numero_comprobante = invoiceNumber,
            secuencial = invoiceSequence,
            estado_comprobante = "PendienteSRI",
            id_emisor = issuer.emisor_id,
            numero_autorizacion = null,
            fecha_autorizacion = null,
            fecha_emision = DateTime.Now
        };
        dbContext.tbl_comprobantes.Add(comprobante);
        await dbContext.SaveChangesAsync();

        var inventoryProductIds = new List<int>();
        foreach (var groupedLine in linesByProduct)
        {
            if (!invoiceProducts.TryGetValue(groupedLine.ProductId, out var invoiceProduct) || !IsStockManagedProduct(invoiceProduct))
            {
                continue;
            }

            var previousStock = invoiceProduct.stock_actual ?? 0;
            var newStock = previousStock - groupedLine.Quantity;
            if (newStock < 0)
            {
                errorMessage = $"No hay stock suficiente para '{invoiceProduct.nombre_producto}'.";
                return;
            }

            invoiceProduct.stock_actual = newStock;
            invoiceProduct.estado_producto = newStock == 0
                ? "Agotado"
                : (string.Equals(invoiceProduct.estado_producto, "Agotado", StringComparison.OrdinalIgnoreCase) ? "Disponible" : invoiceProduct.estado_producto);
            inventoryProductIds.Add(invoiceProduct.id_producto);

            dbContext.tbl_movimiento_inventarios.Add(new tbl_movimiento_inventario
            {
                id_producto = invoiceProduct.id_producto,
                id_usuario = currentUserId,
                fecha_movimiento = DateTime.Now,
                tipo_movimiento = "Salida",
                cantidad = groupedLine.Quantity,
                stock_anterior = previousStock,
                stock_resultante = newStock,
                comprobante_numero = comprobante.numero_comprobante,
                id_referencia_documento = comprobante.id_comprobante,
                tipo_documento_referencia = "Factura",
                observaciones = $"Salida automatica por factura {comprobante.numero_comprobante}",
                metodo_valuacion = "Promedio"
            });
        }

        var currentBalance = sale.saldo_pendiente ?? 0m;
        var accountReceivable = await dbContext.tbl_cta_cobrar.FirstOrDefaultAsync(x => x.id_venta == sale.id_venta);
        if (currentBalance > 0)
        {
            var dueDate = DateOnly.FromDateTime(DateTime.Today.AddDays(Math.Max(0, creditDays)));
            if (accountReceivable is null)
            {
                dbContext.tbl_cta_cobrar.Add(new tbl_cta_cobrar
                {
                    id_cliente = client.cliente_id,
                    id_venta = sale.id_venta,
                    id_comprobante = comprobante.id_comprobante,
                    monto_total = sale.total ?? 0,
                    saldo = currentBalance,
                    fecha_emision = DateTime.Now,
                    fecha_vencimiento = dueDate,
                    estado = "Pendiente",
                    fecha_creacion = DateTime.Now,
                    usuario_creacion = GetCurrentActorLabel()
                });
            }
            else
            {
                accountReceivable.id_cliente = client.cliente_id;
                accountReceivable.id_comprobante = comprobante.id_comprobante;
                accountReceivable.monto_total = sale.total ?? 0;
                accountReceivable.saldo = currentBalance;
                accountReceivable.fecha_vencimiento = dueDate;
                accountReceivable.estado = "Pendiente";
                accountReceivable.usuario_creacion ??= GetCurrentActorLabel();
            }
        }
        else if (accountReceivable is not null)
        {
            accountReceivable.id_comprobante = comprobante.id_comprobante;
            accountReceivable.monto_total = sale.total ?? 0;
            accountReceivable.saldo = 0;
            accountReceivable.estado = "Pagada";
        }

        client.condicion_pago = currentBalance > 0 ? "Credito" : paymentForm;
        client.dias_plazo = currentBalance > 0 ? creditDays : 0;
        var otherOutstandingBalance = await dbContext.tbl_cta_cobrar
            .Where(x => x.id_cliente == client.cliente_id && x.estado == "Pendiente" && x.id_venta != sale.id_venta)
            .SumAsync(x => x.saldo);
        client.saldo_deudor = otherOutstandingBalance + currentBalance;
        client.fecha_actualizacion = DateTime.Now;
        client.id_usuario_actualizacion = currentUserId;

        await dbContext.SaveChangesAsync();
        if (inventoryProductIds.Count > 0)
        {
            await KardexService.RebuildForProductsAsync(inventoryProductIds, currentUserId, $"Salida por factura {invoiceNumber}");
        }

        var successMessage = currentBalance > 0
            ? $"Factura {invoiceNumber} emitida correctamente, vinculada al emisor y enviada a cuentas por cobrar. Quedo pendiente para autorizacion SRI."
            : $"Factura {invoiceNumber} emitida correctamente, vinculada al emisor y pendiente para autorizacion SRI.";

        await LoadAsync(selectedPatientId > 0 ? selectedPatientId : null);
        statusMessage = successMessage;
    }

    private string GetInitialSequencePreview()
    {
        if (currentIssuer is null)
        {
            return "Configura emisor";
        }

        return TryResolveInitialSequence(currentIssuer, out var sequence, out _)
            ? BillingDraftService.BuildInvoiceNumber(currentIssuer, sequence)
            : $"{BillingDraftService.GetInvoicePrefix(currentIssuer)}-000000001";
    }

    private bool TryResolveInitialSequence(EmisorEntity issuer, out long sequence, out string? validationError)
    {
        sequence = 0;
        validationError = null;

        var rawValue = initialInvoiceSequenceInput?.Trim();
        if (string.IsNullOrWhiteSpace(rawValue))
        {
            validationError = "Indica la factura inicial o el secuencial con el que vas a empezar a emitir.";
            return false;
        }

        var prefix = BillingDraftService.GetInvoicePrefix(issuer);
        if (rawValue.Contains('-'))
        {
            var parts = rawValue.Split('-', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            if (parts.Length != 3)
            {
                validationError = "La factura inicial debe tener el formato 001-001-000000123 o solo el secuencial.";
                return false;
            }

            var requestedPrefix = $"{parts[0]}-{parts[1]}";
            if (!string.Equals(requestedPrefix, prefix, StringComparison.Ordinal))
            {
                validationError = $"La factura inicial debe usar la base {prefix} del emisor activo.";
                return false;
            }

            rawValue = parts[2];
        }

        var digits = new string(rawValue.Where(char.IsDigit).ToArray());
        if (!long.TryParse(digits, out sequence) || sequence <= 0)
        {
            validationError = "Ingresa un secuencial valido mayor a cero para la primera factura.";
            return false;
        }

        return true;
    }

    private async Task<ModulePermissions> GetModulePermissionsAsync(OpticaDbContext dbContext, int roleId)
    {
        if (roleId <= 0)
        {
            return new ModulePermissions();
        }

        var permission = await dbContext.tbl_rol_menu_permisos
            .AsNoTracking()
            .Where(x => x.id_rol == roleId)
            .Join(
                dbContext.tbl_menu_apps.AsNoTracking().Where(x => x.ruta == "/facturas"),
                rolePermission => rolePermission.id_menu,
                menu => menu.id_menu,
                (rolePermission, _) => rolePermission)
            .FirstOrDefaultAsync();

        if (permission is null)
        {
            return new ModulePermissions();
        }

        return new ModulePermissions
        {
            CanView = permission.puede_ver,
            CanCreate = permission.puede_crear,
            CanEdit = permission.puede_editar,
            CanDelete = permission.puede_eliminar
        };
    }

