@page "/facturas"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using OptometriaApp.Data
@using OptometriaApp.Models
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BillingDraftService BillingDraftService
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject KardexService KardexService

<PageTitle>Facturas</PageTitle>

<style>
    .invoice-workspace {
        padding: 0;
        overflow: hidden;
        background:
            radial-gradient(circle at top right, rgba(254, 188, 100, 0.12), transparent 32%),
            linear-gradient(180deg, rgba(255, 252, 248, 0.96), rgba(255, 255, 255, 0.98));
    }

    .invoice-sheet-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1.5rem;
        padding: 1.75rem;
        background: linear-gradient(135deg, rgba(93, 161, 129, 0.09), rgba(236, 204, 197, 0.18));
        border-bottom: 1px solid rgba(127, 105, 81, 0.14);
    }

    .invoice-sheet-body {
        padding: clamp(1rem, 2vw, 1.75rem);
    }

    .invoice-toolbar-grid,
    .invoice-party-grid,
    .invoice-editor-grid,
    .invoice-upsert-grid {
        display: grid;
        gap: 1rem;
    }

    .invoice-toolbar-grid,
    .invoice-editor-grid,
    .invoice-upsert-grid {
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }

    .invoice-party-grid {
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }

    .invoice-section {
        border: 1px solid rgba(127, 105, 81, 0.14);
        border-radius: 1.1rem;
        padding: 1.1rem;
        background: rgba(255, 255, 255, 0.8);
        box-shadow: 0 10px 28px rgba(127, 105, 81, 0.06);
        min-width: 0;
    }

    .invoice-block-title {
        font-size: 0.76rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-taupe);
        margin-bottom: 0.9rem;
        font-weight: 700;
    }

    .invoice-search-results {
        display: grid;
        gap: 0.5rem;
        max-height: 15rem;
        overflow: auto;
    }

    .invoice-search-option {
        border: 1px solid rgba(127, 105, 81, 0.14);
        border-radius: 0.9rem;
        background: rgba(255, 255, 255, 0.92);
        padding: 0.7rem 0.8rem;
        text-align: left;
        transition: 0.18s ease;
    }

    .invoice-search-option strong,
    .invoice-search-option span {
        display: block;
    }

    .invoice-search-option strong {
        color: var(--color-ink);
        font-size: 0.92rem;
    }

    .invoice-search-option span {
        color: var(--color-taupe);
        font-size: 0.78rem;
        margin-top: 0.15rem;
    }

    .invoice-search-option.active {
        border-color: rgba(93, 161, 129, 0.45);
        background: rgba(93, 161, 129, 0.1);
        box-shadow: inset 0 0 0 1px rgba(93, 161, 129, 0.18);
    }

    .invoice-summary-table td {
        padding: 0.5rem 0;
        border: none;
    }

    .invoice-summary-table td:last-child {
        text-align: right;
        font-weight: 700;
        color: var(--color-ink);
    }

    .invoice-lines-table th,
    .invoice-lines-table td {
        vertical-align: middle;
        padding-top: 0.8rem;
        padding-bottom: 0.8rem;
    }

    .invoice-lines-table thead th {
        position: sticky;
        top: 0;
        z-index: 1;
        background: #fffaf4;
        color: var(--color-ink);
        font-size: 0.78rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        border-bottom: 1px solid rgba(127, 105, 81, 0.16);
    }

    .invoice-line-editor,
    .invoice-product-upsert {
        margin-top: 1.25rem;
        padding-top: 1.25rem;
        border-top: 1px dashed rgba(127, 105, 81, 0.18);
    }

    .invoice-kpi {
        text-align: right;
    }

    .invoice-kpi strong {
        display: block;
        font-size: 2rem;
        color: var(--color-ink);
    }

    .invoice-top-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(300px, 0.8fr);
        gap: 1.25rem;
        align-items: start;
    }

    .invoice-main-stack {
        display: grid;
        gap: 1.25rem;
        min-width: 0;
    }

    .invoice-sidebar {
        display: grid;
        gap: 1rem;
        position: sticky;
        top: 1rem;
        align-self: start;
        min-width: 0;
    }

    .invoice-document-card {
        border: 1px solid rgba(127, 105, 81, 0.16);
        border-radius: 1.4rem;
        padding: 1.25rem;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(244, 240, 228, 0.5));
        box-shadow: 0 14px 34px rgba(127, 105, 81, 0.07);
        min-width: 0;
    }

    .invoice-document-head {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: flex-start;
        flex-wrap: wrap;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(127, 105, 81, 0.12);
    }

    .invoice-document-main,
    .invoice-document-status {
        min-width: 0;
    }

    .invoice-document-main {
        display: flex;
        gap: 1rem;
        align-items: flex-start;
        flex: 1 1 420px;
    }

    .invoice-document-status {
        flex: 0 1 240px;
        text-align: right;
    }

    .invoice-brand-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 56px;
        min-height: 56px;
        border-radius: 1rem;
        background: linear-gradient(135deg, rgba(93, 161, 129, 0.18), rgba(244, 240, 228, 0.95));
        color: var(--color-ink);
        font-weight: 800;
        letter-spacing: 0.08em;
        border: 1px solid rgba(93, 161, 129, 0.16);
    }

    .invoice-doc-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.3rem 0.7rem;
        border-radius: 999px;
        background: rgba(93, 161, 129, 0.12);
        color: var(--color-sage);
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .invoice-doc-number {
        margin: 0.55rem 0 0;
        font-size: 1.95rem;
        line-height: 1.05;
        color: var(--color-ink);
        overflow-wrap: anywhere;
    }

    .invoice-doc-meta {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem 1rem;
        margin-top: 1rem;
    }

    .invoice-meta-card {
        padding: 0.85rem 0.95rem;
        border-radius: 0.95rem;
        background: rgba(255, 255, 255, 0.74);
        border: 1px solid rgba(127, 105, 81, 0.1);
        min-width: 0;
    }

    .invoice-meta-card label {
        display: block;
        margin-bottom: 0.25rem;
        font-size: 0.74rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-taupe);
    }

    .invoice-meta-card strong,
    .invoice-meta-card span {
        color: var(--color-ink);
        display: block;
        overflow-wrap: anywhere;
    }

    .invoice-pill-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        margin-top: 1rem;
    }

    .invoice-pill {
        display: inline-flex;
        align-items: center;
        padding: 0.45rem 0.8rem;
        border-radius: 999px;
        background: rgba(244, 240, 228, 0.92);
        color: var(--color-taupe-deep);
        border: 1px solid rgba(127, 105, 81, 0.08);
        font-size: 0.82rem;
    }

    .invoice-form-card .management-card-header,
    .invoice-lines-card .management-card-header {
        margin-bottom: 1rem;
    }

    .invoice-grid-2 {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }

    .invoice-readonly-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 0.85rem;
    }

    .invoice-party-stack {
        display: grid;
        gap: 1rem;
    }

    .invoice-party-card-title {
        margin-bottom: 0.65rem;
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--color-ink);
    }

    .invoice-readonly-item {
        padding: 0.9rem 0.95rem;
        border-radius: 0.95rem;
        background: rgba(255, 255, 255, 0.7);
        border: 1px solid rgba(127, 105, 81, 0.1);
        min-width: 0;
    }

    .invoice-readonly-item label {
        display: block;
        margin-bottom: 0.25rem;
        font-size: 0.74rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-taupe);
    }

    .invoice-readonly-item strong,
    .invoice-readonly-item span {
        color: var(--color-ink);
        display: block;
        overflow-wrap: anywhere;
    }

    .invoice-section-caption {
        margin: -0.25rem 0 1rem;
        color: var(--color-taupe);
    }

    .invoice-lines-card .table-responsive {
        border: 1px solid rgba(127, 105, 81, 0.12);
        border-radius: 1rem;
        background: rgba(255, 255, 255, 0.94);
    }

    .invoice-lines-table {
        min-width: 920px;
    }

    .invoice-lines-table td,
    .invoice-lines-table th {
        white-space: nowrap;
    }

    .invoice-lines-table td:nth-child(2),
    .invoice-lines-table td:nth-child(3) {
        white-space: normal;
        overflow-wrap: anywhere;
    }

    .invoice-line-total {
        font-weight: 700;
        color: var(--color-ink);
    }

    .invoice-actions-primary {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.1rem;
    }

    .invoice-actions-primary .btn-primary {
        min-width: 180px;
    }

    .invoice-sidebar-card {
        border: 1px solid rgba(127, 105, 81, 0.14);
        border-radius: 1.2rem;
        padding: 1.1rem;
        background: rgba(255, 255, 255, 0.84);
        box-shadow: 0 10px 26px rgba(127, 105, 81, 0.06);
        min-width: 0;
    }

    .invoice-sidebar-total {
        padding: 1rem;
        border-radius: 1rem;
        background: linear-gradient(180deg, rgba(244, 240, 228, 0.96), rgba(255, 255, 255, 0.98));
        color: var(--color-ink);
        border-color: rgba(93, 161, 129, 0.18);
    }

    .invoice-sidebar-total .invoice-block-title,
    .invoice-sidebar-total .invoice-summary-table td {
        color: var(--color-taupe);
    }

    .invoice-sidebar-total .invoice-summary-table td:last-child {
        color: var(--color-ink);
    }

    .invoice-sidebar-total strong {
        display: block;
        font-size: 2rem;
        line-height: 1;
        margin: 0.45rem 0 0.3rem;
        color: var(--color-sage);
    }

    .invoice-sidebar-actions {
        display: grid;
        gap: 0.7rem;
        margin-top: 1rem;
    }

    .invoice-sidebar-hint {
        margin-top: 0.85rem;
        font-size: 0.84rem;
        color: var(--color-taupe);
    }

    .invoice-sidebar-links {
        display: grid;
        gap: 0.6rem;
    }

    .invoice-preview-sheet {
        border: 1px solid rgba(127, 105, 81, 0.12);
        border-radius: 1rem;
        padding: 1rem;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(244, 240, 228, 0.56));
        min-width: 0;
    }

    .invoice-preview-header {
        display: flex;
        justify-content: space-between;
        gap: 0.8rem;
        align-items: flex-start;
        padding-bottom: 0.85rem;
        border-bottom: 1px dashed rgba(127, 105, 81, 0.18);
        margin-bottom: 0.85rem;
    }

    .invoice-preview-mini-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.65rem;
        margin-bottom: 0.85rem;
    }

    .invoice-preview-mini-grid div {
        font-size: 0.86rem;
    }

    .invoice-preview-notes {
        margin-top: 0.85rem;
        padding-top: 0.85rem;
        border-top: 1px dashed rgba(127, 105, 81, 0.18);
        color: var(--color-taupe);
        white-space: pre-wrap;
    }

    .invoice-empty {
        padding: 1rem;
        border-radius: 0.95rem;
        background: rgba(244, 240, 228, 0.7);
        color: var(--color-taupe);
        text-align: center;
        border: 1px dashed rgba(127, 105, 81, 0.14);
    }

    .invoice-editor-grid--line {
        grid-template-columns: minmax(220px, 1.45fr) repeat(3, minmax(120px, 0.7fr));
        align-items: end;
    }

    .invoice-editor-wide {
        grid-column: span 2;
    }

    .invoice-editor-full {
        grid-column: 1 / -1;
    }

    .invoice-editor-total {
        padding: 0.85rem 1rem;
        border-radius: 1rem;
        background: linear-gradient(180deg, rgba(93, 161, 129, 0.08), rgba(93, 161, 129, 0.14));
        border: 1px solid rgba(93, 161, 129, 0.18);
    }

    .invoice-editor-total label {
        display: block;
        margin-bottom: 0.25rem;
        font-size: 0.74rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-taupe);
    }

    .invoice-editor-total strong {
        display: block;
        font-size: 1.3rem;
        color: var(--color-ink);
    }

    .invoice-actions-primary {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
    }

    @@media (max-width: 1100px) {
        .invoice-top-grid {
            grid-template-columns: 1fr;
        }

        .invoice-sidebar {
            position: static;
        }

        .invoice-editor-grid--line {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .invoice-editor-wide,
        .invoice-editor-full {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 768px) {
        .invoice-sheet-header {
            flex-direction: column;
        }

        .invoice-kpi {
            text-align: left;
        }

        .invoice-document-main,
        .invoice-document-status,
        .invoice-preview-header {
            text-align: left;
        }

        .invoice-doc-meta,
        .invoice-grid-2,
        .invoice-preview-mini-grid,
        .invoice-editor-grid--line {
            grid-template-columns: 1fr;
        }
    }
</style>

@if (isLoading)
{
    <section class="management-shell">
        <div class="management-card">
            <h1>Cargando facturas...</h1>
        </div>
    </section>
}
else if (!canViewModule)
{
    <section class="management-shell">
        <div class="management-card">
            <span class="eyebrow">Restringido</span>
            <h1>Facturas</h1>
            <p>Tu rol no tiene permiso para entrar a este modulo.</p>
        </div>
    </section>
}
else
{
    <section class="management-shell">
        <div class="management-hero">
            <div>
                <span class="eyebrow">Facturacion</span>
                <h1>Factura tradicional</h1>
                <p>Prepara una factura clasica con cabecera, cliente, tabla de items, totales y upserts inline sin salir del flujo.</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-success" role="alert">@statusMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        @if (currentIssuer is not null && issuerRequiresInitialSequence)
        {
            <div class="alert alert-warning" role="alert">
                <strong>Primera emision detectada.</strong> Este emisor aun no tiene facturas registradas. Indica desde que factura deseas empezar a emitir para ajustar la secuencia.
                <div class="invoice-toolbar-grid" style="margin-top: 1rem;">
                    <div>
                        <label class="form-label">Factura inicial o secuencial</label>
                        <input class="form-control"
                               @bind="initialInvoiceSequenceInput"
                               @bind:event="oninput"
                               placeholder="@($"{BillingDraftService.GetInvoicePrefix(currentIssuer)}-000000001 o 1")"
                               readonly="@(!canEditModule)" />
                    </div>
                    <div>
                        <label class="form-label">Vista previa inicial</label>
                        <input class="form-control" value="@InitialSequencePreview" readonly />
                    </div>
                </div>
            </div>
        }

        <section class="management-card invoice-workspace">
            <div class="invoice-sheet-header">
                <div>
                    <span class="eyebrow">Emision comercial</span>
                    <h2 style="margin: 0.35rem 0 0.45rem;">Factura #@DisplayInvoiceNumber</h2>
                    <p style="margin: 0; color: var(--color-taupe);">Documento de trabajo con estructura fiscal, detalle comercial y vista previa en vivo.</p>
                </div>

                <div class="invoice-kpi">
                    <span class="eyebrow">Total a emitir</span>
                    <strong>@totalPreview.ToString("0.00")</strong>
                    <span style="color: var(--color-taupe);">Saldo pendiente: @balancePreview.ToString("0.00")</span>
                </div>
            </div>

            <div class="invoice-sheet-body">
                <div class="invoice-top-grid">
                    <div class="invoice-main-stack">
                        <section class="invoice-document-card">
                            <div class="invoice-document-head">
                                <div class="invoice-document-main">
                                    <div class="invoice-brand-mark">
                                        @((currentIssuer?.nombre_comercial ?? currentIssuer?.razon_social ?? "FC").Trim().Substring(0, Math.Min(2, (currentIssuer?.nombre_comercial ?? currentIssuer?.razon_social ?? "FC").Trim().Length)).ToUpperInvariant())
                                    </div>
                                    <div>
                                        <span class="invoice-doc-badge">Factura en emision</span>
                                        <h3 class="invoice-doc-number">@DisplayInvoiceNumber</h3>
                                        <div style="color: var(--color-taupe); margin-top: 0.35rem;">
                                            @(currentIssuer?.razon_social ?? currentIssuer?.nombre_comercial ?? "Emisor sin configurar")
                                        </div>
                                    </div>
                                </div>

                                <div class="invoice-document-status">
                                    <div class="invoice-block-title" style="margin-bottom:0.3rem;">Estado del documento</div>
                                    <strong style="display:block; font-size:1.1rem; color:var(--color-ink);">@(draftSale is null ? "Sin borrador" : "Borrador activo")</strong>
                                    <span style="color: var(--color-taupe);">Fecha de trabajo: @InvoiceDateLabel</span>
                                </div>
                            </div>

                            <div class="invoice-doc-meta">
                                <div class="invoice-meta-card">
                                    <label>Emisor</label>
                                    <strong>@(currentIssuer?.nombre_comercial ?? currentIssuer?.razon_social ?? "Pendiente")</strong>
                                    <span>@(currentIssuer?.ruc ?? "Sin RUC")</span>
                                </div>
                                <div class="invoice-meta-card">
                                    <label>Contacto emisor</label>
                                    <strong>@(currentIssuer?.telefono ?? "Sin telefono")</strong>
                                    <span>@(currentIssuer?.correo ?? "Sin correo")</span>
                                </div>
                            </div>

                            <div class="invoice-pill-row">
                                <span class="invoice-pill">@draftLines.Count lineas</span>
                                <span class="invoice-pill">IVA promedio @taxRate.ToString("0.##")%</span>
                                <span class="invoice-pill">Total @totalPreview.ToString("0.00")</span>
                                <span class="invoice-pill">Saldo @balancePreview.ToString("0.00")</span>
                            </div>
                        </section>

                        <section class="invoice-section invoice-form-card">
                            <div class="management-card-header">
                                <h2>Estructura del documento</h2>
                                <span>Cliente, pago y datos base</span>
                            </div>
                            <p class="invoice-section-caption">La información principal queda agrupada en bloques claros para emitir más rápido y con menos ruido visual.</p>

                            <div class="invoice-grid-2">
                                <section class="invoice-section">
                                    <div class="invoice-block-title">Cliente y paciente</div>
                                    <div class="invoice-toolbar-grid">
                                        <div>
                                            <label class="form-label" for="invoicePatientSearch">Paciente</label>
                                            <input id="invoicePatientSearch" class="form-control" @bind="patientSearchTerm" @bind:event="oninput" placeholder="Escribe nombre o cedula" disabled="@(!canEditModule)" />
                                            <div class="invoice-search-results" style="margin-top: 0.5rem;">
                                                <button type="button" class="invoice-search-option @(selectedPatientId == 0 ? "active" : null)" @onclick="ClearPatientSelection" disabled="@(!canEditModule)">Sin paciente fijo</button>
                                                @foreach (var patient in FilteredPatients)
                                                {
                                                    <button type="button" class="invoice-search-option @(selectedPatientId == patient.id_paciente ? "active" : null)" @onclick="() => SelectPatientAsync(patient.id_paciente)" disabled="@(!canEditModule)">
                                                        <strong>@GetPatientFullName(patient)</strong>
                                                        <span>@patient.cedula</span>
                                                    </button>
                                                }
                                            </div>
                                        </div>

                                        <div>
                                            <label class="form-label" for="invoiceClientSearch">Cliente</label>
                                            <input id="invoiceClientSearch" class="form-control" @bind="clientSearchTerm" @bind:event="oninput" placeholder="Escribe nombre o identificacion" disabled="@(!canEditModule)" />
                                            <div class="invoice-search-results" style="margin-top: 0.5rem;">
                                                <button type="button" class="invoice-search-option @(selectedClientId == 0 ? "active" : null)" @onclick="ClearClientSelection" disabled="@(!canEditModule)">Sin cliente fijo</button>
                                                @foreach (var client in FilteredClients)
                                                {
                                                    <button type="button" class="invoice-search-option @(selectedClientId == client.cliente_id ? "active" : null)" @onclick="() => SelectClientAsync(client.cliente_id)" disabled="@(!canEditModule)">
                                                        <strong>@(string.IsNullOrWhiteSpace(client.razon_social) ? GetClientPersonName(client) : client.razon_social)</strong>
                                                        <span>@client.numero_identificacion</span>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    @if (billingClient is null && selectedPatient is null)
                                    {
                                        <div class="invoice-empty" style="margin-top: 1rem;">Selecciona cliente y paciente por separado. El paciente no reemplaza al cliente, y el cliente no reemplaza al paciente.</div>
                                    }
                                    else
                                    {
                                        <div class="invoice-party-stack" style="margin-top: 1rem;">
                                            <div>
                                                <div class="invoice-party-card-title">Cliente de facturacion</div>
                                                <div class="invoice-readonly-grid">
                                                    <div class="invoice-readonly-item">
                                                        <label>Nombre fiscal</label>
                                                        <strong>@GetClientDisplayName(billingClient)</strong>
                                                    </div>
                                                    <div class="invoice-readonly-item">
                                                        <label>Identificacion</label>
                                                        <strong>@GetClientIdentification(billingClient)</strong>
                                                    </div>
                                                    <div class="invoice-readonly-item">
                                                        <label>Direccion</label>
                                                        <span>@(billingClient?.direccion ?? "Sin direccion")</span>
                                                    </div>
                                                    <div class="invoice-readonly-item">
                                                        <label>Telefono</label>
                                                        <span>@(billingClient?.telefono ?? "Sin telefono")</span>
                                                    </div>
                                                    <div class="invoice-readonly-item">
                                                        <label>Correo</label>
                                                        <span>@(billingClient?.correo_electronico ?? "Sin correo")</span>
                                                    </div>
                                                    <div class="invoice-readonly-item">
                                                        <label>Condicion</label>
                                                        <span>@(billingClient?.condicion_pago ?? "Contado")</span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div>
                                                <div class="invoice-party-card-title">Paciente origen</div>
                                                <div class="invoice-readonly-grid">
                                                    <div class="invoice-readonly-item">
                                                        <label>Paciente</label>
                                                        <strong>@(selectedPatient is null ? "Sin paciente fijo" : GetPatientFullName(selectedPatient))</strong>
                                                    </div>
                                                    <div class="invoice-readonly-item">
                                                        <label>Cedula</label>
                                                        <strong>@(selectedPatient?.cedula ?? "Sin cedula")</strong>
                                                    </div>
                                                    <div class="invoice-readonly-item">
                                                        <label>Direccion</label>
                                                        <span>@(selectedPatient?.direccion ?? "Sin direccion")</span>
                                                    </div>
                                                    <div class="invoice-readonly-item">
                                                        <label>Telefono</label>
                                                        <span>@(selectedPatient?.telefono ?? "Sin telefono")</span>
                                                    </div>
                                                    <div class="invoice-readonly-item">
                                                        <label>Correo</label>
                                                        <span>@(selectedPatient?.email ?? "Sin correo")</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </section>

                                <section class="invoice-section">
                                    <div class="invoice-block-title">Pago y control</div>
                                    <div class="invoice-toolbar-grid">
                                        <div>
                                            <label class="form-label">Forma de pago</label>
                                            <select class="form-select" @bind="paymentForm" disabled="@(!canEditModule)">
                                                @foreach (var method in paymentMethods)
                                                {
                                                    <option value="@method">@method</option>
                                                }
                                            </select>
                                        </div>

                                        <div>
                                            <label class="form-label">Dias de credito</label>
                                            <input type="number" class="form-control" @bind="creditDays" min="0" readonly="@(!canEditModule)" />
                                        </div>

                                        <div>
                                            <label class="form-label">Impuesto promedio %</label>
                                            <input class="form-control" value="@taxRate.ToString("0.##")" readonly />
                                        </div>

                                        <div>
                                            <label class="form-label">Valor cobrado</label>
                                            <input type="number" step="0.01" class="form-control" @bind="paidAmount" min="0" readonly="@(!canEditModule)" />
                                        </div>
                                    </div>

                                    <div class="invoice-readonly-grid" style="margin-top: 1rem;">
                                        <div class="invoice-readonly-item">
                                            <label>Numero factura</label>
                                            <strong>@DisplayInvoiceNumber</strong>
                                        </div>
                                        <div class="invoice-readonly-item">
                                            <label>Lineas cargadas</label>
                                            <strong>@draftLines.Count</strong>
                                        </div>
                                        <div class="invoice-readonly-item">
                                            <label>Subtotal</label>
                                            <strong>@subtotalPreview.ToString("0.00")</strong>
                                        </div>
                                        <div class="invoice-readonly-item">
                                            <label>Impuestos</label>
                                            <strong>@taxPreview.ToString("0.00")</strong>
                                        </div>
                                    </div>
                                </section>
                            </div>
                        </section>

                        <section class="invoice-section invoice-lines-card">
                            <div class="management-card-header">
                                <h2>Detalle de factura</h2>
                                <span>@draftLines.Count lineas</span>
                            </div>
                            <p class="invoice-section-caption">La tabla prioriza concepto, origen y total por línea para que el documento se lea más profesional y contable.</p>

                            <div class="table-responsive" style="margin-top: 1rem;">
                                <table class="table table-hover invoice-lines-table">
                                    <thead>
                                        <tr>
                                            <th>Codigo</th>
                                            <th>Concepto</th>
                                            <th>Origen</th>
                                            <th>IVA</th>
                                            <th>Cantidad</th>
                                            <th>Precio</th>
                                            <th>Descuento</th>
                                            <th>Total</th>
                                            <th style="text-align: right;">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (draftLines.Count == 0)
                                        {
                                            <tr>
                                                <td colspan="9" style="text-align: center; padding: 2rem; color: var(--color-taupe);">No hay lineas en la factura.</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var line in PagedDraftLines)
                                            {
                                                <tr>
                                                    <td>@line.id_productoNavigation.codigo_producto</td>
                                                    <td>
                                                        <strong>@(line.concepto_item ?? line.id_productoNavigation.nombre_producto)</strong>
                                                        <div style="font-size: 0.78rem; color: var(--color-taupe);">@line.id_productoNavigation.nombre_producto</div>
                                                    </td>
                                                    <td>@GetOriginLabel(line)</td>
                                                    <td>@GetLineTaxLabel(line)</td>
                                                    <td>@line.cantidad</td>
                                                    <td>@((line.precio_unitario ?? 0).ToString("0.00"))</td>
                                                    <td>@((line.descuento ?? 0).ToString("0.00"))</td>
                                                    <td class="invoice-line-total">@((line.total_item ?? 0).ToString("0.00"))</td>
                                                    <td style="text-align: right;">
                                                        <div style="display: inline-flex; gap: 0.5rem;">
                                                            <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important;" @onclick="() => BeginLineEdit(line)" disabled="@(!canEditModule)">
                                                                Editar
                                                            </button>
                                                            <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important;" @onclick="() => RemoveLineAsync(line.id_detalle_venta)" disabled="@(!canEditModule)">
                                                                Quitar
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <TablePager TotalItems="@draftLines.Count" CurrentPage="@draftLinePage" CurrentPageChanged="SetDraftLinePage" />

                            <div class="invoice-line-editor">
                                <div class="invoice-block-title">@(lineEditor.LineId > 0 ? "Editar linea" : "Nueva linea")</div>

                                <div class="invoice-editor-grid invoice-editor-grid--line">
                                    <div class="invoice-editor-wide">
                                        <label class="form-label">Producto</label>
                                        <select class="form-select" value="@lineEditor.ProductId" @onchange="OnManualProductChanged" disabled="@(!canEditModule)">
                                            <option value="0">Selecciona</option>
                                            @foreach (var product in AvailableInvoiceProducts)
                                            {
                                                <option value="@product.id_producto">@GetInvoiceProductOptionLabel(product)</option>
                                            }
                                        </select>
                                    </div>

                                    <div>
                                        <label class="form-label">Cantidad</label>
                                        <input type="number" class="form-control" @bind="lineEditor.Quantity" min="1" readonly="@(!canEditModule)" />
                                    </div>

                                    <div>
                                        <label class="form-label">Precio unitario</label>
                                        <input type="number" step="0.01" class="form-control" @bind="lineEditor.UnitPrice" min="0" readonly="@(!canEditModule)" />
                                    </div>

                                    <div>
                                        <label class="form-label">Descuento</label>
                                        <input type="number" step="0.01" class="form-control" @bind="lineEditor.Discount" min="0" readonly="@(!canEditModule)" />
                                    </div>

                                    <div class="invoice-editor-wide">
                                        <label class="form-label">Concepto</label>
                                        <input class="form-control" @bind="lineEditor.Concept" readonly="@(!canEditModule)" />
                                    </div>

                                    <div>
                                        <label class="form-label">IVA del producto</label>
                                        <select class="form-select" value="@LineEditorTieneIvaValue" @onchange="OnLineEditorTieneIvaChanged" disabled="@(!canEditModule || SelectedManualProduct is null)">
                                            <option value="true">Si</option>
                                            <option value="false">No</option>
                                        </select>
                                    </div>

                                    <div>
                                        <label class="form-label">IVA %</label>
                                        <select class="form-select" @bind="lineEditor.PorcentajeIva" disabled="@(!canEditModule || SelectedManualProduct is null || !lineEditor.TieneIva)">
                                            @foreach (var percentage in ivaPercentageOptions)
                                            {
                                                <option value="@percentage">@($"{percentage:0}%")</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="invoice-editor-total">
                                        <label>Total de linea</label>
                                        <strong>@LineEditorTotal.ToString("0.00")</strong>
                                    </div>
                                </div>

                                <div class="invoice-actions-primary">
                                    <button type="button" class="btn btn-primary" @onclick="SaveLineAsync" disabled="@(!canEditModule)">@LineActionLabel</button>
                                    <button type="button" class="btn btn-outline-primary" @onclick="ResetLineEditor" disabled="@(!canEditModule)">Limpiar</button>
                                    <button type="button" class="btn btn-outline-primary" @onclick="ToggleProductUpsertForm" disabled="@(!canEditModule)">Upsert producto</button>
                                </div>
                            </div>

                            @if (showProductUpsertForm)
                            {
                                <div class="invoice-product-upsert">
                                    <div class="invoice-block-title">@(productUpsertEditor.IdProducto > 0 ? "Editar producto" : "Crear producto rapido")</div>

                                    <div class="invoice-upsert-grid">
                                        <div>
                                            <label class="form-label">Codigo *</label>
                                            <input class="form-control" @bind="productUpsertEditor.CodigoProducto" maxlength="50" />
                                        </div>

                                        <div>
                                            <label class="form-label">Nombre *</label>
                                            <input class="form-control" @bind="productUpsertEditor.NombreProducto" maxlength="150" />
                                        </div>

                                        <div>
                                            <label class="form-label">Tipo item</label>
                                            <input class="form-control" value="Producto" readonly />
                                        </div>

                                        <div>
                                            <label class="form-label">Categoria *</label>
                                            <select class="form-select" @bind="productUpsertEditor.IdCategoria">
                                                <option value="0">Selecciona</option>
                                                @foreach (var category in categories.OrderBy(x => x.nombre))
                                                {
                                                    <option value="@category.id_categoria">@category.nombre</option>
                                                }
                                            </select>
                                        </div>

                                        <div>
                                            <label class="form-label">Precio venta</label>
                                            <input type="number" step="0.01" min="0" class="form-control" @bind="productUpsertEditor.PrecioVenta" />
                                        </div>

                                        <div>
                                            <label class="form-label">Tiene IVA</label>
                                            <select class="form-select" value="@ProductUpsertTieneIvaValue" @onchange="OnProductUpsertTieneIvaChanged">
                                                <option value="true">Si</option>
                                                <option value="false">No</option>
                                            </select>
                                        </div>

                                        <div>
                                            <label class="form-label">IVA %</label>
                                            <select class="form-select" @bind="productUpsertEditor.PorcentajeIva" disabled="@(!productUpsertEditor.TieneIva)">
                                                @foreach (var percentage in ivaPercentageOptions)
                                                {
                                                    <option value="@percentage">@($"{percentage:0}%")</option>
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <div class="invoice-actions-primary">
                                        <button type="button" class="btn btn-primary" @onclick="SaveQuickProductAsync">@ProductUpsertActionLabel</button>
                                    </div>
                                </div>
                            }
                        </section>
                    </div>

                    <aside class="invoice-sidebar">
                        <section class="invoice-sidebar-card invoice-sidebar-total">
                            <div class="invoice-block-title">Totales de emision</div>
                            <span>Total final</span>
                            <strong>@totalPreview.ToString("0.00")</strong>
                            <span>Documento listo para confirmar</span>

                            <table class="table invoice-summary-table" style="margin: 0.9rem 0 0;">
                                <tbody>
                                    <tr><td>Subtotal</td><td>@subtotalPreview.ToString("0.00")</td></tr>
                                    <tr><td>Impuestos</td><td>@taxPreview.ToString("0.00")</td></tr>
                                    <tr><td>Cobrado</td><td>@paidAmount.ToString("0.00")</td></tr>
                                    <tr><td>Saldo</td><td>@balancePreview.ToString("0.00")</td></tr>
                                </tbody>
                            </table>

                            <div class="invoice-sidebar-actions">
                                <button type="button" class="btn btn-primary" @onclick="FinalizeInvoiceAsync" disabled="@(!CanFinalizeInvoice)">Emitir factura</button>
                                <button type="button" class="btn btn-outline-light" disabled>Guardar borrador</button>
                            </div>
                            @if (currentIssuer is null)
                            {
                                <div class="invoice-sidebar-hint">Configura un emisor activo antes de poder emitir la factura.</div>
                            }
                        </section>

                        <section class="invoice-sidebar-card">
                            <div class="invoice-block-title">Vista previa</div>
                            <div class="invoice-preview-sheet">
                                <div class="invoice-preview-header">
                                    <div>
                                        <strong style="display:block; color:var(--color-ink);">@(currentIssuer?.nombre_comercial ?? currentIssuer?.razon_social ?? "Emisor")</strong>
                                        <span style="color:var(--color-taupe);">@(currentIssuer?.direccion ?? "Direccion pendiente")</span>
                                    </div>
                                    <div style="text-align:right;">
                                        <strong style="display:block; color:var(--color-ink);">Factura</strong>
                                        <span style="color:var(--color-taupe);">@DisplayInvoiceNumber</span>
                                    </div>
                                </div>

                                <div class="invoice-preview-mini-grid">
                                    <div><strong>Cliente</strong><br />@GetClientDisplayName(billingClient)</div>
                                    <div><strong>Identificacion</strong><br />@GetClientIdentification(billingClient)</div>
                                    <div><strong>Paciente</strong><br />@(selectedPatient is null ? "Sin paciente fijo" : GetPatientFullName(selectedPatient))</div>
                                    <div><strong>Cedula paciente</strong><br />@(selectedPatient?.cedula ?? "Sin cedula")</div>
                                    <div><strong>Fecha</strong><br />@InvoiceDateLabel</div>
                                    <div><strong>Pago</strong><br />@paymentForm</div>
                                </div>

                                <table class="table invoice-summary-table" style="margin-bottom: 0;">
                                    <tbody>
                                        <tr><td>Items</td><td>@draftLines.Count</td></tr>
                                        <tr><td>Subtotal</td><td>@subtotalPreview.ToString("0.00")</td></tr>
                                        <tr><td>IVA</td><td>@taxPreview.ToString("0.00")</td></tr>
                                        <tr><td>Total</td><td>@totalPreview.ToString("0.00")</td></tr>
                                    </tbody>
                                </table>

                                <div class="invoice-preview-notes">
                                    @(string.IsNullOrWhiteSpace(invoiceNotes) ? "Sin observaciones adicionales." : invoiceNotes)
                                </div>
                            </div>
                        </section>

                        <section class="invoice-sidebar-card">
                            <div class="invoice-block-title">Observaciones</div>
                            <textarea class="form-control" rows="7" @bind="invoiceNotes" readonly="@(!canEditModule)"></textarea>
                        </section>

                        <section class="invoice-sidebar-card">
                            <div class="invoice-block-title">Accesos rapidos</div>
                            <div class="invoice-sidebar-links">
                                <a class="btn btn-outline-primary" href="/clients">Administrar clientes</a>
                                <a class="btn btn-outline-primary" href="/my-invoices">Mis facturas</a>
                                <a class="btn btn-outline-primary" href="/my-credit-notes">Mis notas de credito</a>
                            </div>
                        </section>
                    </aside>
                </div>
            </div>
        </section>
    </section>
}

@code {
    private const int TablePageSize = 5;
    private int draftLinePage = 1;
    private IEnumerable<tbl_detalle_venta> PagedDraftLines => draftLines.Skip((draftLinePage - 1) * TablePageSize).Take(TablePageSize);
    private void SetDraftLinePage(int page) => draftLinePage = page;
    private readonly List<tbl_paciente> patients = [];
    private readonly List<ClientEntity> clients = [];
    private readonly List<tbl_producto> products = [];
    private readonly List<tbl_categoria_producto> categories = [];
    private readonly List<string> paymentMethods = [];
    private readonly List<tbl_detalle_venta> draftLines = [];
    private readonly string[] productTypeOptions = ["Producto"];
    private ModulePermissions permissions = new();
    private tbl_paciente? selectedPatient;
    private ClientEntity? billingClient;
    private EmisorEntity? currentIssuer;
    private tbl_venta? draftSale;
    private bool isLoading = true;
    private bool canViewModule;
    private bool canEditModule;
    private int currentUserId;
    private int currentRoleId;
    private int selectedPatientId;
    private int selectedClientId;
    private string patientSearchTerm = string.Empty;
    private string clientSearchTerm = string.Empty;
    private string? statusMessage;
    private string? errorMessage;
    private string invoiceNumberPreview = "Configura emisor";
    private bool issuerRequiresInitialSequence;
    private string initialInvoiceSequenceInput = string.Empty;
    private string paymentForm = "Efectivo";
    private int creditDays;
    private decimal taxRate;
    private decimal paidAmount;
    private string invoiceNotes = string.Empty;
    private decimal subtotalPreview;
    private decimal taxPreview;
    private decimal totalPreview;
    private decimal balancePreview;
    private readonly decimal[] ivaPercentageOptions = [5m, 8m, 13m, 15m];
    private ManualLineEditor lineEditor = new();
    private ProductUpsertEditor productUpsertEditor = new();
    private bool showProductUpsertForm;

    private tbl_producto? SelectedManualProduct => products.FirstOrDefault(x => x.id_producto == lineEditor.ProductId);
    private IEnumerable<tbl_producto> AvailableInvoiceProducts => products
        .Where(CanInvoiceProduct)
        .OrderBy(x => x.nombre_producto)
        .ThenBy(x => x.codigo_producto);
    private string InvoiceDateLabel => (draftSale?.fecha_venta ?? DateTime.Now).ToString("yyyy-MM-dd HH:mm");
    private decimal LineEditorTotal => Math.Max(0m, (lineEditor.UnitPrice * lineEditor.Quantity) - lineEditor.Discount);
    private string LineActionLabel => lineEditor.LineId > 0 ? "Actualizar linea" : "Agregar linea";
    private string ProductUpsertActionLabel => productUpsertEditor.IdProducto > 0 ? "Actualizar producto" : "Guardar producto";
    private string InitialSequencePreview => GetInitialSequencePreview();
    private string DisplayInvoiceNumber => issuerRequiresInitialSequence ? InitialSequencePreview : invoiceNumberPreview;
    private bool CanFinalizeInvoice => canEditModule && currentIssuer is not null;
    private IEnumerable<tbl_paciente> FilteredPatients => patients
        .Where(MatchesPatientSearch)
        .Take(25);
    private IEnumerable<ClientEntity> FilteredClients => clients
        .Where(MatchesClientSearch)
        .Take(25);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync(int? patientId = null)
    {
        isLoading = true;
        statusMessage = null;
        errorMessage = null;

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        currentUserId = int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var userId) ? userId : 0;
        currentRoleId = int.TryParse(user.FindFirstValue("RoleId"), out var roleId) ? roleId : 0;

        permissions = await GetModulePermissionsAsync(dbContext, currentRoleId);
        canViewModule = permissions.CanView;
        canEditModule = permissions.CanCreate || permissions.CanEdit;

        if (!canViewModule)
        {
            isLoading = false;
            return;
        }

        patients.Clear();
        patients.AddRange(await dbContext.tbl_pacientes
            .AsNoTracking()
            .Where(x => x.activo == true)
            .OrderBy(x => x.apellidos)
            .ThenBy(x => x.nombres)
            .ToListAsync());

        clients.Clear();
        clients.AddRange(await dbContext.clients
            .AsNoTracking()
            .Where(x => x.estado && x.id_usuario_creacion == currentUserId)
            .OrderBy(x => x.razon_social)
            .ThenBy(x => x.numero_identificacion)
            .ToListAsync());

        currentIssuer = await dbContext.emisor
            .AsNoTracking()
            .FirstOrDefaultAsync(x => x.id_usuario_creacion == currentUserId && x.estado);

        categories.Clear();
        categories.AddRange(await dbContext.tbl_categoria_productos
            .AsNoTracking()
            .Where(x => x.activo == true)
            .OrderBy(x => x.nombre)
            .ToListAsync());

        products.Clear();
        products.AddRange(await dbContext.tbl_productos
            .AsNoTracking()
            .Where(x => x.activo == true)
            .OrderBy(x => x.tipo_item)
            .ThenBy(x => x.nombre_producto)
            .ToListAsync());

        paymentMethods.Clear();
        paymentMethods.AddRange(await dbContext.tbl_metodo_pagos
            .AsNoTracking()
            .OrderBy(x => x.nombre)
            .Select(x => x.nombre)
            .ToListAsync());

        if (paymentMethods.Count == 0)
        {
            paymentMethods.AddRange(["Efectivo", "Tarjeta", "Transferencia", "Credito"]);
        }

        if (currentIssuer is null)
        {
            issuerRequiresInitialSequence = false;
            initialInvoiceSequenceInput = string.Empty;
            invoiceNumberPreview = "Configura emisor";
        }
        else
        {
            var issuer = currentIssuer;
            var lastSequence = await BillingDraftService.GetLastInvoiceSequenceAsync(dbContext, issuer);
            issuerRequiresInitialSequence = !lastSequence.HasValue;
            invoiceNumberPreview = issuerRequiresInitialSequence
                ? GetInitialSequencePreview()
                : BillingDraftService.BuildInvoiceNumber(issuer, (lastSequence ?? 0) + 1);
        }

        selectedPatientId = patientId ?? selectedPatientId;
        await LoadCurrentDraftContextAsync(dbContext, selectedPatientId, selectedClientId);
        SyncSearchTerms();

        isLoading = false;
    }

    private async Task LoadCurrentDraftContextAsync(OpticaDbContext dbContext, int patientId, int clientId)
    {
        selectedPatient = patientId > 0
            ? await dbContext.tbl_pacientes.FirstOrDefaultAsync(x => x.id_paciente == patientId)
            : null;

        billingClient = clientId > 0
            ? clients.FirstOrDefault(x => x.cliente_id == clientId)
            : null;

        if (billingClient is null && selectedPatient is null)
        {
            draftSale = null;
            draftLines.Clear();
            showProductUpsertForm = false;
            ResetLineEditor();
            RecalculatePreview();
            return;
        }

        if (billingClient is null)
        {
            draftSale = null;
            draftLines.Clear();
            showProductUpsertForm = false;
            ResetLineEditor();
            RecalculatePreview();
            return;
        }

        try
        {
            var effectivePatientId = await ResolveAnchorPatientIdAsync(dbContext);
            draftSale = await BillingDraftService.GetOrCreateDraftSaleAsync(
                dbContext,
                effectivePatientId,
                billingClient?.cliente_id,
                currentUserId);

            draftSale = await dbContext.tbl_venta
                .Include(x => x.tbl_detalle_venta)
                .ThenInclude(x => x.id_productoNavigation)
                .FirstAsync(x => x.id_venta == draftSale.id_venta);

            paymentForm = draftSale.forma_pago ?? paymentMethods.First();
            creditDays = draftSale.dias_credito ?? 0;
            taxRate = draftSale.porcentaje_impuesto ?? 0;
            paidAmount = draftSale.valor_cobrado ?? 0;
            invoiceNotes = draftSale.observaciones_factura ?? string.Empty;

            draftLines.Clear();
            draftLines.AddRange(draftSale.tbl_detalle_venta.OrderByDescending(x => x.origen_tipo).ThenBy(x => x.id_detalle_venta));
            await BillingDraftService.RecalculateSaleAsync(dbContext, draftSale);
            showProductUpsertForm = false;
            ResetLineEditor();
            RecalculatePreview();
        }
        catch (InvalidOperationException)
        {
            draftSale = null;
            draftLines.Clear();
            showProductUpsertForm = false;
            ResetLineEditor();
            RecalculatePreview();
        }
    }

