@page "/laboratories"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@using System.Net.Mail
@using Microsoft.EntityFrameworkCore
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject NavigationManager NavigationManager

<PageTitle>Laboratorios</PageTitle>

@if (isLoading)
{
    <section class="management-shell">
        <div class="management-card">
            <h1>Cargando laboratorios...</h1>
        </div>
    </section>
}
else if (!canViewLaboratories)
{
    <section class="management-shell">
        <div class="management-card">
            <span class="eyebrow">Restringido</span>
            <h1>Gestion de laboratorios</h1>
            <p>Tu rol no tiene permiso para ver este modulo.</p>
        </div>
    </section>
}
else
{
    <section class="management-shell">
        <div class="management-hero">
            <div>
                <span class="eyebrow">Administrador</span>
                <h1>Laboratorios</h1>
                <p>Administra convenios y contactos de laboratorio con una vista clara, filtros rápidos y acciones integradas.</p>
            </div>

            <div class="workspace-actions">
                @if (permissions.CanCreate)
                {
                    <button type="button" class="btn btn-primary" @onclick="PrepareNewLaboratory">
                        <i class="bi bi-plus-lg" style="margin-right: 6px;"></i> Nuevo laboratorio
                    </button>
                }

                <button type="button" class="btn btn-outline-primary" @onclick="ExportLaboratories">Exportar CSV</button>
            </div>
        </div>

        <section class="management-card">
            <div class="management-card-header">
                <h2>Filtros y búsqueda</h2>
                <span>@FilteredLaboratories.Count resultados</span>
            </div>

            <div class="filters-row-1-1">
                <div>
                    <label class="form-label" for="laboratorySearch">Buscador</label>
                    <input id="laboratorySearch" class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Nombre, correo, contacto, dirección o whatsapp" />
                </div>

                <div>
                    <label class="form-label" for="laboratoryStatus">Estado</label>
                    <select id="laboratoryStatus" class="form-select" @bind="selectedStatusFilter">
                        <option value="all">Todos</option>
                        <option value="active">Activos</option>
                        <option value="inactive">Inactivos</option>
                    </select>
                </div>
            </div>

            <div class="management-actions" style="margin-top: 1rem;">
                <button type="button" class="btn btn-outline-primary" @onclick="ClearFilters">Limpiar filtros</button>
            </div>
        </section>

        <!-- Laboratories Table Card (Full Width) -->
        <section class="management-card" style="margin-top: 1.5rem;">
            <div class="management-card-header">
                <h2>Listado de Laboratorios</h2>
                <span>@FilteredLaboratories.Count registrados</span>
            </div>

            <div class="table-responsive" style="margin-top: 1rem;">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>WhatsApp</th>
                            <th>Contacto</th>
                            <th>Estado</th>
                            <th style="text-align: right; padding-right: 1.5rem;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredLaboratories.Count == 0)
                        {
                            <tr>
                                <td colspan="7" style="text-align: center; padding: 2rem; color: var(--color-taupe);">
                                    No se encontraron laboratorios registrados con los filtros seleccionados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var laboratory in FilteredLaboratories)
                            {
                                <tr>
                                    <td>
                                        <span style="font-family: monospace; font-size: 0.85rem;">@laboratory.id_laboratorio</span>
                                    </td>
                                    <td>
                                        <strong style="color: var(--color-ink);">@laboratory.nombre</strong>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(laboratory.correo) ? "-" : laboratory.correo)</td>
                                    <td>@(string.IsNullOrWhiteSpace(laboratory.whatsapp) ? "-" : laboratory.whatsapp)</td>
                                    <td>@(string.IsNullOrWhiteSpace(laboratory.persona_contacto) ? "-" : laboratory.persona_contacto)</td>
                                    <td>
                                        @if (laboratory.activo == true)
                                        {
                                            <span class="badge" style="background: rgba(93, 161, 129, 0.15) !important; color: #5DA181 !important; font-size: 0.78rem; padding: 0.35rem 0.65rem; border-radius: 2rem;">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background: rgba(127, 105, 81, 0.12) !important; color: #7F6951 !important; font-size: 0.78rem; padding: 0.35rem 0.65rem; border-radius: 2rem;">Inactivo</span>
                                        }
                                    </td>
                                    <td style="text-align: right; padding-right: 1.2rem;">
                                        <div style="display: inline-flex; gap: 0.4rem; justify-content: flex-end;">
                                            <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(93, 161, 129, 0.3) !important; color: var(--color-sage) !important;" @onclick="() => PrepareEditLaboratory(laboratory)">
                                                <i class="bi bi-pencil-fill" style="margin-right: 4px;"></i> Editar
                                            </button>
                                            <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(254, 188, 100, 0.4) !important; color: #e09b3c !important;" @onclick="() => PrepareAuditLaboratory(laboratory)">
                                                <i class="bi bi-clock-history" style="margin-right: 4px;"></i> Auditoría
                                            </button>
                                            @if (permissions.CanDelete)
                                            {
                                                @if (laboratory.activo == true)
                                                {
                                                    <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(127, 105, 81, 0.2) !important; color: var(--color-taupe) !important;" @onclick="() => ToggleActiveAsync(laboratory)">
                                                        Desactivar
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; background-color: var(--color-sage) !important; border-color: var(--color-sage) !important;" @onclick="() => ToggleActiveAsync(laboratory)">
                                                        Activar
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </section>
}

<!-- Custom Form Modal -->
@if (showFormModal && editor is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card form-modal-card">
            <header class="custom-modal-header rose-header">
                <h2>@EditorTitle</h2>
                <button type="button" class="btn-close-modal" @onclick="() => showFormModal = false">×</button>
            </header>
            <div class="custom-modal-body">
                <div class="management-form-grid">
                    <div>
                        <label class="form-label" for="labName">Nombre</label>
                        <input id="labName" class="form-control" @bind="editor.Nombre" readonly="@(!CanModifyEditor)" maxlength="150" />
                    </div>

                    <div>
                        <label class="form-label" for="labContact">Persona de contacto</label>
                        <input id="labContact" class="form-control" @bind="editor.PersonaContacto" readonly="@(!CanModifyEditor)" maxlength="100" />
                    </div>

                    <div>
                        <label class="form-label" for="labEmail">Correo</label>
                        <input id="labEmail" type="email" class="form-control" @bind="editor.Correo" readonly="@(!CanModifyEditor)" maxlength="150" />
                    </div>

                    <div>
                        <label class="form-label" for="labWhatsapp">Whatsapp</label>
                        <input id="labWhatsapp" class="form-control" @bind="editor.Whatsapp" readonly="@(!CanModifyEditor)" maxlength="30" />
                    </div>

                    <div class="patient-form-span">
                        <label class="form-label" for="labAddress">Dirección</label>
                        <input id="labAddress" class="form-control" @bind="editor.Direccion" readonly="@(!CanModifyEditor)" maxlength="255" />
                    </div>
                </div>
            </div>
            <footer class="custom-modal-footer">
                @if (CanModifyEditor)
                {
                    <button type="button" class="btn btn-primary" @onclick="SaveLaboratoryAsync">Guardar cambios</button>
                }
                <button type="button" class="btn btn-outline-primary" @onclick="() => showFormModal = false">Cerrar</button>
            </footer>
        </div>
    </div>
}

<!-- Custom Audit Modal -->
@if (showAuditModal && selectedLaboratory is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card audit-modal-card">
            <header class="custom-modal-header apricot-header">
                <h2>Historial de Auditoría - @selectedLaboratory.nombre</h2>
                <button type="button" class="btn-close-modal" @onclick="() => showAuditModal = false">×</button>
            </header>
            <div class="custom-modal-body">
                @if (auditEntries.Count == 0)
                {
                    <p style="text-align: center; color: var(--color-taupe); margin: 2rem 0;">No hay eventos registrados para este laboratorio en este módulo.</p>
                }
                else
                {
                    <div class="management-list">
                        @foreach (var auditEntry in auditEntries)
                        {
                            <article class="management-list-item" style="border: 1px solid rgba(127, 105, 81, 0.08); border-radius: 0.8rem; padding: 0.95rem; margin-bottom: 0.6rem; background: #faf8f4;">
                                <div style="display: flex; justify-content: space-between; margin-bottom: 0.35rem;">
                                    <strong style="color: var(--color-sage);">@auditEntry.accion</strong>
                                    <span style="font-size: 0.78rem; color: var(--color-taupe);">@(auditEntry.fecha?.ToString("yyyy-MM-dd HH:mm") ?? "Sin fecha")</span>
                                </div>
                                <div style="font-size: 0.82rem; color: var(--color-ink); margin-bottom: 0.35rem;">@auditEntry.detalle</div>
                                <span style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-taupe); opacity: 0.8;">@GetAuditActorLabel(auditEntry)</span>
                            </article>
                        }
                    </div>
                }
            </div>
            <footer class="custom-modal-footer">
                <button type="button" class="btn btn-outline-primary" @onclick="() => showAuditModal = false">Cerrar</button>
            </footer>
        </div>
    </div>
}

<!-- Custom Alert Modal -->
@if (showAlertModal)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card alert-modal-card">
            <header class="custom-modal-header @(alertIsError ? "error-header" : "success-header")">
                <h2>@(alertIsError ? "Error de Validación" : "Operación Exitosa")</h2>
            </header>
            <div class="custom-modal-body" style="padding: 2rem 1.5rem; text-align: center;">
                <div style="font-size: 3rem; margin-bottom: 1rem; color: @(alertIsError ? "#7F6951" : "#5DA181")">
                    <i class="bi @(alertIsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")"></i>
                </div>
                <p style="font-size: 1rem; color: var(--color-ink); line-height: 1.5; margin: 0;">@alertMessage</p>
            </div>
            <footer class="custom-modal-footer" style="justify-content: center; background: transparent; border-top: none; padding-top: 0;">
                <button type="button" class="btn btn-primary" style="min-width: 120px;" @onclick="CloseAlertModal">Aceptar</button>
            </footer>
        </div>
    </div>
}

