@page "/doctores"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using OptometriaApp.Data
@using OptometriaApp.Models
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject IPasswordHasher<tbl_usuario> PasswordHasher

<PageTitle>Medicos</PageTitle>

@if (isLoading)
{
    <section class="management-shell">
        <div class="management-card">
            <h1>Cargando medicos...</h1>
        </div>
    </section>
}
else if (!canViewDoctors)
{
    <section class="management-shell">
        <div class="management-card">
            <span class="eyebrow">Restringido</span>
            <h1>Gestion de medicos</h1>
            <p>Tu rol no tiene permiso para ver este modulo.</p>
        </div>
    </section>
}
else
{
    <section class="management-shell">
        <div class="management-hero">
            <div>
                <span class="eyebrow">Agenda medica</span>
                <h1>@HeroTitle</h1>
                <p>@HeroDescription</p>
            </div>

            <div class="workspace-actions" style="align-items: center;">
                @if (CanCreateDoctorProfile)
                {
                    <button type="button" class="btn btn-coffee" @onclick="PrepareNewDoctor">
                        <i class="bi bi-person-badge-fill" style="margin-right: 6px;"></i> Nueva ficha medica
                    </button>
                }
            </div>
        </div>

        @if (selfManagedMode && CurrentSelfUser is not null && CurrentSelfUser.tbl_medico is null)
        {
            <section class="management-card">
                <div class="management-card-header">
                    <h2>Perfil pendiente</h2>
                    <span>Necesario para citas</span>
                </div>

                <p>
                    Tu usuario ya tiene rol medico, pero aun no tiene ficha profesional completada. Mientras siga pendiente,
                    los pacientes no podran encontrarte para agendar citas.
                </p>

                <div class="workspace-actions">
                    @if (CanCreateDoctorProfile)
                    {
                        <button type="button" class="btn btn-primary" @onclick="PrepareNewDoctor">Completar mi ficha</button>
                    }
                </div>
            </section>
        }

        <section class="management-card">
            <div class="management-card-header">
                <h2>Filtros y busqueda</h2>
                <span>@FilteredUsers.Count resultados</span>
            </div>

            <div class="filters-row">
                <div>
                    <label class="form-label" for="doctorSearch">Buscador</label>
                    <input id="doctorSearch" class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Usuario, nombre, especialidad o licencia" />
                </div>

                <div class="filter-selects-col">
                    <div>
                        <label class="form-label" for="doctorProfileFilter">Ficha</label>
                        <select id="doctorProfileFilter" class="form-select" @bind="selectedProfileFilter">
                            <option value="all">Todas</option>
                            <option value="configured">Con ficha</option>
                            <option value="pending">Pendientes</option>
                            <option value="available">Disponibles para agenda</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label" for="doctorAccessFilter">Usuario</label>
                        <select id="doctorAccessFilter" class="form-select" @bind="selectedAccessFilter">
                            <option value="all">Todos</option>
                            <option value="active">Activos</option>
                            <option value="inactive">Inactivos</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label" for="doctorRecordFilter">Estado de ficha</label>
                        <select id="doctorRecordFilter" class="form-select" @bind="selectedRecordFilter">
                            <option value="all">Todos</option>
                            <option value="active">Fichas activas</option>
                            <option value="inactive">Fichas inactivas</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="management-actions" style="margin-top: 0.3rem;">
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ClearFilters" style="padding: 0.3rem 0.7rem !important; font-size: 0.78rem !important; border-color: rgba(127,105,81,0.25) !important;">
                    <i class="bi bi-trash" style="margin-right: 4px;"></i> Limpiar filtros
                </button>
            </div>
        </section>

        <section class="management-card" style="margin-top: 1.5rem;">
            <div class="management-card-header">
                <h2>Listado de medicos</h2>
                <span>@FilteredUsers.Count registrados</span>
            </div>

            <div class="table-responsive" style="margin-top: 1rem;">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Nombre</th>
                            <th>Rol</th>
                            <th>Especialidad</th>
                            <th>Licencia</th>
                            <th>Estado de ficha</th>
                            <th>Agenda</th>
                            <th style="text-align: right; padding-right: 1.5rem;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredUsers.Count == 0)
                        {
                            <tr>
                                <td colspan="8" style="text-align: center; padding: 2rem; color: var(--color-taupe);">
                                    No se encontraron medicos con los filtros seleccionados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var user in PagedUsers)
                            {
                                <tr>
                                    <td>
                                        <strong style="color: var(--color-sage);">@user.usuario</strong>
                                    </td>
                                    <td>
                                        <strong style="color: var(--color-ink);">@GetFullName(user)</strong>
                                        <div style="font-size: 0.78rem; color: var(--color-taupe);">@(string.IsNullOrWhiteSpace(user.email) ? "Sin correo" : user.email)</div>
                                    </td>
                                    <td>@(user.id_rolNavigation?.nombre ?? "Sin rol")</td>
                                    <td>@(string.IsNullOrWhiteSpace(user.tbl_medico?.especialidad) ? "-" : user.tbl_medico!.especialidad)</td>
                                    <td>@(string.IsNullOrWhiteSpace(user.tbl_medico?.numero_licencia) ? "-" : user.tbl_medico!.numero_licencia)</td>
                                    <td>
                                        @if (user.tbl_medico is null)
                                        {
                                            <span class="badge" style="background: rgba(254, 188, 100, 0.15) !important; color: #e09b3c !important; padding: 0.3rem 0.6rem; border-radius: 2rem;">Pendiente</span>
                                        }
                                        else if (user.tbl_medico.activo == true)
                                        {
                                            <span class="badge" style="background: rgba(93, 161, 129, 0.15) !important; color: #5DA181 !important; padding: 0.3rem 0.6rem; border-radius: 2rem;">Activa</span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background: rgba(127, 105, 81, 0.12) !important; color: #7F6951 !important; padding: 0.3rem 0.6rem; border-radius: 2rem;">Inactiva</span>
                                        }
                                    </td>
                                    <td>
                                        @if (IsAvailableForAppointments(user))
                                        {
                                            <span class="badge" style="background: rgba(93, 161, 129, 0.15) !important; color: #5DA181 !important; padding: 0.3rem 0.6rem; border-radius: 2rem;">Visible</span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background: rgba(127, 105, 81, 0.12) !important; color: #7F6951 !important; padding: 0.3rem 0.6rem; border-radius: 2rem;">No visible</span>
                                        }
                                    </td>
                                    <td style="text-align: right; padding-right: 1.2rem;">
                                        <div style="display: inline-flex; gap: 0.4rem; justify-content: flex-end;">
                                            @if (user.tbl_medico is null)
                                            {
                                                @if (permissions.CanCreate && CanManageUser(user))
                                                {
                                                    <button type="button" class="btn btn-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important;" @onclick="() => PrepareEditDoctor(user)">
                                                        <i class="bi bi-clipboard-plus-fill"></i> Completar ficha
                                                    </button>
                                                }
                                            }
                                            else
                                            {
                                                @if (permissions.CanEdit && CanManageUser(user))
                                                {
                                                    <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(93, 161, 129, 0.3) !important; color: var(--color-sage) !important;" @onclick="() => PrepareEditDoctor(user)">
                                                        <i class="bi bi-pencil-fill" style="margin-right: 4px;"></i> Editar
                                                    </button>
                                                }
                                            }

                                            <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(254, 188, 100, 0.4) !important; color: #e09b3c !important;" @onclick="() => PrepareAuditDoctor(user)">
                                                <i class="bi bi-clock-history" style="margin-right: 4px;"></i> Auditoria
                                            </button>

                                            @if (CanToggleDoctorProfile(user))
                                            {
                                                <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(127, 105, 81, 0.2) !important; color: var(--color-taupe) !important;" @onclick="() => ToggleActiveAsync(user)">
                                                    <i class="bi @(user.tbl_medico!.activo == true ? "bi-toggle-off" : "bi-toggle-on")"></i>
                                                    @(user.tbl_medico!.activo == true ? "Inactivar" : "Activar")
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <TablePager TotalItems="@FilteredUsers.Count" CurrentPage="@doctorPage" CurrentPageChanged="SetDoctorPage" />
        </section>
    </section>
}

@if (showFormModal && editor is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card form-modal-card" style="max-width: 960px;">
            <header class="custom-modal-header rose-header">
                <h2>@EditorTitle</h2>
                <button type="button" class="btn-close-modal" @onclick="CloseFormModal">x</button>
            </header>
            <div class="custom-modal-body">
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger" role="alert">@errorMessage</div>
                }

                <div class="doctor-auth-section" style="margin-bottom: 1.5rem; padding: 1.1rem 1.3rem; border-radius: 1rem; background: linear-gradient(135deg, rgba(93, 161, 129, 0.08), rgba(254, 188, 100, 0.06)); border: 1px solid rgba(93, 161, 129, 0.2);">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.9rem; flex-wrap: wrap; gap: 0.5rem;">
                        <div style="display: flex; align-items: center; gap: 0.6rem;">
                            <div style="width: 38px; height: 38px; border-radius: 50%; background: #5da181; color: white; display: flex; align-items: center; justify-content: center; font-size: 1.1rem;">
                                <i class="bi bi-shield-lock-fill"></i>
                            </div>
                            <div>
                                <h3 style="margin: 0; font-size: 1.05rem; font-weight: 700; color: var(--color-ink);">Cuenta de Inicio de Sesión</h3>
                                <span style="font-size: 0.8rem; color: var(--color-taupe);">Credenciales y estado de acceso del médico a la plataforma</span>
                            </div>
                        </div>
                        <div style="display: flex; gap: 0.4rem; align-items: center;">
                            <span class="badge" style="background: @(editor.LinkedUserActive ? "rgba(93, 161, 129, 0.18)" : "rgba(210, 74, 74, 0.15)"); color: @(editor.LinkedUserActive ? "#2b8a3e" : "#c92a2a"); font-size: 0.78rem; padding: 0.35rem 0.7rem; border-radius: 2rem;">
                                <i class="bi @(editor.LinkedUserActive ? "bi-check-circle-fill" : "bi-x-circle-fill") me-1"></i> @(editor.LinkedUserActive ? "Usuario Activo" : "Usuario Inactivo")
                            </span>
                            @if (editor.LinkedUserBlocked)
                            {
                                <span class="badge" style="background: rgba(210, 74, 74, 0.15); color: #c92a2a; font-size: 0.78rem; padding: 0.35rem 0.7rem; border-radius: 2rem;">
                                    <i class="bi bi-lock-fill me-1"></i> Bloqueado
                                </span>
                            }
                        </div>
                    </div>

                    @if (isCreatingNewDoctor && !selfManagedMode)
                    {
                        <div style="margin-bottom: 0.85rem;">
                            <label class="form-label" for="doctorUser" style="font-weight: 600;">Seleccionar usuario para vincular al médico *</label>
                            <select id="doctorUser" class="form-select" value="@editor.IdUsuario" @onchange="OnEditorUserChanged" disabled="@(!permissions.CanCreate)">
                                <option value="0">-- Selecciona un usuario con rol médico --</option>
                                @foreach (var user in eligibleUsers.OrderBy(u => u.apellidos).ThenBy(u => u.nombres))
                                {
                                    <option value="@user.id_usuario">@($"{GetFullName(user)} (@{user.usuario}) - {user.email ?? "Sin correo"}")</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="management-form-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.85rem; margin-top: 0.5rem;">
                        <div>
                            <label class="form-label" style="font-size: 0.82rem; margin-bottom: 0.2rem; color: var(--color-taupe);">Nombre de usuario</label>
                            <div class="input-group">
                                <span class="input-group-text" style="background: rgba(0,0,0,0.03);"><i class="bi bi-person-fill"></i></span>
                                <input class="form-control" value="@editor.LinkedUserName" readonly style="background: #ffffff; font-weight: 600;" />
                            </div>
                        </div>

                        <div>
                            <label class="form-label" style="font-size: 0.82rem; margin-bottom: 0.2rem; color: var(--color-taupe);">Correo electrónico de acceso</label>
                            <div class="input-group">
                                <span class="input-group-text" style="background: rgba(0,0,0,0.03);"><i class="bi bi-envelope-fill"></i></span>
                                <input class="form-control" value="@editor.LinkedUserEmail" @onchange="args => editor.LinkedUserEmail = args.Value?.ToString() ?? string.Empty" readonly="@(!CanModifyEditor)" style="background: #ffffff;" />
                            </div>
                        </div>

                        <div>
                            <label class="form-label" style="font-size: 0.82rem; margin-bottom: 0.2rem; color: var(--color-taupe);">Rol asignado</label>
                            <div class="input-group">
                                <span class="input-group-text" style="background: rgba(0,0,0,0.03);"><i class="bi bi-award-fill"></i></span>
                                <input class="form-control" value="@editor.LinkedRoleName" readonly style="background: #ffffff;" />
                            </div>
                        </div>

                        @if (editor.LinkedUserLastPasswordChange.HasValue)
                        {
                            <div>
                                <label class="form-label" style="font-size: 0.82rem; margin-bottom: 0.2rem; color: var(--color-taupe);">Último cambio de clave</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background: rgba(0,0,0,0.03);"><i class="bi bi-calendar2-check"></i></span>
                                    <input class="form-control" value="@editor.LinkedUserLastPasswordChange.Value.ToString("yyyy-MM-dd")" readonly style="background: #ffffff;" />
                                </div>
                            </div>
                        }
                    </div>

                    @if (CanModifyEditor)
                    {
                        <div style="margin-top: 1rem; padding-top: 0.85rem; border-top: 1px dashed rgba(127,105,81,0.2);">
                            <div class="form-check form-switch" style="margin-bottom: 0.6rem;">
                                <input id="changeDoctorPasswordSwitch" class="form-check-input" type="checkbox" @bind="editor.ChangePassword" />
                                <label class="form-check-label fw-bold" for="changeDoctorPasswordSwitch" style="color: var(--color-ink); font-size: 0.88rem;">
                                    <i class="bi bi-key-fill text-warning me-1"></i> Asignar / Cambiar contraseña de inicio de sesión
                                </label>
                            </div>

                            @if (editor.ChangePassword)
                            {
                                <div class="management-form-grid" style="grid-template-columns: 1fr 1fr; gap: 0.85rem; background: #ffffff; padding: 0.85rem; border-radius: 0.75rem; border: 1px solid rgba(127,105,81,0.15);">
                                    <div>
                                        <label class="form-label" for="doctorNewPassword" style="font-size: 0.84rem;">Nueva contraseña *</label>
                                        <input id="doctorNewPassword" type="password" class="form-control form-control-sm" @bind="editor.NewPassword" placeholder="Mínimo 6 caracteres" />
                                    </div>
                                    <div>
                                        <label class="form-label" for="doctorConfirmPassword" style="font-size: 0.84rem;">Confirmar nueva contraseña *</label>
                                        <input id="doctorConfirmPassword" type="password" class="form-control form-control-sm" @bind="editor.ConfirmPassword" placeholder="Repite la contraseña" />
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <p class="required-fields-note">Los campos marcados con * son obligatorios.</p>
                <div class="management-form-grid">
                    <div>
                        <label class="form-label" for="doctorLicense">Numero de licencia *</label>
                        <input id="doctorLicense" class="form-control" @bind="editor.NumeroLicencia" maxlength="50" readonly="@(!CanModifyEditor)" />
                    </div>

                    <div>
                        <label class="form-label" for="doctorSpecialty">Especialidad *</label>
                        <input id="doctorSpecialty" class="form-control" @bind="editor.Especialidad" maxlength="100" readonly="@(!CanModifyEditor)" />
                    </div>

                    <div>
                        <label class="form-label" for="doctorProfessionalId">Cedula profesional *</label>
                        <input id="doctorProfessionalId" class="form-control" @bind="editor.CedulaProfesional" maxlength="50" readonly="@(!CanModifyEditor)" />
                    </div>

                    <div>
                        <label class="form-label" for="doctorOfficePhone">Telefono consultorio *</label>
                        <input id="doctorOfficePhone" class="form-control" @bind="editor.TelefonoConsultorio" maxlength="10" inputmode="numeric" oninput="this.value=this.value.replace(/\D/g,'')" readonly="@(!CanModifyEditor)" />
                    </div>

                    <div>
                        <label class="form-label" for="doctorDuration">Duracion consulta (min) *</label>
                        <select id="doctorDuration" class="form-select" @bind="editor.DuracionConsultaMinutos" disabled="@(!CanModifyEditor)">
                            <option value="">Selecciona</option>
                            <option value="15">15 min</option>
                            <option value="30">30 min</option>
                            <option value="60">1 hora</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label" for="doctorPrice">Precio base *</label>
                        <input id="doctorPrice" type="number" step="0.01" class="form-control" @bind="editor.PrecioConsultaBase" readonly="@(!CanModifyEditor)" />
                    </div>

                    <details class="additional-details">
                        <summary><span><i class="bi bi-info-circle"></i> Detalles adicionales</span></summary>
                        <div class="additional-details-body">
                            <div>
                                <label class="form-label" for="doctorSchool">Institución de egreso</label>
                                <input id="doctorSchool" class="form-control" @bind="editor.InstitucionEgreso" maxlength="200" readonly="@(!CanModifyEditor)" />
                            </div>

                            <div>
                                <label class="form-label" for="doctorGraduationYear">Año de egreso</label>
                                <select id="doctorGraduationYear" class="form-select" @bind="editor.AnioEgreso" disabled="@(!CanModifyEditor)">
                                    <option value="">Selecciona</option>
                                    @for (var year = DateTime.Today.Year; year >= 1980; year--)
                                    {
                                        <option value="@year">@year</option>
                                    }
                                </select>
                            </div>

                            <div>
                                <label class="form-label" for="doctorLanguages">Idiomas</label>
                                <input id="doctorLanguages" class="form-control" @bind="editor.Idiomas" maxlength="200" readonly="@(!CanModifyEditor)" />
                            </div>

                            <div>
                                <label class="form-label" for="doctorDiscount">Descuento (%)</label>
                                <input id="doctorDiscount" type="number" step="0.01" class="form-control" @bind="editor.DescuentoPorcentaje" readonly="@(!CanModifyEditor)" />
                            </div>

                            <div>
                                <label class="form-label d-block">Acepta citas telefónicas</label>
                                <div class="form-check form-switch">
                                    <input id="doctorPhoneAppointments" class="form-check-input" type="checkbox" @bind="editor.AceptarCitasTelefonicas" disabled="@(!CanModifyEditor)" />
                                    <label class="form-check-label" for="doctorPhoneAppointments">@((editor.AceptarCitasTelefonicas ? "Sí" : "No"))</label>
                                </div>
                            </div>

                            <div>
                                <label class="form-label d-block">Acepta citas presenciales</label>
                                <div class="form-check form-switch">
                                    <input id="doctorInPersonAppointments" class="form-check-input" type="checkbox" @bind="editor.AceptarCitasPresenciales" disabled="@(!CanModifyEditor)" />
                                    <label class="form-check-label" for="doctorInPersonAppointments">@((editor.AceptarCitasPresenciales ? "Sí" : "No"))</label>
                                </div>
                            </div>

                            <div>
                                <label class="form-label d-block">Puede gestionar agenda</label>
                                <div class="form-check form-switch">
                                    <input id="doctorCanManageAgenda" class="form-check-input" type="checkbox" @bind="editor.PuedeGestionarAgenda" disabled="@(!CanModifyEditor)" />
                                    <label class="form-check-label" for="doctorCanManageAgenda">@((editor.PuedeGestionarAgenda ? "SÃ­" : "No"))</label>
                                </div>
                            </div>

                            <div>
                                <label class="form-label d-block">Puede gestionar disponibilidad</label>
                                <div class="form-check form-switch">
                                    <input id="doctorCanManageAvailability" class="form-check-input" type="checkbox" @bind="editor.PuedeGestionarDisponibilidad" disabled="@(!CanModifyEditor)" />
                                    <label class="form-check-label" for="doctorCanManageAvailability">@((editor.PuedeGestionarDisponibilidad ? "SÃ­" : "No"))</label>
                                </div>
                            </div>

                            <div>
                                <label class="form-label d-block">Puede gestionar historia clinica</label>
                                <div class="form-check form-switch">
                                    <input id="doctorCanManageHistory" class="form-check-input" type="checkbox" @bind="editor.PuedeGestionarHistoriaClinica" disabled="@(!CanModifyEditor)" />
                                    <label class="form-check-label" for="doctorCanManageHistory">@((editor.PuedeGestionarHistoriaClinica ? "SÃ­" : "No"))</label>
                                </div>
                            </div>

                            <div>
                                <label class="form-label d-block">Puede apoyar facturacion</label>
                                <div class="form-check form-switch">
                                    <input id="doctorCanManageBilling" class="form-check-input" type="checkbox" @bind="editor.PuedeGestionarFacturacion" disabled="@(!CanModifyEditor)" />
                                    <label class="form-check-label" for="doctorCanManageBilling">@((editor.PuedeGestionarFacturacion ? "SÃ­" : "No"))</label>
                                </div>
                            </div>

                            <div>
                                <label class="form-label d-block">Estado de ficha</label>
                                <div class="form-check form-switch">
                                    <input id="doctorProfileStatus" class="form-check-input" type="checkbox" @bind="editor.Activo" disabled="@(!CanModifyEditor || selfManagedMode)" />
                                    <label class="form-check-label" for="doctorProfileStatus">@((editor.Activo ? "Activa" : "Inactiva"))</label>
                                </div>
                            </div>
                        </div>
                    </details>
                </div>

                <details class="additional-details">
                    <summary><span><i class="bi bi-info-circle"></i> Mas detalles</span></summary>
                    <div class="additional-details-body is-single">
                        <div>
                            <label class="form-label" for="doctorBio">Biografia</label>
                            <textarea id="doctorBio" class="form-control" rows="3" @bind="editor.Biografia" readonly="@(!CanModifyEditor)"></textarea>
                        </div>

                        <div>
                            <label class="form-label" for="doctorCerts">Certificaciones</label>
                            <textarea id="doctorCerts" class="form-control" rows="3" @bind="editor.Certificaciones" readonly="@(!CanModifyEditor)"></textarea>
                        </div>

                        <div>
                            <label class="form-label" for="doctorObservations">Observaciones</label>
                            <textarea id="doctorObservations" class="form-control" rows="3" @bind="editor.Observaciones" readonly="@(!CanModifyEditor)"></textarea>
                        </div>
                    </div>
                </details>
            </div>
            <footer class="custom-modal-footer">
                <button type="button" class="btn btn-outline-primary" @onclick="CloseFormModal">Cancelar</button>
                @if (CanModifyEditor)
                {
                    <button type="button" class="btn btn-primary" @onclick="SaveDoctorWithHandlingAsync">Guardar cambios</button>
                }
            </footer>
        </div>
    </div>
}

@if (showAuditModal && selectedUser is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card audit-modal-card">
            <header class="custom-modal-header apricot-header">
                <h2>Historial de auditoria</h2>
                <button type="button" class="btn-close-modal" @onclick="CloseAuditModal">x</button>
            </header>
            <div class="custom-modal-body">
                <div style="margin-bottom: 1rem;">
                    <strong style="font-size: 1.1rem; color: var(--color-ink);">@GetFullName(selectedUser)</strong>
                    <span style="display: block; font-size: 0.85rem; color: var(--color-taupe);">@selectedUser.usuario</span>
                </div>

                @if (selectedUser.tbl_medico is null)
                {
                    <p>Este usuario aun no tiene ficha medica creada.</p>
                }
                else if (auditEntries.Count == 0)
                {
                    <p>No hay eventos registrados para este medico.</p>
                }
                else
                {
                    <div class="management-list">
                        @foreach (var auditEntry in auditEntries)
                        {
                            <article class="management-list-item" style="border: 1px solid rgba(127, 105, 81, 0.08); border-radius: 0.8rem; padding: 0.95rem; margin-bottom: 0.6rem; background: #faf8f4;">
                                <div style="display: flex; justify-content: space-between; margin-bottom: 0.35rem;">
                                    <strong style="color: var(--color-sage);">@auditEntry.accion</strong>
                                    <span style="font-size: 0.78rem; color: var(--color-taupe);">@(auditEntry.fecha?.ToString("yyyy-MM-dd HH:mm") ?? "Sin fecha")</span>
                                </div>
                                <div style="font-size: 0.82rem; color: var(--color-ink); margin-bottom: 0.35rem;">@auditEntry.detalle</div>
                                <span style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-taupe); opacity: 0.8;">@GetAuditActorLabel(auditEntry)</span>
                            </article>
                        }
                    </div>
                }
            </div>
            <footer class="custom-modal-footer">
                <button type="button" class="btn btn-primary" @onclick="CloseAuditModal">Cerrar</button>
            </footer>
        </div>
    </div>
}

@if (showAlertModal)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card alert-modal-card">
            <header class="custom-modal-header @(alertIsError ? "error-header" : "success-header")">
                <h2>@(alertIsError ? "Error de validacion" : "Operacion exitosa")</h2>
            </header>
            <div class="custom-modal-body" style="padding: 2rem 1.5rem; text-align: center;">
                <div style="font-size: 3rem; margin-bottom: 1rem; color: @(alertIsError ? "#7F6951" : "#5DA181")">
                    <i class="bi @(alertIsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")"></i>
                </div>
                <p style="font-size: 1rem; color: var(--color-ink); line-height: 1.5; margin: 0;">@alertMessage</p>
            </div>
            <footer class="custom-modal-footer" style="justify-content: center;">
                <button type="button" class="btn btn-primary" style="min-width: 120px;" @onclick="CloseAlertModal">Aceptar</button>
            </footer>
        </div>
    </div>
}

@code {
    private readonly List<tbl_usuario> medicalUsers = [];
    private readonly List<tbl_usuario> eligibleUsers = [];
    private readonly List<tbl_log_auditoria> auditEntries = [];
    private ModulePermissions permissions = new();
    private DoctorEditorModel? editor;
    private tbl_usuario? selectedUser;
    private bool isLoading = true;
    private bool canViewDoctors;
    private bool isCreatingNewDoctor;
    private bool isAdmin;
    private bool isMedicalRoleUser;
    private bool showFormModal;
    private bool showAuditModal;
    private bool showAlertModal;
    private int currentUserId;
    private int currentRoleId;
    private string currentUserName = string.Empty;
    private string currentRoleName = string.Empty;
    private string searchTerm = string.Empty;
    private string selectedProfileFilter = "all";
    private string selectedAccessFilter = "all";
    private string selectedRecordFilter = "all";
    private string alertMessage = string.Empty;
    private bool alertIsError;
    private string? errorMessage;

    private bool selfManagedMode => isMedicalRoleUser && !isAdmin;
    private bool CanCreateDoctorProfile => permissions.CanCreate && eligibleUsers.Any();
    private bool CanModifyEditor => editor is not null && (isCreatingNewDoctor ? permissions.CanCreate : permissions.CanEdit);
    private string HeroTitle => selfManagedMode ? "Completa y mantiene tu ficha medica" : "Gestion de medicos";
    private string HeroDescription => selfManagedMode
        ? "Desde aqui completas tu perfil profesional para quedar visible en citas, horarios y agenda del paciente."
        : "Administra medicos, valida que cada usuario con rol medico tenga su ficha profesional y controla si queda visible para agendamiento.";
    private string EditorTitle => isCreatingNewDoctor ? "Nueva ficha medica" : "Detalle del medico";
    private tbl_usuario? CurrentSelfUser => medicalUsers.FirstOrDefault(u => u.id_usuario == currentUserId);

    private List<tbl_usuario> FilteredUsers => medicalUsers
        .Where(MatchesFilters)
        .OrderBy(u => u.apellidos)
        .ThenBy(u => u.nombres)
        .ToList();
    private const int TablePageSize = 5;
    private int doctorPage = 1;
    private int EffectiveDoctorPage => Math.Min(doctorPage, Math.Max(1, (int)Math.Ceiling(FilteredUsers.Count / (double)TablePageSize)));
    private IEnumerable<tbl_usuario> PagedUsers => FilteredUsers.Skip((EffectiveDoctorPage - 1) * TablePageSize).Take(TablePageSize);
    private void SetDoctorPage(int page) => doctorPage = page;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync(int? preserveUserId = null)
    {
        isLoading = true;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var parsedUserId) ? parsedUserId : 0;
        currentRoleId = int.TryParse(authState.User.FindFirst("RoleId")?.Value, out var parsedRoleId) ? parsedRoleId : 0;
        currentRoleName = authState.User.FindFirst(ClaimTypes.Role)?.Value ?? string.Empty;
        currentUserName = authState.User.Identity?.Name ?? (currentUserId > 0 ? currentUserId.ToString() : "Sistema");
        isAdmin = currentRoleId == 1 || currentRoleName.Contains("admin", StringComparison.OrdinalIgnoreCase);
        isMedicalRoleUser = IsMedicalRoleName(currentRoleName);

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        permissions = await GetModulePermissionsAsync(dbContext, currentRoleId);
        canViewDoctors = permissions.CanView;

        medicalUsers.Clear();
        eligibleUsers.Clear();
        auditEntries.Clear();

        if (!canViewDoctors)
        {
            isLoading = false;
            return;
        }

        var loadedUsers = await dbContext.tbl_usuarios
            .AsNoTracking()
            .Include(u => u.id_rolNavigation)
            .Include(u => u.tbl_medico)
            .ToListAsync();

        var filteredUsers = loadedUsers
            .Where(u => u.tbl_medico is not null || IsMedicalRoleName(u.id_rolNavigation?.nombre))
            .Where(u => !selfManagedMode || u.id_usuario == currentUserId)
            .ToList();

        medicalUsers.AddRange(filteredUsers);
        eligibleUsers.AddRange(filteredUsers.Where(u => u.tbl_medico is null && IsMedicalRoleName(u.id_rolNavigation?.nombre)));

        if (preserveUserId.HasValue)
        {
            selectedUser = medicalUsers.FirstOrDefault(u => u.id_usuario == preserveUserId.Value);
            editor = BuildEditor(selectedUser);
        }

        isLoading = false;
    }

    private void PrepareNewDoctor()
    {
        errorMessage = null;
        isCreatingNewDoctor = true;
        selectedUser = null;
        auditEntries.Clear();

        var initialUser = selfManagedMode
            ? eligibleUsers.FirstOrDefault(u => u.id_usuario == currentUserId)
            : eligibleUsers.FirstOrDefault();

        if (initialUser is null)
        {
            ShowAlert("No hay usuarios con rol medico pendientes de completar ficha.", true);
            return;
        }

        editor = BuildNewEditor(initialUser);
        showFormModal = true;
    }

    private void PrepareEditDoctor(tbl_usuario user)
    {
        errorMessage = null;

        if (!CanManageUser(user))
        {
            ShowAlert("No tienes permiso para gestionar este medico.", true);
            return;
        }

        selectedUser = user;
        isCreatingNewDoctor = user.tbl_medico is null;
        editor = user.tbl_medico is null ? BuildNewEditor(user) : BuildEditor(user);
        showFormModal = true;
    }

    private async Task PrepareAuditDoctor(tbl_usuario user)
    {
        selectedUser = user;
        auditEntries.Clear();

        if (user.tbl_medico is not null)
        {
            await LoadAuditEntriesAsync(user.tbl_medico.id_medico);
        }

        showAuditModal = true;
    }

    private async Task SaveDoctorAsync()
    {
        errorMessage = null;

        if (!ValidateEditor())
        {
            ShowAlert(errorMessage ?? "Corrige los datos del formulario.", true);
            return;
        }

        var currentEditor = editor!;

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var userEntity = await dbContext.tbl_usuarios
            .Include(u => u.id_rolNavigation)
            .Include(u => u.tbl_medico)
            .FirstOrDefaultAsync(u => u.id_usuario == currentEditor.IdUsuario);

        if (userEntity is null)
        {
            ShowAlert("No se encontro el usuario seleccionado.", true);
            return;
        }

        if (!CanManageUser(userEntity))
        {
            ShowAlert("No tienes permiso para gestionar este medico.", true);
            return;
        }

        if (!IsMedicalRoleName(userEntity.id_rolNavigation?.nombre))
        {
            ShowAlert("El usuario seleccionado no tiene un rol medico asignado.", true);
            return;
        }

        if (await dbContext.tbl_medico.AnyAsync(m =>
                m.id_medico != currentEditor.IdMedico &&
                m.numero_licencia.ToLower() == currentEditor.NumeroLicencia.Trim().ToLower()))
        {
            ShowAlert("Ya existe un medico registrado con ese numero de licencia.", true);
            return;
        }

        var now = DateTime.Now;
        tbl_medico doctorEntity;

        if (isCreatingNewDoctor)
        {
            if (!permissions.CanCreate)
            {
                ShowAlert("Tu rol no tiene permiso para crear fichas medicas.", true);
                return;
            }

            if (userEntity.tbl_medico is not null)
            {
                ShowAlert("El usuario ya tiene una ficha medica asociada.", true);
                return;
            }

            doctorEntity = new tbl_medico
            {
                id_usuario = userEntity.id_usuario,
                fecha_creacion = now,
                usuario_creacion = currentUserName
            };

            dbContext.tbl_medico.Add(doctorEntity);
        }
        else
        {
            if (!permissions.CanEdit)
            {
                ShowAlert("Tu rol no tiene permiso para editar fichas medicas.", true);
                return;
            }

            doctorEntity = userEntity.tbl_medico
                ?? throw new InvalidOperationException("No se encontro la ficha medica seleccionada.");
        }

        doctorEntity.numero_licencia = currentEditor.NumeroLicencia.Trim();
        doctorEntity.especialidad = NormalizeOptional(currentEditor.Especialidad);
        doctorEntity.cedula_profesional = NormalizeOptional(currentEditor.CedulaProfesional);
        doctorEntity.institucion_egreso = NormalizeOptional(currentEditor.InstitucionEgreso);
        doctorEntity.anio_egreso = ParseOptionalInt(currentEditor.AnioEgreso);
        doctorEntity.telefono_consultorio = NormalizeOptional(currentEditor.TelefonoConsultorio);
        doctorEntity.biografia = NormalizeOptional(currentEditor.Biografia);
        doctorEntity.certificaciones = NormalizeOptional(currentEditor.Certificaciones);
        doctorEntity.idiomas = NormalizeOptional(currentEditor.Idiomas);
        doctorEntity.precio_consulta_base = ParseOptionalDecimal(currentEditor.PrecioConsultaBase);
        doctorEntity.descuento_porcentaje = ParseOptionalDecimal(currentEditor.DescuentoPorcentaje);
        doctorEntity.aceptar_citas_telefonicas = currentEditor.AceptarCitasTelefonicas;
        doctorEntity.aceptar_citas_presenciales = currentEditor.AceptarCitasPresenciales;
        doctorEntity.puede_gestionar_agenda = currentEditor.PuedeGestionarAgenda;
        doctorEntity.puede_gestionar_disponibilidad = currentEditor.PuedeGestionarDisponibilidad;
        doctorEntity.puede_gestionar_historia_clinica = currentEditor.PuedeGestionarHistoriaClinica;
        doctorEntity.puede_gestionar_facturacion = currentEditor.PuedeGestionarFacturacion;
        doctorEntity.duracion_consulta_minutos = ParseOptionalInt(currentEditor.DuracionConsultaMinutos);
        doctorEntity.observaciones = NormalizeOptional(currentEditor.Observaciones);
        doctorEntity.activo = selfManagedMode ? true : currentEditor.Activo;
        doctorEntity.fecha_actualizacion = now;
        doctorEntity.usuario_actualizacion = currentUserName;

        if (currentEditor.ChangePassword && !string.IsNullOrWhiteSpace(currentEditor.NewPassword))
        {
            userEntity.password_hash = PasswordHasher.HashPassword(userEntity, currentEditor.NewPassword.Trim());
            userEntity.ultimo_cambio_password = DateOnly.FromDateTime(DateTime.Today);
            userEntity.intentos_fallidos = 0;
            userEntity.bloqueado = false;
        }

        if (!string.IsNullOrWhiteSpace(currentEditor.LinkedUserEmail) && currentEditor.LinkedUserEmail.Trim() != (userEntity.email ?? string.Empty))
        {
            userEntity.email = currentEditor.LinkedUserEmail.Trim();
        }

        await dbContext.SaveChangesAsync();

        WriteAudit(
            dbContext,
            isCreatingNewDoctor ? "Crear ficha medica" : "Editar ficha medica",
            $"MedicoId={doctorEntity.id_medico}; UsuarioId={userEntity.id_usuario}; Licencia={doctorEntity.numero_licencia}; Especialidad={doctorEntity.especialidad ?? "Sin especialidad"}; Activo={(doctorEntity.activo == true ? "Si" : "No")}{(currentEditor.ChangePassword ? "; ClaveActualizada=Si" : "")}");

        await dbContext.SaveChangesAsync();

        ShowAlert(
            isCreatingNewDoctor ? "La ficha medica se creo correctamente." : "La ficha medica se guardo correctamente.",
            false);

        isCreatingNewDoctor = false;
        showFormModal = false;
        await LoadAsync(userEntity.id_usuario);
    }

    private async Task SaveDoctorWithHandlingAsync()
    {
        try
        {
            await SaveDoctorAsync();
        }
        catch (Exception ex)
        {
            errorMessage = GetInnermostMessage(ex);
        }
    }

    private async Task ToggleActiveAsync(tbl_usuario user)
    {
        if (!CanToggleDoctorProfile(user))
        {
            ShowAlert("No tienes permiso para activar o inactivar esta ficha medica.", true);
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var userEntity = await dbContext.tbl_usuarios
            .Include(u => u.tbl_medico)
            .FirstOrDefaultAsync(u => u.id_usuario == user.id_usuario);

        if (userEntity?.tbl_medico is null)
        {
            ShowAlert("No se encontro la ficha medica seleccionada.", true);
            return;
        }

        userEntity.tbl_medico.activo = !(userEntity.tbl_medico.activo == true);
        userEntity.tbl_medico.fecha_actualizacion = DateTime.Now;
        userEntity.tbl_medico.usuario_actualizacion = currentUserName;

        WriteAudit(
            dbContext,
            userEntity.tbl_medico.activo == true ? "Activar ficha medica" : "Inactivar ficha medica",
            $"MedicoId={userEntity.tbl_medico.id_medico}; UsuarioId={userEntity.id_usuario}; Activo={(userEntity.tbl_medico.activo == true ? "Si" : "No")}");

        await dbContext.SaveChangesAsync();

        ShowAlert(
            userEntity.tbl_medico.activo == true ? "La ficha medica fue activada correctamente." : "La ficha medica fue inactivada correctamente.",
            false);

        await LoadAsync(userEntity.id_usuario);
    }

    private async Task LoadAuditEntriesAsync(int doctorId)
    {
        var token = $"MedicoId={doctorId};";

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var entries = await dbContext.tbl_log_auditoria
            .AsNoTracking()
            .Include(a => a.id_usuarioNavigation)
            .Where(a => a.modulo == "Medicos" && a.detalle != null && a.detalle.Contains(token))
            .OrderByDescending(a => a.fecha)
            .Take(20)
            .ToListAsync();

        auditEntries.Clear();
        auditEntries.AddRange(entries);
    }

    private void OnEditorUserChanged(ChangeEventArgs args)
    {
        if (editor is null || !int.TryParse(args.Value?.ToString(), out var userId))
        {
            return;
        }

        var selected = eligibleUsers.FirstOrDefault(u => u.id_usuario == userId);
        if (selected is null)
        {
            return;
        }

        editor.IdUsuario = selected.id_usuario;
        editor.LinkedUserName = selected.usuario;
        editor.LinkedUserFullName = GetFullName(selected);
        editor.LinkedRoleName = selected.id_rolNavigation?.nombre ?? "Sin rol";
        editor.LinkedUserEmail = selected.email ?? string.Empty;
        editor.LinkedUserPhone = selected.telefono ?? string.Empty;
        editor.LinkedUserActive = selected.activo == true;
        editor.LinkedUserBlocked = selected.bloqueado == true;
        editor.LinkedUserLastPasswordChange = selected.ultimo_cambio_password;
        editor.LinkedUserCreationDate = selected.fecha_creacion;
    }

    private void CloseFormModal()
    {
        showFormModal = false;
        errorMessage = null;
    }

    private void CloseAuditModal()
    {
        showAuditModal = false;
    }

    private void ShowAlert(string message, bool isError)
    {
        alertMessage = message;
        alertIsError = isError;
        showAlertModal = true;
    }

    private static string GetInnermostMessage(Exception ex)
    {
        while (ex.InnerException is not null)
        {
            ex = ex.InnerException;
        }

        return ex.Message;
    }

    private void CloseAlertModal()
    {
        showAlertModal = false;
        alertMessage = string.Empty;
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        selectedProfileFilter = "all";
        selectedAccessFilter = "all";
        selectedRecordFilter = "all";
    }

    private bool MatchesFilters(tbl_usuario user)
    {
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var normalizedSearch = searchTerm.Trim().ToLowerInvariant();
            var fullName = GetFullName(user).ToLowerInvariant();
            var specialty = user.tbl_medico?.especialidad?.ToLowerInvariant() ?? string.Empty;
            var license = user.tbl_medico?.numero_licencia?.ToLowerInvariant() ?? string.Empty;

            if (!user.usuario.ToLowerInvariant().Contains(normalizedSearch) &&
                !fullName.Contains(normalizedSearch) &&
                !specialty.Contains(normalizedSearch) &&
                !license.Contains(normalizedSearch))
            {
                return false;
            }
        }

        if (selectedProfileFilter == "configured" && user.tbl_medico is null)
        {
            return false;
        }

        if (selectedProfileFilter == "pending" && user.tbl_medico is not null)
        {
            return false;
        }

        if (selectedProfileFilter == "available" && !IsAvailableForAppointments(user))
        {
            return false;
        }

        if (selectedAccessFilter == "active" && user.activo != true)
        {
            return false;
        }

        if (selectedAccessFilter == "inactive" && user.activo == true)
        {
            return false;
        }

        if (selectedRecordFilter == "active" && user.tbl_medico?.activo != true)
        {
            return false;
        }

        if (selectedRecordFilter == "inactive" && user.tbl_medico is not null && user.tbl_medico.activo == true)
        {
            return false;
        }

        if (selectedRecordFilter == "inactive" && user.tbl_medico is null)
        {
            return false;
        }

        return true;
    }

    private bool ValidateEditor()
    {
        if (editor is null)
        {
            errorMessage = "No hay un medico seleccionado.";
            return false;
        }

        editor.NumeroLicencia = editor.NumeroLicencia.Trim();
        editor.Especialidad = editor.Especialidad.Trim();
        editor.CedulaProfesional = editor.CedulaProfesional.Trim();
        editor.InstitucionEgreso = editor.InstitucionEgreso.Trim();
        editor.TelefonoConsultorio = editor.TelefonoConsultorio.Trim();
        editor.Idiomas = editor.Idiomas.Trim();
        editor.Biografia = editor.Biografia.Trim();
        editor.Certificaciones = editor.Certificaciones.Trim();
        editor.Observaciones = editor.Observaciones.Trim();

        if (editor.IdUsuario <= 0)
        {
            errorMessage = "Selecciona un usuario con rol medico.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(editor.NumeroLicencia))
        {
            errorMessage = "El numero de licencia es obligatorio.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(editor.Especialidad))
        {
            errorMessage = "La especialidad es obligatoria para mostrar correctamente al medico en agenda.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(editor.CedulaProfesional))
        {
            errorMessage = "La cédula profesional es obligatoria.";
            return false;
        }

        if (!AppValidation.IsDigitsOnly(editor.TelefonoConsultorio) || editor.TelefonoConsultorio.Length != 10)
        {
            errorMessage = "El teléfono del consultorio debe tener exactamente 10 dígitos y solo números.";
            return false;
        }

        if (!string.IsNullOrWhiteSpace(editor.AnioEgreso))
        {
            var currentYear = DateTime.Today.Year;
            if (!int.TryParse(editor.AnioEgreso, out var graduationYear) || graduationYear < 1980 || graduationYear > currentYear)
            {
                errorMessage = "El año de egreso debe estar entre 1980 y el año actual.";
                return false;
            }
        }

        if (string.IsNullOrWhiteSpace(editor.DuracionConsultaMinutos) || editor.DuracionConsultaMinutos is not ("15" or "30" or "60"))
        {
            errorMessage = "Selecciona una duración de consulta de 15, 30 o 60 minutos.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(editor.PrecioConsultaBase))
        {
            errorMessage = "El precio base es obligatorio.";
            return false;
        }

        if (!AppValidation.TryParseDecimal(editor.PrecioConsultaBase, out var basePrice) || basePrice < 0)
        {
            errorMessage = "El precio base no es valido.";
            return false;
        }

        if (!string.IsNullOrWhiteSpace(editor.DescuentoPorcentaje))
        {
            if (!decimal.TryParse(editor.DescuentoPorcentaje, out var discount) || discount < 0 || discount > 100)
            {
                errorMessage = "El descuento debe estar entre 0 y 100.";
                return false;
            }
        }

        if (editor.ChangePassword)
        {
            if (string.IsNullOrWhiteSpace(editor.NewPassword))
            {
                errorMessage = "Ingresa la nueva contraseña de inicio de sesión.";
                return false;
            }

            if (editor.NewPassword.Length < 6)
            {
                errorMessage = "La contraseña debe tener al menos 6 caracteres.";
                return false;
            }

            if (editor.NewPassword != editor.ConfirmPassword)
            {
                errorMessage = "Las contraseñas no coinciden.";
                return false;
            }
        }

        return true;
    }

    private async Task<ModulePermissions> GetModulePermissionsAsync(OpticaDbContext dbContext, int roleId)
    {
        if (roleId <= 0)
        {
            return new ModulePermissions();
        }

        var permission = await dbContext.tbl_rol_menu_permisos
            .AsNoTracking()
            .Where(p => p.id_rol == roleId)
            .Join(
                dbContext.tbl_menu_apps.AsNoTracking().Where(m => m.ruta == "/doctores"),
                rolePermission => rolePermission.id_menu,
                menu => menu.id_menu,
                (rolePermission, _) => rolePermission)
            .FirstOrDefaultAsync();

        return permission is null
            ? new ModulePermissions()
            : new ModulePermissions
            {
                CanView = permission.puede_ver,
                CanCreate = permission.puede_crear,
                CanEdit = permission.puede_editar,
                CanDelete = permission.puede_eliminar
            };
    }

    private bool CanManageUser(tbl_usuario user)
    {
        return !selfManagedMode || user.id_usuario == currentUserId;
    }

    private bool CanToggleDoctorProfile(tbl_usuario user)
    {
        return isAdmin && permissions.CanDelete && user.tbl_medico is not null;
    }

    private bool IsAvailableForAppointments(tbl_usuario user)
    {
        return user.activo == true && user.tbl_medico?.activo == true;
    }

    private static bool IsMedicalRoleName(string? roleName)
    {
        return !string.IsNullOrWhiteSpace(roleName) &&
               (roleName.Contains("doctor", StringComparison.OrdinalIgnoreCase) ||
                roleName.Contains("medic", StringComparison.OrdinalIgnoreCase) ||
                roleName.Contains("optomet", StringComparison.OrdinalIgnoreCase));
    }

    private static DoctorEditorModel BuildNewEditor(tbl_usuario user)
    {
        return new DoctorEditorModel
        {
            IdUsuario = user.id_usuario,
            LinkedUserName = user.usuario,
            LinkedUserFullName = GetFullName(user),
            LinkedRoleName = user.id_rolNavigation?.nombre ?? "Sin rol",
            LinkedUserEmail = user.email ?? string.Empty,
            LinkedUserPhone = user.telefono ?? string.Empty,
            LinkedUserActive = user.activo == true,
            LinkedUserBlocked = user.bloqueado == true,
            LinkedUserLastPasswordChange = user.ultimo_cambio_password,
            LinkedUserCreationDate = user.fecha_creacion,
            AceptarCitasTelefonicas = true,
            AceptarCitasPresenciales = true,
            PuedeGestionarAgenda = true,
            PuedeGestionarDisponibilidad = true,
            PuedeGestionarHistoriaClinica = true,
            DuracionConsultaMinutos = "30",
            Activo = true
        };
    }

    private static DoctorEditorModel? BuildEditor(tbl_usuario? user)
    {
        if (user?.tbl_medico is null)
        {
            return user is null ? null : BuildNewEditor(user);
        }

        return new DoctorEditorModel
        {
            IdMedico = user.tbl_medico.id_medico,
            IdUsuario = user.id_usuario,
            LinkedUserName = user.usuario,
            LinkedUserFullName = GetFullName(user),
            LinkedRoleName = user.id_rolNavigation?.nombre ?? "Sin rol",
            LinkedUserEmail = user.email ?? string.Empty,
            LinkedUserPhone = user.telefono ?? string.Empty,
            LinkedUserActive = user.activo == true,
            LinkedUserBlocked = user.bloqueado == true,
            LinkedUserLastPasswordChange = user.ultimo_cambio_password,
            LinkedUserCreationDate = user.fecha_creacion,
            NumeroLicencia = user.tbl_medico.numero_licencia,
            Especialidad = user.tbl_medico.especialidad ?? string.Empty,
            CedulaProfesional = user.tbl_medico.cedula_profesional ?? string.Empty,
            InstitucionEgreso = user.tbl_medico.institucion_egreso ?? string.Empty,
            AnioEgreso = user.tbl_medico.anio_egreso?.ToString() ?? string.Empty,
            TelefonoConsultorio = user.tbl_medico.telefono_consultorio ?? string.Empty,
            Biografia = user.tbl_medico.biografia ?? string.Empty,
            Certificaciones = user.tbl_medico.certificaciones ?? string.Empty,
            Idiomas = user.tbl_medico.idiomas ?? string.Empty,
            PrecioConsultaBase = user.tbl_medico.precio_consulta_base?.ToString("0.##") ?? string.Empty,
            DescuentoPorcentaje = user.tbl_medico.descuento_porcentaje?.ToString("0.##") ?? string.Empty,
            AceptarCitasTelefonicas = user.tbl_medico.aceptar_citas_telefonicas != false,
            AceptarCitasPresenciales = user.tbl_medico.aceptar_citas_presenciales != false,
            PuedeGestionarAgenda = user.tbl_medico.puede_gestionar_agenda != false,
            PuedeGestionarDisponibilidad = user.tbl_medico.puede_gestionar_disponibilidad != false,
            PuedeGestionarHistoriaClinica = user.tbl_medico.puede_gestionar_historia_clinica != false,
            PuedeGestionarFacturacion = user.tbl_medico.puede_gestionar_facturacion == true,
            DuracionConsultaMinutos = user.tbl_medico.duracion_consulta_minutos?.ToString() ?? "30",
            Observaciones = user.tbl_medico.observaciones ?? string.Empty,
            Activo = user.tbl_medico.activo != false
        };
    }

    private static string GetFullName(tbl_usuario user)
    {
        return $"{user.nombres} {user.apellidos}".Trim();
    }

    private static string GetAuditActorLabel(tbl_log_auditoria auditEntry)
    {
        return auditEntry.id_usuarioNavigation is null
            ? "Responsable: Sistema"
            : $"Responsable: {auditEntry.id_usuarioNavigation.usuario}";
    }

    private static string? NormalizeOptional(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }

    private static int? ParseOptionalInt(string? value)
    {
        return int.TryParse(value, out var parsed) ? parsed : null;
    }

    private static decimal? ParseOptionalDecimal(string? value)
    {
        return decimal.TryParse(value, out var parsed) ? parsed : null;
    }

    private void WriteAudit(OpticaDbContext dbContext, string action, string detail)
    {
        dbContext.tbl_log_auditoria.Add(new tbl_log_auditoria
        {
            id_usuario = currentUserId > 0 ? currentUserId : null,
            accion = action,
            modulo = "Medicos",
            fecha = DateTime.Now,
            detalle = detail
        });
    }

