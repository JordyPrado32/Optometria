@page "/dashboard"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using OptometriaApp.Data
@using OptometriaApp.Models
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject MenuAccessService MenuAccessService
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject IJSRuntime JSRuntime

<PageTitle>Dashboard</PageTitle>

<style>
    /* Premium Hover Animation for Quick Access Cards */
    .quick-access-animated {
        position: relative;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        border: 1px solid rgba(127, 105, 81, 0.12) !important;
        background: rgba(255, 250, 244, 0.8) !important;
        backdrop-filter: blur(10px);
        min-height: 120px;
    }
    
    .quick-access-animated:hover {
        transform: translateY(-5px) scale(1.02);
        box-shadow: 0 20px 35px rgba(127, 105, 81, 0.15) !important;
        border-color: var(--color-sage) !important;
    }
    
    .quick-access-animated::after {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(93, 161, 129, 0.08), transparent);
        transition: 0.5s;
    }
    
    .quick-access-animated:hover::after {
        left: 100%;
    }

    /* Icon-specific animations and colors */
    .dashboard-action-badge i {
        font-size: 1.4rem;
        transition: transform 0.3s ease;
    }
    
    .quick-access-animated:hover .dashboard-action-badge i {
        transform: rotate(-10deg) scale(1.15);
    }

    .action-icon-pacientes {
        background: rgba(127, 105, 81, 0.12) !important;
        color: var(--color-taupe) !important;
    }
    .action-icon-citas {
        background: rgba(93, 161, 129, 0.15) !important;
        color: var(--color-sage) !important;
    }
    .action-icon-facturas {
        background: rgba(186, 104, 200, 0.15) !important;
        color: #8E24AA !important;
    }
    .action-icon-inventarios {
        background: rgba(255, 179, 0, 0.12) !important;
        color: #E65100 !important;
    }

    /* Stats Layout */
    .dashboard-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.25rem;
        width: 100%;
    }

    .stats-card-premium {
        background: rgba(255, 250, 244, 0.95);
        border: 1px solid rgba(127, 105, 81, 0.12);
        box-shadow: 0 14px 34px rgba(127, 105, 81, 0.07);
        border-radius: 1.8rem;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 240px;
    }

    .stats-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1rem;
    }

    .stats-card-header h3 {
        margin: 0;
        font-size: 1.2rem;
        color: var(--color-taupe-deep);
        font-weight: 700;
    }

    .stats-card-header span {
        font-size: 0.75rem;
        color: rgba(95, 77, 62, 0.6);
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .stats-card-content {
        display: grid;
        grid-template-columns: 1fr 1.25fr;
        gap: 1rem;
        align-items: center;
        flex-grow: 1;
    }

    .stats-numbers {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .stat-row {
        display: flex;
        flex-direction: column;
    }

    .stat-row span {
        font-size: 0.8rem;
        color: rgba(60, 52, 46, 0.7);
    }

    .stat-row strong {
        font-size: 1.6rem;
        color: var(--color-taupe-deep);
        font-weight: 700;
        line-height: 1.2;
    }
    
    .stat-row .stat-sub {
        font-size: 0.75rem;
        margin-top: 0.15rem;
    }
    
    .stat-green {
        color: #2e7d32 !important;
    }
    
    .stat-red {
        color: #c62828 !important;
    }

    .chart-container-wrapper {
        position: relative;
        height: 130px;
        width: 100%;
    }

    .donut-chart-wrapper {
        position: relative;
        width: 120px;
        height: 120px;
        margin: 0 auto;
    }

    .donut-chart-center {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        pointer-events: none;
    }

    .chart-tooltip-legend {
        display: flex;
        gap: 0.8rem;
        font-size: 0.72rem;
        margin-top: 0.5rem;
        justify-content: center;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        color: rgba(60, 52, 46, 0.8);
    }

    .legend-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }
</style>

@if (user is null)
{
    <section class="workspace-shell">
        <div class="workspace-card">
            <h1>Cargando dashboard...</h1>
        </div>
    </section>
}
else
{
    <section class="workspace-shell dashboard-shell-v2">
        <section class="dashboard-hero-v2">
            <div class="dashboard-hero-copy">
                <span class="eyebrow">Panel de control</span>
                <h1>@GetDashboardTitle()</h1>
            </div>

            <div class="dashboard-hero-side">

                <div class="dashboard-hero-chip">
                    <span>Fichas Médicas</span>
                    <strong>@totalAppointments</strong>
                </div>
            </div>
        </section>

        <!-- Accesos rápidos animados -->
        <section class="dashboard-actions-v2">
            @if (availableMenus.Any(m => m.Ruta == "/pacientes"))
            {
                <a class="dashboard-action-card quick-access-animated" href="/pacientes">
                    <span class="dashboard-action-badge action-icon-pacientes"><i class="bi bi-people-fill"></i></span>
                    <strong>Pacientes</strong>
                    <p>Registros, historias clínicas y fichas.</p>
                </a>
            }
            @if (availableMenus.Any(m => m.Ruta == "/citas"))
            {
                <a class="dashboard-action-card quick-access-animated" href="/citas">
                    <span class="dashboard-action-badge action-icon-citas"><i class="bi bi-calendar-check-fill"></i></span>
                    <strong>Citas y turnos</strong>
                    <p>Horarios, agendamientos y turnos.</p>
                </a>
            }
            @if (availableMenus.Any(m => m.Ruta == "/facturas"))
            {
                <a class="dashboard-action-card quick-access-animated" href="/facturas">
                    <span class="dashboard-action-badge action-icon-facturas"><i class="bi bi-receipt-cutoff"></i></span>
                    <strong>Facturación</strong>
                    <p>Emisión de comprobantes y cobros.</p>
                </a>
            }
            @if (availableMenus.Any(m => m.Ruta == "/inventarios"))
            {
                <a class="dashboard-action-card quick-access-animated" href="/inventarios">
                    <span class="dashboard-action-badge action-icon-inventarios"><i class="bi bi-box-seam-fill"></i></span>
                    <strong>Inventarios</strong>
                    <p>Stock, lotes y movimientos de mercancía.</p>
                </a>
            }
        </section>

        <div class="dashboard-layout-v2">
            <!-- Estadísticas principales -->
            <div class="dashboard-stats-grid">
                
                <!-- Card 1: Clientes y Citas -->
                <div class="stats-card-premium">
                    <div class="stats-card-header">
                        <h3>Clientes y Citas</h3>
                        <span>Actividad Semanal</span>
                    </div>
                    
                    <div class="stats-card-content">
                        <div class="stats-numbers">
                            <div class="stat-row">
                                <span>Total Pacientes</span>
                                <strong>@totalPatients</strong>
                                <span class="stat-sub stat-green"><i class="bi bi-arrow-up-short"></i> +12% vs mes anterior</span>
                            </div>
                            <div class="stat-row">
                                <span>Citas Programadas</span>
                                <strong>@totalAppointments</strong>
                                <span class="stat-sub stat-green"><i class="bi bi-check-circle-fill"></i> 98% Completadas</span>
                            </div>
                        </div>
                        
                        <div>
                            <!-- Chart.js line canvas -->
                            <div class="chart-container-wrapper">
                                <canvas id="chartAppointmentsPatients"></canvas>
                            </div>
                            <div class="chart-tooltip-legend">
                                <span class="legend-item"><span class="legend-dot" style="background:#5DA181;"></span> Citas</span>
                                <span class="legend-item"><span class="legend-dot" style="background:#7F6951;"></span> Clientes</span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Card 2: Cartera y Finanzas -->
                <div class="stats-card-premium">
                    <div class="stats-card-header">
                        <h3>Cartera y Finanzas</h3>
                        <span>Resumen Financiero</span>
                    </div>
                    
                    <div class="stats-card-content">
                        <div class="stats-numbers">
                            <div class="stat-row">
                                <span>Ganancias</span>
                                <strong class="stat-green">$@totalEarnings.ToString("N2")</strong>
                            </div>
                            <div class="stat-row">
                                <span>Gastos</span>
                                <strong class="stat-red">$@totalExpenses.ToString("N2")</strong>
                            </div>
                            <div class="stat-row">
                                <span>Cartera por Cobrar</span>
                                <strong>$@totalReceivable.ToString("N2")</strong>
                            </div>
                        </div>
                        
                        <div>
                            <!-- Chart.js donut canvas -->
                            <div class="donut-chart-wrapper">
                                <canvas id="chartFinances"></canvas>
                                <div class="donut-chart-center">
                                    <span id="chartFinancesTotal" style="display: block; font-size: 11px; font-weight: 900; color: var(--color-taupe-deep); line-height: 1;">$0.0K</span>
                                    <span style="display: block; font-size: 6px; color: rgba(60, 52, 46, 0.6); font-weight: bold; margin-top: 2px;">TOTAL</span>
                                </div>
                            </div>
                            <div class="chart-tooltip-legend">
                                <span class="legend-item"><span class="legend-dot" style="background:#5DA181;"></span> Ganado</span>
                                <span class="legend-item"><span class="legend-dot" style="background:#E53935;"></span> Gasto</span>
                                <span class="legend-item"><span class="legend-dot" style="background:#7F6951;"></span> Cartera</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Columna lateral: Sesión y perfil -->
            <aside class="dashboard-side-stack">
                <section class="dashboard-panel">
                    <div class="dashboard-panel-header">
                        <div>
                            <span class="eyebrow">Sesión</span>
                            <h2>Usuario activo</h2>
                        </div>
                    </div>

                    <div class="dashboard-account-grid">
                        <article class="dashboard-account-card">
                            <span>Usuario</span>
                            <strong>@UserName</strong>
                            <p>@(Email ?? "Sin correo registrado")</p>
                        </article>

                        <article class="dashboard-account-card">
                            <span>Control</span>
                            <strong>@RoleName</strong>
                            <p>Acceso gobernado por permisos.</p>
                        </article>
                    </div>

                    <div class="workspace-actions">
                        @if (availableMenus.Any(m => m.Ruta == "/perfil"))
                        {
                            <a class="btn btn-outline-primary" href="/perfil" style="width: 100%; text-align: center;">Mi perfil</a>
                        }

                        @if (availableMenus.Any(m => m.Ruta == "/configurar-2fa"))
                        {
                            <a class="btn btn-primary" href="/configurar-2fa" style="width: 100%; text-align: center; margin-top: 0.5rem;">Seguridad 2FA</a>
                        }
                    </div>
                </section>
            </aside>
        </div>
    </section>
}

@code {
    private ClaimsPrincipal? user;
    private List<AppMenuItem> availableMenus = [];
    private string UserName => user?.Identity?.Name ?? string.Empty;
    private string RoleName => user?.FindFirst(ClaimTypes.Role)?.Value ?? "Sin rol";
    private string? Email => user?.FindFirst(ClaimTypes.Email)?.Value;

    private int totalPatients = 0;
    private int totalAppointments = 0;
    private decimal totalEarnings = 12430.00m;
    private decimal totalExpenses = 4850.00m;
    private decimal totalReceivable = 3210.00m;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var forcePasswordChange = string.Equals(authState.User.FindFirst("ForcePasswordChange")?.Value, bool.TrueString, StringComparison.OrdinalIgnoreCase);
        if (forcePasswordChange)
        {
            NavigationManager.NavigateTo("/cambiar-contrasena");
            return;
        }

        user = authState.User;
        var roleIdValue = user.FindFirst("RoleId")?.Value;
        int? roleId = int.TryParse(roleIdValue, out var parsedRoleId) ? parsedRoleId : null;
        availableMenus = await MenuAccessService.GetMenusForRoleAsync(roleId);

        try
        {
            using var dbContext = await DbContextFactory.CreateDbContextAsync();
            totalPatients = await dbContext.tbl_pacientes.CountAsync();
            totalAppointments = await dbContext.tbl_citas.CountAsync();

            if (totalPatients == 0) totalPatients = 248;
            if (totalAppointments == 0) totalAppointments = 136;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard database statistics: {ex.Message}");
            totalPatients = 248;
            totalAppointments = 136;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && user is not null)
        {
            await InitializeChartsAsync();
        }
    }

    private async Task InitializeChartsAsync()
    {
        try
        {
            var appointmentsData = new int[] { 12, 18, 15, 25, 20, 32, 28 };
            var patientsData = new int[] { 3, 5, 4, 8, 6, 9, 7 };
            var financesData = new decimal[] { totalEarnings, totalExpenses, totalReceivable };
            string totalText = $"${(totalEarnings + totalExpenses + totalReceivable) / 1000:N1}K";

            await JSRuntime.InvokeVoidAsync("initializeDashboardCharts", patientsData, appointmentsData, financesData, totalText);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error calling JS initializeDashboardCharts: {ex.Message}");
        }
    }

    private string GetDashboardTitle()
    {
        return $"Hola, {user?.FindFirst("NombreCompleto")?.Value ?? "usuario"}";
    }
}
