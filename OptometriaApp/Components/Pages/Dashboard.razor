@page "/dashboard"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using OptometriaApp.Data
@using OptometriaApp.Models
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject MenuAccessService MenuAccessService
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject IJSRuntime JSRuntime

<PageTitle>Dashboard</PageTitle>

<style>
    /* Premium highlight for Quick Access Cards */
    .quick-access-animated {
        position: relative;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        border: 1px solid rgba(127, 105, 81, 0.12) !important;
        background: rgba(255, 250, 244, 0.8) !important;
        backdrop-filter: blur(10px);
        min-height: 120px;
    }

    .quick-access-animated > * {
        position: relative;
        z-index: 1;
    }
    
    .quick-access-animated:hover {
        transform: translateY(-5px) scale(1.02);
        box-shadow: 0 20px 35px rgba(127, 105, 81, 0.15) !important;
        border-color: var(--color-sage) !important;
    }
    
    .quick-access-animated::after {
        content: '';
        position: absolute;
        top: -35%;
        right: -18%;
        width: 58%;
        height: 100%;
        background: linear-gradient(135deg, transparent 0%, rgba(93, 161, 129, 0.16) 34%, rgba(254, 188, 100, 0.2) 52%, rgba(236, 204, 197, 0.16) 72%, transparent 100%);
        transform: rotate(18deg);
        opacity: 1;
        transition: transform 0.3s ease, opacity 0.3s ease;
        pointer-events: none;
    }
    
    .quick-access-animated:hover::after {
        opacity: 1;
        transform: rotate(18deg) translateX(-8px);
    }

    /* Icon-specific animations and colors */
    .dashboard-action-badge i {
        font-size: 1.4rem;
        transition: transform 0.3s ease;
    }
    
    .quick-access-animated:hover .dashboard-action-badge i {
        transform: rotate(-10deg) scale(1.15);
    }

    .action-icon-pacientes {
        background: rgba(127, 105, 81, 0.12) !important;
        color: var(--color-taupe) !important;
    }
    .action-icon-citas {
        background: rgba(93, 161, 129, 0.15) !important;
        color: var(--color-sage) !important;
    }
    .action-icon-facturas {
        background: rgba(186, 104, 200, 0.15) !important;
        color: #8E24AA !important;
    }
    .action-icon-inventarios {
        background: rgba(255, 179, 0, 0.12) !important;
        color: #E65100 !important;
    }

    /* Stats Layout */
    .dashboard-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.25rem;
        width: 100%;
    }

    .stats-card-premium {
        background: rgba(255, 250, 244, 0.95);
        border: 1px solid rgba(127, 105, 81, 0.12);
        box-shadow: 0 14px 34px rgba(127, 105, 81, 0.07);
        border-radius: 1.8rem;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 240px;
        min-width: 0;
        container-type: inline-size;
        overflow: hidden;
    }

    .stats-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1rem;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .stats-card-header h3 {
        margin: 0;
        font-size: 1.2rem;
        color: var(--color-taupe-deep);
        font-weight: 700;
    }

    .stats-card-header span {
        font-size: 0.75rem;
        color: rgba(95, 77, 62, 0.6);
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .stats-card-content {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1rem;
        align-items: start;
        flex-grow: 1;
        min-width: 0;
    }

    .stats-numbers {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: 1rem;
    }

    .stat-row {
        display: flex;
        flex-direction: column;
    }

    .stat-row span {
        font-size: 0.8rem;
        color: rgba(60, 52, 46, 0.7);
    }

    .stat-row strong {
        font-size: 1.6rem;
        color: var(--color-taupe-deep);
        font-weight: 700;
        line-height: 1.2;
        overflow-wrap: anywhere;
    }
    
    .stat-row .stat-sub {
        font-size: 0.75rem;
        margin-top: 0.15rem;
    }
    
    .stat-green {
        color: #2e7d32 !important;
    }
    
    .stat-red {
        color: #c62828 !important;
    }

    .chart-container-wrapper {
        position: relative;
        height: 190px;
        width: 100%;
        max-width: 100%;
        min-width: 0;
        overflow: hidden;
    }

    .chart-container-wrapper canvas,
    .donut-chart-wrapper canvas {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        height: 100% !important;
    }

    .donut-chart-wrapper {
        position: relative;
        width: 120px;
        height: 120px;
        margin: 0 auto;
        border-radius: 50%;
        background: var(--finance-ring, conic-gradient(#5DA181 0deg 120deg, #E53935 120deg 180deg, #7F6951 180deg 360deg));
        box-shadow: inset 0 0 0 1px rgba(127, 105, 81, 0.08);
    }

    .donut-chart-wrapper::before {
        content: '';
        position: absolute;
        inset: 26px;
        border-radius: 50%;
        background: #FFFDF9;
        box-shadow: inset 0 0 0 1px rgba(127, 105, 81, 0.06);
        z-index: 0;
    }

    .donut-chart-wrapper canvas {
        position: relative;
        z-index: 1;
    }

    .donut-chart-center {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        pointer-events: none;
    }

    .chart-tooltip-legend {
        display: flex;
        gap: 0.8rem;
        font-size: 0.72rem;
        margin-top: 0.5rem;
        justify-content: center;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        color: rgba(60, 52, 46, 0.8);
        white-space: normal;
    }

    .legend-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex: 0 0 auto;
    }

    .dashboard-account-card {
        min-width: 0;
    }

    .dashboard-account-card p,
    .dashboard-account-card strong {
        max-width: 100%;
        min-width: 0;
        overflow-wrap: anywhere;
        word-break: break-word;
        white-space: normal;
    }

    @@container (max-width: 480px) {
        .stats-card-content {
            grid-template-columns: 1fr;
            align-items: start;
        }

        .stats-numbers {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        }

        .chart-container-wrapper {
            height: 160px;
        }
    }

    @@media (max-width: 1500px) {
        .dashboard-layout-v2 {
            grid-template-columns: 1fr;
        }

        .dashboard-account-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 900px) {
        .dashboard-stats-grid,
        .dashboard-account-grid {
            grid-template-columns: 1fr;
        }

        .stats-card-premium {
            padding: 1.1rem;
        }
    }
</style>

@if (user is null)
{
    <section class="workspace-shell">
        <div class="workspace-card">
            <h1>Cargando dashboard...</h1>
        </div>
    </section>
}
else
{
    <section class="workspace-shell dashboard-shell-v2">
        <section class="dashboard-hero-v2">
            <div class="dashboard-hero-copy">
                <span class="eyebrow">Panel de control</span>
                <h1>@GetDashboardTitle()</h1>
            </div>

            <div class="dashboard-hero-side">

                <div class="dashboard-hero-chip">
                    <span>Fichas Médicas</span>
                    <strong>@totalAppointments</strong>
                </div>
                @if (readyForPickupCount > 0)
                {
                    <div class="dashboard-hero-chip" style="background: rgba(255, 224, 102, 0.28); border-color: rgba(255, 193, 7, 0.35);">
                        <span>Pedidos listos</span>
                        <strong>@readyForPickupCount</strong>
                    </div>
                }
            </div>
        </section>

        <!-- Accesos rápidos animados -->
        <section class="dashboard-actions-v2">
            @if (availableMenus.Any(m => m.Ruta == "/pacientes"))
            {
                <a class="dashboard-action-card quick-access-animated" href="/pacientes">
                    <span class="dashboard-action-badge action-icon-pacientes"><i class="bi bi-people-fill"></i></span>
                    <strong>Pacientes</strong>
                    <p>Registros, historias clínicas y fichas.</p>
                </a>
            }
            @if (availableMenus.Any(m => m.Ruta == "/citas"))
            {
                <a class="dashboard-action-card quick-access-animated" href="/citas">
                    <span class="dashboard-action-badge action-icon-citas"><i class="bi bi-calendar-check-fill"></i></span>
                    <strong>Citas y turnos</strong>
                    <p>Horarios, agendamientos y turnos.</p>
                </a>
            }
            @if (availableMenus.Any(m => m.Ruta == "/facturas"))
            {
                <a class="dashboard-action-card quick-access-animated" href="/facturas">
                    <span class="dashboard-action-badge action-icon-facturas"><i class="bi bi-receipt-cutoff"></i></span>
                    <strong>Facturación</strong>
                    <p>Emisión de comprobantes y cobros.</p>
                </a>
            }
            @if (availableMenus.Any(m => m.Ruta == "/inventarios"))
            {
                <a class="dashboard-action-card quick-access-animated" href="/inventarios">
                    <span class="dashboard-action-badge action-icon-inventarios"><i class="bi bi-box-seam-fill"></i></span>
                    <strong>Inventarios</strong>
                    <p>Stock, lotes y movimientos de mercancía.</p>
                </a>
            }
        </section>



        <div class="dashboard-layout-v2">
            <!-- Estadísticas principales -->
            <div class="dashboard-stats-grid">
                
                <!-- Card 1: Clientes y Citas -->
                <div class="stats-card-premium">
                    <div class="stats-card-header">
                        <h3>Clientes y Citas</h3>
                        <span>Resumen real</span>
                    </div>
                    
                    <div class="stats-card-content">
                        <div>
                            <div class="chart-container-wrapper">
                                <canvas id="chartAppointmentsPatients"></canvas>
                            </div>
                        </div>

                        <div class="stats-numbers">
                            <div class="stat-row">
                                <span>Total Pacientes</span>
                                <strong>@totalPatients</strong>
                                <span class="stat-sub @(patientMonthlyChange >= 0 ? "stat-green" : "stat-red")">
                                    <i class="bi @(patientMonthlyChange >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short")"></i>
                                    @FormatPercentage(patientMonthlyChange) vs mes anterior
                                </span>
                            </div>
                            <div class="stat-row">
                                <span>Citas Programadas</span>
                                <strong>@totalAppointments</strong>
                                <span class="stat-sub stat-green"><i class="bi bi-check-circle-fill"></i> @appointmentCompletionRate.ToString("0.#")% realizadas</span>
                            </div>
                            <div class="stat-row">
                                <span>Citas Confirmadas</span>
                                <strong class="stat-green">@confirmedAppointments</strong>
                                <span class="stat-sub">Confirmadas actualmente</span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Card 2: Cartera y Finanzas -->
                <div class="stats-card-premium">
                    <div class="stats-card-header">
                        <h3>Cartera y Finanzas</h3>
                        <span>Resumen Financiero</span>
                    </div>
                    
                    <div class="stats-card-content">
                        <div>
                            <div class="donut-chart-wrapper" style="@GetFinanceRingStyle()">
                                <canvas id="chartFinances"></canvas>
                                <div class="donut-chart-center">
                                    <span id="chartFinancesTotal" style="display: block; font-size: 11px; font-weight: 900; color: var(--color-taupe-deep); line-height: 1;">$0.0K</span>
                                    <span style="display: block; font-size: 6px; color: rgba(60, 52, 46, 0.6); font-weight: bold; margin-top: 2px;">TOTAL</span>
                                </div>
                            </div>
                            <div class="chart-tooltip-legend">
                                <span class="legend-item"><span class="legend-dot" style="background:#5DA181;"></span> Ganado</span>
                                <span class="legend-item"><span class="legend-dot" style="background:#E53935;"></span> Gasto</span>
                                <span class="legend-item"><span class="legend-dot" style="background:#7F6951;"></span> Cartera</span>
                            </div>
                        </div>

                        <div class="stats-numbers">
                            <div class="stat-row">
                                <span>Ganancias</span>
                                <strong class="stat-green">$@totalEarnings.ToString("N2")</strong>
                            </div>
                            <div class="stat-row">
                                <span>Gastos</span>
                                <strong class="stat-red">$@totalExpenses.ToString("N2")</strong>
                            </div>
                            <div class="stat-row">
                                <span>Cartera por Cobrar</span>
                                <strong>$@totalReceivable.ToString("N2")</strong>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Columna lateral: Sesión y perfil -->
            <aside class="dashboard-side-stack">
                <section class="dashboard-panel">
                    <div class="dashboard-panel-header">
                        <div>
                            <span class="eyebrow">Sesión</span>
                            <h2>Usuario activo</h2>
                        </div>
                    </div>

                    <div class="dashboard-account-grid">
                        <article class="dashboard-account-card">
                            <span>Usuario</span>
                            <strong>@UserName</strong>
                            <p>@(Email ?? "Sin correo registrado")</p>
                        </article>

                        <article class="dashboard-account-card">
                            <span>Control</span>
                            <strong>@RoleName</strong>
                            <p>Acceso gobernado por permisos.</p>
                        </article>
                    </div>

                    <div class="workspace-actions">
                        @if (availableMenus.Any(m => m.Ruta == "/perfil"))
                        {
                            <a class="btn btn-outline-primary" href="/perfil" style="width: 100%; text-align: center;">Mi perfil</a>
                        }

                        @if (availableMenus.Any(m => m.Ruta == "/configurar-2fa"))
                        {
                            <a class="btn btn-primary" href="/configurar-2fa" style="width: 100%; text-align: center; margin-top: 0.5rem;">Seguridad 2FA</a>
                        }
                    </div>
                </section>

                @if (readyForPickupCount > 0)
                {
                    <section class="dashboard-panel" style="border: 1px solid rgba(255, 193, 7, 0.28); background: linear-gradient(180deg, rgba(255, 248, 215, 0.92), rgba(255,255,255,0.98));">
                        <div class="dashboard-panel-header">
                            <div>
                                <span class="eyebrow">Alerta operativa</span>
                                <h2>Pedidos listos para entrega</h2>
                            </div>
                        </div>

                        <article class="dashboard-account-card">
                            <span>Pendientes</span>
                            <strong style="font-size: 2rem; color: #8a6a00;">@readyForPickupCount</strong>
                            <p>Hay pedidos en estado listo para entrega esperando gestion del personal.</p>
                        </article>

                        @if (availableMenus.Any(m => m.Ruta == "/envios-laboratorio"))
                        {
                            <div class="workspace-actions">
                                <a class="btn btn-outline-primary" href="/envios-laboratorio" style="width: 100%; text-align: center;">Revisar envios</a>
                            </div>
                        }
                    </section>
                }
            </aside>
        </div>
    </section>
}

@code {
    private ClaimsPrincipal? user;
    private List<AppMenuItem> availableMenus = [];
    private string UserName => user?.Identity?.Name ?? string.Empty;
    private string RoleName => user?.FindFirst(ClaimTypes.Role)?.Value ?? "Sin rol";
    private string? Email => user?.FindFirst(ClaimTypes.Email)?.Value;

    private int totalPatients = 0;
    private int totalAppointments = 0;
    private int confirmedAppointments;
    private decimal totalEarnings;
    private decimal totalExpenses;
    private decimal totalReceivable;
    private decimal patientMonthlyChange;
    private decimal appointmentCompletionRate;
    private int readyForPickupCount;
    private decimal cashCollected;
    private decimal otherCollected;
    private int todayConsultations;
    private int pendingCollectionCount;
    private int lowStockAlertCount;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var forcePasswordChange = string.Equals(authState.User.FindFirst("ForcePasswordChange")?.Value, bool.TrueString, StringComparison.OrdinalIgnoreCase);
        if (forcePasswordChange)
        {
            NavigationManager.NavigateTo("/cambiar-contrasena");
            return;
        }

        user = authState.User;
        var roleIdValue = user.FindFirst("RoleId")?.Value;
        int? roleId = int.TryParse(roleIdValue, out var parsedRoleId) ? parsedRoleId : null;
        availableMenus = await MenuAccessService.GetMenusForRoleAsync(roleId);

        try
        {
            using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var today = DateTime.Today;
            totalPatients = await dbContext.tbl_pacientes.CountAsync();
            totalAppointments = await dbContext.tbl_citas.CountAsync();
            confirmedAppointments = await dbContext.tbl_citas.CountAsync(x =>
                x.id_estadoNavigation != null && x.id_estadoNavigation.nombre_estado == "Confirmada");
            totalEarnings = await dbContext.tbl_venta
                .Where(x => x.estado == null || (x.estado != "Anulada" && x.estado != "Cancelada"))
                .SumAsync(x => x.total ?? 0m);
            totalExpenses = await dbContext.tbl_liquidacion_compra
                .Where(x => x.activo != false && x.estado_liquidacion != "Anulada")
                .SumAsync(x => x.total ?? 0m);
            totalReceivable = await dbContext.tbl_cta_cobrar
                .Where(x => x.saldo > 0 && x.estado != "Pagada")
                .SumAsync(x => x.saldo);
            pendingCollectionCount = await dbContext.tbl_cta_cobrar.CountAsync(x => x.saldo > 0 && x.estado != "Pagada");
            readyForPickupCount = await dbContext.tbl_envio_laboratorios.CountAsync(x =>
                x.estado != null && x.estado.ToLower().Contains("listo"));
            todayConsultations = await dbContext.tbl_consulta.CountAsync(x => x.fecha_consulta.HasValue && x.fecha_consulta.Value.Date == today);
            lowStockAlertCount = await dbContext.tbl_productos.CountAsync(x => (x.stock_minimo ?? 0) > 0 && (x.stock_actual ?? 0) <= (x.stock_minimo ?? 0));
            cashCollected = await dbContext.tbl_venta
                .Where(x => (x.estado == null || (x.estado != "Anulada" && x.estado != "Cancelada")) &&
                            x.forma_pago != null &&
                            x.forma_pago.ToLower().Contains("efectivo"))
                .SumAsync(x => x.valor_cobrado ?? 0m);
            otherCollected = await dbContext.tbl_venta
                .Where(x => (x.estado == null || (x.estado != "Anulada" && x.estado != "Cancelada")) &&
                            (x.forma_pago == null || !x.forma_pago.ToLower().Contains("efectivo")))
                .SumAsync(x => x.valor_cobrado ?? 0m);

            var currentMonthStart = new DateTime(today.Year, today.Month, 1);
            var previousMonthStart = currentMonthStart.AddMonths(-1);
            var currentMonthPatients = await dbContext.tbl_pacientes.CountAsync(x => x.fecha_registro >= currentMonthStart);
            var previousMonthPatients = await dbContext.tbl_pacientes.CountAsync(x =>
                x.fecha_registro >= previousMonthStart && x.fecha_registro < currentMonthStart);
            patientMonthlyChange = previousMonthPatients == 0
                ? (currentMonthPatients > 0 ? 100m : 0m)
                : (currentMonthPatients - previousMonthPatients) * 100m / previousMonthPatients;

            var completedAppointments = await dbContext.tbl_citas.CountAsync(x =>
                x.id_estadoNavigation != null && x.id_estadoNavigation.nombre_estado == "Realizada");
            appointmentCompletionRate = totalAppointments == 0
                ? 0m
                : completedAppointments * 100m / totalAppointments;

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard database statistics: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && user is not null)
        {
            await InitializeChartsAsync();
        }
    }

    private async Task InitializeChartsAsync()
    {
        try
        {
            var financesData = new decimal[] { totalEarnings, totalExpenses, totalReceivable };
            var activityData = new int[] { totalPatients, totalAppointments, confirmedAppointments };
            var financialTotal = totalEarnings + totalExpenses + totalReceivable;
            string totalText = financialTotal >= 1000m
                ? $"${financialTotal / 1000:N1}K"
                : $"${financialTotal:N2}";

            await JSRuntime.InvokeVoidAsync(
                "initializeDashboardCharts",
                new[] { "Pacientes", "Citas", "Confirmadas" },
                activityData,
                financesData,
                totalText);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error calling JS initializeDashboardCharts: {ex.Message}");
        }
    }

    private string GetDashboardTitle()
    {
        return $"Hola, {user?.FindFirst("NombreCompleto")?.Value ?? "usuario"}";
    }

    private static string FormatPercentage(decimal value) =>
        $"{(value >= 0 ? "+" : string.Empty)}{value:0.#}%";

    private string GetFinanceRingStyle()
    {
        var earned = Math.Max(totalEarnings, 0m);
        var expenses = Math.Max(totalExpenses, 0m);
        var receivable = Math.Max(totalReceivable, 0m);
        var total = earned + expenses + receivable;

        if (total <= 0)
        {
            return "--finance-ring: conic-gradient(#5DA181 0deg 120deg, #E53935 120deg 240deg, #7F6951 240deg 360deg);";
        }

        var earnedEnd = decimal.ToDouble(earned / total * 360m);
        var expensesEnd = decimal.ToDouble((earned + expenses) / total * 360m);

        return $"--finance-ring: conic-gradient(#5DA181 0deg {earnedEnd:0.##}deg, #E53935 {earnedEnd:0.##}deg {expensesEnd:0.##}deg, #7F6951 {expensesEnd:0.##}deg 360deg);";
    }
}
