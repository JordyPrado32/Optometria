@page "/dashboard"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject MenuAccessService MenuAccessService

<PageTitle>Dashboard</PageTitle>

@if (user is null)
{
    <section class="workspace-shell">
        <div class="workspace-card">
            <h1>Cargando dashboard...</h1>
        </div>
    </section>
}
else
{
    <section class="workspace-shell dashboard-shell-v2">
        <section class="dashboard-hero-v2">
            <div class="dashboard-hero-copy">
                <span class="eyebrow">Panel administrativo</span>
                <h1>@GetDashboardTitle()</h1>
                <p>@GetDashboardDescription()</p>
            </div>

            <div class="dashboard-hero-side">
                <div class="dashboard-hero-chip">
                    <span>Rol actual</span>
                    <strong>@RoleName</strong>
                </div>

                <div class="dashboard-hero-chip">
                    <span>Modulos activos</span>
                    <strong>@availableMenus.Count</strong>
                </div>
            </div>
        </section>

        <section class="dashboard-actions-v2">
            @foreach (var menu in availableMenus.Where(m => m.Ruta != "/dashboard").Take(4))
            {
                <a class="dashboard-action-card" href="@menu.Ruta">
                    <span class="dashboard-action-badge">@GetModuleIconLabel(menu.Ruta)</span>
                    <strong>@menu.Nombre</strong>
                    <p>@GetModuleDescription(menu.Ruta)</p>
                </a>
            }
        </section>

        <div class="dashboard-layout-v2">
            <section class="dashboard-panel dashboard-modules-panel">
                <div class="dashboard-panel-header">
                    <div>
                        <span class="eyebrow">Navegacion</span>
                        <h2>Modulos disponibles</h2>
                    </div>
                    <span>@availableMenus.Count accesos</span>
                </div>

                <div class="dashboard-module-grid-v2">
                    @foreach (var menu in availableMenus.Where(m => m.Ruta != "/dashboard"))
                    {
                        <a class="dashboard-module-tile" href="@menu.Ruta">
                            <span class="dashboard-module-mark">@GetModuleIconLabel(menu.Ruta)</span>
                            <div>
                                <strong>@menu.Nombre</strong>
                                <p>@GetModuleDescription(menu.Ruta)</p>
                            </div>
                        </a>
                    }
                </div>
            </section>

            <aside class="dashboard-side-stack">
                <section class="dashboard-panel">
                    <div class="dashboard-panel-header">
                        <div>
                            <span class="eyebrow">Cuenta</span>
                            <h2>Sesion y perfil</h2>
                        </div>
                    </div>

                    <div class="dashboard-account-grid">
                        <article class="dashboard-account-card">
                            <span>Usuario</span>
                            <strong>@UserName</strong>
                            <p>@(Email ?? "Sin correo registrado")</p>
                        </article>

                        <article class="dashboard-account-card">
                            <span>Control</span>
                            <strong>@RoleName</strong>
                            <p>Acceso gobernado por permisos del sistema.</p>
                        </article>
                    </div>

                    <div class="workspace-actions">
                        @if (availableMenus.Any(m => m.Ruta == "/profile"))
                        {
                            <a class="btn btn-outline-primary" href="/profile">Ir a perfil</a>
                        }

                        @if (availableMenus.Any(m => m.Ruta == "/setup-2fa"))
                        {
                            <a class="btn btn-primary" href="/setup-2fa">Revisar seguridad</a>
                        }
                    </div>
                </section>

                <section class="dashboard-panel">
                    <div class="dashboard-panel-header">
                        <div>
                            <span class="eyebrow">Operacion</span>
                            <h2>Enfoque recomendado</h2>
                        </div>
                    </div>

                    <div class="dashboard-sequence-grid">
                        <article>
                            <strong>1. Consulta</strong>
                            <p>Abre primero el modulo objetivo y valida el contexto antes de editar.</p>
                        </article>

                        <article>
                            <strong>2. Control</strong>
                            <p>Usa roles, menus y permisos para mantener orden operativo.</p>
                        </article>

                        <article>
                            <strong>3. Seguridad</strong>
                            <p>Revisa autenticacion y cuenta cuando detectes bloqueos o perdida de acceso.</p>
                        </article>
                    </div>
                </section>
            </aside>
        </div>
    </section>
}

@code {
    private ClaimsPrincipal? user;
    private List<AppMenuItem> availableMenus = [];
    private string UserName => user?.Identity?.Name ?? string.Empty;
    private string RoleName => user?.FindFirst(ClaimTypes.Role)?.Value ?? "Sin rol";
    private string? Email => user?.FindFirst(ClaimTypes.Email)?.Value;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var forcePasswordChange = string.Equals(authState.User.FindFirst("ForcePasswordChange")?.Value, bool.TrueString, StringComparison.OrdinalIgnoreCase);
        if (forcePasswordChange)
        {
            NavigationManager.NavigateTo("/change-password");
            return;
        }

        user = authState.User;
        var roleIdValue = user.FindFirst("RoleId")?.Value;
        int? roleId = int.TryParse(roleIdValue, out var parsedRoleId) ? parsedRoleId : null;
        availableMenus = await MenuAccessService.GetMenusForRoleAsync(roleId);
    }

    private string GetDashboardTitle()
    {
        return $"Hola, {user?.FindFirst("NombreCompleto")?.Value ?? "usuario"}";
    }

    private string GetDashboardDescription()
    {
        return "Este espacio centraliza la operacion administrativa con accesos claros, paneles estables y una lectura rapida del sistema sin ruido visual.";
    }

    private static string GetModuleDescription(string route) => route switch
    {
        "/patients" => "Registra, consulta y actualiza fichas clinicas base.",
        "/doctor/patient-entry" => "Da de alta pacientes y manten solo los tuyos al dia.",
        "/doctor/my-patients" => "Consulta tu lista asignada con filtros y exportacion.",
        "/appointments" => "Administra agenda, recordatorios y estados de citas por rol.",
        "/appointment-availability" => "Gestiona horarios semanales, descansos y bloqueos del medico.",
        "/doctors" => "Completa fichas profesionales y habilita medicos visibles para agendamiento.",
        "/laboratories" => "Gestiona laboratorios, contactos y disponibilidad operativa.",
        "/suppliers" => "Administra proveedores, relacion comercial y datos de abastecimiento.",
        "/products" => "Controla catalogo, inventario avanzado, rotacion y datos logisticos.",
        "/product-categories" => "Organiza y mantiene las categorias que usa el catalogo de productos y servicios.",
        "/purchases" => "Consolida abastecimiento, recepcion y control de inventario por usuario.",
        "/purchase-orders" => "Registra y administra tus ordenes de compra con sus lineas.",
        "/purchase-receptions" => "Recibe compras y genera trazabilidad de entrada a inventario.",
        "/purchase-liquidations" => "Liquida compras con factura, saldos y estado de pago.",
        "/inventories" => "Consulta lotes, kardex y registra movimientos manuales propios.",
        "/kardex" => "Revisa valorizacion, costo promedio ponderado y trazabilidad completa por producto.",
        "/clients" => "Gestiona tus clientes de facturacion electronica y su trazabilidad.",
        "/emisor" => "Configura el emisor SRI asociado a tu usuario y su punto de emision.",
        "/invoices" => "Factura servicios y productos, recoge pendientes y controla credito e impuestos.",
        "/my-invoices" => "Consulta tus facturas emitidas, sus lineas, saldos y acceso rapido a notas de credito.",
        "/my-credit-notes" => "Administra tus notas de credito y ajusta facturas emitidas con trazabilidad completa.",
        "/accounts-receivable" => "Supervisa cartera, vencimientos y abonos ligados a facturas emitidas a credito.",
        "/users" => "Administra cuentas, estados y seguridad de acceso.",
        "/profile" => "Actualiza tu informacion personal y preferencias.",
        "/register" => "Crea cuentas nuevas de forma controlada.",
        "/setup-2fa" => "Gestiona autenticacion de segundo factor.",
        "/roles" => "Configura permisos y alcance por rol.",
        "/menus" => "Organiza la navegacion del sistema.",
        _ => "Acceso habilitado por tu rol actual."
    };

    private static string GetModuleIconLabel(string route) => route switch
    {
        "/patients" => "PC",
        "/doctor/patient-entry" => "IP",
        "/doctor/my-patients" => "MP",
        "/appointments" => "CT",
        "/appointment-availability" => "DP",
        "/doctors" => "MD",
        "/laboratories" => "LB",
        "/suppliers" => "PR",
        "/products" => "PD",
        "/product-categories" => "CG",
        "/purchases" => "CP",
        "/purchase-orders" => "OC",
        "/purchase-receptions" => "RC",
        "/purchase-liquidations" => "LC",
        "/inventories" => "IV",
        "/kardex" => "KX",
        "/clients" => "CL",
        "/emisor" => "EM",
        "/invoices" => "FC",
        "/my-invoices" => "MF",
        "/my-credit-notes" => "NC",
        "/accounts-receivable" => "CC",
        "/users" => "US",
        "/profile" => "PF",
        "/register" => "RG",
        "/setup-2fa" => "2F",
        "/roles" => "RL",
        "/menus" => "MN",
        _ => "MD"
    };
}
