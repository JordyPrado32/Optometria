@page "/suppliers"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@using System.Net.Mail
@using Microsoft.EntityFrameworkCore
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject NavigationManager NavigationManager

<PageTitle>Proveedores</PageTitle>

@if (isLoading)
{
    <section class="management-shell">
        <div class="management-card">
            <h1>Cargando proveedores...</h1>
        </div>
    </section>
}
else if (!canViewSuppliers)
{
    <section class="management-shell">
        <div class="management-card">
            <span class="eyebrow">Restringido</span>
            <h1>Gestion de proveedores</h1>
            <p>Tu rol no tiene permiso para ver este modulo.</p>
        </div>
    </section>
}
else
{
    <section class="management-shell">
        <div class="management-hero">
            <div>
                <span class="eyebrow">Administrador</span>
                <h1>Proveedores</h1>
                <p>Administra proveedores con una vista clara, filtros rápidos y acciones integradas.</p>
            </div>

            <div class="workspace-actions">
                @if (permissions.CanCreate)
                {
                    <button type="button" class="btn btn-primary" @onclick="PrepareNewSupplier">
                        <i class="bi bi-plus-lg" style="margin-right: 6px;"></i> Nuevo proveedor
                    </button>
                }

                <button type="button" class="btn btn-outline-primary" @onclick="ExportSuppliers">Exportar CSV</button>
            </div>
        </div>

        <section class="management-card">
            <div class="management-card-header">
                <h2>Filtros y búsqueda</h2>
                <span>@FilteredSuppliers.Count resultados</span>
            </div>

            <div class="management-form-grid">
                <div>
                    <label class="form-label" for="supplierSearch">Buscador</label>
                    <input id="supplierSearch" class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Nombre, teléfono, correo, dirección u observaciones" />
                </div>
            </div>

            <div class="management-actions" style="margin-top: 1rem;">
                <button type="button" class="btn btn-outline-primary" @onclick="ClearFilters">Limpiar filtros</button>
            </div>
        </section>

        <!-- Suppliers Table Card (Full Width) -->
        <section class="management-card" style="margin-top: 1.5rem;">
            <div class="management-card-header">
                <h2>Listado de Proveedores</h2>
                <span>@FilteredSuppliers.Count registrados</span>
            </div>

            <div class="table-responsive" style="margin-top: 1rem;">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th>Teléfono</th>
                            <th>Correo</th>
                            <th>Dirección</th>
                            <th>Observaciones</th>
                            <th style="text-align: right; padding-right: 1.5rem;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredSuppliers.Count == 0)
                        {
                            <tr>
                                <td colspan="7" style="text-align: center; padding: 2rem; color: var(--color-taupe);">
                                    No se encontraron proveedores registrados con los filtros seleccionados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var supplier in FilteredSuppliers)
                            {
                                <tr>
                                    <td>
                                        <span style="font-family: monospace; font-size: 0.85rem;">@supplier.id_proveedor</span>
                                    </td>
                                    <td>
                                        <strong style="color: var(--color-ink);">@supplier.nombre</strong>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(supplier.telefono) ? "-" : supplier.telefono)</td>
                                    <td>@(string.IsNullOrWhiteSpace(supplier.email) ? "-" : supplier.email)</td>
                                    <td>@(string.IsNullOrWhiteSpace(supplier.direccion) ? "-" : supplier.direccion)</td>
                                    <td>@(string.IsNullOrWhiteSpace(supplier.observaciones) ? "-" : (supplier.observaciones.Length > 40 ? supplier.observaciones.Substring(0, 37) + "..." : supplier.observaciones))</td>
                                    <td style="text-align: right; padding-right: 1.2rem;">
                                        <div style="display: inline-flex; gap: 0.4rem; justify-content: flex-end;">
                                            <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(93, 161, 129, 0.3) !important; color: var(--color-sage) !important;" @onclick="() => PrepareEditSupplier(supplier)">
                                                <i class="bi bi-pencil-fill" style="margin-right: 4px;"></i> Editar
                                            </button>
                                            <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(254, 188, 100, 0.4) !important; color: #e09b3c !important;" @onclick="() => PrepareAuditSupplier(supplier)">
                                                <i class="bi bi-clock-history" style="margin-right: 4px;"></i> Auditoría
                                            </button>
                                            @if (permissions.CanDelete)
                                            {
                                                <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(127, 105, 81, 0.2) !important; color: var(--color-taupe) !important;" @onclick="() => DeleteSupplierAsync(supplier)">
                                                    Eliminar
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </section>
}

<!-- Custom Form Modal -->
@if (showFormModal && editor is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card form-modal-card">
            <header class="custom-modal-header rose-header">
                <h2>@EditorTitle</h2>
                <button type="button" class="btn-close-modal" @onclick="() => showFormModal = false">×</button>
            </header>
            <div class="custom-modal-body">
                <div class="management-form-grid">
                    <div>
                        <label class="form-label" for="supplierName">Nombre</label>
                        <input id="supplierName" class="form-control" @bind="editor.Nombre" readonly="@(!CanModifyEditor)" maxlength="150" />
                    </div>

                    <div>
                        <label class="form-label" for="supplierPhone">Teléfono</label>
                        <input id="supplierPhone" class="form-control" @bind="editor.Telefono" readonly="@(!CanModifyEditor)" maxlength="30" />
                    </div>

                    <div>
                        <label class="form-label" for="supplierEmail">Correo</label>
                        <input id="supplierEmail" type="email" class="form-control" @bind="editor.Email" readonly="@(!CanModifyEditor)" maxlength="150" />
                    </div>

                    <div class="patient-form-span">
                        <label class="form-label" for="supplierAddress">Dirección</label>
                        <input id="supplierAddress" class="form-control" @bind="editor.Direccion" readonly="@(!CanModifyEditor)" maxlength="255" />
                    </div>

                    <div class="patient-form-span">
                        <label class="form-label" for="supplierNotes">Observaciones</label>
                        <textarea id="supplierNotes" class="form-control" rows="4" @bind="editor.Observaciones" readonly="@(!CanModifyEditor)"></textarea>
                    </div>
                </div>
            </div>
            <footer class="custom-modal-footer">
                @if (CanModifyEditor)
                {
                    <button type="button" class="btn btn-primary" @onclick="SaveSupplierAsync">Guardar cambios</button>
                }
                <button type="button" class="btn btn-outline-primary" @onclick="() => showFormModal = false">Cerrar</button>
            </footer>
        </div>
    </div>
}

<!-- Custom Audit Modal -->
@if (showAuditModal && selectedSupplier is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card audit-modal-card">
            <header class="custom-modal-header apricot-header">
                <h2>Historial de Auditoría - @selectedSupplier.nombre</h2>
                <button type="button" class="btn-close-modal" @onclick="() => showAuditModal = false">×</button>
            </header>
            <div class="custom-modal-body">
                @if (auditEntries.Count == 0)
                {
                    <p style="text-align: center; color: var(--color-taupe); margin: 2rem 0;">No hay eventos registrados para este proveedor en este módulo.</p>
                }
                else
                {
                    <div class="management-list">
                        @foreach (var auditEntry in auditEntries)
                        {
                            <article class="management-list-item" style="border: 1px solid rgba(127, 105, 81, 0.08); border-radius: 0.8rem; padding: 0.95rem; margin-bottom: 0.6rem; background: #faf8f4;">
                                <div style="display: flex; justify-content: space-between; margin-bottom: 0.35rem;">
                                    <strong style="color: var(--color-sage);">@auditEntry.accion</strong>
                                    <span style="font-size: 0.78rem; color: var(--color-taupe);">@(auditEntry.fecha?.ToString("yyyy-MM-dd HH:mm") ?? "Sin fecha")</span>
                                </div>
                                <div style="font-size: 0.82rem; color: var(--color-ink); margin-bottom: 0.35rem;">@auditEntry.detalle</div>
                                <span style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-taupe); opacity: 0.8;">@GetAuditActorLabel(auditEntry)</span>
                            </article>
                        }
                    </div>
                }
            </div>
            <footer class="custom-modal-footer">
                <button type="button" class="btn btn-outline-primary" @onclick="() => showAuditModal = false">Cerrar</button>
            </footer>
        </div>
    </div>
}

<!-- Custom Alert Modal -->
@if (showAlertModal)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card alert-modal-card">
            <header class="custom-modal-header @(alertIsError ? "error-header" : "success-header")">
                <h2>@(alertIsError ? "Error de Validación" : "Operación Exitosa")</h2>
            </header>
            <div class="custom-modal-body" style="padding: 2rem 1.5rem; text-align: center;">
                <div style="font-size: 3rem; margin-bottom: 1rem; color: @(alertIsError ? "#7F6951" : "#5DA181")">
                    <i class="bi @(alertIsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")"></i>
                </div>
                <p style="font-size: 1rem; color: var(--color-ink); line-height: 1.5; margin: 0;">@alertMessage</p>
            </div>
            <footer class="custom-modal-footer" style="justify-content: center; background: transparent; border-top: none; padding-top: 0;">
                <button type="button" class="btn btn-primary" style="min-width: 120px;" @onclick="CloseAlertModal">Aceptar</button>
            </footer>
        </div>
    </div>
}

<style>
