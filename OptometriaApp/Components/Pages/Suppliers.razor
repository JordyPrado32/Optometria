    private async Task DeleteSupplierAsync(tbl_proveedor supplier)
    {
        errorMessage = null;

        if (!permissions.CanDelete || supplier.id_proveedor <= 0)
        {
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var supplierEntity = await dbContext.tbl_proveedors
            .Include(s => s.tbl_productos)
            .FirstOrDefaultAsync(s => s.id_proveedor == supplier.id_proveedor);

        if (supplierEntity is null)
        {
            ShowAlert("No se encontro el proveedor seleccionado.", true);
            return;
        }

        if (supplierEntity.tbl_productos.Count > 0)
        {
            ShowAlert("No puedes eliminar un proveedor con productos asociados.", true);
            return;
        }

        WriteAudit(
            dbContext,
            "Eliminar proveedor",
            $"ProveedorId={supplierEntity.id_proveedor}; Nombre={supplierEntity.nombre}; Ruc={supplierEntity.ruc}");

        dbContext.tbl_proveedors.Remove(supplierEntity);
        await dbContext.SaveChangesAsync();

        ShowAlert("El proveedor fue eliminado correctamente.", false);
        selectedSupplierId = 0;
        await LoadAsync();
    }

    private async Task LoadAuditEntriesAsync(int supplierId)
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var token = $"ProveedorId={supplierId};";

        auditEntries = await dbContext.tbl_log_auditoria
            .AsNoTracking()
            .Include(a => a.id_usuarioNavigation)
            .Where(a => a.modulo == "Proveedores" && a.detalle != null && a.detalle.Contains(token))
            .OrderByDescending(a => a.fecha)
            .Take(20)
            .ToListAsync();
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        selectedStatusFilter = "all";
        selectedRatingFilter = string.Empty;
    }

    private void ExportSuppliers()
    {
        var query = new List<string>();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query.Add($"search={Uri.EscapeDataString(searchTerm)}");
        }

        if (selectedStatusFilter != "all")
        {
            query.Add($"status={Uri.EscapeDataString(selectedStatusFilter)}");
        }

        var exportUrl = query.Count == 0
            ? "/exports/suppliers.csv"
            : $"/exports/suppliers.csv?{string.Join("&", query)}";

        NavigationManager.NavigateTo(exportUrl, forceLoad: true);
    }

    private bool MatchesFilters(tbl_proveedor supplier)
    {
        if (selectedStatusFilter is "active" or "inactive")
        {
            var expectedStatus = selectedStatusFilter == "active";
            if ((supplier.es_activo ?? true) != expectedStatus)
            {
                return false;
            }
        }

        if (!string.IsNullOrWhiteSpace(selectedRatingFilter) &&
            !string.Equals(supplier.calificacion, selectedRatingFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return true;
        }

        var search = searchTerm.Trim().ToLowerInvariant();
        return supplier.nombre.ToLowerInvariant().Contains(search) ||
               (supplier.razon_social?.ToLowerInvariant().Contains(search) ?? false) ||
               (supplier.ruc?.ToLowerInvariant().Contains(search) ?? false) ||
               (supplier.telefono?.ToLowerInvariant().Contains(search) ?? false) ||
               (supplier.email?.ToLowerInvariant().Contains(search) ?? false) ||
               (supplier.contacto_nombre?.ToLowerInvariant().Contains(search) ?? false) ||
               (supplier.contacto_correo?.ToLowerInvariant().Contains(search) ?? false) ||
               (supplier.ciudad?.ToLowerInvariant().Contains(search) ?? false) ||
               (supplier.provincia?.ToLowerInvariant().Contains(search) ?? false) ||
               (supplier.observaciones?.ToLowerInvariant().Contains(search) ?? false);
    }

    private bool ValidateEditor()
    {
        if (editor is null)
        {
            errorMessage = "No hay un proveedor seleccionado.";
            return false;
        }

        editor.Nombre = editor.Nombre.Trim();
        editor.Ruc = editor.Ruc.Trim();
        editor.Email = editor.Email.Trim();
        editor.ContactoCorreo = editor.ContactoCorreo.Trim();
        editor.Telefono = editor.Telefono.Trim();
        editor.ContactoTelefono = editor.ContactoTelefono.Trim();

        if (string.IsNullOrWhiteSpace(editor.Nombre))
        {
            errorMessage = "Ingresa el nombre del proveedor.";
            return false;
        }

        if (!string.IsNullOrWhiteSpace(editor.Ruc) && (editor.Ruc.Length != 13 || !editor.Ruc.All(char.IsDigit)))
        {
            errorMessage = "El RUC debe tener exactamente 13 digitos.";
            return false;
        }

        if (!string.IsNullOrWhiteSpace(editor.Email) && !IsValidEmail(editor.Email))
        {
            errorMessage = "Ingresa un correo electronico valido.";
            return false;
        }

        if (!string.IsNullOrWhiteSpace(editor.ContactoCorreo) && !IsValidEmail(editor.ContactoCorreo))
        {
            errorMessage = "Ingresa un correo del contacto valido.";
            return false;
        }

        if (editor.DiasCreditoPromedio < 0 || editor.TiempoEntregaPromedio < 0 || editor.LimiteCredito < 0 || editor.SaldoPendiente < 0)
        {
            errorMessage = "Los valores numericos no pueden ser negativos.";
            return false;
        }

        return true;
    }

    private async Task<ModulePermissions> GetModulePermissionsAsync(OpticaDbContext dbContext, int roleId)
    {
        if (roleId <= 0)
        {
            return new ModulePermissions();
        }

        var permission = await dbContext.tbl_rol_menu_permisos
            .AsNoTracking()
            .Where(p => p.id_rol == roleId)
            .Join(
                dbContext.tbl_menu_apps.AsNoTracking().Where(m => m.ruta == "/proveedores"),
                rolePermission => rolePermission.id_menu,
                menu => menu.id_menu,
                (rolePermission, _) => rolePermission)
            .FirstOrDefaultAsync();

        return permission is null
            ? new ModulePermissions()
            : new ModulePermissions
            {
                CanView = permission.puede_ver,
                CanCreate = permission.puede_crear,
                CanEdit = permission.puede_editar,
                CanDelete = permission.puede_eliminar
            };
    }

