            supplierEntity.razon_social = NormalizeOptional(editor.RazonSocial);
            supplierEntity.ruc = NormalizeOptional(editor.Ruc);
            supplierEntity.tipo_identificacion = NormalizeOptional(editor.TipoIdentificacion);
            supplierEntity.nombre_comercial = NormalizeOptional(editor.NombreComercial);
            supplierEntity.telefono = NormalizeOptional(editor.Telefono);
            supplierEntity.email = NormalizeOptional(editor.Email);
            supplierEntity.direccion = NormalizeOptional(editor.Direccion);
            supplierEntity.ciudad = NormalizeOptional(editor.Ciudad);
            supplierEntity.provincia = NormalizeOptional(editor.Provincia);
            supplierEntity.codigo_postal = NormalizeOptional(editor.CodigoPostal);
            supplierEntity.contacto_nombre = NormalizeOptional(editor.ContactoNombre);
            supplierEntity.contacto_telefono = NormalizeOptional(editor.ContactoTelefono);
            supplierEntity.contacto_correo = NormalizeOptional(editor.ContactoCorreo);
            supplierEntity.dias_credito_promedio = editor.DiasCreditoPromedio;
            supplierEntity.saldo_pendiente = editor.SaldoPendiente;
            supplierEntity.limite_credito = editor.LimiteCredito;
            supplierEntity.condicion_pago = NormalizeOptional(editor.CondicionPago);
            supplierEntity.banco_nombre = NormalizeOptional(editor.BancoNombre);
            supplierEntity.cuenta_bancaria = NormalizeOptional(editor.CuentaBancaria);
            supplierEntity.tipo_cuenta = NormalizeOptional(editor.TipoCuenta);
            supplierEntity.calificacion = NormalizeOptional(editor.Calificacion);
            supplierEntity.tiempo_entrega_promedio = editor.TiempoEntregaPromedio;
            supplierEntity.es_activo = editor.EsActivo;
            supplierEntity.observaciones = NormalizeOptional(editor.Observaciones);
            supplierEntity.fecha_actualizacion = DateTime.Now;
            supplierEntity.id_usuario_actualizacion = currentUserId > 0 ? currentUserId : null;

            await dbContext.SaveChangesAsync();

            WriteAudit(
                dbContext,
                isCreatingNewSupplier ? "Crear proveedor" : "Editar proveedor",
                $"ProveedorId={supplierEntity.id_proveedor}; Nombre={supplierEntity.nombre}; Ruc={supplierEntity.ruc}; RazonSocial={supplierEntity.razon_social}; Estado={(supplierEntity.es_activo ?? true ? "Activo" : "Inactivo")}");

            await dbContext.SaveChangesAsync();

            ShowAlert(isCreatingNewSupplier
                ? "El proveedor se creo correctamente."
                : "La informacion del proveedor se guardo correctamente.", false);

            showFormModal = false;
            isCreatingNewSupplier = false;
            await LoadAsync(supplierEntity.id_proveedor);
        }
        catch (Exception ex)
