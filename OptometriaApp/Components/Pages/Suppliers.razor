@page "/proveedores"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@using System.Net.Mail
@using Microsoft.EntityFrameworkCore
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject NavigationManager NavigationManager

<PageTitle>Proveedores</PageTitle>

@if (isLoading)
{
    <section class="management-shell">
        <div class="management-card">
            <h1>Cargando proveedores...</h1>
        </div>
    </section>
}
else if (!canViewSuppliers)
{
    <section class="management-shell">
        <div class="management-card">
            <span class="eyebrow">Restringido</span>
            <h1>Gestion de proveedores</h1>
            <p>Tu rol no tiene permiso para ver este modulo.</p>
        </div>
    </section>
}
else
{
    <section class="management-shell">
        <div class="management-hero">
            <div>
                <span class="eyebrow">Compras</span>
                <h1>Proveedores</h1>
                <p>Administra relacion comercial, contacto, credito, datos fiscales y seguimiento operativo del proveedor en un solo lugar.</p>
            </div>

            <div class="workspace-actions" style="align-items: center;">
                @if (permissions.CanCreate)
                {
                    <button type="button" class="btn btn-coffee" @onclick="PrepareNewSupplier">
                        <i class="bi bi-plus-lg" style="margin-right: 6px;"></i> Nuevo proveedor
                    </button>
                }

                <button type="button" class="btn btn-excel" @onclick="ExportSuppliers">
                    <i class="bi bi-file-earmark-excel-fill" style="margin-right: 6px;"></i> Exportar CSV
                </button>
            </div>
        </div>

        <section class="management-card">
            <div class="management-card-header">
                <h2>Filtros y busqueda</h2>
                <span>@FilteredSuppliers.Count resultados</span>
            </div>

            <div class="filters-row-2">
                <div>
                    <label class="form-label" for="supplierSearch">Buscador</label>
                    <input id="supplierSearch" class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Nombre, razon social, RUC, telefono, correo o ciudad" />
                </div>

                <div class="filter-selects-col-2">
                    <div>
                        <label class="form-label" for="supplierStatus">Estado</label>
                        <select id="supplierStatus" class="form-select" @bind="selectedStatusFilter">
                            <option value="all">Todos</option>
                            <option value="active">Activos</option>
                            <option value="inactive">Inactivos</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label" for="supplierRating">Calificacion</label>
                        <select id="supplierRating" class="form-select" @bind="selectedRatingFilter">
                            <option value="">Todas</option>
                            @foreach (var option in ratingOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="management-actions" style="margin-top: 0.3rem;">
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ClearFilters" style="padding: 0.3rem 0.7rem !important; font-size: 0.78rem !important; border-color: rgba(127,105,81,0.25) !important;">
                    <i class="bi bi-trash" style="margin-right: 4px;"></i> Limpiar filtros
                </button>
            </div>
        </section>

        <section class="management-card" style="margin-top: 1.5rem;">
            <div class="management-card-header">
                <h2>Listado de proveedores</h2>
                <span>@FilteredSuppliers.Count registrados</span>
            </div>

            <div class="table-responsive" style="margin-top: 1rem;">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Codigo</th>
                            <th>Proveedor</th>
                            <th>RUC</th>
                            <th>Contacto</th>
                            <th>Ciudad</th>
                            <th>Credito</th>
                            <th>Estado</th>
                            <th style="text-align: right; padding-right: 1.5rem;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredSuppliers.Count == 0)
                        {
                            <tr>
                                <td colspan="8" style="text-align: center; padding: 2rem; color: var(--color-taupe);">
                                    No se encontraron proveedores con los filtros seleccionados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var supplier in FilteredSuppliers)
                            {
                                <tr>
                                    <td>
                                        <span style="font-family: monospace; font-size: 0.85rem;">@supplier.id_proveedor</span>
                                    </td>
                                    <td>
                                        <strong style="color: var(--color-ink);">@supplier.nombre</strong>
                                        <div style="font-size: 0.78rem; color: var(--color-taupe);">@(string.IsNullOrWhiteSpace(supplier.razon_social) ? "Sin razon social" : supplier.razon_social)</div>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(supplier.ruc) ? "-" : supplier.ruc)</td>
                                    <td>
                                        <div>@(string.IsNullOrWhiteSpace(supplier.contacto_nombre) ? (string.IsNullOrWhiteSpace(supplier.telefono) ? "-" : supplier.telefono) : supplier.contacto_nombre)</div>
                                        <div style="font-size: 0.78rem; color: var(--color-taupe);">@(string.IsNullOrWhiteSpace(supplier.contacto_correo) ? (string.IsNullOrWhiteSpace(supplier.email) ? "-" : supplier.email) : supplier.contacto_correo)</div>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(supplier.ciudad) ? "-" : supplier.ciudad)</td>
                                    <td>
                                        <div>@(string.IsNullOrWhiteSpace(supplier.condicion_pago) ? "-" : supplier.condicion_pago)</div>
                                        <div style="font-size: 0.78rem; color: var(--color-taupe);">Limite: @(supplier.limite_credito?.ToString("0.00") ?? "0.00")</div>
                                    </td>
                                    <td>
                                        <div>@((supplier.es_activo ?? true) ? "Activo" : "Inactivo")</div>
                                        <div style="font-size: 0.78rem; color: var(--color-taupe);">Calif: @(supplier.calificacion ?? "-")</div>
                                    </td>
                                    <td style="text-align: right; padding-right: 1.2rem;">
                                        <div style="display: inline-flex; gap: 0.4rem; justify-content: flex-end;">
                                            <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(93, 161, 129, 0.3) !important; color: var(--color-sage) !important;" @onclick="() => PrepareEditSupplier(supplier)">
                                                <i class="bi bi-pencil-fill" style="margin-right: 4px;"></i> Editar
                                            </button>
                                            <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(254, 188, 100, 0.4) !important; color: #e09b3c !important;" @onclick="() => PrepareAuditSupplier(supplier)">
                                                <i class="bi bi-clock-history" style="margin-right: 4px;"></i> Auditoria
                                            </button>
                                            @if (permissions.CanDelete)
                                            {
                                                <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(127, 105, 81, 0.2) !important; color: var(--color-taupe) !important;" @onclick="() => DeleteSupplierAsync(supplier)">
                                                    Eliminar
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </section>
}

@if (showFormModal && editor is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card form-modal-card">
            <header class="custom-modal-header rose-header">
                <h2>@EditorTitle</h2>
                <button type="button" class="btn-close-modal" @onclick="CloseFormModal">×</button>
            </header>
            <div class="custom-modal-body">
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger" role="alert">@errorMessage</div>
                }

                <p style="margin-bottom: 1rem; color: var(--color-taupe); font-size: 0.9rem;">Los campos marcados con * son obligatorios.</p>

                <div class="management-form-grid">
                    <div>
                        <label class="form-label">Nombre *</label>
                        <input class="form-control" @bind="editor.Nombre" readonly="@(!CanModifyEditor)" maxlength="150" />
                    </div>

                    <div>
                        <label class="form-label">Razon social</label>
                        <input class="form-control" @bind="editor.RazonSocial" readonly="@(!CanModifyEditor)" maxlength="300" />
                    </div>

                    <div>
                        <label class="form-label">RUC</label>
                        <input class="form-control" @bind="editor.Ruc" readonly="@(!CanModifyEditor)" maxlength="13" />
                    </div>

                    <div>
                        <label class="form-label">Tipo identificacion</label>
                        <select class="form-select" @bind="editor.TipoIdentificacion" disabled="@(!CanModifyEditor)">
                            @foreach (var option in identificationOptions)
                            {
                                <option value="@option.Code">@option.Label</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label">Nombre comercial</label>
                        <input class="form-control" @bind="editor.NombreComercial" readonly="@(!CanModifyEditor)" maxlength="300" />
                    </div>

                    <div>
                        <label class="form-label">Telefono</label>
                        <input class="form-control" @bind="editor.Telefono" readonly="@(!CanModifyEditor)" maxlength="30" />
                    </div>

                    <div>
                        <label class="form-label">Correo</label>
                        <input type="email" class="form-control" @bind="editor.Email" readonly="@(!CanModifyEditor)" maxlength="150" />
                    </div>

                    <div class="patient-form-span">
                        <label class="form-label">Direccion</label>
                        <input class="form-control" @bind="editor.Direccion" readonly="@(!CanModifyEditor)" maxlength="255" />
                    </div>

                    <div>
                        <label class="form-label">Ciudad</label>
                        <input class="form-control" @bind="editor.Ciudad" readonly="@(!CanModifyEditor)" maxlength="100" />
                    </div>

                    <div>
                        <label class="form-label">Provincia</label>
                        <input class="form-control" @bind="editor.Provincia" readonly="@(!CanModifyEditor)" maxlength="100" />
                    </div>

                    <div>
                        <label class="form-label">Codigo postal</label>
                        <input class="form-control" @bind="editor.CodigoPostal" readonly="@(!CanModifyEditor)" maxlength="10" />
                    </div>

                    <div>
                        <label class="form-label">Contacto nombre</label>
                        <input class="form-control" @bind="editor.ContactoNombre" readonly="@(!CanModifyEditor)" maxlength="200" />
                    </div>

                    <div>
                        <label class="form-label">Contacto telefono</label>
                        <input class="form-control" @bind="editor.ContactoTelefono" readonly="@(!CanModifyEditor)" maxlength="20" />
                    </div>

                    <div>
                        <label class="form-label">Contacto correo</label>
                        <input type="email" class="form-control" @bind="editor.ContactoCorreo" readonly="@(!CanModifyEditor)" maxlength="100" />
                    </div>

                    <div>
                        <label class="form-label">Dias credito promedio</label>
                        <input type="number" class="form-control" @bind="editor.DiasCreditoPromedio" readonly="@(!CanModifyEditor)" min="0" />
                    </div>

                    <div>
                        <label class="form-label">Saldo pendiente</label>
                        <input type="number" step="0.01" class="form-control" @bind="editor.SaldoPendiente" readonly="@(!CanModifyEditor)" min="0" />
                    </div>

                    <div>
                        <label class="form-label">Limite credito</label>
                        <input type="number" step="0.01" class="form-control" @bind="editor.LimiteCredito" readonly="@(!CanModifyEditor)" min="0" />
                    </div>

                    <div>
                        <label class="form-label">Condicion pago</label>
                        <select class="form-select" @bind="editor.CondicionPago" disabled="@(!CanModifyEditor)">
                            @foreach (var option in paymentConditionOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label">Banco</label>
                        <input class="form-control" @bind="editor.BancoNombre" readonly="@(!CanModifyEditor)" maxlength="100" />
                    </div>

                    <div>
                        <label class="form-label">Cuenta bancaria</label>
                        <input class="form-control" @bind="editor.CuentaBancaria" readonly="@(!CanModifyEditor)" maxlength="20" />
                    </div>

                    <div>
                        <label class="form-label">Tipo cuenta</label>
                        <select class="form-select" @bind="editor.TipoCuenta" disabled="@(!CanModifyEditor)">
                            @foreach (var option in accountTypeOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label">Calificacion</label>
                        <select class="form-select" @bind="editor.Calificacion" disabled="@(!CanModifyEditor)">
                            <option value="">Sin asignar</option>
                            @foreach (var option in ratingOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label">Tiempo entrega promedio</label>
                        <input type="number" class="form-control" @bind="editor.TiempoEntregaPromedio" readonly="@(!CanModifyEditor)" min="0" />
                    </div>

                    <div>
                        <label class="form-label">Estado</label>
                        <select class="form-select" @bind="EditorEsActivoValue" disabled="@(!CanModifyEditor)">
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>

                    <div class="patient-form-span">
                        <label class="form-label">Observaciones</label>
                        <textarea class="form-control" rows="4" @bind="editor.Observaciones" readonly="@(!CanModifyEditor)"></textarea>
                    </div>
                </div>
            </div>
            <footer class="custom-modal-footer">
                @if (CanModifyEditor)
                {
                    <button type="button" class="btn btn-primary" @onclick="SaveSupplierWithHandlingAsync">Guardar cambios</button>
                }
                <button type="button" class="btn btn-outline-primary" @onclick="CloseFormModal">Cerrar</button>
            </footer>
        </div>
    </div>
}

@if (showAuditModal && selectedSupplier is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card audit-modal-card">
            <header class="custom-modal-header apricot-header">
                <h2>Historial de auditoria - @selectedSupplier.nombre</h2>
                <button type="button" class="btn-close-modal" @onclick="() => showAuditModal = false">×</button>
            </header>
            <div class="custom-modal-body">
                @if (auditEntries.Count == 0)
                {
                    <p style="text-align: center; color: var(--color-taupe); margin: 2rem 0;">No hay eventos registrados para este proveedor en este modulo.</p>
                }
                else
                {
                    <div class="management-list">
                        @foreach (var auditEntry in auditEntries)
                        {
                            <article class="management-list-item" style="border: 1px solid rgba(127, 105, 81, 0.08); border-radius: 0.8rem; padding: 0.95rem; margin-bottom: 0.6rem; background: #faf8f4;">
                                <div style="display: flex; justify-content: space-between; margin-bottom: 0.35rem;">
                                    <strong style="color: var(--color-sage);">@auditEntry.accion</strong>
                                    <span style="font-size: 0.78rem; color: var(--color-taupe);">@(auditEntry.fecha?.ToString("yyyy-MM-dd HH:mm") ?? "Sin fecha")</span>
                                </div>
                                <div style="font-size: 0.82rem; color: var(--color-ink); margin-bottom: 0.35rem;">@auditEntry.detalle</div>
                                <span style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-taupe); opacity: 0.8;">@GetAuditActorLabel(auditEntry)</span>
                            </article>
                        }
                    </div>
                }
            </div>
            <footer class="custom-modal-footer">
                <button type="button" class="btn btn-outline-primary" @onclick="() => showAuditModal = false">Cerrar</button>
            </footer>
        </div>
    </div>
}

@if (showAlertModal)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card alert-modal-card">
            <header class="custom-modal-header @(alertIsError ? "error-header" : "success-header")">
                <h2>@(alertIsError ? "Error de validacion" : "Operacion exitosa")</h2>
            </header>
            <div class="custom-modal-body" style="padding: 2rem 1.5rem; text-align: center;">
                <div style="font-size: 3rem; margin-bottom: 1rem; color: @(alertIsError ? "#7F6951" : "#5DA181")">
                    <i class="bi @(alertIsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")"></i>
                </div>
                <p style="font-size: 1rem; color: var(--color-ink); line-height: 1.5; margin: 0;">@alertMessage</p>
            </div>
            <footer class="custom-modal-footer" style="justify-content: center; background: transparent; border-top: none; padding-top: 0;">
                <button type="button" class="btn btn-primary" style="min-width: 120px;" @onclick="CloseAlertModal">Aceptar</button>
            </footer>
        </div>
    </div>
}

@code {
    private readonly List<tbl_proveedor> suppliers = [];
    private readonly List<(string Code, string Label)> identificationOptions =
    [
        ("04", "04 - RUC"),
        ("05", "05 - Cedula"),
        ("06", "06 - Pasaporte"),
        ("08", "08 - Exterior")
    ];
    private readonly string[] paymentConditionOptions = ["Contado", "Credito", "Mixto"];
    private readonly string[] accountTypeOptions = ["Ahorros", "Corriente"];
    private readonly string[] ratingOptions = ["A", "B", "C", "D"];
    private List<tbl_log_auditoria> auditEntries = [];
    private SupplierEditorModel? editor;
    private ModulePermissions permissions = new();
    private bool isLoading = true;
    private bool canViewSuppliers;
    private bool isCreatingNewSupplier;
    private int selectedSupplierId;
    private int currentUserId;
    private int currentRoleId;
    private string searchTerm = string.Empty;
    private string selectedStatusFilter = "all";
    private string selectedRatingFilter = string.Empty;
    private string? errorMessage;
    private bool showFormModal;
    private bool showAuditModal;
    private bool showAlertModal;
    private string alertMessage = string.Empty;
    private bool alertIsError;
    private tbl_proveedor? selectedSupplier;

    private List<tbl_proveedor> FilteredSuppliers => suppliers
        .Where(MatchesFilters)
        .OrderBy(s => s.nombre)
        .ThenBy(s => s.razon_social)
        .ToList();

    private string EditorTitle => isCreatingNewSupplier ? "Nuevo proveedor" : "Detalle del proveedor";
    private bool CanModifyEditor => isCreatingNewSupplier ? permissions.CanCreate : permissions.CanEdit;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var parsedUserId) ? parsedUserId : 0;
        currentRoleId = int.TryParse(authState.User.FindFirst("RoleId")?.Value, out var parsedRoleId) ? parsedRoleId : 0;
        await LoadAsync();
    }

    private async Task LoadAsync(int? preserveSelectedSupplierId = null)
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        permissions = await GetModulePermissionsAsync(dbContext, currentRoleId);
        canViewSuppliers = permissions.CanView;

        if (!canViewSuppliers)
        {
            isLoading = false;
            return;
        }

        var loadedSuppliers = await dbContext.tbl_proveedors
            .AsNoTracking()
            .Include(s => s.tbl_productos)
            .ToListAsync();

        suppliers.Clear();
        suppliers.AddRange(loadedSuppliers);

        if (preserveSelectedSupplierId.HasValue)
        {
            selectedSupplierId = preserveSelectedSupplierId.Value;
            var currentSupplier = suppliers.FirstOrDefault(s => s.id_proveedor == selectedSupplierId);
            if (currentSupplier is not null)
            {
                editor = BuildEditor(currentSupplier);
            }
        }

        isLoading = false;
    }

    private void PrepareNewSupplier()
    {
        isCreatingNewSupplier = true;
        selectedSupplierId = 0;
        editor = new SupplierEditorModel
        {
            TipoIdentificacion = "04",
            CondicionPago = "Contado",
            TipoCuenta = "Ahorros",
            EsActivo = true
        };
        auditEntries = [];
        errorMessage = null;
        showFormModal = true;
    }

    private void PrepareEditSupplier(tbl_proveedor supplier)
    {
        isCreatingNewSupplier = false;
        selectedSupplierId = supplier.id_proveedor;
        editor = BuildEditor(supplier);
        errorMessage = null;
        showFormModal = true;
    }

    private async Task PrepareAuditSupplier(tbl_proveedor supplier)
    {
        selectedSupplier = supplier;
        await LoadAuditEntriesAsync(supplier.id_proveedor);
        showAuditModal = true;
    }

    private void ShowAlert(string message, bool isError)
    {
        alertMessage = message;
        alertIsError = isError;
        showAlertModal = true;
        StateHasChanged();
    }

    private void CloseAlertModal()
    {
        showAlertModal = false;
        alertMessage = string.Empty;
    }

    private void CloseFormModal()
    {
        errorMessage = null;
        showFormModal = false;
    }

    private string EditorEsActivoValue
    {
        get => editor?.EsActivo == true ? "true" : "false";
        set
        {
            if (editor is not null)
            {
                editor.EsActivo = string.Equals(value, "true", StringComparison.OrdinalIgnoreCase);
            }
        }
    }

    private async Task SaveSupplierAsync()
    {
        errorMessage = null;

        if (!ValidateEditor())
        {
            ShowAlert(errorMessage ?? "Error de validacion.", true);
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        tbl_proveedor supplierEntity;

        if (isCreatingNewSupplier)
        {
            if (!permissions.CanCreate)
            {
                ShowAlert("Tu rol no tiene permiso para crear proveedores.", true);
                return;
            }

            supplierEntity = new tbl_proveedor
            {
                fecha_registro = DateTime.Now,
                id_usuario_registro = currentUserId > 0 ? currentUserId : null
            };
            dbContext.tbl_proveedors.Add(supplierEntity);
        }
        else
        {
            if (!permissions.CanEdit)
            {
                ShowAlert("Tu rol no tiene permiso para editar proveedores.", true);
                return;
            }

            supplierEntity = await dbContext.tbl_proveedors.FirstOrDefaultAsync(s => s.id_proveedor == editor!.IdProveedor)
                ?? throw new InvalidOperationException("No se encontro el proveedor seleccionado.");
        }

        supplierEntity.nombre = editor!.Nombre.Trim();
        supplierEntity.razon_social = NormalizeOptional(editor.RazonSocial);
        supplierEntity.ruc = NormalizeOptional(editor.Ruc);
        supplierEntity.tipo_identificacion = NormalizeOptional(editor.TipoIdentificacion);
        supplierEntity.nombre_comercial = NormalizeOptional(editor.NombreComercial);
        supplierEntity.telefono = NormalizeOptional(editor.Telefono);
        supplierEntity.email = NormalizeOptional(editor.Email);
        supplierEntity.direccion = NormalizeOptional(editor.Direccion);
        supplierEntity.ciudad = NormalizeOptional(editor.Ciudad);
        supplierEntity.provincia = NormalizeOptional(editor.Provincia);
        supplierEntity.codigo_postal = NormalizeOptional(editor.CodigoPostal);
        supplierEntity.contacto_nombre = NormalizeOptional(editor.ContactoNombre);
        supplierEntity.contacto_telefono = NormalizeOptional(editor.ContactoTelefono);
        supplierEntity.contacto_correo = NormalizeOptional(editor.ContactoCorreo);
        supplierEntity.dias_credito_promedio = editor.DiasCreditoPromedio;
        supplierEntity.saldo_pendiente = editor.SaldoPendiente;
        supplierEntity.limite_credito = editor.LimiteCredito;
        supplierEntity.condicion_pago = NormalizeOptional(editor.CondicionPago);
        supplierEntity.banco_nombre = NormalizeOptional(editor.BancoNombre);
        supplierEntity.cuenta_bancaria = NormalizeOptional(editor.CuentaBancaria);
        supplierEntity.tipo_cuenta = NormalizeOptional(editor.TipoCuenta);
        supplierEntity.calificacion = NormalizeOptional(editor.Calificacion);
        supplierEntity.tiempo_entrega_promedio = editor.TiempoEntregaPromedio;
        supplierEntity.es_activo = editor.EsActivo;
