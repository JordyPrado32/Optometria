    private async Task<BlockRescheduleResult> RescheduleAppointmentsForBlockAsync(
        OpticaDbContext dbContext,
        int doctorId,
        tbl_bloqueo_horarios block,
        int blockId)
    {
        var result = new BlockRescheduleResult();
        var overlappingAppointments = await dbContext.tbl_citas
            .Include(x => x.id_estadoNavigation)
            .Where(x =>
                x.id_medico == doctorId &&
                x.fecha_cita >= block.fecha_inicio &&
                x.fecha_cita <= block.fecha_fin &&
                x.id_estadoNavigation != null &&
                (x.id_estadoNavigation.nombre_estado == "Programada" ||
                 x.id_estadoNavigation.nombre_estado == "Confirmada" ||
                 x.id_estadoNavigation.nombre_estado == "Reprogramada"))
            .OrderBy(x => x.fecha_cita)
            .ThenBy(x => x.hora_inicio)
            .ToListAsync();

        if (overlappingAppointments.Count == 0)
        {
            return result;
        }

        var reprogrammedStateId = await dbContext.tbl_estado_cita
            .Where(x => x.nombre_estado == "Reprogramada")
            .Select(x => x.id_estado)
            .FirstAsync();

        foreach (var appointment in overlappingAppointments)
        {
            if (!DoesBlockAffectAppointment(block, appointment.fecha_cita, appointment.hora_inicio, appointment.hora_fin))
            {
                continue;
            }

            var durationMinutes = Math.Max(10, (int)(appointment.hora_fin - appointment.hora_inicio).TotalMinutes);
            var nextSlot = await FindNextAvailableSlotAsync(dbContext, doctorId, block.fecha_fin.AddDays(1), durationMinutes, appointment.id_cita);
            if (nextSlot is null)
            {
                result.UnresolvedAppointmentIds.Add(appointment.id_cita);
                WriteAudit(
                    dbContext,
                    "Reprogramacion automatica pendiente",
                    $"CitaId={appointment.id_cita}; MedicoId={doctorId}; BloqueoId={blockId}; Motivo=SinCupoAutomatico");
                continue;
            }

            appointment.fecha_cita = nextSlot.Value.Date;
            appointment.hora_inicio = nextSlot.Value.Start;
            appointment.hora_fin = nextSlot.Value.End;
            appointment.id_disponibilidad = nextSlot.Value.AvailabilityId;
            appointment.id_estado = reprogrammedStateId;
            appointment.fecha_actualizacion = DateTime.Now;

            WriteAudit(
                dbContext,
                "Reprogramar cita por bloqueo horario",
                $"CitaId={appointment.id_cita}; MedicoId={doctorId}; BloqueoId={blockId}; NuevaFecha={appointment.fecha_cita:yyyy-MM-dd}; NuevaHora={appointment.hora_inicio:HH\\:mm}");

            result.ReprogrammedCount++;
        }

        return result;
    }

    private async Task<(DateOnly Date, TimeOnly Start, TimeOnly End, int? AvailabilityId)?> FindNextAvailableSlotAsync(
        OpticaDbContext dbContext,
        int doctorId,
        DateOnly searchStartDate,
        int durationMinutes,
        int currentAppointmentId)
    {
        for (var offset = 0; offset < 90; offset++)
        {
            var candidateDate = searchStartDate.AddDays(offset);
            var dayOfWeek = ToDatabaseDayOfWeek(candidateDate.DayOfWeek);
            var schedules = await dbContext.tbl_disponibilidad_medico
                .AsNoTracking()
                .Where(x => x.id_medico == doctorId && x.dia_semana == dayOfWeek && x.disponible == true)
                .OrderBy(x => x.hora_inicio)
                .ToListAsync();

            if (schedules.Count == 0)
            {
                continue;
            }

            var dayBlocks = await dbContext.tbl_bloqueo_horarios
                .AsNoTracking()
                .Where(x => x.id_medico == doctorId && x.activo == true && x.fecha_inicio <= candidateDate && x.fecha_fin >= candidateDate)
                .ToListAsync();

            var busySlots = await dbContext.tbl_citas
                .AsNoTracking()
                .Include(x => x.id_estadoNavigation)
                .Where(x => x.id_medico == doctorId && x.fecha_cita == candidateDate && x.id_cita != currentAppointmentId)
                .Where(x => x.id_estadoNavigation != null &&
                    (x.id_estadoNavigation.nombre_estado == "Programada" ||
                     x.id_estadoNavigation.nombre_estado == "Confirmada" ||
                     x.id_estadoNavigation.nombre_estado == "Reprogramada"))
                .Select(x => new { x.hora_inicio, x.hora_fin })
                .ToListAsync();

            foreach (var schedule in schedules)
            {
                var cursor = schedule.hora_inicio;
                while (cursor.AddMinutes(durationMinutes) <= schedule.hora_fin)
                {
                    var slotEnd = cursor.AddMinutes(durationMinutes);
                    var overlapsBreak = schedule.hora_descanso_inicio.HasValue &&
                        schedule.hora_descanso_fin.HasValue &&
                        cursor < schedule.hora_descanso_fin.Value &&
                        slotEnd > schedule.hora_descanso_inicio.Value;
                    var overlapsBlock = SlotOverlapsAnyBlock(dayBlocks, candidateDate, cursor, slotEnd);
                    var overlapsAppointment = busySlots.Any(x => cursor < x.hora_fin && slotEnd > x.hora_inicio);

                    if (!overlapsBreak && !overlapsBlock && !overlapsAppointment)
                    {
                        return (candidateDate, cursor, slotEnd, schedule.id_disponibilidad);
                    }

                    cursor = cursor.AddMinutes(durationMinutes);
                }
            }
        }

        return null;
    }

    private static int ToDatabaseDayOfWeek(DayOfWeek dayOfWeek)
    {
        return dayOfWeek switch
        {
            DayOfWeek.Monday => 1,
            DayOfWeek.Tuesday => 2,
            DayOfWeek.Wednesday => 3,
            DayOfWeek.Thursday => 4,
            DayOfWeek.Friday => 5,
            DayOfWeek.Saturday => 6,
            _ => 7
        };
    }

    private static bool DoesBlockAffectAppointment(tbl_bloqueo_horarios block, DateOnly date, TimeOnly start, TimeOnly end)
    {
        if (date < block.fecha_inicio || date > block.fecha_fin)
        {
            return false;
        }

        if (string.Equals(block.alcance_bloqueo, "Completo", StringComparison.OrdinalIgnoreCase) ||
            !block.hora_inicio.HasValue ||
            !block.hora_fin.HasValue)
        {
            return true;
        }

        return start < block.hora_fin.Value && end > block.hora_inicio.Value;
    }

    private static bool SlotOverlapsAnyBlock(IEnumerable<tbl_bloqueo_horarios> blocks, DateOnly date, TimeOnly start, TimeOnly end)
        => blocks.Any(block => DoesBlockAffectAppointment(block, date, start, end));

