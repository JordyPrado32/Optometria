@page "/disponibilidad-medica"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using OptometriaApp.Data
@using OptometriaApp.Models
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject NavigationManager NavigationManager

<PageTitle>Disponibilidad medica</PageTitle>

@if (isLoading)
{
    <section class="management-shell">
        <div class="management-card">
            <h1>Cargando disponibilidad medica...</h1>
        </div>
    </section>
}
else if (!canViewModule)
{
    <section class="management-shell">
        <div class="management-card">
            <span class="eyebrow">Restringido</span>
            <h1>Disponibilidad medica</h1>
            <p>Tu rol no tiene permiso para entrar a este modulo.</p>
        </div>
    </section>
}
else
{
    <section class="management-shell">
        <div class="management-hero">
            <div>
                <span class="eyebrow">Agenda operativa</span>
                <h1>@HeroTitle</h1>
                <p>@HeroDescription</p>
            </div>

            <div class="workspace-actions" style="align-items: center;">
                <button type="button" class="btn btn-excel" @onclick="ExportAvailability">
                    <i class="bi bi-file-earmark-excel-fill" style="margin-right: 6px;"></i> Exportar CSV
                </button>
                @if (CanManageAvailability)
                {
                    <button type="button" class="btn btn-coffee" @onclick="OpenNewAvailabilityModal">
                        <i class="bi bi-calendar-plus-fill" style="margin-right: 6px;"></i> Nueva disponibilidad
                    </button>
                    <button type="button" class="btn btn-coffee" @onclick="OpenNewBlockModal" style="background-color: var(--color-sand) !important; color: var(--color-taupe-deep) !important; border-color: rgba(127,105,81,0.3) !important;">
                        <i class="bi bi-calendar-x-fill" style="margin-right: 6px;"></i> Nuevo bloqueo
                    </button>
                }
            </div>
        </div>

        <div class="availability-top-row">
            @if (isAdmin)
            {
                <section class="management-card">
                    <div class="management-card-header">
                        <h2>Medico en contexto</h2>
                        <span>@(SelectedDoctor is null ? "Sin seleccion" : "Agenda activa")</span>
                    </div>

                    <div class="availability-context-grid">
                        <div>
                            <label class="form-label" for="availabilityDoctorSelector">Medico</label>
                            <select id="availabilityDoctorSelector" class="form-select" value="@availabilityDoctorId" @onchange="OnAvailabilityDoctorChanged">
                                @foreach (var doctor in doctors)
                                {
                                    <option value="@doctor.id_medico">@GetDoctorDisplayName(doctor)</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="form-label">Especialidad</label>
                            <input class="form-control" value="@(SelectedDoctor?.especialidad ?? "Sin especialidad registrada")" readonly />
                        </div>

                        <div>
                            <label class="form-label">Licencia</label>
                            <input class="form-control" value="@(SelectedDoctor?.numero_licencia ?? "Sin licencia")" readonly />
                        </div>
                    </div>
                </section>
            }

            <section class="management-card availability-filter-card">
                <div class="management-card-header">
                    <h2>Filtros</h2>
                    <span>@FilteredAvailabilityRows.Count disponibilidades | @FilteredBlocks.Count bloqueos</span>
                </div>

                <p style="margin-bottom: 1rem; color: var(--color-taupe); font-size: 0.9rem;">
                    Filtra solo lo que ya esta cargado para el medico activo. El cambio de medico se hace aparte para no mezclar contexto con filtros.
                </p>

                <div class="availability-filters-grid">
                    <div>
                        <label class="form-label" for="dayFilter">Dia</label>
                        <select id="dayFilter" class="form-select" @bind="selectedDayFilter">
                            <option value="0">Todos</option>
                            @foreach (var option in dayOptions)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label" for="blockTypeFilter">Tipo de bloqueo</label>
                        <select id="blockTypeFilter" class="form-select" @bind="selectedBlockTypeFilter">
                            <option value="">Todos</option>
                            @foreach (var option in blockTypeOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>

                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ClearFilters" style="padding: 0.3rem 0.7rem !important; font-size: 0.78rem !important; border-color: rgba(127,105,81,0.25) !important; min-height: auto !important; height: 32px !important; display: inline-flex; align-items: center; gap: 0.45rem; margin-bottom: 4px;">
                        <i class="bi bi-trash"></i>
                        <span>Limpiar filtros</span>
                    </button>
                </div>

                @if (!doctors.Any())
                {
                    <div class="alert alert-warning" role="alert" style="margin-top: 1rem;">
                        No hay medicos disponibles para gestionar disponibilidad.
                    </div>
                }
            </section>
        </div>

        <section class="management-card">
            <div class="management-card-header">
                <h2>Panel operativo</h2>
                <span>Disponibilidad y bloqueos</span>
            </div>

            <div class="user-summary-grid" style="margin-bottom: 1.25rem;">
                <div class="user-summary-card">
                    <span class="eyebrow">Disponibilidad</span>
                    <strong>@FilteredAvailabilityRows.Count</strong>
                    <p>Bloques activos de horario para el medico en contexto.</p>
                </div>

                <div class="user-summary-card">
                    <span class="eyebrow">Bloqueos</span>
                    <strong>@FilteredBlocks.Count</strong>
                    <p>Ausencias y excepciones registradas con los filtros actuales.</p>
                </div>

                <div class="user-summary-card">
                    <span class="eyebrow">Contexto</span>
                    <strong>@(SelectedDoctor is null ? "Sin medico" : GetDoctorShortName(SelectedDoctor))</strong>
                    <p>@(SelectedDoctor?.especialidad ?? "Selecciona o verifica el medico activo para trabajar con claridad.")</p>
                </div>
            </div>

            <div class="availability-records-grid">
                <section class="availability-record-panel">
                        <div class="management-card-header" style="margin-bottom: 0.9rem;">
                            <h2>Disponibilidad registrada</h2>
                            <span>@FilteredAvailabilityRows.Count filas</span>
                        </div>

                        <div class="management-list">
                            @if (FilteredAvailabilityRows.Count == 0)
                            {
                                <p>No hay disponibilidad registrada para el medico y filtros seleccionados.</p>
                            }
                            else
                            {
                                @foreach (var row in PagedAvailabilityRows)
                                {
                                    <article class="management-list-item availability-row">
                                        <div class="availability-row-copy">
                                            <strong>@(row.nombre_dia ?? GetDayLabel(row.dia_semana))</strong>
                                            <span>@($"{row.hora_inicio:HH\\:mm} - {row.hora_fin:HH\\:mm}")</span>
                                            <span>@GetBreakLabel(row)</span>
                                            <span>@(string.IsNullOrWhiteSpace(row.observaciones) ? "Sin observaciones" : row.observaciones)</span>
                                        </div>
                                        @if (CanManageAvailability)
                                        {
                                            <div class="availability-row-actions">
                                                <button type="button" class="availability-icon-button is-edit" title="Editar" aria-label="Editar disponibilidad" @onclick="() => OpenEditAvailabilityModal(row)">
                                                    <i class="bi bi-pencil-fill"></i>
                                                </button>
                                                <button type="button" class="availability-icon-button is-delete" title="Eliminar" aria-label="Eliminar disponibilidad" @onclick="() => AskDeleteAvailability(row.id_disponibilidad)">
                                                    <i class="bi bi-trash3-fill"></i>
                                                </button>
                                            </div>
                                        }
                                    </article>
                                }
                            }
                        </div>

                        <div class="table-pager availability-pager">
                            <button type="button" class="btn btn-outline-primary compact-action" @onclick="PreviousAvailabilityPage" disabled="@(CurrentAvailabilityPage <= 1)">Anterior</button>
                            <span>Pagina @CurrentAvailabilityPage de @TotalAvailabilityPages</span>
                            <button type="button" class="btn btn-outline-primary compact-action" @onclick="NextAvailabilityPage" disabled="@(CurrentAvailabilityPage >= TotalAvailabilityPages)">Siguiente</button>
                        </div>
                </section>

                <section class="availability-record-panel">
                        <div class="management-card-header" style="margin-bottom: 0.9rem;">
                            <h2>Bloqueos registrados</h2>
                            <span>@FilteredBlocks.Count filas</span>
                        </div>

                        <div class="management-list">
                            @if (FilteredBlocks.Count == 0)
                            {
                                <p>No hay bloqueos registrados para el medico y filtros seleccionados.</p>
                            }
                            else
                            {
                                @foreach (var block in PagedBlocks)
                                {
                                    <article class="management-list-item availability-row">
                                        <div class="availability-row-copy">
                                            <strong>@block.tipo_bloqueo</strong>
                                            <span>@($"{block.fecha_inicio:yyyy-MM-dd} al {block.fecha_fin:yyyy-MM-dd}")</span>
                                            <span>@GetBlockTimeLabel(block)</span>
                                            <span>@(string.IsNullOrWhiteSpace(block.razon_bloqueo) ? "Sin razon" : block.razon_bloqueo)</span>
                                        </div>
                                        @if (CanManageAvailability)
                                        {
                                            <div class="availability-row-actions">
                                                <button type="button" class="availability-icon-button is-edit" title="Editar" aria-label="Editar bloqueo" @onclick="() => OpenEditBlockModal(block)">
                                                    <i class="bi bi-pencil-fill"></i>
                                                </button>
                                                <button type="button" class="availability-icon-button is-delete" title="Eliminar" aria-label="Eliminar bloqueo" @onclick="() => AskDeleteBlock(block.id_bloqueo)">
                                                    <i class="bi bi-trash3-fill"></i>
                                                </button>
                                            </div>
                                        }
                                    </article>
                                }
                            }
                        </div>

                        <div class="table-pager availability-pager">
                            <button type="button" class="btn btn-outline-primary compact-action" @onclick="PreviousBlockPage" disabled="@(CurrentBlockPage <= 1)">Anterior</button>
                            <span>Pagina @CurrentBlockPage de @TotalBlockPages</span>
                            <button type="button" class="btn btn-outline-primary compact-action" @onclick="NextBlockPage" disabled="@(CurrentBlockPage >= TotalBlockPages)">Siguiente</button>
                        </div>
                </section>
            </div>
        </section>
    </section>
}

@if (showAvailabilityModal)
{
    <div class="custom-modal-overlay" @onclick="CloseAvailabilityModal">
        <div class="custom-modal-card form-modal-card" @onclick:stopPropagation="true">
            <header class="custom-modal-header rose-header">
                <h2>@(availabilityEditor.IdDisponibilidad > 0 ? "Editar disponibilidad" : "Nueva disponibilidad")</h2>
                <button type="button" class="btn-close-modal" @onclick="CloseAvailabilityModal">×</button>
            </header>

            <div class="custom-modal-body">
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger" role="alert">@errorMessage</div>
                }

                <p style="margin-bottom: 1rem; color: var(--color-taupe); font-size: 0.9rem;">
                    Define la jornada semanal, descanso y observaciones antes de guardar.
                </p>

                <div class="management-form-grid">
                    <div>
                        <label class="form-label" for="availabilityDay">Dia</label>
                        <select id="availabilityDay" class="form-select" @bind="availabilityEditor.DayOfWeek" disabled="@(!CanManageAvailability)">
                            @foreach (var option in dayOptions)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label" for="availabilityStart">Hora inicio</label>
                        <input id="availabilityStart" type="time" class="form-control" value="@availabilityEditor.StartTime" @onchange="OnAvailabilityStartChanged" readonly="@(!CanManageAvailability)" />
                    </div>

                    <div>
                        <label class="form-label" for="availabilityEnd">Hora fin</label>
                        <input id="availabilityEnd" type="time" class="form-control" value="@availabilityEditor.EndTime" @onchange="OnAvailabilityEndChanged" readonly="@(!CanManageAvailability)" />
                    </div>

                    <div>
                        <label class="form-label" for="availabilityBreakStart">Descanso inicio</label>
                        <input id="availabilityBreakStart" type="time" class="form-control" value="@availabilityEditor.BreakStart" @onchange="OnAvailabilityBreakStartChanged" readonly="@(!CanManageAvailability)" />
                    </div>

                    <div>
                        <label class="form-label" for="availabilityBreakEnd">Descanso fin</label>
                        <input id="availabilityBreakEnd" type="time" class="form-control" value="@availabilityEditor.BreakEnd" @onchange="OnAvailabilityBreakEndChanged" readonly="@(!CanManageAvailability)" />
                    </div>

                    <div>
                        <label class="form-label" for="availabilityNotes">Observaciones</label>
                        <input id="availabilityNotes" class="form-control" @bind="availabilityEditor.Observaciones" maxlength="500" readonly="@(!CanManageAvailability)" />
                    </div>
                </div>
            </div>

            <footer class="custom-modal-footer">
                <button type="button" class="btn btn-primary" @onclick="SaveAvailabilityAsync">Guardar disponibilidad</button>
                <button type="button" class="btn btn-outline-primary" @onclick="CloseAvailabilityModal">Cerrar</button>
            </footer>
        </div>
    </div>
}

@if (showBlockModal)
{
    <div class="custom-modal-overlay" @onclick="CloseBlockModal">
        <div class="custom-modal-card form-modal-card" @onclick:stopPropagation="true">
            <header class="custom-modal-header rose-header">
                <h2>@(blockEditor.IdBloqueo > 0 ? "Editar bloqueo" : "Nuevo bloqueo")</h2>
                <button type="button" class="btn-close-modal" @onclick="CloseBlockModal">×</button>
            </header>

            <div class="custom-modal-body">
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger" role="alert">@errorMessage</div>
                }

                <p style="margin-bottom: 1rem; color: var(--color-taupe); font-size: 0.9rem;">
                    Registra ausencias completas, permisos parciales o el horario de almuerzo cuando deban cerrar agenda real.
                </p>

                <div class="management-form-grid">
                    <div>
                        <label class="form-label" for="blockStart">Fecha inicio</label>
                        <input id="blockStart" type="date" class="form-control" value="@blockEditor.FechaInicio" @onchange="OnBlockStartChanged" readonly="@(!CanManageAvailability)" min="@TodayDateIso" />
                    </div>

                    <div>
                        <label class="form-label" for="blockEnd">Fecha fin</label>
                        <input id="blockEnd" type="date" class="form-control" value="@blockEditor.FechaFin" @onchange="OnBlockEndChanged" readonly="@(!CanManageAvailability)" min="@blockEditor.FechaInicio" />
                    </div>

                    <div>
                        <label class="form-label" for="blockScope">Alcance</label>
                        <select id="blockScope" class="form-select" @bind="blockEditor.AlcanceBloqueo" disabled="@(!CanManageAvailability)">
                            @foreach (var option in blockScopeOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label" for="blockType">Tipo</label>
                        <select id="blockType" class="form-select" @bind="blockEditor.TipoBloqueo" disabled="@(!CanManageAvailability)">
                            @foreach (var option in blockTypeOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label" for="blockStartTime">Hora inicio</label>
                        <input id="blockStartTime" type="time" class="form-control" value="@blockEditor.HoraInicio" @onchange="OnBlockTimeStartChanged" disabled="@IsBlockTimeDisabled" />
                    </div>

                    <div>
                        <label class="form-label" for="blockEndTime">Hora fin</label>
                        <input id="blockEndTime" type="time" class="form-control" value="@blockEditor.HoraFin" @onchange="OnBlockTimeEndChanged" disabled="@IsBlockTimeDisabled" />
                    </div>

                    <div>
                        <label class="form-label" for="blockReason">Razon</label>
                        <input id="blockReason" class="form-control" @bind="blockEditor.Razon" maxlength="300" readonly="@(!CanManageAvailability)" />
                    </div>
                </div>
            </div>

            <footer class="custom-modal-footer">
                <button type="button" class="btn btn-primary" @onclick="SaveBlockAsync">Guardar bloqueo</button>
                <button type="button" class="btn btn-outline-primary" @onclick="CloseBlockModal">Cerrar</button>
            </footer>
        </div>
    </div>
}

@if (showActionModal)
{
    <div class="custom-modal-overlay" @onclick="CloseActionModal">
        <div class="custom-modal-card alert-modal-card" @onclick:stopPropagation="true">
            <header class="custom-modal-header @(actionModalKind == ActionModalKind.Error ? "error-header" : actionModalKind == ActionModalKind.Success ? "success-header" : "rose-header")">
                <h2>@actionModalTitle</h2>
            </header>

            <div class="custom-modal-body" style="padding: 2rem 1.5rem; text-align: center;">
                <p style="margin: 0; color: var(--color-taupe-deep); font-weight: 700;">@actionModalMessage</p>
            </div>

            <footer class="custom-modal-footer" style="justify-content: center;">
                @if (actionModalKind == ActionModalKind.Confirm)
                {
                    <button type="button" class="btn btn-primary" @onclick="ConfirmPendingDeleteAsync">Si, eliminar</button>
                    <button type="button" class="btn btn-outline-primary" @onclick="CloseActionModal">Cancelar</button>
                }
                else
                {
                    <button type="button" class="btn btn-primary" @onclick="CloseActionModal">Aceptar</button>
                }
            </footer>
        </div>
    </div>
}

@code {
    private readonly List<tbl_medico> doctors = [];
    private readonly List<tbl_disponibilidad_medico> currentAvailabilityRows = [];
    private readonly List<tbl_bloqueo_horarios> currentBlocks = [];
    private ModulePermissions permissions = new();
    private AvailabilityEditor availabilityEditor = new();
    private BlockEditor blockEditor = new();
    private tbl_medico? currentDoctorProfile;
    private bool isLoading = true;
    private bool canViewModule;
    private bool isAdmin;
    private bool isDoctor;
    private bool showAvailabilityModal;
    private bool showBlockModal;
    private bool showActionModal;
    private ActionModalKind actionModalKind;
    private PendingDeleteKind pendingDeleteKind;
    private int pendingDeleteId;
    private int currentUserId;
    private int currentRoleId;
    private int currentDoctorId;
    private int availabilityDoctorId;
    private int availabilityPage = 1;
    private int blockPage = 1;
    private int selectedDayFilter;
    private string selectedBlockTypeFilter = string.Empty;
    private string currentRoleName = string.Empty;
    private string? errorMessage;
    private string actionModalTitle = string.Empty;
    private string actionModalMessage = string.Empty;
    private string TodayDateIso => DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
    private const int AvailabilityPageSize = 3;

    private static readonly string[] blockTypeOptions = ["Vacaciones", "Enfermedad", "Permiso parcial", "Almuerzo", "Mantenimiento", "Otro"];
    private static readonly string[] blockScopeOptions = ["Completo", "Parcial", "Almuerzo"];
    private static readonly DayOption[] dayOptions =
    [
        new((byte)1, "Lunes"),
        new((byte)2, "Martes"),
        new((byte)3, "Miercoles"),
        new((byte)4, "Jueves"),
        new((byte)5, "Viernes"),
        new((byte)6, "Sabado"),
        new((byte)7, "Domingo")
    ];

    private bool CanManageAvailability => permissions.CanEdit && (isAdmin || (isDoctor && currentDoctorProfile?.puede_gestionar_disponibilidad != false));
    private tbl_medico? SelectedDoctor => doctors.FirstOrDefault(d => d.id_medico == availabilityDoctorId);
    private bool IsBlockTimeDisabled => !CanManageAvailability || string.Equals(blockEditor.AlcanceBloqueo, "Completo", StringComparison.OrdinalIgnoreCase);
    private string HeroTitle => isAdmin ? "Disponibilidad y bloqueos de todos los medicos" : "Mi disponibilidad y ausencias";
    private string HeroDescription => isAdmin
        ? "Administra horarios semanales, descansos y bloqueos de todo el equipo medico en una sola vista operativa."
        : "Mantiene tus horarios de atencion y tus ausencias fuera del flujo de citas para trabajar con mas claridad.";

    private List<tbl_disponibilidad_medico> FilteredAvailabilityRows => currentAvailabilityRows
        .Where(x => selectedDayFilter == 0 || x.dia_semana == selectedDayFilter)
        .OrderBy(x => x.dia_semana)
        .ThenBy(x => x.hora_inicio)
        .ToList();

    private List<tbl_bloqueo_horarios> FilteredBlocks => currentBlocks
        .Where(x => string.IsNullOrWhiteSpace(selectedBlockTypeFilter) || string.Equals(x.tipo_bloqueo, selectedBlockTypeFilter, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(x => x.fecha_inicio)
        .ToList();
    private int CurrentAvailabilityPage => Math.Clamp(availabilityPage, 1, TotalAvailabilityPages);
    private int CurrentBlockPage => Math.Clamp(blockPage, 1, TotalBlockPages);
    private IEnumerable<tbl_disponibilidad_medico> PagedAvailabilityRows => FilteredAvailabilityRows
        .Skip((CurrentAvailabilityPage - 1) * AvailabilityPageSize)
        .Take(AvailabilityPageSize);
    private IEnumerable<tbl_bloqueo_horarios> PagedBlocks => FilteredBlocks
        .Skip((CurrentBlockPage - 1) * AvailabilityPageSize)
        .Take(AvailabilityPageSize);
    private int TotalAvailabilityPages => Math.Max(1, (int)Math.Ceiling(FilteredAvailabilityRows.Count / (double)AvailabilityPageSize));
    private int TotalBlockPages => Math.Max(1, (int)Math.Ceiling(FilteredBlocks.Count / (double)AvailabilityPageSize));

    protected override async Task OnInitializedAsync()
    {
        PrepareNewAvailability();
        PrepareNewBlock();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var parsedUserId) ? parsedUserId : 0;
        currentRoleId = int.TryParse(authState.User.FindFirst("RoleId")?.Value, out var parsedRoleId) ? parsedRoleId : 0;
        currentRoleName = authState.User.FindFirst(ClaimTypes.Role)?.Value ?? string.Empty;
        isAdmin = currentRoleId == 1 || currentRoleName.Contains("admin", StringComparison.OrdinalIgnoreCase);
        isDoctor = currentRoleName.Contains("doctor", StringComparison.OrdinalIgnoreCase)
            || currentRoleName.Contains("medic", StringComparison.OrdinalIgnoreCase)
            || currentRoleName.Contains("optomet", StringComparison.OrdinalIgnoreCase);

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        permissions = await GetModulePermissionsAsync(dbContext, currentRoleId);
        canViewModule = permissions.CanView;

        if (!canViewModule)
        {
            isLoading = false;
            return;
        }

        doctors.Clear();
        doctors.AddRange(await dbContext.tbl_medico
            .AsNoTracking()
            .Include(m => m.id_usuarioNavigation)
            .Where(m => m.activo == true && m.id_usuarioNavigation.activo == true)
            .OrderBy(m => m.id_usuarioNavigation.apellidos)
            .ThenBy(m => m.id_usuarioNavigation.nombres)
            .ToListAsync());

        if (isDoctor)
        {
            currentDoctorProfile = doctors.FirstOrDefault(d => d.id_usuario == currentUserId);
            currentDoctorId = currentDoctorProfile?.id_medico ?? 0;
        }

        availabilityDoctorId = currentDoctorId > 0 ? currentDoctorId : availabilityDoctorId > 0 ? availabilityDoctorId : doctors.FirstOrDefault()?.id_medico ?? 0;
        await LoadAvailabilityAsync(dbContext);
        isLoading = false;
    }

    private async Task LoadAvailabilityAsync(OpticaDbContext dbContext)
    {
        currentAvailabilityRows.Clear();
        currentBlocks.Clear();

        if (availabilityDoctorId <= 0)
        {
            return;
        }

        currentAvailabilityRows.AddRange(await dbContext.tbl_disponibilidad_medico
            .AsNoTracking()
            .Where(x => x.id_medico == availabilityDoctorId)
            .OrderBy(x => x.dia_semana)
            .ThenBy(x => x.hora_inicio)
            .ToListAsync());

        currentBlocks.AddRange(await dbContext.tbl_bloqueo_horarios
            .AsNoTracking()
            .Where(x => x.id_medico == availabilityDoctorId && x.activo == true)
            .OrderByDescending(x => x.fecha_inicio)
            .ToListAsync());
    }

    private async Task SaveAvailabilityAsync()
    {
        errorMessage = null;

        if (!CanManageAvailability || availabilityDoctorId <= 0)
        {
            return;
        }

        if (availabilityEditor.DayOfWeek is < 1 or > 7)
        {
            errorMessage = "Selecciona un dia valido para la disponibilidad.";
            return;
        }

        if (!TimeOnly.TryParse(availabilityEditor.StartTime, out var startTime) || !TimeOnly.TryParse(availabilityEditor.EndTime, out var endTime) || startTime >= endTime)
        {
            errorMessage = "Verifica el rango horario de la disponibilidad.";
            return;
        }

        TimeOnly? breakStart = TimeOnly.TryParse(availabilityEditor.BreakStart, out var parsedBreakStart) ? parsedBreakStart : null;
        TimeOnly? breakEnd = TimeOnly.TryParse(availabilityEditor.BreakEnd, out var parsedBreakEnd) ? parsedBreakEnd : null;
        if (breakStart.HasValue != breakEnd.HasValue)
        {
            errorMessage = "Completa ambas horas del descanso o deja ambas vacias.";
            return;
        }

        if (breakStart.HasValue && breakEnd.HasValue && (breakStart.Value >= breakEnd.Value || breakStart.Value < startTime || breakEnd.Value > endTime))
        {
            errorMessage = "El descanso debe quedar dentro de la jornada.";
            return;
        }

        var normalizedObservations = NormalizeOptional(availabilityEditor.Observaciones);
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var duplicateExists = await dbContext.tbl_disponibilidad_medico
            .AsNoTracking()
            .AnyAsync(x =>
                x.id_medico == availabilityDoctorId &&
                x.id_disponibilidad != availabilityEditor.IdDisponibilidad &&
                x.dia_semana == availabilityEditor.DayOfWeek &&
                x.hora_inicio == startTime &&
                x.hora_fin == endTime &&
                x.hora_descanso_inicio == breakStart &&
                x.hora_descanso_fin == breakEnd &&
                x.observaciones == normalizedObservations);

        if (duplicateExists)
        {
            errorMessage = "Ya existe una disponibilidad exactamente igual para este medico.";
            return;
        }

        tbl_disponibilidad_medico entity;
        if (availabilityEditor.IdDisponibilidad > 0)
        {
            entity = await dbContext.tbl_disponibilidad_medico.FirstOrDefaultAsync(x => x.id_disponibilidad == availabilityEditor.IdDisponibilidad && x.id_medico == availabilityDoctorId)
                ?? new tbl_disponibilidad_medico();
        }
        else
        {
            entity = new tbl_disponibilidad_medico();
            dbContext.tbl_disponibilidad_medico.Add(entity);
        }

        entity.id_medico = availabilityDoctorId;
        entity.dia_semana = availabilityEditor.DayOfWeek;
        entity.nombre_dia = GetDayLabel(availabilityEditor.DayOfWeek);
        entity.hora_inicio = startTime;
        entity.hora_fin = endTime;
        entity.permitir_descanso_medio_dia = breakStart.HasValue && breakEnd.HasValue;
        entity.hora_descanso_inicio = breakStart;
        entity.hora_descanso_fin = breakEnd;
        entity.disponible = true;
        entity.observaciones = normalizedObservations;
        entity.fecha_actualizacion = DateTime.Now;
        entity.usuario_actualizacion = GetCurrentActorLabel();

        await dbContext.SaveChangesAsync();
        WriteAudit(dbContext, availabilityEditor.IdDisponibilidad > 0 ? "Editar disponibilidad" : "Crear disponibilidad", $"MedicoId={availabilityDoctorId}; DisponibilidadId={entity.id_disponibilidad}; Dia={entity.dia_semana}; HoraInicio={entity.hora_inicio:HH\\:mm}; HoraFin={entity.hora_fin:HH\\:mm}");
        await dbContext.SaveChangesAsync();

        PrepareNewAvailability();
        showAvailabilityModal = false;
        await using var refreshContext = await DbContextFactory.CreateDbContextAsync();
        await LoadAvailabilityAsync(refreshContext);
        ShowActionResult("Guardado", "La disponibilidad fue guardada correctamente.", false);
    }

    private async Task DeleteAvailabilityAsync(int availabilityId)
    {
        if (!CanManageAvailability || availabilityId <= 0)
        {
            ShowActionResult("Error", "No tienes permisos para eliminar esta disponibilidad.", true);
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var entity = await dbContext.tbl_disponibilidad_medico.FirstOrDefaultAsync(x => x.id_disponibilidad == availabilityId && x.id_medico == availabilityDoctorId);
        if (entity is null)
        {
            ShowActionResult("Error", "No se encontro la disponibilidad seleccionada.", true);
            return;
        }

        dbContext.tbl_disponibilidad_medico.Remove(entity);
        WriteAudit(dbContext, "Eliminar disponibilidad", $"MedicoId={availabilityDoctorId}; DisponibilidadId={availabilityId}");
        await dbContext.SaveChangesAsync();

        PrepareNewAvailability();
        await using var refreshContext = await DbContextFactory.CreateDbContextAsync();
        await LoadAvailabilityAsync(refreshContext);
        ShowActionResult("Eliminado", "La disponibilidad fue eliminada correctamente.", false);
    }

    private async Task SaveBlockAsync()
    {
        errorMessage = null;

        if (!CanManageAvailability || availabilityDoctorId <= 0)
        {
            return;
        }

        if (!DateOnly.TryParse(blockEditor.FechaInicio, out var startDate) || !DateOnly.TryParse(blockEditor.FechaFin, out var endDate) || startDate > endDate)
        {
            errorMessage = "Verifica el rango de fechas del bloqueo.";
            return;
        }

        if (startDate < DateOnly.FromDateTime(DateTime.Today))
        {
            errorMessage = "No puedes registrar bloqueos con fecha inicial en el pasado.";
            return;
        }

        TimeOnly? blockTimeStart = null;
        TimeOnly? blockTimeEnd = null;
        if (!string.Equals(blockEditor.AlcanceBloqueo, "Completo", StringComparison.OrdinalIgnoreCase))
        {
            if (!TimeOnly.TryParse(blockEditor.HoraInicio, out var parsedBlockStart) || !TimeOnly.TryParse(blockEditor.HoraFin, out var parsedBlockEnd) || parsedBlockStart >= parsedBlockEnd)
            {
                errorMessage = "Para un permiso parcial o un almuerzo debes indicar una hora valida de inicio y fin.";
                return;
            }

            blockTimeStart = parsedBlockStart;
            blockTimeEnd = parsedBlockEnd;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        tbl_bloqueo_horarios entity;
        if (blockEditor.IdBloqueo > 0)
        {
            entity = await dbContext.tbl_bloqueo_horarios.FirstOrDefaultAsync(x => x.id_bloqueo == blockEditor.IdBloqueo && x.id_medico == availabilityDoctorId)
                ?? new tbl_bloqueo_horarios();
        }
        else
        {
            entity = new tbl_bloqueo_horarios
            {
                fecha_creacion = DateTime.Now,
                usuario_creacion = GetCurrentActorLabel()
            };
            dbContext.tbl_bloqueo_horarios.Add(entity);
        }

        entity.id_medico = availabilityDoctorId;
        entity.fecha_inicio = startDate;
        entity.fecha_fin = endDate;
        entity.alcance_bloqueo = blockEditor.AlcanceBloqueo;
        entity.hora_inicio = blockTimeStart;
        entity.hora_fin = blockTimeEnd;
        entity.tipo_bloqueo = blockEditor.TipoBloqueo;
        entity.razon_bloqueo = NormalizeOptional(blockEditor.Razon);
        entity.activo = true;

        await dbContext.SaveChangesAsync();
        var automaticRescheduleResult = await RescheduleAppointmentsForBlockAsync(dbContext, availabilityDoctorId, entity, entity.id_bloqueo);
        WriteAudit(
            dbContext,
            blockEditor.IdBloqueo > 0 ? "Editar bloqueo horario" : "Crear bloqueo horario",
            $"MedicoId={availabilityDoctorId}; BloqueoId={entity.id_bloqueo}; Inicio={entity.fecha_inicio:yyyy-MM-dd}; Fin={entity.fecha_fin:yyyy-MM-dd}; Reprogramadas={automaticRescheduleResult.ReprogrammedCount}; Pendientes={automaticRescheduleResult.UnresolvedAppointmentIds.Count}");
        await dbContext.SaveChangesAsync();

        PrepareNewBlock();
        showBlockModal = false;
        await using var refreshContext = await DbContextFactory.CreateDbContextAsync();
        await LoadAvailabilityAsync(refreshContext);
        var actionMessage = automaticRescheduleResult.ReprogrammedCount > 0
            ? $"El bloqueo fue guardado correctamente y se reprogramaron {automaticRescheduleResult.ReprogrammedCount} cita(s)."
            : "El bloqueo fue guardado correctamente.";

        if (automaticRescheduleResult.UnresolvedAppointmentIds.Count > 0)
        {
            actionMessage += $" Quedaron {automaticRescheduleResult.UnresolvedAppointmentIds.Count} cita(s) sin cupo automatico: {string.Join(", ", automaticRescheduleResult.UnresolvedAppointmentIds)}.";
        }

        ShowActionResult("Guardado", actionMessage, automaticRescheduleResult.UnresolvedAppointmentIds.Count > 0);
    }

    private async Task DeleteBlockAsync(int blockId)
    {
        if (!CanManageAvailability || blockId <= 0)
        {
            ShowActionResult("Error", "No tienes permisos para eliminar este bloqueo.", true);
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var entity = await dbContext.tbl_bloqueo_horarios.FirstOrDefaultAsync(x => x.id_bloqueo == blockId && x.id_medico == availabilityDoctorId);
        if (entity is null)
        {
            ShowActionResult("Error", "No se encontro el bloqueo seleccionado.", true);
