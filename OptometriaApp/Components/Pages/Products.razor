@code {
    private readonly List<tbl_producto> products = [];
    private readonly List<tbl_categoria_producto> categories = [];
    private readonly List<tbl_proveedor> suppliers = [];
    private readonly string[] productStateOptions = ["Disponible", "Descontinuado", "Agotado", "Especial Orden"];
    private readonly string[] productTypeOptions = ["Producto"];
    private readonly string[] movementFrequencyOptions = ["Alta", "Media", "Baja"];
    private readonly string[] natureOptions = [ProductInventoryRules.GoodNature, ProductInventoryRules.ServiceNature];
    private decimal[] ivaPercentageOptions = [0m, 5m, 15m];
    private decimal defaultIvaPercentage = 15m;
    private List<tbl_log_auditoria> auditEntries = [];
    private ProductEditorModel? editor;
    private ModulePermissions permissions = new();
    private bool isLoading = true;
    private bool canViewProducts;
    private bool isCreatingNewProduct;
    private int currentUserId;
    private string currentUserName = string.Empty;
    private int currentRoleId;
    private string searchTerm = string.Empty;
    private string selectedCategoryFilter = string.Empty;
    private string selectedSupplierFilter = string.Empty;
    private string selectedStatusFilter = "all";
    private string selectedStateFilter = string.Empty;
    private string selectedTypeFilter = string.Empty;
    private string? errorMessage;
    private bool showFormModal;
    private bool showAuditModal;
    private bool showAlertModal;
    private string alertMessage = string.Empty;
    private bool alertIsError;
    private tbl_producto? selectedProduct;
    private byte[]? pendingProductImageBytes;
    private string? pendingProductImageExtension;
    private string? pendingProductImagePreview;
    private const long MaxProductImageSize = 3 * 1024 * 1024;

    private List<tbl_producto> FilteredProducts => products
        .Where(MatchesFilters)
        .OrderBy(p => p.nombre_producto)
        .ThenBy(p => p.codigo_producto)
        .ToList();
    private int tablePageSize = 8;
    private int productPage = 1;
    private int EffectiveProductPage => Math.Min(productPage, Math.Max(1, (int)Math.Ceiling(FilteredProducts.Count / (double)tablePageSize)));
    private IEnumerable<tbl_producto> PagedProducts => FilteredProducts.Skip((EffectiveProductPage - 1) * tablePageSize).Take(tablePageSize);
    private void SetProductPage(int page) => productPage = page;
    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            tablePageSize = size;
            productPage = 1;
        }
    }

    private string EditorTitle => isCreatingNewProduct ? "Nuevo producto" : "Detalle del producto";
    private bool CanModifyEditor => isCreatingNewProduct ? permissions.CanCreate : permissions.CanEdit;
    private bool EditorIsService => string.Equals(editor?.NaturalezaItem, ProductInventoryRules.ServiceNature, StringComparison.OrdinalIgnoreCase);
    private bool EditorManagesInventory => !EditorIsService;
    private string? ProductImagePreviewUrl => pendingProductImagePreview ?? editor?.ImagenUrl;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var parsedUserId) ? parsedUserId : 0;
        currentRoleId = int.TryParse(authState.User.FindFirst("RoleId")?.Value, out var parsedRoleId) ? parsedRoleId : 0;
        currentUserName = authState.User.Identity?.Name ?? "Sistema";
        await LoadAsync();
    }

    private async Task LoadAsync(int? preserveSelectedProductId = null)
    {
        isLoading = true;
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        permissions = await GetModulePermissionsAsync(dbContext, currentRoleId);
        canViewProducts = permissions.CanView;

        if (!canViewProducts)
        {
            isLoading = false;
            return;
        }

        defaultIvaPercentage = await CustomizationService.GetActiveVatPercentageAsync();
        ivaPercentageOptions = await CustomizationService.GetAvailableVatRatesAsync();

        var loadedProducts = await dbContext.tbl_productos
            .AsNoTracking()
            .Include(p => p.id_categoriaNavigation)
            .Include(p => p.id_proveedorNavigation)
            .ToListAsync();

        var loadedCategories = await dbContext.tbl_categoria_productos
            .AsNoTracking()
            .OrderBy(c => c.nombre)
            .ToListAsync();

        var loadedSuppliers = await dbContext.tbl_proveedors
            .AsNoTracking()
            .OrderBy(s => s.nombre)
            .ToListAsync();

        products.Clear();
        products.AddRange(loadedProducts);
        categories.Clear();
        categories.AddRange(loadedCategories);
        suppliers.Clear();
        suppliers.AddRange(loadedSuppliers);

        if (preserveSelectedProductId.HasValue)
        {
            selectedProduct = products.FirstOrDefault(p => p.id_producto == preserveSelectedProductId.Value);
            editor = BuildEditor(selectedProduct);
        }

        isLoading = false;
    }

