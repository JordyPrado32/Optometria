    private void ClearFilters()
    {
        searchTerm = string.Empty;
        selectedCategoryFilter = string.Empty;
        selectedSupplierFilter = string.Empty;
        selectedStatusFilter = "all";
        selectedStateFilter = string.Empty;
        selectedTypeFilter = string.Empty;
    }

    private void ExportProducts()
    {
        var query = new List<string>();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query.Add($"search={Uri.EscapeDataString(searchTerm)}");
        }

        if (!string.IsNullOrWhiteSpace(selectedCategoryFilter))
        {
            query.Add($"categoryId={Uri.EscapeDataString(selectedCategoryFilter)}");
        }

        if (!string.IsNullOrWhiteSpace(selectedTypeFilter))
        {
            query.Add($"nature={Uri.EscapeDataString(selectedTypeFilter)}");
        }

        if (!string.IsNullOrWhiteSpace(selectedSupplierFilter))
        {
            query.Add($"supplierId={Uri.EscapeDataString(selectedSupplierFilter)}");
        }

        if (selectedStatusFilter != "all")
        {
            query.Add($"status={Uri.EscapeDataString(selectedStatusFilter)}");
        }

        if (!string.IsNullOrWhiteSpace(selectedStateFilter))
        {
            query.Add($"state={Uri.EscapeDataString(selectedStateFilter)}");
        }

        var exportUrl = query.Count == 0
            ? "/exports/products.csv"
            : $"/exports/products.csv?{string.Join("&", query)}";

        NavigationManager.NavigateTo(exportUrl, forceLoad: true);
    }

    private bool MatchesFilters(tbl_producto product)
    {
        if (selectedStatusFilter is "active" or "inactive")
        {
            var expectedStatus = selectedStatusFilter == "active";
            if ((product.activo ?? false) != expectedStatus)
            {
                return false;
            }
        }

        if (!string.IsNullOrWhiteSpace(selectedStateFilter) &&
            !string.Equals(product.estado_producto, selectedStateFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (!string.IsNullOrWhiteSpace(selectedTypeFilter) &&
            !string.Equals(ProductInventoryRules.NormalizeNature(product.naturaleza_item), selectedTypeFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (int.TryParse(selectedCategoryFilter, out var categoryId) && categoryId > 0 && product.id_categoria != categoryId)
        {
            return false;
        }

        if (int.TryParse(selectedSupplierFilter, out var supplierId) && supplierId > 0 && product.id_proveedor != supplierId)
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return true;
        }

        var search = searchTerm.Trim().ToLowerInvariant();
        return product.codigo_producto.ToLowerInvariant().Contains(search) ||
               product.nombre_producto.ToLowerInvariant().Contains(search) ||
               (product.descripcion?.ToLowerInvariant().Contains(search) ?? false) ||
               (product.codigo_barras?.ToLowerInvariant().Contains(search) ?? false) ||
               (product.marca?.ToLowerInvariant().Contains(search) ?? false) ||
               (product.modelo?.ToLowerInvariant().Contains(search) ?? false) ||
               (product.etiquetas?.ToLowerInvariant().Contains(search) ?? false);
    }

    private bool ValidateEditor()
    {
        if (editor is null)
        {
            errorMessage = "No hay un producto seleccionado.";
            return false;
        }

        NormalizeEditorForCurrentNature();
        editor.CodigoProducto = editor.CodigoProducto.Trim();
        editor.NombreProducto = editor.NombreProducto.Trim();
        editor.CodigoBarras = editor.CodigoBarras.Trim();
        editor.TipoItem = ProductInventoryRules.ProductType;

        if (string.IsNullOrWhiteSpace(editor.CodigoProducto) || string.IsNullOrWhiteSpace(editor.NombreProducto))
        {
            errorMessage = "Completa el codigo y el nombre del producto.";
            return false;
        }

        if (!productTypeOptions.Contains(editor.TipoItem, StringComparer.OrdinalIgnoreCase))
        {
            errorMessage = "Selecciona un tipo de item valido.";
            return false;
        }

        if (!editor.IdCategoria.HasValue || editor.IdCategoria.Value <= 0)
        {
            errorMessage = "Selecciona una categoria para el producto.";
            return false;
        }

        if (editor.PrecioVenta < 0 || editor.PrecioCosto < 0)
        {
            errorMessage = "Los precios no pueden ser negativos.";
            return false;
        }

        if (editor.PorcentajeIva < 0)
        {
            errorMessage = "El porcentaje de IVA no puede ser negativo.";
            return false;
        }

        if (editor.StockActual < 0 || editor.StockMinimo < 0 || editor.StockMaximo < 0 || editor.PuntoReorden < 0 || editor.CantidadEmpaque < 0)
        {
            errorMessage = "Los campos de inventario no pueden ser negativos.";
            return false;
        }

        if (editor.PorcentajeMargen < 0 || editor.DescuentoMayorista < 0 || editor.DescuentoClienteFijo < 0 || editor.PorcentajeDescuentoPromo < 0)
        {
            errorMessage = "Los porcentajes no pueden ser negativos.";
            return false;
        }

        if (editor.CodigoBarras.Length > 50)
        {
            errorMessage = "El codigo de barras excede la longitud permitida.";
            return false;
        }

        return true;
    }

    private async Task<ModulePermissions> GetModulePermissionsAsync(OpticaDbContext dbContext, int roleId)
    {
        if (roleId <= 0)
        {
            return new ModulePermissions();
        }

        var permission = await dbContext.tbl_rol_menu_permisos
            .AsNoTracking()
            .Where(p => p.id_rol == roleId)
            .Join(
                dbContext.tbl_menu_apps.AsNoTracking().Where(m => m.ruta == "/productos"),
                rolePermission => rolePermission.id_menu,
                menu => menu.id_menu,
                (rolePermission, _) => rolePermission)
            .FirstOrDefaultAsync();

        return permission is null
            ? new ModulePermissions()
            : new ModulePermissions
            {
                CanView = permission.puede_ver,
                CanCreate = permission.puede_crear,
                CanEdit = permission.puede_editar,
                CanDelete = permission.puede_eliminar
            };
    }

