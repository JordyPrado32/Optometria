    private async Task SaveProductAsync()
    {
        errorMessage = null;

        if (!ValidateEditor())
        {
            ShowAlert(errorMessage ?? "Corrige los datos del formulario.", true);
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var normalizedCode = editor!.CodigoProducto.Trim().ToLowerInvariant();
        var normalizedBarcode = editor.CodigoBarras.Trim().ToLowerInvariant();

        var codeExists = await dbContext.tbl_productos
            .AnyAsync(p => p.id_producto != editor.IdProducto && p.codigo_producto.ToLower() == normalizedCode);

        if (codeExists)
        {
            ShowAlert("Ya existe un producto con el mismo codigo.", true);
            return;
        }

        if (!string.IsNullOrWhiteSpace(normalizedBarcode))
        {
            var barcodeExists = await dbContext.tbl_productos
                .AnyAsync(p => p.id_producto != editor.IdProducto && p.codigo_barras != null && p.codigo_barras.ToLower() == normalizedBarcode);

            if (barcodeExists)
            {
                ShowAlert("El codigo de barras ya existe.", true);
                return;
            }
        }

        tbl_producto productEntity;
        if (isCreatingNewProduct)
        {
            if (!permissions.CanCreate)
            {
                ShowAlert("Tu rol no tiene permiso para crear productos.", true);
                return;
            }

            productEntity = new tbl_producto
            {
                fecha_creacion = DateTime.Now,
                usuario_creacion = currentUserName
            };
            dbContext.tbl_productos.Add(productEntity);
        }
        else
        {
            if (!permissions.CanEdit)
            {
                ShowAlert("Tu rol no tiene permiso para editar productos.", true);
                return;
            }

            productEntity = await dbContext.tbl_productos.FirstOrDefaultAsync(p => p.id_producto == editor.IdProducto)
                ?? throw new InvalidOperationException("No se encontró el producto seleccionado.");
        }

        NormalizeEditorForCurrentNature();
        if (pendingProductImageBytes is not null)
        {
            editor.ImagenUrl = await SaveProductImageAsync(editor.CodigoProducto);
        }

        var initialStock = EditorManagesInventory ? editor.StockActual : 0;
        ApplyEditorToEntity(productEntity, preserveExistingStock: !isCreatingNewProduct);
        productEntity.id_usuario_actualizacion = currentUserId > 0 ? currentUserId : null;

        await dbContext.SaveChangesAsync();

        if (isCreatingNewProduct && initialStock > 0)
        {
            dbContext.tbl_movimiento_inventarios.Add(new tbl_movimiento_inventario
            {
                id_producto = productEntity.id_producto,
                id_usuario = currentUserId,
                fecha_movimiento = DateTime.Now,
                tipo_movimiento = "Entrada",
                cantidad = initialStock,
                stock_anterior = 0,
                stock_resultante = initialStock,
                tipo_documento_referencia = "StockInicial",
                observaciones = "Stock inicial del producto",
                metodo_valuacion = "Promedio",
                costo_unitario = productEntity.precio_costo
            });

            await dbContext.SaveChangesAsync();
            await KardexService.RebuildForProductAsync(productEntity.id_producto, currentUserId, "Stock inicial producto");
        }

        WriteAudit(
            dbContext,
            isCreatingNewProduct ? "Crear producto" : "Editar producto",
            $"ProductoId={productEntity.id_producto}; Codigo={productEntity.codigo_producto}; Nombre={productEntity.nombre_producto}; EstadoProducto={productEntity.estado_producto}");

        await dbContext.SaveChangesAsync();

        ShowAlert(
            isCreatingNewProduct
                ? "El producto se creó correctamente."
                : "La información del producto se guardó correctamente.",
            false);

        showFormModal = false;
        isCreatingNewProduct = false;
        ClearPendingProductImage();
        await LoadAsync(productEntity.id_producto);
    }

