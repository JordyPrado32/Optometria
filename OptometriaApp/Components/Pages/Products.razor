    private async Task DeleteProductAsync(tbl_producto product)
    {
        if (!permissions.CanDelete)
        {
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var productEntity = await dbContext.tbl_productos
            .Include(p => p.tbl_detalle_venta)
            .Include(p => p.tbl_movimiento_inventarios)
            .FirstOrDefaultAsync(p => p.id_producto == product.id_producto);

        if (productEntity is null)
        {
            ShowAlert("No se encontró el producto seleccionado.", true);
            return;
        }

        if (productEntity.tbl_detalle_venta.Count > 0 || productEntity.tbl_movimiento_inventarios.Count > 0)
        {
            ShowAlert("No puedes eliminar un producto con ventas o movimientos asociados.", true);
            return;
        }

        WriteAudit(
            dbContext,
            "Eliminar producto",
            $"ProductoId={productEntity.id_producto}; Codigo={productEntity.codigo_producto}; Nombre={productEntity.nombre_producto}");

        dbContext.tbl_productos.Remove(productEntity);
        await dbContext.SaveChangesAsync();

        ShowAlert("El producto fue eliminado correctamente.", false);
        selectedProduct = null;
        await LoadAsync();
    }

