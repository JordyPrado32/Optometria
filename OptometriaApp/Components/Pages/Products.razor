    private static string? NormalizeOptional(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }

    private async Task OnProductImageSelected(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            ShowAlert("Selecciona una imagen valida en formato JPG, PNG o WebP.", true);
            return;
        }

        if (file.Size > MaxProductImageSize)
        {
            ShowAlert("La imagen no debe superar 3 MB.", true);
            return;
        }

        await using var stream = file.OpenReadStream(MaxProductImageSize);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);

        pendingProductImageBytes = memory.ToArray();
        pendingProductImageExtension = GetSafeImageExtension(file.Name, file.ContentType);
        pendingProductImagePreview = $"data:{file.ContentType};base64,{Convert.ToBase64String(pendingProductImageBytes)}";
    }

    private void ClearProductImage()
    {
        if (editor is not null)
        {
            editor.ImagenUrl = string.Empty;
        }

        ClearPendingProductImage();
    }

    private void ClearPendingProductImage()
    {
        pendingProductImageBytes = null;
        pendingProductImageExtension = null;
        pendingProductImagePreview = null;
    }

    private async Task<string> SaveProductImageAsync(string productCode)
    {
        var extension = pendingProductImageExtension ?? ".jpg";
        var safeCode = new string(productCode.Trim().ToLowerInvariant()
            .Select(ch => char.IsLetterOrDigit(ch) ? ch : '-')
            .ToArray())
            .Trim('-');

        if (string.IsNullOrWhiteSpace(safeCode))
        {
            safeCode = Guid.NewGuid().ToString("N");
        }

        var fileName = $"{safeCode}-{DateTime.Now:yyyyMMddHHmmss}{extension}";
        var folder = Path.Combine(WebHostEnvironment.WebRootPath, "images", "products");
        Directory.CreateDirectory(folder);
        var fullPath = Path.Combine(folder, fileName);
        await File.WriteAllBytesAsync(fullPath, pendingProductImageBytes!);
        return $"/images/products/{fileName}";
    }

    private static string GetSafeImageExtension(string fileName, string contentType)
    {
        var extension = Path.GetExtension(fileName).ToLowerInvariant();
        if (extension is ".jpg" or ".jpeg" or ".png" or ".webp")
        {
            return extension;
        }

        return contentType.ToLowerInvariant() switch
        {
            "image/png" => ".png",
            "image/webp" => ".webp",
            _ => ".jpg"
        };
    }

    private void NormalizeEditorForCurrentNature()
    {
        if (editor is null)
        {
            return;
        }

        editor.NaturalezaItem = ProductInventoryRules.NormalizeNature(editor.NaturalezaItem);
        editor.TipoItem = ProductInventoryRules.ProductType;

        if (!EditorIsService)
        {
            if (editor.CantidadEmpaque <= 0)
            {
                editor.CantidadEmpaque = 1;
            }

            return;
        }

        editor.StockActual = 0;
        editor.StockMinimo = 0;
        editor.StockMaximo = 0;
        editor.PuntoReorden = 0;
        editor.CantidadEmpaque = 0;
        editor.Almacen = string.Empty;
        editor.Pasillo = string.Empty;
        editor.Estante = string.Empty;
        editor.Nivel = string.Empty;
        editor.PesoUnitario = 0;
        editor.DimensionesLargo = 0;
        editor.DimensionesAncho = 0;
        editor.DimensionesAlto = 0;
        editor.VolumenM3 = 0;
        editor.RequiereLote = false;
        editor.RequiereFechaVencimiento = false;
        editor.DiasVencimiento = 0;
        editor.FechaUltimaCompra = null;
        editor.CantidadMovimientosMes = 0;
    }

    private static string GetAuditActorLabel(tbl_log_auditoria auditEntry)
    {
        return auditEntry.id_usuarioNavigation is null
            ? "Responsable: Sistema"
            : $"Responsable: {auditEntry.id_usuarioNavigation.usuario}";
    }

    private static string GetInnermostMessage(Exception ex)
    {
        while (ex.InnerException is not null)
        {
            ex = ex.InnerException;
        }

        return ex.Message;
    }

    private void WriteAudit(OpticaDbContext dbContext, string action, string detail)
    {
        dbContext.tbl_log_auditoria.Add(new tbl_log_auditoria
        {
            id_usuario = currentUserId > 0 ? currentUserId : null,
            accion = action,
            modulo = "Productos",
            fecha = DateTime.Now,
            detalle = detail
        });
    }

