    private static string BuildSlotKey(TimeOnly start, TimeOnly end) => $"{start:HH\\:mm}|{end:HH\\:mm}";

    private static TimeOnly GetSlotStart(string slotKey)
    {
        return TryParseSlot(slotKey, out var start, out _) ? start : TimeOnly.MinValue;
    }

    private static int CountScheduleSlots(tbl_disponibilidad_medico schedule, int durationMinutes, IEnumerable<tbl_bloqueo_horarios>? dayBlocks = null, DateOnly? date = null)
    {
        var count = 0;
        var cursor = schedule.hora_inicio;

        while (cursor < schedule.hora_fin && cursor.ToTimeSpan().Add(TimeSpan.FromMinutes(durationMinutes)) <= schedule.hora_fin.ToTimeSpan())
        {
            var slotEnd = cursor.AddMinutes(durationMinutes);
            var overlapsBreak = schedule.hora_descanso_inicio.HasValue &&
                schedule.hora_descanso_fin.HasValue &&
                cursor < schedule.hora_descanso_fin.Value &&
                slotEnd > schedule.hora_descanso_inicio.Value;
            var overlapsBlock = date.HasValue && dayBlocks is not null && SlotOverlapsAnyBlock(dayBlocks, date.Value, cursor, slotEnd);

            if (!overlapsBreak && !overlapsBlock)
            {
                count++;
            }

            cursor = cursor.AddMinutes(durationMinutes);
        }

        return count;
    }

