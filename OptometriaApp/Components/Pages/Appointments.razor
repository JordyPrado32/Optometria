        return appointment.id_pacienteNavigation.id_usuario == currentUserId ||
               appointment.id_pacienteNavigation.id_usuario_registro == currentUserId;
    }

    private static AppointmentEditorModel? BuildAppointmentEditor(tbl_citas? appointment)
    {
        if (appointment is null)
        {
            return null;
        }

        var isSelfAppointment = appointment.id_pacienteNavigation.id_usuario.HasValue;

        return new AppointmentEditorModel
        {
            IdCita = appointment.id_cita,
            IdMedico = appointment.id_medico,
            IdPaciente = appointment.id_paciente,
            FechaCita = appointment.fecha_cita.ToString("yyyy-MM-dd"),
            SelectedSlotKey = BuildSlotKey(appointment.hora_inicio, appointment.hora_fin),
            TipoCita = string.IsNullOrWhiteSpace(appointment.tipo_cita) ? "Presencial" : appointment.tipo_cita!,
            Motivo = appointment.motivo_cita ?? string.Empty,
            Descripcion = appointment.descripcion_adicional ?? string.Empty,
            Estado = appointment.id_estadoNavigation?.nombre_estado ?? "Sin estado",
            NotasMedico = appointment.notas_medico ?? string.Empty,
            RazonCancelacion = appointment.razon_cancelacion ?? string.Empty,
            TargetType = isSelfAppointment ? "self" : "family",
            FamilyPatientId = isSelfAppointment ? 0 : appointment.id_paciente,
            FamilyCedula = isSelfAppointment ? string.Empty : appointment.id_pacienteNavigation.cedula,
            FamilyNames = isSelfAppointment ? string.Empty : appointment.id_pacienteNavigation.nombres,
            FamilyLastNames = isSelfAppointment ? string.Empty : appointment.id_pacienteNavigation.apellidos,
            FamilyPhone = isSelfAppointment ? string.Empty : appointment.id_pacienteNavigation.telefono ?? string.Empty,
            FamilyBirthDate = isSelfAppointment ? string.Empty : appointment.id_pacienteNavigation.fecha_nacimiento?.ToString("yyyy-MM-dd") ?? string.Empty
        };
    }

    private static string GetDoctorDisplayName(tbl_medico doctor)
    {
        var fullName = $"{doctor.id_usuarioNavigation.nombres} {doctor.id_usuarioNavigation.apellidos}".Trim();
        return string.IsNullOrWhiteSpace(doctor.especialidad)
            ? fullName
            : $"{fullName} - {doctor.especialidad}";
    }

    private static string GetPatientDisplayName(tbl_paciente patient)
    {
        return $"{patient.nombres} {patient.apellidos}".Trim();
    }

    private static string GetAppointmentTitle(tbl_citas appointment)
    {
        return $"{GetPatientDisplayName(appointment.id_pacienteNavigation)}";
    }

    private static string BuildSlotKey(TimeOnly start, TimeOnly end) => $"{start:HH\\:mm}|{end:HH\\:mm}";

    private static bool TryParseSlot(string? rawSlot, out TimeOnly start, out TimeOnly end)
    {
        start = default;
        end = default;

        if (string.IsNullOrWhiteSpace(rawSlot))
        {
            return false;
        }

        var parts = rawSlot.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length == 2 &&
               TimeOnly.TryParse(parts[0], out start) &&
               TimeOnly.TryParse(parts[1], out end) &&
               start < end;
    }

    private static byte ToDatabaseDayOfWeek(DayOfWeek dayOfWeek) => dayOfWeek switch
    {
        DayOfWeek.Monday => 1,
        DayOfWeek.Tuesday => 2,
        DayOfWeek.Wednesday => 3,
        DayOfWeek.Thursday => 4,
        DayOfWeek.Friday => 5,
        DayOfWeek.Saturday => 6,
        _ => 7
    };

    private static string GetDayLabel(byte dayOfWeek)
    {
        return dayOptions.FirstOrDefault(x => x.Value == dayOfWeek)?.Label ?? $"Dia {dayOfWeek}";
    }

    private static string GetBreakLabel(tbl_disponibilidad_medico row)
    {
        if (!row.hora_descanso_inicio.HasValue || !row.hora_descanso_fin.HasValue)
        {
            return "Sin descanso";
        }

        return $"Descanso {row.hora_descanso_inicio:HH\\:mm}-{row.hora_descanso_fin:HH\\:mm}";
    }

    private static bool IsPendingState(string? stateName)
    {
        return stateName is "Programada" or "Confirmada" or "Reprogramada";
    }

    private static string? NormalizeOptional(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }

    private static int? CalculateAge(DateOnly? birthDate)
    {
        if (!birthDate.HasValue)
        {
            return null;
        }

        var today = DateOnly.FromDateTime(DateTime.Today);
        var age = today.Year - birthDate.Value.Year;
        if (birthDate.Value > today.AddYears(-age))
        {
            age--;
        }

        return age < 0 ? null : age;
    }

    private static string GeneratePatientCode()
    {
        return $"PAC-{DateTime.Now:yyyyMMddHHmmssfff}";
    }

    private string GetCurrentActorLabel()
    {
        return currentUserId > 0 ? currentUserId.ToString() : "SYSTEM";
    }

    private void WriteAudit(OpticaDbContext dbContext, string action, string detail)
    {
        dbContext.tbl_log_auditoria.Add(new tbl_log_auditoria
        {
            id_usuario = currentUserId > 0 ? currentUserId : null,
            accion = action,
            modulo = "Citas",
            fecha = DateTime.Now,
            detalle = detail
        });
    }

