    private bool ValidateAppointmentEditor()
    {
        if (appointmentEditor is null)
        {
            errorMessage = "No hay una cita activa en edicion.";
            return false;
        }

        appointmentEditor.Motivo = appointmentEditor.Motivo.Trim();
        appointmentEditor.Descripcion = appointmentEditor.Descripcion.Trim();
        appointmentEditor.NotasMedico = appointmentEditor.NotasMedico.Trim();
        appointmentEditor.RazonCancelacion = appointmentEditor.RazonCancelacion.Trim();

        if (appointmentEditor.IdMedico <= 0)
        {
            errorMessage = "Selecciona un medico.";
            return false;
        }

        if ((isAdmin || isDoctor) && appointmentEditor.IdPaciente <= 0)
        {
            errorMessage = "Selecciona un paciente.";
            return false;
        }

        if (isClient && appointmentEditor.TargetType == "family")
        {
            if (appointmentEditor.FamilyPatientId <= 0)
            {
                appointmentEditor.FamilyCedula = appointmentEditor.FamilyCedula.Trim();
                appointmentEditor.FamilyNames = appointmentEditor.FamilyNames.Trim();
                appointmentEditor.FamilyLastNames = appointmentEditor.FamilyLastNames.Trim();
                appointmentEditor.FamilyPhone = appointmentEditor.FamilyPhone.Trim();

                if (string.IsNullOrWhiteSpace(appointmentEditor.FamilyCedula) ||
                    string.IsNullOrWhiteSpace(appointmentEditor.FamilyNames) ||
                    string.IsNullOrWhiteSpace(appointmentEditor.FamilyLastNames))
                {
                    errorMessage = "Completa cedula, nombres y apellidos del familiar.";
                    return false;
                }
            }
        }

        if (!DateOnly.TryParse(appointmentEditor.FechaCita, out var appointmentDate))
        {
            errorMessage = "La fecha de la cita no es valida.";
            return false;
        }

        if (appointmentDate < DateOnly.FromDateTime(DateTime.Today))
        {
            errorMessage = "No se pueden agendar citas en fechas pasadas.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(appointmentEditor.SelectedSlotKey))
        {
            errorMessage = "Selecciona un horario disponible.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(appointmentEditor.Motivo))
        {
            errorMessage = "Escribe el motivo de la cita.";
            return false;
        }

        return true;
    }

    private string GetCurrentAppointmentPatientLabel()
    {
        if (appointmentEditor is null)
        {
            return linkedPatient is null ? "Sin paciente" : GetPatientDisplayName(linkedPatient);
        }

        if (!isClient)
        {
            var currentPatient = patients.FirstOrDefault(p => p.id_paciente == appointmentEditor.IdPaciente);
            return currentPatient is null ? "Sin paciente seleccionado" : GetPatientDisplayName(currentPatient);
        }

        if (appointmentEditor.TargetType == "family")
        {
            if (appointmentEditor.FamilyPatientId > 0)
            {
                var familyPatient = clientFamilyPatients.FirstOrDefault(p => p.id_paciente == appointmentEditor.FamilyPatientId);
                return familyPatient is null ? "Familiar seleccionado" : GetPatientDisplayName(familyPatient);
            }

            var familyName = $"{appointmentEditor.FamilyNames} {appointmentEditor.FamilyLastNames}".Trim();
            return string.IsNullOrWhiteSpace(familyName) ? "Nuevo familiar" : familyName;
        }

        return linkedPatient is null
            ? "Se generara tu ficha rapida de paciente"
            : GetPatientDisplayName(linkedPatient);
    }

    private async Task<tbl_paciente?> ResolveAppointmentPatientAsync(OpticaDbContext dbContext)
    {
        if (appointmentEditor is null)
        {
            errorMessage = "No hay un paciente seleccionado.";
            return null;
        }

        if (!isClient)
        {
            var selectedPatient = await dbContext.tbl_pacientes.FirstOrDefaultAsync(p => p.id_paciente == appointmentEditor.IdPaciente && p.activo == true);
            if (selectedPatient is null)
            {
                errorMessage = "Selecciona un paciente valido.";
            }

            return selectedPatient;
        }

        if (appointmentEditor.TargetType == "family")
        {
            if (appointmentEditor.FamilyPatientId > 0)
            {
                var familyPatient = await dbContext.tbl_pacientes.FirstOrDefaultAsync(p =>
                    p.id_paciente == appointmentEditor.FamilyPatientId &&
                    p.activo == true &&
                    (p.id_usuario_registro == currentUserId || p.id_usuario == currentUserId));

                if (familyPatient is null)
                {
                    errorMessage = "Selecciona un familiar valido.";
                }

                return familyPatient;
            }

            var normalizedCedula = appointmentEditor.FamilyCedula.Trim().ToLowerInvariant();
            var existingFamilyPatient = await dbContext.tbl_pacientes.FirstOrDefaultAsync(p => p.cedula.ToLower() == normalizedCedula);
            if (existingFamilyPatient is not null && existingFamilyPatient.id_usuario_registro != currentUserId && existingFamilyPatient.id_usuario != currentUserId)
            {
                errorMessage = "La cedula del familiar ya pertenece a otra ficha registrada.";
                return null;
            }

            if (existingFamilyPatient is not null)
            {
                existingFamilyPatient.nombres = appointmentEditor.FamilyNames.Trim();
                existingFamilyPatient.apellidos = appointmentEditor.FamilyLastNames.Trim();
                existingFamilyPatient.telefono = NormalizeOptional(appointmentEditor.FamilyPhone);
                existingFamilyPatient.fecha_nacimiento = DateOnly.TryParse(appointmentEditor.FamilyBirthDate, out var existingBirthDate) ? existingBirthDate : existingFamilyPatient.fecha_nacimiento;
                existingFamilyPatient.edad = CalculateAge(existingFamilyPatient.fecha_nacimiento);
                existingFamilyPatient.activo = true;
                existingFamilyPatient.id_usuario_registro ??= currentUserId;
                return existingFamilyPatient;
            }

            var birthDate = DateOnly.TryParse(appointmentEditor.FamilyBirthDate, out var parsedBirthDate) ? (DateOnly?)parsedBirthDate : null;
            var newFamilyPatient = new tbl_paciente
            {
                codigo_paciente = GeneratePatientCode(),
                cedula = appointmentEditor.FamilyCedula.Trim(),
                nombres = appointmentEditor.FamilyNames.Trim(),
                apellidos = appointmentEditor.FamilyLastNames.Trim(),
                fecha_nacimiento = birthDate,
                edad = CalculateAge(birthDate),
                telefono = NormalizeOptional(appointmentEditor.FamilyPhone),
                activo = true,
                fecha_registro = DateTime.Now,
                id_usuario_registro = currentUserId
            };

            dbContext.tbl_pacientes.Add(newFamilyPatient);
            return newFamilyPatient;
        }

        if (linkedPatient is not null)
        {
            var selfPatient = await dbContext.tbl_pacientes.FirstOrDefaultAsync(p => p.id_paciente == linkedPatient.id_paciente && p.activo == true);
            if (selfPatient is null)
            {
                errorMessage = "No se encontro tu ficha de paciente.";
            }

            return selfPatient;
        }

        var currentUser = await dbContext.tbl_usuarios.FirstOrDefaultAsync(u => u.id_usuario == currentUserId);
        if (currentUser is null)
        {
            errorMessage = "No se encontro el usuario autenticado.";
            return null;
        }

        var generatedCedula = $"TMPU{currentUserId:D8}";
        var generatedPatient = new tbl_paciente
        {
            codigo_paciente = GeneratePatientCode(),
            cedula = generatedCedula,
            nombres = currentUser.nombres,
            apellidos = currentUser.apellidos,
            telefono = currentUser.telefono,
            email = currentUser.email,
            activo = true,
            fecha_registro = DateTime.Now,
            id_usuario_registro = currentUserId,
            id_usuario = currentUserId,
            observaciones = "Ficha rapida creada desde agenda de citas."
        };

        dbContext.tbl_pacientes.Add(generatedPatient);
        return generatedPatient;
    }

    private void ExportAppointments()
    {
        var query = new List<string>();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query.Add($"search={Uri.EscapeDataString(searchTerm)}");
        }

        if (!string.IsNullOrWhiteSpace(selectedTemporalFilter))
        {
            query.Add($"period={Uri.EscapeDataString(selectedTemporalFilter)}");
        }

        if (!string.IsNullOrWhiteSpace(selectedStatusFilter))
        {
            query.Add($"status={Uri.EscapeDataString(selectedStatusFilter)}");
        }

        if (selectedDoctorFilter > 0)
        {
            query.Add($"doctorId={selectedDoctorFilter}");
        }

        if (!string.IsNullOrWhiteSpace(dateFromFilter))
        {
            query.Add($"dateFrom={Uri.EscapeDataString(dateFromFilter)}");
        }

        if (!string.IsNullOrWhiteSpace(dateToFilter))
        {
            query.Add($"dateTo={Uri.EscapeDataString(dateToFilter)}");
        }

        var exportUrl = query.Count == 0
            ? "/exports/appointments.csv"
            : $"/exports/appointments.csv?{string.Join("&", query)}";

        NavigationManager.NavigateTo(exportUrl, forceLoad: true);
    }

    private bool MatchesFilters(tbl_citas appointment)
    {
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var normalizedSearch = searchTerm.Trim().ToLowerInvariant();
            var doctorName = GetDoctorDisplayName(appointment.id_medicoNavigation).ToLowerInvariant();
            var patientName = GetPatientDisplayName(appointment.id_pacienteNavigation).ToLowerInvariant();
            var statusName = appointment.id_estadoNavigation?.nombre_estado?.ToLowerInvariant() ?? string.Empty;
            var typeName = appointment.tipo_cita?.ToLowerInvariant() ?? string.Empty;
            var reason = appointment.motivo_cita?.ToLowerInvariant() ?? string.Empty;

            if (!doctorName.Contains(normalizedSearch) &&
                !patientName.Contains(normalizedSearch) &&
                !statusName.Contains(normalizedSearch) &&
                !typeName.Contains(normalizedSearch) &&
                !reason.Contains(normalizedSearch))
            {
                return false;
            }
        }

        if (!string.IsNullOrWhiteSpace(selectedStatusFilter) &&
            !string.Equals(appointment.id_estadoNavigation?.nombre_estado, selectedStatusFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (selectedDoctorFilter > 0 && appointment.id_medico != selectedDoctorFilter)
        {
            return false;
        }

        var today = DateOnly.FromDateTime(DateTime.Today);
        switch (selectedTemporalFilter)
        {
            case "upcoming" when appointment.fecha_cita < today:
                return false;
            case "past" when appointment.fecha_cita >= today:
                return false;
            case "today" when appointment.fecha_cita != today:
                return false;
        }

        if (DateOnly.TryParse(dateFromFilter, out var dateFrom) && appointment.fecha_cita < dateFrom)
        {
            return false;
        }

        if (DateOnly.TryParse(dateToFilter, out var dateTo) && appointment.fecha_cita > dateTo)
        {
            return false;
        }

        return true;
    }

    private async Task<ModulePermissions> GetModulePermissionsAsync(OpticaDbContext dbContext, int roleId)
    {
        if (roleId <= 0)
        {
            return new ModulePermissions();
        }

        var permission = await dbContext.tbl_rol_menu_permisos
            .AsNoTracking()
            .Where(p => p.id_rol == roleId)
            .Join(
                dbContext.tbl_menu_apps.AsNoTracking().Where(m => m.ruta == "/appointments"),
                rolePermission => rolePermission.id_menu,
                menu => menu.id_menu,
                (rolePermission, _) => rolePermission)
            .FirstOrDefaultAsync();

        if (permission is null)
        {
            return new ModulePermissions();
        }

        return new ModulePermissions
        {
            CanView = permission.puede_ver,
            CanCreate = permission.puede_crear,
            CanEdit = permission.puede_editar,
            CanDelete = permission.puede_eliminar
        };
    }

    private bool CanAccessAppointment(tbl_citas appointment)
    {
        if (isAdmin)
