@code {
    [SupplyParameterFromQuery(Name = "patientId")]
    public int? PrefillPatientId { get; set; }

    [SupplyParameterFromQuery(Name = "reason")]
    public string? PrefillReason { get; set; }

    [SupplyParameterFromQuery(Name = "date")]
    public string? PrefillDate { get; set; }

    private readonly List<tbl_citas> appointments = [];
    private readonly List<tbl_medico> doctors = [];
    private readonly List<tbl_paciente> patients = [];
    private readonly List<tbl_paciente> clientFamilyPatients = [];
    private readonly List<tbl_estado_cita> appointmentStates = [];
    private readonly List<tbl_log_auditoria> appointmentAuditEntries = [];
    private readonly List<tbl_citas> selectedPatientHistory = [];
    private readonly List<SlotOption> availableSlots = [];
    private readonly List<SlotOption> occupiedSlots = [];
    private readonly List<CalendarDayOption> appointmentCalendarDays = [];
    private readonly List<tbl_disponibilidad_medico> currentAvailabilityRows = [];
    private readonly List<tbl_bloqueo_horarios> currentBlocks = [];

    private AppointmentEditorModel? appointmentEditor;
    private LinkedPatientEditor selfPatientEditor = new();
    private AvailabilityEditor availabilityEditor = new();
    private BlockEditor blockEditor = new();
    private ModulePermissions permissions = new();
    private tbl_medico? currentDoctorProfile;
    private tbl_paciente? linkedPatient;
    private tbl_citas? selectedAppointment;
    private bool isLoading = true;
    private bool canViewModule;
    private bool isAdmin;
    private bool isDoctor;
    private bool isReceptionist;
    private bool isClient;
    private bool isCreatingAppointment;
    private bool showFormModal;
    private bool showAuditModal;
    private bool showPatientHistoryModal;
    private bool showCalendarModal;
    private bool showCancellationChoiceModal;
    private bool showApiDraftModal;
    private bool showFormCancellationReason;
    private bool showSmartConfirmationModal;
    private bool hasPromptedInitialConfirmation;
    private tbl_citas? smartSelectedAppointment;
    private string smartCancelReason = string.Empty;
    private string assistedReceptionPhone = string.Empty;
    private string assistedLabPhone = string.Empty;
    private int selectedAppointmentId;
    private int currentUserId;
    private int currentRoleId;
    private int currentDoctorId;
    private int availabilityDoctorId;
    private string currentRoleName = string.Empty;
    private string currentUserName = string.Empty;
    private string searchTerm = string.Empty;
    private string selectedTemporalFilter = "upcoming";
    private string selectedStatusFilter = string.Empty;
    private int selectedDoctorFilter;
    private DateOnly appointmentCalendarMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private string dateFromFilter = string.Empty;
    private string dateToFilter = string.Empty;
    private string? statusMessage;
    private string? errorMessage;
    private ApiActionDraft? apiDraft;
    private bool hasConsumedPrefill;
    private string selectedCalendarView = "month";
    private string calendarFocusDate = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
    private string selectedPatientHistoryLabel = string.Empty;
    private string TodayDateIso => DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");

    private static readonly string[] appointmentTypeOptions = ["Presencial", "Telefónica", "Virtual"];
    private static readonly string[] CalendarWeekDays = ["Dom", "Lun", "Mar", "Mie", "Jue", "Vie", "Sab"];
    private static readonly string[] genderOptions = ["Femenino", "Masculino", "No binario", "Prefiero no decirlo"];
    private static readonly string[] blockTypeOptions = ["Vacaciones", "Enfermedad", "Permiso parcial", "Almuerzo", "Mantenimiento", "Otro"];
    private static readonly DayOption[] dayOptions =
    [
        new((byte)1, "Lunes"),
        new((byte)2, "Martes"),
        new((byte)3, "Miércoles"),
        new((byte)4, "Jueves"),
        new((byte)5, "Viernes"),
        new((byte)6, "Sábado"),
        new((byte)7, "Domingo")
    ];

    private bool CanCreateAppointments => permissions.CanCreate && (!isDoctor || currentDoctorProfile?.puede_gestionar_agenda != false);
    private bool CanEditAppointments => appointmentEditor is not null &&
        (isCreatingAppointment ? permissions.CanCreate : permissions.CanEdit) &&
        (!isDoctor || currentDoctorProfile?.puede_gestionar_agenda != false);
    private bool CanConfirmAppointments => appointmentEditor is not null && !isCreatingAppointment && (isAdmin || isDoctor || isClient);
    private bool CanCancelAppointments => appointmentEditor is not null && !isCreatingAppointment && permissions.CanDelete;
    private bool CanCloseAppointments => appointmentEditor is not null && !isCreatingAppointment && (isAdmin || (isDoctor && currentDoctorProfile?.puede_gestionar_historia_clinica != false));
    private bool CanViewPatientHistory => isAdmin || (!isClient && permissions.CanView);
    private bool CanManageAvailability => permissions.CanEdit && (isAdmin || (isDoctor && currentDoctorProfile?.puede_gestionar_disponibilidad != false));
    private bool CanWriteMedicalNotes => appointmentEditor is not null && (isAdmin || (isDoctor && currentDoctorProfile?.puede_gestionar_historia_clinica != false)) && permissions.CanEdit;
    private bool CanChangeDoctor => CanEditAppointments && (isAdmin || isReceptionist || (isDoctor && currentDoctorId == appointmentEditor!.IdMedico));
    private bool ShowCancellationReasonInForm => appointmentEditor is not null && (showFormCancellationReason || IsCanceledState(appointmentEditor.Estado));
    private string CurrentEditorLabel => isCreatingAppointment ? "Nuevo registro" : (selectedAppointmentId > 0 ? $"Cita #{selectedAppointmentId}" : "Sin selección");
    private string CurrentEditorModeLabel => appointmentEditor is null ? "Sin selección" : isCreatingAppointment ? "Creación" : CanEditAppointments ? "Edición" : "Consulta";
    private string CurrentPatientLabel => appointmentEditor is null
        ? linkedPatient is null ? "Sin paciente" : GetPatientDisplayName(linkedPatient)
        : GetCurrentAppointmentPatientLabel();
    private string EditorTitle => appointmentEditor is null
        ? "Detalle de la cita"
        : isCreatingAppointment
            ? "Crear cita nueva"
            : selectedAppointmentId > 0
                ? "Editar cita"
                : "Detalle de la cita";
    private string EditorStatusLabel => appointmentEditor is null ? "Sin datos" : CanEditAppointments ? "Edición habilitada" : "Solo lectura";
    private string EditorDescription => appointmentEditor is null
        ? "Selecciona una cita o crea una nueva."
        : isCreatingAppointment
            ? "Completa médico, paciente, fecha y horario para registrar una nueva cita sin perder el contexto de la agenda."
            : CanEditAppointments
                ? "Estás trabajando sobre una cita existente. Cualquier ajuste que guardes actualizará su agenda, estado o detalle."
                : "Estás revisando una cita existente en modo consulta.";
    private string HeroTitle => (isAdmin || isReceptionist) ? "Control total de citas y turnos" : isDoctor ? "Mi agenda médica" : "Mis citas y recordatorios";
    private string HeroDescription => (isAdmin || isReceptionist)
        ? "Consulta todas las citas del sistema, controla estados, agenda por cualquier paciente y exporta la operación filtrada."
        : isDoctor
            ? "Revisa todas tus citas asignadas, su motivo, su estado y mantén tu agenda diaria bajo control."
            : "Agenda para ti o para un familiar, revisa tus estados, filtra citas anteriores y reprograma o cancela cuando lo necesites.";
    private string AppointmentMonthLabel => CultureInfo.GetCultureInfo("es-ES").TextInfo.ToTitleCase(appointmentCalendarMonth.ToString("MMMM yyyy", CultureInfo.GetCultureInfo("es-ES")));
    private string SelectedAppointmentDateLabel => DateOnly.TryParse(appointmentEditor?.FechaCita, out var selectedDate)
        ? selectedDate.ToString("yyyy-MM-dd")
        : "fecha seleccionada";
    private IEnumerable<SlotDisplayOption> SchedulerSlots
    {
        get
        {
            var slots = occupiedSlots
                .Select(x => new SlotDisplayOption(x.Key, x.Label, true, GetSlotStart(x.Key)))
                .Concat(availableSlots.Select(x => new SlotDisplayOption(x.Key, x.Label.Split(" - ")[0], false, GetSlotStart(x.Key))));

            if (DateOnly.TryParse(appointmentEditor?.FechaCita, out var selectedDate) && selectedDate == DateOnly.FromDateTime(DateTime.Now))
            {
                var nowTime = TimeOnly.FromDateTime(DateTime.Now);
                slots = slots.Where(s => s.Start > nowTime || (appointmentEditor != null && s.Key == appointmentEditor.SelectedSlotKey));
            }

            return slots.OrderBy(x => x.Start);
        }
    }

    private List<tbl_citas> FilteredAppointments => appointments
        .Where(MatchesFilters)
        .OrderBy(a => a.fecha_cita)
        .ThenBy(a => a.hora_inicio)
        .ToList();
    private int tablePageSize = 8;
    private int appointmentPage = 1;
    private int EffectiveAppointmentPage => Math.Min(appointmentPage, Math.Max(1, (int)Math.Ceiling(FilteredAppointments.Count / (double)tablePageSize)));
    private IEnumerable<tbl_citas> PagedAppointments => FilteredAppointments.Skip((EffectiveAppointmentPage - 1) * tablePageSize).Take(tablePageSize);
    private void SetAppointmentPage(int page) => appointmentPage = page;
    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            tablePageSize = size;
            appointmentPage = 1;
        }
    }
    private int PendingAppointmentsCount => FilteredAppointments.Count(x => IsPendingState(x.id_estadoNavigation?.nombre_estado ?? string.Empty));
    private int ConfirmedAppointmentsCount => FilteredAppointments.Count(x => string.Equals(x.id_estadoNavigation?.nombre_estado, "Confirmada", StringComparison.OrdinalIgnoreCase));
    private int CompletedAppointmentsCount => FilteredAppointments.Count(x => string.Equals(x.id_estadoNavigation?.nombre_estado, "Realizada", StringComparison.OrdinalIgnoreCase));
    private int CancelledAppointmentsCount => FilteredAppointments.Count(x => string.Equals(x.id_estadoNavigation?.nombre_estado, "Cancelada", StringComparison.OrdinalIgnoreCase));
    private IEnumerable<tbl_citas> CalendarDayAppointments => FilteredAppointments.Where(x => x.fecha_cita == GetCalendarFocusDate()).OrderBy(x => x.hora_inicio);
    private IEnumerable<CalendarSummaryRow> WeeklyCalendarSummaries => BuildWeeklyCalendarSummaries();
    private IEnumerable<CalendarSummaryRow> MonthlyCalendarSummaries => BuildMonthlyCalendarSummaries();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync(int? focusAppointmentId = null)
    {
        isLoading = true;
        statusMessage = null;
        errorMessage = null;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var parsedUserId) ? parsedUserId : 0;
        currentRoleId = int.TryParse(authState.User.FindFirst("RoleId")?.Value, out var parsedRoleId) ? parsedRoleId : 0;
        currentRoleName = authState.User.FindFirst(ClaimTypes.Role)?.Value ?? string.Empty;
        currentUserName = authState.User.FindFirst(ClaimTypes.Name)?.Value
            ?? authState.User.FindFirst("FullName")?.Value
            ?? authState.User.Identity?.Name
            ?? string.Empty;

        isAdmin = currentRoleId == 1 || currentRoleName.Contains("admin", StringComparison.OrdinalIgnoreCase);
        isDoctor = currentRoleName.Contains("doctor", StringComparison.OrdinalIgnoreCase)
            || currentRoleName.Contains("medic", StringComparison.OrdinalIgnoreCase)
            || currentRoleName.Contains("optomet", StringComparison.OrdinalIgnoreCase);
        isReceptionist = currentRoleId == 2 || currentRoleName.Contains("recep", StringComparison.OrdinalIgnoreCase);
        isClient = !isAdmin && !isDoctor && !isReceptionist;

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        permissions = await GetModulePermissionsAsync(dbContext, currentRoleId);
        canViewModule = permissions.CanView;

        if (!canViewModule)
        {
            isLoading = false;
            return;
        }

        doctors.Clear();
        doctors.AddRange(await dbContext.tbl_medico
            .AsNoTracking()
            .Include(m => m.id_usuarioNavigation)
            .Where(m => m.activo == true && m.id_usuarioNavigation.activo == true)
            .OrderBy(m => m.id_usuarioNavigation.apellidos)
            .ThenBy(m => m.id_usuarioNavigation.nombres)
            .ToListAsync());

        if (isDoctor)
        {
            currentDoctorProfile = doctors.FirstOrDefault(d => d.id_usuario == currentUserId);
            currentDoctorId = currentDoctorProfile?.id_medico ?? 0;
        }

        availabilityDoctorId = currentDoctorId > 0 ? currentDoctorId : availabilityDoctorId > 0 ? availabilityDoctorId : doctors.FirstOrDefault()?.id_medico ?? 0;
        selectedDoctorFilter = isDoctor ? currentDoctorId : selectedDoctorFilter;

        appointmentStates.Clear();
        appointmentStates.AddRange(await dbContext.tbl_estado_cita.AsNoTracking().Where(s => s.activo == true).OrderBy(s => s.id_estado).ToListAsync());

        linkedPatient = null;
        clientFamilyPatients.Clear();
        var visibleClientPatients = new List<tbl_paciente>();
        if (isClient)
        {
            visibleClientPatients = await dbContext.tbl_pacientes
                .AsNoTracking()
                .Include(p => p.id_usuarioNavigation)
                .Where(p => p.activo == true && (p.id_usuario == currentUserId || p.id_usuario_registro == currentUserId))
                .OrderBy(p => p.apellidos)
                .ThenBy(p => p.nombres)
                .ToListAsync();

            linkedPatient = visibleClientPatients.FirstOrDefault(p => p.id_usuario == currentUserId);
            if (linkedPatient is not null)
            {
                selfPatientEditor.Cedula = linkedPatient.cedula ?? string.Empty;
                selfPatientEditor.FechaNacimiento = linkedPatient.fecha_nacimiento?.ToString("yyyy-MM-dd") ?? string.Empty;
                selfPatientEditor.Telefono = linkedPatient.telefono ?? string.Empty;
                selfPatientEditor.Genero = linkedPatient.genero ?? string.Empty;
                selfPatientEditor.Direccion = linkedPatient.direccion ?? string.Empty;
                selfPatientEditor.Observaciones = linkedPatient.observaciones ?? string.Empty;
                clientFamilyPatients.AddRange(visibleClientPatients.Where(p => p.id_paciente != linkedPatient.id_paciente));
            }
            else
            {
                clientFamilyPatients.AddRange(visibleClientPatients);
            }
        }

        patients.Clear();
        if (isAdmin || isDoctor || isReceptionist)
        {
            patients.AddRange(await dbContext.tbl_pacientes.AsNoTracking().Include(p => p.id_usuarioNavigation).Where(p => p.activo == true).OrderBy(p => p.apellidos).ThenBy(p => p.nombres).ToListAsync());
        }
        else
        {
            patients.AddRange(visibleClientPatients);
        }

        var appointmentsQuery = dbContext.tbl_citas
            .AsNoTracking()
            .Include(c => c.id_medicoNavigation).ThenInclude(m => m.id_usuarioNavigation)
            .Include(c => c.id_pacienteNavigation)
            .Include(c => c.id_estadoNavigation)
            .Include(c => c.id_disponibilidadNavigation)
            .AsQueryable();

        if (isAdmin || isReceptionist)
        {
        }
        else if (isDoctor)
        {
            appointmentsQuery = appointmentsQuery.Where(c => c.id_medicoNavigation.id_usuario == currentUserId);
        }
        else
        {
            appointmentsQuery = appointmentsQuery.Where(c =>
                c.id_pacienteNavigation.id_usuario == currentUserId ||
                c.id_pacienteNavigation.id_usuario_registro == currentUserId);
        }

        var loadedAppointments = await appointmentsQuery
            .OrderByDescending(c => c.fecha_cita)
            .ThenByDescending(c => c.hora_inicio)
            .ToListAsync();

        appointments.Clear();
        appointments.AddRange(loadedAppointments);

        await LoadAvailabilityAsync(dbContext);

        if (focusAppointmentId.HasValue)
        {
            await SelectAppointmentAsync(focusAppointmentId.Value, false);
        }
        else if (!isCreatingAppointment)
        {
            selectedAppointmentId = appointments.FirstOrDefault()?.id_cita ?? 0;
            if (selectedAppointmentId > 0)
            {
                await SelectAppointmentAsync(selectedAppointmentId, false);
            }
            else
            {
                appointmentEditor = null;
                selectedAppointment = null;
                appointmentAuditEntries.Clear();
            }
        }

        if (!hasConsumedPrefill && CanCreateAppointments && (PrefillPatientId.HasValue || !string.IsNullOrWhiteSpace(PrefillReason) || !string.IsNullOrWhiteSpace(PrefillDate)))
        {
            hasConsumedPrefill = true;
            await PrepareNewAppointmentAsync();
            ApplyPrefillToAppointmentEditor();
            showFormModal = true;
        }

        var contactNumbers = await CustomizationService.GetAssistedContactNumbersAsync();
        assistedReceptionPhone = contactNumbers.ReceptionPhone;
        assistedLabPhone = contactNumbers.LabPhone;

        if (!hasPromptedInitialConfirmation && !showFormModal && !showSmartConfirmationModal)
        {
            var todayDate = DateOnly.FromDateTime(DateTime.Today);
            var pendingAppt = appointments.FirstOrDefault(c =>
                (string.Equals(c.id_estadoNavigation?.nombre_estado, "Programada", StringComparison.OrdinalIgnoreCase) ||
                 string.Equals(c.id_estadoNavigation?.nombre_estado, "Reprogramada", StringComparison.OrdinalIgnoreCase)) &&
                c.fecha_cita >= todayDate);

            if (pendingAppt != null)
            {
                hasPromptedInitialConfirmation = true;
                OpenSmartConfirmationModal(pendingAppt);
            }
        }

        isLoading = false;
    }

    private async Task LoadAvailabilityAsync(OpticaDbContext dbContext)
    {
        currentAvailabilityRows.Clear();
        currentBlocks.Clear();

        if (!CanManageAvailability || availabilityDoctorId <= 0)
        {
            return;
        }

        currentAvailabilityRows.AddRange(await dbContext.tbl_disponibilidad_medico
            .AsNoTracking()
            .Where(x => x.id_medico == availabilityDoctorId)
            .OrderBy(x => x.dia_semana)
            .ThenBy(x => x.hora_inicio)
            .ToListAsync());

        currentBlocks.AddRange(await dbContext.tbl_bloqueo_horarios
            .AsNoTracking()
            .Where(x => x.id_medico == availabilityDoctorId && x.activo == true)
            .OrderByDescending(x => x.fecha_inicio)
            .ToListAsync());
    }

