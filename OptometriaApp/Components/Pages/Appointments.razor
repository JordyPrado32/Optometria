    private DateOnly GetCalendarFocusDate()
        => DateOnly.TryParse(calendarFocusDate, out var parsedDate) ? parsedDate : DateOnly.FromDateTime(DateTime.Today);

    private string GetCalendarViewLabel()
        => selectedCalendarView switch
        {
            "day" => $"día {GetCalendarFocusDate():yyyy-MM-dd}",
            "week" => $"semana de {GetStartOfWeek(GetCalendarFocusDate().ToDateTime(TimeOnly.MinValue)):yyyy-MM-dd}",
            _ => $"{GetCalendarFocusDate():yyyy-MM}"
        };

    private IEnumerable<CalendarSummaryRow> BuildWeeklyCalendarSummaries()
    {
        var start = DateOnly.FromDateTime(GetStartOfWeek(GetCalendarFocusDate().ToDateTime(TimeOnly.MinValue)));
        return Enumerable.Range(0, 7)
            .Select(offset => start.AddDays(offset))
            .Select(date =>
            {
                var dayAppointments = FilteredAppointments.Where(x => x.fecha_cita == date).ToList();
                return new CalendarSummaryRow(
                    date.ToString("yyyy-MM-dd"),
                    dayAppointments.Count,
                    dayAppointments.Count(x => IsPendingState(x.id_estadoNavigation?.nombre_estado ?? string.Empty)),
                    dayAppointments.Count(x => string.Equals(x.id_estadoNavigation?.nombre_estado, "Confirmada", StringComparison.OrdinalIgnoreCase)),
                    dayAppointments.Count(x => string.Equals(x.id_estadoNavigation?.nombre_estado, "Realizada", StringComparison.OrdinalIgnoreCase)),
                    dayAppointments.Count(x => string.Equals(x.id_estadoNavigation?.nombre_estado, "Cancelada", StringComparison.OrdinalIgnoreCase)));
            });
    }

    private IEnumerable<CalendarSummaryRow> BuildMonthlyCalendarSummaries()
    {
        var focus = GetCalendarFocusDate();
        return FilteredAppointments
            .Where(x => x.fecha_cita.Year == focus.Year && x.fecha_cita.Month == focus.Month)
            .GroupBy(x => x.fecha_cita)
            .OrderBy(x => x.Key)
            .Select(group => new CalendarSummaryRow(
                group.Key.ToString("yyyy-MM-dd"),
                group.Count(),
                group.Count(x => IsPendingState(x.id_estadoNavigation?.nombre_estado ?? string.Empty)),
                group.Count(x => string.Equals(x.id_estadoNavigation?.nombre_estado, "Confirmada", StringComparison.OrdinalIgnoreCase)),
                group.Count(x => string.Equals(x.id_estadoNavigation?.nombre_estado, "Realizada", StringComparison.OrdinalIgnoreCase)),
                group.Count(x => string.Equals(x.id_estadoNavigation?.nombre_estado, "Cancelada", StringComparison.OrdinalIgnoreCase))));
    }

    private static DateTime GetStartOfWeek(DateTime date)
    {
        var diff = (7 + (date.DayOfWeek - DayOfWeek.Monday)) % 7;
        return date.AddDays(-diff).Date;
    }
    private static bool DoesBlockAffectAppointment(tbl_bloqueo_horarios block, DateOnly date, TimeOnly start, TimeOnly end)
    {
        if (date < block.fecha_inicio || date > block.fecha_fin)
        {
            return false;
        }

        if (string.Equals(block.alcance_bloqueo, "Completo", StringComparison.OrdinalIgnoreCase) ||
            !block.hora_inicio.HasValue ||
            !block.hora_fin.HasValue)
        {
            return true;
        }

        return start < block.hora_fin.Value && end > block.hora_inicio.Value;
    }

    private static bool SlotOverlapsAnyBlock(IEnumerable<tbl_bloqueo_horarios> blocks, DateOnly date, TimeOnly start, TimeOnly end)
        => blocks.Any(block => DoesBlockAffectAppointment(block, date, start, end));

    private async Task SendGmail24hReminderAsync(tbl_citas appointment)
    {
        if (appointment.id_pacienteNavigation == null || string.IsNullOrWhiteSpace(appointment.id_pacienteNavigation.email))
        {
            await JSRuntime.InvokeVoidAsync("alert", "El paciente no tiene un correo electrónico registrado.");
            return;
        }

        try
        {
            var patientEmail = appointment.id_pacienteNavigation.email.Trim();
            var patientName = GetPatientDisplayName(appointment.id_pacienteNavigation);
            var doctorName = GetDoctorDisplayName(appointment.id_medicoNavigation);
            var appointmentType = string.IsNullOrWhiteSpace(appointment.tipo_cita) ? "Presencial" : appointment.tipo_cita!;
            var statusLabel = appointment.id_estadoNavigation?.nombre_estado ?? "Programada";
            var reminderWindow = "24 horas antes";

            await EmailSender.SendAppointmentReminderAsync(
                patientEmail,
                string.IsNullOrWhiteSpace(patientName) ? "Paciente" : patientName,
                string.IsNullOrWhiteSpace(doctorName) ? "Profesional asignado" : doctorName,
                appointment.fecha_cita,
                appointment.hora_inicio,
                appointmentType,
                statusLabel,
                reminderWindow,
                null,
                $"Recordatorio de cita optométrica (24 horas antes)");

            using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var dbAppt = await dbContext.tbl_citas.FindAsync(appointment.id_cita);
            if (dbAppt != null)
            {
                dbAppt.recordatorio_24hrs = true;
                dbAppt.notificacion_enviada = true;
                dbAppt.fecha_notificacion_enviada = DateTime.Now;
                dbAppt.tipo_notificacion = "Email 24 horas antes (Manual)";
                dbAppt.fecha_actualizacion = DateTime.Now;
                dbAppt.usuario_actualizacion = GetCurrentActorLabel();
                await dbContext.SaveChangesAsync();
            }

            appointment.recordatorio_24hrs = true;
            await JSRuntime.InvokeVoidAsync("alert", $"Recordatorio por Gmail enviado exitosamente a {patientEmail}.");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al enviar correo por Gmail: {ex.Message}");
        }
    }

