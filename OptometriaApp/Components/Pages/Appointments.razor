@page "/citas"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@using System.Security.Claims
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using OptometriaApp.Data
@using OptometriaApp.Models
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BillingDraftService BillingDraftService
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject NavigationManager NavigationManager

<PageTitle>Citas y turnos</PageTitle>

@if (isLoading)
{
    <section class="management-shell">
        <div class="management-card">
            <h1>Cargando citas y turnos...</h1>
        </div>
    </section>
}
else if (!canViewModule)
{
    <section class="management-shell">
        <div class="management-card">
            <span class="eyebrow">Restringido</span>
            <h1>Citas y turnos</h1>
            <p>Tu rol no tiene permiso para entrar a este modulo.</p>
        </div>
    </section>
}
else
{
    <section class="management-shell">
        <div class="management-hero">
            <div>
                <span class="eyebrow">Agenda clinica</span>
                <h1>@HeroTitle</h1>
                <p>@HeroDescription</p>
            </div>

            <div class="workspace-actions" style="align-items: center;">
                @if (CanCreateAppointments)
                {
                    <button type="button" class="btn btn-coffee" @onclick="OpenNewAppointmentModal">
                        <i class="bi bi-calendar-plus-fill" style="margin-right: 6px;"></i> Nueva cita
                    </button>
                }

                <button type="button" class="btn btn-excel" @onclick="ExportAppointments">
                    <i class="bi bi-file-earmark-excel-fill" style="margin-right: 6px;"></i> Exportar CSV
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-success" role="alert">@statusMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        @if (isClient && linkedPatient is null)
        {
            <section class="management-card">
                <div class="management-card-header">
                    <h2>Tu perfil de paciente aun no esta completo</h2>
                    <span>Se crea automaticamente</span>
                </div>

                <p>
                    Cuando agendes una cita para ti, el sistema puede crear una ficha rapida con tu usuario y luego la completas
                    con mas detalle. Si prefieres dejarla lista ahora, puedes hacerlo aqui.
                </p>

                <div class="management-form-grid">
                    <div>
                        <label class="form-label" for="selfPatientDocument">Cedula</label>
                        <input id="selfPatientDocument" class="form-control" @bind="selfPatientEditor.Cedula" maxlength="20" />
                    </div>

                    <div>
                        <label class="form-label" for="selfPatientBirthDate">Fecha de nacimiento</label>
                        <input id="selfPatientBirthDate" type="date" class="form-control" value="@selfPatientEditor.FechaNacimiento" @onchange="OnSelfPatientBirthDateChanged" max="@TodayDateIso" />
                    </div>

                    <div>
                        <label class="form-label" for="selfPatientPhone">Telefono</label>
                        <input id="selfPatientPhone" class="form-control" @bind="selfPatientEditor.Telefono" maxlength="20" />
                    </div>

                    <div>
                        <label class="form-label" for="selfPatientGender">Genero</label>
                        <select id="selfPatientGender" class="form-select" @bind="selfPatientEditor.Genero">
                            <option value="">Selecciona</option>
                            @foreach (var option in genderOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="management-form-grid patient-form-block">
                    <div class="patient-form-span">
                        <label class="form-label" for="selfPatientAddress">Direccion</label>
                        <input id="selfPatientAddress" class="form-control" @bind="selfPatientEditor.Direccion" maxlength="255" />
                    </div>

                    <div class="patient-form-span">
                        <label class="form-label" for="selfPatientNotes">Observaciones</label>
                        <textarea id="selfPatientNotes" class="form-control" rows="3" @bind="selfPatientEditor.Observaciones"></textarea>
                    </div>
                </div>

                <div class="workspace-actions">
                    <button type="button" class="btn btn-primary" @onclick="SaveLinkedPatientAsync">Guardar y vincular</button>
                </div>
            </section>
        }

        <section class="management-card">
            <div class="management-card-header">
                <h2>Filtros</h2>
                <span>@FilteredAppointments.Count resultados</span>
            </div>

            <div class="@(isDoctor ? "appointment-filters-grid-doctor" : "appointment-filters-grid-all")">
                <div>
                    <label class="form-label" for="appointmentSearch">Busqueda</label>
                    <input id="appointmentSearch" class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Paciente, doctor, motivo o tipo" />
                </div>

                @if (!isDoctor)
                {
                    <div>
                        <label class="form-label" for="appointmentDoctorFilter">Medico</label>
                        <select id="appointmentDoctorFilter" class="form-select" @bind="selectedDoctorFilter">
                            <option value="0">Todos</option>
                            @foreach (var doctor in doctors)
                            {
                                <option value="@doctor.id_medico">@GetDoctorDisplayName(doctor)</option>
                            }
                        </select>
                    </div>
                }

                <div>
                    <label class="form-label" for="appointmentScope">Periodo</label>
                    <select id="appointmentScope" class="form-select" @bind="selectedTemporalFilter">
                        <option value="upcoming">Proximas</option>
                        <option value="past">Anteriores</option>
                        <option value="today">Hoy</option>
                        <option value="all">Todas</option>
                    </select>
                </div>

                <div>
                    <label class="form-label" for="appointmentStatus">Estado</label>
                    <select id="appointmentStatus" class="form-select" @bind="selectedStatusFilter">
                        <option value="">Todos</option>
                        @foreach (var state in appointmentStates)
                        {
                            <option value="@state.nombre_estado">@state.nombre_estado</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="form-label" for="appointmentDateFrom">Desde</label>
                    <input id="appointmentDateFrom" type="date" class="form-control" value="@dateFromFilter" @onchange="OnDateFromFilterChanged" />
                </div>

                <div>
                    <label class="form-label" for="appointmentDateTo">Hasta</label>
                    <input id="appointmentDateTo" type="date" class="form-control" value="@dateToFilter" @onchange="OnDateToFilterChanged" />
                </div>
            </div>

            <div class="management-actions" style="margin-top: 0.3rem;">
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ClearFilters" style="padding: 0.3rem 0.7rem !important; font-size: 0.78rem !important; border-color: rgba(127,105,81,0.25) !important;">
                    <i class="bi bi-trash" style="margin-right: 4px;"></i> Limpiar filtros
                </button>
            </div>

            @if (!doctors.Any())
            {
                <div class="alert alert-warning" role="alert" style="margin-top: 1rem;">
                    No hay medicos disponibles para agendar o filtrar en este momento.
                </div>
            }
        </section>

        <!-- Appointments Table -->
        <section class="management-card" style="margin-top: 1.5rem;">
            <div class="management-card-header">
                <h2>Agenda de citas</h2>
                <span>@FilteredAppointments.Count registros</span>
            </div>

            <div class="table-responsive" style="margin-top: 1rem;">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Hora</th>
                            <th>Paciente</th>
                            @if (!isDoctor)
                            {
                                <th>Médico</th>
                            }
                            <th>Tipo</th>
                            <th>Motivo</th>
                            <th>Estado</th>
                            <th style="text-align: right; padding-right: 1.5rem;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredAppointments.Count == 0)
                        {
                            <tr>
                                <td colspan="8" style="text-align: center; padding: 2rem; color: var(--color-taupe);">
                                    No hay citas que coincidan con los filtros actuales.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var appointment in PagedAppointments)
                            {
                                var stateName = appointment.id_estadoNavigation?.nombre_estado ?? "Sin estado";
                                var stateColor = stateName switch
                                {
                                    "Confirmada" => "#5DA181",
                                    "Programada" => "#e09b3c",
                                    "Reprogramada" => "#7F6951",
                                    "Cancelada" => "#dc3545",
                                    "Realizada" => "#5DA181",
                                    _ => "#7F6951"
                                };
                                var stateBg = stateName switch
                                {
                                    "Confirmada" => "rgba(93,161,129,0.12)",
                                    "Programada" => "rgba(254,188,100,0.15)",
                                    "Reprogramada" => "rgba(127,105,81,0.12)",
                                    "Cancelada" => "rgba(220,53,69,0.1)",
                                    "Realizada" => "rgba(93,161,129,0.12)",
                                    _ => "rgba(127,105,81,0.1)"
                                };
                                <tr>
                                    <td><strong>@appointment.fecha_cita.ToString("yyyy-MM-dd")</strong></td>
                                    <td style="font-family: monospace; font-size: 0.85rem;">@($"{appointment.hora_inicio:HH\\:mm} - {appointment.hora_fin:HH\\:mm}")</td>
                                    <td><strong style="color: var(--color-ink);">@GetPatientDisplayName(appointment.id_pacienteNavigation)</strong></td>
                                    @if (!isDoctor)
                                    {
                                        <td>@GetDoctorDisplayName(appointment.id_medicoNavigation)</td>
                                    }
                                    <td>@(string.IsNullOrWhiteSpace(appointment.tipo_cita) ? "Presencial" : appointment.tipo_cita)</td>
                                    <td style="max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@(appointment.motivo_cita ?? "-")</td>
                                    <td>
                                        <span class="badge" style="background: @stateBg !important; color: @stateColor !important; font-size: 0.78rem; padding: 0.35rem 0.65rem; border-radius: 2rem;">
                                            @stateName
                                        </span>
                                    </td>
                                    <td style="text-align: right; padding-right: 1.2rem;">
                                        <div style="display: inline-flex; gap: 0.4rem; justify-content: flex-end;">
                                            <button type="button" class="btn btn-outline-primary"
                                                    style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(93,161,129,0.3) !important; color: var(--color-sage) !important;"
                                                    @onclick="() => OpenEditAppointmentModal(appointment.id_cita)">
                                                <i class="bi bi-pencil-fill" style="margin-right: 4px;"></i> Ver/Editar
                                            </button>
                                            @if (CanConfirmAppointments && IsPendingState(stateName))
                                            {
                                                <button type="button" class="btn btn-outline-primary"
                                                        style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(93,161,129,0.3) !important; color: var(--color-sage) !important;"
                                                        @onclick="() => QuickConfirmAsync(appointment.id_cita)">
                                                    <i class="bi bi-check2-circle" style="margin-right: 4px;"></i> Confirmar
                                                </button>
                                            }
                                            else if (stateName == "Confirmada" && (permissions.CanDelete || isAdmin || isDoctor || isClient))
                                            {
                                                <button type="button" class="btn btn-outline-primary"
                                                        style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(220,53,69,0.35) !important; color: #dc3545 !important;"
                                                        @onclick="() => OpenCancellationChoiceAsync(appointment.id_cita)">
                                                    <i class="bi bi-x-circle" style="margin-right: 4px;"></i> Cancelar
                                                </button>
                                            }
                                            <button type="button" class="btn btn-outline-primary"
                                                    style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(254,188,100,0.4) !important; color: #e09b3c !important;"
                                                    @onclick="() => OpenAuditModal(appointment.id_cita)">
                                                <i class="bi bi-clock-history" style="margin-right: 4px;"></i> Auditoría
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <TablePager TotalItems="@FilteredAppointments.Count" CurrentPage="@appointmentPage" CurrentPageChanged="SetAppointmentPage" />
        </section>
    </section>
}

<!-- Form Modal -->
@if (showFormModal && appointmentEditor is not null)
{
    <div class="custom-modal-overlay" @onclick="CloseFormModal">
        <div class="custom-modal-card form-modal-card" @onclick:stopPropagation="true">
            <header class="custom-modal-header rose-header">
                <h2>@EditorTitle</h2>
                <button type="button" class="btn-close-modal" @onclick="CloseFormModal">×</button>
            </header>

            <div class="custom-modal-body">
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger" role="alert" style="margin-bottom: 1rem;">@errorMessage</div>
                }
                @if (!string.IsNullOrWhiteSpace(statusMessage))
                {
                    <div class="alert alert-success" role="alert" style="margin-bottom: 1rem;">@statusMessage</div>
                }

                <div class="appointment-modal-layout">
                    <div class="appointment-modal-fields">
                        <div>
                            <label class="form-label" for="modalAppointmentDoctor">Medico</label>
                            <select id="modalAppointmentDoctor" class="form-select" value="@appointmentEditor.IdMedico" @onchange="OnDoctorSelectionChanged" disabled="@(!CanChangeDoctor)">
                                <option value="0">Selecciona</option>
                                @foreach (var doctor in doctors)
                                {
                                    <option value="@doctor.id_medico">@GetDoctorDisplayName(doctor)</option>
                                }
                            </select>
                        </div>

                        @if (isAdmin || isDoctor)
                        {
                            <div>
                                <label class="form-label" for="modalAppointmentPatient">Paciente</label>
                                <select id="modalAppointmentPatient" class="form-select" @bind="appointmentEditor.IdPaciente" disabled="@(!CanEditAppointments)">
                                    <option value="0">Selecciona</option>
                                    @foreach (var patient in patients.OrderBy(p => p.apellidos).ThenBy(p => p.nombres))
                                    {
                                        <option value="@patient.id_paciente">@GetPatientDisplayName(patient)</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <div>
                                <label class="form-label" for="modalAppointmentTarget">La cita es para</label>
                                <select id="modalAppointmentTarget" class="form-select" value="@appointmentEditor.TargetType" @onchange="OnAppointmentTargetChanged" disabled="@(!CanEditAppointments)">
                                    <option value="self">Mi usuario</option>
                                    <option value="family">Un familiar</option>
                                </select>
                            </div>
                        }

                        @if (isClient)
                        {
                            <div>
                                <label class="form-label">Paciente</label>
                                <input class="form-control" value="@CurrentPatientLabel" readonly />
                            </div>
                        }

                        <div>
                            <label class="form-label" for="modalAppointmentType">Tipo</label>
                            <select id="modalAppointmentType" class="form-select" @bind="appointmentEditor.TipoCita" disabled="@(!CanEditAppointments)">
                                @foreach (var option in appointmentTypeOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="form-label">Estado</label>
                            <input class="form-control" value="@appointmentEditor.Estado" readonly />
                        </div>

                        <div class="appointment-reason-field">
                            <label class="form-label" for="modalAppointmentReason">Motivo</label>
                            <textarea id="modalAppointmentReason" class="form-control" @bind="appointmentEditor.Motivo" maxlength="255" readonly="@(!CanEditAppointments)"></textarea>
                        </div>

                        @if (ShowCancellationReasonInForm)
                        {
                            <div>
                                <label class="form-label" for="modalAppointmentCancelReason">Razon de cancelacion</label>
                                <textarea id="modalAppointmentCancelReason" class="form-control" rows="2" @bind="appointmentEditor.RazonCancelacion" readonly="@(!CanCancelAppointments)"></textarea>
                            </div>
                        }
                    </div>

                    <section class="appointment-scheduler-panel" aria-label="Seleccion de fecha y turno">
                        <div class="appointment-scheduler-header">
                            <button type="button" class="calendar-nav-button" title="Mes anterior" @onclick="() => ChangeAppointmentCalendarMonthAsync(-1)" disabled="@(!CanEditAppointments)">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            <strong>@AppointmentMonthLabel</strong>
                            <button type="button" class="calendar-nav-button" title="Mes siguiente" @onclick="() => ChangeAppointmentCalendarMonthAsync(1)" disabled="@(!CanEditAppointments)">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>

                        <div class="calendar-legend">
                            <span><i class="legend-dot free"></i> Libre</span>
                            <span><i class="legend-dot partial"></i> Parcial</span>
                            <span><i class="legend-dot full"></i> Lleno</span>
                            <span><i class="legend-dot past"></i> Pasado</span>
                        </div>

                        <div class="appointment-calendar-grid">
                            @foreach (var dayName in CalendarWeekDays)
                            {
                                <div class="calendar-weekday">@dayName</div>
                            }

                            @foreach (var day in appointmentCalendarDays)
                            {
                                if (day.IsPlaceholder)
                                {
                                    <div class="calendar-day is-placeholder"></div>
                                }
                                else
                                {
                                    <button type="button"
                                            class="calendar-day @GetCalendarDayCss(day)"
                                            disabled="@(!CanEditAppointments || !day.CanSelect)"
                                            title="@day.StatusLabel"
                                            @onclick="() => SelectAppointmentCalendarDateAsync(day.Date!.Value)">
                                        @day.Date!.Value.Day
                                    </button>
                                }
                            }
                        </div>

                        <div class="appointment-slots-panel">
                            <div class="slots-title">
                                <strong>Turnos para el @SelectedAppointmentDateLabel</strong>
                                <span>@availableSlots.Count libres</span>
                            </div>

                            <div class="slots-grid">
                                @foreach (var slot in SchedulerSlots)
                                {
                                    <button type="button"
                                            class="slot-button @(slot.IsOccupied ? "is-occupied" : slot.Key == appointmentEditor.SelectedSlotKey ? "is-selected" : string.Empty)"
                                            disabled="@(slot.IsOccupied || !CanEditAppointments)"
                                            @onclick="() => SelectAppointmentSlot(slot.Key)">
                                        @slot.Label
                                        @if (slot.IsOccupied)
                                        {
                                            <br /><small>Ocupado</small>
                                        }
                                    </button>
                                }

                                @if (!SchedulerSlots.Any())
                                {
                                    <div class="slots-empty">No hay turnos para esta fecha.</div>
                                }
                            </div>
                        </div>
                    </section>
                </div>

                @if (isClient && appointmentEditor.TargetType == "family")
                {
                    <div class="management-form-grid patient-form-block" style="margin-top: 1rem;">
                        <div class="patient-form-span">
                            <label class="form-label" for="modalFamilyPatientSelect">Familiar</label>
                            <select id="modalFamilyPatientSelect" class="form-select" value="@appointmentEditor.FamilyPatientId" @onchange="OnFamilyPatientSelectionChanged" disabled="@(!CanEditAppointments)">
                                <option value="0">Registrar nuevo familiar</option>
                                @foreach (var familyPatient in clientFamilyPatients.OrderBy(p => p.apellidos).ThenBy(p => p.nombres))
                                {
                                    <option value="@familyPatient.id_paciente">@GetPatientDisplayName(familyPatient)</option>
                                }
                            </select>
                        </div>

                        @if (appointmentEditor.FamilyPatientId <= 0)
                        {
                            <div>
                                <label class="form-label" for="modalFamilyCedula">Cedula familiar</label>
                                <input id="modalFamilyCedula" class="form-control" @bind="appointmentEditor.FamilyCedula" maxlength="20" readonly="@(!CanEditAppointments)" />
                            </div>
                            <div>
                                <label class="form-label" for="modalFamilyNames">Nombres</label>
                                <input id="modalFamilyNames" class="form-control" @bind="appointmentEditor.FamilyNames" maxlength="100" readonly="@(!CanEditAppointments)" />
                            </div>
                            <div>
                                <label class="form-label" for="modalFamilyLastNames">Apellidos</label>
                                <input id="modalFamilyLastNames" class="form-control" @bind="appointmentEditor.FamilyLastNames" maxlength="100" readonly="@(!CanEditAppointments)" />
                            </div>
                            <div>
                                <label class="form-label" for="modalFamilyPhone">Telefono</label>
                                <input id="modalFamilyPhone" class="form-control" @bind="appointmentEditor.FamilyPhone" maxlength="20" readonly="@(!CanEditAppointments)" />
                            </div>
                            <div>
                                <label class="form-label" for="modalFamilyBirthDate">Fecha nacimiento</label>
                                <input id="modalFamilyBirthDate" type="date" class="form-control" value="@appointmentEditor.FamilyBirthDate" @onchange="OnFamilyBirthDateChanged" readonly="@(!CanEditAppointments)" max="@TodayDateIso" />
                            </div>
                        }
                    </div>
                }

                <div class="management-form-grid patient-form-block" style="margin-top: 1rem;">
                    <div class="patient-form-span">
                        <label class="form-label" for="modalAppointmentDescription">Descripcion adicional</label>
                        <textarea id="modalAppointmentDescription" class="form-control" rows="3" @bind="appointmentEditor.Descripcion" readonly="@(!CanEditAppointments)"></textarea>
                    </div>

                    @if (CanWriteMedicalNotes)
                    {
                        <div class="patient-form-span">
                            <label class="form-label" for="modalAppointmentNotes">Notas medicas</label>
                            <textarea id="modalAppointmentNotes" class="form-control" rows="3" @bind="appointmentEditor.NotasMedico"></textarea>
                        </div>
                    }

                </div>
            </div>

            <footer class="custom-modal-footer">
                @if (CanEditAppointments)
                {
                    <button type="button" class="btn btn-primary" @onclick="SaveAndCloseAppointmentAsync">
                        @(isCreatingAppointment ? "Agendar cita" : "Guardar cambios")
                    </button>
                }
                @if (!isCreatingAppointment && CanConfirmAppointments)
                {
                    <button type="button" class="btn btn-outline-primary" @onclick='() => ChangeAppointmentStateAsync("Confirmada")'>Confirmar</button>
                }
                @if (!isCreatingAppointment && CanCloseAppointments)
                {
                    <button type="button" class="btn btn-outline-primary" @onclick='() => ChangeAppointmentStateAsync("Realizada")'>Marcar realizada</button>
                    <button type="button" class="btn btn-outline-primary" @onclick='() => ChangeAppointmentStateAsync("No presento")'>No presento</button>
                }
                @if (!isCreatingAppointment && CanCancelAppointments)
                {
                    <button type="button" class="btn btn-outline-primary" style="color: #dc3545 !important; border-color: rgba(220,53,69,0.3) !important;"
                            @onclick="HandleFormCancelClickAsync">Cancelar cita</button>
                }
                <button type="button" class="btn btn-outline-primary" @onclick="CloseFormModal">Cerrar</button>
            </footer>
        </div>
    </div>
}

<!-- Cancellation choice modal -->
@if (showCancellationChoiceModal && appointmentEditor is not null)
{
    <div class="custom-modal-overlay" @onclick="CloseCancellationChoiceModal">
        <div class="custom-modal-card alert-modal-card" @onclick:stopPropagation="true">
            <header class="custom-modal-header rose-header">
                <h2>Cancelar cita confirmada</h2>
                <button type="button" class="btn-close-modal" @onclick="CloseCancellationChoiceModal">×</button>
            </header>
            <div class="custom-modal-body">
                <p>¿Deseas reprogramar la cita o cancelarla definitivamente?</p>
                <div>
                    <label class="form-label" for="cancellationChoiceReason">Razón de cancelación definitiva</label>
                    <textarea id="cancellationChoiceReason" class="form-control" rows="3"
                              @bind="appointmentEditor.RazonCancelacion"
                              placeholder="Escribe la razón si deseas cancelarla definitivamente"></textarea>
                </div>
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger" role="alert" style="margin-top: 1rem;">@errorMessage</div>
                }
            </div>
            <footer class="custom-modal-footer">
                <button type="button" class="btn btn-outline-primary" @onclick="ChooseReprogramAppointment">
                    <i class="bi bi-calendar-event" style="margin-right: 5px;"></i> Reprogramar
                </button>
                <button type="button" class="btn btn-outline-primary"
                        style="color: #dc3545 !important; border-color: rgba(220,53,69,0.35) !important;"
                        @onclick="CancelDefinitelyAsync">
                    <i class="bi bi-x-circle" style="margin-right: 5px;"></i> Cancelar definitivamente
                </button>
                <button type="button" class="btn btn-outline-primary" @onclick="CloseCancellationChoiceModal">Volver</button>
            </footer>
        </div>
    </div>
}

<!-- Audit Modal -->
@if (showAuditModal)
{
    <div class="custom-modal-overlay" @onclick="CloseAuditModal">
        <div class="custom-modal-card" style="max-width: 680px;" @onclick:stopPropagation="true">
            <header class="custom-modal-header" style="background: linear-gradient(135deg, rgba(254,188,100,0.18) 0%, rgba(254,188,100,0.06) 100%);">
                <h2>Auditoría de cita</h2>
                <button type="button" class="btn-close-modal" @onclick="CloseAuditModal">×</button>
            </header>
            <div class="custom-modal-body">
                @if (appointmentAuditEntries.Count == 0)
                {
                    <p style="color: var(--color-taupe); text-align: center; padding: 1.5rem 0;">No hay eventos registrados para esta cita.</p>
                }
                else
                {
                    <div class="management-list">
                        @foreach (var auditEntry in appointmentAuditEntries)
                        {
                            <article class="management-list-item">
                                <strong>@auditEntry.accion</strong>
                                <span>@(auditEntry.fecha?.ToString("yyyy-MM-dd HH:mm") ?? "Sin fecha")</span>
                                <span>@(auditEntry.id_usuarioNavigation?.usuario ?? "Sistema")</span>
                                <span>@auditEntry.detalle</span>
                            </article>
                        }
                    </div>
                }
            </div>
            <footer class="custom-modal-footer">
                <button type="button" class="btn btn-outline-primary" @onclick="CloseAuditModal">Cerrar</button>
            </footer>
        </div>
    </div>
}



