    private async Task PrepareNewAppointmentAsync()
    {
        statusMessage = null;
        errorMessage = null;

        if (!CanCreateAppointments)
        {
            errorMessage = "No tienes permiso para agendar citas.";
            return;
        }

        var defaultDoctorId = isDoctor ? currentDoctorId : selectedDoctorFilter > 0 ? selectedDoctorFilter : doctors.FirstOrDefault()?.id_medico ?? 0;
        var defaultPatientId = isClient ? linkedPatient?.id_paciente ?? 0 : 0;

        appointmentEditor = new AppointmentEditorModel
        {
            IdMedico = defaultDoctorId,
            IdPaciente = defaultPatientId,
            FechaCita = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd"),
            TipoCita = "Presencial",
            Estado = "Programada",
            TargetType = "self"
        };

        selectedAppointmentId = 0;
        selectedAppointment = null;
        isCreatingAppointment = true;
        showFormCancellationReason = false;
        appointmentAuditEntries.Clear();
        appointmentCalendarMonth = DateOnly.TryParse(appointmentEditor.FechaCita, out var defaultDate)
            ? new DateOnly(defaultDate.Year, defaultDate.Month, 1)
            : new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1);

        await RebuildAvailableSlotsAsync();
        await BuildAppointmentCalendarAsync();
    }

    private void ApplyPrefillToAppointmentEditor()
    {
        if (appointmentEditor is null)
        {
            return;
        }

        if (PrefillPatientId.HasValue && PrefillPatientId.Value > 0 && patients.Any(x => x.id_paciente == PrefillPatientId.Value))
        {
            appointmentEditor.IdPaciente = PrefillPatientId.Value;
        }

        if (!string.IsNullOrWhiteSpace(PrefillReason))
        {
            appointmentEditor.Motivo = PrefillReason.Trim();
        }

        if (DateOnly.TryParse(PrefillDate, out var parsedDate) && parsedDate >= DateOnly.FromDateTime(DateTime.Today))
        {
            appointmentEditor.FechaCita = parsedDate.ToString("yyyy-MM-dd");
            appointmentCalendarMonth = new DateOnly(parsedDate.Year, parsedDate.Month, 1);
        }
    }

