@if (showPatientHistoryModal && selectedPatientHistory.Any())
{
    <div class="custom-modal-overlay" @onclick="ClosePatientHistoryModal">
        <div class="custom-modal-card" style="max-width: 760px;" @onclick:stopPropagation="true">
            <header class="custom-modal-header rose-header">
                <h2>Historial de citas - @selectedPatientHistoryLabel</h2>
                <button type="button" class="btn-close-modal" @onclick="ClosePatientHistoryModal">×</button>
            </header>
            <div class="custom-modal-body">
                <div class="management-list">
                    @foreach (var appointment in selectedPatientHistory)
                    {
                        <article class="management-list-item">
                            <strong>@appointment.fecha_cita.ToString("yyyy-MM-dd")</strong>
                            <span>@($"{appointment.hora_inicio:HH\\:mm} - {appointment.hora_fin:HH\\:mm}")</span>
                            <span>@GetDoctorDisplayName(appointment.id_medicoNavigation)</span>
                            <span>@(appointment.id_estadoNavigation?.nombre_estado ?? "Sin estado")</span>
                            <span>@(string.IsNullOrWhiteSpace(appointment.motivo_cita) ? "-" : appointment.motivo_cita)</span>
                        </article>
                    }
                </div>
            </div>
            <footer class="custom-modal-footer">
                <button type="button" class="btn btn-outline-primary" @onclick="ClosePatientHistoryModal">Cerrar</button>
            </footer>
        </div>
    </div>
}
