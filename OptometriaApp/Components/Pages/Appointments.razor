    private async Task RebuildAvailableSlotsAsync()
    {
        availableSlots.Clear();
        occupiedSlots.Clear();

        if (appointmentEditor is null || appointmentEditor.IdMedico <= 0 || !DateOnly.TryParse(appointmentEditor.FechaCita, out var appointmentDate))
        {
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var doctor = await dbContext.tbl_medico.AsNoTracking().FirstOrDefaultAsync(m => m.id_medico == appointmentEditor.IdMedico && m.activo == true);
        if (doctor is null)
        {
            return;
        }

        var dayOfWeek = ToDatabaseDayOfWeek(appointmentDate.DayOfWeek);
        var schedules = await dbContext.tbl_disponibilidad_medico
            .AsNoTracking()
            .Where(x => x.id_medico == doctor.id_medico && x.dia_semana == dayOfWeek && x.disponible == true)
            .OrderBy(x => x.hora_inicio)
            .ToListAsync();

        if (schedules.Count == 0)
        {
            return;
        }

        var isBlocked = await dbContext.tbl_bloqueo_horarios
            .AsNoTracking()
            .AnyAsync(x => x.id_medico == doctor.id_medico && x.activo == true && x.fecha_inicio <= appointmentDate && x.fecha_fin >= appointmentDate);

        if (isBlocked)
        {
            return;
        }

        var durationMinutes = Math.Max(10, doctor.duracion_consulta_minutos ?? 30);
        var busySlots = await dbContext.tbl_citas
            .AsNoTracking()
            .Include(c => c.id_estadoNavigation)
            .Where(c => c.id_medico == doctor.id_medico && c.fecha_cita == appointmentDate && c.id_cita != appointmentEditor.IdCita)
            .Where(c => c.id_estadoNavigation != null && c.id_estadoNavigation.nombre_estado != "Cancelada")
            .Select(c => new { c.hora_inicio, c.hora_fin })
            .ToListAsync();

        occupiedSlots.AddRange(busySlots
            .OrderBy(x => x.hora_inicio)
            .Select(x => new SlotOption(BuildSlotKey(x.hora_inicio, x.hora_fin), $"{x.hora_inicio:HH\\:mm}")));

        foreach (var schedule in schedules)
        {
            var cursor = schedule.hora_inicio;
            while (cursor.AddMinutes(durationMinutes) <= schedule.hora_fin)
            {
                var slotEnd = cursor.AddMinutes(durationMinutes);
                var overlapsBreak = schedule.hora_descanso_inicio.HasValue &&
                    schedule.hora_descanso_fin.HasValue &&
                    cursor < schedule.hora_descanso_fin.Value &&
                    slotEnd > schedule.hora_descanso_inicio.Value;

                var overlapsAppointment = busySlots.Any(x => cursor < x.hora_fin && slotEnd > x.hora_inicio);
                if (!overlapsBreak && !overlapsAppointment)
                {
                    var key = BuildSlotKey(cursor, slotEnd);
                    availableSlots.Add(new SlotOption(key, $"{cursor:HH\\:mm} - {slotEnd:HH\\:mm}"));
                }

                cursor = cursor.AddMinutes(durationMinutes);
            }
        }

        if (appointmentEditor.IdCita > 0 && !string.IsNullOrWhiteSpace(appointmentEditor.SelectedSlotKey) && availableSlots.All(x => x.Key != appointmentEditor.SelectedSlotKey))
        {
            if (TryParseSlot(appointmentEditor.SelectedSlotKey, out var currentStart, out var currentEnd))
            {
                availableSlots.Insert(0, new SlotOption(appointmentEditor.SelectedSlotKey, $"{currentStart:HH\\:mm} - {currentEnd:HH\\:mm} (actual)"));
            }
        }
    }

    private async Task BuildAppointmentCalendarAsync()
    {
        appointmentCalendarDays.Clear();

        if (appointmentEditor is null)
        {
            return;
        }

        var firstDay = appointmentCalendarMonth;
        var daysInMonth = DateTime.DaysInMonth(firstDay.Year, firstDay.Month);
        var leadingBlanks = (int)new DateTime(firstDay.Year, firstDay.Month, 1).DayOfWeek;

        for (var index = 0; index < leadingBlanks; index++)
        {
            appointmentCalendarDays.Add(CalendarDayOption.Placeholder());
        }

        if (appointmentEditor.IdMedico <= 0)
        {
            for (var day = 1; day <= daysInMonth; day++)
            {
                appointmentCalendarDays.Add(CalendarDayOption.Unavailable(new DateOnly(firstDay.Year, firstDay.Month, day), "Selecciona un medico"));
            }

            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var doctor = await dbContext.tbl_medico.AsNoTracking().FirstOrDefaultAsync(m => m.id_medico == appointmentEditor.IdMedico && m.activo == true);
        if (doctor is null)
        {
            return;
        }

        var monthStart = firstDay;
        var monthEnd = new DateOnly(firstDay.Year, firstDay.Month, daysInMonth);
        var today = DateOnly.FromDateTime(DateTime.Today);
        var selectedDate = DateOnly.TryParse(appointmentEditor.FechaCita, out var parsedSelectedDate) ? parsedSelectedDate : today;
        var durationMinutes = Math.Max(10, doctor.duracion_consulta_minutos ?? 30);

        var schedules = await dbContext.tbl_disponibilidad_medico
            .AsNoTracking()
            .Where(x => x.id_medico == doctor.id_medico && x.disponible == true)
            .ToListAsync();

        var blocks = await dbContext.tbl_bloqueo_horarios
            .AsNoTracking()
            .Where(x => x.id_medico == doctor.id_medico && x.activo == true && x.fecha_inicio <= monthEnd && x.fecha_fin >= monthStart)
            .ToListAsync();

        var monthAppointments = await dbContext.tbl_citas
            .AsNoTracking()
            .Include(c => c.id_estadoNavigation)
            .Where(c => c.id_medico == doctor.id_medico && c.fecha_cita >= monthStart && c.fecha_cita <= monthEnd)
            .Where(c => c.id_estadoNavigation != null && c.id_estadoNavigation.nombre_estado != "Cancelada" && c.id_cita != appointmentEditor.IdCita)
            .Select(c => new { c.fecha_cita, c.hora_inicio, c.hora_fin })
            .ToListAsync();

        for (var day = 1; day <= daysInMonth; day++)
        {
            var date = new DateOnly(firstDay.Year, firstDay.Month, day);
            var isPast = date < today;
            var isBlocked = blocks.Any(x => x.fecha_inicio <= date && x.fecha_fin >= date);
            var daySchedules = schedules.Where(x => x.dia_semana == ToDatabaseDayOfWeek(date.DayOfWeek)).ToList();
            var capacity = isBlocked ? 0 : daySchedules.Sum(x => CountScheduleSlots(x, durationMinutes));
            var occupied = monthAppointments.Count(x => x.fecha_cita == date);

            if (isPast)
            {
                appointmentCalendarDays.Add(new CalendarDayOption(date, "past", "Pasado", false, date == selectedDate));
            }
            else if (capacity <= 0)
            {
                appointmentCalendarDays.Add(new CalendarDayOption(date, "unavailable", isBlocked ? "Bloqueado" : "Sin disponibilidad", false, date == selectedDate));
            }
            else if (occupied >= capacity)
            {
                appointmentCalendarDays.Add(new CalendarDayOption(date, "full", "Lleno", true, date == selectedDate));
            }
            else if (occupied > 0)
            {
                appointmentCalendarDays.Add(new CalendarDayOption(date, "partial", "Parcial", true, date == selectedDate));
            }
            else
            {
                appointmentCalendarDays.Add(new CalendarDayOption(date, "free", "Libre", true, date == selectedDate));
            }
        }
    }

    private async Task<bool> AppointmentConflictExistsAsync(OpticaDbContext dbContext, int doctorId, DateOnly appointmentDate, TimeOnly startTime, TimeOnly endTime, int? currentAppointmentId)
    {
        return await dbContext.tbl_citas
            .Include(c => c.id_estadoNavigation)
            .AnyAsync(c =>
                c.id_medico == doctorId &&
                c.fecha_cita == appointmentDate &&
                (!currentAppointmentId.HasValue || c.id_cita != currentAppointmentId.Value) &&
                c.id_estadoNavigation != null &&
                c.id_estadoNavigation.nombre_estado != "Cancelada" &&
                startTime < c.hora_fin &&
                endTime > c.hora_inicio);
    }

    private async Task<int?> ResolveAvailabilityIdAsync(OpticaDbContext dbContext, int doctorId, DateOnly appointmentDate, TimeOnly startTime, TimeOnly endTime)
    {
        var dayOfWeek = ToDatabaseDayOfWeek(appointmentDate.DayOfWeek);
        return await dbContext.tbl_disponibilidad_medico
            .Where(x =>
                x.id_medico == doctorId &&
                x.dia_semana == dayOfWeek &&
                x.disponible == true &&
                x.hora_inicio <= startTime &&
                x.hora_fin >= endTime)
            .Select(x => (int?)x.id_disponibilidad)
            .FirstOrDefaultAsync();
    }

