@page "/pacientes"
@attribute [Authorize(Policy = "FullAccess")]
@rendermode InteractiveServer
@using System.Net.Mail
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject NavigationManager NavigationManager

<PageTitle>Pacientes</PageTitle>

@if (isLoading)
{
    <section class="management-shell">
        <div class="management-card">
            <h1>Cargando pacientes...</h1>
        </div>
    </section>
}
else if (!canViewPatients)
{
    <section class="management-shell">
        <div class="management-card">
            <span class="eyebrow">Restringido</span>
            <h1>Gestión de pacientes</h1>
            <p>Tu rol no tiene permiso para ver este módulo.</p>
        </div>
    </section>
}
else
{
    <section class="management-shell">
        <div class="management-hero">
            <div>
                <span class="eyebrow">Administrador</span>
                <h1>Pacientes</h1>
                <p>Administra historias base de pacientes con una vista clara, filtros rápidos y acciones integradas.</p>
            </div>

            <div class="workspace-actions">
                @if (permissions.CanCreate)
                {
                    <button type="button" class="btn btn-primary" @onclick="PrepareNewPatient">
                        <i class="bi bi-person-plus-fill" style="margin-right: 6px;"></i> Nuevo paciente
                    </button>
                }

                <button type="button" class="btn btn-outline-primary" @onclick="ExportPatients">Exportar CSV</button>
            </div>
        </div>

        <section class="management-card">
            <div class="management-card-header">
                <h2>Filtros y búsqueda</h2>
                <span>@FilteredPatients.Count resultados</span>
            </div>

            <div class="filters-row">
                <div>
                    <label class="form-label" for="patientSearch">Buscador</label>
                    <input id="patientSearch" class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Código, cédula, nombre, correo o teléfono" />
                </div>

                <div class="filter-selects-col">
                    <div>
                        <label class="form-label" for="patientStatus">Estado</label>
                        <select id="patientStatus" class="form-select" @bind="selectedStatusFilter">
                            <option value="all">Todos</option>
                            <option value="active">Activos</option>
                            <option value="inactive">Inactivos</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label" for="patientGender">Género</label>
                        <select id="patientGender" class="form-select" @bind="selectedGenderFilter">
                            <option value="">Todos</option>
                            @foreach (var option in genderOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label" for="patientCivilStatus">Estado civil</label>
                        <select id="patientCivilStatus" class="form-select" @bind="selectedCivilStatusFilter">
                            <option value="">Todos</option>
                            @foreach (var option in civilStatusOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="management-actions" style="margin-top: 1rem;">
                <button type="button" class="btn btn-outline-primary" @onclick="ClearFilters">Limpiar filtros</button>
            </div>
        </section>

        <!-- Patients Table Card (Full Width) -->
        <section class="management-card" style="margin-top: 1.5rem;">
            <div class="management-card-header">
                <h2>Listado de Pacientes</h2>
                <span>@FilteredPatients.Count registrados</span>
            </div>

            <div class="table-responsive" style="margin-top: 1rem;">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Cédula</th>
                            <th>Paciente</th>
                            <th>Celular</th>
                            <th>Correo</th>
                            <th>Estado</th>
                            <th style="text-align: right; padding-right: 1.5rem;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredPatients.Count == 0)
                        {
                            <tr>
                                <td colspan="7" style="text-align: center; padding: 2rem; color: var(--color-taupe);">
                                    No se encontraron pacientes registrados con los filtros seleccionados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var patient in FilteredPatients)
                            {
                                <tr>
                                    <td>
                                        <span style="font-family: monospace; font-size: 0.85rem;">@(string.IsNullOrWhiteSpace(patient.codigo_paciente) ? "-" : patient.codigo_paciente)</span>
                                    </td>
                                    <td>@patient.cedula</td>
                                    <td>
                                        <strong style="color: var(--color-ink);">@($"{patient.nombres} {patient.apellidos}")</strong>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(patient.telefono) ? "-" : patient.telefono)</td>
                                    <td>@(string.IsNullOrWhiteSpace(patient.email) ? "-" : patient.email)</td>
                                    <td>
                                        @if (patient.activo == true)
                                        {
                                            <span class="badge" style="background: rgba(93, 161, 129, 0.15) !important; color: #5DA181 !important; font-size: 0.78rem; padding: 0.35rem 0.65rem; border-radius: 2rem;">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background: rgba(127, 105, 81, 0.12) !important; color: #7F6951 !important; font-size: 0.78rem; padding: 0.35rem 0.65rem; border-radius: 2rem;">Inactivo</span>
                                        }
                                    </td>
                                    <td style="text-align: right; padding-right: 1.2rem;">
                                        <div style="display: inline-flex; gap: 0.4rem; justify-content: flex-end;">
                                            <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(93, 161, 129, 0.3) !important; color: var(--color-sage) !important;" @onclick="() => PrepareEditPatient(patient)">
                                                <i class="bi bi-pencil-fill" style="margin-right: 4px;"></i> Editar
                                            </button>
                                            <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(254, 188, 100, 0.4) !important; color: #e09b3c !important;" @onclick="() => PrepareAuditPatient(patient)">
                                                <i class="bi bi-clock-history" style="margin-right: 4px;"></i> Auditoría
                                            </button>
                                            @if (permissions.CanDelete)
                                            {
                                                @if (patient.activo == true)
                                                {
                                                    <button type="button" class="btn btn-outline-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(127, 105, 81, 0.2) !important; color: var(--color-taupe) !important;" @onclick="() => ToggleActiveAsync(patient)">
                                                        Desactivar
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-primary" style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; background-color: var(--color-sage) !important; border-color: var(--color-sage) !important;" @onclick="() => ToggleActiveAsync(patient)">
                                                        Activar
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </section>
}

<!-- Custom Form Modal -->
@if (showFormModal && editor is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card form-modal-card">
            <header class="custom-modal-header rose-header">
                <h2>@EditorTitle</h2>
                <button type="button" class="btn-close-modal" @onclick="() => showFormModal = false">×</button>
            </header>
            <div class="custom-modal-body">
                <div class="management-form-grid">
                    <div>
                        <label class="form-label" for="patientCode">Código paciente</label>
                        <input id="patientCode" class="form-control" @bind="editor.CodigoPaciente" readonly="@(!CanModifyEditor)" maxlength="30" />
                    </div>

                    <div>
                        <label class="form-label" for="patientDocument">Cédula</label>
                        <input id="patientDocument" class="form-control" @bind="editor.Cedula" readonly="@(!CanModifyEditor)" maxlength="20" />
                    </div>

                    <div>
                        <label class="form-label" for="patientNames">Nombres</label>
                        <input id="patientNames" class="form-control" @bind="editor.Nombres" readonly="@(!CanModifyEditor)" maxlength="100" />
                    </div>

                    <div>
                        <label class="form-label" for="patientLastNames">Apellidos</label>
                        <input id="patientLastNames" class="form-control" @bind="editor.Apellidos" readonly="@(!CanModifyEditor)" maxlength="100" />
                    </div>

                    <div>
                        <label class="form-label" for="patientBirthDate">Fecha de nacimiento <span style="font-size: 0.8rem; color: var(--color-taupe); font-weight: normal;">(dd/mm/aaaa)</span></label>
                        <input id="patientBirthDate" type="date" class="form-control" value="@editor.FechaNacimiento" @onchange="OnBirthDateChanged" readonly="@(!CanModifyEditor)" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>

                    <div>
                        <label class="form-label" for="patientAge">Edad</label>
                        <input id="patientAge" class="form-control" value="@GetCalculatedAgeText()" readonly />
                    </div>

                    <div>
                        <label class="form-label" for="patientGenderField">Género</label>
                        <select id="patientGenderField" class="form-select" @bind="editor.Genero" disabled="@(!CanModifyEditor)">
                            <option value="">Selecciona</option>
                            @foreach (var option in genderOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label" for="patientCivilStatusField">Estado civil</label>
                        <select id="patientCivilStatusField" class="form-select" @bind="editor.EstadoCivil" disabled="@(!CanModifyEditor)">
                            <option value="">Selecciona</option>
                            @foreach (var option in civilStatusOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label" for="patientOccupation">Ocupación</label>
                        <input id="patientOccupation" class="form-control" @bind="editor.Ocupacion" readonly="@(!CanModifyEditor)" maxlength="100" />
                    </div>

                    <div>
                        <label class="form-label" for="patientPhone">Teléfono / Celular</label>
                        <input id="patientPhone" class="form-control" @bind="editor.Telefono" readonly="@(!CanModifyEditor)" maxlength="20" placeholder="10 dígitos (opcional)" />
                    </div>

                    <div>
                        <label class="form-label" for="patientEmail">Correo</label>
                        <input id="patientEmail" type="email" class="form-control" @bind="editor.Email" readonly="@(!CanModifyEditor)" maxlength="150" />
                    </div>
                </div>

                <div class="management-form-grid patient-form-block" style="grid-template-columns: 1fr; margin-top: 1rem;">
                    <div>
                        <label class="form-label" for="patientAddress">Dirección</label>
                        <input id="patientAddress" class="form-control" @bind="editor.Direccion" readonly="@(!CanModifyEditor)" maxlength="255" />
                    </div>

                    <div style="margin-top: 1rem;">
                        <label class="form-label" for="patientObservations">Observaciones</label>
                        <textarea id="patientObservations" class="form-control" rows="3" @bind="editor.Observaciones" readonly="@(!CanModifyEditor)"></textarea>
                    </div>
                </div>
            </div>
            <footer class="custom-modal-footer">
                <button type="button" class="btn btn-outline-primary" @onclick="() => showFormModal = false">Cancelar</button>
                @if (CanModifyEditor)
                {
                    <button type="button" class="btn btn-primary" @onclick="SavePatientAsync">Guardar cambios</button>
                }
            </footer>
        </div>
    </div>
}

<!-- Custom Audit Modal -->
@if (showAuditModal && editor is not null)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card audit-modal-card">
            <header class="custom-modal-header apricot-header">
                <h2>Historial de Auditoría</h2>
                <button type="button" class="btn-close-modal" @onclick="() => showAuditModal = false">×</button>
            </header>
            <div class="custom-modal-body">
                <div style="margin-bottom: 1.5rem;">
                    <strong style="font-size: 1.1rem; color: var(--color-ink);">@editor.FullName</strong>
                    <span style="display: block; font-size: 0.85rem; color: var(--color-taupe);">Código: @editor.CodigoPaciente | Cédula: @editor.Cedula</span>
                </div>

                <div class="audit-info-summary" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-bottom: 1.5rem; background: rgba(244, 240, 228, 0.4); padding: 1rem; border-radius: 0.8rem;">
                    <div>
                        <small style="color: var(--color-taupe); display: block; font-size: 0.75rem;">Fecha Registro</small>
                        <strong>@editor.FechaRegistro</strong>
                    </div>
                    <div>
                        <small style="color: var(--color-taupe); display: block; font-size: 0.75rem;">Usuario Registro</small>
                        <strong>@editor.UsuarioRegistro</strong>
                    </div>
                </div>

                <div class="audit-history-list" style="max-height: 300px; overflow-y: auto;">
                    @if (auditEntries.Count == 0)
                    {
                        <p>No hay eventos registrados para este paciente.</p>
                    }
                    else
                    {
                        <div style="display: grid; gap: 0.8rem;">
                            @foreach (var auditEntry in auditEntries)
                            {
                                <div style="background: #ffffff; border: 1px solid rgba(127, 105, 81, 0.08); padding: 0.8rem; border-radius: 0.6rem; box-shadow: 0 2px 8px rgba(127,105,81,0.02);">
                                    <div style="display: flex; justify-content: space-between; margin-bottom: 0.4rem;">
                                        <strong style="color: var(--color-sage);">@auditEntry.accion</strong>
                                        <span style="font-size: 0.78rem; color: var(--color-taupe);">@(auditEntry.fecha?.ToString("yyyy-MM-dd HH:mm") ?? "Sin fecha")</span>
                                    </div>
                                    <div style="font-size: 0.82rem; color: var(--color-ink); margin-bottom: 0.2rem;">
                                        @auditEntry.detalle
                                    </div>
                                    <div style="font-size: 0.75rem; color: var(--color-taupe);">
                                        Actor: @GetAuditActorLabel(auditEntry)
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
            <footer class="custom-modal-footer">
                <button type="button" class="btn btn-primary" @onclick="() => showAuditModal = false">Cerrar</button>
            </footer>
        </div>
    </div>
}

<!-- Custom Alert Modal -->
@if (showAlertModal)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-card alert-modal-card">
            <header class="custom-modal-header @(alertIsError ? "error-header" : "success-header")">
                <h2>@(alertIsError ? "Error de Validación" : "Operación Exitosa")</h2>
            </header>
            <div class="custom-modal-body" style="padding: 2rem 1.5rem; text-align: center;">
                <div style="font-size: 3rem; margin-bottom: 1rem; color: @(alertIsError ? "#7F6951" : "#5DA181")">
                    <i class="bi @(alertIsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")"></i>
                </div>
                <p style="font-size: 1rem; color: var(--color-ink); line-height: 1.5; margin: 0;">@alertMessage</p>
            </div>
            <footer class="custom-modal-footer" style="justify-content: center; background: transparent; border-top: none; padding-top: 0;">
                <button type="button" class="btn btn-primary" style="min-width: 120px;" @onclick="CloseAlertModal">Aceptar</button>
            </footer>
        </div>
    </div>
}

