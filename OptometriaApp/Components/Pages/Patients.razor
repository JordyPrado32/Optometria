@code {
    private readonly List<tbl_paciente> patients = [];
    private List<tbl_log_auditoria> auditEntries = [];
    private PatientEditorModel? editor;
    private List<tbl_usuario> portalUsers = [];
    private bool enablePortalAccess;
    private bool isNewPortalUser;
    private string portalUsername = string.Empty;
    private string portalPassword = string.Empty;
    private int selectedPortalUserId;
    private ModulePermissions permissions = new();
    private bool isLoading = true;
    private bool canViewPatients;
    private bool isCreatingNewPatient;
    private int selectedPatientId;
    private int currentUserId;
    private int currentRoleId;
    private string searchTerm = string.Empty;
    private string selectedStatusFilter = "all";
    private string selectedGenderFilter = string.Empty;
    private string selectedCivilStatusFilter = string.Empty;
    private string? errorMessage;

    // Modal Control Fields
    private bool showFormModal;
    private bool showAuditModal;
    private bool showAlertModal;
    private string alertMessage = string.Empty;
    private bool alertIsError;

    private static readonly string[] genderOptions = ["Femenino", "Masculino", "No binario", "Prefiero no decirlo"];
    private static readonly string[] civilStatusOptions = ["Soltero(a)", "Casado(a)", "Union libre", "Divorciado(a)", "Viudo(a)"];

    private List<tbl_paciente> FilteredPatients => patients
        .Where(MatchesFilters)
        .OrderBy(p => p.apellidos)
        .ThenBy(p => p.nombres)
        .ToList();
    private int tablePageSize = 8;
    private int patientPage = 1;
    private int EffectivePatientPage => Math.Min(patientPage, Math.Max(1, (int)Math.Ceiling(FilteredPatients.Count / (double)tablePageSize)));
    private IEnumerable<tbl_paciente> PagedPatients => FilteredPatients.Skip((EffectivePatientPage - 1) * tablePageSize).Take(tablePageSize);
    private void SetPatientPage(int page) => patientPage = page;
    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            tablePageSize = size;
            patientPage = 1;
        }
    }

    private string EditorTitle => isCreatingNewPatient ? "Nuevo paciente" : "Detalle del paciente";
    private bool CanModifyEditor => isCreatingNewPatient ? permissions.CanCreate : permissions.CanEdit;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var parsedUserId) ? parsedUserId : 0;
        currentRoleId = int.TryParse(authState.User.FindFirst("RoleId")?.Value, out var parsedRoleId) ? parsedRoleId : 0;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();

        permissions = await GetModulePermissionsAsync(dbContext, currentRoleId);
        canViewPatients = permissions.CanView;

        if (!canViewPatients)
        {
            isLoading = false;
            return;
        }

        var loadedPatients = await dbContext.tbl_pacientes
            .AsNoTracking()
            .Include(p => p.id_usuario_registroNavigation)
            .Include(p => p.tbl_consulta)
            .ToListAsync();

        patients.Clear();
        patients.AddRange(loadedPatients);

        // Cargar usuarios con rol 'Paciente'
        portalUsers = await dbContext.tbl_usuarios
            .AsNoTracking()
            .Where(u => u.id_rolNavigation.nombre.ToLower() == "paciente" && u.activo == true)
            .OrderBy(u => u.apellidos)
            .ThenBy(u => u.nombres)
            .ToListAsync();

        selectedPatientId = 0;
        editor = null;
        auditEntries = [];

        isLoading = false;
    }

    private void PrepareNewPatient()
    {
        isCreatingNewPatient = true;
        selectedPatientId = 0;
        editor = BuildNewEditor();
        auditEntries = [];
        enablePortalAccess = false;
        isNewPortalUser = false;
        selectedPortalUserId = 0;
        portalUsername = string.Empty;
        portalPassword = string.Empty;
        showFormModal = true;
    }

    private void PrepareEditPatient(tbl_paciente patient)
    {
        isCreatingNewPatient = false;
        selectedPatientId = patient.id_paciente;
        editor = BuildEditor(patient);
        showFormModal = true;
    }

    private async Task PrepareAuditPatient(tbl_paciente patient)
    {
        selectedPatientId = patient.id_paciente;
        editor = BuildEditor(patient);
        await LoadAuditEntriesAsync(patient.id_paciente);
        showAuditModal = true;
    }

    private void ShowAlert(string message, bool isError)
    {
        alertMessage = message;
        alertIsError = isError;
        showAlertModal = true;
    }

    private void CloseAlertModal()
    {
        showAlertModal = false;
        alertMessage = string.Empty;
    }

    private static string GetClinicalHistoryUrl(int patientId) => $"/doctor/historia-clinica?patientId={patientId}";

    private async Task SelectPatientAsync(int patientId)
    {
        selectedPatientId = patientId;
        isCreatingNewPatient = false;
        errorMessage = null;
        var patient = patients.FirstOrDefault(p => p.id_paciente == patientId);
        editor = BuildEditor(patient);
        if (patient is not null && patient.id_usuario.HasValue)
        {
            enablePortalAccess = true;
            isNewPortalUser = false;
            selectedPortalUserId = patient.id_usuario.Value;
        }
        else
        {
            enablePortalAccess = false;
            isNewPortalUser = false;
            selectedPortalUserId = 0;
        }
        portalUsername = string.Empty;
        portalPassword = string.Empty;
        await LoadAuditEntriesAsync(patientId);
    }

    private void SetPortalUserType(bool isNew)
    {
        isNewPortalUser = isNew;
    }

    private async Task SavePatientAsync()
    {
        if (!ValidateEditor())
        {
            ShowAlert(errorMessage ?? "Por favor corrige los errores del formulario.", true);
            return;
        }

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var normalizedCedula = editor!.Cedula.Trim().ToLowerInvariant();
            var normalizedEmail = editor.Email.Trim().ToLowerInvariant();
            var normalizedCode = editor.CodigoPaciente.Trim().ToLowerInvariant();

            var cedulaExists = await dbContext.tbl_pacientes
                .AnyAsync(p => p.id_paciente != editor.IdPaciente && p.cedula.ToLower() == normalizedCedula);

            if (cedulaExists)
            {
                ShowAlert("La cédula ya está registrada para otro paciente.", true);
                return;
            }

            if (!string.IsNullOrWhiteSpace(normalizedEmail))
            {
                var emailExists = await dbContext.tbl_pacientes
                    .AnyAsync(p => p.id_paciente != editor.IdPaciente && p.email != null && p.email.ToLower() == normalizedEmail);

                if (emailExists)
                {
                    ShowAlert("El correo ya está registrado para otro paciente.", true);
                    return;
                }
            }

            if (!string.IsNullOrWhiteSpace(normalizedCode))
            {
                var codeExists = await dbContext.tbl_pacientes
                    .AnyAsync(p => p.id_paciente != editor.IdPaciente && p.codigo_paciente != null && p.codigo_paciente.ToLower() == normalizedCode);

                if (codeExists)
                {
                    ShowAlert("El código del paciente ya existe.", true);
                    return;
                }
            }

            var birthDate = ParseBirthDate(editor.FechaNacimiento);
            var age = CalculateAge(birthDate);

            // Validar que el usuario de registro realmente exista en la base de datos
            int? validUserId = null;
            if (currentUserId > 0)
            {
                var userExists = await dbContext.tbl_usuarios.AnyAsync(u => u.id_usuario == currentUserId);
                if (userExists)
                {
                    validUserId = currentUserId;
                }
            }

            // Procesar credenciales de acceso al portal si están habilitadas
            int? linkedUserId = null;
            if (enablePortalAccess)
            {
                if (isNewPortalUser)
                {
                    if (string.IsNullOrWhiteSpace(portalUsername))
                    {
                        ShowAlert("Por favor ingresa un nombre de usuario para el portal.", true);
                        return;
                    }
                    var normalizedUsername = portalUsername.Trim().ToLowerInvariant();
                    var usernameExists = await dbContext.tbl_usuarios.AnyAsync(u => u.usuario.ToLower() == normalizedUsername);
                    if (usernameExists)
                    {
                        ShowAlert("El nombre de usuario para el portal ya está registrado.", true);
                        return;
                    }
                    if (string.IsNullOrWhiteSpace(portalPassword))
                    {
                        ShowAlert("Por favor ingresa una contraseña para el nuevo usuario.", true);
                        return;
                    }

                    var pacienteRole = await dbContext.tbl_rols.FirstOrDefaultAsync(r => r.nombre.ToLower() == "paciente");
                    if (pacienteRole is null)
                    {
                        ShowAlert("No se encontró el rol 'Paciente' en la base de datos.", true);
                        return;
                    }

                    var newUser = new tbl_usuario
                    {
                        id_rol = pacienteRole.id_rol,
                        nombres = editor.Nombres.Trim(),
                        apellidos = editor.Apellidos.Trim(),
                        email = string.IsNullOrWhiteSpace(editor.Email) ? null : editor.Email.Trim(),
                        usuario = portalUsername.Trim(),
                        telefono = string.IsNullOrWhiteSpace(editor.Telefono) ? null : editor.Telefono.Trim(),
                        fecha_nacimiento = birthDate,
                        activo = true,
                        bloqueado = false,
                        intentos_fallidos = 0,
                        fecha_creacion = DateTime.Now,
                        ultimo_cambio_password = DateOnly.FromDateTime(DateTime.Now)
                    };
                    newUser.password_hash = PasswordHasher.HashPassword(newUser, portalPassword);
                    dbContext.tbl_usuarios.Add(newUser);
                    await dbContext.SaveChangesAsync();

                    dbContext.tbl_usuario_seguridad.Add(new tbl_usuario_seguridad
                    {
                        id_usuario = newUser.id_usuario,
                        two_factor_enabled = false,
                        must_change_password = false,
                        created_at = DateTime.Now,
                        updated_at = DateTime.Now
                    });
                    await dbContext.SaveChangesAsync();

                    linkedUserId = newUser.id_usuario;
                }
                else
                {
                    if (selectedPortalUserId <= 0)
                    {
                        ShowAlert("Por favor selecciona un usuario responsable.", true);
                        return;
                    }
                    linkedUserId = selectedPortalUserId;
                }
            }

            if (isCreatingNewPatient)
            {
                if (!permissions.CanCreate)
                {
                    ShowAlert("Tu rol no tiene permiso para crear pacientes.", true);
                    return;
                }

                var newPatient = new tbl_paciente
                {
                    codigo_paciente = ResolvePatientCode(editor.CodigoPaciente),
                    cedula = editor.Cedula.Trim(),
                    nombres = editor.Nombres.Trim(),
                    apellidos = editor.Apellidos.Trim(),
                    fecha_nacimiento = birthDate,
                    edad = age,
                    genero = NormalizeOptional(editor.Genero),
                    estado_civil = NormalizeOptional(editor.EstadoCivil),
                    ocupacion = NormalizeOptional(editor.Ocupacion),
                    direccion = NormalizeOptional(editor.Direccion),
                    telefono = NormalizeOptional(editor.Telefono),
                    email = NormalizeOptional(editor.Email),
                    observaciones = NormalizeOptional(editor.Observaciones),
                    activo = true,
                    fecha_registro = DateTime.Now,
                    id_usuario_registro = validUserId,
                    id_usuario = linkedUserId
                };

                dbContext.tbl_pacientes.Add(newPatient);
                await dbContext.SaveChangesAsync();

                WriteAudit(
                    dbContext,
                    "Crear paciente",
                    $"PacienteId={newPatient.id_paciente}; Cedula={newPatient.cedula}; Nombre={newPatient.nombres} {newPatient.apellidos}; Codigo={newPatient.codigo_paciente}");

                await dbContext.SaveChangesAsync();
                ShowAlert("El paciente se registró correctamente.", false);
                showFormModal = false;
                await LoadAsync();
                return;
            }

            if (!permissions.CanEdit)
            {
                ShowAlert("Tu rol no tiene permiso para editar pacientes.", true);
                return;
            }

            var patientEntity = await dbContext.tbl_pacientes.FirstOrDefaultAsync(p => p.id_paciente == editor.IdPaciente);
            if (patientEntity is null)
            {
                ShowAlert("No se encontró el paciente seleccionado.", true);
                return;
            }

            patientEntity.codigo_paciente = ResolvePatientCode(editor.CodigoPaciente);
            patientEntity.cedula = editor.Cedula.Trim();
            patientEntity.nombres = editor.Nombres.Trim();
            patientEntity.apellidos = editor.Apellidos.Trim();
            patientEntity.fecha_nacimiento = birthDate;
            patientEntity.edad = age;
            patientEntity.genero = NormalizeOptional(editor.Genero);
            patientEntity.estado_civil = NormalizeOptional(editor.EstadoCivil);
            patientEntity.ocupacion = NormalizeOptional(editor.Ocupacion);
            patientEntity.direccion = NormalizeOptional(editor.Direccion);
            patientEntity.telefono = NormalizeOptional(editor.Telefono);
            patientEntity.email = NormalizeOptional(editor.Email);
            patientEntity.observaciones = NormalizeOptional(editor.Observaciones);
            patientEntity.id_usuario = linkedUserId;

            WriteAudit(
                dbContext,
                "Editar paciente",
                $"PacienteId={patientEntity.id_paciente}; Cedula={patientEntity.cedula}; Nombre={patientEntity.nombres} {patientEntity.apellidos}");

            await dbContext.SaveChangesAsync();
            ShowAlert("La información del paciente se guardó correctamente.", false);
            showFormModal = false;
            await LoadAsync();
        }
        catch (DbUpdateException dbEx)
        {
            var innerMsg = dbEx.InnerException?.Message ?? dbEx.Message;
            ShowAlert($"Error de base de datos al guardar: {innerMsg}", true);
        }
        catch (Exception ex)
        {
            ShowAlert($"Ocurrió un error inesperado al guardar los cambios: {ex.Message}", true);
        }
    }

    private async Task ToggleActiveAsync(tbl_paciente patient)
    {
        if (!permissions.CanDelete)
        {
            ShowAlert("Tu rol no tiene permiso para activar o desactivar pacientes.", true);
            return;
        }

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var patientEntity = await dbContext.tbl_pacientes.FirstOrDefaultAsync(p => p.id_paciente == patient.id_paciente);
            if (patientEntity is null)
            {
                ShowAlert("No se encontró el paciente seleccionado.", true);
                return;
            }

            patientEntity.activo = !(patientEntity.activo ?? false);
            WriteAudit(
                dbContext,
                patientEntity.activo == true ? "Reactivar paciente" : "Inactivar paciente",
                $"PacienteId={patientEntity.id_paciente}; Cedula={patientEntity.cedula}; Activo={(patientEntity.activo == true ? "Si" : "No")}");

            await dbContext.SaveChangesAsync();
            ShowAlert(patientEntity.activo == true
                ? "El paciente fue reactivado correctamente."
                : "El paciente fue inactivado correctamente.", false);

            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowAlert($"Ocurrió un error al cambiar el estado del paciente: {ex.Message}", true);
        }
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        selectedStatusFilter = "all";
        selectedGenderFilter = string.Empty;
        selectedCivilStatusFilter = string.Empty;
    }

    private void ExportPatients()
    {
        var query = new List<string>();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query.Add($"search={Uri.EscapeDataString(searchTerm)}");
        }

        if (!string.Equals(selectedStatusFilter, "all", StringComparison.OrdinalIgnoreCase))
        {
            query.Add($"status={Uri.EscapeDataString(selectedStatusFilter)}");
        }

        if (!string.IsNullOrWhiteSpace(selectedGenderFilter))
        {
            query.Add($"gender={Uri.EscapeDataString(selectedGenderFilter)}");
        }

        if (!string.IsNullOrWhiteSpace(selectedCivilStatusFilter))
        {
            query.Add($"civilStatus={Uri.EscapeDataString(selectedCivilStatusFilter)}");
        }

        var exportUrl = query.Count == 0
            ? "/exports/patients.csv"
            : $"/exports/patients.csv?{string.Join("&", query)}";

        NavigationManager.NavigateTo(exportUrl, forceLoad: true);
    }

    private async Task LoadAuditEntriesAsync(int patientId)
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var patientToken = $"PacienteId={patientId};";

        auditEntries = await dbContext.tbl_log_auditoria
            .AsNoTracking()
            .Include(a => a.id_usuarioNavigation)
            .Where(a => a.modulo == "Pacientes" && a.detalle != null && a.detalle.Contains(patientToken))
            .OrderByDescending(a => a.fecha)
            .Take(20)
            .ToListAsync();
    }

    private void OnBirthDateChanged(ChangeEventArgs args)
    {
        if (editor is null)
        {
            return;
        }

        var inputVal = args.Value?.ToString() ?? string.Empty;
        if (DateOnly.TryParse(inputVal, out var birthDate) && birthDate > DateOnly.FromDateTime(DateTime.Today))
        {
            ShowAlert("La fecha de nacimiento no puede estar en el futuro.", true);
            editor.FechaNacimiento = string.Empty;
            editor.Edad = null;
            return;
        }

        editor.FechaNacimiento = inputVal;
        editor.Edad = CalculateAge(ParseBirthDate(editor.FechaNacimiento));
    }

    private bool MatchesFilters(tbl_paciente patient)
    {
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var normalizedSearch = searchTerm.Trim().ToLowerInvariant();
            var matches = (patient.codigo_paciente != null && patient.codigo_paciente.ToLower().Contains(normalizedSearch)) ||
                          (patient.cedula != null && patient.cedula.ToLower().Contains(normalizedSearch)) ||
                          (patient.nombres != null && patient.nombres.ToLower().Contains(normalizedSearch)) ||
                          (patient.apellidos != null && patient.apellidos.ToLower().Contains(normalizedSearch)) ||
                          (patient.email != null && patient.email.ToLower().Contains(normalizedSearch)) ||
                          (patient.telefono != null && patient.telefono.ToLower().Contains(normalizedSearch));

            if (!matches) return false;
        }

        if (!string.Equals(selectedStatusFilter, "all", StringComparison.OrdinalIgnoreCase))
        {
            var wantActive = string.Equals(selectedStatusFilter, "active", StringComparison.OrdinalIgnoreCase);
            if (patient.activo != wantActive) return false;
        }

        if (!string.IsNullOrWhiteSpace(selectedGenderFilter))
        {
            if (!string.Equals(patient.genero, selectedGenderFilter, StringComparison.OrdinalIgnoreCase))
                return false;
        }

        if (!string.IsNullOrWhiteSpace(selectedCivilStatusFilter))
        {
            if (!string.Equals(patient.estado_civil, selectedCivilStatusFilter, StringComparison.OrdinalIgnoreCase))
                return false;
        }

        return true;
    }

    private bool ValidateEditor()
    {
        if (editor is null)
        {
            errorMessage = "No hay un paciente seleccionado.";
            return false;
        }

        editor.CodigoPaciente = editor.CodigoPaciente.Trim();
        editor.Cedula = editor.Cedula.Trim();
        editor.Nombres = editor.Nombres.Trim();
        editor.Apellidos = editor.Apellidos.Trim();
        editor.Email = editor.Email.Trim();
        editor.Telefono = editor.Telefono.Trim();
        editor.Ocupacion = editor.Ocupacion.Trim();
        editor.Direccion = editor.Direccion.Trim();

        if (string.IsNullOrWhiteSpace(editor.Cedula) ||
            string.IsNullOrWhiteSpace(editor.Nombres) ||
            string.IsNullOrWhiteSpace(editor.Apellidos) ||
            string.IsNullOrWhiteSpace(editor.FechaNacimiento))
        {
            errorMessage = "Cédula, fecha de nacimiento, nombres y apellidos son obligatorios.";
            return false;
        }

        if (!AppValidation.IsValidEcuadorianCedula(editor.Cedula))
        {
            errorMessage = "Ingresa una cédula ecuatoriana válida.";
            return false;
        }

        if (!AppValidation.IsPersonName(editor.Nombres) || !AppValidation.IsPersonName(editor.Apellidos))
        {
            errorMessage = "Nombres y apellidos solo pueden contener letras y cada nombre o apellido debe tener al menos 3 letras.";
            return false;
        }

        if (editor.Cedula.Length > 20 || editor.Nombres.Length > 100 || editor.Apellidos.Length > 100)
        {
            errorMessage = "Verifica las longitudes máximas de cédula, nombres y apellidos.";
            return false;
        }

        if (editor.CodigoPaciente.Length > 30 ||
            editor.Email.Length > 150 ||
            editor.Telefono.Length > 20 ||
            editor.Ocupacion.Length > 100 ||
            editor.Direccion.Length > 255)
        {
            errorMessage = "Uno o varios campos exceden la longitud permitida.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(editor.Telefono) && string.IsNullOrWhiteSpace(editor.Email))
        {
            errorMessage = "Ingresa al menos una forma de contacto: teléfono o correo.";
            return false;
        }

        if (!string.IsNullOrWhiteSpace(editor.Telefono) && !AppValidation.IsValidPhoneNumber(editor.Telefono))
        {
            errorMessage = "El teléfono debe tener entre 7 y 15 dígitos numéricos.";
            return false;
        }

        if (!string.IsNullOrWhiteSpace(editor.Email) && !AppValidation.IsValidEmail(editor.Email))
        {
            errorMessage = "Ingresa un correo electrónico válido.";
            return false;
        }

        if (!string.IsNullOrWhiteSpace(editor.FechaNacimiento) && !DateOnly.TryParse(editor.FechaNacimiento, out _))
        {
            errorMessage = "La fecha de nacimiento no es válida.";
            return false;
        }

        if (DateOnly.TryParse(editor.FechaNacimiento, out var birthDate) && birthDate > DateOnly.FromDateTime(DateTime.Today))
        {
            errorMessage = "La fecha de nacimiento no puede estar en el futuro.";
            return false;
        }

        return true;
    }

