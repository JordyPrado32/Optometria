@using System.Net.Mail
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<OpticaDbContext> DbContextFactory
@inject NavigationManager NavigationManager

@if (isLoading)
{
    <section class="management-shell">
        <div class="management-card">
            <h1>Cargando pacientes asignados...</h1>
        </div>
    </section>
}
else if (!canViewModule)
{
    <section class="management-shell">
        <div class="management-card">
            <span class="eyebrow">Restringido</span>
            <h1>@PageTitleText</h1>
            <p>Tu rol no tiene permiso para ver este modulo.</p>
        </div>
    </section>
}
else
{
    <section class="management-shell">
        <div class="management-hero">
            <div>
                <span class="eyebrow">Doctor</span>
                <h1>@PageTitleText</h1>
                <p>@PageDescription</p>
            </div>

            <div class="workspace-actions" style="align-items: center;">
                @if (IsEntryMode && permissions.CanCreate)
                {
                    <button type="button" class="btn btn-coffee" @onclick="OpenNewPatientModal">
                        <i class="bi bi-person-plus-fill" style="margin-right: 6px;"></i> Nuevo paciente
                    </button>
                }

                <button type="button" class="btn btn-excel" @onclick="ExportPatients">
                    <i class="bi bi-file-earmark-excel-fill" style="margin-right: 6px;"></i> Exportar CSV
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-success" role="alert">@statusMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        <section class="management-card">
            <div class="management-card-header">
                <h2>Filtros y busqueda</h2>
                <span>@FilteredPatients.Count resultados</span>
            </div>

            <div class="management-form-grid">
                <div>
                    <label class="form-label" for="doctorPatientSearch">Buscador</label>
                    <input id="doctorPatientSearch" class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Codigo, cedula, nombre, correo o telefono" />
                </div>

                <div>
                    <label class="form-label" for="doctorPatientStatus">Estado</label>
                    <select id="doctorPatientStatus" class="form-select" @bind="selectedStatusFilter">
                        <option value="all">Todos</option>
                        <option value="active">Activos</option>
                        <option value="inactive">Inactivos</option>
                    </select>
                </div>

                <div>
                    <label class="form-label" for="doctorPatientGender">Genero</label>
                    <select id="doctorPatientGender" class="form-select" @bind="selectedGenderFilter">
                        <option value="">Todos</option>
                        @foreach (var option in genderOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="form-label" for="doctorPatientCivilStatus">Estado civil</label>
                    <select id="doctorPatientCivilStatus" class="form-select" @bind="selectedCivilStatusFilter">
                        <option value="">Todos</option>
                        @foreach (var option in civilStatusOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </div>
            </div>

            <div class="management-actions">
                <button type="button" class="btn btn-outline-primary" @onclick="ClearFilters">Limpiar filtros</button>
            </div>
        </section>

        <!-- Patients Table -->
        <section class="management-card" style="margin-top: 1.5rem;">
            <div class="management-card-header">
                <h2>@ListTitle</h2>
                <span>@FilteredPatients.Count registros</span>
            </div>

            <div class="table-responsive" style="margin-top: 1rem;">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Cédula</th>
                            <th>Paciente</th>
                            <th>Teléfono</th>
                            <th>Correo</th>
                            <th>Estado</th>
                            <th style="text-align: right; padding-right: 1.5rem;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredPatients.Count == 0)
                        {
                            <tr>
                                <td colspan="7" style="text-align: center; padding: 2rem; color: var(--color-taupe);">
                                    No se encontraron pacientes con los filtros actuales.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var patient in PagedPatients)
                            {
                                <tr>
                                    <td><span style="font-family: monospace; font-size: 0.85rem;">@(string.IsNullOrWhiteSpace(patient.codigo_paciente) ? "-" : patient.codigo_paciente)</span></td>
                                    <td>@patient.cedula</td>
                                    <td><strong style="color: var(--color-ink);">@($"{patient.nombres} {patient.apellidos}")</strong></td>
                                    <td>@(string.IsNullOrWhiteSpace(patient.telefono) ? "-" : patient.telefono)</td>
                                    <td>@(string.IsNullOrWhiteSpace(patient.email) ? "-" : patient.email)</td>
                                    <td>
                                        @if (patient.activo == true)
                                        {
                                            <span class="badge" style="background: rgba(93,161,129,0.15) !important; color: #5DA181 !important; font-size: 0.78rem; padding: 0.35rem 0.65rem; border-radius: 2rem;">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background: rgba(127,105,81,0.12) !important; color: #7F6951 !important; font-size: 0.78rem; padding: 0.35rem 0.65rem; border-radius: 2rem;">Inactivo</span>
                                        }
                                    </td>
                                    <td style="text-align: right; padding-right: 1.2rem;">
                                        <div style="display: inline-flex; gap: 0.4rem; justify-content: flex-end;">
                                            <button type="button" class="btn btn-outline-primary"
                                                    style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(93,161,129,0.3) !important; color: var(--color-sage) !important;"
                                                    @onclick="() => OpenEditPatientModal(patient.id_paciente)">
                                                <i class="bi bi-pencil-fill" style="margin-right: 4px;"></i> @(IsEntryMode ? "Editar" : "Ver")
                                            </button>
                                            <a class="btn btn-outline-primary"
                                               style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important;"
                                               href="@BuildClinicalHistoryUrl(patient.id_paciente)">
                                                Historia
                                            </a>
                                            @if (IsEntryMode && permissions.CanDelete)
                                            {
                                                @if (patient.activo == true)
                                                {
                                                    <button type="button" class="btn btn-outline-primary"
                                                            style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; border-color: rgba(127,105,81,0.2) !important; color: var(--color-taupe) !important;"
                                                            @onclick="() => ToggleActiveFromTableAsync(patient.id_paciente)">
                                                        Desactivar
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-primary"
                                                            style="padding: 0.3rem 0.8rem !important; font-size: 0.78rem !important; background-color: var(--color-sage) !important; border-color: var(--color-sage) !important;"
                                                            @onclick="() => ToggleActiveFromTableAsync(patient.id_paciente)">
                                                        Activar
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <TablePager TotalItems="@FilteredPatients.Count" CurrentPage="@patientPage" CurrentPageChanged="SetPatientPage" />
        </section>
    </section>
}

<!-- Patient Form Modal -->
@if (showFormModal && editor is not null)
{
    <div class="custom-modal-overlay" @onclick="ClosePatientModal">
        <div class="custom-modal-card form-modal-card" @onclick:stopPropagation="true">
            <header class="custom-modal-header rose-header">
                <h2>@EditorTitle</h2>
                <button type="button" class="btn-close-modal" @onclick="ClosePatientModal">×</button>
            </header>

            <div class="custom-modal-body">
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger" role="alert" style="margin-bottom: 1rem;">@errorMessage</div>
                }
                @if (!string.IsNullOrWhiteSpace(statusMessage))
                {
                    <div class="alert alert-success" role="alert" style="margin-bottom: 1rem;">@statusMessage</div>
                }

                @if (!isCreatingNewPatient)
                {
                    <div class="user-summary-grid" style="margin-bottom: 1.2rem;">
                        <div class="user-summary-card">
                            <span class="eyebrow">Identificacion</span>
                            <strong>@editor.FullName</strong>
                            <p>@editor.Cedula</p>
                        </div>
                        <div class="user-summary-card">
                            <span class="eyebrow">Seguimiento</span>
                            <strong>@editor.CodigoPaciente</strong>
                            <p>@GetAgeSummary()</p>
                        </div>
                        <div class="user-summary-card">
                            <span class="eyebrow">Asignacion</span>
                            <strong>@editor.TotalConsultas</strong>
                            <p>@GetConsultationSummary()</p>
                        </div>
                    </div>
                }

                <div class="management-form-grid">
                    <div>
                        <label class="form-label" for="modalDoctorPatientCode">Codigo paciente</label>
                        <input id="modalDoctorPatientCode" class="form-control" @bind="editor.CodigoPaciente" readonly="@(!CanModifyEditor)" maxlength="30" />
                    </div>
                    <div>
                        <label class="form-label" for="modalDoctorPatientDocument">Cedula</label>
                        <input id="modalDoctorPatientDocument" class="form-control" @bind="editor.Cedula" readonly="@(!CanModifyEditor)" maxlength="20" />
                    </div>
                    <div>
                        <label class="form-label" for="modalDoctorPatientNames">Nombres</label>
                        <input id="modalDoctorPatientNames" class="form-control" @bind="editor.Nombres" readonly="@(!CanModifyEditor)" maxlength="100" />
                    </div>
                    <div>
                        <label class="form-label" for="modalDoctorPatientLastNames">Apellidos</label>
                        <input id="modalDoctorPatientLastNames" class="form-control" @bind="editor.Apellidos" readonly="@(!CanModifyEditor)" maxlength="100" />
                    </div>
                    <div>
                        <label class="form-label" for="modalDoctorPatientBirthDate">Fecha de nacimiento</label>
                        <input id="modalDoctorPatientBirthDate" type="date" class="form-control" value="@editor.FechaNacimiento" @onchange="OnBirthDateChanged" max="@TodayDateIso" readonly="@(!CanModifyEditor)" />
                    </div>
                    <div>
                        <label class="form-label" for="modalDoctorPatientAge">Edad</label>
                        <input id="modalDoctorPatientAge" class="form-control" value="@GetCalculatedAgeText()" readonly />
                    </div>
                    <div>
                        <label class="form-label" for="modalDoctorPatientGenderField">Genero</label>
                        <select id="modalDoctorPatientGenderField" class="form-select" @bind="editor.Genero" disabled="@(!CanModifyEditor)">
                            <option value="">Selecciona</option>
                            @foreach (var option in genderOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label" for="modalDoctorPatientCivilStatusField">Estado civil</label>
                        <select id="modalDoctorPatientCivilStatusField" class="form-select" @bind="editor.EstadoCivil" disabled="@(!CanModifyEditor)">
                            <option value="">Selecciona</option>
                            @foreach (var option in civilStatusOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label" for="modalDoctorPatientOccupation">Ocupacion</label>
                        <input id="modalDoctorPatientOccupation" class="form-control" @bind="editor.Ocupacion" readonly="@(!CanModifyEditor)" maxlength="100" />
                    </div>
                    <div>
                        <label class="form-label" for="modalDoctorPatientPhone">Telefono</label>
                        <input id="modalDoctorPatientPhone" class="form-control" @bind="editor.Telefono" readonly="@(!CanModifyEditor)" maxlength="20" />
                    </div>
                    <div>
                        <label class="form-label" for="modalDoctorPatientEmail">Correo</label>
                        <input id="modalDoctorPatientEmail" type="email" class="form-control" @bind="editor.Email" readonly="@(!CanModifyEditor)" maxlength="150" />
                    </div>
                </div>

                <div class="management-form-grid patient-form-block" style="margin-top: 1rem;">
                    <div class="patient-form-span">
                        <label class="form-label" for="modalDoctorPatientAddress">Direccion</label>
                        <input id="modalDoctorPatientAddress" class="form-control" @bind="editor.Direccion" readonly="@(!CanModifyEditor)" maxlength="255" />
                    </div>
                    <div class="patient-form-span">
                        <label class="form-label" for="modalDoctorPatientObservations">Observaciones</label>
                        <textarea id="modalDoctorPatientObservations" class="form-control" rows="4" @bind="editor.Observaciones" readonly="@(!CanModifyEditor)"></textarea>
                    </div>
                </div>

                @if (!isCreatingNewPatient)
                {
                    <div class="user-audit-grid" style="margin-top: 1.2rem;">
                        <div>
                            <label class="form-label">Fecha de registro</label>
                            <input class="form-control" value="@editor.FechaRegistro" readonly />
                        </div>
                        <div>
                            <label class="form-label">Usuario registro</label>
                            <input class="form-control" value="@editor.UsuarioRegistro" readonly />
                        </div>
                        <div>
                            <label class="form-label">Consultas contigo</label>
                            <input class="form-control" value="@editor.TotalConsultas" readonly />
                        </div>
                        <div>
                            <label class="form-label">Ultima consulta</label>
                            <input class="form-control" value="@editor.UltimaConsulta" readonly />
                        </div>
                    </div>
                }
            </div>

            <footer class="custom-modal-footer">
                @if (CanModifyEditor)
                {
                    <button type="button" class="btn btn-primary" @onclick="SaveAndClosePatientAsync">Guardar cambios</button>
                }
                @if (!isCreatingNewPatient && editor.IdPaciente > 0)
                {
                    <a class="btn btn-outline-primary" href="@BuildClinicalHistoryUrl(editor.IdPaciente)">Historia clinica</a>
                }
                <button type="button" class="btn btn-outline-primary" @onclick="ClosePatientModal">Cerrar</button>
            </footer>
        </div>
    </div>
}



@code {
    [Parameter] public string Mode { get; set; } = "entry";

    private readonly List<tbl_paciente> patients = [];
    private List<tbl_log_auditoria> auditEntries = [];
    private DoctorPatientEditorModel? editor;
    private ModulePermissions permissions = new();
    private bool isLoading = true;
    private bool canViewModule;
    private bool isCreatingNewPatient;
    private bool showFormModal;
    private int selectedPatientId;
    private int currentUserId;
    private int currentRoleId;
    private string searchTerm = string.Empty;
    private string selectedStatusFilter = "all";
    private string selectedGenderFilter = string.Empty;
    private string selectedCivilStatusFilter = string.Empty;
    private string? statusMessage;
    private string? errorMessage;
    private string TodayDateIso => DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");

    private static readonly string[] genderOptions = ["Femenino", "Masculino", "No binario", "Prefiero no decirlo"];
    private static readonly string[] civilStatusOptions = ["Soltero(a)", "Casado(a)", "Union libre", "Divorciado(a)", "Viudo(a)"];

    private bool IsEntryMode => string.Equals(Mode, "entry", StringComparison.OrdinalIgnoreCase);
    private string CurrentRoute => IsEntryMode ? "/doctor/ingresar-pacientes" : "/doctor/mis-pacientes";
    private string CurrentModuleName => IsEntryMode ? "Ingresar pacientes" : "Ver mis pacientes";
    private string ExportRoute => IsEntryMode ? "/exports/doctor-patient-entry.csv" : "/exports/doctor-my-patients.csv";
    private string PageTitleText => IsEntryMode ? "Ingresar pacientes" : "Ver mis pacientes";
    private string PageDescription => IsEntryMode
        ? "Registra pacientes nuevos y busca o actualiza sus datos base en todo el catalogo."
        : "Consulta tu cartera de pacientes asignados con filtros, busqueda rapida y exportacion controlada.";
    private string ListTitle => IsEntryMode ? "Todos los pacientes" : "Mis pacientes";
    private string EditorTitle => isCreatingNewPatient ? "Nuevo paciente" : "Detalle del paciente";
    private string EditorSubtitle => isCreatingNewPatient ? "Alta medica" : (selectedPatientId > 0 ? $"Paciente #{selectedPatientId}" : "Vista");
    private string EmptySelectionMessage => IsEntryMode
        ? "Selecciona un paciente asignado o crea uno nuevo."
        : "Selecciona un paciente para revisar su informacion.";
    private bool CanModifyEditor => IsEntryMode && (isCreatingNewPatient ? permissions.CanCreate : permissions.CanEdit);
    private static string BuildClinicalHistoryUrl(int patientId) => $"/doctor/historia-clinica?patientId={patientId}";

    private List<tbl_paciente> FilteredPatients => patients
        .Where(MatchesFilters)
        .OrderBy(p => p.apellidos)
        .ThenBy(p => p.nombres)
        .ToList();
    private const int TablePageSize = 5;
    private int patientPage = 1;
    private int EffectivePatientPage => Math.Min(patientPage, Math.Max(1, (int)Math.Ceiling(FilteredPatients.Count / (double)TablePageSize)));
    private IEnumerable<tbl_paciente> PagedPatients => FilteredPatients.Skip((EffectivePatientPage - 1) * TablePageSize).Take(TablePageSize);
    private void SetPatientPage(int page) => patientPage = page;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var parsedUserId) ? parsedUserId : 0;
        currentRoleId = int.TryParse(authState.User.FindFirst("RoleId")?.Value, out var parsedRoleId) ? parsedRoleId : 0;

        await LoadAsync();
    }

    private async Task OpenEditPatientModal(int patientId)
    {
        await SelectPatientAsync(patientId);
        showFormModal = true;
    }

    private async Task OpenNewPatientModal()
    {
        PrepareNewPatient();
        showFormModal = true;
        await Task.CompletedTask;
    }

    private void ClosePatientModal()
    {
        showFormModal = false;
        if (isCreatingNewPatient)
        {
            isCreatingNewPatient = false;
            editor = null;
        }
    }

    private async Task SaveAndClosePatientAsync()
    {
        await SavePatientAsync();
        if (string.IsNullOrWhiteSpace(errorMessage))
        {
            showFormModal = false;
        }
    }

    private async Task ToggleActiveFromTableAsync(int patientId)
    {
        await SelectPatientAsync(patientId);
        await ToggleActiveAsync();
    }

    private async Task LoadAsync(int? preserveSelectedPatientId = null)
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();

        permissions = await GetModulePermissionsAsync(dbContext, currentRoleId);
        canViewModule = permissions.CanView;

        if (!canViewModule || currentUserId <= 0)
        {
            isLoading = false;
            return;
        }

        List<tbl_paciente> loadedPatients;
        if (IsEntryMode)
        {
            loadedPatients = await dbContext.tbl_pacientes
                .AsNoTracking()
                .Include(p => p.id_usuario_registroNavigation)
                .Include(p => p.tbl_consulta)
                .ToListAsync();
        }
        else
        {
            loadedPatients = await dbContext.tbl_pacientes
                .AsNoTracking()
                .Where(p => p.tbl_consulta.Any(c => c.id_optometra == currentUserId))
                .Include(p => p.id_usuario_registroNavigation)
                .Include(p => p.tbl_consulta.Where(c => c.id_optometra == currentUserId))
                .ToListAsync();
        }

        patients.Clear();
        patients.AddRange(loadedPatients);

        if (isCreatingNewPatient)
        {
            editor ??= BuildNewEditor();
            auditEntries = [];
        }
        else
        {
            selectedPatientId = preserveSelectedPatientId ?? selectedPatientId;
            if (selectedPatientId == 0)
            {
                selectedPatientId = patients.FirstOrDefault()?.id_paciente ?? 0;
            }

            if (selectedPatientId > 0)
            {
                await SelectPatientAsync(selectedPatientId);
            }
            else
            {
                editor = null;
                auditEntries = [];
            }
        }

        isLoading = false;
    }

    private void PrepareNewPatient()
    {
        statusMessage = null;
        errorMessage = null;
        isCreatingNewPatient = true;
        selectedPatientId = 0;
        editor = BuildNewEditor();
        auditEntries = [];
    }

    private async Task SelectPatientAsync(int patientId)
    {
        selectedPatientId = patientId;
        isCreatingNewPatient = false;
        statusMessage = null;
        errorMessage = null;
        editor = BuildEditor(patients.FirstOrDefault(p => p.id_paciente == patientId));
        await LoadAuditEntriesAsync(patientId);
    }

    private async Task SavePatientAsync()
    {
        statusMessage = null;
        errorMessage = null;

        if (!IsEntryMode || !ValidateEditor())
        {
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var normalizedCedula = editor!.Cedula.Trim().ToLowerInvariant();
        var normalizedEmail = editor.Email.Trim().ToLowerInvariant();
        var normalizedCode = editor.CodigoPaciente.Trim().ToLowerInvariant();

        var cedulaExists = await dbContext.tbl_pacientes
            .AnyAsync(p => p.id_paciente != editor.IdPaciente && p.cedula.ToLower() == normalizedCedula);

        if (cedulaExists)
        {
            errorMessage = "La cedula ya esta registrada para otro paciente.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(normalizedEmail))
        {
            var emailExists = await dbContext.tbl_pacientes
                .AnyAsync(p => p.id_paciente != editor.IdPaciente && p.email != null && p.email.ToLower() == normalizedEmail);

            if (emailExists)
            {
                errorMessage = "El correo ya esta registrado para otro paciente.";
                return;
            }
        }

        if (!string.IsNullOrWhiteSpace(normalizedCode))
        {
            var codeExists = await dbContext.tbl_pacientes
                .AnyAsync(p => p.id_paciente != editor.IdPaciente && p.codigo_paciente != null && p.codigo_paciente.ToLower() == normalizedCode);

            if (codeExists)
            {
                errorMessage = "El codigo del paciente ya existe.";
                return;
            }
        }

        var birthDate = ParseBirthDate(editor.FechaNacimiento);
        var age = CalculateAge(birthDate);

        if (isCreatingNewPatient)
        {
            if (!permissions.CanCreate)
            {
                errorMessage = "Tu rol no tiene permiso para crear pacientes en este modulo.";
                return;
            }

            var newPatient = new tbl_paciente
            {
                codigo_paciente = ResolvePatientCode(editor.CodigoPaciente),
                cedula = editor.Cedula.Trim(),
                nombres = editor.Nombres.Trim(),
                apellidos = editor.Apellidos.Trim(),
                fecha_nacimiento = birthDate,
                edad = age,
                genero = NormalizeOptional(editor.Genero),
                estado_civil = NormalizeOptional(editor.EstadoCivil),
                ocupacion = NormalizeOptional(editor.Ocupacion),
                direccion = NormalizeOptional(editor.Direccion),
                telefono = NormalizeOptional(editor.Telefono),
                email = NormalizeOptional(editor.Email),
                observaciones = NormalizeOptional(editor.Observaciones),
                activo = true,
                fecha_registro = DateTime.Now,
                id_usuario_registro = currentUserId
            };

            dbContext.tbl_pacientes.Add(newPatient);
            await dbContext.SaveChangesAsync();

            dbContext.tbl_consulta.Add(new tbl_consulta
            {
                id_paciente = newPatient.id_paciente,
                id_optometra = currentUserId,
                fecha_consulta = DateTime.Now,
                motivo_consulta = "Asignacion inicial desde ingreso de pacientes"
            });

            WriteAudit(
                dbContext,
                "Crear paciente",
                $"PacienteId={newPatient.id_paciente}; Cedula={newPatient.cedula}; Nombre={newPatient.nombres} {newPatient.apellidos}; Codigo={newPatient.codigo_paciente}; DoctorId={currentUserId}");

            await dbContext.SaveChangesAsync();
            statusMessage = "El paciente se registro y quedo asignado a tu cuenta.";
            isCreatingNewPatient = false;
            await LoadAsync(newPatient.id_paciente);
            return;
        }

        if (!permissions.CanEdit)
        {
            errorMessage = "Tu rol no tiene permiso para editar pacientes en este modulo.";
            return;
        }

        var isAssignedToCurrentDoctor = await dbContext.tbl_consulta
            .AnyAsync(c => c.id_paciente == editor.IdPaciente && c.id_optometra == currentUserId);

        if (!isAssignedToCurrentDoctor)
        {
            errorMessage = "Solo puedes editar pacientes asignados a tus consultas.";
            return;
        }

        var patientEntity = await dbContext.tbl_pacientes.FirstOrDefaultAsync(p => p.id_paciente == editor.IdPaciente);
        if (patientEntity is null)
        {
            errorMessage = "No se encontro el paciente seleccionado.";
            return;
        }

        patientEntity.codigo_paciente = ResolvePatientCode(editor.CodigoPaciente);
        patientEntity.cedula = editor.Cedula.Trim();
        patientEntity.nombres = editor.Nombres.Trim();
        patientEntity.apellidos = editor.Apellidos.Trim();
        patientEntity.fecha_nacimiento = birthDate;
        patientEntity.edad = age;
        patientEntity.genero = NormalizeOptional(editor.Genero);
        patientEntity.estado_civil = NormalizeOptional(editor.EstadoCivil);
        patientEntity.ocupacion = NormalizeOptional(editor.Ocupacion);
        patientEntity.direccion = NormalizeOptional(editor.Direccion);
        patientEntity.telefono = NormalizeOptional(editor.Telefono);
        patientEntity.email = NormalizeOptional(editor.Email);
        patientEntity.observaciones = NormalizeOptional(editor.Observaciones);

        WriteAudit(
            dbContext,
            "Editar paciente",
            $"PacienteId={patientEntity.id_paciente}; Cedula={patientEntity.cedula}; Nombre={patientEntity.nombres} {patientEntity.apellidos}; DoctorId={currentUserId}");

        await dbContext.SaveChangesAsync();
        statusMessage = "La informacion del paciente se guardo correctamente.";
        await LoadAsync(patientEntity.id_paciente);
    }

    private async Task ToggleActiveAsync()
    {
        statusMessage = null;
        errorMessage = null;

        if (!IsEntryMode || !permissions.CanDelete || editor is null || editor.IdPaciente <= 0)
        {
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var isAssignedToCurrentDoctor = await dbContext.tbl_consulta
            .AnyAsync(c => c.id_paciente == editor.IdPaciente && c.id_optometra == currentUserId);

        if (!isAssignedToCurrentDoctor)
        {
            errorMessage = "Solo puedes cambiar el estado de pacientes asignados a tus consultas.";
            return;
        }

        var patientEntity = await dbContext.tbl_pacientes.FirstOrDefaultAsync(p => p.id_paciente == editor.IdPaciente);
        if (patientEntity is null)
        {
            errorMessage = "No se encontro el paciente seleccionado.";
            return;
        }

        patientEntity.activo = !(patientEntity.activo ?? false);
        WriteAudit(
            dbContext,
            patientEntity.activo == true ? "Reactivar paciente" : "Inactivar paciente",
            $"PacienteId={patientEntity.id_paciente}; Cedula={patientEntity.cedula}; Activo={(patientEntity.activo == true ? "Si" : "No")}; DoctorId={currentUserId}");

        await dbContext.SaveChangesAsync();
        statusMessage = patientEntity.activo == true
            ? "El paciente fue reactivado correctamente."
            : "El paciente fue inactivado correctamente.";

        await LoadAsync(patientEntity.id_paciente);
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        selectedStatusFilter = "all";
        selectedGenderFilter = string.Empty;
        selectedCivilStatusFilter = string.Empty;
    }

    private void ExportPatients()
    {
        var query = new List<string>();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query.Add($"search={Uri.EscapeDataString(searchTerm)}");
        }

        if (!string.Equals(selectedStatusFilter, "all", StringComparison.OrdinalIgnoreCase))
        {
            query.Add($"status={Uri.EscapeDataString(selectedStatusFilter)}");
        }

        if (!string.IsNullOrWhiteSpace(selectedGenderFilter))
        {
            query.Add($"gender={Uri.EscapeDataString(selectedGenderFilter)}");
        }

        if (!string.IsNullOrWhiteSpace(selectedCivilStatusFilter))
        {
            query.Add($"civilStatus={Uri.EscapeDataString(selectedCivilStatusFilter)}");
        }

        var exportUrl = query.Count == 0
            ? ExportRoute
            : $"{ExportRoute}?{string.Join("&", query)}";

        NavigationManager.NavigateTo(exportUrl, forceLoad: true);
    }

    private async Task LoadAuditEntriesAsync(int patientId)
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var patientToken = $"PacienteId={patientId};";
        var moduleNames = IsEntryMode
            ? new[] { "Ingresar pacientes", "Pacientes" }
            : new[] { "Ingresar pacientes", "Ver mis pacientes", "Pacientes" };

        auditEntries = await dbContext.tbl_log_auditoria
            .AsNoTracking()
            .Include(a => a.id_usuarioNavigation)
            .Where(a => a.detalle != null && a.detalle.Contains(patientToken) && a.modulo != null && moduleNames.Contains(a.modulo))
            .OrderByDescending(a => a.fecha)
            .Take(20)
            .ToListAsync();
    }

    private void OnBirthDateChanged(ChangeEventArgs args)
    {
        if (editor is null)
        {
            return;
        }

        editor.FechaNacimiento = args.Value?.ToString() ?? string.Empty;
        editor.Edad = CalculateAge(ParseBirthDate(editor.FechaNacimiento));
    }

    private bool MatchesFilters(tbl_paciente patient)
    {
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var normalizedSearch = searchTerm.Trim().ToLowerInvariant();
            var fullName = $"{patient.nombres} {patient.apellidos}".ToLowerInvariant();
            var matchesSearch =
                (patient.codigo_paciente?.ToLowerInvariant().Contains(normalizedSearch) ?? false) ||
                patient.cedula.ToLowerInvariant().Contains(normalizedSearch) ||
                fullName.Contains(normalizedSearch) ||
                (patient.email?.ToLowerInvariant().Contains(normalizedSearch) ?? false) ||
                (patient.telefono?.ToLowerInvariant().Contains(normalizedSearch) ?? false);

            if (!matchesSearch)
            {
                return false;
            }
        }

        if (selectedStatusFilter == "active" && patient.activo != true)
        {
            return false;
        }

        if (selectedStatusFilter == "inactive" && patient.activo == true)
        {
            return false;
        }

        if (!string.IsNullOrWhiteSpace(selectedGenderFilter) &&
            !string.Equals(patient.genero, selectedGenderFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (!string.IsNullOrWhiteSpace(selectedCivilStatusFilter) &&
            !string.Equals(patient.estado_civil, selectedCivilStatusFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return true;
    }

    private bool ValidateEditor()
    {
        if (editor is null)
        {
            errorMessage = "No hay un paciente seleccionado.";
            return false;
        }

        editor.CodigoPaciente = editor.CodigoPaciente.Trim();
        editor.Cedula = editor.Cedula.Trim();
        editor.Nombres = editor.Nombres.Trim();
        editor.Apellidos = editor.Apellidos.Trim();
        editor.Email = editor.Email.Trim();
        editor.Telefono = editor.Telefono.Trim();
        editor.Ocupacion = editor.Ocupacion.Trim();
        editor.Direccion = editor.Direccion.Trim();

        if (string.IsNullOrWhiteSpace(editor.Cedula) ||
            string.IsNullOrWhiteSpace(editor.Nombres) ||
            string.IsNullOrWhiteSpace(editor.Apellidos))
        {
            errorMessage = "Completa cedula, nombres y apellidos.";
            return false;
        }

        if (editor.Cedula.Length > 20 || editor.Nombres.Length > 100 || editor.Apellidos.Length > 100)
        {
            errorMessage = "Verifica las longitudes maximas de cedula, nombres y apellidos.";
            return false;
        }

        if (editor.CodigoPaciente.Length > 30 ||
            editor.Email.Length > 150 ||
            editor.Telefono.Length > 20 ||
            editor.Ocupacion.Length > 100 ||
            editor.Direccion.Length > 255)
        {
            errorMessage = "Uno o varios campos exceden la longitud permitida.";
            return false;
        }

        if (!string.IsNullOrWhiteSpace(editor.Email) && !IsValidEmail(editor.Email))
        {
            errorMessage = "Ingresa un correo electronico valido.";
            return false;
        }

        if (!string.IsNullOrWhiteSpace(editor.FechaNacimiento) && !DateOnly.TryParse(editor.FechaNacimiento, out _))
        {
            errorMessage = "La fecha de nacimiento no es valida.";
            return false;
        }

        if (DateOnly.TryParse(editor.FechaNacimiento, out var birthDate) && birthDate > DateOnly.FromDateTime(DateTime.Today))
        {
            errorMessage = "La fecha de nacimiento no puede estar en el futuro.";
            return false;
        }

        return true;
    }

