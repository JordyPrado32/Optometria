@rendermode InteractiveServer
@inject NavigationManager NavigationManager

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <ErrorBoundary @key="routeData.PageType">
            <ChildContent>
                <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                    <NotAuthorized>
                        <LayoutView Layout="typeof(Layout.AuthLayout)">
                            <div class="auth-shell">
                                <div class="auth-panel auth-panel-form">
                                    <div class="auth-card">
                                        <h1>Acceso requerido</h1>
                                        <p>Inicia sesión para continuar con el sistema de optometría.</p>
                                    </div>
                                    <div class="unauthorized-actions">
                                        <a href="/login" class="btn btn-coffee">Ir al inicio de sesión</a>
                                    </div>
                                </div>
                            </div>
                        </LayoutView>
                    </NotAuthorized>
                </AuthorizeRouteView>
            </ChildContent>
            <ErrorContent Context="exception">
                <LayoutView Layout="typeof(Layout.MainLayout)">
                    <div class="route-state-container">
                        <div class="route-state-card text-danger">
                            <h1>Se produjo un error visual</h1>
                            <p>El error fue contenido para evitar que se cierre toda la sesión. Puedes volver al tablero o recargar esta sección.</p>
                        </div>
                    </div>
                </LayoutView>
            </ErrorContent>
        </ErrorBoundary>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <section class="management-shell">
                <div class="management-card">
                    <span class="eyebrow">404</span>
                    <h1>Página no encontrada</h1>
                    <p>La ruta solicitada no existe o no se encuentra disponible.</p>
                    <div class="workspace-actions">
                        <a class="btn btn-coffee" href="/dashboard">Volver al tablero</a>
                    </div>
                </div>
            </section>
        </LayoutView>
    </NotFound>
</Router>
