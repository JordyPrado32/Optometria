{
  "ConnectionStrings": {
    "OpticaConnection": ""
  },
  "Infrastructure": {
    "ApplyDatabaseSchemaOnStartup": false,
    "EnableAppointmentReminders": false
  },
  "Deployment": {
    "UseHttpsRedirection": false
  },
  "Security": {
    "ApplicationName": "OptometriaApp",
    "TotpIssuer": "OptometriaApp",
    "TemporaryPasswordMinutesValid": 15
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "OptometriaApp",
    "EnableSsl": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
